# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.
# In Astro, only vars prefixed with PUBLIC_ are exposed to client code; everything
# here stays server-side (used only in src/pages/api/** and src/lib/**).

# --- TMDB (themoviedb.org → Settings → API, v3 key) ---
TMDB_API_KEY=your_tmdb_v3_api_key

# --- Supabase (Project Settings → API) ---
# URL and the anon key are safe-ish, but we keep reads/writes server-side so both stay here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Service-role key BYPASSES row-level security. Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Owner auth (single-user diary) ---
# Password you type on the login form. Choose something long.
ADMIN_PASSWORD=change_me_to_a_long_passphrase
# Secret used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=generate_a_random_64_char_hex_string
# A local `astro dev` server treats you as the owner without logging in, so the
# owner-only half of the site — which is most of it — can actually be worked on.
# Set this to 0 to browse the dev server as a stranger instead, which is the only
# way to check what a visitor is not supposed to see. Optional and off-by-absence:
# there is nothing to set for the normal case. Never applies to a build; see the
# note on isDevOwner in src/lib/auth.ts for why it cannot.
#OWNER_DEV=0

# --- MapTiler (the restaurant log's map) ---
# Vector tiles for /restaurants?view=map. Sign up at maptiler.com; the free tier
# is 100k tile requests a month.
#
# UNLIKE EVERYTHING ABOVE, THIS ONE IS PUBLIC. MapLibre requests tiles from the
# browser, so the key is compiled into the page and every request carries it —
# that is how the library works, and the PUBLIC_ prefix says so out loud. The
# real control is the domain allowlist: in the MapTiler dashboard, restrict the
# key to your own origins. Treat it as published, not as a secret.
#
# Unset is a supported state: the map still plots its pins, on a bare cream
# ground with no streets under them, and says why.
PUBLIC_MAPTILER_KEY=your_maptiler_key

# Geocoding — the composer's "find this restaurant" lookup — needs no key. It
# reads OpenStreetMap through Nominatim, which is the only free geocoder that
# actually indexes restaurants by name (MapTiler's returns villages in Spain for
# "Wu's Wonton King"). See src/lib/geocode.ts for the usage policy it honours.

# --- Jellyfin (optional; the film page's "play" button) ---
# Both unset is a supported state: the button never renders and film pages fall
# back to the YTS download link, which is what they did before this existed.
#
# NOTE — unlike everything above, these two DO reach the browser, despite the
# lack of a PUBLIC_ prefix: Jellyfin is tailnet-only, so a Vercel function can
# never reach it and the calls have to come from your own device. src/lib/
# jellyfin.ts emits them into the page for an authenticated owner session only.
# The key is useless to anyone not on your tailnet, but treat it as exposed.
#
# Tailnet HTTPS name for the server. Get it with `tailscale serve --bg 8096`,
# which fronts Jellyfin with a real cert (plain http:// would be blocked as
# mixed content from this site). Reaches Jellyfin from every tailnet device
# EXCEPT the one it runs on — a node can't reach its own serve endpoint.
JELLYFIN_URL=https://your-machine.your-tailnet.ts.net
# Covers exactly that gap, so the button also works while browsing on the
# machine hosting Jellyfin. Optional; harmless everywhere else, since the client
# probes both and keeps whichever answers.
JELLYFIN_LOCAL_URL=http://127.0.0.1:8096
# Jellyfin Dashboard → Advanced → API Keys → new key. Full-access; revoke there.
JELLYFIN_API_KEY=your_jellyfin_api_key
