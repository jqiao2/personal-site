# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.
# In Astro, only vars prefixed with PUBLIC_ are exposed to client code; everything
# here stays server-side (used only in src/pages/api/** and src/lib/**).

# --- TMDB (themoviedb.org → Settings → API, v3 key) ---
TMDB_API_KEY=your_tmdb_v3_api_key

# --- Supabase (Project Settings → API) ---
# URL and the anon key are safe-ish, but we keep reads/writes server-side so both stay here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Service-role key BYPASSES row-level security. Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Owner auth (single-user diary) ---
# Password you type on the login form. Choose something long.
ADMIN_PASSWORD=change_me_to_a_long_passphrase
# Secret used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=generate_a_random_64_char_hex_string
