    "restaurants:import": "node --env-file=.env scripts/import-to-try.mjs",
    "activities:import": "node --import ./scripts/ts-hook.mjs --env-file=.env scripts/import-strava-archive.mjs",
    "activities:test": "node --import ./scripts/ts-hook.mjs scripts/ingest.test.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.4",
    "@garmin/fitsdk": "^21.213.0",
