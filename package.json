{
  "name": "personal-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "credits:fetch": "node --env-file=.env scripts/credit-graph/fetch.mjs",
    "credits:load": "node --env-file=.env scripts/credit-graph/load.mjs",
