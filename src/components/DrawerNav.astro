---
// The primary site tabs, folded into the mobile drawer.
//
// Below 820px SiteHeader hides its tab strip (see .sh[data-sidebar] .sh__tabs)
// so the header fits one row. This renders those same tabs — Home, About,
// Projects, and the Journal group with its four logs — as a vertical block at
// the top of the section's drawer, so the whole site is still reachable from
// the hamburger. Hidden above 820px, where the header strip carries the tabs.
//
// It wears the section's header palette (the same --sh-* variables SiteHeader
// uses), so the folded tabs read as the same nav painted for this section.
import { siteNav, sectionNav } from '../lib/nav';
import { headerThemeStyle, type HeaderTheme } from '../lib/header-theme';

interface Props {
	/** Pathname used to light the active row. */
	pathname: string;
	/** Section palette to wear — matches the page's SiteHeader theme. */
	theme?: HeaderTheme;
	/** Rule + gap below the nav, separating it from section content underneath.
	    Off when the nav is the drawer's only content (the header's own menu). */
	divider?: boolean;
	/** Also fold this section's own pages (the sidebar's link list) into the
	    drawer, below the site tabs. On when the page has no sidebar of its own —
	    a section subpage — so its sibling pages stay reachable from the hamburger.
	    Off on the section index, whose sidebar already lists them. */
	sectionLinks?: boolean;
	/** Owner state, so owner-only section links show only for the owner. */
	owner?: boolean;
	/** Show the nav at every width, not just below 820px. On when it lives in a
	    drawer that stays available on wide screens too (a subpage whose section
	    has its own pages — see SiteHeader's ownDrawerWide). */
	always?: boolean;
}

const {
	pathname,
	theme = 'root',
	divider = true,
	sectionLinks = false,
	owner = false,
	always = false,
} = Astro.props;
const nav = siteNav(pathname);
const section = sectionLinks ? sectionNav(theme, pathname, owner) : [];
const style = headerThemeStyle(theme);
---

<nav class:list={['dnav', !divider && 'dnav--flush', always && 'dnav--always']} style={style} aria-label="Sections">
	{
		nav.map((n) =>
			n.children ? (
				// The Journal tab is a submenu, not a flat dump of the four logs: a
				// native <details> so it toggles with no JS, opened by default when
				// you're already inside one of the logs.
				<details class="dnav__group" open={n.children.some((c) => c.active) || undefined}>
					<summary class:list={['dnav__row', 'dnav__summary', n.active && 'dnav__row--active']}>
						{/* The label is a link to the month in review; only the caret
						    (the rest of the summary) opens the submenu. */}
						<a class="dnav__label" href={n.href} aria-current={n.active ? 'page' : undefined}>
							{n.label}
						</a>
						<svg class="dnav__caret" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
							<path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
						</svg>
					</summary>
					<div class="dnav__kids">
						{n.children.map((c) => (
							<a
								class:list={['dnav__kid', c.active && 'dnav__kid--active']}
								href={c.href}
								aria-current={c.active ? 'page' : undefined}
							>
								{c.label}
							</a>
						))}
					</div>
				</details>
			) : (
				<a
					class:list={['dnav__row', n.active && 'dnav__row--active']}
					href={n.href}
					aria-current={n.active ? 'page' : undefined}
				>
					{n.label}
				</a>
			),
		)
	}
	{
		// The section's own pages, folded in below the site tabs so a subpage's
		// siblings stay reachable from the hamburger. Only rendered when asked
		// (sectionLinks) — the section index leaves this to its full sidebar.
		section.length > 0 && (
			<div class="dnav__section">
				{section.map((s) => (
					<a
						class:list={['dnav__row', 'dnav__sectionrow', s.active && 'dnav__row--active']}
						href={s.href}
						aria-current={s.active ? 'page' : undefined}
					>
						{s.label}
					</a>
				))}
			</div>
		)
	}
</nav>

<style>
	/* Desktop shows the tabs in the header strip, so this stays hidden there; it
	   only appears once the drawer itself is in play. */
	.dnav {
		display: none;
	}
	@media (max-width: 820px) {
		.dnav {
			display: block;
			margin-bottom: 22px;
			padding-bottom: 16px;
			border-bottom: 1px solid var(--sh-border);
		}
		.dnav--flush {
			margin-bottom: 0;
			padding-bottom: 0;
			border-bottom: none;
		}
	}
	/* Shown at every width — for drawers that stay in play on wide screens. It's
	   always flush there (the header's own drawer), so no divider handling needed. */
	.dnav--always {
		display: block;
	}
	.dnav__row {
		display: block;
		padding: 8px 0;
		font-family: var(--sh-font);
		font-size: 15px;
		color: var(--sh-link);
		text-decoration: none;
	}
	.dnav__row--active {
		color: var(--sh-active);
		font-weight: 600;
	}
	/* Journal's summary row: the label + a caret, no default disclosure triangle. */
	.dnav__summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		list-style: none;
		cursor: pointer;
	}
	.dnav__summary::-webkit-details-marker {
		display: none;
	}
	.dnav__label {
		color: inherit;
		font: inherit;
		text-decoration: none;
	}
	/* The caret's tap target: the whole right-hand end of the row, which is
	   summary surface, so a tap there toggles instead of navigating. */
	.dnav__caret {
		flex: none;
		box-sizing: content-box;
		padding: 6px 0 6px 24px;
	}
	.dnav__group[open] .dnav__caret {
		transform: rotate(180deg);
	}
	/* The four logs, as an indented vertical submenu under Journal. */
	.dnav__kids {
		display: flex;
		flex-direction: column;
		padding: 2px 0 6px 14px;
	}
	.dnav__kid {
		font-family: var(--sh-font);
		font-size: 14px;
		color: var(--sh-link);
		text-decoration: none;
		padding: 7px 0;
	}
	.dnav__kid--active {
		color: var(--sh-active);
		font-weight: 600;
	}
	.dnav__row:hover,
	.dnav__label:hover,
	.dnav__kid:hover {
		color: var(--sh-hover);
	}

	/* The section's own pages, set off from the site tabs above by a hairline —
	   this is "where you are" (the log) versus "the rest of the site". */
	.dnav__section {
		margin-top: 14px;
		padding-top: 12px;
		border-top: 1px solid var(--sh-border);
	}
	.dnav__sectionrow {
		font-size: 14px;
	}
</style>
