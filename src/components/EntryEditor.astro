			grid-template-columns: 1fr;
		}
		.cal {
			right: auto;
			left: 0;
		}
	}
</style>

<script>
	// Owner-only. Astro always hoists this script; bail out when the modal isn't
	// in the DOM (a non-owner viewing the page).
	const modal = document.getElementById('ee-modal') as HTMLDivElement | null;
	const configEl = document.getElementById('ee-config');

	if (modal && configEl) {
		interface Film {
			tmdbId: number;
			title: string;
			year: number | null;
			poster: string | null;
		}
		interface Initial {
			date: string;
			rating: number | null;
			liked: boolean;
			rewatch: boolean;
			medium: string | null;
			otherMedium: string;
			venue: string;
			format: string;
			review: string;
			tags: string[];
			friends: string[];
		}
		interface Config {
			mode: 'select' | 'edit';
			logId: number | null;
			redirect: string;
			today: string;
			venueOptions: string[];
			formatOptions: string[];
			tagOptions: string[];
			friendOptions: string[];
			initial: Initial | null;
			film: Film | null;
		}

		const cfg = JSON.parse(configEl.textContent || '{}') as Config;
		const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
		const IMG = 'https://image.tmdb.org/t/p/w92';

		const backdrop = $('ee-backdrop');
		const panel = $<HTMLDivElement>('ee-panel');
		const closeBtn = $('ee-close');
		const titleEl = $<HTMLSpanElement>('ee-title');
		const leftBtn = $<HTMLButtonElement>('ee-left');
		const save = $<HTMLButtonElement>('ee-save');
		const msg = $<HTMLSpanElement>('ee-msg');
		const fullForm = $<HTMLDivElement>('ee-full');
		const filmRow = $<HTMLDivElement>('ee-film-row');
		const dateField = $<HTMLDivElement>('ee-date-field');
		const discard = $<HTMLDivElement>('ee-discard');
		const discardTitle = $<HTMLDivElement>('ee-discard-title');
		const discardMsg = $<HTMLDivElement>('ee-discard-msg');
		const discardKeep = $('ee-discard-keep');
		const discardConfirm = $('ee-discard-confirm');

		// Film picker (absent in edit mode, where the film is locked).
		const q = $<HTMLInputElement>('ee-q');
		const results = $<HTMLUListElement>('ee-results');
		const searchWrap = $('ee-search');
		const selected = $('ee-selected');
		const selPoster = $<HTMLImageElement>('ee-sel-poster');
		const selTitle = $<HTMLSpanElement>('ee-sel-title');
		const selYear = $<HTMLSpanElement>('ee-sel-year');
		const priorHint = $<HTMLDivElement>('ee-prior');
		const change = $('ee-change');

		const dateBtn = $<HTMLButtonElement>('ee-date');
		const cal = $<HTMLDivElement>('ee-cal');
		const calGrid = $<HTMLDivElement>('ee-cal-grid');
		const calMonth = $<HTMLSpanElement>('ee-cal-month');
		const calPrev = $('ee-cal-prev');
		const calNext = $('ee-cal-next');

		const reviewInput = $<HTMLTextAreaElement>('ee-review');
		const likeBtn = $<HTMLButtonElement>('ee-like');
		const rewatchBtn = $<HTMLButtonElement>('ee-rewatch');
		const fill = $<HTMLSpanElement>('ee-sp-fill');
		const hits = $<HTMLSpanElement>('ee-sp-hits');
		const ratingLabel = $<HTMLSpanElement>('ee-rating-label');
		const mediums = $<HTMLDivElement>('ee-mediums');
		const theaterFields = $<HTMLDivElement>('ee-theater-fields');
		const otherField = $<HTMLDivElement>('ee-other-field');
		const venueInput = $<HTMLInputElement>('ee-venue');
		const formatInput = $<HTMLInputElement>('ee-format');
		const otherInput = $<HTMLInputElement>('ee-other');
		const venueSuggest = $<HTMLUListElement>('ee-venue-suggest');
		const formatSuggest = $<HTMLUListElement>('ee-format-suggest');
		const tagInput = $<HTMLInputElement>('ee-tag-input');
		const tagSuggest = $<HTMLUListElement>('ee-tag-suggest');
		const tagChipsBox = $<HTMLDivElement>('ee-tag-chips');
		const friendInput = $<HTMLInputElement>('ee-friend-input');
		const friendSuggest = $<HTMLUListElement>('ee-friend-suggest');
		const friendChipsBox = $<HTMLDivElement>('ee-friend-chips');
		const mediumBtns = Array.from(mediums.querySelectorAll<HTMLButtonElement>('button[data-medium]'));

		const isEdit = cfg.mode === 'edit';
		// `select` promotes itself to `log` once a film is chosen, so this is state,
		// not a constant.
		let mode: 'log' | 'edit' | 'select' = cfg.mode;

		let tmdbId: number | null = isEdit ? (cfg.film?.tmdbId ?? null) : null;
		let date: string = cfg.initial?.date || cfg.today;
		let rating: number | null = null;
		let liked = false;
		let rewatch = false;
		let medium: string | null = null; // 'theater'|'tv'|'computer'|'plane'|'other'|null

		// ---- Calendar ----
		const MONTHS = [
			'January', 'February', 'March', 'April', 'May', 'June',
			'July', 'August', 'September', 'October', 'November', 'December',
		];
		const WEEKDAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
		let calY = 0;
		let calM = 0;

		const parseIso = (iso: string): [number, number, number] | null => {
			const p = iso.split('-').map(Number);
			return p.length === 3 && p.every(Number.isInteger) ? [p[0], p[1], p[2]] : null;
		};
		const toIso = (y: number, m: number, d: number) =>
			`${y}-${String(m + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;

		function renderDateLabel() {
			const p = parseIso(date);
			if (!p) {
				dateBtn.textContent = 'Select a date';
				return;
			}
			const dt = new Date(p[0], p[1] - 1, p[2]);
			dateBtn.textContent = `${WEEKDAYS[dt.getDay()]}, ${MONTHS[p[1] - 1].slice(0, 3)} ${p[2]}, ${p[0]}`;
		}
		function renderCal() {
			calMonth.textContent = `${MONTHS[calM]} ${calY}`;
			calGrid.textContent = '';
			const lead = new Date(calY, calM, 1).getDay();
			const days = new Date(calY, calM + 1, 0).getDate();
			for (let i = 0; i < lead; i++) calGrid.appendChild(document.createElement('span'));
			for (let d = 1; d <= days; d++) {
				const iso = toIso(calY, calM, d);
				const b = document.createElement('button');
				b.type = 'button';
				b.textContent = String(d);
				if (iso === date) b.classList.add('on');
				b.addEventListener('click', () => {
					date = iso;
					renderDateLabel();
					closeCal();
				});
				calGrid.appendChild(b);
			}
		}
		function openCal() {
			const p = parseIso(date) ?? parseIso(cfg.today)!;
			calY = p[0];
			calM = p[1] - 1;
			renderCal();
			cal.hidden = false;
		}
		function closeCal() {
			cal.hidden = true;
		}
		dateBtn.addEventListener('click', () => (cal.hidden ? openCal() : closeCal()));
		calPrev.addEventListener('click', () => {
			if (--calM < 0) {
				calM = 11;
				calY--;
			}
			renderCal();
		});
		calNext.addEventListener('click', () => {
			if (++calM > 11) {
				calM = 0;
				calY++;
			}
			renderCal();
		});
		document.addEventListener('click', (e) => {
			const t = e.target as Node;
			if (!cal.hidden && !cal.contains(t) && !dateBtn.contains(t)) closeCal();
		});

		// ---- TMDB search (log / select modes) ----
		if (q) {
			let timer: number | undefined;
			q.addEventListener('input', () => {
				window.clearTimeout(timer);
				const query = q.value.trim();
				if (!query) return hideResults();
				timer = window.setTimeout(() => runSearch(query), 300);
			});
			q.addEventListener('focus', () => {
				const query = q.value.trim();
				if (query) runSearch(query);
			});
			document.addEventListener('click', (e) => {
				if (!searchWrap.contains(e.target as Node)) hideResults();
			});
			change.addEventListener('click', () => {
				tmdbId = null;
				selected.hidden = true;
				searchWrap.hidden = false;
				save.disabled = true;
				q.value = '';
				resetEntryFields();
				q.focus();
			});
		}
		async function runSearch(query: string) {
			try {
				const res = await fetch(`/api/tmdb/search?query=${encodeURIComponent(query)}`);
				if (!res.ok) return hideResults();
				const data = await res.json();
				renderResults(data.results ?? []);
			} catch {
				hideResults();
			}
		}
		function renderResults(items: any[]) {
			results.textContent = '';
			if (!items.length) return hideResults();
			for (const m of items.slice(0, 8)) {
				const li = document.createElement('li');
				const img = document.createElement('img');
				if (m.poster_path) img.src = IMG + m.poster_path;
				img.alt = '';
				const label = document.createElement('span');
				label.textContent = m.title;
				if (m.release_date) {
					const yr = document.createElement('span');
					yr.className = 'r-year';
					yr.textContent = m.release_date.slice(0, 4);
					label.appendChild(yr);
				}
				li.append(img, label);
				li.addEventListener('click', () => selectMovie(m));
				results.appendChild(li);
			}
			results.hidden = false;
		}
		function hideResults() {
			results.hidden = true;
			results.textContent = '';
		}
		function selectMovie(m: any) {
			tmdbId = m.id;
			selTitle.textContent = m.title;
			selYear.textContent = m.release_date ? m.release_date.slice(0, 4) : '';
			if (m.poster_path) {
				selPoster.src = IMG + m.poster_path;
				selPoster.hidden = false;
			} else {
				selPoster.removeAttribute('src');
				selPoster.hidden = true;
			}
			hideResults();
			searchWrap.hidden = true;
			selected.hidden = false;
			save.disabled = false;
			// Picking a film in `select` mode is what turns it into a log entry.
			if (mode === 'select') {
				mode = 'log';
				renderMode();
			}
			// A film's rating/like/rewatch is film-specific — start each entry clean,
			// then let the prior-watch lookup suggest a rewatch.
			resetEntryFields();
			loadPrior(m.id);
		}
		// Clear rating / like / rewatch / prior hint, keeping film + date + review.
		function resetEntryFields() {
			rating = null;
			setFill(0);
			ratingLabel.textContent = 'Not rated';
			liked = false;
			likeBtn.classList.remove('on');
			rewatch = false;
			rewatchBtn.classList.remove('on');
			priorHint.hidden = true;
			priorHint.textContent = '';
		}
		// Look up whether this film was watched before; if so, suggest a rewatch and
		// pre-fill the previous rating/like. Guarded against a stale response when
		// the user switches films mid-request.
		async function loadPrior(id: number) {
			try {
				const res = await fetch(`/api/films/prior-watch?tmdbId=${id}`);
				if (!res.ok) return;
				const prior = await res.json();
				if (tmdbId !== id || !prior.watched) return;
				rewatch = true;
				rewatchBtn.classList.add('on');
				if (prior.rating != null) {
					rating = prior.rating;
					setFill(rating);
					ratingLabel.textContent = labelFor(rating);
				}
				liked = Boolean(prior.liked);
				likeBtn.classList.toggle('on', liked);
				const n = prior.logCount;
				priorHint.textContent =
					n > 0
						? `Logged ${n} time${n === 1 ? '' : 's'} before — marked as a rewatch.`
						: `You've watched this before — marked as a rewatch.`;
				priorHint.hidden = false;
			} catch {
				/* network hiccup — leave the entry clean */
			}
		}

		// ---- Half-star picker (10 hotspots over 5 stars) ----
		const setFill = (value: number) => {
			fill.style.width = `${(value / 5) * 100}%`;
		};
		const labelFor = (v: number) => (v === 0 ? 'Not rated' : `${Math.floor(v)}${v % 1 ? '½' : ''}★`);
		for (let i = 1; i <= 10; i++) {
			const hit = document.createElement('span');
			const value = i / 2;
			hit.addEventListener('mousemove', () => {
				setFill(value);
				ratingLabel.textContent = labelFor(value);
			});
			hit.addEventListener('click', () => {
				rating = value;
				setFill(value);
				ratingLabel.textContent = labelFor(value);
			});
			hits.appendChild(hit);
		}
		hits.addEventListener('mouseleave', () => {
			setFill(rating ?? 0);
			ratingLabel.textContent = labelFor(rating ?? 0);
		});

		likeBtn.addEventListener('click', () => {
			liked = !liked;
			likeBtn.classList.toggle('on', liked);
		});
		rewatchBtn.addEventListener('click', () => {
			rewatch = !rewatch;
			rewatchBtn.classList.toggle('on', rewatch);
		});

		// ---- Medium picker (single-select; click active to deselect) ----
		function renderMedium() {
			for (const b of mediumBtns) b.classList.toggle('on', b.dataset.medium === medium);
			theaterFields.hidden = medium !== 'theater';
			otherField.hidden = medium !== 'other';
		}
		for (const b of mediumBtns) {
			b.addEventListener('click', () => {
				const m = b.dataset.medium ?? null;
				medium = medium === m ? null : m;
				renderMedium();
			});
		}

		// ---- Free-text autocomplete shared by venue + format ----
		function wireSuggest(input: HTMLInputElement, list: HTMLUListElement, options: string[]) {
			let active = -1;
			const candidates = () => {
				const token = input.value.trim().toLowerCase();
				return options
					.filter((o) => o.toLowerCase() !== token)
					.filter((o) => !token || o.toLowerCase().includes(token))
					.slice(0, 6);
			};
			const render = () => {
				const items = candidates();
				list.textContent = '';
				active = -1;
				if (!items.length) {
					list.hidden = true;
					return;
				}
				for (const o of items) {
					const li = document.createElement('li');
					li.textContent = o;
					li.addEventListener('mousedown', (e) => {
						e.preventDefault();
						input.value = o;
						list.hidden = true;
					});
					list.appendChild(li);
				}
				list.hidden = false;
			};
			input.addEventListener('input', render);
			input.addEventListener('focus', render);
			input.addEventListener('blur', () => {
				list.hidden = true;
			});
			input.addEventListener('keydown', (e) => {
				const lis = Array.from(list.querySelectorAll('li'));
				if (!lis.length) return;
				if (e.key === 'Enter' && active >= 0) {
					e.preventDefault();
					input.value = lis[active].textContent || '';
					list.hidden = true;
				} else if (e.key === 'ArrowDown') {
					e.preventDefault();
					active = (active + 1) % lis.length;
					lis.forEach((li, i) => li.classList.toggle('active', i === active));
				} else if (e.key === 'ArrowUp') {
					e.preventDefault();
					active = (active - 1 + lis.length) % lis.length;
					lis.forEach((li, i) => li.classList.toggle('active', i === active));
				}
			});
		}
		wireSuggest(venueInput, venueSuggest, cfg.venueOptions);
		wireSuggest(formatInput, formatSuggest, cfg.formatOptions);

		// ---- Chip fields: free-text values as removable chips, with autocomplete over
		// the names already in the database. Tags and "watched with" are the same
		// interaction, so they share one implementation.
		interface ChipField {
			get(): string[];
			set(values: string[]): void;
			hideSuggest(): void;
		}
		function wireChips(
			input: HTMLInputElement,
			suggest: HTMLUListElement,
			chipsBox: HTMLDivElement,
			options: string[],
			removeLabel: (name: string) => string,
		): ChipField {
			let values: string[] = [];
			let active = -1;

			function renderChips() {
				chipsBox.textContent = '';
				values.forEach((v, i) => {
					const chip = document.createElement('span');
					chip.className = 'chip';
					chip.append(v);
					const x = document.createElement('button');
					x.type = 'button';
					x.setAttribute('aria-label', removeLabel(v));
					x.textContent = '✕';
					x.addEventListener('click', () => remove(i));
					chip.appendChild(x);
					chipsBox.appendChild(chip);
				});
				chipsBox.hidden = values.length === 0;
			}
			function remove(i: number) {
				values.splice(i, 1);
				renderChips();
				renderSuggest();
			}
			function commit(raw: string) {
				const name = raw.trim();
				if (name && !values.some((v) => v.toLowerCase() === name.toLowerCase())) values.push(name);
				input.value = '';
				renderChips();
				renderSuggest();
			}
			function candidates(): string[] {
				const token = input.value.trim().toLowerCase();
				const used = new Set(values.map((v) => v.toLowerCase()));
				return options
					.filter((o) => !used.has(o.toLowerCase()))
					.filter((o) => !token || o.toLowerCase().includes(token))
					.slice(0, 6);
			}
			function renderSuggest() {
				const items = candidates();
				suggest.textContent = '';
				active = -1;
				if (!items.length) {
					suggest.hidden = true;
					return;
				}
				for (const o of items) {
					const li = document.createElement('li');
					li.textContent = o;
					li.addEventListener('mousedown', (e) => {
						e.preventDefault();
						commit(o);
					});
					suggest.appendChild(li);
				}
				suggest.hidden = false;
			}

			input.addEventListener('input', renderSuggest);
			input.addEventListener('focus', renderSuggest);
			input.addEventListener('blur', () => {
				suggest.hidden = true;
			});
			input.addEventListener('keydown', (e) => {
				const lis = Array.from(suggest.querySelectorAll('li'));
				if (e.key === 'Enter') {
					e.preventDefault();
					if (active >= 0 && lis[active]) commit(lis[active].textContent || '');
					else commit(input.value);
				} else if (e.key === 'ArrowDown' && lis.length) {
					e.preventDefault();
					active = (active + 1) % lis.length;
					lis.forEach((li, i) => li.classList.toggle('active', i === active));
				} else if (e.key === 'ArrowUp' && lis.length) {
					e.preventDefault();
					active = (active - 1 + lis.length) % lis.length;
					lis.forEach((li, i) => li.classList.toggle('active', i === active));
				} else if (e.key === 'Backspace' && !input.value && values.length) {
					remove(values.length - 1);
				}
			});

			return {
				get: () => values,
				set: (next) => {
					values = [...next];
					renderChips();
				},
				hideSuggest: () => {
					suggest.hidden = true;
				},
			};
		}

		const tagField = wireChips(tagInput, tagSuggest, tagChipsBox, cfg.tagOptions, (t) => `Remove ${t}`);
		const friendField = wireChips(
			friendInput,
			friendSuggest,
			friendChipsBox,
			cfg.friendOptions,
			(f) => `Remove ${f}`,
		);

		// ---- Mode presentation (select ⇄ log) ----
		function renderMode() {
			const select = mode === 'select';
			titleEl.textContent = isEdit ? 'Edit entry' : select ? 'What did you watch?' : 'Log a film';
			fullForm.hidden = select;
			dateField.hidden = select;
			filmRow.classList.toggle('field-grid--solo', select);
			panel.classList.toggle('modal__panel--picker', select);
			save.hidden = select;
		}

		// ---- Dirty tracking ----
		// A JSON snapshot of the form, normalized so hidden fields don't count.
		const snap = () =>
			JSON.stringify({
				date,
				rating,
				liked,
				rewatch,
				medium,
				otherMedium: medium === 'other' ? otherInput.value.trim() : '',
				venue: medium === 'theater' ? venueInput.value.trim() : '',
				format: medium === 'theater' ? formatInput.value.trim() : '',
				review: reviewInput.value.trim(),
				tags: [...tagField.get()].sort(),
				friends: [...friendField.get()].sort(),
			});
		let cleanSnap = '';
		// In log/select mode the film selection is intentionally excluded from the
		// dirty check — picking a film alone isn't "work worth confirming"; a
		// rating, like, rewatch flag, medium, tag, friend, or review is.
		const isDirty = () => snap() !== cleanSnap;

		// Seed every field from the config. Also the reset target when the user
		// discards their edits (edit mode) or closes the composer (log mode).
		function seedForm() {
			const init = cfg.initial;
			mode = cfg.mode;
			date = init?.date || cfg.today;
			rating = init?.rating ?? null;
			liked = init?.liked ?? false;
			rewatch = init?.rewatch ?? false;
			medium = init?.medium ?? null;
			tagField.set(init?.tags ?? []);
			friendField.set(init?.friends ?? []);
			venueInput.value = init?.venue ?? '';
			formatInput.value = init?.format ?? '';
			otherInput.value = init?.otherMedium ?? '';
			reviewInput.value = init?.review ?? '';
			tagInput.value = '';
			friendInput.value = '';

			setFill(rating ?? 0);
			ratingLabel.textContent = labelFor(rating ?? 0);
			likeBtn.classList.toggle('on', liked);
			rewatchBtn.classList.toggle('on', rewatch);
			renderMedium();
			renderDateLabel();
			renderMode();
			tagField.hideSuggest();
			friendField.hideSuggest();
			venueSuggest.hidden = true;
			formatSuggest.hidden = true;
			closeCal();
			msg.className = 'save-msg';
			msg.textContent = '';

			if (!isEdit) {
				tmdbId = null;
				q.value = '';
				selected.hidden = true;
				searchWrap.hidden = false;
				priorHint.hidden = true;
				priorHint.textContent = '';
				hideResults();
			}
			save.disabled = !isEdit && tmdbId == null;
			cleanSnap = snap();
		}

		// ---- Open / close ----
		const lockScroll = (on: boolean) => {
			document.body.style.overflow = on ? 'hidden' : '';
		};
		const openModal = () => {
			seedForm();
			discard.hidden = true;
			modal.hidden = false;
			lockScroll(true);
			if (!isEdit) q.focus();
		};
		const closeModal = () => {
			modal.hidden = true;
			discard.hidden = true;
			lockScroll(false);
		};
		const attemptClose = () => {
			if (isDirty()) {
				discardTitle.textContent = isEdit ? 'Discard changes?' : 'Discard this entry?';
				discardMsg.textContent = isEdit
					? 'You have unsaved edits to this entry.'
					: 'Your entry has unsaved changes.';
				discard.hidden = false;
			} else {
				closeModal();
			}
		};

		for (const el of document.querySelectorAll('[data-open-entry-editor]')) {
			el.addEventListener('click', openModal);
		}
		closeBtn.addEventListener('click', attemptClose);
		backdrop.addEventListener('click', attemptClose);
		discardKeep.addEventListener('click', () => {
			discard.hidden = true;
		});
		discardConfirm.addEventListener('click', closeModal);
		document.addEventListener('keydown', (e) => {
			if (e.key !== 'Escape' || modal.hidden) return;
			if (!discard.hidden) discard.hidden = true;
			else if (!cal.hidden) closeCal();
			else attemptClose();
		});

		// ---- Save / delete ----
		// 'other' sends its free-text value as the medium; theater carries venue+format.
		const payload = () => ({
			watchedDate: date || null,
			rating,
			reviewText: reviewInput.value,
			rewatched: rewatch,
			liked,
			tags: tagField.get(),
			friends: friendField.get(),
			medium: medium === 'other' ? otherInput.value.trim() || null : medium,
			venue: medium === 'theater' ? venueInput.value.trim() || null : null,
			format: medium === 'theater' ? formatInput.value.trim() || null : null,
		});
		const loginRedirect = () => {
			window.location.href = `/films/login?redirect=${encodeURIComponent(cfg.redirect)}`;
		};

		save.addEventListener('click', async () => {
			if (!isEdit && !tmdbId) return;
			save.disabled = true;
			msg.className = 'save-msg';
			msg.textContent = 'Saving…';
			try {
				const res = isEdit
					? await fetch(`/api/films/logs/${cfg.logId}`, {
							method: 'PATCH',
							headers: { 'content-type': 'application/json' },
							body: JSON.stringify(payload()),
						})
					: await fetch('/api/films/logs', {
							method: 'POST',
							headers: { 'content-type': 'application/json' },
							body: JSON.stringify({ tmdbId, ...payload() }),
						});
				if (res.status === 401) return loginRedirect();
				const data = await res.json();
				if (!res.ok) throw new Error(data.error || 'Save failed');
				// The page renders from the DB, so a reload is the refresh.
				window.location.reload();
			} catch (err) {
				msg.className = 'save-msg error';
				msg.textContent = err instanceof Error ? err.message : 'Save failed';
				save.disabled = false;
			}
		});

		// Left footer button: "Delete entry" in edit mode, "Cancel" otherwise.
		if (isEdit) {
			leftBtn.addEventListener('click', async () => {
				if (!window.confirm('Delete this diary entry? This cannot be undone.')) return;
				leftBtn.disabled = true;
				save.disabled = true;
				msg.className = 'save-msg';
				msg.textContent = 'Deleting…';
				try {
					const res = await fetch(`/api/films/logs/${cfg.logId}`, { method: 'DELETE' });
					if (res.status === 401) return loginRedirect();
					if (!res.ok) {
						const data = await res.json().catch(() => ({}));
						throw new Error(data.error || 'Delete failed');
					}
					window.location.href = '/films/diary';
				} catch (err) {
					msg.className = 'save-msg error';
					msg.textContent = err instanceof Error ? err.message : 'Delete failed';
					leftBtn.disabled = false;
					save.disabled = false;
				}
			});
		} else {
			leftBtn.addEventListener('click', attemptClose);
		}
	}
</script>
