---
// Shared diary entry modal. Pages open it in one of two modes:
//   select — film picker only ("What did you watch?"). Picking a film promotes
//            the modal to `log` in place: the full entry form.
//   edit   — amend an existing entry; the film is locked.
//
// `log` is therefore a runtime state rather than an entry point — logging always
// starts by asking which film.
//
// Pages render their own trigger; any element carrying [data-open-entry-editor]
// opens the modal. Server data reaches the client through the JSON config tag.
export interface EntryEditorFilm {
	tmdbId: number;
	title: string;
	year: number | null;
	poster: string | null;
}

export interface EntryEditorInitial {
	date: string;
	rating: number | null;
	liked: boolean;
	rewatch: boolean;
	medium: string | null;
	otherMedium: string;
	venue: string;
	format: string;
	review: string;
	tags: string[];
	friends: string[];
}

interface Props {
	mode: 'select' | 'edit';
	venueOptions: string[];
	tagOptions: string[];
	friendOptions: string[];
	/** Where to send the user after a 401, and back to after saving. */
	redirect: string;
	/** edit mode only. */
	logId?: number | null;
	film?: EntryEditorFilm | null;
	initial?: EntryEditorInitial | null;
}

const {
	mode,
	venueOptions,
	tagOptions,
	friendOptions,
	redirect,
	logId = null,
	film = null,
	initial = null,
} = Astro.props;

const FORMAT_OPTIONS = [
	'Digital',
	'35mm',
	'70mm',
	'IMAX',
	'IMAX 70mm',
	'IMAX 3D',
	'3D',
	'Dolby Cinema',
	'VistaVision',
	'DCP',
];

const today = new Date().toISOString().slice(0, 10);
const config = {
	mode,
	logId,
	redirect,
	today,
	venueOptions,
	formatOptions: FORMAT_OPTIONS,
	tagOptions,
	friendOptions,
	initial,
	film,
};
// Escape "<" so a review containing "</script>" can't break out of the JSON tag.
const configJson = JSON.stringify(config).replace(/</g, '\\u003c');

const headTitle = mode === 'edit' ? 'Edit entry' : 'What did you watch?';
---

<div class="modal" id="ee-modal" hidden>
	<div class="modal__backdrop" id="ee-backdrop"></div>
	<div class="modal__panel" id="ee-panel" role="dialog" aria-modal="true" aria-labelledby="ee-title">
		<div class="modal__head">
			<span class="modal__title" id="ee-title">{headTitle}</span>
			<button type="button" class="modal__close" id="ee-close" aria-label="Close">✕</button>
		</div>

		<div class="discard" id="ee-discard" hidden>
			<div class="discard__box">
				<div class="discard__title" id="ee-discard-title">
					{mode === 'edit' ? 'Discard changes?' : 'Discard this entry?'}
				</div>
				<div class="discard__msg" id="ee-discard-msg">
					{
						mode === 'edit'
							? 'You have unsaved edits to this entry.'
							: 'Your entry has unsaved changes.'
					}
				</div>
				<div class="discard__actions">
					<button type="button" class="btn-ghost" id="ee-discard-keep">Keep editing</button>
					<button type="button" class="btn-discard" id="ee-discard-confirm">Discard</button>
				</div>
			</div>
		</div>

		<div class="modal__body">
			<div class="field-grid" id="ee-film-row">
				<div class="film-field">
					<label class="lbl" for="ee-q">Film</label>

					{
						mode === 'edit' && film ? (
							<div class="selected selected--locked">
								<div class="selected__poster">{film.poster && <img src={film.poster} alt="" />}</div>
								<div class="selected__info">
									<div class="selected__title">
										{film.title}
										{film.year && <span class="selected__year">{film.year}</span>}
									</div>
								</div>
							</div>
						) : (
							<>
								<div class="search" id="ee-search">
									<input type="text" id="ee-q" placeholder="Search a film…" autocomplete="off" />
									<ul class="results" id="ee-results" hidden />
								</div>
								<div class="selected" id="ee-selected" hidden>
									<div class="selected__poster">
										<img id="ee-sel-poster" alt="" />
									</div>
									<div class="selected__info">
										<div class="selected__title">
											<span id="ee-sel-title" />
											<span class="selected__year" id="ee-sel-year" />
										</div>
									</div>
									<button type="button" class="selected__change" id="ee-change">
										Change
									</button>
								</div>
								<div class="prior-hint" id="ee-prior" hidden />
							</>
						)
					}
				</div>

				<div class="date-field" id="ee-date-field">
					<label class="lbl" for="ee-date">Watched</label>
					<button type="button" class="datebtn" id="ee-date" aria-haspopup="dialog">Select a date</button>
					<div class="cal" id="ee-cal" role="dialog" aria-label="Choose a date" hidden>
						<div class="cal__head">
							<button type="button" class="cal__nav" id="ee-cal-prev" aria-label="Previous month">‹</button>
							<span class="cal__month" id="ee-cal-month"></span>
							<button type="button" class="cal__nav" id="ee-cal-next" aria-label="Next month">›</button>
						</div>
						<div class="cal__wd">
							<span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span
							><span>Sa</span>
						</div>
						<div class="cal__grid" id="ee-cal-grid"></div>
					</div>
				</div>
			</div>

			<div class="full-form" id="ee-full">
				<div>
					<label class="lbl">Rating</label>
					<div class="rating-row">
						<span class="starpicker" id="ee-starpicker">
							<span class="sp-empty">★★★★★</span>
							<span class="sp-fill" id="ee-sp-fill"></span>
							<span class="sp-hits" id="ee-sp-hits"></span>
						</span>
						<span class="rating-label" id="ee-rating-label">Not rated</span>
						<div class="toggles">
							<button type="button" class="toggle" id="ee-like">♥ Like</button>
							<button type="button" class="toggle" id="ee-rewatch">↻ Rewatch</button>
						</div>
					</div>
				</div>

				<div>
					<label class="lbl">Medium</label>
					<div class="mediums" id="ee-mediums">
						<button type="button" class="toggle" data-medium="theater">Theater</button>
						<button type="button" class="toggle" data-medium="tv">TV</button>
						<button type="button" class="toggle" data-medium="computer">Computer</button>
						<button type="button" class="toggle" data-medium="plane">Airplane</button>
						<button type="button" class="toggle" data-medium="other">Other…</button>
					</div>
					<div class="theater-fields" id="ee-theater-fields" hidden>
						<div class="suggest-field">
							<label class="lbl" for="ee-venue">Theater</label>
							<input type="text" id="ee-venue" placeholder="e.g. Metrograph, NYC" autocomplete="off" />
							<ul class="suggest" id="ee-venue-suggest" hidden></ul>
						</div>
						<div class="suggest-field">
							<label class="lbl" for="ee-format">Format</label>
							<input type="text" id="ee-format" placeholder="e.g. 35mm, IMAX, 70mm" autocomplete="off" />
							<ul class="suggest" id="ee-format-suggest" hidden></ul>
						</div>
					</div>
					<div class="other-field" id="ee-other-field" hidden>
						<label class="lbl" for="ee-other">Other medium</label>
						<input type="text" id="ee-other" placeholder="e.g. projector, phone, drive-in…" autocomplete="off" />
					</div>
				</div>

				<div class="chips-field">
					<label class="lbl" for="ee-friend-input">Watched with</label>
					<input
						type="text"
						id="ee-friend-input"
						placeholder="Tag a friend, press Enter…"
						autocomplete="off"
					/>
					<ul class="chips-suggest" id="ee-friend-suggest" hidden></ul>
					<div class="chips-box" id="ee-friend-chips" hidden></div>
				</div>

				<div>
					<label class="lbl" for="ee-review">Review</label>
					<textarea id="ee-review" rows="4" placeholder="Add your thoughts…"></textarea>
				</div>

				<div class="chips-field">
					<label class="lbl" for="ee-tag-input">Tags</label>
					<input type="text" id="ee-tag-input" placeholder="Type a tag, press Enter…" autocomplete="off" />
					<ul class="chips-suggest" id="ee-tag-suggest" hidden></ul>
					<div class="chips-box" id="ee-tag-chips" hidden></div>
				</div>
			</div>
		</div>

		<div class="modal__foot">
			<button type="button" class={mode === 'edit' ? 'btn-delete' : 'btn-ghost'} id="ee-left">
				{mode === 'edit' ? 'Delete entry' : 'Cancel'}
			</button>
			<span class="save-msg" id="ee-msg"></span>
			<button type="button" class="btn-save" id="ee-save" hidden={mode === 'select'}>
				{mode === 'edit' ? 'Save changes' : 'Log film'}
			</button>
		</div>
	</div>
</div>

<script type="application/json" id="ee-config" set:html={configJson} />

<style>
	.modal {
		position: fixed;
		inset: 0;
		z-index: 50;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding: 56px 24px;
	}
	.modal[hidden] {
		display: none;
	}
	.modal__backdrop {
		position: absolute;
		inset: 0;
		background: rgba(10, 4, 5, 0.72);
		backdrop-filter: blur(3px);
	}
	.modal__panel {
		position: relative;
		width: 100%;
		max-width: 560px;
		max-height: calc(100vh - 112px);
		display: flex;
		flex-direction: column;
		background: #241012;
		border: 1px solid #4a2529;
		border-radius: 14px;
		box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.7);
		overflow: hidden;
	}
	.modal__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 20px 24px;
		border-bottom: 1px solid #402226;
		flex: none;
	}
	.modal__title {
		font-family: 'Newsreader', serif;
		font-style: italic;
		font-size: 22px;
		color: #f4e8d1;
	}
	.modal__close {
		width: 30px;
		height: 30px;
		border: 1px solid #4a2529;
		background: transparent;
		color: #c2a99a;
		border-radius: 7px;
		cursor: pointer;
		font-size: 14px;
		line-height: 1;
	}
	.modal__close:hover {
		background: #402226;
		color: #f4e8d1;
	}
	.modal__body {
		padding: 22px 24px 26px;
		display: flex;
		flex-direction: column;
		gap: 20px;
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
	}
	/* select mode is a short, content-height panel with nothing to scroll, so the
	   search dropdown is free to overhang it rather than be clipped by the
	   scroll container. */
	.modal__panel--picker,
	.modal__panel--picker .modal__body {
		overflow: visible;
	}
	.full-form {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.full-form[hidden] {
		display: none;
	}

	.field-grid {
		display: grid;
		grid-template-columns: 1fr 150px;
		gap: 12px;
		align-items: start;
	}
	/* select mode: film picker only, no date column */
	.field-grid--solo {
		display: block;
	}
	.film-field {
		position: relative;
	}
	.date-field {
		position: relative;
	}
	.date-field[hidden] {
		display: none;
	}
	.lbl {
		display: block;
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 1.4px;
		color: #8a6f63;
		margin-bottom: 7px;
	}
	.search {
		position: relative;
	}
	.search[hidden] {
		display: none;
	}

	#ee-q,
	#ee-review,
	#ee-venue,
	#ee-format,
	#ee-other,
	#ee-tag-input,
	#ee-friend-input {
		width: 100%;
		background: #1c0d0e;
		border: 1px solid #4a2529;
		border-radius: 8px;
		color: #f4e8d1;
		font-family: 'Archivo', sans-serif;
		font-size: 14px;
		padding: 11px 13px;
		outline: none;
	}
	#ee-q:focus,
	#ee-review:focus,
	#ee-venue:focus,
	#ee-format:focus,
	#ee-other:focus,
	#ee-tag-input:focus,
	#ee-friend-input:focus {
		border-color: #d9b45a;
	}
	#ee-review {
		padding: 12px 13px;
		font-family: 'Newsreader', serif;
		color: #f2e5cd;
		line-height: 1.5;
		resize: vertical;
	}

	/* Date button + calendar popover */
	.datebtn {
		width: 100%;
		text-align: left;
		background: #1c0d0e;
		border: 1px solid #4a2529;
		border-radius: 8px;
		padding: 10px 13px;
		color: #f4e8d1;
		font-size: 13px;
		font-family: 'Archivo', sans-serif;
		cursor: pointer;
		outline: none;
	}
	.datebtn:hover,
	.datebtn:focus {
		border-color: #d9b45a;
	}
	.cal {
		position: absolute;
		top: 100%;
		right: 0;
		margin-top: 6px;
		width: 252px;
		background: #241012;
		border: 1px solid #4a2529;
		border-radius: 10px;
		box-shadow: 0 18px 40px -14px rgba(0, 0, 0, 0.7);
		z-index: 20;
		padding: 12px;
	}
	.cal[hidden] {
		display: none;
	}
	.cal__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 10px;
	}
	.cal__nav {
		width: 26px;
		height: 26px;
		border: 1px solid #4a2529;
		background: transparent;
		color: #c2a99a;
		border-radius: 6px;
		cursor: pointer;
		font-size: 14px;
		line-height: 1;
	}
	.cal__nav:hover {
		background: #402226;
		color: #f4e8d1;
	}
	.cal__month {
		font-family: 'Newsreader', serif;
		font-size: 15px;
		color: #f4e8d1;
	}
	.cal__wd {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 2px;
		margin-bottom: 4px;
	}
	.cal__wd span {
		text-align: center;
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		color: #8a6f63;
		padding: 4px 0;
	}
	.cal__grid {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 2px;
	}
	.cal__grid :global(button) {
		text-align: center;
		font-size: 13px;
		padding: 7px 0;
		border: none;
		background: transparent;
		border-radius: 6px;
		cursor: pointer;
		color: #e9d9c4;
		font-family: 'Archivo', sans-serif;
	}
	.cal__grid :global(button:hover) {
		background: #402226;
	}
	.cal__grid :global(button.on) {
		background: #d9b45a;
		color: #2a1214;
		font-weight: 700;
	}
	.cal__grid :global(span) {
		padding: 7px 0;
	}

	/* TMDB search results */
	.results {
		list-style: none;
		margin: 6px 0 0;
		padding: 0;
		position: absolute;
		z-index: 10;
		width: 100%;
		max-height: 280px;
		overflow-y: auto;
		background: #1c0d0e;
		border: 1px solid #4a2529;
		border-radius: 8px;
	}
	.results[hidden] {
		display: none;
	}
	.results :global(li) {
		display: flex;
		gap: 10px;
		align-items: center;
		padding: 7px 9px;
		cursor: pointer;
		color: #e9d9c4;
		font-size: 13px;
	}
	.results :global(li:hover) {
		background: #331619;
	}
	.results :global(img) {
		width: 30px;
		height: 45px;
		object-fit: cover;
		border-radius: 3px;
		background: #4a2529;
		flex-shrink: 0;
	}
	.results :global(.r-year) {
		color: #a2857a;
		margin-left: 6px;
	}
	.results :global(.r-watched) {
		margin-left: auto;
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 1px;
		color: #d9b45a;
		white-space: nowrap;
	}

	.selected {
		display: flex;
		align-items: center;
		gap: 12px;
		background: #1c0d0e;
		border: 1px solid #4a2529;
		border-radius: 8px;
		padding: 8px 10px;
	}
	.selected[hidden] {
		display: none;
	}
	.selected__poster {
		width: 38px;
		height: 57px;
		flex: none;
		border-radius: 4px;
		overflow: hidden;
		background-image: repeating-linear-gradient(135deg, #351a1d 0 7px, #2c1518 7px 14px);
		border: 1px solid #4a2529;
	}
	.selected__poster img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.selected__info {
		flex: 1;
		min-width: 0;
	}
	.selected__title {
		font-family: 'Newsreader', serif;
		font-size: 16px;
		color: #f2e5cd;
		line-height: 1.2;
	}
	.selected__year {
		color: #b0917f;
		font-style: italic;
		font-size: 14px;
		margin-left: 4px;
	}
	.selected__change {
		flex: none;
		font-size: 12px;
		font-weight: 600;
		color: #ddc9b4;
		background: transparent;
		border: 1px solid #4a2529;
		border-radius: 7px;
		padding: 7px 13px;
		cursor: pointer;
		font-family: 'Archivo', sans-serif;
	}
	.selected__change:hover {
		border-color: #d9b45a;
		color: #f4e8d1;
	}
	.prior-hint {
		margin-top: 9px;
		font-size: 12px;
		color: #d9b45a;
		line-height: 1.4;
	}
	.prior-hint[hidden] {
		display: none;
	}

	/* Rating */
	.rating-row {
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
	}
	.starpicker {
		position: relative;
		display: inline-block;
		line-height: 1;
		font-size: 26px;
		cursor: pointer;
		user-select: none;
	}
	.sp-empty {
		color: #4a2529;
	}
	.sp-fill {
		position: absolute;
		top: 0;
		left: 0;
		width: 0;
		overflow: hidden;
		white-space: nowrap;
		color: #d9b45a;
		pointer-events: none;
	}
	.sp-fill::before {
		content: '★★★★★';
	}
	.sp-hits {
		position: absolute;
		inset: 0;
		display: flex;
	}
	.sp-hits :global(span) {
		flex: 1;
	}
	.rating-label {
		font-size: 13px;
		color: #a2857a;
	}
	.toggles {
		display: flex;
		gap: 10px;
		margin-left: auto;
	}
	.toggle {
		font-size: 13px;
		font-weight: 600;
		border-radius: 20px;
		padding: 9px 16px;
		cursor: pointer;
		font-family: 'Archivo', sans-serif;
		background: transparent;
		color: #ddc9b4;
		border: 1px solid #4a2529;
	}
	.toggle.on {
		background: #d9b45a;
		color: #2a1214;
		border-color: #d9b45a;
	}
	.mediums {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}
	.theater-fields {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px;
		margin-top: 12px;
	}
	.theater-fields[hidden],
	.other-field[hidden] {
		display: none;
	}
	.other-field {
		margin-top: 12px;
	}

	/* Venue / format autocomplete (opens downward) */
	.suggest-field {
		position: relative;
	}
	.suggest {
		list-style: none;
		margin: 6px 0 0;
		padding: 0;
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		z-index: 10;
		max-height: 200px;
		overflow-y: auto;
		background: #241012;
		border: 1px solid #4a2529;
		border-radius: 8px;
		box-shadow: 0 18px 40px -14px rgba(0, 0, 0, 0.7);
	}
	.suggest[hidden] {
		display: none;
	}
	.suggest :global(li) {
		padding: 9px 13px;
		cursor: pointer;
		font-size: 14px;
		color: #f2e5cd;
		border-bottom: 1px solid #351a1d;
	}
	.suggest :global(li:last-child) {
		border-bottom: none;
	}
	.suggest :global(li:hover),
	.suggest :global(li.active) {
		background: #331619;
	}

	/* Chip fields (tags, watched-with): input + autocomplete (opens upward) + chips */
	.chips-field {
		position: relative;
	}
	.chips-suggest {
		list-style: none;
		margin: 0;
		padding: 0;
		position: absolute;
		bottom: 100%;
		left: 0;
		right: 0;
		margin-bottom: 6px;
		z-index: 10;
		max-height: 200px;
		overflow-y: auto;
		background: #241012;
		border: 1px solid #4a2529;
		border-radius: 8px;
		box-shadow: 0 -18px 40px -14px rgba(0, 0, 0, 0.7);
	}
	.chips-suggest[hidden] {
		display: none;
	}
	.chips-suggest :global(li) {
		padding: 9px 13px;
