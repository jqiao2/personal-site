	.chips-box :global(.chip) {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-size: 12px;
		color: #ddc9b4;
		border: 1px solid #4a2529;
		border-radius: 20px;
		padding: 4px 8px 4px 12px;
		background: #241012;
	}
	.chips-box :global(.chip button) {
		background: none;
		border: none;
		cursor: pointer;
		color: #a2857a;
		font-size: 13px;
