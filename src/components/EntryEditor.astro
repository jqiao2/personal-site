	/* Footer */
	.modal__foot {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 16px 24px;
		border-top: 1px solid #402226;
		background: #1f0e10;
		flex: none;
		/* Rounds itself rather than relying on the panel to clip it, which the
		   picker variant can't do. */
