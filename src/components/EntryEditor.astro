		inset: 0;
		z-index: 30;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 28px;
		border-radius: 14px;
		background: rgba(15, 6, 7, 0.88);
		backdrop-filter: blur(2px);
	}
	.discard[hidden] {
		display: none;
	}
	.discard__box {
		width: 100%;
		max-width: 360px;
		background: #241012;
		border: 1px solid #4a2529;
		border-radius: 12px;
		padding: 24px;
		text-align: center;
	}
	.discard__title {
		font-family: 'Newsreader', serif;
		font-style: italic;
		font-size: 21px;
		color: #f4e8d1;
		margin-bottom: 8px;
	}
	.discard__msg {
		font-size: 13px;
		color: #a2857a;
		line-height: 1.5;
		margin-bottom: 22px;
	}
	.discard__actions {
		display: flex;
		gap: 10px;
		justify-content: center;
	}
	.btn-discard {
		font-size: 13px;
		font-weight: 700;
		color: #2a1214;
		background: #d9865a;
		border: none;
		border-radius: 8px;
		padding: 9px 18px;
		cursor: pointer;
		font-family: 'Archivo', sans-serif;
