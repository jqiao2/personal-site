---
// The one site header, themed to whichever section it's sitting in.
//
// This replaces the half-dozen hand-copied nav strips that used to live in each
// section's pages — wine tabs in the film log, paper tabs in the book log, the
// menu bar in the restaurant log, and so on. They only ever differed in colour
// and typeface, so the markup is shared here and the look is a `theme` preset:
// same four tabs, same Journal dropdown, same active logic everywhere, painted
// to match the page.
//
// STRUCTURE. Always a full-viewport-width strip (the `100vw` bleed trick), with
// its links held to a section-width column inside. That's what the film and
// activity logs already did from inside their card; every other section is a
// plain top strip, for which the bleed is a no-op. So one structure covers both
// placements.
import { siteNav, sectionNav } from '../lib/nav';
import { requireOwner } from '../lib/auth';
import { headerThemeStyle, type HeaderTheme } from '../lib/header-theme';
import DrawerNav from './DrawerNav.astro';

interface Props {
	/** Pathname used to light the active tab. */
	pathname: string;
	/** Which section's palette to wear. */
	theme?: HeaderTheme;
	/** Width of the inner column, when the page's own column isn't the theme's
	    default — the film subpages run narrower than the film log's 1120px card,
	    and the nav has to line up with whatever is under it. */
	max?: string;
	/** Set by pages that already render their own `[data-site-drawer]` sidebar
	    (home, film/restaurant/activity logs), which doubles as the mobile drawer.
	    When false — every other page — the header supplies its own nav-only drawer
	    so the hamburger menu is universal. Either way the tabs fold into it below
	    820px. */
	sidebar?: boolean;
}

const { pathname, theme = 'root', max, sidebar = false } = Astro.props;
const nav = siteNav(pathname);
const style = headerThemeStyle(theme, max);

// The brand mark: `jq` (the initials, and the JSON processor every backend runs
// on) applied to the section as a jq filter path — so the site reads as one
// pipeline over a life. Home is the identity filter `.` (returns everything, the
// cross-section feed); each section is the path that pulls it out. The `jq` stays
// constant, the accent-coloured filter names the section — the tool is the small
// constant, the hobby it surfaces is the loud part.
const FILTERS: Record<string, string> = {
	root: '.',
	film: '.films',
	book: '.books',
	restaurant: '.meals',
	activity: '.activities',
	subway: '.subway',
};
const filter = FILTERS[theme] ?? FILTERS.root;

// The admin sign-in lives here so every page with a header offers it. A visitor
// gets the "Log in" button + dialog; the owner gets neither (their session is
// already established, and each section passes its own owner controls — "+ Log
// film", "+ Log meal" — through the `actions` slot). requireOwner is safe to
// call on any page: no cookie → false, and it only needs SESSION_SECRET to
// verify a token that's actually present.
const owner = await requireOwner(Astro.cookies);

// When this header supplies its own drawer (a subpage, `sidebar` false) AND the
// section has its own pages to offer, the hamburger + drawer stay live at every
// width — not just below 820px. That's what makes those pages reachable on a
// wide iPad or desktop, where there's no sidebar and the tab strip alone can't
// carry them. Pages with no sub-nav (About, Projects, subway) keep the drawer a
// mobile-only affordance, so no lone hamburger appears beside a full tab strip
// for nothing.
const ownDrawerWide = !sidebar && sectionNav(theme, pathname, owner).length > 0;
---

<header class="sh" style={style} data-theme={theme}>
	<nav class="sh__inner" aria-label="Primary">
		<a class="sh__brand" href="/" aria-label={`jq ${filter} — home`}>
			<span class="sh__brand-jq">jq</span><span class="sh__brand-filter">{filter}</span>
		</a>
		<div class="sh__tabs">
		{
			nav.map((n) =>
				n.children ? (
					<div class="sh-logs" data-logs>
						<a
							class:list={['sh__link', 'sh-logs__link', n.active && 'sh__link--active']}
							href={n.href}
							aria-current={n.active ? 'page' : undefined}
						>
							{n.label}
						</a>
						<button
							type="button"
							class="sh-logs__toggle"
							aria-haspopup="true"
							aria-expanded="false"
							aria-label="Open logs menu"
							data-logs-toggle
						>
							<svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
								<path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
							</svg>
						</button>
						<ul class="sh-logs__menu">
							{n.children.map((c) => (
								<li>
									<a
										class:list={['sh-logs__item', c.active && 'sh-logs__item--active']}
										href={c.href}
										aria-current={c.active ? 'page' : undefined}
									>
										{c.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				) : (
					<a
						class:list={['sh__link', n.active && 'sh__link--active']}
						href={n.href}
						aria-current={n.active ? 'page' : undefined}
					>
						{n.label}
					</a>
				),
			)
		}
		</div>
		<div class="sh__actions">
			<slot name="actions" />
			{!owner && (
				<button type="button" class="sh-login-btn" data-login-open>Log in</button>
			)}
			<button
				type="button"
				class:list={['sh-burger', ownDrawerWide && 'sh-burger--own']}
				data-drawer-toggle
				aria-label="Open menu"
				aria-controls="site-drawer"
				aria-expanded="false"
			>
				<svg viewBox="0 0 20 14" width="20" height="14" aria-hidden="true">
					<path d="M0 1h20M0 7h20M0 13h20" fill="none" stroke="currentColor" stroke-width="1.6" />
				</svg>
			</button>
		</div>
	</nav>
</header>

<button type="button" class="sh-drawer-backdrop" data-drawer-backdrop aria-label="Close menu" hidden />

{/* Pages with their own sidebar (sidebar=true) supply the drawer themselves —
    the section index, with DrawerNav folded in at its top. Everyone else gets
    this nav-only drawer so the hamburger works site-wide. */}
{!sidebar && (
	<aside
		id="site-drawer"
		class:list={['sh-menu', ownDrawerWide && 'sh-menu--wide']}
		data-site-drawer
		style={style}
		aria-label="Menu"
	>
		<DrawerNav
			pathname={pathname}
			theme={theme}
			divider={false}
			sectionLinks
			owner={owner}
			always={ownDrawerWide}
		/>
	</aside>
)}

{
	!owner && (
		<div class="sh-login" data-login-modal hidden>
			<div class="sh-login__backdrop" data-login-close />
			<div
				class="sh-login__box"
				role="dialog"
				aria-modal="true"
				aria-labelledby="sh-login-title"
			>
				<div class="sh-login__title" id="sh-login-title">Admin sign in</div>
				<div class="sh-login__sub">Enter the admin password to log entries and edit this profile.</div>
				<form class="sh-login__form" data-login-form>
					<input
						type="password"
						data-login-pw
						placeholder="Password"
						autocomplete="current-password"
						required
					/>
					<div class="sh-login__err" data-login-err hidden>Incorrect password. Try again.</div>
					<div class="sh-login__actions">
						<button type="button" class="sh-login__cancel" data-login-close>Cancel</button>
						<button type="submit" class="sh-login__submit">Sign in</button>
					</div>
				</form>
			</div>
		</div>
	)
}

<script>
	// The Journal dropdown. It opens on hover and keyboard focus by CSS alone
	// (see .sh-logs:hover / :focus-within); this script only adds the touch path
	// — a tap on the caret — plus outside-click and Escape to close. Kept tiny on
	// purpose: the tab still navigates to the month page whether or not any of
	// this runs.
	for (const logs of document.querySelectorAll<HTMLElement>('[data-logs]')) {
		const toggle = logs.querySelector<HTMLButtonElement>('[data-logs-toggle]');
		if (!toggle) continue;
		const set = (open: boolean) => {
			logs.toggleAttribute('data-open', open);
			toggle.setAttribute('aria-expanded', String(open));
		};
		toggle.addEventListener('click', (e) => {
			e.stopPropagation();
			set(!logs.hasAttribute('data-open'));
		});
		document.addEventListener('click', (e) => {
			if (!logs.contains(e.target as Node)) set(false);
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') set(false);
		});
	}
</script>

<script>
	// Admin sign in. Only wired when the dialog is in the DOM (visitors); the owner
	// sees no modal. POSTs the password to /api/auth/login, which sets the signed
	// session cookie, then reloads so the server re-renders with owner controls.
	const modal = document.querySelector<HTMLElement>('[data-login-modal]');
	const openBtn = document.querySelector<HTMLButtonElement>('[data-login-open]');
	if (modal && openBtn) {
		const form = modal.querySelector<HTMLFormElement>('[data-login-form]')!;
		const pw = modal.querySelector<HTMLInputElement>('[data-login-pw]')!;
		const err = modal.querySelector<HTMLElement>('[data-login-err]')!;
		const close = () => {
			modal.hidden = true;
			form.reset();
			err.hidden = true;
		};
		openBtn.addEventListener('click', () => {
			modal.hidden = false;
			pw.focus();
		});
		for (const el of modal.querySelectorAll('[data-login-close]')) {
			el.addEventListener('click', close);
		}
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !modal.hidden) close();
		});
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			err.hidden = true;
			try {
				const res = await fetch('/api/auth/login', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ password: pw.value }),
				});
				if (!res.ok) {
					err.hidden = false;
					pw.select();
					return;
				}
				window.location.reload();
			} catch {
				err.hidden = false;
				pw.select();
			}
		});
	}
</script>

<script>
	// Mobile drawer. Below 820px the section's right sidebar is taken out of the
	// feed and hidden (see the [data-site-drawer] rule below); this
	// toggles a class on <html> that shows it, plus a backdrop. Only wired
	// when the page opted in with `sidebar` — the button and backdrop exist then.
	const burger = document.querySelector<HTMLButtonElement>('[data-drawer-toggle]');
	const backdrop = document.querySelector<HTMLElement>('[data-drawer-backdrop]');
	if (burger) {
		const set = (open: boolean) => {
			document.documentElement.classList.toggle('sh-drawer-open', open);
			burger.setAttribute('aria-expanded', String(open));
			if (backdrop) backdrop.hidden = !open;
		};
		burger.addEventListener('click', () =>
			set(!document.documentElement.classList.contains('sh-drawer-open')),
		);
		backdrop?.addEventListener('click', () => set(false));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') set(false);
		});
	}
</script>

<style is:global>
	/* The mobile drawer, shared by every page that passes `sidebar` to the header.
	   Below 820px the page's own sidebar (marked [data-site-drawer]) is lifted out
	   of the feed grid and hidden against the right edge; the header's hamburger
	   shows it. Positioning only — each sidebar keeps its own themed background and
	   padding (set in that section's styles), so the drawer reads as that section. */
	@media (max-width: 820px) {
		[data-site-drawer] {
			position: fixed;
			top: 0;
			right: 0;
			bottom: 0;
			width: min(310px, 84vw);
			margin: 0;
			z-index: 90;
			overflow-y: auto;
			/* Parked off the right edge, with no travel between the two states —
			   `visibility` (not just the offset) so a closed drawer can't be tabbed
			   into or swallow a click meant for the hamburger. */
			transform: translateX(100%);
			visibility: hidden;
			box-shadow: -14px 0 40px rgba(0, 0, 0, 0.32);
		}
		html.sh-drawer-open [data-site-drawer] {
			transform: translateX(0);
			visibility: visible;
		}
	}
	/* The wide drawer (a subpage whose section has its own pages) is hidden
	   until opened at ALL widths, not just below 820px — same box as above, lifted
	   out of the media query. The extra class outweighs the mobile rule, so the two
	   never fight where both match. */
	.sh-menu--wide[data-site-drawer] {
		position: fixed;
		top: 0;
		right: 0;
		bottom: 0;
		width: min(310px, 84vw);
		margin: 0;
		z-index: 90;
		overflow-y: auto;
		transform: translateX(100%);
		visibility: hidden;
		box-shadow: -14px 0 40px rgba(0, 0, 0, 0.32);
	}
	html.sh-drawer-open .sh-menu--wide[data-site-drawer] {
		transform: translateX(0);
		visibility: visible;
	}
</style>

<style>
	/* The strip: full viewport width, its content held to the section column.
	   `margin-left: calc(50% - 50vw)` is the bleed — a no-op when the header is
	   already full width, and what lets it escape a centered card when it isn't
	   (the film and activity logs place it inside one). */
	.sh {
		width: 100vw;
		margin-left: calc(50% - 50vw);
		background: var(--sh-bg);
		border-bottom: 1px solid var(--sh-border);
		font-family: var(--sh-font);
	}
	.sh__inner {
		/* border-box so the column's outer width is exactly --sh-max on every
		   host layout — the section layouts set a global border-box, but Layout
		   (home/about/projects) doesn't, which otherwise made this strip 64px
		   wider there than the 1120px cards elsewhere. */
		box-sizing: border-box;
		max-width: var(--sh-max);
		margin: 0 auto;
		padding: 0 var(--sh-pad, clamp(14px, 4vw, 28px));
		display: flex;
		align-items: stretch;
		gap: 2px;
		flex-wrap: wrap;
	}
	/* Brand mark: `jq .section` set in mono so it reads as a jq filter. Themed by
	   the same --sh-* vars as everything else — `jq` in the section's strong
	   colour, the filter path in its accent. Its own right margin holds it off
	   the tabs; the mono face is the system stack, no webfont added for six
	   glyphs. */
	.sh__brand {
		display: inline-flex;
		align-items: center;
		margin-right: 18px;
		padding: 0 2px;
		font-family: ui-monospace, 'JetBrains Mono', 'SFMono-Regular', Menlo, Consolas, monospace;
		font-size: 16px;
		font-weight: 600;
		letter-spacing: -0.5px;
		text-decoration: none;
		white-space: nowrap;
	}
	.sh__brand-jq {
		color: var(--sh-active);
	}
	.sh__brand-filter {
		margin-left: 0.32em;
		font-weight: 700;
		color: var(--sh-accent);
	}
	.sh__brand:hover .sh__brand-jq {
		color: var(--sh-hover);
	}

	/* The primary tabs, as one flex child so they can be hidden as a group when
	   the header collapses to a hamburger on mobile. */
	.sh__tabs {
		display: flex;
		align-items: stretch;
		gap: 2px;
		flex-wrap: wrap;
	}
	.sh__link {
		display: inline-flex;
		align-items: center;
		font-size: 13px;
		letter-spacing: 0.4px;
		color: var(--sh-link);
		text-decoration: none;
		padding: 22px 15px 20px;
		border-bottom: 2px solid transparent;
		white-space: nowrap;
	}
	.sh__link:hover {
		color: var(--sh-hover);
	}
	.sh__link--active {
		color: var(--sh-active);
		font-weight: 600;
		border-bottom-color: var(--sh-accent);
	}

	/* Journal dropdown */
	.sh-logs {
		position: relative;
		display: inline-flex;
		align-items: stretch;
	}
	.sh-logs__link {
		padding-right: 4px;
	}
	/* The active underline belongs under the whole Journal tab — the label AND
	   its caret — not just the label, or it reads as off-centre. Drawn as a
	   full-width bar on the group so it can't shift the row's height. */
	.sh-logs:has(.sh__link--active) {
		position: relative;
	}
	.sh-logs:has(.sh__link--active)::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 2px;
		background: var(--sh-accent);
	}
	.sh-logs:has(.sh__link--active) .sh__link--active {
		border-bottom-color: transparent;
	}
	.sh-logs__toggle {
		display: inline-flex;
		align-items: center;
		padding: 0 8px 0 2px;
		background: none;
		border: none;
		color: var(--sh-link);
		cursor: pointer;
	}
	.sh-logs:hover .sh-logs__toggle,
	.sh-logs:focus-within .sh-logs__toggle {
		color: var(--sh-hover);
	}
	.sh-logs:hover .sh-logs__toggle svg,
	.sh-logs:focus-within .sh-logs__toggle svg,
	.sh-logs[data-open] .sh-logs__toggle svg {
		transform: rotate(180deg);
	}

	.sh-logs__menu {
		position: absolute;
		top: 100%;
		left: 0;
		z-index: 60;
		margin: 0;
		padding: 6px;
		list-style: none;
		min-width: 168px;
		background: var(--sh-menu-bg);
		border: 1px solid var(--sh-border);
		border-radius: 0 0 8px 8px;
		box-shadow: 0 14px 34px rgba(0, 0, 0, 0.28);
		/* Hidden until hovered, focused, or tapped open. visibility (not just
		   opacity) so the links aren't tab-reachable while collapsed. */
		opacity: 0;
		visibility: hidden;
	}
	.sh-logs:hover .sh-logs__menu,
	.sh-logs:focus-within .sh-logs__menu,
	.sh-logs[data-open] .sh-logs__menu {
		opacity: 1;
		visibility: visible;
	}
	.sh-logs__item {
		display: block;
		padding: 9px 12px;
		font-size: 13px;
		color: var(--sh-link);
		text-decoration: none;
		border-radius: 5px;
		white-space: nowrap;
	}
	.sh-logs__item:hover {
		color: var(--sh-hover);
		background: color-mix(in srgb, var(--sh-accent) 14%, transparent);
	}
	.sh-logs__item--active {
		color: var(--sh-active);
		font-weight: 600;
	}

	.sh__actions {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.sh__actions:empty {
		display: none;
	}

	/* Mobile: the primary tabs fold into the hamburger drawer (rendered there by
	   DrawerNav) on every page, leaving the header a single row of action buttons
	   + hamburger. The tabs no longer set the row height, so pad the strip to keep
	   breathing room above the divider. */
	@media (max-width: 820px) {
		.sh__tabs {
			display: none;
		}
		.sh__inner {
			padding-top: 13px;
			padding-bottom: 15px;
		}
	}

	/* The header's own nav-only drawer, used on pages that don't render a section
	   sidebar. Hidden on desktop (the tabs show in the strip); below 820px the
	   global [data-site-drawer] rule parks it off-canvas and the hamburger shows
	   it. Wears the section's menu background. */
	.sh-menu {
		display: none;
	}
	@media (max-width: 820px) {
		.sh-menu {
			display: block;
			background: var(--sh-menu-bg);
			padding: 22px 24px;
		}
	}
	/* The wide variant (a subpage with section pages) shows at every width — its
	   off-canvas positioning is set globally below so it's parked off-screen until
	   the hamburger shows it, the same as the narrow drawer. */
	.sh-menu--wide {
		display: block;
		background: var(--sh-menu-bg);
		padding: 22px 24px;
	}

	/* Hamburger — mobile only, sits to the right of any owner action buttons.
	   Wears the section palette like the Log-in button next to it. */
	.sh-burger {
		display: none;
		align-items: center;
		justify-content: center;
		background: none;
		border: 1px solid var(--sh-border);
		border-radius: 4px;
		color: var(--sh-link);
		padding: 7px 9px;
		cursor: pointer;
	}
	.sh-burger:hover {
		color: var(--sh-hover);
		border-color: var(--sh-accent);
	}
	.sh-burger svg {
		display: block;
	}
	.sh-drawer-backdrop {
		position: fixed;
		inset: 0;
		z-index: 80;
		border: 0;
		background: rgba(0, 0, 0, 0.44);
		cursor: pointer;
	}
	.sh-drawer-backdrop[hidden] {
		display: none;
	}
	@media (max-width: 820px) {
		.sh-burger {
			display: inline-flex;
		}
	}
	/* A subpage whose section has its own pages keeps its hamburger at every width
	   (see ownDrawerWide) — that's the only route to those pages when there's no
	   sidebar and the screen is too wide to have collapsed. */
	.sh-burger--own {
		display: inline-flex;
	}

	@media (max-width: 640px) {
		.sh__link {
			padding: 16px 11px 14px;
		}
		.sh__brand {
			font-size: 15px;
			margin-right: 12px;
		}
	}

	/* Admin sign-in — the button wears the section's palette; the dialog is a
	   self-contained overlay, so it reads the same on a dark log or a light one. */
	.sh-login-btn {
		font-family: var(--sh-font);
		font-size: 12.5px;
		color: var(--sh-link);
		background: none;
		border: 1px solid var(--sh-border);
		border-radius: 4px;
		padding: 6px 12px;
		cursor: pointer;
		white-space: nowrap;
	}
	.sh-login-btn:hover {
		color: var(--sh-hover);
		border-color: var(--sh-accent);
	}

	.sh-login {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 20px;
	}
	.sh-login[hidden] {
		display: none;
	}
	.sh-login__backdrop {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.5);
	}
	.sh-login__box {
		position: relative;
		width: 100%;
		max-width: 340px;
		background: #fbf9f4;
		color: #2b2622;
		border-radius: 10px;
		padding: 22px;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
		font-family: system-ui, sans-serif;
	}
	.sh-login__title {
		font-size: 1.05rem;
		font-weight: 600;
	}
	.sh-login__sub {
		font-size: 0.82rem;
		color: #6b6259;
		margin: 6px 0 16px;
	}
	.sh-login__form {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.sh-login__form input {
		padding: 9px 11px;
