---
// Add-a-film-to-the-watchlist modal, shared by the watchlist page and the film
// log header. Render it once on a page (owner only); any element carrying
// `data-open-watchlist` opens it. Searches TMDB, POSTs to /api/films/watchlist,
// then reloads so the new entry shows. Extracted from watchlist.astro.
---

<div class="modal" id="composer" hidden>
	<div class="modal__backdrop" id="composer-backdrop"></div>
	<div class="modal__panel" role="dialog" aria-modal="true" aria-label="Add a film to your watchlist">
		<div class="modal__head">
			<span class="modal__title">Add to watchlist</span>
			<button type="button" class="modal__close" id="composer-close" aria-label="Close">✕</button>
		</div>

		<div class="modal__body">
			<label class="lbl" for="c-q">Film</label>
			<div class="search" id="c-search">
				<input type="text" id="c-q" placeholder="Search a film…" autocomplete="off" />
				<ul class="results" id="c-results" hidden></ul>
			</div>
			<div class="selected" id="c-selected" hidden>
				<img id="c-sel-poster" alt="" width="26" height="39" />
				<span id="c-sel-title"></span>
				<button type="button" class="link" id="c-change">change</button>
			</div>
		</div>

		<div class="modal__foot">
			<span class="save-msg" id="save-msg"></span>
			<button type="button" class="btn-ghost" id="composer-cancel">Cancel</button>
			<button type="button" class="btn-save" id="composer-save" disabled>Add film</button>
		</div>
	</div>
</div>

<style>
	.modal {
		position: fixed;
		inset: 0;
		z-index: 50;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding: 72px 24px;
	}
	.modal[hidden] {
		display: none;
	}
	.modal__backdrop {
		position: absolute;
		inset: 0;
		background: rgba(10, 4, 5, 0.72);
		backdrop-filter: blur(3px);
	}
	.modal__panel {
		position: relative;
		width: 100%;
		max-width: 480px;
		background: #241012;
		border: 1px solid #4a2529;
		border-radius: 14px;
		box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.7);
		overflow: hidden;
	}
	.modal__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 20px 24px;
		border-bottom: 1px solid #402226;
	}
	.modal__title {
		font-family: 'Newsreader', serif;
		font-style: italic;
		font-size: 22px;
		color: #f4e8d1;
	}
	.modal__close {
		width: 30px;
		height: 30px;
		border: 1px solid #4a2529;
		background: transparent;
		color: #c2a99a;
		border-radius: 7px;
		cursor: pointer;
		font-size: 14px;
		line-height: 1;
	}
	.modal__close:hover {
		background: #402226;
		color: #f4e8d1;
	}
	.modal__body {
		padding: 22px 24px 26px;
	}
	.lbl {
		display: block;
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 1.4px;
		color: #8a6f63;
		margin-bottom: 7px;
	}
	.search {
		position: relative;
	}
	#c-q {
		width: 100%;
		background: #1c0d0e;
		border: 1px solid #4a2529;
		border-radius: 8px;
		color: #f4e8d1;
		font-family: 'Archivo', sans-serif;
		padding: 11px 13px;
		font-size: 14px;
		outline: none;
	}
	#c-q:focus {
		border-color: #d9b45a;
	}
	.results {
		list-style: none;
		margin: 6px 0 0;
		padding: 0;
		position: absolute;
		z-index: 10;
		width: 100%;
		max-height: 300px;
		overflow-y: auto;
		background: #1c0d0e;
		border: 1px solid #4a2529;
		border-radius: 8px;
	}
	.results :global(li) {
		display: flex;
		gap: 10px;
		align-items: center;
		padding: 7px 9px;
		cursor: pointer;
		color: #e9d9c4;
		font-size: 13px;
	}
	.results :global(li:hover) {
		background: #331619;
	}
	.results :global(img) {
		width: 30px;
		height: 45px;
		object-fit: cover;
		border-radius: 3px;
		background: #4a2529;
		flex-shrink: 0;
	}
	.results :global(.r-year) {
		color: #a2857a;
		margin-left: 6px;
	}
	.selected {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 12px;
		font-family: 'Newsreader', serif;
		font-size: 15px;
		color: #f2e5cd;
	}
	.selected img {
		object-fit: cover;
		border-radius: 3px;
		background: #4a2529;
	}
	.link {
		background: none;
		border: none;
		color: #a2857a;
		cursor: pointer;
		font-size: 12px;
		text-decoration: underline;
		font-family: 'Archivo', sans-serif;
		padding: 0;
	}
	.link:hover {
		color: #f4e8d1;
	}
	.modal__foot {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 12px;
		padding: 16px 24px;
		border-top: 1px solid #402226;
		background: #1f0e10;
	}
	.btn-ghost {
		font-size: 14px;
		font-weight: 600;
		color: #ddc9b4;
		background: transparent;
		border: 1px solid #4a2529;
		border-radius: 8px;
		padding: 10px 20px;
		cursor: pointer;
		font-family: 'Archivo', sans-serif;
	}
	.btn-ghost:hover {
		border-color: #a2857a;
		color: #f4e8d1;
	}
	.btn-save {
		font-size: 14px;
		font-weight: 700;
		border: none;
		border-radius: 8px;
		padding: 10px 22px;
		font-family: 'Archivo', sans-serif;
		background: #d9b45a;
		color: #2a1214;
		cursor: pointer;
	}
	.btn-save:disabled {
		background: #4a2529;
		color: #8a6f63;
		cursor: not-allowed;
	}
	.save-msg {
		font-size: 13px;
		color: #a2857a;
		margin-right: auto;
	}
	.save-msg.error {
		color: #e0736f;
	}
</style>

<script>
	// --- Add a film to the watchlist (search overlay, owner only) ---------
	// Astro always hoists this script; bail out cleanly when the modal isn't in
	// the DOM (a visitor viewing the page). Any element with `data-open-watchlist`
	// opens it — the watchlist title button and the film log header both use that.
	const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-open-watchlist]'));
	const modal = document.getElementById('composer') as HTMLDivElement | null;

	if (triggers.length && modal) {
		const IMG = 'https://image.tmdb.org/t/p/w92';
		const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
		const close = $('composer-close');
		const cancel = $('composer-cancel');
		const backdrop = $('composer-backdrop');
		const save = $<HTMLButtonElement>('composer-save');
		const msg = $<HTMLSpanElement>('save-msg');
		const q = $<HTMLInputElement>('c-q');
		const results = $<HTMLUListElement>('c-results');
		const searchWrap = $('c-search');
		const selected = $('c-selected');
		const selPoster = $<HTMLImageElement>('c-sel-poster');
		const selTitle = $<HTMLSpanElement>('c-sel-title');
		const change = $('c-change');

		let tmdbId: number | null = null;

		// --- TMDB search (debounced) ---
		let timer: number | undefined;
		q.addEventListener('input', () => {
			window.clearTimeout(timer);
			const query = q.value.trim();
			if (!query) return hideResults();
			timer = window.setTimeout(() => runSearch(query), 300);
		});
		async function runSearch(query: string) {
			try {
				const res = await fetch(`/api/tmdb/search?query=${encodeURIComponent(query)}`);
				if (!res.ok) return hideResults();
				const data = await res.json();
				renderResults(data.results ?? []);
			} catch {
				hideResults();
			}
		}
		function renderResults(items: any[]) {
			results.textContent = '';
			if (!items.length) return hideResults();
			for (const m of items.slice(0, 8)) {
				const li = document.createElement('li');
				const img = document.createElement('img');
				if (m.poster_path) img.src = IMG + m.poster_path;
				img.alt = '';
				const label = document.createElement('span');
				label.textContent = m.title;
				if (m.release_date) {
					const yr = document.createElement('span');
					yr.className = 'r-year';
					yr.textContent = m.release_date.slice(0, 4);
					label.appendChild(yr);
				}
				li.append(img, label);
				li.addEventListener('click', () => selectMovie(m));
				results.appendChild(li);
			}
			results.hidden = false;
		}
		function hideResults() {
			results.hidden = true;
			results.textContent = '';
		}
		function selectMovie(m: any) {
			tmdbId = m.id;
			selTitle.textContent = m.title + (m.release_date ? ` (${m.release_date.slice(0, 4)})` : '');
			if (m.poster_path) {
				selPoster.src = IMG + m.poster_path;
				selPoster.hidden = false;
			} else {
				selPoster.removeAttribute('src');
				selPoster.hidden = true;
			}
			hideResults();
			searchWrap.hidden = true;
			selected.hidden = false;
			save.disabled = false;
			msg.className = 'save-msg';
			msg.textContent = '';
		}
		change.addEventListener('click', () => {
			tmdbId = null;
			selected.hidden = true;
			searchWrap.hidden = false;
			save.disabled = true;
			q.value = '';
			q.focus();
		});
		document.addEventListener('click', (e) => {
			if (!searchWrap.contains(e.target as Node)) hideResults();
		});

		const closeModal = () => {
			modal.hidden = true;
		};
		const openModal = () => {
			modal.hidden = false;
			q.focus();
		};
		for (const trigger of triggers) trigger.addEventListener('click', openModal);
		close.addEventListener('click', closeModal);
		cancel.addEventListener('click', closeModal);
		backdrop.addEventListener('click', closeModal);
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !modal.hidden) closeModal();
		});

		save.addEventListener('click', async () => {
			if (!tmdbId) return;
			save.disabled = true;
			msg.className = 'save-msg';
			msg.textContent = 'Adding…';
			try {
				const res = await fetch('/api/films/watchlist', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ tmdbId }),
				});
				if (res.status === 401) {
					window.location.href = '/films/login?redirect=/films/watchlist';
					return;
				}
				const data = await res.json().catch(() => ({}));
				if (!res.ok) throw new Error(data.error || 'Add failed');
				// New entries sort to the top (added just now) — reload to show it.
				window.location.reload();
			} catch (err) {
				msg.className = 'save-msg error';
				msg.textContent = err instanceof Error ? err.message : 'Add failed';
				save.disabled = false;
			}
		});
	}
</script>
