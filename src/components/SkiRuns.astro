---
// The run/lift breakdown of a lift-served ski or snowboard day — what Slopes
// shows and neither the raw file nor Strava's arbitrary auto-laps do. All the
// work (segment the altitude sawtooth, convert to feet/mph, build each run's
// sparkline) is in src/lib/ski-view.ts; this file is only the markup. Renders
// nothing when there's no altitude stream or no run was found.
import type { SkiView } from '../lib/ski-view';

interface Props {
	view: SkiView | null;
	/** When set (owner on a ski day), a link into the run/lift editor. */
	editHref?: string | null;
	/** True when this day's partition has been hand-corrected — shown as a badge
	 *  so an edited day is legible as such. */
	edited?: boolean;
}

const { view, editHref = null, edited = false } = Astro.props;

const W = 64;
const H = 24;
/** Sparkline points → an SVG polyline over the shared day-altitude scale. */
function sparkPath(spark: number[]): string {
	if (spark.length < 2) return '';
	return spark
		.map((p, i) => `${((i / (spark.length - 1)) * W).toFixed(1)},${((1 - p) * (H - 2) + 1).toFixed(1)}`)
		.join(' ');
}
---

{
	view && (
		<section class="ski">
			<div class="ski__head">
				<h2 class="section-h">
					Runs &amp; lifts <span class="section-h__meta">{view.summary.runs} runs</span>
					{edited && <span class="ski__edited">edited</span>}
				</h2>
				{editHref && <a class="ski__edit" href={editHref}>Edit</a>}
			</div>

			<div class="ski-sum">
				<div class="ski-sum__cell">
					<div class="ski-sum__val figure">{view.summary.runs}</div>
					<div class="ski-sum__lbl">Runs</div>
				</div>
				<div class="ski-sum__cell">
					<div class="ski-sum__val figure">{view.summary.verticalFt.toLocaleString()} ft</div>
					<div class="ski-sum__lbl">Vertical</div>
				</div>
				<div class="ski-sum__cell">
					<div class="ski-sum__val figure">{view.summary.timeSkiing}</div>
					<div class="ski-sum__lbl">Time skiing</div>
				</div>
				<div class="ski-sum__cell">
					<div class="ski-sum__val figure">{view.summary.liftTime}</div>
					<div class="ski-sum__lbl">On lifts</div>
				</div>
				<div class="ski-sum__cell">
					<div class="ski-sum__val figure">{view.summary.longestRunFt.toLocaleString()} ft</div>
					<div class="ski-sum__lbl">Longest run</div>
				</div>
				{view.summary.maxSpeedMph != null && (
					<div class="ski-sum__cell">
						<div class="ski-sum__val figure">{view.summary.maxSpeedMph.toFixed(0)} mph</div>
						<div class="ski-sum__lbl">Top speed</div>
					</div>
				)}
			</div>

			<ol class="ski-list">
				{view.items.map((item) =>
					item.kind === 'run' ? (
						<li class="ski-run">
							<span class="ski-run__num figure">{item.index}</span>
							<svg class="ski-run__spark" viewBox={`0 0 ${W} ${H}`} fill="none" aria-hidden="true">
								<polyline
									points={sparkPath(item.spark)}
									stroke="#1c6e8c"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
							<span class="ski-run__vert figure">{item.verticalFt.toLocaleString()} ft</span>
							<span class="ski-run__meta figure">
								{item.duration}
								{item.avgMph != null && <> · {item.avgMph.toFixed(0)} mph</>}
								{item.distanceMi != null && <> · {item.distanceMi.toFixed(2)} mi</>}
							</span>
						</li>
					) : (
						<li class="ski-lift">
							<svg class="ski-lift__icon" viewBox="0 0 24 24" fill="none" stroke="#6b7b88" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M3 5l18 3M6 6.4V10l3 .5M18 8.9V12l-3-.5M9 10.5l6 1M8 12.5v3.5M16 14v3.5M6.5 20h3M14.5 20h3" />
							</svg>
							<span class="ski-lift__label">Lift</span>
							<span class="ski-lift__meta figure">{item.duration} · +{item.gainFt.toLocaleString()} ft</span>
						</li>
					),
				)}
			</ol>
		</section>
	)
}

<style>
	.ski {
		margin-top: 0.5rem;
	}
	.ski__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	.ski__edited {
		font-family: 'Instrument Sans', Arial, sans-serif;
		font-size: 0.62rem;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: #6b7b88;
		border: 1px solid #c9d4dc;
		border-radius: 999px;
		padding: 0.05rem 0.45rem;
		margin-left: 0.35rem;
		vertical-align: middle;
	}
	.ski__edit {
		flex: none;
		font-size: 0.8rem;
		color: #6b7b88;
		text-decoration: none;
		border: 1px solid #c9d4dc;
		border-radius: 6px;
		padding: 0.25rem 0.7rem;
	}
	.ski__edit:hover {
		border-color: #1c6e8c;
		color: #1c6e8c;
	}
	.section-h {
		font-size: 1.05rem;
		font-family: 'Instrument Serif', Georgia, serif;
		color: #3d4a55;
		margin: 2.5rem 0 1rem;
	}
	.section-h__meta {
		font-family: 'Instrument Sans', Arial, sans-serif;
		font-size: 0.75rem;
		color: #6b7b88;
		font-weight: 400;
		margin-left: 0.4rem;
	}

	/* Summary — same flex-wrap card idea as the page's stat strip. */
	.ski-sum {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-bottom: 1.25rem;
	}
	.ski-sum__cell {
		background: #f8fbfd;
		border: 1px solid #c9d4dc;
		border-radius: 8px;
		padding: 0.7rem 0.9rem;
		flex: 1 1 100px;
	}
	.ski-sum__val {
		font-family: 'Instrument Serif', Georgia, serif;
		font-size: 1.3rem;
		color: #3d4a55;
		line-height: 1.1;
	}
	.ski-sum__lbl {
		margin-top: 0.2rem;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: #6b7b88;
	}

	/* The run/lift timeline. Runs are the substance; lifts are the muted
	   connectors between them, the way the day actually alternated. */
	.ski-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border: 1px solid #c9d4dc;
		border-radius: 10px;
		overflow: hidden;
	}
	.ski-run {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 0.6rem 1rem;
		background: #fff;
	}
	.ski-run + .ski-run,
	.ski-lift + .ski-run,
	.ski-run + .ski-lift,
	.ski-lift + .ski-lift {
		border-top: 1px solid #eef4f8;
	}
	.ski-run__num {
		flex: none;
		width: 1.6rem;
		height: 1.6rem;
		display: grid;
		place-items: center;
		border-radius: 999px;
		background: #dceaf4;
		color: #12495e;
		font-size: 0.8rem;
	}
	.ski-run__spark {
		flex: none;
		width: 64px;
		height: 24px;
	}
	.ski-run__vert {
		flex: none;
		min-width: 4.5rem;
		font-family: 'Instrument Serif', Georgia, serif;
		font-size: 1.15rem;
		color: #3d4a55;
	}
	.ski-run__meta {
		flex: 1;
		text-align: right;
		font-size: 0.85rem;
		color: #6b7b88;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.ski-lift {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.4rem 1rem;
		background: #f8fbfd;
		color: #6b7b88;
	}
	.ski-lift__icon {
		width: 1.05rem;
		height: 1.05rem;
		flex: none;
	}
	.ski-lift__label {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.07em;
	}
	.ski-lift__meta {
		margin-left: auto;
		font-size: 0.8rem;
	}

	@media (max-width: 560px) {
		.ski-run__spark {
			display: none;
		}
		.ski-run__meta {
			font-size: 0.78rem;
		}
	}
</style>
