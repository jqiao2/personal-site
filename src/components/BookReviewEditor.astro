		border-color: #cfa452;
	}

	/* The private note: a disclosure, not a field. Dashed is the whole
	   vocabulary for "not part of the page" — the pill, the box, and the block
	   the book page draws the saved note in all wear it, and the loud gold
	   fill this modal gives its published controls stays off it. */
	.privnote__toggle {
		margin-top: 10px;
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.3px;
		border-radius: 20px;
		padding: 6px 13px;
		cursor: pointer;
		background: transparent;
		color: #8a745a;
		border: 1px dashed #45341f;
	}
	.privnote__toggle:hover,
	.privnote__toggle:focus-visible,
	.privnote__toggle[aria-expanded='true'] {
		color: #cdbb98;
		border-color: #6d5836;
		outline: none;
	}
	.privnote__lock {
		font-size: 11px;
		filter: grayscale(1);
		opacity: 0.75;
	}
	.privnote__toggle[aria-expanded='true'] .privnote__lock {
		filter: none;
		opacity: 1;
	}
	.privnote__box {
		margin-top: 8px;
		border-style: dashed;
	}
	.privnote__box[hidden] {
		display: none;
	}

	/* Scales */
	.scales {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 20px;
	}
	.segmented {
		display: flex;
		border: 1px solid #45341f;
		border-radius: 9px;
		overflow: hidden;
	}
	.seg {
		flex: 1 1 0;
		min-width: 0;
		padding: 10px 4px;
		font-size: 12px;
		font-weight: 600;
		cursor: pointer;
		font-family: 'Archivo', sans-serif;
		border: none;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		background: #1f1609;
		color: #b09a78;
	}
	.seg + .seg {
		border-left: 1px solid #45341f;
	}
	.seg[aria-pressed='true'] {
		background: #cfa452;
		color: #241a10;
	}
	.scale-ends {
		display: flex;
		justify-content: space-between;
		font-size: 10.5px;
		color: #75603f;
		margin-top: 6px;
		letter-spacing: 0.3px;
	}

	/* Mood / tone */
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(158px, 1fr));
		gap: 1px;
		background: #33261a;
		border: 1px solid #45341f;
		border-radius: 9px;
		overflow: hidden;
	}
	.check {
		display: flex;
		align-items: center;
		gap: 9px;
		text-align: left;
		padding: 10px 12px;
		border: none;
		cursor: pointer;
		font-family: 'Archivo', sans-serif;
		font-size: 13px;
		letter-spacing: 0.1px;
		background: #1f1609;
		color: #b09a78;
	}
	.check[aria-pressed='true'] {
		background: #332411;
		color: #f7ead0;
		font-weight: 600;
	}
	.check__box {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 15px;
		height: 15px;
		border-radius: 3px;
		font-size: 10px;
		line-height: 1;
		background: transparent;
		color: transparent;
		border: 1px solid #4d3a22;
	}
	.check[aria-pressed='true'] .check__box {
		background: #cfa452;
		color: #241a10;
		border-color: #cfa452;
	}

	/* Buttons */
	.btn-ghost {
		font-size: 13.5px;
		font-weight: 600;
		color: #dcc9a6;
		background: transparent;
		border: 1px solid #45341f;
		border-radius: 8px;
		padding: 10px 18px;
		cursor: pointer;
		font-family: 'Archivo', sans-serif;
	}
	.btn-ghost:hover {
		border-color: #a68f6e;
		color: #f2e6cd;
	}
	.btn-ghost--sm {
		margin-top: 11px;
		font-size: 12px;
		padding: 8px 14px;
	}
	.btn-ghost--danger {
		color: #e0a06e;
		border-color: #6b4a2a;
	}
	.btn-save {
		font-size: 14px;
		font-weight: 700;
		color: #241a10;
		background: #cfa452;
		border: none;
		border-radius: 8px;
		padding: 10px 22px;
		cursor: pointer;
		font-family: 'Archivo', sans-serif;
	}
	.btn-save:hover {
		background: #ecc87c;
	}
	.btn-discard {
		font-size: 13px;
		font-weight: 700;
		color: #241a10;
		background: #d08a52;
		border: none;
		border-radius: 8px;
		padding: 9px 18px;
		cursor: pointer;
		font-family: 'Archivo', sans-serif;
	}
	.save-msg {
		font-size: 11.5px;
		letter-spacing: 0.3px;
		color: #8a745a;
	}
	.save-msg--ok {
		color: #8fae6a;
	}

	/* Discard guard */
	.discard {
		position: absolute;
		inset: 0;
		background: rgba(14, 9, 4, 0.9);
		backdrop-filter: blur(2px);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 28px;
		z-index: 20;
	}
	.discard[hidden] {
		display: none;
	}
	.discard__box {
		width: 100%;
		max-width: 360px;
		background: #241a10;
		border: 1px solid #45341f;
		border-radius: 12px;
		padding: 24px;
		text-align: center;
	}
	.discard__title {
		font-family: 'Newsreader', serif;
		font-style: italic;
		font-size: 21px;
		color: #f2e6cd;
		margin-bottom: 8px;
	}
	.discard__msg {
		font-size: 13px;
		color: #a68f6e;
		line-height: 1.5;
		margin-bottom: 22px;
	}
	.discard__actions {
		display: flex;
		gap: 10px;
		justify-content: center;
	}

	@media (max-width: 560px) {
		.modal {
			padding: 16px 12px;
		}
		.modal__panel {
			max-height: calc(100vh - 32px);
		}
		.toggles {
			margin-left: 0;
		}
	}
</style>

<script>
	import { wireStarPicker } from '../lib/star-picker';

	const modal = document.getElementById('br-modal');
	if (modal) {
		type Seed = {
			id: number | null;
			readFrom: string;
			readTo: string;
			rating: number;
			loved: boolean;
			gaveUp?: boolean;
			text: string;
			privateNote: string;
			pacing: string;
			focus: string;
			moods: string[];
			tones: string[];
		};
		type Read = { from: string; to: string; label: string };

		const config = JSON.parse(modal.dataset.config || '{}') as {
			bookId: number;
			newRead: Read;
			latestRead: Read | null;
			priorReads: number;
			attachOnBody: string;
			attachOffBody: string;
			gaveUp: boolean;
		};

		const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
		const readLabel = $('br-read-label');
		const clearRating = $<HTMLButtonElement>('br-clear-rating');
		const lovedBtn = $<HTMLButtonElement>('br-loved');
		const rereadBtn = $<HTMLButtonElement>('br-reread');
		const lovedHint = $('br-loved-hint');
		const attach = $('br-attach');
		const attachLabel = $('br-attach-label');
		const attachTitle = $('br-attach-title');
		const attachBody = $('br-attach-body');
		const attachAction = $<HTMLButtonElement>('br-attach-action');
		const textArea = $<HTMLTextAreaElement>('br-text');
		const privateArea = $<HTMLTextAreaElement>('br-private');
		const privateToggle = $<HTMLButtonElement>('br-private-toggle');
		const moodCount = $('br-mood-count');
		const toneCount = $('br-tone-count');
		const clearMoods = $<HTMLButtonElement>('br-clear-moods');
		const clearTones = $<HTMLButtonElement>('br-clear-tones');
		const leftBtn = $<HTMLButtonElement>('br-left');
		const saveBtn = $<HTMLButtonElement>('br-save');
		const msg = $('br-msg');
		const discard = $('br-discard');
		const discardTitle = $('br-discard-title');

		const empty = (): Seed => ({
			id: null,
			readFrom: config.newRead.from,
			readTo: config.newRead.to,
			rating: 0,
			loved: false,
			gaveUp: config.gaveUp,
			text: '',
			privateNote: '',
			pacing: '',
			focus: '',
			moods: [],
			tones: [],
		});

		let seed = empty();
		let state = empty();
		let mode: 'write' | 'edit' = 'write';
		let reread = false;
		let saved = false;

		// The shared half-star picker (see StarPicker.astro). The "Clear" control
		// sits in the field head here rather than inside the picker, so that the
		// row is stars and heart alone and clearing appears only once there is
		// something to clear.
		const starPicker = wireStarPicker($('br-starpicker'), {
			onChange: (v) => {
				state.rating = v ?? 0;
				saved = false;
				render();
			},
		});

		const same = (a: string[], b: string[]) => a.join('|') === b.join('|');
		const dirty = () =>
			state.rating !== seed.rating ||
			state.text !== seed.text ||
			state.privateNote !== seed.privateNote ||
			state.pacing !== seed.pacing ||
			state.focus !== seed.focus ||
			state.loved !== seed.loved ||
			reread ||
			!same(state.moods, seed.moods) ||
			!same(state.tones, seed.tones);

		function pressed(el: HTMLElement, on: boolean) {
			el.setAttribute('aria-pressed', on ? 'true' : 'false');
		}

		function paintGroup(id: string, values: string[]) {
			modal!.querySelectorAll<HTMLButtonElement>(`#${id} button`).forEach((b) => {
				pressed(b, values.includes(b.dataset.value || ''));
			});
		}

		function render() {
			// The picker paints its own hover; this only puts the committed value
			// back, which is what every other caller of render() has just changed.
			starPicker.set(state.rating || null);
			clearRating.hidden = state.rating === 0;
			pressed(lovedBtn, state.loved);
			pressed(rereadBtn, reread);
			lovedHint.hidden = !(state.loved && !state.rating);

			// The Re-read choice only exists when there is an earlier read to
			// confuse this one with.
			const showAttach = mode === 'write' && config.priorReads > 0 && !!config.latestRead;
			rereadBtn.hidden = !showAttach;
			attach.hidden = !showAttach;
			if (showAttach) {
				attach.classList.toggle('attach--on', reread);
				attachLabel.textContent = reread ? 'New read' : 'Attaching to';
				attachTitle.textContent = reread ? config.newRead.label : config.latestRead!.label;
				attachBody.textContent = reread ? config.attachOnBody : config.attachOffBody;
				attachAction.textContent = reread
					? 'Not a re-read. Keep it on the latest read'
					: '↻ This is a new read';
			}

			paintGroup('br-pacing', state.pacing ? [state.pacing] : []);
			paintGroup('br-focus', state.focus ? [state.focus] : []);
			paintGroup('br-moods', state.moods);
			paintGroup('br-tones', state.tones);
			// Counted from the rendered buttons, not written down: the vocabularies
			// are defined once in book-queries.ts and have already grown once.
			const moodTotal = modal!.querySelectorAll('#br-moods button').length;
			const toneTotal = modal!.querySelectorAll('#br-tones button').length;
			moodCount.textContent = state.moods.length
				? `${state.moods.length} of ${moodTotal} selected`
				: 'none yet';
			toneCount.textContent = state.tones.length
				? `${state.tones.length} of ${toneTotal} selected`
				: 'none yet';
			clearMoods.hidden = state.moods.length === 0;
			clearTones.hidden = state.tones.length === 0;

			saveBtn.textContent = mode === 'edit' ? 'Save changes' : 'Save review';
			leftBtn.textContent = mode === 'edit' ? 'Delete review' : 'Cancel';
			leftBtn.classList.toggle('btn-ghost--danger', mode === 'edit');
			discardTitle.textContent = mode === 'edit' ? 'Discard changes?' : 'Discard this review?';
			msg.textContent = saved ? 'Saved' : dirty() ? 'Unsaved changes' : '';
			msg.classList.toggle('save-msg--ok', saved);
		}

		function open(button: HTMLElement) {
			const raw = button.dataset.seed;
			mode = raw ? 'edit' : 'write';
			seed = raw ? { ...empty(), ...(JSON.parse(raw) as Seed) } : empty();
			state = { ...seed, moods: [...seed.moods], tones: [...seed.tones] };
			reread = false;
			saved = false;
			readLabel.textContent =
				button.dataset.readLabel ||
				(config.priorReads && config.latestRead ? config.latestRead.label : config.newRead.label);
			textArea.value = state.text;
			privateArea.value = state.privateNote;
			// Open iff there's a note — never a state where a note is held unseen.
			showPrivate(state.privateNote.length > 0);
			modal!.hidden = false;
			document.body.style.overflow = 'hidden';
			render();
		}

		function close() {
			modal!.hidden = true;
			discard.hidden = true;
			document.body.style.overflow = '';
		}

		function attemptClose() {
			if (dirty()) discard.hidden = false;
			else close();
		}

		document.querySelectorAll<HTMLElement>('[data-open-review]').forEach((b) => {
			b.addEventListener('click', () => open(b));
		});

		$('br-close').addEventListener('click', attemptClose);
		modal.querySelector('[data-close]')?.addEventListener('click', attemptClose);
		$('br-keep').addEventListener('click', () => (discard.hidden = true));
		$('br-discard-confirm').addEventListener('click', close);
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !modal!.hidden) attemptClose();
		});

		clearRating.addEventListener('click', () => {
			state.rating = 0;
			saved = false;
			render();
		});

		lovedBtn.addEventListener('click', () => {
			state.loved = !state.loved;
			saved = false;
			render();
		});
		const toggleReread = () => {
			reread = !reread;
			saved = false;
			render();
		};
		rereadBtn.addEventListener('click', toggleReread);
		attachAction.addEventListener('click', toggleReread);

		textArea.addEventListener('input', () => {
			state.text = textArea.value;
			saved = false;
			render();
		});

		// Open/closed is derived from the text, never stored; closing discards.
		function showPrivate(on: boolean) {
			privateArea.hidden = !on;
			privateToggle.setAttribute('aria-expanded', String(on));
		}
		privateToggle.addEventListener('click', () => {
			if (privateArea.hidden) {
				showPrivate(true);
				privateArea.focus();
				return;
			}
			if (privateArea.value.trim() && !window.confirm('Discard the private note?')) return;
			privateArea.value = '';
			state.privateNote = '';
			showPrivate(false);
			saved = false;
			render();
		});
		privateArea.addEventListener('input', () => {
			state.privateNote = privateArea.value;
			saved = false;
			render();
		});

		const single = (id: string, key: 'pacing' | 'focus') => {
			modal!.querySelectorAll<HTMLButtonElement>(`#${id} button`).forEach((b) => {
				b.addEventListener('click', () => {
					const value = b.dataset.value || '';
					state[key] = state[key] === value ? '' : value;
					saved = false;
					render();
				});
			});
		};
		single('br-pacing', 'pacing');
		single('br-focus', 'focus');

		const multi = (id: string, key: 'moods' | 'tones') => {
			modal!.querySelectorAll<HTMLButtonElement>(`#${id} button`).forEach((b) => {
				b.addEventListener('click', () => {
					const value = b.dataset.value || '';
					const at = state[key].indexOf(value);
					if (at >= 0) state[key].splice(at, 1);
					else state[key].push(value);
					saved = false;
					render();
				});
			});
		};
		multi('br-moods', 'moods');
		multi('br-tones', 'tones');

		clearMoods.addEventListener('click', () => {
			state.moods = [];
			saved = false;
			render();
		});
		clearTones.addEventListener('click', () => {
			state.tones = [];
			saved = false;
			render();
		});

		leftBtn.addEventListener('click', async () => {
			if (mode !== 'edit') return attemptClose();
			if (seed.id == null) return close();
			msg.textContent = 'Deleting…';
			const res = await fetch(
				`/api/books/review?bookId=${config.bookId}&id=${seed.id}`,
				{ method: 'DELETE' },
			);
			if (!res.ok) {
				msg.textContent = 'Delete failed';
				return;
			}
			location.reload();
		});

		saveBtn.addEventListener('click', async () => {
			// Which read this lands on. Editing keeps the read it was opened from;
			// a new review goes to the latest stretch of sessions, unless Re-read
			// says it is a fresh one.
			const target = mode === 'edit' ? { from: seed.readFrom, to: seed.readTo } : reread || !config.latestRead ? { from: config.newRead.from, to: config.newRead.to } : { from: config.latestRead.from, to: config.latestRead.to };

			msg.textContent = 'Saving…';
			const res = await fetch('/api/books/review', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({
					bookId: config.bookId,
					readFrom: target.from,
					readTo: target.to,
					rating: state.rating,
					loved: state.loved,
					gaveUp: state.gaveUp ?? false,
					text: state.text,
					privateNote: state.privateNote,
					pacing: state.pacing,
					focus: state.focus,
					moods: state.moods,
					tones: state.tones,
				}),
			});
			if (!res.ok) {
				const body = (await res.json().catch(() => ({}))) as { error?: string };
				msg.textContent = body.error || 'Save failed';
				return;
			}
			saved = true;
			location.reload();
		});

		render();
	}
</script>
