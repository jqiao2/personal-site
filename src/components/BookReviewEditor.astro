---
// The book review dialog — the reading log's answer to EntryEditor.
//
// Same shape as the film log's composer (scrim, sticky head, scrolling body,
// sticky foot, discard guard) with the fields a book needs instead of a film's.
// One difference matters: a review here belongs to a READ, not to the book, so
// the dialog has to decide which read it is writing about. That is what the
// Re-read toggle does, and the panel under the rating says out loud which read
// a save will land on — getting it wrong silently would file a review of the
// book you just finished against the copy you read in 2019.
//
// Ships hidden. Anything with `data-open-review` opens it, carrying the review
// to edit in `data-seed` (absent means a new one).
import { FOCUS, MOODS, PACING, TONES } from '../lib/book-queries';
import StarPicker from './StarPicker.astro';

interface Props {
	bookId: number;
	bookTitle: string;
	/** Where a new review lands when Re-read is on: the latest stretch of sessions. */
	newRead: { from: string; to: string; label: string };
	/** The read a new review lands on when Re-read is off. Null when there are none. */
	latestRead: { from: string; to: string; label: string } | null;
	priorReads: number;
	attachOnBody: string;
	attachOffBody: string;
	/** True while the book is given up, so a fresh review records that ending. */
	gaveUp: boolean;
}

const { bookId, bookTitle, newRead, latestRead, priorReads, attachOnBody, attachOffBody, gaveUp } =
	Astro.props;

const config = JSON.stringify({ bookId, newRead, latestRead, priorReads, attachOnBody, attachOffBody, gaveUp });
---

<div class="modal" id="br-modal" data-config={config} hidden>
	<div class="modal__backdrop" data-close></div>
	<div class="modal__panel" role="dialog" aria-modal="true" aria-labelledby="br-title">
		<div class="modal__head">
			<div class="modal__heading">
				<div class="modal__title" id="br-title">{bookTitle}</div>
				<div class="modal__read" id="br-read-label">This read</div>
			</div>
			<button type="button" class="modal__close" id="br-close" aria-label="Close">✕</button>
		</div>

		<div class="discard" id="br-discard" hidden>
			<div class="discard__box">
				<div class="discard__title" id="br-discard-title">Discard this review?</div>
				<div class="discard__msg">You have unsaved changes to this review.</div>
				<div class="discard__actions">
					<button type="button" class="btn-ghost" id="br-keep">Keep editing</button>
					<button type="button" class="btn-discard" id="br-discard-confirm">Discard</button>
				</div>
			</div>
		</div>

		<div class="modal__body">
			<div class="field">
				<div class="field__head">
					<span class="lbl">Rating</span>
					<button type="button" class="linkish" id="br-clear-rating" hidden>Clear</button>
				</div>
				<div class="rating-row">
					<StarPicker
						id="br-starpicker"
						style="--sp-size:29px;--sp-empty:#3d2d1a;--sp-fill:#cfa452;--sp-label:#cfa452;--sp-label-size:20px;--sp-label-font:'Newsreader', serif"
					/>
					<div class="toggles">
						<button type="button" class="toggle" id="br-loved">♥ Loved</button>
						<button type="button" class="toggle" id="br-reread" hidden>↻ Re-read</button>
					</div>
				</div>
				<div class="hint" id="br-loved-hint" hidden>
					Loved with no stars is a complete answer. The page will show the heart on its own.
				</div>
			</div>

			<div class="attach" id="br-attach" hidden>
				<div class="attach__label" id="br-attach-label">Attaching to</div>
				<div class="attach__title" id="br-attach-title"></div>
				<div class="attach__body" id="br-attach-body"></div>
				<button type="button" class="btn-ghost btn-ghost--sm" id="br-attach-action"></button>
			</div>

			<div class="field">
				<label class="lbl" for="br-text">Review</label>
				<textarea id="br-text" rows="5" placeholder="What stayed with you…"></textarea>
				<button
					type="button"
					class="privnote__toggle"
					id="br-private-toggle"
					aria-expanded="false"
					aria-controls="br-private"
				>
					<span class="privnote__lock" aria-hidden="true">🔒</span>Private note
				</button>
				<textarea id="br-private" class="privnote__box" rows="3" hidden></textarea>
			</div>

			<div class="scales">
				<div>
					<span class="lbl">Pacing</span>
					<div class="segmented" id="br-pacing">
						{PACING.map((p) => <button type="button" class="seg" data-value={p}>{p}</button>)}
					</div>
					<div class="scale-ends"><span>slower</span><span>faster</span></div>
				</div>
				<div>
					<span class="lbl">Character focus</span>
					<div class="segmented" id="br-focus">
						{FOCUS.map((f) => <button type="button" class="seg" data-value={f}>{f}</button>)}
					</div>
					<div class="scale-ends"><span>character</span><span>plot</span></div>
				</div>
			</div>

			<div class="field">
				<div class="field__head">
					<span class="lbl">Mood</span>
					<span class="count" id="br-mood-count">none yet</span>
					<button type="button" class="linkish linkish--end" id="br-clear-moods" hidden>Clear</button>
				</div>
				<div class="grid" id="br-moods">
					{
						MOODS.map((m) => (
							<button type="button" class="check" data-value={m}>
								<span class="check__box">✓</span>
								{m}
							</button>
						))
					}
				</div>
			</div>

			<div class="field">
				<div class="field__head">
					<span class="lbl">Tone</span>
					<span class="count" id="br-tone-count">none yet</span>
					<button type="button" class="linkish linkish--end" id="br-clear-tones" hidden>Clear</button>
				</div>
				<div class="grid" id="br-tones">
					{
						TONES.map((t) => (
							<button type="button" class="check" data-value={t}>
								<span class="check__box">✓</span>
								{t}
							</button>
						))
					}
				</div>
			</div>
		</div>

		<div class="modal__foot">
			<button type="button" class="btn-ghost" id="br-left">Cancel</button>
			<div class="foot__right">
				<span class="save-msg" id="br-msg"></span>
				<button type="button" class="btn-save" id="br-save">Save review</button>
			</div>
		</div>
	</div>
</div>

<style>
	.modal {
		position: fixed;
