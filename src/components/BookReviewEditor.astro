		color: #8a745a;
	}
	.attach--on .attach__label {
		color: #cfa452;
	}
	.attach__title {
		font-family: 'Newsreader', serif;
		font-size: 17px;
		color: #f2e6cd;
		line-height: 1.45;
		margin-top: 8px;
	}
	.attach__body {
		font-size: 12.5px;
		color: #8a745a;
		line-height: 1.6;
		margin-top: 7px;
		max-width: 460px;
	}

	textarea {
		width: 100%;
		background: #1a120a;
		border: 1px solid #45341f;
		border-radius: 9px;
		padding: 13px 14px;
		color: #f2e6cd;
		font-size: 15px;
		font-family: 'Newsreader', serif;
		line-height: 1.6;
		outline: none;
		resize: vertical;
	}
