---
// Twenty-four bars over one local day. See src/lib/reading-hours.ts for the
// shape of it; this is the markup, the chrome, and the pointer handling.
//
// Two callers, deliberately one component. On the month card it is `mini` and
// part of an exported image, so it has no tooltip — an image cannot be hovered.
// On the book page it is `lg` and does.
//
// The chart is always drawn. It had a Show/Hide control once, on the theory that
// twenty-four bars are an imposition on a page that has plenty to say already;
// they are not, at this size, and a reader who has scrolled to "When you read
// it" has already asked the question the chart answers.
import { buildHistogram, type HourSize } from '../lib/reading-hours';

interface Props {
	hours: number[];
	size: HourSize;
	scale?: number;
	title?: string;
	fallback?: string;
}

const { hours, size, scale = 1, title = '', fallback } = Astro.props;

const chart = buildHistogram({ hours, size, scale, fallback });
const { geom } = chart;

// Only a title puts a header on the chart. `mini` never has one: on the card the
// band's own heading sits above it.
const showHeader = size !== 'mini' && !!title;
const gap = Math.round(11 * (size === 'mini' ? scale : 1));
---

<div class="hours" style={`gap:${gap}px`} data-hourchart={chart.geom.chrome ? '' : null}>
	{
		showHeader && (
			<div class="hours__head">
				<div class:list={['hours__title', size === 'sm' && 'hours__title--sm']}>{title}</div>
			</div>
		)
	}

	{
		!chart.enough && (
			<div class:list={['hours__fallback', size === 'sm' && 'hours__fallback--sm']}>
				{chart.fallback}
			</div>
		)
	}

	{
		chart.enough && (
			<div class="hours__body">
				<div class="hours__plot" style={`height:${geom.H}px`} data-hours-plot>
					<div class="hours__cols" style={`gap:${geom.gap}px`}>
						{chart.columns.map((c) => (
							<div class="hours__col" data-hour={c.hour} data-tip={c.tip}>
								<div
									class="hours__bar"
									data-empty={c.pages ? null : ''}
									style={`height:${c.height}px;background:${c.background};border-radius:${c.radius}`}
								/>
							</div>
						))}
					</div>
					<div class="hours__baseline" />
					{geom.chrome && <div class="hours__tip" data-hours-tip hidden />}
				</div>

				<div
					class="hours__axis"
					style={`height:${Math.round(geom.type * 1.5)}px;margin-top:${Math.round(7 * scale)}px`}
				>
					{chart.labels.map((l) => (
						<div
							class="hours__label"
							style={`left:${l.left.toFixed(2)}%;transform:translateX(${l.shift});font-size:${geom.type}px`}
						>
							{l.text}
						</div>
					))}
				</div>
			</div>
		)
	}
</div>

<style>
	.hours {
		display: flex;
		flex-direction: column;
	}
	.hours__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 14px;
	}
	.hours__title {
		font-family: 'Newsreader', serif;
		font-style: italic;
		font-size: 19px;
		color: #ead9b6;
		line-height: 1.2;
	}
	.hours__title--sm {
		font-size: 17px;
	}
	.hours__fallback {
		font-family: 'Newsreader', serif;
		font-style: italic;
		font-size: 17px;
		color: #8a745a;
		line-height: 1.55;
	}
	.hours__fallback--sm {
		font-size: 15.5px;
	}
	.hours__plot {
		position: relative;
		touch-action: none;
		cursor: crosshair;
	}
	.hours__cols {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: flex-end;
	}
	.hours__col {
		flex: 1 1 0;
		min-width: 0;
		height: 100%;
		display: flex;
		align-items: flex-end;
	}
	/* The hovered hour lights its whole column, not just the bar — an empty hour
	   has to be hoverable too, or the tooltip goes quiet exactly where "nothing
	   read" is the interesting answer. */
	.hours__col[data-on] {
		background: rgba(207, 164, 82, 0.07);
	}
	.hours__col[data-on] .hours__bar:not([data-empty]) {
		box-shadow: 0 0 0 1px #ecc87c;
	}
	.hours__baseline {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 1px;
		background: #45341f;
	}
	.hours__bar {
		width: 100%;
	}
	.hours__tip {
		position: absolute;
		bottom: calc(100% + 8px);
		white-space: nowrap;
		z-index: 20;
		background: #241a10;
		border: 1px solid #45341f;
		border-radius: 7px;
		padding: 7px 11px;
		font-size: 11.5px;
		color: #f2e6cd;
		box-shadow: 0 14px 32px -12px rgba(0, 0, 0, 0.85);
		pointer-events: none;
	}
	.hours__axis {
		position: relative;
	}
	.hours__label {
		position: absolute;
		top: 0;
		letter-spacing: 0.6px;
		color: #8a745a;
		white-space: nowrap;
	}
</style>

<script>
	const HOURS = 24;

	function wire(root: HTMLElement) {
		const plot = root.querySelector<HTMLElement>('[data-hours-plot]');
		const tip = root.querySelector<HTMLElement>('[data-hours-tip]');
		const cols = Array.from(root.querySelectorAll<HTMLElement>('.hours__col'));
		if (!plot || !tip || cols.length === 0) return;

		let shown = -1;

		const clear = () => {
			if (shown < 0) return;
			cols[shown]?.removeAttribute('data-on');
			tip.hidden = true;
			shown = -1;
		};

		const move = (clientX: number) => {
			const r = plot.getBoundingClientRect();
			if (r.width === 0) return;
			const i = Math.floor(((clientX - r.left) / r.width) * HOURS);
			if (i < 0 || i >= HOURS || i === shown) return;
			cols[shown]?.removeAttribute('data-on');
			shown = i;
			const col = cols[i];
			col.setAttribute('data-on', '');
			tip.textContent = col.dataset.tip ?? '';
			// Centre on the column, then pull the tooltip inside the plot at the
			// ends — at 2am the box is wider than the space left of it.
			const left = (i / HOURS) * 100 + 100 / (HOURS * 2);
			tip.style.left = `${left.toFixed(2)}%`;
			tip.style.transform = `translateX(${left < 22 ? '0%' : left > 78 ? '-100%' : '-50%'})`;
			tip.hidden = false;
		};

		plot.addEventListener('mousemove', (e) => move(e.clientX));
		plot.addEventListener('pointerdown', (e) => move(e.clientX));
		plot.addEventListener('mouseleave', clear);
	}

	for (const root of document.querySelectorAll<HTMLElement>('[data-hourchart]')) {
		wire(root);
	}
</script>
