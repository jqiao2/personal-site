---
// The map view, for both Restaurants and To try.
//
// MapLibre GL over MapTiler's vector tiles, on a basemap styled entirely by us
// (see src/lib/map-style.ts). Everything that made the earlier hand-drawn
// version work is kept — what changes is that the pins now sit on streets and
// water instead of on ruled paper, which is the difference between knowing a
// pin is in Sunset Park and being told so.
//
// THE PIN CARRIES THE TRIP ANSWER, and nothing else. Filled means worth the
// trip; blank means not. One question, two states, no key to memorise — which
// is the most a 26px mark can carry and be read at a glance. The verdict's six
// rungs and three colour bands used to live here and asked far more of the
// mark than that, and asked it of pins that often had no verdict at all: the
// whole to-try map is places nobody has been to. Everything else about a place
// — verdict, stars, heart, visit count — is one click away in the popup, at a
// size where it can actually be read.
//
// NOTHING IS CLUSTERED. Pins that overlap overlap; the one on top is a hover
// away from the one beneath, and a zoom separates them. Collapsing them into a
// disc traded the content for a number the caption already gives.
//
// WHAT HAPPENS ON FIRST LOAD. Not fit-to-bounds over everything — four fifths
// of the pins are one dense New York cluster and the rest are in Mexico City,
// Austin, LA and Tokyo, so that gives a world map with five specks. Not a
// hardcoded New York either, which silently hides a fifth of the collection.
// The map fits the bounds of whichever city holds the most of it, and the panel
// beside it names every other city with its count — both the affordance that
// says the rest of the world is there and the control that goes to it.
//
// MOBILE. A map wants full height on a phone, which leaves nowhere for the city
// list. Below 760px the list becomes a horizontal strip of chips above the map.
// Pinch zooms; it does not rotate — see the handler setup in the script.
import { verdictAt } from '../lib/verdict';
import { MAP_TOKENS } from '../lib/map-style';
import type { MapPoint } from '../lib/restaurant-map';

interface Props {
	points: MapPoint[];
	cities: { name: string; count: number }[];
	/** The city currently framed. Null means "the one with the most pins". */
	activeCity: string | null;
	/** Builds the href for a city chip; the page owns the rest of the query. */
	cityHref: (city: string | null) => string;
	caption?: string;
}

const { points, cities, activeCity, cityHref, caption } = Astro.props;

const framedCity = activeCity ?? cities[0]?.name ?? null;
const placed = points.filter((p) => Number.isFinite(p.lat) && Number.isFinite(p.lng));

const config = {
	key: import.meta.env.PUBLIC_MAPTILER_KEY ?? '',
	framedCity,
	points: placed.map((p) => ({
		id: p.id,
		name: p.name,
		lat: p.lat,
		lng: p.lng,
		verdict: p.verdict,
		visited: p.visited,
		trip: p.trip,
		price: p.price,
		cuisine: p.cuisine,
		city: p.city,
		where: p.where,
		rating: p.rating,
		visits: p.visits,
		hearted: p.hearted,
		verdictLabel: verdictAt(p.verdict)?.label ?? 'No verdict yet',
	})),
	tokens: MAP_TOKENS,
};

const unplaced = points.length - placed.length;
const hasKey = Boolean(config.key);
---

<div class="map">
	<div class="map__cities">
		<div class="map__cities-head rl-label">Elsewhere</div>
		<div class="map__cities-list">
			{
				cities.map((c) => (
					<a
						class:list={['cityrow', c.name === framedCity && 'cityrow--on']}
						href={cityHref(c.name)}
						aria-current={c.name === framedCity ? 'true' : undefined}
					>
						<span class="cityrow__name">{c.name}</span>
						<span class="rl-gap" />
						<span class="cityrow__n">{c.count}</span>
					</a>
				))
			}
		</div>
	</div>

	<div class="map__canvas">
		<div class="map__gl" data-map></div>

		{
			!hasKey && (
				<p class="map__note">
					The basemap needs <code>PUBLIC_MAPTILER_KEY</code> set. The pins are still
					plotted; only the streets under them are missing.
				</p>
			)
		}
		{
			hasKey && placed.length === 0 && (
				<p class="map__note">
					Nothing here has coordinates yet. A place lands on the map once its
					location is confirmed in the composer.
				</p>
			)
		}

		<div class="legend">
			<span class="rl-label">Pin ink</span>
			<span class="legend__item"><i class="legend__full"></i>worth the trip †</span>
			<span class="legend__item"><i class="legend__blank"></i>if I’m nearby</span>
		</div>

		<div class="map__caption">
			{framedCity ?? 'Everywhere'}
			<span class="map__off"> · {placed.length} placed</span>
			{unplaced > 0 && <span class="map__off"> · {unplaced} without coordinates</span>}
			{caption && <span class="map__cap2"> · {caption}</span>}
		</div>
	</div>
</div>

<script type="application/json" id="restaurant-map-config" set:html={JSON.stringify(config)} is:inline />

<script>
	import * as maplibregl from 'maplibre-gl';
	import 'maplibre-gl/dist/maplibre-gl.css';
	// MapLibre 6 decodes tiles in a module worker that it loads as a SIBLING of
	// whatever file it is bundled into — it builds the URL at runtime from
	// `import.meta.url`, which a bundler cannot see, so the worker is never
	// emitted and the request 404s. The map then looks like it is working:
	// the style and the TileJSON load on the main thread, so the attribution
	// appears and the controls draw, while every tile silently fails to decode
	// and not one road, river or label is ever painted.
	//
	// `?worker&url` rather than plain `?url`: the worker is not a single file.
	// It does `import {...} from './maplibre-gl-shared.mjs'`, so copying it
	// alone emits something that loads and then fails to resolve its own
	// import — the same blank map, one layer further down. `?worker` runs it
	// through Vite's worker build so that dependency is bundled in, and `&url`
	// hands back the path instead of a constructor, which is what
	// setWorkerUrl takes. astro.config.mjs sets worker.format to 'es' so the
	// emitted file is the module worker MapLibre asks for.
	import maplibreWorkerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';
	maplibregl.setWorkerUrl(maplibreWorkerUrl);
	import { menuBasemap, MAP_TOKENS } from '../lib/map-style';

	interface Pin {
		id: number;
		name: string;
		lat: number;
		lng: number;
		verdict: number | null;
		visited: boolean;
		trip: boolean;
		price: string | null;
		cuisine: string;
		city: string;
		where: string;
		rating: number | null;
		visits: number;
		hearted: boolean;
		verdictLabel: string;
	}

	const tag = document.getElementById('restaurant-map-config');
	const host = document.querySelector<HTMLElement>('[data-map]');
	if (tag && host) {
		const cfg = JSON.parse(tag.textContent || '{}') as {
			key: string;
			framedCity: string | null;
			points: Pin[];
			tokens: typeof MAP_TOKENS;
		};

		const map = new maplibregl.Map({
			container: host,
			// Without a key there are no tiles, but the pins are still worth
			// plotting — so the map falls back to a bare cream ground rather than
			// refusing to render.
			style: cfg.key
				? (menuBasemap(cfg.key) as maplibregl.StyleSpecification)
				: {
						version: 8,
						sources: {},
						layers: [
							{ id: 'ground', type: 'background', paint: { 'background-color': cfg.tokens.land } },
						],
					},
			center: [-73.99, 40.71],
			zoom: 11,
			attributionControl: { compact: true },
			// The section is a printed object; a tilted, spinning map is not. But
			// `touchZoomRotate: false` turned off the whole two-finger handler, and
			// pinch-to-zoom went out with the rotation — on a phone that left the
			// +/- buttons as the only way to zoom a full-height map. Keep the
			// handler and disable only the half that spins it, below.
			pitchWithRotate: false,
			dragRotate: false,
			touchPitch: false,
		});
		// Pinch zooms, two fingers never rotate. `disableRotation` also stops the
		// gesture from being read as a rotation at all, so a pinch that starts
		// slightly twisted still zooms instead of doing nothing.
		map.touchZoomRotate.disableRotation();
		map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

		/** Frame the chosen city, or everything if it has no pins. */
		function frame() {
			const inCity = cfg.framedCity
				? cfg.points.filter((p) => p.city === cfg.framedCity)
				: cfg.points;
			const use = inCity.length ? inCity : cfg.points;
			if (use.length === 0) return;
			if (use.length === 1) {
				map.jumpTo({ center: [use[0].lng, use[0].lat], zoom: 14.5 });
				return;
			}
			const b = new maplibregl.LngLatBounds();
			for (const p of use) b.extend([p.lng, p.lat]);
			map.fitBounds(b, { padding: 64, maxZoom: 15, animate: false });
		}

		function pinEl(p: Pin): HTMLElement {
			const el = document.createElement('a');
			el.className = 'gl-pin';
			el.href = `/restaurants/place/${p.id}`;
			el.title = p.trip ? `${p.name} — worth the trip` : p.name;
			el.innerHTML = `<svg viewBox="0 0 26 34" width="26" height="34" aria-hidden="true">
					<path d="M13 33 C13 33 24 20.5 24 13 A11 11 0 1 0 2 13 C2 20.5 13 33 13 33 Z"
						fill="${p.trip ? MAP_TOKENS.pinRing : '#fdf7e8'}"
						stroke="${MAP_TOKENS.pinRing}" stroke-width="1.6"></path>
				</svg><span class="gl-pin__name">${escape(p.name)}</span>`;
			return el;
		}

		function escape(s: string): string {
			const d = document.createElement('span');
			d.textContent = s;
			return d.innerHTML;
		}

		function popupHtml(p: Pin): string {
			const stars = p.rating ? '★'.repeat(Math.floor(p.rating)) + (p.rating % 1 >= 0.5 ? '½' : '') : '';
			const visits = p.visits === 1 ? '1 visit' : `${p.visits} visits`;
			return `<div class="gl-pop">
				<div class="gl-pop__top">
					<span class="gl-pop__name">${escape(p.name)}</span>
					${p.hearted ? '<span class="gl-pop__heart">♥</span>' : ''}
					<span class="gl-pop__gap"></span>
					<span class="gl-pop__price">${escape(p.price ?? '')}</span>
				</div>
				<div class="gl-pop__meta">${escape(p.cuisine)}${stars ? ` <span class="gl-pop__stars">${stars}</span>` : ''}</div>
				<div class="gl-pop__foot">
					<span>${escape(p.verdictLabel)}</span>
					<span class="gl-pop__visits">${p.visited ? visits : 'not been yet'}</span>
				</div>
				<a class="gl-pop__go" href="/restaurants/place/${p.id}">${escape(p.where)} →</a>
			</div>`;
		}

		// A tile failure must not take the pins with it.
		//
		// 'load' waits for the style AND its sources, so if MapTiler is
		// unreachable — an outage, a blown quota, a key restricted to the wrong
		// domain — it never fires, and hanging the markers off it would leave a
		// blank rectangle where the whole map used to be. 'styledata' fires as
		// soon as the style is parsed, which is all that is needed to add a
		// source, so the pins come up on the cream ground with or without
		// streets under them. Degrading to a worse map is fine; degrading to no
		// map is not.
		map.on('error', (e) => {
			// Tile 404s are routine at the edges of a fitBounds; only say
			// something once, and never throw.
			console.warn('map:', e.error?.message ?? 'tile or style request failed');
		});

		function whenStyleReady(fn: () => void) {
			if (map.isStyleLoaded()) fn();
			else map.once('styledata', fn);
		}

		whenStyleReady(() => {
			frame();

			// Every pin, once, and then left alone. Markers are anchored to
			// lng/lat, so MapLibre re-places them on its own as the camera moves —
			// there is nothing to recompute per frame now that nothing is grouped,
			// and nothing here reads a tile, so the pins come up whether or not the
			// basemap does.
			//
			// Drawn far-to-near: a pin sitting lower on the screen is nearer the
			// reader, so it belongs on top of the one behind it. That is the only
			// thing standing in for the removed clustering, and it is what makes an
			// overlapping stack read as a stack instead of a smear.
			let popup: maplibregl.Popup | null = null;
			const order = [...cfg.points].sort((a, b) => b.lat - a.lat);

			for (const p of order) {
				const el = pinEl(p);
				el.addEventListener('click', (e) => {
					e.preventDefault();
					popup?.remove();
					popup = new maplibregl.Popup({ closeButton: false, offset: 30, maxWidth: '266px' })
						.setLngLat([p.lng, p.lat])
						.setHTML(popupHtml(p))
						.addTo(map);
				});
				new maplibregl.Marker({ element: el, anchor: 'bottom' })
					.setLngLat([p.lng, p.lat])
					.addTo(map);
			}
		});
	}
</script>

<style is:global>
	/* The vendor's chrome, restyled to the section's palette rather than left
	   in its default blue-grey — the giveaway that a map was dropped in. */
	.map__gl .maplibregl-ctrl-group {
		background: #fdf7e8;
		border: 1px solid var(--ink);
		border-radius: 0;
		box-shadow: none;
	}
	.map__gl .maplibregl-ctrl-group button + button {
		border-top: 1px solid var(--rule);
	}
	.map__gl .maplibregl-ctrl-attrib {
		background: rgba(253, 247, 232, 0.86);
		font-family: var(--ui);
		font-size: 10px;
	}
	.map__gl .maplibregl-ctrl-attrib a {
		color: var(--ink-3);
	}

	.gl-pin {
		display: block;
		cursor: pointer;
		filter: drop-shadow(0 1px 1px rgba(47, 30, 18, 0.35));
	}
	/* Pins are allowed to overlap now, so the one being pointed at has to be
	   able to come out from under its neighbours — otherwise the name label
	   under it renders behind them. */
	.gl-pin:hover {
		z-index: 3;
	}
	.gl-pin__name {
		position: absolute;
		left: 50%;
		top: 100%;
		transform: translateX(-50%);
		white-space: nowrap;
		font-family: var(--ui);
		font-size: 10.5px;
		color: var(--ink);
		background: rgba(253, 247, 232, 0.9);
		padding: 1px 4px;
		opacity: 0;
		pointer-events: none;
		transition: opacity 90ms;
	}
	.gl-pin:hover .gl-pin__name {
		opacity: 1;
	}

	/* The popup is the tile's anatomy at popup size: name, heart, gap, price. */
	.maplibregl-popup-content {
		background: #fdf7e8;
		border: 1px solid var(--ink);
		border-radius: 0;
		box-shadow: 0 4px 12px rgba(47, 30, 18, 0.22);
		padding: 11px 13px 12px;
		font-family: var(--ui);
	}
	.maplibregl-popup-tip {
		border-top-color: var(--ink) !important;
	}
	.gl-pop__top {
		display: flex;
		align-items: baseline;
		gap: 8px;
	}
	.gl-pop__name {
		font-size: 14.5px;
		font-weight: 600;
		color: var(--ink);
	}
	.gl-pop__heart {
		font-size: 12px;
		color: var(--terracotta-deep);
	}
	.gl-pop__gap {
		flex: 1;
		min-width: 12px;
	}
	.gl-pop__price {
		font-family: var(--mono);
		font-size: 12.5px;
		color: var(--ink);
	}
	.gl-pop__meta {
		margin-top: 4px;
		font-size: 11.5px;
		color: var(--ink-2);
	}
	.gl-pop__stars {
		color: var(--marigold);
		letter-spacing: 0.6px;
	}
	.gl-pop__foot {
		margin-top: 9px;
		padding-top: 9px;
		border-top: 1px solid var(--rule-4);
		display: flex;
		align-items: center;
		gap: 9px;
		font-size: 12.5px;
		color: var(--ink);
	}
	.gl-pop__visits {
		margin-left: auto;
		font-family: var(--mono);
		font-size: 11px;
		color: var(--ink-3);
	}
	.gl-pop__go {
		display: block;
		margin-top: 8px;
		font-size: 11.5px;
		color: var(--terracotta-deep);
	}
</style>

<style>
	.map {
		margin-top: 16px;
		display: flex;
		flex-wrap: wrap-reverse;
		border: 1px solid var(--rule);
	}
	.map__canvas {
		flex: 999 1 380px;
		position: relative;
		background: #f2e7d2;
		height: min(70vh, 560px);
		min-height: 360px;
		overflow: hidden;
	}
	.map__gl {
		position: absolute;
		inset: 0;
	}
	.map__note {
		position: absolute;
		left: 50%;
		top: 50%;
		z-index: 2;
		transform: translate(-50%, -50%);
		max-width: 320px;
		text-align: center;
		font-family: var(--prose);
		font-size: 15px;
		color: var(--ink-2);
		background: rgba(253, 247, 232, 0.92);
		border: 1px solid var(--rule);
		padding: 14px 16px;
	}
	.map__note code {
		font-family: var(--mono);
		font-size: 12.5px;
	}

	.legend {
		position: absolute;
		left: 14px;
		bottom: 30px;
		z-index: 2;
		max-width: calc(100% - 28px);
		background: rgba(253, 247, 232, 0.94);
		border: 1px solid var(--rule);
		padding: 9px 11px;
		display: flex;
		align-items: center;
		gap: 8px 14px;
		flex-wrap: wrap;
		pointer-events: none;
	}
	.legend__item {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 11.5px;
		color: var(--ink-2);
	}
	.legend__item i {
		width: 11px;
		height: 11px;
		display: block;
		border-radius: 50%;
	}
	/* The two swatches are the two pins, minus the teardrop tail: one inked in,
	   one left as paper. */
	.legend__full {
		background: var(--ink);
		border: 1.6px solid var(--ink);
	}
	.legend__blank {
		background: #fdf7e8;
		border: 1.6px solid var(--ink);
	}

	.map__caption {
		position: absolute;
		right: 14px;
		top: 14px;
		z-index: 2;
		background: rgba(253, 247, 232, 0.94);
		border: 1px solid var(--rule);
		padding: 6px 10px;
		font-family: var(--mono);
		font-size: 11px;
		color: var(--ink-3);
		pointer-events: none;
	}
	.map__off {
		color: var(--terracotta-deep);
	}
	.map__cap2 {
		color: var(--ink-4);
	}

	.map__cities {
		flex: 1 1 190px;
		min-width: 0;
		background: var(--panel);
		border-left: 1px solid var(--rule);
		order: 2;
	}
	.map__cities-head {
		padding: 14px 14px 10px;
		border-bottom: 1px solid var(--rule);
	}
	.cityrow {
		display: flex;
		align-items: center;
		gap: 9px;
		padding: 11px 14px;
		border-bottom: 1px solid var(--rule-2);
		color: var(--ink-2);
	}
	.cityrow:hover {
		background: #e6d5b4;
		color: var(--ink);
	}
	.cityrow--on {
		color: var(--ink);
		font-weight: 700;
	}
	.cityrow__name {
		font-size: 13px;
	}
	.cityrow__n {
		font-family: var(--mono);
		font-size: 11.5px;
		color: var(--ink-3);
	}

	@media (max-width: 760px) {
		.map {
			flex-direction: column;
		}
		.map__cities {
			/* In the row layout `flex: 1 1 190px` is a width. Here the container
			   is a column, so that same basis becomes a 190px HEIGHT that also
			   grows — an empty band above the map. The strip should be exactly
			   as tall as its chips. */
			flex: 0 0 auto;
			border-left: none;
			border-bottom: 1px solid var(--rule);
			order: 0;
		}
		.map__cities-head {
			display: none;
		}
		.map__cities-list {
			display: flex;
			gap: 8px;
			overflow-x: auto;
			padding: 10px 12px;
		}
		.cityrow {
			border: 1px solid var(--rule);
			background: var(--card);
			padding: 6px 11px;
			white-space: nowrap;
			flex: none;
		}
		.cityrow--on {
			background: var(--ink);
			color: var(--ground);
			border-color: var(--ink);
		}
		.cityrow .rl-gap {
			display: none;
		}
		.map__canvas {
			height: min(76vh, 620px);
		}
	}
</style>
