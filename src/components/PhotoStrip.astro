---
// Every photograph taken at a place, in one row.
//
// WHY THIS IS NOT THE WALL. `PhotoWall` lays out ONE visit's photographs, where
// the count is one to three and the photographs are the content of the page. A
// place is the other shape: twelve visits of one to three each, where any given
// photograph is a thumbnail in a history and the interesting thing about it is
// which meal it came from. Grouping that by visit — the wall, twelve times,
// under twelve dated headings — is a section that grows a rung every meal and
// is mostly margin. So this is a contact sheet instead: one row, the same
// height at twelve visits and at forty, scrolled sideways rather than down.
//
// WHAT THE HEADINGS CARRIED, AND WHERE IT WENT. A dated heading told you when a
// photograph was taken. Here the photograph tells you itself: point at one and
// the line under the row says its date and its caption. That line is a single
// reserved slot rather than a tooltip at the pointer, so it always appears in
// the same place and pointing along the row doesn't make the page jump.
//
// TIME RUNS LEFT TO RIGHT, AND THE ROW OPENS AT THE RIGHT. A sideways row only
// shows one end of itself until somebody scrolls it, and the end worth showing
// is the recent one. That was briefly done by reversing the photographs, which
// worked and cost too much: the verdict history directly above is a plot with a
// time axis, a time axis cannot run backwards, and one screen may not disagree
// with itself about which way the year goes. Where a row STARTS is a scroll
// position, not an order, so it is fixed as one — see `direction: rtl` in the
// stylesheet, which puts a scrollport's start edge on the right and needs no
// script and no frame in the wrong place before it corrects itself.
//
// THE SLOT IS EMPTY UNTIL IT IS POINTED AT. It carried a standing line about
// the row — how many visits, which way round — and that line was there the
// whole time to be read once, so it went. What it is now is space held open, and
// held open on purpose: the line has to arrive without the page moving under the
// pointer, and the only way to have room for it on arrival is to have had the
// room all along.
//
// WHERE A PHONE CANNOT HOVER the slot is not held open at all, since nothing can
// ever land in it. Every photograph is a link to its visit, which is where the
// date and the words are in full — hover is the shortcut, not the only route.
import { shortDate } from '../lib/restaurant-view';
import type { StripPhoto } from '../lib/restaurant-view';
import { photoSrc, photoSrcSet, photoWidthsFor } from '../lib/photo-src';

interface Props {
	photos: StripPhoto[];
}

const { photos } = Astro.props;
const when = (p: StripPhoto) => `${shortDate(p.date)} ${p.date.slice(0, 4)}`;

// A shot is `--shot-h` tall and as wide as its ratio makes it, so the widest
// one here is the widest ratio at that height: 124 × 16:9 is 220px, and
// nothing off a camera is wider than 16:9. On a phone `--shot-h` becomes a
// sixth of the column, which puts the same photograph near a quarter of the
// viewport.
const CAP = 220;
const WIDTHS = photoWidthsFor(CAP);
const SIZES = `(max-width: 560px) 25vw, ${CAP}px`;
---

<div class="shots">
	<div class="shots__rail">
		<div class="shots__track">
			{
				photos.map((p) => (
					<a class="shot" href={`/restaurants/diary/${p.visitId}`} style={`--ratio:${p.ratio}`}>
						<img
							class="shot__img"
							src={photoSrc(p.url, CAP)}
							srcset={photoSrcSet(p.url, WIDTHS)}
							sizes={SIZES}
							alt={p.caption ?? when(p)}
							width={p.width ?? undefined}
							height={p.height ?? undefined}
							loading="lazy"
							decoding="async"
						/>
						{/* Positioned against `.shots` rather than against the photograph, for
						    two reasons: every photograph's line then lands in the same slot
						    under the row instead of the eye chasing it along the strip, and an
						    element whose containing block sits outside the scroller is not
						    clipped by the scroller. */}
						<span class="shot__meta">
							<span class="shot__when">{when(p)}</span>
							{p.caption && <span class="shot__caption">{p.caption}</span>}
						</span>
					</a>
				))
			}
		</div>
	</div>
</div>

<style>
	/* Heights, not widths, are what the row agrees on: each photograph keeps its
	   own ratio, so portraits come out narrow and landscapes wide and nothing is
	   cropped to a common shape it doesn't have.

	   `--shot-h` is a px value on a desktop and a fraction of the viewport on a
	   phone, where four photographs across is what the width can carry. */
	.shots {
		--shot-h: 124px;
		--shot-gap: 8px;
		--meta-h: 34px;
		position: relative;
		margin-top: 14px;
		/* The slot the hovered line drops into. Reserved, so pointing at a
		   photograph never moves the page under the pointer. */
		padding-bottom: var(--meta-h);
	}
	.shots__rail {
		overflow-x: auto;
		overflow-y: hidden;
		scrollbar-width: thin;
		scrollbar-color: var(--rule) transparent;
		padding-bottom: 6px;
		/* THE ROW OPENS AT ITS RIGHT-HAND END. A scrollport starts at its start
		   edge, and in `rtl` that edge is the right one — so the newest
		   photographs are what you land on, with no script setting scrollLeft
		   after the fact and so no frame of the wrong end before it corrects
		   itself. Only the scrollport is turned around; the track inside is put
		   back to `ltr`, so the photographs still run oldest to newest, left to
		   right, the way the verdict history above them does. */
		direction: rtl;
	}
	.shots__track {
		direction: ltr;
		display: flex;
		flex-wrap: nowrap;
		gap: var(--shot-gap);
		/* Wide enough for the row when the row is long, and the full width of
		   the port when it isn't — otherwise a place with three photographs
		   would sit them against the right-hand edge. */
		width: max-content;
		min-width: 100%;
	}
	.shot {
		flex: none;
		display: block;
	}
	.shot__img {
		display: block;
		height: var(--shot-h);
		width: calc(var(--ratio) * var(--shot-h));
		object-fit: cover;
		box-shadow: inset 0 0 0 1px rgba(47, 30, 18, 0.18);
		background: var(--panel);
		transition: opacity 120ms ease;
	}
	/* Pointing at one photograph steps the rest back, so the line underneath
	   plainly belongs to the one under the pointer rather than to the row. */
	.shots__rail:hover .shot__img {
		opacity: 0.42;
	}
	.shots__rail .shot:hover .shot__img,
	.shot:focus-visible .shot__img {
		opacity: 1;
		box-shadow: inset 0 0 0 2px var(--terracotta);
	}
	.shot:focus-visible {
		outline: none;
	}

	.shot__meta {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: var(--meta-h);
		display: flex;
		align-items: baseline;
		gap: 9px;
		padding-top: 9px;
		margin: 0;
		line-height: 1.3;
		transition: opacity 120ms ease;
		/* One line, always: a long caption may not grow the slot and shove the
		   section below it down as the pointer moves along the row. */
		white-space: nowrap;
		overflow: hidden;
	}
	.shot__meta {
		opacity: 0;
		/* It lies over the row's slot, invisible, once per photograph. Without
		   this the last one would swallow the pointer and the slot would answer
		   for a photograph nobody was pointing at. */
		pointer-events: none;
	}
	.shot:hover .shot__meta,
	.shot:focus-visible .shot__meta {
		opacity: 1;
	}
	.shot__when {
		flex: none;
		font-family: var(--mono);
		font-size: 11px;
		color: var(--ink-2);
	}
	.shot__caption {
		min-width: 0;
		font-family: var(--prose);
		font-style: italic;
		font-size: 13.5px;
		color: var(--ink-2);
		overflow: hidden;
		text-overflow: ellipsis;
	}
	/* Where the pointer cannot hover, the line can never arrive, so the room
	   kept for it is dead space at the foot of the row and the row simply ends
	   where the photographs do. */
	@media (hover: none) {
		.shots {
			padding-bottom: 0;
		}
		/* And with no room kept, the line must not be able to appear at all — a
		   tap that lands as a hover would otherwise draw it over the foot of the
		   photographs on its way to the visit. */
		.shot__meta {
			display: none;
		}
	}

	@media (max-width: 560px) {
		.shots {
			/* Four across the column, at whatever the column is: the gutters and
			   the three gaps come off first, and a 3:2 photograph is what the
			   remaining quarter has to hold. */
			--shot-gap: 6px;
			--shot-h: calc((100vw - 2 * var(--gutter) - 3 * var(--shot-gap)) / 6);
			--meta-h: 30px;
		}
		.shot__caption {
			font-size: 12.5px;
		}
	}
</style>
