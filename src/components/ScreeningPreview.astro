---
// A compact row of what's queued up next, for the top of the watchlist page.
// Most-imminent film on the left, furthest out on the right. Poster-only tiles
// with a hover overlay for the detail, exactly like the /films/watchlist and
// /films/watched grids — a filled poster clicks through to that film's page.
//
// The row is ALWAYS drawn, empty slots and all: the header and the empty slots
// are how you reach the Screening Room, so hiding the row would strand it.
import type { QueueEntry } from '../lib/screening-queue';
import { imageUrl } from '../lib/tmdb';

interface Props {
	entries: QueueEntry[];
	/** How many slots the shelf shows (filled then empty). */
	slots?: number;
}
const { entries, slots = 5 } = Astro.props;
const shown = entries.slice(0, slots);
const empties = Math.max(0, slots - shown.length);

const dateLabel = (iso: string) =>
	new Date(`${iso}T00:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
---

<div class="preview">
	<a class="preview__head" href="/films/screening-room">
		<span class="preview__label">Screening Room</span>
		<span class="preview__link">Up next →</span>
	</a>
	<div class="preview__row">
		{shown.map((f) => {
			const poster = imageUrl(f.poster_path, 'w185');
			return (
				<a
					class={poster ? 'tile' : 'tile tile--noimg'}
					href={`/films/movie/${f.tmdb_id}`}
				>
					{poster && <img src={poster} alt={`${f.title} poster`} loading="lazy" decoding="async" />}
					<div class="tile__overlay">
						<div class="tile__title">{f.title}</div>
						<div class="tile__date">{dateLabel(f.scheduled_date)}</div>
						{f.venue && <div class="tile__venue">{f.venue}</div>}
					</div>
				</a>
			);
		})}
		{Array.from({ length: empties }).map(() => (
			<a class="tile tile--empty" href="/films/screening-room" aria-label="Open the Screening Room"></a>
		))}
	</div>
</div>

<style>
	.preview {
		width: 100%;
		max-width: 340px;
		border: 1px solid #4a2529;
		border-radius: 12px;
		padding: 14px 16px 14px;
		background: #1f0e10;
	}
	.preview__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 12px;
	}
	.preview__label {
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 1.6px;
		color: #8a6f63;
	}
	.preview__link {
		font-size: 12px;
		color: #d9b45a;
	}
	.preview__head:hover .preview__label {
		color: #c2a99a;
	}
	.preview__head:hover .preview__link {
		color: #f0d488;
	}
	.preview__row {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 8px;
	}

	/* Poster tile — same behaviour as the watchlist/watched grids: the poster
	   fills a 2/3 box and a caption overlay fades in on hover. */
	.tile {
		position: relative;
		display: block;
		aspect-ratio: 2 / 3;
		border-radius: 4px;
		overflow: hidden;
		border: 1px solid #4a2529;
		background-image: repeating-linear-gradient(135deg, #351a1d 0 7px, #2c1518 7px 14px);
		transition: border-color 0.12s;
	}
	.tile:hover {
		border-color: #d9b45a;
	}
	.tile img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.tile__overlay {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 6px;
		background: rgba(18, 8, 9, 0.86);
		opacity: 0;
		transition: opacity 0.16s ease;
	}
	.tile:hover .tile__overlay {
		opacity: 1;
	}
	/* No poster: keep the caption legible over the striped tile. */
	.tile--noimg .tile__overlay {
		opacity: 1;
		background: transparent;
		justify-content: center;
		text-align: center;
	}
	.tile__title {
		font-family: 'Newsreader', serif;
		font-size: 11px;
		line-height: 1.15;
		color: #f4e8d1;
		overflow: hidden;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
	}
	.tile__date {
		font-size: 9.5px;
		letter-spacing: 0.4px;
		text-transform: uppercase;
		color: #d9b45a;
		margin-top: 3px;
	}
	.tile__venue {
		font-size: 9px;
		color: #a2857a;
		margin-top: 2px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* Empty slot — a waiting frame that leads to the Screening Room. */
	.tile--empty {
		background-image: none;
		background: #190b0c;
		border-style: dashed;
		border-color: #3a1f22;
	}
	.tile--empty:hover {
		border-color: #d9b45a;
	}
</style>
