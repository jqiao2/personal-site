---
// The owner's two composers, in one component: "log a meal" and "add to
// to-try". Any element carrying [data-open-meal-editor] opens the first;
// [data-open-try-editor] opens the second. Both are inert for a visitor,
// because the component is only rendered for an owner session.
//
// THE THREE RATING SIGNALS. Every visit can carry a half-step star rating, a
// six-step verdict and a heart, and the naïve form gives you three rows of
// widgets stacked in a modal. They are not redundant — stars are "how good was
// it", the verdict is "how much do I want to go back and repeat it", the heart
// is "do I love it" — so the form ranks them rather than flattening them:
//
//   1. Stars come first and are the largest control. They are the question you
//      can always answer, and the one a tile leads with.
//   2. The verdict is a SLIDER, not six buttons. Six radio buttons would be six
//      equal choices; a slider says out loud that the scale is ordered, and the
//      needle beside it turns as you drag, so you learn the mark's angles by
//      using the control rather than by reading a legend.
//   3. The heart is a single toggle sitting beside the revisit mark, below
//      both. It is deliberately small: it is not a seventh rung of the verdict,
//      and giving it equal weight would imply it were.
//
// Only the stars survive onto a tile, only the verdict survives onto a map pin,
// and the heart appears on the entry and as a small mark next to a name.
import { VERDICTS } from '../lib/verdict';
import { PRICE_BANDS, WHY_TAGS } from '../lib/restaurants';
import { verdictRotation } from '../lib/verdict';
import { localDay } from '../lib/day';
import StarPicker from './StarPicker.astro';

interface Props {
	/** Where to return after saving. */
	redirect: string;
	/**
	 * Pre-selected place, when the composer is opened from a place page.
	 *
	 * `priceBand` and `previous` are what a second meal here inherits: what the
	 * place costs and whether it's worth the trip are facts about the place, and
	 * the date, verdict and heart are what the last visit said. See carryFrom.
	 */
	place?: {
		id: number;
		name: string;
		meta: string;
		visits: number;
		trip?: boolean;
		priceBand?: string | null;
		previous?: { visitedOn: string; verdict: number | null; hearted: boolean } | null;
	} | null;
	/** Editing an existing visit rather than logging a new one. */
	visitId?: number | null;
	initial?: {
		visitedOn: string;
		rating: number | null;
		verdict: number | null;
		hearted: boolean;
		revisit: boolean;
		friends: string[];
		review: string;
		tags: string[];
	} | null;
	/**
	 * The photographs already on the visit being edited, in their stored order.
	 * They are shown alongside the ones being added, because a photograph you
	 * cannot see is one you cannot take out or move — which used to mean the
	 * only way to fix the order of an entry was to delete the visit.
	 */
	photos?: { id: number; url: string }[];
	tagOptions?: string[];
	friendOptions?: string[];
	deleteRedirect?: string;
}

const {
	redirect,
	place = null,
	visitId = null,
	initial = null,
	photos = [],
	tagOptions = [],
	friendOptions = [],
	deleteRedirect = '/restaurants/diary',
} = Astro.props;

const config = {
	redirect,
	place,
	visitId,
	initial,
	photos,
	tagOptions,
	friendOptions,
	verdicts: VERDICTS.map((v) => ({ label: v.label, gloss: v.gloss, ink: v.ink })),
	// The composer opens on today, and today is the browser's day rather than
	// the server's: a Vercel function in UTC calls it tomorrow all evening.
	fallbackDate: localDay(),
};
---

<script type="application/json" id="meal-editor-config" set:html={JSON.stringify(config)} />

<div class="me" id="meal-editor" hidden>
	<div class="me__backdrop" data-me-backdrop></div>
	<div class="me__sheet" role="dialog" aria-modal="true" aria-labelledby="me-title">
		<div class="me__bar">
			<span class="me__title" id="me-title" data-me-title>Log a meal</span>
			<button type="button" class="me__x" data-me-close aria-label="Close">×</button>
		</div>

		<div class="me__confirm" data-me-confirm hidden>
			<div class="me__confirm-box">
				<div class="me__confirm-title">Discard?</div>
				<div class="me__confirm-actions">
					<button type="button" class="rl-btn" data-me-keep>Keep</button>
					<button type="button" class="me__danger" data-me-discard>Discard</button>
				</div>
			</div>
		</div>

		<!-- ------------------------------------------------ log a meal -->
		<div class="me__body" data-me-pane="log">
			<div class="me__field me__field--rel">
				<label class="rl-label" for="me-place">Place</label>
				<div class="me__locked" data-me-locked hidden>
					<span class="me__locked-name" data-me-locked-name></span>
					<span class="me__locked-meta" data-me-locked-meta></span>
					<button type="button" class="rl-btn me__change" data-me-unlock>Change</button>
				</div>
				<input
					class="me__input"
					id="me-place"
					data-me-place
					type="text"
					autocomplete="off"
					placeholder="Search or type a new place"
				/>
				<!-- Places already in the log, then the same candidates the to-try
				     composer offers, then "add it anyway". See searchPlaces. -->
				<div class="me__suggest" data-me-suggest hidden></div>
				<!-- What a picked candidate attached, stated plainly: seeing it is
				     the confirmation, and clearing it is how you refuse it. -->
				<div class="me__pinned" data-me-log-pinned hidden>
					<span class="me__pinned-mark">◎</span>
					<span class="me__pinned-text" data-me-log-pinned-text></span>
					<button type="button" class="me__pinned-x" data-me-unpin>clear</button>
				</div>
			</div>

			<div class="me__field">
				<label class="rl-label" for="me-date">Visited</label>
				<input class="me__input me__input--mono" id="me-date" data-me-date type="date" />
			</div>

			<div class="me__field">
				<span class="rl-label">Rating</span>
				<!-- The same picker the film composer uses, in this page's palette:
				     a half star is a click on the left half of a star, so there is
				     no half-step mode to arm first. -->
				<StarPicker
					clearable
					style="--sp-size:22px;--sp-empty:#dbc7a2;--sp-fill:var(--marigold);--sp-label:var(--ink-3)"
				/>
			</div>

			<div class="me__field">
				<label class="rl-label" for="me-verdict">Would I go back</label>
				<div class="me__verdict">
					<svg class="me__needle" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
						<circle cx="12" cy="12" r="11" fill="none" stroke="var(--rule)" stroke-width="1.2"></circle>
						<g data-me-needle transform={verdictRotation(0)}>
							<path d="M12 3.4 L16.2 11.4 L12 9.5 L7.8 11.4 Z" fill="var(--avocado)"></path>
							<rect x="11.2" y="9.2" width="1.6" height="10" fill="var(--avocado)"></rect>
						</g>
					</svg>
					<input
						class="me__range"
						id="me-verdict"
						data-me-verdict
						type="range"
						min="0"
						max="5"
						step="1"
						value="0"
					/>
					<span class="me__verdict-name" data-me-verdict-name>Definitely return</span>
				</div>
				<p class="me__gloss" data-me-verdict-gloss></p>
				<label class="me__unset">
					<input type="checkbox" data-me-verdict-unset checked />
					<span>No verdict yet</span>
				</label>
			</div>

			<div class="me__toggles">
				<button type="button" class="me__toggle me__toggle--heart" data-me-heart>♥ Loved it</button>
				<button type="button" class="me__toggle" data-me-revisit>↻ Been before</button>
			</div>

			<div class="me__field">
				<label class="rl-label" for="me-friends">With</label>
				<input
					class="me__input"
					id="me-friends"
					data-me-friends
					type="text"
					list="me-friend-options"
					autocomplete="off"
					placeholder="Priya, Dan"
				/>
				<datalist id="me-friend-options">
					{friendOptions.map((f) => <option value={f} />)}
				</datalist>
			</div>

			<div class="me__field">
				<span class="rl-label">Price</span>
				<div class="me__prices" data-me-prices>
					{
						PRICE_BANDS.map((p) => (
							<button type="button" class="me__price" data-me-price={p}>
								{p}
							</button>
						))
					}
				</div>
			</div>

			{/*
				A property of the PLACE, asked here because a meal is when you find
				out. It is not a sixth rung of the verdict: the verdict is "would I
				come back", this is "would I cross town to", and a place can easily
				earn one and not the other.
			*/}
			<div class="me__field">
				<span class="rl-label">Would I go out of my way</span>
				<div class="me__trip" data-me-trips>
					<button type="button" class="me__trip-b" data-me-trip="0">If I&rsquo;m nearby</button>
					<button type="button" class="me__trip-b" data-me-trip="1">Worth the trip †</button>
				</div>
			</div>

			<div class="me__field">
				<label class="rl-label" for="me-notes">Notes</label>
				<textarea
					class="me__textarea"
					id="me-notes"
					data-me-notes
					rows="3"
					placeholder="What you ate, what to order next time"></textarea>
			</div>

			<div class="me__field">
				<span class="rl-label">Photos</span>
				<div class="me__photos" data-me-photos></div>
				<label class="me__addphoto">
					+
					<input type="file" accept="image/*" multiple data-me-photo-input hidden />
				</label>
			</div>

			<div class="me__field">
				<label class="rl-label" for="me-tags">Tags</label>
				<div class="me__tags" data-me-tags></div>
				<input
					class="me__input"
					id="me-tags"
					data-me-tag-input
					type="text"
					list="me-tag-options"
					autocomplete="off"
					placeholder="Enter to add"
				/>
				<datalist id="me-tag-options">
					{tagOptions.map((t) => <option value={t} />)}
				</datalist>
			</div>
		</div>

		<!-- ----------------------------------------------- add to-try -->
		<div class="me__body" data-me-pane="try" hidden>
			<div class="me__field me__field--rel">
				<label class="rl-label" for="me-try-name">Place</label>
				<input class="me__input" id="me-try-name" data-me-try-name type="text" autocomplete="off" placeholder="Wu's Wonton King" />
				<!-- Candidates from the geocoder. Picking one fills the location
				     fields and pins the place; everything stays editable after,
				     because OSM's idea of a neighbourhood is often not yours. -->
				<div class="me__suggest" data-me-geo hidden></div>
				<div class="me__pinned" data-me-pinned hidden>
					<span class="me__pinned-mark">◎</span>
					<span class="me__pinned-text" data-me-pinned-text></span>
					<button type="button" class="me__pinned-x" data-me-unpin>clear</button>
				</div>
			</div>
			<div class="me__grid">
				<div class="me__field">
					<label class="rl-label" for="me-try-where">Where</label>
					<input class="me__input" id="me-try-where" data-me-try-where type="text" autocomplete="off" placeholder="Two Bridges, Manhattan" />
				</div>
				<div class="me__field">
					<label class="rl-label" for="me-try-cuisine">Cuisine</label>
					<input class="me__input" id="me-try-cuisine" data-me-try-cuisine type="text" autocomplete="off" placeholder="Cantonese" />
				</div>
			</div>
			<div class="me__field">
				<span class="rl-label">Price</span>
				<div class="me__prices" data-me-try-prices>
					{
						PRICE_BANDS.map((p) => (
							<button type="button" class="me__price" data-me-try-price={p}>
								{p}
							</button>
						))
					}
				</div>
			</div>
			<div class="me__field">
				<span class="rl-label">Would I go out of my way</span>
				<div class="me__trip" data-me-try-trips>
					<button type="button" class="me__trip-b" data-me-try-trip="0">If I&rsquo;m nearby</button>
					<button type="button" class="me__trip-b" data-me-try-trip="1">Worth the trip †</button>
				</div>
			</div>

			{/*
				Beside the sentence, never instead of it. The line you write is the
				record; these eight words are what makes eighty of them a list you
				can cut down.
			*/}
			<div class="me__field">
				<span class="rl-label">What kind of why</span>
				<div class="me__whytags" data-me-why-tags>
					{
						WHY_TAGS.map((t) => (
							<button type="button" class="me__whytag" data-me-why-tag={t}>
								{t}
							</button>
						))
					}
				</div>
			</div>

			<div class="me__field">
				<label class="rl-label" for="me-try-why">Why</label>
				<input class="me__input me__input--prose" id="me-try-why" data-me-try-why type="text" autocomplete="off" placeholder="Peking duck, BYOB, a big table" />
			</div>
		</div>

		<div class="me__foot">
			<span class="me__summary" data-me-summary></span>
			{
				visitId && (
					<button type="button" class="me__delete" data-me-delete data-redirect={deleteRedirect}>
						Delete
					</button>
				)
			}
			<button type="button" class="rl-btn me__cancel" data-me-close>Cancel</button>
			<button type="button" class="me__save" data-me-save disabled>Log visit</button>
		</div>
	</div>
</div>

<script>
	import { hitWhere, lookupPlaces, type GeoHit } from '../lib/place-lookup';
	import { wireStarPicker } from '../lib/star-picker';

	interface VerdictSpec {
		label: string;
		gloss: string;
		ink: string;
	}
	/** The last visit somewhere, as the composer inherits it. */
	interface PreviousVisit {
		visitedOn: string;
		rating: number | null;
		verdict: number | null;
		hearted: boolean;
	}
	interface PlaceSpec {
		id: number;
		name: string;
		meta: string;
		visits: number;
		trip?: boolean;
		priceBand?: string | null;
		previous?: PreviousVisit | null;
	}
	/** A place already in the log, as the autocomplete route returns it. */
	interface LoggedPlace {
		id: number;
		name: string;
		cuisines: string[];
		visit_count: number;
		neighborhood: string | null;
		city: string;
		price_band: string | null;
		trip: boolean;
		previous: PreviousVisit | null;
	}
	interface Config {
		redirect: string;
		place: PlaceSpec | null;
		visitId: number | null;
		initial: {
			visitedOn: string;
			rating: number | null;
			verdict: number | null;
			hearted: boolean;
			revisit: boolean;
			friends: string[];
			review: string;
			tags: string[];
		} | null;
		photos: { id: number; url: string }[];
		tagOptions: string[];
		friendOptions: string[];
		verdicts: VerdictSpec[];
		fallbackDate: string;
	}

	const configTag = document.getElementById('meal-editor-config');
	const editor = document.getElementById('meal-editor');
	if (configTag && editor) {
		// Bound once so the narrowing survives into the callbacks below.
		const root: HTMLElement = editor;
		const cfg = JSON.parse(configTag.textContent || '{}') as Config;
		const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel);
		const $$ = (sel: string) => Array.from(root.querySelectorAll<HTMLElement>(sel));

		// LOGGING ANOTHER MEAL SOMEWHERE STARTS FROM THE LAST ONE. Six answers
		// carry forward when a place with a history is picked: the date, the
		// rating, the verdict, the heart, the price and whether it's worth the
		// trip. Five of them barely move between visits — you don't stop loving a
		// place between Tuesday and a fortnight later, and somewhere you go back
		// to is usually about as good as it was — and the sixth, the date, is a
		// better guess than today when the reason you're logging a second visit
		// is that you're catching up on several at once.
		//
		// Every one of them is shown as the form's answer, not hidden in it, so
		// disagreeing with a carried number is one click on the stars.
		//
		// An edit inherits nothing: it is showing a visit that happened, not
		// proposing one, so cfg.initial wins wherever both could speak.
		const inherited = cfg.initial ? null : (cfg.place?.previous ?? null);

		type Pane = 'log' | 'try';
		// One list holds both kinds, because the arrangement is one arrangement:
		// a photograph added today can belong between two taken last month, and
		// two lists side by side could not say that.
		type PhotoItem =
			| { kind: 'stored'; id: number; url: string }
			| { kind: 'new'; file: File; url: string; width: number; height: number };

		const state = {
			pane: 'log' as Pane,
			open: false,
			placeId: cfg.place?.id ?? null,
			placeName: '',
			locked: cfg.place,
			rating: cfg.initial?.rating ?? inherited?.rating ?? 0,
			verdict: cfg.initial?.verdict ?? inherited?.verdict ?? 0,
			verdictSet: cfg.initial?.verdict != null || inherited?.verdict != null,
			hearted: cfg.initial?.hearted ?? inherited?.hearted ?? false,
			revisit: cfg.initial?.revisit ?? (cfg.place ? cfg.place.visits > 0 : false),
			price: (cfg.place?.priceBand ?? null) as string | null,
			// Whether those answers were carried over rather than given. Changing
			// the place clears carried answers and leaves typed ones alone.
			borrowed: Boolean(!cfg.initial && cfg.place && (inherited || cfg.place.priceBand || cfg.place.trip)),
			tags: [...(cfg.initial?.tags ?? [])],
			photos: (cfg.photos ?? []).map((p): PhotoItem => ({ kind: 'stored', id: p.id, url: p.url })),
			// Taking a stored photograph out of the list is a decision, not yet a
			// deletion: the file goes when the visit is saved, so Cancel leaves the
			// entry exactly as it was found.
			removed: [] as number[],
			tryPrice: null as string | null,
			// The place's own answer, in both panes. Seeded from the place when
			// the composer opens on one, so logging a meal doesn't quietly
			// un-mark somewhere already marked.
			trip: cfg.place?.trip ?? false,
			tryTrip: false,
			whyTags: [] as string[],
			/** A confirmed point from the geocoder, or null for an unplaced entry. */
			geo: null as GeoHit | null,
			saving: false,
		};

		// The shared half-star picker (see StarPicker.astro). It owns its own
		// hover; the state only mirrors what it commits, so the summary line and
		// the dirty check keep reading one number. render() puts the committed
		// value back, which is how a rating carried from the last visit — or
		// dropped again when the place is unpicked — reaches the stars.
		const starPicker = wireStarPicker($('[data-star-picker]')!, {
			onChange: (v) => {
				state.rating = v ?? 0;
				render();
			},
		});

		// -- opening / closing ------------------------------------------------
		function open(pane: Pane) {
			state.pane = pane;
			state.open = true;
			// A point belongs to the place you were naming, not to the dialog, so
			// it does not survive being closed and reopened on something else.
			state.geo = null;
			root.hidden = false;
			document.body.style.overflow = 'hidden';
			$('[data-me-pane="log"]')!.hidden = pane !== 'log';
			$('[data-me-pane="try"]')!.hidden = pane !== 'try';
			$('[data-me-title]')!.textContent =
				pane === 'try' ? 'Add to to-try' : cfg.visitId ? 'Edit this visit' : state.locked ? 'Log a visit' : 'Log a meal';
			$('[data-me-save]')!.textContent = pane === 'try' ? 'Add' : cfg.visitId ? 'Save' : 'Log visit';
			render();
			window.setTimeout(() => {
				const focus = pane === 'try' ? $('[data-me-try-name]') : state.locked ? $('[data-me-date]') : $('[data-me-place]');
				(focus as HTMLInputElement | null)?.focus();
			}, 20);
		}

		function close() {
			state.open = false;
			root.hidden = true;
			$('[data-me-confirm]')!.hidden = true;
			document.body.style.overflow = '';
		}

		/** Anything typed that would be lost. Drives the discard confirmation. */
		function dirty(): boolean {
			if (state.pane === 'try') {
				return Boolean(
					value('[data-me-try-name]') ||
						value('[data-me-try-where]') ||
						value('[data-me-try-cuisine]') ||
						value('[data-me-try-why]') ||
						state.tryPrice ||
						state.tryTrip ||
						state.whyTags.length,
				);
			}
			if (cfg.visitId) return true;
			return Boolean(
				state.placeId ||
					value('[data-me-place]') ||
					state.rating ||
					state.verdictSet ||
					value('[data-me-friends]') ||
					value('[data-me-notes]') ||
					state.tags.length ||
					state.photos.length,
			);
		}

		function askClose() {
			if (dirty()) $('[data-me-confirm]')!.hidden = false;
			else close();
		}

		function value(sel: string): string {
			return ($(sel) as HTMLInputElement | HTMLTextAreaElement | null)?.value.trim() ?? '';
		}

		// -- rendering --------------------------------------------------------
		function render() {
			const locked = state.locked;
			$('[data-me-locked]')!.hidden = !locked;
			($('[data-me-place]') as HTMLInputElement).hidden = Boolean(locked);
			if (locked) {
				$('[data-me-locked-name]')!.textContent = locked.name;
				$('[data-me-locked-meta]')!.textContent = locked.meta;
			}

			starPicker.set(state.rating || null);

			const v = cfg.verdicts[state.verdict] ?? cfg.verdicts[0];
			const needle = $('[data-me-needle]')!;
			needle.setAttribute('transform', `rotate(${state.verdict * 36} 12 12)`);
			needle.querySelectorAll('path, rect').forEach((n) => n.setAttribute('fill', v.ink));
			needle.parentElement!.style.opacity = state.verdictSet ? '1' : '0.35';
			$('[data-me-verdict-name]')!.textContent = state.verdictSet ? v.label : 'Not recorded';
			$('[data-me-verdict-gloss]')!.textContent = state.verdictSet ? v.gloss : '';
			($('[data-me-verdict]') as HTMLInputElement).value = String(state.verdict);
			($('[data-me-verdict-unset]') as HTMLInputElement).checked = !state.verdictSet;

			$('[data-me-heart]')!.classList.toggle('me__toggle--on', state.hearted);
			$('[data-me-revisit]')!.classList.toggle('me__toggle--on', state.revisit);
			$$('[data-me-price]').forEach((el) =>
				el.classList.toggle('me__price--on', el.dataset.mePrice === state.price),
			);
			$$('[data-me-try-price]').forEach((el) =>
				el.classList.toggle('me__price--on', el.dataset.meTryPrice === state.tryPrice),
			);
			$$('[data-me-trip]').forEach((el) =>
				el.classList.toggle('me__trip-b--on', (el.dataset.meTrip === '1') === state.trip),
			);
			$$('[data-me-try-trip]').forEach((el) =>
				el.classList.toggle('me__trip-b--on', (el.dataset.meTryTrip === '1') === state.tryTrip),
			);
			$$('[data-me-why-tag]').forEach((el) =>
				el.classList.toggle('me__whytag--on', state.whyTags.includes(el.dataset.meWhyTag ?? '')),
			);

			const tags = $('[data-me-tags]')!;
			tags.replaceChildren(
				...state.tags.map((name, i) => {
					const chip = document.createElement('span');
					chip.className = 'me__tag';
					chip.textContent = name;
					const x = document.createElement('button');
					x.type = 'button';
					x.className = 'me__tag-x';
					x.textContent = '×';
					x.setAttribute('aria-label', `Remove ${name}`);
					x.addEventListener('click', () => {
						state.tags.splice(i, 1);
						render();
					});
					chip.append(x);
					return chip;
				}),
			);

			const photos = $('[data-me-photos]')!;
			photos.replaceChildren(
				...state.photos.map((p, i) => {
					const cell = document.createElement('span');
					cell.className = 'me__photo';
					const img = document.createElement('img');
					img.src = p.url;
					img.alt = '';
					const x = document.createElement('button');
					x.type = 'button';
					x.className = 'me__photo-x';
					x.textContent = '×';
					x.setAttribute('aria-label', 'Remove photo');
					x.addEventListener('click', () => {
						// A file the browser made for the preview is the browser's to
						// free; a stored one is the server's, and it is only marked.
						if (p.kind === 'new') URL.revokeObjectURL(p.url);
						else state.removed.push(p.id);
						state.photos.splice(i, 1);
						render();
					});
					// Two arrows rather than a drag: this composer is used on a phone
					// more than anywhere else, and HTML drag-and-drop does not exist
					// under a finger.
					const move = document.createElement('span');
					move.className = 'me__photo-move';
					for (const [glyph, to, label] of [
						['‹', i - 1, 'Move photo earlier'],
						['›', i + 1, 'Move photo later'],
					] as const) {
						const b = document.createElement('button');
						b.type = 'button';
						b.className = 'me__photo-move-b';
						b.textContent = glyph;
						b.setAttribute('aria-label', label);
						b.disabled = to < 0 || to >= state.photos.length;
						b.addEventListener('click', () => {
							const [moved] = state.photos.splice(i, 1);
							state.photos.splice(to, 0, moved);
							render();
						});
						move.append(b);
					}
					cell.append(img, x, move);
					return cell;
				}),
			);

			const bits: string[] = [];
			if (state.rating) bits.push(`${state.rating}★`);
			if (state.verdictSet) bits.push(v.label.toLowerCase());
			if (state.photos.length) bits.push(`${state.photos.length} photo${state.photos.length === 1 ? '' : 's'}`);
			$('[data-me-summary]')!.textContent = state.pane === 'try' ? '' : bits.join(' · ');

			// What the geocoder pinned, in whichever pane is open.
			const g = state.geo;
			const where = g ? [g.neighborhood, g.city, g.stateRegion].filter(Boolean).join(', ') : '';
			const pinnedText = !g
				? ''
				: g.precise
					? `${where} · ${g.lat.toFixed(4)}, ${g.lng.toFixed(4)}`
					: `${where} · area only — no point, so it stays off the map`;
			for (const [box, text] of [
				['[data-me-pinned]', '[data-me-pinned-text]'],
				['[data-me-log-pinned]', '[data-me-log-pinned-text]'],
			]) {
				const el = $(box);
				if (!el) continue;
				el.hidden = !g;
				const label = $(text);
				if (label) label.textContent = pinnedText;
			}

			const save = $('[data-me-save]') as HTMLButtonElement;
			save.disabled = state.saving || !canSave();
		}

		// -- what a second visit starts from ----------------------------------
		/** The date field, which is the browser's to hold rather than state's. */
		function dateField(): HTMLInputElement {
			return $('[data-me-date]') as HTMLInputElement;
		}

		/**
		 * Carry the last visit's answers onto a place just picked, alongside the
		 * two the place itself answers. Called on every pick, so picking a second
		 * place replaces the first one's answers rather than leaving them.
		 */
		function carryFrom(from: { priceBand: string | null; trip: boolean; previous: PreviousVisit | null }) {
			state.price = from.priceBand;
			state.trip = from.trip;
			state.rating = from.previous?.rating ?? 0;
			state.verdict = from.previous?.verdict ?? 0;
			state.verdictSet = from.previous?.verdict != null;
			state.hearted = from.previous?.hearted ?? false;
			dateField().value = from.previous?.visitedOn ?? cfg.fallbackDate;
			state.borrowed = Boolean(from.previous || from.priceBand || from.trip);
		}

		/**
		 * Unpicking a place takes back what it lent. A form nobody borrowed from
		 * is left exactly as it was typed — the guard is the whole point of the
		 * flag: naming a new place must not wipe a verdict you sat and decided.
		 */
		function dropCarried() {
			if (!state.borrowed) return;
			// Blank on every side, which leaves borrowed false in its turn.
			carryFrom({ priceBand: null, trip: false, previous: null });
		}

		function canSave(): boolean {
			if (state.pane === 'try') return Boolean(value('[data-me-try-name]'));
			return Boolean(state.placeId || value('[data-me-place]'));
		}

		// -- place autocomplete ----------------------------------------------
		// ONE FIELD, TWO QUESTIONS. Where you ate is usually somewhere already in
		// the log and sometimes somewhere that has never been in it, and you do
		// not know which until the name is typed. So the field answers both at
		// once: the places already logged, then the SAME candidate list the
		// to-try composer offers — our own gazetteer and the geocoder, with the
		// source named on every row — then "add it anyway" underneath.
		//
		// IT USED TO GUESS. Choosing "new place" silently took the geocoder's
		// top hit and attached it, on the grounds that when you are logging a
		// meal the location is a detail. It is a detail right up to the moment it
		// is wrong: two restaurants of a name are common, and a wrong pin is
		// invisible here and has to be found and fixed on the place page later.
		// Picking from the list is one more click and no guessing, and it is a
		// list you already know how to read from adding a place to try.
		//
		// THE TWO LOOKUPS ARE DEBOUNCED APART, not together. Ours is instant and
		// should feel it; the geocoder is a volunteer service paced to a request
		// a second. So the logged places land first and the map's candidates
		// arrive underneath them a moment later.
		const suggest = {
			q: '',
			places: [] as LoggedPlace[],
			geo: [] as GeoHit[],
			looking: false,
		};
		/** Answers to a query that is no longer what's typed are dropped. */
		let queryId = 0;
		let placeTimer = 0;
		let geoTimer = 0;

		function searchPlaces(q: string) {
			window.clearTimeout(placeTimer);
			window.clearTimeout(geoTimer);
			suggest.q = q;
			suggest.places = [];
			suggest.geo = [];
			// Under three characters the geocode route answers nothing by design,
			// so there is nothing to wait for and nothing to say about waiting.
			suggest.looking = q.length >= 3;
			if (!q) {
				$('[data-me-suggest]')!.hidden = true;
				return;
			}
			const mine = ++queryId;

			placeTimer = window.setTimeout(async () => {
				let places: LoggedPlace[] = [];
				try {
					const res = await fetch(`/api/restaurants/places?q=${encodeURIComponent(q)}`);
					if (res.ok) places = (await res.json()).places ?? [];
				} catch {
					// A failed lookup must not block typing a new place; the rows
					// below are offered regardless.
				}
				if (mine !== queryId) return;
				suggest.places = places;
				renderSuggest();
			}, 160);

			if (suggest.looking) {
				geoTimer = window.setTimeout(async () => {
					const { hits } = await lookupPlaces(q);
					if (mine !== queryId) return;
					suggest.geo = hits;
					suggest.looking = false;
					renderSuggest();
				}, 420);
			}
		}

		function renderSuggest() {
			const box = $('[data-me-suggest]')!;
			box.replaceChildren();
			for (const p of suggest.places) box.append(loggedRow(p));

			// A candidate that is already in the log is offered above with its
			// visits on it; offering it again as new is how one restaurant ends
			// up as two rows that can never be added back together.
			const known = new Set(suggest.places.map((p) => p.name.toLowerCase()));
			for (const hit of suggest.geo) {
				if (!known.has(hit.name.toLowerCase())) box.append(geoRow(hit, () => pickNew(hit.name || suggest.q, hit)));
			}

			if (suggest.looking) {
				const row = document.createElement('div');
				row.className = 'me__sug me__sug--none';
				row.textContent = 'Looking for it on the map…';
				box.append(row);
			}

			// The last row needs nobody to have heard of the place, which is the
			// whole point of it: a stall, a place that opened last week, a place
			// only Google knows. Absent only when the name is already in the log,
			// where adding it again would be a duplicate.
			if (!suggest.places.some((p) => p.name.toLowerCase() === suggest.q.toLowerCase())) {
				box.append(
					sugRow(`“${suggest.q}”`, 'new place · no point on the map', 'add', () => pickNew(suggest.q, null)),
				);
			}
			box.hidden = false;
		}

		function loggedRow(p: LoggedPlace): HTMLElement {
			const meta = `${p.cuisines[0] ?? ''}${p.cuisines[0] ? ' · ' : ''}${p.neighborhood ? `${p.neighborhood}, ${p.city}` : p.city}`;
			return sugRow(p.name, meta, `${p.visit_count} visit${p.visit_count === 1 ? '' : 's'}`, () => {
				state.placeId = p.id;
				state.locked = { id: p.id, name: p.name, meta, visits: p.visit_count };
				state.revisit = p.visit_count > 0;
				// Somewhere with a history hands over the answers it already has;
				// somewhere only marked to try has none, and hands over a blank.
				carryFrom({ priceBand: p.price_band, trip: Boolean(p.trip), previous: p.previous });
				// A place on record has whatever location it has, and a visit must
				// never rewrite it — so a candidate picked before changing your
				// mind does not follow you here.
				state.geo = null;
			});
		}

		/** A candidate from the gazetteer or the geocoder, in either pane. */
		function geoRow(hit: GeoHit, onPick: () => void): HTMLElement {
			// An area is offered — it still fills in the words — but it is named
			// as what it is, so nobody pins a restaurant to the middle of a
			// neighbourhood by accident.
			const meta = [
				hit.address || hit.display.split(',').slice(1, 3).join(',').trim(),
				hit.cuisines.join(', ') || hit.kind,
				hit.precise ? '' : 'no exact point',
			]
				.filter(Boolean)
				.join(' · ');
			// WHO SAID SO, on every row. Two sources disagree about a Chinatown
			// noodle shop more often than they agree, and the only way to choose
			// between them is to know who is speaking.
			const row = sugRow(hit.name || hit.display.split(',')[0], meta, hit.sourceLabel ?? 'OpenStreetMap', onPick);
			if (!hit.precise) row.classList.add('me__sug--vague');
			return row;
		}

		// Two lines, not three spans on one: the name, then everything that
		// distinguishes this row from the next. At 380px a single flex line ran
		// the name, the street and the OSM type together into one string.
		//
		// Chosen on mousedown rather than click, because the field's blur fires
		// first and would take the box away before the click landed.
		function sugRow(name: string, meta: string, tail: string, onPick: () => void): HTMLElement {
			const row = document.createElement('div');
			row.className = 'me__sug';
			for (const [part, text] of [
				['name', name],
				['meta', meta],
				['tail', tail],
			] as const) {
				const span = document.createElement('span');
				span.className = `me__sug-${part}`;
				span.textContent = text;
				row.append(span);
			}
			row.addEventListener('mousedown', (e) => {
				e.preventDefault();
				// Whichever box this row was put in — the two panes have one each.
				const box = row.parentElement as HTMLElement | null;
				if (box) box.hidden = true;
				onPick();
				render();
			});
			return row;
		}

		/**
		 * A place the log has never seen: named, and placed only if a candidate
		 * was picked. The point rides in state.geo, where the receipt under the
		 * field shows it and "clear" refuses it.
		 */
		function pickNew(name: string, hit: GeoHit | null) {
			state.placeId = null;
			state.placeName = name;
			state.geo = hit;
			// A place the log has never seen has nothing to lend, so anything
			// carried here from a place picked and reconsidered goes back.
			dropCarried();
			// The meta stays "new place" even when a hit came with it, because
			// the receipt below states the location and is the thing that can be
			// cleared — a line up here claiming a neighbourhood would go on
			// claiming it after the point was refused.
			state.locked = { id: 0, name, meta: 'new place', visits: 0 };
			// So Change reopens on the name that will be saved: a picked hit
			// carries the proper spelling and the accents, which is the half you
			// cannot type on a phone.
			($('[data-me-place]') as HTMLInputElement).value = name;
		}

		// -- the to-try composer's lookup --------------------------------------
		// The same candidates, in the pane that has a Where field to narrow them
		// with — which is what separates the four Tacos El Bronco from each
		// other.
		let tryTimer = 0;
		function lookupPlace() {
			window.clearTimeout(tryTimer);
			const box = $('[data-me-geo]')!;
			const name = value('[data-me-try-name]');
			if (name.length < 3) {
				box.hidden = true;
				return;
			}
			const hint = value('[data-me-try-where]');
			tryTimer = window.setTimeout(async () => {
				const { hits } = await lookupPlaces(name, hint);
				box.replaceChildren();
				if (hits.length === 0) {
					// Nothing by that name. Saying so beats an empty box — the place
					// is still perfectly addable, just without a point.
					const row = document.createElement('div');
					row.className = 'me__sug me__sug--none';
					row.textContent = 'No exact match — it will be added without a point on the map.';
					box.append(row);
					box.hidden = false;
					return;
				}
				for (const hit of hits) box.append(geoRow(hit, () => pick(hit)));
				box.hidden = false;
			}, 420);
		}

		function pick(hit: GeoHit) {
			state.geo = hit;
			$('[data-me-geo]')!.hidden = true;

			// Picking a hit means "this is the place", so the form becomes that
			// place: its real name — properly spelled and accented, which is the
			// half you can't type on a phone — then where it is and what it
			// serves. Every field stays editable; OSM files Ba Xuyên under Dyker
			// Heights when anyone who goes there says Sunset Park, so the geocode
			// is a suggestion and the field is the record.
			if (hit.name) ($('[data-me-try-name]') as HTMLInputElement).value = hit.name;

			const where = hitWhere(hit);
			if (where) ($('[data-me-try-where]') as HTMLInputElement).value = where;

			// Only fill a cuisine that is empty — a typed one is a choice, and
			// OSM's is a guess.
			const cuisineField = $('[data-me-try-cuisine]') as HTMLInputElement;
			if (hit.cuisines.length > 0 && !cuisineField.value.trim()) {
				cuisineField.value = hit.cuisines.join(', ');
			}
			render();
		}

		// -- saving ------------------------------------------------------------
		async function save() {
			if (!canSave() || state.saving) return;
			state.saving = true;
			render();
			try {
				if (state.pane === 'try') return await saveToTry();
				return await saveVisit();
			} catch (e) {
				window.alert(e instanceof Error ? e.message : 'Something went wrong saving that.');
			} finally {
				state.saving = false;
				render();
			}
		}

		async function saveToTry() {
			const where = value('[data-me-try-where]');
			// "Two Bridges, Manhattan" and plain "Austin" both arrive in one
			// field, because that is how you say where a place is. The comma
			// splits neighbourhood from city; without one, it is all city.
			const [first, ...rest] = where.split(',').map((s) => s.trim()).filter(Boolean);
			const g = state.geo;
			const body = {
				name: value('[data-me-try-name]'),
				// One field, but the column is an array and a place is legitimately
				// "Vietnamese, Sandwich". Stored whole, that becomes a single
				// cuisine nothing can filter by and a chip the width of the row.
				cuisines: value('[data-me-try-cuisine]')
					.split(',')
					.map((c) => c.trim())
					.filter(Boolean),
				priceBand: state.tryPrice,
				trip: state.tryTrip,
				toTryTags: state.whyTags,
				// What you typed wins over what the geocoder guessed — you edited
				// it after picking, or you never picked at all. The coordinates
				// and the country are the parts only the geocoder knows.
				neighborhood: rest.length ? first : null,
				city: rest.length ? rest.join(', ') : first || g?.city || null,
				stateRegion: g?.stateRegion ?? null,
				country: g?.country ?? null,
				// A neighbourhood centroid is not where the restaurant is, so an
				// imprecise hit contributes its NAMES and nothing else.
				lat: g?.precise ? g.lat : null,
				lng: g?.precise ? g.lng : null,
				toTryReason: value('[data-me-try-why]'),
				toTry: true,
			};
			const res = await fetch('/api/restaurants/places', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify(body),
			});
			if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error ?? 'could not add the place');
			location.href = '/restaurants/to-try';
		}

		async function saveVisit() {
			const friends = value('[data-me-friends]')
				.split(',')
				.map((s) => s.trim())
				.filter(Boolean);
			const payload = {
				restaurantId: state.placeId ?? undefined,
				place: state.placeId
					? { name: state.locked?.name ?? '', priceBand: state.price, trip: state.trip }
					: {
							name: state.locked?.name || value('[data-me-place]'),
							priceBand: state.price,
							trip: state.trip,
							// A picked candidate's cuisines come along with its names.
							// This pane has no cuisine field, so nothing is overwritten
							// and nothing was typed to disagree with — the place page is
							// where it gets corrected, like every other guess.
							cuisines: state.geo?.cuisines ?? [],
							// Only a NEW place carries a location; picking an existing
							// one must never overwrite the location already on record.
							neighborhood: state.geo?.neighborhood ?? null,
							city: state.geo?.city ?? null,
							stateRegion: state.geo?.stateRegion ?? null,
							country: state.geo?.country ?? null,
							lat: state.geo?.precise ? state.geo.lat : null,
							lng: state.geo?.precise ? state.geo.lng : null,
						},
				visitedOn: value('[data-me-date]') || cfg.fallbackDate,
				rating: state.rating || null,
				verdict: state.verdictSet ? state.verdict : null,
				hearted: state.hearted,
				revisit: state.revisit,
				friends,
				review: value('[data-me-notes]'),
				tags: state.tags,
			};

			const url = cfg.visitId ? `/api/restaurants/visits/${cfg.visitId}` : '/api/restaurants/visits';
			const res = await fetch(url, {
				method: cfg.visitId ? 'PATCH' : 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify(payload),
			});
			if (res.status === 401) {
				location.href = `/films/login?next=${encodeURIComponent(cfg.redirect)}`;
				return;
			}
			if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error ?? 'could not log that visit');
			const saved = await res.json();
			const visitId = cfg.visitId ?? saved.id;

			// A photograph taken out of the list goes now, once the rest of the
			// edit has been accepted — before this point Save could still fail,
			// and a file deleted for a save that never happened is gone for
			// nothing. The storage object goes with the row; there is no undo.
			const failures: string[] = [];
			for (const id of state.removed) {
				try {
					const res = await fetch(`/api/restaurants/photos/${id}`, { method: 'DELETE' });
					if (!res.ok) failures.push('a photograph could not be deleted');
				} catch {
					failures.push('a photograph could not be deleted');
				}
			}

			// Photographs go up after the visit exists, because the storage path
			// is keyed on its id. A failed upload leaves a logged visit with
			// fewer photos rather than losing the whole entry.
			//
			// ONE REQUEST PER PHOTOGRAPH. Vercel caps a serverless request body
			// at 4.5 MB and enforces it in the platform, before the function is
			// entered — so the endpoint's own limit never sees an oversized body
			// and the browser gets a 413 it cannot explain. Batching four photos
			// into one request trips that cap on the sum, which is how three
			// perfectly acceptable photos fail because of a fourth.
			//
			// The ids come back as they are stored, so the arrangement below can
			// name every photograph in the list — the ones already there and the
			// ones that arrived a moment ago alike.
			const order: number[] = [];
			for (const p of state.photos) {
				if (p.kind === 'stored') {
					order.push(p.id);
					continue;
				}
				const form = new FormData();
				form.append('photo', p.file, p.file.name);
				form.append('width', String(p.width));
				form.append('height', String(p.height));
				form.append('caption', '');
				try {
					const up = await fetch(`/api/restaurants/visits/${visitId}/photos`, { method: 'POST', body: form });
					if (up.ok) {
						const added = await up.json().catch(() => null);
						for (const id of added?.ids ?? []) order.push(Number(id));
					} else {
						// A 413 comes from the platform as HTML, not from the
						// endpoint as JSON, so it is named here rather than parsed.
						const body = up.status === 413 ? null : await up.json().catch(() => null);
						const why = body?.error ?? (up.status === 413 ? 'it was too large to send' : `HTTP ${up.status}`);
						failures.push(`a photograph did not upload — ${why}`);
					}
				} catch {
					failures.push('a photograph did not upload — the request did not complete');
				}
			}

			// Uploading appends, so a list that was only added to is already in
			// the right order and needs no second request. Anything else — a
			// photograph moved, or a new one nudged in front of the old ones — is
			// sent whole, since the arrangement is what is being saved, not the
			// moves that produced it.
			const seeded = cfg.photos ?? [];
			const stored = new Set(seeded.map((p) => p.id));
			const kept = new Set(order.filter((id) => stored.has(id)));
			const appended = [
				...seeded.map((p) => p.id).filter((id) => kept.has(id)),
				...order.filter((id) => !stored.has(id)),
			];
			if (order.length > 1 && order.some((id, i) => id !== appended[i])) {
				try {
					const res = await fetch(`/api/restaurants/visits/${visitId}/photos`, {
						method: 'PATCH',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ order }),
					});
					if (!res.ok) failures.push('the photographs kept their old order');
				} catch {
					failures.push('the photographs kept their old order');
				}
			}

			// The visit itself is already saved by now, so this reports what did
			// not happen around it rather than pretending the whole save failed.
			if (failures.length > 0) {
				window.alert(`The visit was saved, but: ${[...new Set(failures)].join('; ')}.`);
			}

			location.href = cfg.redirect;
		}

		async function remove() {
			if (!cfg.visitId) return;
			if (!window.confirm('Delete this visit?')) return;
			const res = await fetch(`/api/restaurants/visits/${cfg.visitId}`, { method: 'DELETE' });
			if (!res.ok) {
				window.alert('Could not delete that visit.');
				return;
			}
			location.href = ($('[data-me-delete]') as HTMLElement).dataset.redirect ?? '/restaurants/diary';
		}

		// -- wiring -------------------------------------------------------------
		document.querySelectorAll('[data-open-meal-editor]').forEach((el) =>
			el.addEventListener('click', () => open('log')),
		);
		document.querySelectorAll('[data-open-try-editor]').forEach((el) =>
			el.addEventListener('click', () => open('try')),
		);
		$$('[data-me-close]').forEach((el) => el.addEventListener('click', askClose));
		$('[data-me-backdrop]')!.addEventListener('click', askClose);
		$('[data-me-keep]')!.addEventListener('click', () => {
			$('[data-me-confirm]')!.hidden = true;
		});
		$('[data-me-discard]')!.addEventListener('click', close);
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && state.open) askClose();
		});

		$('[data-me-place]')!.addEventListener('input', (e) => {
			searchPlaces((e.target as HTMLInputElement).value.trim());
			render();
		});
		$('[data-me-place]')!.addEventListener('blur', () => {
			window.setTimeout(() => {
				$('[data-me-suggest]')!.hidden = true;
			}, 140);
		});
		$('[data-me-unlock]')!.addEventListener('click', () => {
			state.locked = null;
			state.placeId = null;
			// The point belonged to the place being unpicked, so it goes with it,
			// and so do the answers that came off its last visit.
			state.geo = null;
			dropCarried();
			render();
			($('[data-me-place]') as HTMLInputElement).focus();
			searchPlaces(value('[data-me-place]'));
		});

		$('[data-me-verdict]')!.addEventListener('input', (e) => {
			state.verdict = Number((e.target as HTMLInputElement).value);
			// Touching the slider is the act of recording a verdict; making you
			// also untick a box would be a second step for one decision.
			state.verdictSet = true;
			render();
		});
		$('[data-me-verdict-unset]')!.addEventListener('change', (e) => {
			state.verdictSet = !(e.target as HTMLInputElement).checked;
			render();
		});

		$('[data-me-heart]')!.addEventListener('click', () => {
			state.hearted = !state.hearted;
			render();
		});
		$('[data-me-revisit]')!.addEventListener('click', () => {
			state.revisit = !state.revisit;
			render();
		});
		$$('[data-me-price]').forEach((el) =>
			el.addEventListener('click', () => {
				const p = el.dataset.mePrice ?? null;
				state.price = state.price === p ? null : p;
				render();
			}),
		);
		$$('[data-me-try-price]').forEach((el) =>
			el.addEventListener('click', () => {
				const p = el.dataset.meTryPrice ?? null;
				state.tryPrice = state.tryPrice === p ? null : p;
				render();
			}),
		);
		// Two buttons rather than one toggle, because "if I'm nearby" is an
		// answer and not the absence of one.
		$$('[data-me-trip]').forEach((el) =>
			el.addEventListener('click', () => {
				state.trip = el.dataset.meTrip === '1';
				render();
			}),
		);
		$$('[data-me-try-trip]').forEach((el) =>
			el.addEventListener('click', () => {
				state.tryTrip = el.dataset.meTryTrip === '1';
				render();
			}),
		);
		$$('[data-me-why-tag]').forEach((el) =>
			el.addEventListener('click', () => {
				const tag = el.dataset.meWhyTag ?? '';
				state.whyTags = state.whyTags.includes(tag)
					? state.whyTags.filter((t) => t !== tag)
					: [...state.whyTags, tag];
				render();
			}),
		);

		$('[data-me-tag-input]')!.addEventListener('keydown', (e) => {
			const input = e.target as HTMLInputElement;
			if (e.key !== 'Enter' || !input.value.trim()) return;
			e.preventDefault();
			const tag = input.value.trim();
			if (!state.tags.some((t) => t.toLowerCase() === tag.toLowerCase())) state.tags.push(tag);
			input.value = '';
			render();
		});

		$('[data-me-photo-input]')!.addEventListener('change', async (e) => {
			const input = e.target as HTMLInputElement;
			for (const file of Array.from(input.files ?? [])) {
				state.photos.push(await prepare(file));
			}
			input.value = '';
			render();
		});

		$('[data-me-save]')!.addEventListener('click', save);
		$('[data-me-delete]')?.addEventListener('click', remove);
		$$('[data-me-try-name], [data-me-notes], [data-me-friends]').forEach((el) =>
			el.addEventListener('input', render),
		);

		// The to-try composer looks a place up as you name it; editing "Where"
		// re-runs it, because the hint is what separates two places of the name.
		$('[data-me-try-name]')!.addEventListener('input', () => {
			state.geo = null;
			lookupPlace();
		});
		$('[data-me-try-where]')!.addEventListener('input', lookupPlace);
		$('[data-me-try-name]')!.addEventListener('blur', () => {
			window.setTimeout(() => {
				$('[data-me-geo]')!.hidden = true;
			}, 160);
		});
		$$('[data-me-unpin]').forEach((el) =>
			el.addEventListener('click', () => {
				state.geo = null;
				render();
			}),
		);

		// -- photographs --------------------------------------------------------
		//
		// A photograph is decoded, measured and shrunk here, in the browser,
		// before it is ever sent.
		//
		// MEASURED here because the mixed-orientation wall needs each photo's
		// aspect ratio and the browser has to decode the image to show the
		// thumbnail anyway — measuring it again on the server would mean
		// decoding every upload twice.
		//
		// SHRUNK here because a phone photograph does not fit through the door.
		// A modern iPhone writes 5–12 MB per frame; Vercel refuses a serverless
		// request body over 4.5 MB with a platform-level 413, so the full-size
		// original could never reach the endpoint no matter what the endpoint
		// permitted.
		//
		// The size is chosen against what the page actually paints, because the
		// bucket is served raw — there is no CDN transform and no srcset behind
		// these URLs, so whatever is stored is what every reader downloads. The
		// largest render on the site is a lone photograph at
		// `min(64vh, 520px)` tall, about 780 px wide at 3:2; the widest is a
		// phone's 360 px column. A 1600 px long edge covers the first at 2× and
		// the second at 3×, and is half the pixels — a quarter of the area — of
		// the 2200 px this used to keep. Instagram stores 1080 px for the same
		// job, so this is still the generous end of reasonable.

		/** Long edge, in pixels, of a stored photograph. */
		const MAX_EDGE = 1600;
		/**
		 * Re-encode anything above this, even when its dimensions are fine.
		 *
		 * Low enough to catch a correctly-sized frame that is merely encoded at
		 * camera quality: at MAX_EDGE this encoder lands around 200–400 KB, so
		 * anything meaningfully above that has headroom left in it. Below the
		 * line the file the camera wrote is kept rather than paying a second
		 * lossy pass to save a few kilobytes.
		 */
		const REENCODE_OVER = 600 * 1024;
		/** Encoder quality, for either format. */
		const QUALITY = 0.82;

		/**
		 * Encode a canvas, preferring WebP — roughly a quarter smaller than JPEG
		 * at matching quality, and every browser that can run this editor can
		 * display it.
		 *
		 * The result's own type is what decides, not a feature test, because
		 * `toBlob` does not report an unsupported format: it silently encodes a
		 * PNG instead, which for a photograph is several times larger than the
		 * JPEG it was standing in for. Asking the blob what it came out as is
		 * the only answer that cannot be wrong.
		 */
		async function encode(canvas: HTMLCanvasElement): Promise<Blob | null> {
			const webp = await new Promise<Blob | null>((resolve) =>
				canvas.toBlob(resolve, 'image/webp', QUALITY),
			);
			if (webp?.type === 'image/webp') return webp;
			return new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', QUALITY));
		}

		async function prepare(file: File): Promise<PhotoItem> {
			// `from-image` so a portrait held sideways is stored the way up it
			// was taken: the EXIF rotation a phone records is applied to the
			// pixels here, and canvas would otherwise drop it on re-encoding.
			let bitmap: ImageBitmap | null = null;
			try {
				bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });
			} catch {
				// A format this browser cannot decode still goes up as it arrived,
				// unmeasured. Refusing it here would be guessing on the server's
				// behalf about what it can store.
				return { kind: 'new', file, url: URL.createObjectURL(file), width: 0, height: 0 };
			}

			const { width, height } = bitmap;
			const scale = Math.min(1, MAX_EDGE / Math.max(width, height));
			// Small enough already: keep the file the camera wrote rather than
			// paying a second lossy encode for nothing.
			if (scale === 1 && file.size <= REENCODE_OVER) {
				bitmap.close();
				return { kind: 'new', file, url: URL.createObjectURL(file), width, height };
			}

			const w = Math.round(width * scale);
			const h = Math.round(height * scale);
			const canvas = document.createElement('canvas');
			canvas.width = w;
			canvas.height = h;
			canvas.getContext('2d')?.drawImage(bitmap, 0, 0, w, h);
			bitmap.close();
			const blob = await encode(canvas);
			if (!blob) return { kind: 'new', file, url: URL.createObjectURL(file), width, height };

			// An image that was already within MAX_EDGE can come out of the
			// encoder bigger than it went in — something compressed harder than
			// this by whoever made it, or a flat graphic that JPEG handles worse
			// than the PNG it arrived as. Keep whichever is actually smaller.
			// When the dimensions did change the new file wins regardless: those
			// pixels are the point, and `width`/`height` below have to describe
			// the file being sent.
			if (scale === 1 && blob.size >= file.size) {
				return { kind: 'new', file, url: URL.createObjectURL(file), width, height };
			}

			// The extension has to follow the re-encode: the server derives the
			// stored object's name from this one, and a JPEG called .heic would
			// be served with the wrong type for the rest of its life.
			const ext = blob.type === 'image/webp' ? 'webp' : 'jpg';
			const name = `${file.name.replace(/\.[^.]+$/, '') || 'photo'}.${ext}`;
			const shrunk = new File([blob], name, { type: blob.type });
			return { kind: 'new', file: shrunk, url: URL.createObjectURL(shrunk), width: w, height: h };
		}

		// Seed from the server: an edit opens on the stored visit, another meal
		// somewhere on the date of the last one there, and everything else on
		// today.
		dateField().value = cfg.initial?.visitedOn ?? inherited?.visitedOn ?? cfg.fallbackDate;
		if (cfg.initial) {
			($('[data-me-notes]') as HTMLTextAreaElement).value = cfg.initial.review;
			($('[data-me-friends]') as HTMLInputElement).value = cfg.initial.friends.join(', ');
		}
		render();
	}
</script>

