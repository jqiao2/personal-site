---
// Time-in-zone for one activity — a horizontal bar chart across the zones, one
// bar per zone sized by time spent, with its range, time and share alongside.
// Fed a computed ZoneBin[] from src/lib/zones.ts; this file only draws it.
// Rendered once for HR and once for power on the detail page.
//
// COLOUR IS EFFORT, NOT TAXONOMY — the palette's one rule (activity-tokens.ts).
// Zones are an intensity ramp, so they earn a warm-cool gradient the way the
// exertion scale earns alpenglow for "brutal": lake (easy, cold) → larch →
// alpenglow (max). That is meaning, not one-hue-per-category, so it stays
// inside the rule rather than turning the page into a dashboard.
import type { ZoneBin } from '../lib/zones';

interface Props {
	title: string;
	bins: ZoneBin[];
	/** The stream's unit, shown on each row's range: 'bpm' or 'W'. */
	unit: string;
	/** e.g. 'LTHR 165' or 'FTP 250' — what the percentages are measured against. */
	anchor: string;
	/** e.g. 'Friel, % LTHR' — the model, said plainly so the number isn't a claim. */
	model: string;
}
const { title, bins, unit, anchor, model } = Astro.props;

const total = bins.reduce((s, b) => s + b.seconds, 0);
// Bars are scaled to the busiest zone, so the longest bar fills the row and the
// rest read as fractions of it — a bar chart of where the time went, not a
// second copy of the percentages.
const peak = bins.reduce((m, b) => Math.max(m, b.seconds), 0);

// The lake → larch → alpenglow effort ramp, interpolated across however many
// zones this breakdown has (5 for HR, 7 for power).
const ANCHORS = ['#1c6e8c', '#d99a3a', '#c96f5e'].map((h) => [
	parseInt(h.slice(1, 3), 16),
	parseInt(h.slice(3, 5), 16),
	parseInt(h.slice(5, 7), 16),
]);
function zoneColor(i: number, n: number): string {
	if (n <= 1) return `rgb(${ANCHORS[0].join(',')})`;
	const p = (i / (n - 1)) * (ANCHORS.length - 1);
	const j = Math.min(Math.floor(p), ANCHORS.length - 2);
	const t = p - j;
	const c = [0, 1, 2].map((k) => Math.round(ANCHORS[j][k] + (ANCHORS[j + 1][k] - ANCHORS[j][k]) * t));
	return `rgb(${c.join(',')})`;
}

function fmtTime(seconds: number): string {
	const s = Math.round(seconds);
	const h = Math.floor(s / 3600);
	const m = Math.floor((s % 3600) / 60);
	const ss = s % 60;
	if (h > 0) return `${h}:${String(m).padStart(2, '0')}:${String(ss).padStart(2, '0')}`;
	return `${m}:${String(ss).padStart(2, '0')}`;
}
function fmtRange(b: ZoneBin): string {
	if (b.hi == null) return `${b.lo}+ ${unit}`;
	return `${b.lo}–${b.hi} ${unit}`;
}
const pct = (s: number) => (total > 0 ? (s / total) * 100 : 0);
---

<section class="zones">
	<h2 class="section-h">{title} <span class="section-h__meta">{anchor} · {model}</span></h2>

	<div class="zones__rows" role="img" aria-label={`Time in each zone: ${title.toLowerCase()}`}>
		{
			bins.map((b, i) => (
				<div class="zones__row" class:list={[b.seconds === 0 && 'zones__row--empty']}>
					<span class="zones__z">Z{b.zone.z}</span>
					<span class="zones__label">{b.zone.label}</span>
					<span class="zones__range figure">{fmtRange(b)}</span>
					<span class="zones__track">
						<span
							class="zones__fill"
							style={`width:${peak > 0 ? (b.seconds / peak) * 100 : 0}%;background:${zoneColor(i, bins.length)}`}
						/>
					</span>
					<span class="zones__time figure">{fmtTime(b.seconds)}</span>
					<span class="zones__pct figure">{Math.round(pct(b.seconds))}%</span>
				</div>
			))
		}
	</div>
</section>

<style>
	.zones {
		margin-top: 1rem;
	}
	.section-h {
		font-size: 1.05rem;
		font-family: 'Instrument Serif', Georgia, serif;
		color: #3d4a55;
		margin: 2.5rem 0 1rem;
	}
	.section-h__meta {
		font-family: 'Instrument Sans', Arial, sans-serif;
		font-size: 0.75rem;
		color: #6b7b88;
		font-weight: 400;
		margin-left: 0.4rem;
	}
	.zones__rows {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	.zones__row {
		display: grid;
		grid-template-columns: 1.6rem 6.5rem 6.5rem 1fr auto 2.6rem;
		align-items: center;
		gap: 0.6rem;
		padding: 0.3rem 0.1rem;
		font-size: 0.85rem;
		color: #3d4a55;
		border-top: 1px solid #eef4f8;
	}
	.zones__row--empty {
		color: #9aa8b2;
	}
	.zones__z {
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		color: #6b7b88;
	}
	.zones__label {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.zones__range {
		color: #6b7b88;
		font-size: 0.8rem;
		white-space: nowrap;
	}
	/* The bar itself — a track the fill grows across, longest zone = full width. */
	.zones__track {
		height: 0.7rem;
		border-radius: 999px;
		background: #eef4f8;
		overflow: hidden;
	}
	.zones__fill {
		display: block;
		height: 100%;
		min-width: 2px;
		border-radius: 999px;
	}
	.zones__row--empty .zones__track {
		background: transparent;
	}
	/* A zone with no time gets no bar — the min-width on the fill would otherwise
	   leave a 2px sliver of colour that reads as a trace of time that isn't there. */
	.zones__row--empty .zones__fill {
		display: none;
	}
	.zones__time {
		font-variant-numeric: tabular-nums;
	}
	.zones__pct {
		text-align: right;
		color: #6b7b88;
		font-variant-numeric: tabular-nums;
	}
	@media (max-width: 520px) {
		.zones__row {
			grid-template-columns: 1.6rem 5rem 1fr auto 2.4rem;
		}
		.zones__range {
			display: none;
		}
	}
</style>
