---
// The activity log's poster (ACTIVITIES.md §7). Where FilmPoster.astro shows
// what TMDB already drew, this component draws the tile itself — there is no
// third-party art for a bike ride, so the card's face has to be manufactured
// from the numbers a head unit recorded.
//
// TWO FACES BY DESIGN, NOT BY ACCIDENT. Most activities have `route_path`: a
// normalised `M x y L x y…` string already fitted to a 0-0-100-100 viewBox at
// ingest time (src/lib/route-shape.ts owns that math). Those get a static
// stroked-line map — no tiles, no JS, cheap enough to run forty-to-a-page. A
// trainer ride, a treadmill run and a pool swim have no GPS at all, and that
// is a normal reading rather than a broken one (ACTIVITIES.md's whole §0 makes
// this point), so route-less cards do not get an empty box with a "no map"
// apology in it. They get a second, deliberately different face: the numbers
// the workout *does* have, set large in Instrument Serif, because a number
// said with real display type reads as a considered answer instead of a
// placeholder for a map that didn't load.
//
// WHY THE ROUTE IS AN SVG STROKE AND NOT A CANVAS OR A STATIC MAP TILE. A map
// tile costs a network request and a tile provider's rate limit per card;
// forty of them on one page is forty requests for a shape that a 200-point
// path string already encodes losslessly enough for a 60px thumbnail. Canvas
// would need JS to run before anything paints. An inline `<path>` needs
// neither — it's in the server-rendered HTML, it scales losslessly at any
// card size via `vector-effect="non-scaling-stroke"`, and the browser paints
// it in the same pass as the text next to it.
import { ALPINE, cardStats, noGpsStats, type CardStatRow } from '../lib/activity-tokens';
import { sportIcon, sportMeta } from '../lib/sports';

// The card asks activity-tokens.ts what to say under its face — cardStats()
// for the stat line, noGpsStats() for the big numbers a routeless card gives
// its whole face to. Both used to be written out here, over a private set of
// mi/ft/clock/pace helpers and a per-family switch, which is how the same list
// on /activities/all ended up showing one set of stats in its first page and a
// different set in every page after it: the rows JS builds could not import an
// .astro file, so they had already been rewritten against sports.ts. There is
// one rule now, in a module both of them can reach.


/** Extends `CardStatRow` (activity-tokens.ts, itself sports.ts's `StatRow`)
 *  rather than re-listing the stat columns: every column `formatStat` can read
 *  is optional there, so a sport whose lead figure is SWOLF or vertical descent
 *  gets it whenever the caller passed a full `ActivityListRow`, and falls
 *  through to the next figure it does have when it didn't. */
export interface ActivityRow extends CardStatRow {
	id: number | string;
	sub_sport?: string | null;
	title: string;
	local_date: string;
	started_at?: string;
	elapsed_seconds: number;
	exertion_method?: string | null;
	route_path: string | null;
	favorite_rank?: number | null;
	start_place?: string | null;
	/** Set by activities.ts's `redactActivities` — this is a private activity
	 * being shown to a visitor, and every field above it except `sport` has
	 * already been emptied. See the redacted branch below. */
	redacted?: boolean;
}

interface Props {
	activity: ActivityRow;
	size?: 'tile' | 'row' | 'cell';
}

const { activity: a, size = 'tile' } = Astro.props;

const label = sportMeta(a.sport).label;
const glyph = sportIcon(a.sport);
const hasRoute = !a.redacted && !!a.route_path;
const stats = a.redacted ? [] : cardStats(a, size === 'cell' ? 2 : 3);
const face = a.redacted || hasRoute ? null : noGpsStats(a);

// A redacted card has nowhere to go, so it isn't a link. Astro renders a
// dynamic tag name from a capitalised variable.
const Element = a.redacted ? 'div' : 'a';

// Pull the route's start point out of "M x y …" to place the start dot —
// route_path is always emitted by route-shape.ts in this exact form.
const startMatch = a.route_path?.match(/^M\s*(-?[\d.]+)[\s,]+(-?[\d.]+)/);
const start = startMatch ? { x: Number(startMatch[1]), y: Number(startMatch[2]) } : null;
---

<!-- REDACTED CARD. A private activity, seen by a visitor: the sport glyph and
     nothing else — no title, no stats, no route. It is a <div> and not an <a>
     because the detail page it would link to 404s for this reader, and a link
     that is always a dead end is worse than no link. The sport label lives in
     aria-label/title rather than on the face, so a screen reader gets the one
     fact the card is making and a sighted reader gets the same fact as a
     glyph. -->
<Element
	class:list={['ac', `ac--${size}`, a.redacted && 'ac--redacted']}
	href={a.redacted ? undefined : `/activities/${a.id}`}
	aria-label={a.redacted ? label : undefined}
	title={a.redacted ? label : undefined}
	style={{
		'--sky': ALPINE.sky,
		'--snow': ALPINE.snow,
		'--granite': ALPINE.granite,
		'--granite-soft': ALPINE.graniteSoft,
		'--lake': ALPINE.lake,
		'--lake-deep': ALPINE.lakeDeep,
		'--larch': ALPINE.larch,
		'--scree': ALPINE.scree,
	}}
>
	{a.redacted ? (
		<div class="ac__face">
			<svg class="ac__redacted-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
				<path d={glyph} />
			</svg>
		</div>
	) : (
	<Fragment>
	<div class="ac__face">
		{
			hasRoute ? (
				<svg class="ac__route" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
					<path
						d={a.route_path!}
						fill="none"
						stroke="var(--lake)"
						stroke-width="2.2"
						stroke-linecap="round"
						stroke-linejoin="round"
						vector-effect="non-scaling-stroke"
					/>
					{start && <circle cx={start.x} cy={start.y} r="1.8" fill="var(--lake)" />}
				</svg>
			) : (
				<div class="ac__nogps">
					<div class="ac__nogps-stat">
						<span class="ac__nogps-value figure">{face![0]}</span>
					</div>
					{face![1] && (
						<div class="ac__nogps-stat ac__nogps-stat--sub">
							<span class="ac__nogps-value ac__nogps-value--sub figure">{face![1]}</span>
						</div>
					)}
					<svg class="ac__nogps-mark" viewBox="0 0 24 24" fill="none" stroke="var(--granite-soft)" stroke-width="1.5" aria-hidden="true">
						<path d={glyph} />
					</svg>
				</div>
			)
		}
		{a.favorite_rank && (
			<span class="ac__fav" title={`Favourite #${a.favorite_rank}`}>★</span>
		)}
	</div>
	<div class="ac__meta">
		<div class="ac__title">{a.title}</div>
		<div class="ac__sport">
			<svg class="ac__sport-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
				<path d={glyph} />
			</svg>
			<span>{label}</span>
		</div>
		<div class="ac__stats figure">
			{stats.map((s, i) => (
				<>
					{i > 0 && <span class="ac__stats-sep">·</span>}
					<span>{s}</span>
				</>
			))}
		</div>
	</div>
	</Fragment>
	)}
</Element>

<style>
	.ac {
		display: flex;
		flex-direction: column;
		background: var(--snow);
		border: 1px solid var(--scree);
		border-radius: 10px;
		overflow: hidden;
		color: var(--granite);
		transition: border-color 0.15s ease, transform 0.15s ease;
	}
	.ac:hover {
		border-color: var(--lake);
		transform: translateY(-1px);
	}
	.ac__face {
		position: relative;
		aspect-ratio: 4 / 3;
		background: var(--snow);
		border-bottom: 1px solid var(--scree);
		/* The face is a flex item of .ac, so its automatic minimum size is its
		   content's — and an in-flow <svg> reports an intrinsic 1:1 box, which
		   overrides aspect-ratio and makes the face as tall as the card is wide.
		   Pinning the route out of flow (below) plus min-height:0 leaves
		   aspect-ratio as the only thing sizing it. */
		flex: none;
		min-height: 0;
	}
	.ac__route {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	.ac__fav {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		color: var(--larch);
		font-size: 0.9rem;
		line-height: 1;
	}

	/* No-GPS face: the whole face goes to two figures in Instrument Serif. */
	.ac__nogps {
		position: relative;
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.15em;
	}
	.ac__nogps-stat {
		display: flex;
		align-items: baseline;
		gap: 0.3em;
	}
	.ac__nogps-value {
		font-family: 'Instrument Serif', Georgia, serif;
		font-size: 2.6rem;
		line-height: 1;
		color: var(--granite);
	}
	.ac__nogps-value--sub {
		font-size: 1.3rem;
		color: var(--granite-soft);
	}
	/* Round caps and joins are part of how the sport glyphs are drawn — see
	   SPORT_ICONS in sports.ts. Set in CSS rather than as attributes so the
	   rows all.astro builds by hand get them from the same place. */
	.ac__nogps-mark,
	.ac__sport-mark {
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.ac__nogps-mark {
		position: absolute;
		bottom: 0.6rem;
		left: 0.6rem;
		width: 1.1rem;
		height: 1.1rem;
		opacity: 0.6;
	}

	.ac__meta {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 0.75rem 0.85rem 0.9rem;
	}
	.ac__title {
		font-weight: 600;
		font-size: 0.95rem;
		line-height: 1.25;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		-webkit-text-size-adjust: 100%;
		text-size-adjust: 100%;
	}
	.ac__sport {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.78rem;
		color: var(--granite-soft);
	}
	.ac__sport-mark {
		width: 0.95rem;
		height: 0.95rem;
		flex: none;
	}
	.ac__stats {
		font-size: 0.85rem;
		color: var(--granite);
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.ac__stats-sep {
		color: var(--scree);
	}

	/* Redacted: the whole card is the face, and the face is one glyph. No meta
	   block, so the card is square-ish at every size instead of leaving an
	   empty strip where the title used to be. */
	.ac--redacted .ac__face {
		border-bottom: none;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.ac--redacted:hover {
		border-color: var(--scree);
		transform: none;
	}
	.ac__redacted-mark {
		width: 40%;
		max-width: 2.2rem;
		height: auto;
		color: var(--granite-soft);
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.ac--redacted.ac--row {
		/* No meta block to fill the rest of the line, so the card is its face
		   rather than a 120px glyph with a metre of empty card after it. */
		width: fit-content;
	}
	.ac--redacted.ac--row .ac__face {
		border-right: none;
		width: 88px;
	}

	/* tile — the landing page's top-four, largest of the three. */
	.ac--tile .ac__nogps-value {
		font-size: 3rem;
	}
	.ac--tile .ac__title {
		font-size: 1.05rem;
	}

	/* cell — the week grid's per-day list: narrow and short. */
	.ac--cell {
		border-radius: 8px;
	}
	.ac--cell .ac__face {
		aspect-ratio: 16 / 9;
	}
	.ac--cell .ac__nogps-value {
		font-size: 1.7rem;
	}
	.ac--cell .ac__nogps-value--sub {
		font-size: 1rem;
	}
	.ac--cell .ac__meta {
		padding: 0.55rem 0.6rem 0.65rem;
		gap: 0.2rem;
	}
	.ac--cell .ac__title {
		font-size: 0.85rem;
	}
	.ac--cell .ac__sport {
		font-size: 0.72rem;
	}
	.ac--cell .ac__stats {
		font-size: 0.76rem;
	}

	/* row — a wide horizontal variant for list views. */
	.ac--row {
		flex-direction: row;
		align-items: stretch;
	}
	.ac--row .ac__face {
		aspect-ratio: 1 / 1;
		width: 120px;
		flex: none;
		border-bottom: none;
		border-right: 1px solid var(--scree);
	}
	.ac--row .ac__meta {
		flex: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto auto;
		align-items: center;
		column-gap: 1.25rem;
		padding: 0 1rem;
	}
	.ac--row .ac__title {
		min-width: 0;
	}
	.ac--row .ac__stats {
		white-space: nowrap;
		text-align: right;
	}
	.ac--row .ac__nogps-value {
		font-size: 1.9rem;
	}

	/* Below ~560px the row's four columns (face / title / sport / stats) no
	   longer fit on one line without truncating numbers, which is the one
	   thing a stat card must never do — so the meta block wraps instead. */
	@media (max-width: 560px) {
		.ac--row .ac__face {
			width: 88px;
		}
		.ac--row .ac__meta {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: 0.25rem;
			padding: 0.65rem 0.75rem;
		}
		.ac--row .ac__title {
			max-width: 100%;
		}
		.ac--row .ac__stats {
			white-space: normal;
			text-align: left;
		}
	}
</style>
