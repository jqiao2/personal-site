---
// Server island: the cross-section home feed. Rendered on its own request
// (server:defer on the homepage) so the static shell ships instantly and these
// rows stream in after. recentJournal reduces the four tracks to what the
// caller is allowed to see (see its header), so nothing here can leak a private
// row to a visitor.
import { recentJournal } from '../lib/recent-journal';
import { PAGE_SIZE } from '../lib/journal-log-page';
import { requireOwner } from '../lib/auth';
import FeedRows from './FeedRows.astro';

// The island is its own request, so it does its own owner check rather than
// trusting a prop from the page. Signed in, private activities join the feed.
// PAGE_SIZE rows, so this is /log's page 1 and "See more" can open on page 2.
const recent = await recentJournal(PAGE_SIZE, await requireOwner(Astro.cookies));
---

<FeedRows items={recent} />
