---
// Server island: the cross-section home feed. Rendered on its own request
// (server:defer on the homepage) so the static shell ships instantly and these
// rows stream in after. recentJournal reduces the four tracks to what the
// caller is allowed to see (see its header), so nothing here can leak a private
// row to a visitor.
import { recentJournal, TRACK_TAG } from '../lib/recent-journal';
import { formatWatchedDate } from '../lib/format';
import { requireOwner } from '../lib/auth';

// The island is its own request, so it does its own owner check rather than
// trusting a prop from the page. Signed in, private activities join the feed.
const recent = await recentJournal(15, await requireOwner(Astro.cookies));
---

{
	recent.map((it) => (
		<article class:list={['item', `item--${it.track}`]}>
			<div class="item__body">
				<p class="item__meta">
					<time datetime={it.day}>{formatWatchedDate(it.day) ?? it.day}</time>
					<span class="tag">{TRACK_TAG[it.track]}</span>
				</p>
				<h2 class="item__title">
					{it.href ? <a href={it.href}>{it.title}</a> : <span>{it.title}</span>}
				</h2>
				{it.detail && <p class="item__note">{it.detail}</p>}
			</div>
			{(() => {
				// The thumb is a photo for the poster tracks; for an activity it's
				// the route outline where those have a cover, and the sport glyph
				// when the activity has no GPS (a trainer ride, a pool swim).
				const thumb = it.image ? (
					<img src={it.image} alt="" width="46" height="69" loading="lazy" />
				) : it.route ? (
					<svg class="item__route" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
						<path
							d={it.route}
							fill="none"
							stroke="var(--accent)"
							stroke-width="2.4"
							stroke-linecap="round"
							stroke-linejoin="round"
							vector-effect="non-scaling-stroke"
						/>
					</svg>
				) : it.icon ? (
					<svg class="item__glyph" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" aria-hidden="true">
						<path d={it.icon} />
					</svg>
				) : null;
				if (!thumb) return null;
				return it.href ? (
					<a class="item__thumb" href={it.href}>{thumb}</a>
				) : (
					<span class="item__thumb">{thumb}</span>
				);
			})()}
		</article>
	))
}

<style>
	/* Feed items — hairline-ruled rows, poster thumb on the right. */
	.item {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		padding: 0.75rem 0 1.05rem;
		border-bottom: 1px solid var(--rule-soft);
	}
	.item__body {
		flex: 1;
		min-width: 0;
	}
	.item__meta {
		font-family: var(--sans);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-soft);
		margin: 0 0 0.2rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		align-items: baseline;
	}
	.item__title {
		font-size: 1.15rem;
		font-weight: 600;
		margin: 0;
		line-height: 1.25;
	}
	.item__title a {
		color: var(--ink);
		text-decoration: none;
	}
	.item__title a:hover {
		text-decoration: underline;
	}
	.item__note {
		margin: 0.35rem 0 0;
		color: var(--ink-soft);
		font-size: 0.95rem;
	}
	.item__thumb img,
	.item__route,
	.item__glyph {
		display: block;
		width: 46px;
		height: 69px;
		object-fit: cover;
		border: 1px solid var(--rule);
		background: var(--card);
	}
	/* Route and glyph aren't cropped like a photo — they sit centred in the
	   same framed box with a little breathing room. */
	.item__route,
	.item__glyph {
		object-fit: contain;
		padding: 8px;
		box-sizing: border-box;
	}
	.item__glyph {
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.tag {
		font-family: var(--sans);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		padding: 0.1rem 0.4rem;
		border: 1px solid var(--rule);
		background: var(--accent-bg);
		color: var(--accent);
		border-radius: 2px;
	}
</style>
