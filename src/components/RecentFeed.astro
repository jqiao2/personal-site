---
// Server island: the cross-section home feed. Rendered on its own request
// (server:defer on the homepage) so the static shell ships instantly and these
// rows stream in after. recentJournal already reduces the four tracks to what a
// visitor may see (see its header), so nothing here can leak a private row.
import { recentJournal, TRACK_TAG } from '../lib/recent-journal';
import { formatWatchedDate } from '../lib/format';

const recent = await recentJournal(15);
---

{
	recent.map((it) => (
		<article class:list={['item', `item--${it.track}`]}>
			<div class="item__body">
				<p class="item__meta">
					<time datetime={it.day}>{formatWatchedDate(it.day) ?? it.day}</time>
					<span class="tag">{TRACK_TAG[it.track]}</span>
				</p>
				<h2 class="item__title">
					{it.href ? <a href={it.href}>{it.title}</a> : <span>{it.title}</span>}
				</h2>
				{it.detail && <p class="item__note">{it.detail}</p>}
			</div>
			{it.image &&
				(it.href ? (
					<a class="item__thumb" href={it.href}>
						<img src={it.image} alt="" width="46" height="69" loading="lazy" />
					</a>
				) : (
					<span class="item__thumb">
						<img src={it.image} alt="" width="46" height="69" loading="lazy" />
					</span>
				))}
		</article>
	))
}

<style>
	/* Feed items — hairline-ruled rows, poster thumb on the right. */
	.item {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		padding: 0.75rem 0 1.05rem;
		border-bottom: 1px solid var(--rule-soft);
	}
	.item__body {
		flex: 1;
		min-width: 0;
	}
	.item__meta {
		font-family: var(--sans);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-soft);
		margin: 0 0 0.2rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		align-items: baseline;
	}
	.item__title {
		font-size: 1.15rem;
		font-weight: 600;
		margin: 0;
		line-height: 1.25;
	}
	.item__title a {
		color: var(--ink);
		text-decoration: none;
	}
	.item__title a:hover {
		text-decoration: underline;
	}
	.item__note {
		margin: 0.35rem 0 0;
		color: var(--ink-soft);
		font-size: 0.95rem;
	}
	.item__thumb img {
		display: block;
		width: 46px;
		height: 69px;
		object-fit: cover;
		border: 1px solid var(--rule);
		background: var(--card);
	}
	.tag {
		font-family: var(--sans);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		padding: 0.1rem 0.4rem;
		border: 1px solid var(--rule);
		background: var(--accent-bg);
		color: var(--accent);
		border-radius: 2px;
	}
</style>
