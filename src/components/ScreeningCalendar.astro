---
// One page of the Screening Room's continuous calendar: a Sunday-first run of
// weeks in a plain 7-column grid. Rendered both by /films/screening-room and by
// its `months` partial, so appended pages come back as the same markup under
// the same scope hash — and stay styled.
import type { CalendarWeek } from '../lib/screening-calendar';
import { imageUrl } from '../lib/tmdb';

interface Props {
	weeks: CalendarWeek[];
	isOwner: boolean;
}
const { weeks, isOwner } = Astro.props;
---

{weeks.map((week) =>
	week.days.map((cell) => (
		<div
			class:list={[
				'cell',
				cell.isToday && 'cell--today',
				// The month seam, drawn on whichever of this cell's edges it runs along.
				cell.edgeTop && 'seam-t',
				cell.edgeBottom && 'seam-b',
				cell.edgeLeft && 'seam-l',
			]}
			data-date={cell.date}
		>
			<div class="cell__num">
				{cell.monthLabel && <span class="cell__month">{cell.monthLabel}</span>}
				{cell.day}
			</div>
			{isOwner && (
				<button
					type="button"
					class="cell__add"
					data-open-screening
					data-date={cell.date}
					aria-label={`Schedule a film on ${cell.date}`}
				>+</button>
			)}
			<div class="cell__films">
				{cell.films.map((f) => {
					const poster = imageUrl(f.poster_path, 'w185');
					return (
						<div
							class="film"
							data-tmdb-id={f.tmdb_id}
							data-venue={f.venue ?? ''}
							draggable={isOwner ? 'true' : 'false'}
						>
							{/* Poster-only tile with a hover overlay, same as the
							    watchlist/watched grids — clicks through to the film. */}
							<a
								class={poster ? 'tile' : 'tile tile--noimg'}
								href={`/films/movie/${f.tmdb_id}`}
								draggable="false"
							>
								{poster && <img src={poster} alt={`${f.title} poster`} loading="lazy" decoding="async" draggable="false" />}
								<div class="tile__overlay">
									<div class="tile__title">{f.title}</div>
									{f.venue && <div class="tile__venue">{f.venue}</div>}
								</div>
							</a>
							{isOwner && (
								<button
									type="button"
									class="film__remove"
									aria-label={`Remove ${f.title} from the queue`}
								>&#10005;</button>
							)}
						</div>
					);
				})}
			</div>
		</div>
	)),
)}

<style>
	.cell {
		position: relative;
		box-sizing: border-box;
		min-height: 118px;
		border: 1px solid #3a1f22;
		border-radius: 8px;
		padding: 6px;
		background: #1f0e10;
	}
	/* The month seam. It cuts the run of days between the last of one month and
	   the 1st of the next, so on a 7-column grid it steps: along the top of the
	   1st and the rest of its week, down the left of the 1st, and along the
	   bottom of the days before it. Each segment is drawn once, on the cell it
	   belongs to, so nothing doubles up across the gap. */
	.seam-t {
		border-top: 2px solid #9c6f63;
	}
	.seam-b {
		border-bottom: 2px solid #9c6f63;
	}
	.seam-l {
		border-left: 2px solid #9c6f63;
	}
	.cell--today {
		border-color: #d9b45a;
	}
	/* Drop target under a dragged poster. */
	.cell.is-over {
		border-color: #d9b45a;
		background: #2b1316;
	}
	.cell__num {
		font-family: var(--font-newsreader);
		font-size: 14px;
		color: #7c6156;
		padding: 2px 4px;
	}
	/* The 1st carries the only month name on the page. */
	.cell__month {
		color: #e0cbb0;
		margin-right: 4px;
	}
	.cell--today .cell__num {
		color: #d9b45a;
	}
	/* Owner-only "+" to schedule onto this day; shows on cell hover/focus. */
	.cell__add {
		position: absolute;
		top: 5px;
		right: 5px;
		width: 22px;
		height: 22px;
		border-radius: 6px;
		border: 1px solid #4a2529;
		background: rgba(20, 8, 9, 0.7);
		color: #d9b45a;
		font-size: 15px;
		line-height: 1;
		cursor: pointer;
		opacity: 0;
	}
	.cell:hover .cell__add,
	.cell__add:focus-visible {
		opacity: 1;
	}
	.cell__add:hover {
		background: #d9b45a;
		color: #2a1214;
	}
	/* Poster tiles wrap within a day; each is the watchlist/watched tile —
	   poster fills a 2/3 box, caption overlay shows on hover. */
	.cell__films {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 4px;
	}
	.film {
		position: relative;
		width: 46px;
	}
	.film[draggable='true'] {
		cursor: grab;
	}
	.film.is-dragging {
		opacity: 0.4;
	}
	.film.is-saving {
		opacity: 0.6;
		pointer-events: none;
	}
	.tile {
		position: relative;
		display: block;
		aspect-ratio: 2 / 3;
		border-radius: 4px;
		overflow: hidden;
		border: 1px solid #4a2529;
		background-image: repeating-linear-gradient(135deg, #351a1d 0 7px, #2c1518 7px 14px);
	}
	.tile:hover {
		border-color: #d9b45a;
	}
	.tile img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.tile__overlay {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		padding: 5px;
		background: rgba(18, 8, 9, 0.86);
		opacity: 0;
	}
	.tile:hover .tile__overlay {
		opacity: 1;
	}
	.tile--noimg .tile__overlay {
		opacity: 1;
		background: transparent;
		justify-content: center;
		text-align: center;
	}
	.tile__title {
		font-family: var(--font-newsreader);
		font-size: 10px;
		line-height: 1.15;
		color: #f4e8d1;
		overflow: hidden;
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
	}
	.tile__venue {
		font-size: 8.5px;
		color: #a2857a;
		margin-top: 2px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.film__remove {
		position: absolute;
		top: -5px;
		right: -5px;
		z-index: 2;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: rgba(20, 8, 9, 0.9);
		border: 1px solid #4a2529;
		color: #f2e5cd;
		font-size: 9px;
		line-height: 1;
		cursor: pointer;
		opacity: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.film:hover .film__remove,
	.film__remove:focus-visible {
		opacity: 1;
	}
	.film__remove:hover {
		background: #d9b45a;
		color: #2a1214;
		border-color: #d9b45a;
	}
	.film__remove:disabled {
		opacity: 0.5;
		cursor: default;
	}

	@media (max-width: 640px) {
		.cell {
			min-height: 92px;
		}
		.film {
			width: 38px;
		}
	}
</style>
