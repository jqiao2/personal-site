---
// One shelf of hardcover spines, scrolling horizontally when the books outrun
// the column. Used twice on /books: the to-read pile and everything finished.
//
// Every number here comes from shelf-view.ts. The spine carries its geometry as
// custom properties rather than a wall of inline style, so the rules below stay
// readable and only the varying quantities are written into the markup.
import { SHELF_HEIGHT, SHELF_PULL_HEADROOM, type ShelfSpine } from '../lib/shelf-view';

interface Props {
	spines: ShelfSpine[];
	/** Shown resting on an otherwise bare board. */
	emptyLine: string;
}

const { spines, emptyLine } = Astro.props;
---

<div class="shelf">
	<div
		class="shelf__scroll"
		data-shelf
		style={`padding-top:${SHELF_PULL_HEADROOM}px`}
	>
		<div class="shelf__run">
			<div class="shelf__books" style={`height:${SHELF_HEIGHT}px`}>
				{
					spines.length > 0 ? (
						spines.map((s) => (
							<a
								class="spine"
								href={s.href}
								title={s.tooltip}
								aria-label={s.aria}
								data-spine
								style={`--w:${s.width}px; --h:${s.height}px; --run:${s.runLength}px; --cloth:${s.cloth}; --foil:${s.foil}; --ts:${s.titleSize}px; --as:${s.authorSize}px; --lines:${s.titleLines}`}
							>
								<span class="spine__body">
									<span class="spine__curve" />
									{/* Head and tail bands, and the pair of rules between them. */}
									<span class="spine__band spine__band--head" />
									<span class="spine__band spine__band--tail" />
									<span class="spine__rule spine__rule--head" />
									<span class="spine__rule spine__rule--tail" />
									<span class="spine__type">
										<span class="spine__title">{s.title}</span>
										{s.showAuthor && (
											<Fragment>
												<span class="spine__sep" />
												<span class="spine__author">{s.surname}</span>
											</Fragment>
										)}
									</span>
								</span>
							</a>
						))
					) : (
						<div class="shelf__empty">{emptyLine}</div>
					)
				}
			</div>
			<div class="shelf__board" />
			<div class="shelf__under" />
		</div>
	</div>
	<div class="shelf__fade" />
</div>

<script>
	// Two-step: the first click pulls a book out of the row, the second follows
	// the link. Both spines are real anchors, so with this script absent — or
	// before it loads — one click simply opens the book, which is the behaviour
	// the pull is an enhancement on rather than a prerequisite for.
	const PULLED = 'spine--pulled';

	let pulled: HTMLElement | null = null;
	// A pull can make the browser scroll the spine into view, and the scroll
	// handler below would then immediately undo it. Ignore scrolls that arrive
	// on the heels of a pull.
	let pulledAt = 0;

	function release() {
		pulled?.classList.remove(PULLED);
		pulled = null;
	}

	for (const spine of document.querySelectorAll<HTMLAnchorElement>('[data-spine]')) {
		spine.addEventListener('click', (event) => {
			// Otherwise the shelf's own handler treats this as a click on the
			// background and releases the book we are in the middle of pulling.
			event.stopPropagation();
			if (spine === pulled) return;
			event.preventDefault();
			release();
			spine.classList.add(PULLED);
			pulled = spine;
			pulledAt = Date.now();
		});
	}

	for (const shelf of document.querySelectorAll<HTMLElement>('[data-shelf]')) {
		shelf.addEventListener('click', release);
		shelf.addEventListener('scroll', () => {
			if (pulled && Date.now() - pulledAt > 400) release();
		});
	}

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && pulled) release();
	});
</script>

<style>
	.shelf {
		position: relative;
	}
	/* The scroller clips vertically, so the headroom a pulled book rises into has
	   to be inside it — hence the padding-top set from SHELF_PULL_HEADROOM. */
	.shelf__scroll {
		overflow-x: auto;
		overflow-y: hidden;
		scrollbar-width: thin;
		scrollbar-color: #4a3520 #1c1409;
	}
	/* The board runs the whole length of the books, not just the visible width. */
	.shelf__run {
		width: max-content;
		min-width: 100%;
	}
	.shelf__books {
		display: flex;
		align-items: flex-end;
		gap: 2px;
		padding: 0 46px 0 22px;
		background: linear-gradient(180deg, #0c0704 0%, #130d07 55%, #1d1409 100%);
		box-shadow:
			inset 0 -22px 28px -20px rgba(0, 0, 0, 0.95),
			inset 0 14px 20px -16px rgba(0, 0, 0, 0.9);
	}
	.shelf__empty {
		font-family: 'Newsreader', serif;
		font-style: italic;
		font-size: 17px;
		color: #a68f6e;
		padding-bottom: 16px;
	}
	/* Timber, with the grain running along it and the light catching its front
	   edge. The strip beneath is the shadow the shelf casts on the wall. */
	.shelf__board {
		height: 20px;
		background:
			linear-gradient(180deg, #4c3721 0%, #3e2c1a 44%, #2b1d10 100%),
			repeating-linear-gradient(
				90deg,
				rgba(0, 0, 0, 0.12) 0 3px,
				rgba(255, 255, 255, 0.02) 3px 8px,
				rgba(0, 0, 0, 0.07) 8px 14px
			);
		background-blend-mode: overlay;
		box-shadow: inset 0 1px 0 rgba(232, 199, 138, 0.3);
	}
	.shelf__under {
		height: 7px;
		background: linear-gradient(180deg, #22170a 0%, #150e06 100%);
	}
	/* Says there is more shelf to the right without spending a control on it. */
	.shelf__fade {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		width: 66px;
		pointer-events: none;
		background: linear-gradient(
			90deg,
			rgba(26, 18, 10, 0) 0%,
			rgba(26, 18, 10, 0.7) 55%,
			#1a120a 100%
		);
	}

	.spine {
		display: block;
		flex: none;
		position: relative;
		width: var(--w);
		height: var(--h);
		outline: none;
		z-index: 1;
		transition: transform 0.16s ease;
	}
	/* Less than the pull, so the hint and the state never read as the same thing. */
	.spine:hover {
		transform: translateY(-7px);
	}
	.spine:focus-visible {
		outline: 2px solid #cfa452;
		outline-offset: 3px;
	}
	.spine.spine--pulled {
		z-index: 60;
		transform: none;
	}

	.spine__body {
		position: absolute;
		inset: 0;
		overflow: hidden;
		/* Square at the hinge, rounded at the fore-edge side. */
		border-radius: 1px 3px 3px 1px;
		background: var(--cloth);
		color: var(--foil);
		transform-origin: 50% 100%;
		box-shadow:
			6px 0 10px -7px rgba(0, 0, 0, 0.9),
			0 9px 13px -8px rgba(0, 0, 0, 0.95),
			inset -1px 0 0 rgba(0, 0, 0, 0.5);
		transition:
			transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
			box-shadow 0.3s ease;
	}
	.spine--pulled .spine__body {
		transform: translateY(-30px) scale(1.05) rotate(-1.4deg);
		box-shadow:
			0 26px 34px -12px rgba(0, 0, 0, 0.95),
			8px 0 18px -8px rgba(0, 0, 0, 0.8),
			0 0 0 1px rgba(207, 164, 82, 0.35);
	}
	/* The curve of the spine: lit at the hinge, falling away to the right. */
	.spine__curve {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			90deg,
			rgba(255, 246, 225, 0.17) 0%,
			rgba(255, 246, 225, 0.06) 16%,
			rgba(0, 0, 0, 0) 44%,
			rgba(0, 0, 0, 0.26) 80%,
			rgba(0, 0, 0, 0.46) 100%
		);
	}

	.spine__band {
		position: absolute;
		left: 0;
		right: 0;
		height: 5px;
		background: currentColor;
		opacity: 0.3;
	}
	.spine__band--head {
		top: 0;
	}
	.spine__band--tail {
		bottom: 0;
	}
	.spine__rule {
		position: absolute;
		left: 2px;
		right: 2px;
		height: 3px;
		border-top: 1px solid currentColor;
		border-bottom: 1px solid currentColor;
		opacity: 0.55;
	}
	.spine__rule--head {
		top: 10px;
	}
	.spine__rule--tail {
		bottom: 10px;
	}

	/* The lettering, turned a quarter clockwise so it reads top-to-bottom — the
	   convention on English-language hardcovers. The box is laid out along the
	   spine's length and then rotated, which is why its width is the run and its
	   height is the spine's width. */
	.spine__type {
		position: absolute;
		top: 50%;
		left: 50%;
		width: var(--run);
		height: var(--w);
		margin-top: calc(var(--w) / -2);
		margin-left: calc(var(--run) / -2);
		transform: rotate(90deg);
		display: flex;
		align-items: center;
		padding: 0 2px;
	}
	/* A thick spine has room to letter the title across two or three lines, the
	   way a real one does; a thin one gets a single line. --lines carries the
	   count that fits, and the clamp puts an ellipsis on whatever overruns it. */
	.spine__title {
		flex: 0 1 auto;
		min-width: 0;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: var(--lines);
		line-clamp: var(--lines);
		overflow: hidden;
		overflow-wrap: break-word;
		font-family: 'Newsreader', serif;
		font-weight: 500;
		font-size: var(--ts);
		line-height: 1.15;
		letter-spacing: 0.1px;
	}
	.spine__sep {
		flex: none;
		width: 1px;
		height: 58%;
		background: currentColor;
		opacity: 0.5;
		margin-left: auto;
	}
	.spine__author {
		flex: none;
		margin-left: 7px;
		max-width: 40%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-family: 'Archivo', sans-serif;
		font-size: var(--as);
		letter-spacing: 0.7px;
		text-transform: uppercase;
		opacity: 0.88;
	}

	/* The pull still happens — it is the state the second click depends on. It
	   just arrives without travelling. */
	@media (prefers-reduced-motion: reduce) {
		.spine,
		.spine__body {
			transition: none;
		}
		.spine:hover {
			transform: none;
		}
	}
</style>
