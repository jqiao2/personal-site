---
// Shell for the art-directed "Jason's film log" section — dark warm theme,
// Archivo + Newsreader webfonts. Page-specific styles live in each page.
import PosterLoader from '../components/PosterLoader.astro';
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&display=swap"
			rel="stylesheet"
		/>
		<!-- Posters all come from one host and none is requested until after paint,
		     so warm the connection while the page is still being built rather than
		     paying for it on the first tile. -->
		<link rel="preconnect" href="https://image.tmdb.org" />
	</head>
	<body>
		<slot />
		<PosterLoader />
		<script>
			// "Back" links go to the actual previous page when you arrived from within
			// the site; the href stays a fallback for direct loads / new tabs / external
			// referrers (where history.back() would leave the site).
			for (const a of document.querySelectorAll('a.back')) {
				a.addEventListener('click', (e) => {
					const ref = document.referrer;
					const sameOrigin = !!ref && new URL(ref).origin === location.origin;
					if (history.length > 1 && sameOrigin) {
						e.preventDefault();
						history.back();
					}
				});
			}
		</script>
		<style is:global>
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
			}
			body {
				min-height: 100vh;
				background: #1c0d0e;
				color: #f4e8d1;
				font-family: 'Archivo', Arial, sans-serif;
				-webkit-font-smoothing: antialiased;
			}
			a {
				text-decoration: none;
				color: #d9b45a;
			}
		</style>
	</body>
</html>
