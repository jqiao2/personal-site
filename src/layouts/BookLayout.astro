---
// Shell for the book log — the film log's sibling, shifted from its wine
// red to a paper brown. Same Archivo + Newsreader pairing, same art-directed
// approach: page-specific styles live in the page.
import { Font } from 'astro:assets';

interface Props {
	title: string;
}
const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="jq" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<Font cssVariable="--font-newsreader" preload />
		<Font cssVariable="--font-archivo" preload />
	</head>
	<body>
		<slot />
		<style is:global>
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
			}
			html {
				/* Hold the scrollbar's width whether or not there is one, so nothing
				   slides sideways when the page's height changes. */
				scrollbar-gutter: stable;
			}
			body {
				min-height: 100vh;
				background: #1a120a;
				color: #f2e6cd;
				font-family: var(--font-archivo);
				-webkit-font-smoothing: antialiased;
			}
			a {
				text-decoration: none;
				color: #cfa452;
			}
			a:hover {
				color: #ecc87c;
			}
		</style>
	</body>
</html>
