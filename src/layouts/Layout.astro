---
interface Props {
	title: string;
	showTmdbFooter?: boolean;
}

const { title, showTmdbFooter = false } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<nav>
				<a href="/">Home</a>
				<a href="/about">About</a>
				<a href="/projects">Projects</a>
				<a href="/films">Films</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		{
			showTmdbFooter && (
				<footer>
					<p>
						This product uses the TMDB API but is not endorsed or certified by{" "}
						<a href="https://www.themoviedb.org/" rel="noopener" target="_blank">
							TMDB
						</a>
						.
					</p>
				</footer>
			)
		}
		<style>
			:root {
				color-scheme: light dark;
				--bg: #fff;
				--fg: #111;
				--border: #ddd;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--bg: #111;
					--fg: #eee;
					--border: #333;
				}
			}
			body {
				font-family: system-ui, sans-serif;
				background: var(--bg);
				color: var(--fg);
				margin: 0;
			}
			header {
				border-bottom: 1px solid var(--border);
				padding: 1rem 2rem;
			}
			nav {
				display: flex;
				gap: 1.5rem;
				max-width: 800px;
				margin: 0 auto;
			}
			nav a {
				text-decoration: none;
				color: var(--fg);
				font-weight: 500;
			}
			nav a:hover {
				text-decoration: underline;
			}
			main {
				max-width: 800px;
				margin: 0 auto;
				padding: 2rem;
			}
			footer {
				border-top: 1px solid var(--border);
				max-width: 800px;
				margin: 2rem auto 0;
				padding: 1rem 2rem;
				font-size: 0.8rem;
				opacity: 0.7;
			}
			footer a {
				color: inherit;
			}
		</style>
	</body>
</html>
