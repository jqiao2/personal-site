---
import Layout from '../layouts/Layout.astro';
import RecentFeed from '../components/RecentFeed.astro';

// Static shell. The header's "Log in" button is hidden client-side for the owner
// now (see SiteHeader.astro), which was the only thing that made this whole
// response server-rendered. The cross-section feed stays a server island
// (RecentFeed, server:defer below) — it re-checks the owner from cookies and
// streams in per request — so the most-hit page on the site is now one static
// file the CDN serves with no function invocation for its shell.
---

<Layout title="Jason Qiao" wide sidebar>
	<div class="shell">
		<div class="feed">
			<p class="intro">
				Where I document my career work and my hobbies. Start with my{' '}
				<a href="/about">background</a> or my{' '}
				<a href="/projects">coding projects</a>.
			</p>

			<RecentFeed server:defer>
				<div slot="fallback" class="feed__skeleton" aria-hidden="true">
					{Array.from({ length: 6 }).map(() => (
						<div class="skel-item">
							<div class="skel-body">
								<div class="skel-line skel-line--meta"></div>
								<div class="skel-line skel-line--title"></div>
								<div class="skel-line skel-line--note"></div>
							</div>
							<div class="skel-thumb"></div>
						</div>
					))}
				</div>
			</RecentFeed>

			<p class="feed__more"><a href="/month">The month in review →</a></p>
		</div>

		<aside class="sidebar" id="site-drawer" data-site-drawer>
			<section class="widget">
				<h3 class="widget__title">Sections</h3>
				<ul class="widget__list">
					<li><a href="/films">Films</a></li>
					<li><a href="/books">Books</a></li>
					<li><a href="/restaurants">Restaurants</a></li>
					<li><a href="/activities">Activities</a></li>
					<li><a href="/subway">Subway</a></li>
					<li><a href="/projects">Projects</a></li>
				</ul>
			</section>

			<section class="widget">
				<h3 class="widget__title">Elsewhere</h3>
				<ul class="widget__list widget__list--plain">
					<li><a href="/pinned">Pinned</a></li>
					<li><a href="/archive">Archive</a></li>
					<li><a href="/about">About me</a></li>
				</ul>
			</section>

			<a class="rss" href="/rss.xml">RSS</a>
		</aside>
	</div>
</Layout>

<style>
	.shell {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 200px;
		gap: 2.5rem;
	}
	@media (max-width: 820px) {
		.shell {
			grid-template-columns: 1fr;
		}
		/* Off-canvas drawer (positioning comes from SiteHeader's global rule);
		   here it just gets an opaque paper ground and its own padding, since it
		   no longer sits inside the page's gutter. */
		.sidebar {
			background: var(--paper);
			border-left: 1px solid var(--rule);
			padding: 1.5rem 1.4rem;
		}
	}

	.intro {
		margin: 0 0 1.5rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--rule);
		color: var(--ink-soft);
	}

	/* Skeleton rows shown while the RecentFeed island streams in. Mirrors the
	   real row geometry, and reserves the height of the whole feed, so nothing
	   below it moves when the island lands — the six rows are what the reader
	   sees, the min-height is what holds the rest of the page still.
	   ponytail: the reserve is measured (15 rows at 1280px/420px), not derived.
	   It drifts if the row template or `recentJournal(15)` changes; re-measure
	   with a script like tmp/measure.mjs rather than guessing. */
	.feed__skeleton {
		min-height: 1730px;
	}
	@media (max-width: 820px) {
		.feed__skeleton {
			min-height: 1800px;
		}
	}
	.skel-item {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		padding: 0.75rem 0 1.05rem;
		border-bottom: 1px solid var(--rule-soft);
	}
	.skel-body {
		flex: 1;
		min-width: 0;
	}
	.skel-thumb {
		flex: none;
		width: 46px;
		height: 69px;
		border: 1px solid var(--rule);
		background: var(--card);
	}
	.skel-line {
		height: 0.72rem;
		border-radius: 2px;
		background: var(--rule-soft);
	}
	.skel-line--meta {
		width: 40%;
		margin-bottom: 0.5rem;
	}
	.skel-line--title {
		width: 75%;
		height: 1.15rem;
		margin-bottom: 0.5rem;
	}
	.skel-line--note {
		width: 90%;
	}
	.feed__more {
		font-family: var(--sans);
		font-size: 0.8rem;
		margin-top: 1.25rem;
	}

	/* Sidebar */
	.sidebar {
		font-size: 0.9rem;
	}
	.widget {
		margin-bottom: 1.8rem;
	}
	.widget__title {
		font-family: var(--sans);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--ink-soft);
		margin: 0 0 0.5rem;
		padding-bottom: 0.3rem;
		border-bottom: 1px solid var(--rule);
	}
	.widget__list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.widget__list li {
		padding: 0.2rem 0;
		line-height: 1.35;
	}
	.rss {
		display: inline-block;
		font-family: var(--sans);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: #fff;
		background: var(--accent);
		padding: 0.25rem 0.6rem;
		border-radius: 2px;
		text-decoration: none;
	}
	.rss:visited {
		color: #fff;
	}
</style>
