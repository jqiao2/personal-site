---
// Interactive MTA subway log. Network geometry, stations and per-service track
// segments are generated from the official MTA schematic diagram — see
// src/scripts/subway-data.js. Rendering and interaction are handled client-side.
//
// Rendering note: the viewport <g> is only ever TRANSLATED (never scaled), and
// geometry is drawn at data*k plus a fixed-pixel parallel offset. That keeps every
// stroke, pill and label a constant on-screen size at any zoom while positions
// scale. Each service is its own parallel line and toggles independently.
const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/films', label: 'Films' },
	{ href: '/subway', label: 'Subway Map', active: true },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Subway Map</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<section class="sm">
			<nav class="sm-nav">
				{
					nav.map((n) => (
						<a href={n.href} class={n.active ? 'active' : ''}>
							{n.label}
						</a>
					))
				}
			</nav>

			<div class="sm-body">
				<div class="sm-mapwrap">
					<svg id="sm-svg" preserveAspectRatio="xMidYMid meet">
						<rect id="sm-bg" x="0" y="0" fill="#eef1ee"></rect>
						<g id="sm-vp">
							<g id="sm-lines"></g>
							<g id="sm-hit"></g>
							<g id="sm-pills"></g>
							<g id="sm-labels"></g>
						</g>
					</svg>

					<div class="sm-controls">
						<div class="sm-zoom">
							<button id="sm-zin" title="Zoom in">+</button>
							<button id="sm-zout" title="Zoom out">&minus;</button>
							<button id="sm-reset" title="Reset view">&#8634;</button>
						</div>
						<div id="sm-msg" class="sm-msg" hidden></div>
					</div>

					<div class="sm-hint">
						Scroll to zoom &middot; drag to pan &middot; zoom in for station names &middot; click a
						line to mark it ridden, a station to mark it visited
					</div>
				</div>

				<aside class="sm-side">
					<div>
						<div class="sm-title">Subway log</div>
						<div id="sm-tot-st" class="sm-tot-st">Loading network…</div>
						<div id="sm-tot-sg" class="sm-tot-sg"></div>
						<div id="sm-tot-pct" class="sm-tot-pct"></div>
					</div>
					<div class="sm-rule"></div>
					<div id="sm-rows" class="sm-rows"></div>
					<div class="sm-rule"></div>
					<div class="sm-io">
						<button id="sm-export">Export JSON</button>
						<label>
							Import JSON
							<input id="sm-import" type="file" accept=".json,application/json" hidden />
						</label>
					</div>
					<p class="sm-note">
						Every service is its own line — the A, C and E each run their own track down 8 Av, so
						you can log them independently. Click a line to mark it ridden and a station to mark it
						visited. Saved in this browser; export to back up or move devices.
					</p>
				</aside>
			</div>
		</section>

		<style is:global>
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				height: 100%;
			}
			body {
				background: #1c0d0e;
				font-family: 'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif;
				-webkit-font-smoothing: antialiased;
			}
			.sm {
				min-height: 100vh;
				background: #2a1214;
				display: flex;
				flex-direction: column;
			}
			.sm-nav {
				display: flex;
				align-items: stretch;
				gap: 2px;
				padding: 0 28px;
				background: #20100f;
				border-bottom: 1px solid #4a2529;
			}
			.sm-nav a {
				font-size: 13px;
				letter-spacing: 0.4px;
				color: #c2a99a;
				text-decoration: none;
				padding: 22px 16px 20px;
				border-bottom: 2px solid transparent;
			}
			.sm-nav a:hover {
				color: #f4e8d1;
			}
			.sm-nav a.active {
				color: #f4e8d1;
				font-weight: 600;
				border-bottom-color: #d9b45a;
			}
			.sm-body {
				display: flex;
				flex: 1;
				height: calc(100vh - 62px);
				min-height: 520px;
			}
			.sm-mapwrap {
				flex: 1;
				min-width: 0;
				position: relative;
				background: #eef1ee;
			}
			#sm-svg {
				width: 100%;
				height: 100%;
				display: block;
				cursor: grab;
				touch-action: none;
			}
			#sm-svg.dragging {
				cursor: grabbing;
			}
			.sm-controls {
				position: absolute;
				top: 14px;
				left: 14px;
				display: flex;
				flex-direction: column;
				gap: 8px;
				align-items: flex-start;
			}
			.sm-zoom {
				display: flex;
				gap: 6px;
			}
			.sm-zoom button {
				width: 34px;
				height: 34px;
				border: none;
				border-radius: 8px;
				background: #20100f;
				color: #f4e8d1;
				font-size: 18px;
				cursor: pointer;
			}
			.sm-zoom button:hover {
				background: #3a1d1f;
			}
			.sm-msg {
				background: #20100f;
				color: #f4e8d1;
				font: 500 12px Archivo, Arial, sans-serif;
				padding: 8px 12px;
				border-radius: 8px;
				max-width: 240px;
			}
			.sm-hint {
				position: absolute;
				bottom: 12px;
				left: 14px;
				right: 14px;
				font: 500 11px Archivo, Arial, sans-serif;
				color: #6b7370;
				pointer-events: none;
			}
			.sm-side {
				width: 306px;
				flex: none;
				background: #20100f;
				border-left: 1px solid #4a2529;
				padding: 24px 20px;
				overflow-y: auto;
				display: flex;
				flex-direction: column;
				gap: 18px;
			}
			.sm-title {
				font-family: 'Newsreader', serif;
				font-size: 24px;
				font-weight: 500;
				color: #f4e8d1;
				line-height: 1.1;
			}
			.sm-tot-st {
				margin-top: 10px;
				font-size: 13px;
				color: #d9b45a;
				font-weight: 600;
			}
			.sm-tot-sg {
				margin-top: 3px;
				font-size: 13px;
				color: #ddc9b4;
			}
			.sm-tot-pct {
				margin-top: 3px;
				font-size: 12px;
				color: #a2857a;
			}
			.sm-rule {
				height: 1px;
				background: #4a2529;
			}
			.sm-rows {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 12px 16px;
			}
			.sm-row {
				display: grid;
				grid-template-columns: 26px 1fr;
				align-items: center;
				gap: 9px;
			}
			.sm-bullet {
				width: 26px;
				height: 26px;
				border-radius: 50%;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				font: 700 13px Archivo, Arial, sans-serif;
			}
			.sm-bullet.sir {
				font-size: 9px;
				letter-spacing: 0.2px;
			}
			.sm-rowinfo {
				min-width: 0;
			}
			.sm-rowpct {
				font: 600 12px Archivo, Arial, sans-serif;
				color: #f4e8d1;
			}
			.sm-bar {
				height: 4px;
				background: #3a1d1f;
				border-radius: 2px;
				overflow: hidden;
				margin-top: 3px;
			}
			.sm-bar > div {
				height: 100%;
				border-radius: 2px;
				transition: width 0.15s ease;
			}
			.sm-io {
				display: flex;
				gap: 8px;
			}
			.sm-io button,
			.sm-io label {
				flex: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				border: 1px solid #6b3a3f;
				border-radius: 8px;
				background: transparent;
				color: #f4e8d1;
				font: 600 12px Archivo, Arial, sans-serif;
				padding: 9px 0;
				cursor: pointer;
			}
			.sm-io button:hover,
			.sm-io label:hover {
				border-color: #d9b45a;
			}
			.sm-note {
				margin: 0;
				font: 400 11px Archivo, Arial, sans-serif;
				color: #a2857a;
				line-height: 1.5;
			}
			@media (max-width: 760px) {
				.sm-body {
					flex-direction: column;
					height: auto;
				}
				.sm-mapwrap {
					height: 70vh;
				}
				.sm-side {
					width: 100%;
					border-left: none;
					border-top: 1px solid #4a2529;
				}
			}
		</style>

		<script>
			import { CANVAS, SERVICES, STATIONS, SEGMENTS } from '../scripts/subway-data.js';

			const KEY = 'mta-subway-log-v2';
			const SVGNS = 'http://www.w3.org/2000/svg';
			const W = CANVAS.W, H = CANVAS.H;

			// Fixed on-screen sizes (viewBox units ≈ constant screen px since the group
			// only translates). Parallel service lines are SPACING apart.
			const SPACING = 4.8;
			const LINE_W = 3.0, LINE_W_ON = 3.9, HIT_W = 5.2;
			const PILL_TH = 5.4, PILL_PAD = 3.6, PILL_BORDER = 1.4;
			const TINT = 0.32; // faded amount for unridden track
			const LABEL_FONT = 11, LABEL_ZOOM = 2.0;
			// Below this zoom, lines/pills hold a fixed on-screen size; beyond it they
			// scale with zoom so parallel lines fan apart and are easier to click.
			const SIZE_K0 = 4;
			const sizeScaleFor = (z) => (z <= SIZE_K0 ? 1 : z / SIZE_K0);
			let curScale = 1;

			const svg = document.getElementById('sm-svg');
			svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
			const bg = document.getElementById('sm-bg');
			bg.setAttribute('width', W); bg.setAttribute('height', H);
			const vp = document.getElementById('sm-vp');
			const gLines = document.getElementById('sm-lines');
			const gHit = document.getElementById('sm-hit');
			const gPills = document.getElementById('sm-pills');
			const gLabels = document.getElementById('sm-labels');
			const msgEl = document.getElementById('sm-msg');

			const stById = {};
			STATIONS.forEach((s) => (stById[s.id] = s));
			const oMap = {};
			SERVICES.forEach((sv) => (oMap[sv.svc] = sv.o));

			// ---- state ----
			let marks = { st: {}, seg: {} };
			try {
				const s = JSON.parse(localStorage.getItem(KEY));
				if (s && s.st && s.seg) marks = s;
			} catch (e) {}
			let k = 1, tx = 0, ty = 0, showLabels = false;

			// ---- helpers ----
			function el(name, attrs) {
				const e = document.createElementNS(SVGNS, name);
				for (const kk in attrs) e.setAttribute(kk, attrs[kk]);
				return e;
			}
			function mix(hex, t) {
				const b = [0xee, 0xf1, 0xee];
				let c = '#';
				for (let j = 0; j < 3; j++) {
					const v = Math.round(parseInt(hex.slice(1 + j * 2, 3 + j * 2), 16) * t + b[j] * (1 - t));
					c += v.toString(16).padStart(2, '0');
				}
				return c;
			}
			function textOn(hex) {
				const r = parseInt(hex.slice(1, 3), 16), g = parseInt(hex.slice(3, 5), 16), b = parseInt(hex.slice(5, 7), 16);
				return 0.299 * r + 0.587 * g + 0.114 * b > 150 ? '#141414' : '#ffffff';
			}
			function save() { try { localStorage.setItem(KEY, JSON.stringify(marks)); } catch (e) {} }
			function setMsg(t) { if (t) { msgEl.textContent = t; msgEl.hidden = false; } else msgEl.hidden = true; }
			// Orient a normal into a fixed half-plane so parallel offsets never flip
			// sides between segments (diagonal reference avoids grid-aligned lines).
			function hemi(nx, ny) { return nx + ny < 0 ? [-nx, -ny] : [nx, ny]; }

			// ---- per-segment unit normals (zoom-independent), pts[0]↔a, pts[last]↔b ----
			// Orient by PROPAGATION from the most axis-aligned vertex so the normal
			// never flips sign along a segment (which made diagonals look harsh).
			SEGMENTS.forEach((sg) => {
				const P = sg.pts, L = P.length, raw = [];
				for (let i = 0; i < L; i++) {
					let ax, ay;
					if (L === 1) { ax = 1; ay = 0; }
					else if (i === 0) { ax = P[1][0] - P[0][0]; ay = P[1][1] - P[0][1]; }
					else if (i === L - 1) { ax = P[L - 1][0] - P[L - 2][0]; ay = P[L - 1][1] - P[L - 2][1]; }
					else { ax = P[i + 1][0] - P[i - 1][0]; ay = P[i + 1][1] - P[i - 1][1]; }
					const len = Math.hypot(ax, ay) || 1;
					raw.push([-ay / len, ax / len]);
				}
				// seed at the vertex whose normal sits furthest from the flip boundary
				let seed = 0, bm = -1;
				for (let i = 0; i < L; i++) { const m = Math.abs(raw[i][0] + raw[i][1]); if (m > bm) { bm = m; seed = i; } }
				const N = new Array(L);
				N[seed] = hemi(raw[seed][0], raw[seed][1]);
				for (let i = seed + 1; i < L; i++) N[i] = raw[i][0] * N[i - 1][0] + raw[i][1] * N[i - 1][1] >= 0 ? raw[i] : [-raw[i][0], -raw[i][1]];
				for (let i = seed - 1; i >= 0; i--) N[i] = raw[i][0] * N[i + 1][0] + raw[i][1] * N[i + 1][1] >= 0 ? raw[i] : [-raw[i][0], -raw[i][1]];
				sg._n = N;
			});

			// ---- share endpoint normals so parallel lines line up through a station ----
			const stationEnds = {};
			SEGMENTS.forEach((sg) => {
				const L = sg.pts.length;
				(stationEnds[sg.a] = stationEnds[sg.a] || []).push({ sg, i: 0 });
				(stationEnds[sg.b] = stationEnds[sg.b] || []).push({ sg, i: L - 1 });
			});
			for (const id in stationEnds) {
				const ends = stationEnds[id];
				if (ends.length !== 2) continue; // only straightforward through-stations
				const n0 = ends[0].sg._n[ends[0].i], n1 = ends[1].sg._n[ends[1].i];
				let sx = n0[0] + n1[0], sy = n0[1] + n1[1];
				const l = Math.hypot(sx, sy) || 1; sx /= l; sy /= l;
				ends[0].sg._n[ends[0].i] = [sx, sy];
				ends[1].sg._n[ends[1].i] = [sx, sy];
			}

			// ---- per-station marker geometry (orientation, span) + label priority ----
			const cov = {}; // id -> {Sxx,Sxy,Syy,cnt}
			function addDir(id, dx, dy) {
				const l = Math.hypot(dx, dy) || 1, x = dx / l, y = dy / l;
				const c = cov[id] || (cov[id] = { Sxx: 0, Sxy: 0, Syy: 0, cnt: 0 });
				c.Sxx += x * x; c.Sxy += x * y; c.Syy += y * y; c.cnt++;
			}
			SEGMENTS.forEach((sg) => {
				const P = sg.pts, L = P.length;
				addDir(sg.a, P[1][0] - P[0][0], P[1][1] - P[0][1]);
				addDir(sg.b, P[L - 2][0] - P[L - 1][0], P[L - 2][1] - P[L - 1][1]);
			});
			// offset range of the lines actually meeting at each station (sized/centred
			// from the packed per-segment offsets, so the pill length tracks the number
			// of lines through it and stays centred on the bundle).
			const oRange = {};
			SEGMENTS.forEach((sg) => {
				[sg.a, sg.b].forEach((id) => {
					const r = oRange[id] || (oRange[id] = [Infinity, -Infinity]);
					r[0] = Math.min(r[0], sg.o); r[1] = Math.max(r[1], sg.o);
				});
			});
			const stMeta = {};
			STATIONS.forEach((s) => {
				const c = cov[s.id] || { Sxx: 1, Sxy: 0, Syy: 0, cnt: 0 };
				const ang = 0.5 * Math.atan2(2 * c.Sxy, c.Sxx - c.Syy); // principal (line) axis
				let nx = -Math.sin(ang), ny = Math.cos(ang);
				if (nx + ny < 0) { nx = -nx; ny = -ny; }
				let deg = (Math.atan2(ny, nx) * 180) / Math.PI;
				deg = Math.round(deg / 45) * 45; // snap pill to 45° increments
				const r = oRange[s.id] || [0, 0];
				stMeta[s.id] = {
					nx: Math.cos((deg * Math.PI) / 180), ny: Math.sin((deg * Math.PI) / 180),
					deg,
					midOff: ((r[0] + r[1]) / 2) * SPACING,
					len: (r[1] - r[0]) * SPACING + LINE_W_ON + PILL_PAD,
					prio: c.cnt,
				};
			});
			const stationsByPrio = [...STATIONS].sort((a, b) => stMeta[b.id].prio - stMeta[a.id].prio);

			// ---- build lines (visible + hit) ----
			const segEls = {};
			SEGMENTS.forEach((sg) => {
				const vis = el('path', {
					stroke: mix(sg.color, TINT), 'stroke-width': LINE_W, fill: 'none',
					'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'pointer-events': 'none',
				});
				gLines.appendChild(vis);
				const hit = el('path', {
					stroke: 'rgba(0,0,0,0)', 'stroke-width': HIT_W, fill: 'none',
					'stroke-linecap': 'round', style: 'cursor:pointer;',
				});
				const title = el('title', {});
				hit.appendChild(title);
				hit.addEventListener('click', () => toggleSeg(sg.id));
				gHit.appendChild(hit);
				segEls[sg.id] = { sg, vis, hit, title };
			});

			// ---- build station pills + labels ----
			const pillEls = {};
			const labelEls = {};
			STATIONS.forEach((s) => {
				const m = stMeta[s.id];
				const rect = el('rect', {
					x: (-m.len / 2).toFixed(2), y: (-PILL_TH / 2).toFixed(2),
					width: m.len.toFixed(2), height: PILL_TH, rx: (PILL_TH / 2).toFixed(2),
					'stroke-width': PILL_BORDER, 'vector-effect': 'non-scaling-stroke', style: 'cursor:pointer;',
				});
				const title = el('title', {});
				rect.appendChild(title);
				rect.addEventListener('click', () => stationClick(s.id));
				gPills.appendChild(rect);
				pillEls[s.id] = { s, rect, title, m };

				const right = s.x >= W / 2;
				const label = el('text', {
					'text-anchor': right ? 'start' : 'end',
					style: 'font:600 ' + LABEL_FONT + 'px Archivo,Arial,sans-serif; fill:#2a2620; paint-order:stroke; stroke:#eef1ee; stroke-width:3px; pointer-events:none;',
				});
				label.textContent = s.name;
				label.style.display = 'none';
				gLabels.appendChild(label);
				labelEls[s.id] = { s, label, right, w: s.name.length * LABEL_FONT * 0.54 };
			});

			// ---- geometry (depends on zoom k). Positions scale; sizes/offsets fixed. ----
			function drawGeometry() {
				curScale = sizeScaleFor(k);
				const sp = SPACING * curScale;
				const hw = (HIT_W * curScale).toFixed(2);
				for (const id in segEls) {
					const e = segEls[id], sg = e.sg, off = sg.o * sp, P = sg.pts, N = sg._n;
					let d = '';
					for (let i = 0; i < P.length; i++) {
						const x = P[i][0] * k + off * N[i][0];
						const y = P[i][1] * k + off * N[i][1];
						d += (i ? ' L ' : 'M ') + x.toFixed(1) + ' ' + y.toFixed(1);
					}
					e.vis.setAttribute('d', d);
					e.vis.setAttribute('stroke-width', ((marks.seg[sg.id] ? LINE_W_ON : LINE_W) * curScale).toFixed(2));
					e.hit.setAttribute('d', d);
					e.hit.setAttribute('stroke-width', hw);
				}
				STATIONS.forEach((s) => {
					const m = stMeta[s.id];
					const cx = s.x * k + m.midOff * curScale * m.nx, cy = s.y * k + m.midOff * curScale * m.ny;
					pillEls[s.id].rect.setAttribute('transform', 'translate(' + cx.toFixed(1) + ' ' + cy.toFixed(1) + ') rotate(' + m.deg + ') scale(' + curScale.toFixed(3) + ')');
				});
				drawLabels();
			}
			function drawLabels() {
				if (!showLabels) { STATIONS.forEach((s) => (labelEls[s.id].label.style.display = 'none')); return; }
				const placed = [];
				for (const s of stationsByPrio) {
					const e = labelEls[s.id], px = s.x * k, py = s.y * k;
					const bx = e.right ? px + 8 : px - 8 - e.w;
					const by = py - LABEL_FONT * 0.55;
					const box = [bx, by, bx + e.w, by + LABEL_FONT * 1.1];
					let clash = false;
					for (let i = 0; i < placed.length; i++) {
						const p = placed[i];
						if (box[0] < p[2] && box[2] > p[0] && box[1] < p[3] && box[3] > p[1]) { clash = true; break; }
					}
					if (clash) { e.label.style.display = 'none'; }
					else {
						placed.push(box);
						e.label.style.display = '';
						e.label.setAttribute('x', (e.right ? px + 8 : px - 8).toFixed(1));
						e.label.setAttribute('y', (py + LABEL_FONT * 0.34).toFixed(1));
					}
				}
			}

			// ---- state → styling (independent of zoom) ----
			function renderSegMark(sg) {
				const e = segEls[sg.id], on = !!marks.seg[sg.id];
				e.vis.setAttribute('stroke', on ? sg.color : mix(sg.color, TINT));
				e.vis.setAttribute('stroke-width', ((on ? LINE_W_ON : LINE_W) * curScale).toFixed(2));
				e.title.textContent = sg.svc + ' · ' + stById[sg.a].name + ' ↔ ' + stById[sg.b].name + (on ? ' — ridden' : '');
			}
			function renderPillMark(s) {
				const e = pillEls[s.id], on = !!marks.st[s.id];
				e.rect.setAttribute('fill', on ? '#26231f' : '#ffffff');
				e.rect.setAttribute('stroke', on ? '#26231f' : '#7a7264');
				e.title.textContent = s.name + ' (' + s.svcs.join(' ') + ')' + (on ? ' — visited' : '');
			}
			function renderAllMarks() {
				SEGMENTS.forEach(renderSegMark);
				STATIONS.forEach(renderPillMark);
				renderSidebar();
			}

			// ---- sidebar ----
			const rowEls = {};
			const rowsWrap = document.getElementById('sm-rows');
			SERVICES.forEach((sv) => {
				const row = document.createElement('div');
				row.className = 'sm-row';
				const bullet = document.createElement('span');
				bullet.className = 'sm-bullet' + (sv.svc.length > 1 ? ' sir' : '');
				bullet.style.background = sv.color;
				bullet.style.color = textOn(sv.color);
				bullet.textContent = sv.svc;
				const info = document.createElement('div');
				info.className = 'sm-rowinfo';
				const pct = document.createElement('div');
				pct.className = 'sm-rowpct';
				const bar = document.createElement('div');
				bar.className = 'sm-bar';
				const barIn = document.createElement('div');
				barIn.style.background = sv.color;
				bar.appendChild(barIn);
				info.appendChild(pct);
				info.appendChild(bar);
				row.appendChild(bullet);
				row.appendChild(info);
				rowsWrap.appendChild(row);
				rowEls[sv.svc] = { pct, bar: barIn };
			});
			function renderSidebar() {
				const per = {};
				SERVICES.forEach((sv) => (per[sv.svc] = { sgT: 0, sgR: 0 }));
				SEGMENTS.forEach((sg) => { const p = per[sg.svc]; p.sgT++; if (marks.seg[sg.id]) p.sgR++; });
				SERVICES.forEach((sv) => {
					const p = per[sv.svc], pct = p.sgT ? Math.round((100 * p.sgR) / p.sgT) : 0;
					rowEls[sv.svc].pct.textContent = pct + '%';
					rowEls[sv.svc].bar.style.width = pct + '%';
				});
				const visited = STATIONS.filter((s) => marks.st[s.id]).length;
				const ridden = SEGMENTS.filter((sg) => marks.seg[sg.id]).length;
				document.getElementById('sm-tot-st').textContent = visited + ' / ' + STATIONS.length + ' stations visited';
				document.getElementById('sm-tot-sg').textContent = ridden + ' / ' + SEGMENTS.length + ' track segments ridden';
				document.getElementById('sm-tot-pct').textContent = Math.round((100 * ridden) / SEGMENTS.length) + '% of the system ridden';
			}

			// ---- marking ----
			function toggleSeg(id) {
				if (dragMoved) return;
				if (marks.seg[id]) delete marks.seg[id]; else marks.seg[id] = 1;
				save();
				renderSegMark(segEls[id].sg);
				renderSidebar();
			}
			function stationClick(id) {
				if (dragMoved) return;
				if (marks.st[id]) delete marks.st[id]; else marks.st[id] = 1;
				save();
				renderPillMark(stById[id]);
				renderSidebar();
			}

			// ---- pan / zoom ----
			function applyPan() { vp.setAttribute('transform', 'translate(' + tx.toFixed(2) + ' ' + ty.toFixed(2) + ')'); }
			function clampPan() {
				tx = Math.min(W * 0.4, Math.max(W * (1 - k) - W * 0.4, tx));
				ty = Math.min(H * 0.4, Math.max(H * (1 - k) - H * 0.4, ty));
			}
			function metrics() {
				const r = svg.getBoundingClientRect();
				const s = Math.min(r.width / W, r.height / H);
				return { r, s, ox: (r.width - W * s) / 2, oy: (r.height - H * s) / 2 };
			}
			function labelCheck() {
				const show = k >= LABEL_ZOOM;
				if (show !== showLabels) showLabels = show;
			}
			let rafPending = false;
			function scheduleDraw() {
				if (rafPending) return;
				rafPending = true;
				requestAnimationFrame(() => { rafPending = false; drawGeometry(); });
			}
			function zoomAt(qx, qy, factor) {
				const k2 = Math.max(1, Math.min(22, k * factor));
				tx = qx - (qx - tx) * (k2 / k);
				ty = qy - (qy - ty) * (k2 / k);
				k = k2;
				clampPan(); applyPan(); labelCheck(); scheduleDraw();
			}
			svg.addEventListener('wheel', (e) => {
				e.preventDefault();
				const m = metrics();
				const qx = (e.clientX - m.r.left - m.ox) / m.s;
				const qy = (e.clientY - m.r.top - m.oy) / m.s;
				zoomAt(qx, qy, Math.exp(-e.deltaY * 0.0015));
			}, { passive: false });

			let drag = null, dragMoved = false;
			svg.addEventListener('pointerdown', (e) => {
				if (e.button !== 0) return;
				drag = { x: e.clientX, y: e.clientY };
				dragMoved = false;
				svg.classList.add('dragging');
			});
			svg.addEventListener('pointermove', (e) => {
				if (!drag) return;
				const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
				if (Math.abs(dx) + Math.abs(dy) > 4) dragMoved = true;
				const m = metrics();
				tx += dx / m.s; ty += dy / m.s;
				drag = { x: e.clientX, y: e.clientY };
				clampPan(); applyPan();
			});
			function endDrag() { drag = null; svg.classList.remove('dragging'); }
			svg.addEventListener('pointerup', endDrag);
			svg.addEventListener('pointerleave', endDrag);
			document.getElementById('sm-zin').addEventListener('click', () => zoomAt(W / 2, H / 2, 1.5));
			document.getElementById('sm-zout').addEventListener('click', () => zoomAt(W / 2, H / 2, 1 / 1.5));
			document.getElementById('sm-reset').addEventListener('click', () => {
				k = 1; tx = 0; ty = 0; applyPan(); labelCheck(); drawGeometry();
			});

			// ---- export / import ----
			document.getElementById('sm-export').addEventListener('click', () => {
				const data = { format: 'mta-subway-log', version: 2, stationsVisited: Object.keys(marks.st), segmentsRidden: Object.keys(marks.seg) };
				const a = document.createElement('a');
				a.href = URL.createObjectURL(new Blob([JSON.stringify(data, null, 1)], { type: 'application/json' }));
				a.download = 'mta-subway-log.json';
				a.click();
			});
			document.getElementById('sm-import').addEventListener('change', (e) => {
				const f = e.target.files && e.target.files[0];
				if (!f) return;
				f.text().then((t) => {
					try {
						const d = JSON.parse(t);
						marks = { st: {}, seg: {} };
						(d.stationsVisited || Object.keys(d.st || {})).forEach((id) => (marks.st[id] = 1));
						(d.segmentsRidden || Object.keys(d.seg || {})).forEach((kk) => (marks.seg[kk] = 1));
						save();
						renderAllMarks();
						setMsg('Imported.');
					} catch (err) { setMsg('Could not read that file.'); }
				});
				e.target.value = '';
			});

			// ---- go ----
			applyPan();
			drawGeometry();
			renderAllMarks();
		</script>
	</body>
</html>
