---
// Interactive MTA subway log. Network geometry, stations and per-service track
// segments are generated from the official MTA schematic diagram — see
// src/scripts/subway-data.js. Rendering and interaction are handled client-side.
//
// Rendering note: the viewport <g> is only ever TRANSLATED (never scaled), and
// geometry is drawn at data*k plus a fixed-pixel parallel offset. That keeps every
// stroke, pill and label a constant on-screen size at any zoom while positions
// scale. Each service is its own parallel line and toggles independently.
import { Font } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';

// Static. The header's owner-only "Log in" button is hidden client-side now
// (see SiteHeader.astro), so this page prerenders to one CDN-served file with no
// function invocation. The map itself was always drawn client-side.
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Subway Map</title>
		<Font cssVariable="--font-newsreader" preload />
		<Font cssVariable="--font-archivo" preload />
	</head>
	<body>
		<section class="sm">
			<SiteHeader pathname={Astro.url.pathname} theme="subway" />

			<div class="sm-body">
				<div class="sm-mapwrap">
					<svg id="sm-svg" preserveAspectRatio="xMidYMid meet">
						<rect id="sm-bg" x="0" y="0" fill="#eef1ee"></rect>
						<g id="sm-vp">
							<g id="sm-lines"></g>
							<g id="sm-hit"></g>
							<g id="sm-pills"></g>
							<g id="sm-labels"></g>
						</g>
					</svg>

					<div id="sm-tip" class="sm-tip" hidden></div>

					<div id="sm-geo" hidden></div>

					<div class="sm-controls">
						<div class="sm-view">
							<button id="sm-view-diagram" aria-pressed="true">Diagram</button>
							<button id="sm-view-map" aria-pressed="false">Map</button>
						</div>
						<div class="sm-zoom">
							<button id="sm-zin" title="Zoom in">+</button>
							<button id="sm-zout" title="Zoom out">&minus;</button>
							<button id="sm-reset" title="Reset view">&#8634;</button>
						</div>
						<div id="sm-msg" class="sm-msg" hidden></div>
					</div>

					<div class="sm-hint">
						Scroll to zoom &middot; drag to pan &middot; zoom in for station names &middot; click a
						line to mark it ridden &middot; click a station to mark it visited
					</div>
				</div>

				<aside class="sm-side">
					<div>
						<div class="sm-title">Subway log</div>
						<div id="sm-tot-st" class="sm-tot-st">Loading network…</div>
						<div id="sm-tot-sg" class="sm-tot-sg"></div>
						<div id="sm-tot-pct" class="sm-tot-pct"></div>
					</div>
					<div class="sm-rule"></div>
					<div id="sm-rows" class="sm-rows"></div>
					<div class="sm-rule"></div>
					<div class="sm-io">
						<button id="sm-export">Export JSON</button>
						<label>
							Import JSON
							<input id="sm-import" type="file" accept=".json,application/json" hidden />
						</label>
					</div>
					<p class="sm-note">
						Every service is its own line. The A, C and E each run their own track down 8 Av. You can
						log them independently. Click a line to mark it ridden. Click a station to mark it
						visited. Export to back up.
					</p>
				</aside>
			</div>
		</section>

		<style is:global>
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				height: 100%;
			}
			body {
				background: #1c0d0e;
				font-family: var(--font-archivo);
				-webkit-font-smoothing: antialiased;
			}
			.sm {
				min-height: 100vh;
				background: #2a1214;
				display: flex;
				flex-direction: column;
			}
			.sm-body {
				display: flex;
				flex: 1;
				height: calc(100vh - 62px);
				min-height: 520px;
			}
			.sm-mapwrap {
				flex: 1;
				min-width: 0;
				position: relative;
				background: #eef1ee;
			}
			#sm-svg {
				width: 100%;
				height: 100%;
				display: block;
				cursor: grab;
				touch-action: none;
			}
			#sm-svg.dragging {
				cursor: grabbing;
			}
			.sm-controls {
				position: absolute;
				top: 14px;
				left: 14px;
				display: flex;
				flex-direction: column;
				gap: 8px;
				align-items: flex-start;
			}
			.sm-zoom {
				display: flex;
				gap: 6px;
			}
			#sm-geo {
				position: absolute;
				inset: 0;
				background: #1a1c1e;
			}
			/* the map is dark; so are its zoom buttons */
			#sm-geo .maplibregl-ctrl-group {
				background: #20100f;
			}
			#sm-geo .maplibregl-ctrl-group button + button {
				border-top-color: #3a2a28;
			}
			#sm-geo .maplibregl-ctrl-icon {
				filter: invert(1);
			}
			.sm-view {
				display: flex;
			}
			.sm-view button {
				border: none;
				background: #20100f;
				color: #a2857a;
				font: 600 12px Archivo, Arial, sans-serif;
				padding: 9px 12px;
				cursor: pointer;
			}
			.sm-view button:first-child {
				border-radius: 8px 0 0 8px;
			}
			.sm-view button:last-child {
				border-radius: 0 8px 8px 0;
			}
			.sm-view button[aria-pressed='true'] {
				color: #f4e8d1;
				background: #3a1d1f;
			}
			.sm-zoom button {
				width: 34px;
				height: 34px;
				border: none;
				border-radius: 8px;
				background: #20100f;
				color: #f4e8d1;
				font-size: 18px;
				cursor: pointer;
			}
			.sm-zoom button:hover {
				background: #3a1d1f;
			}
			.sm-msg {
				background: #20100f;
				color: #f4e8d1;
				font: 500 12px Archivo, Arial, sans-serif;
				padding: 8px 12px;
				border-radius: 8px;
				max-width: 240px;
			}
			.sm-hint {
				position: absolute;
				bottom: 12px;
				left: 14px;
				right: 14px;
				font: 500 11px Archivo, Arial, sans-serif;
				color: #6b7370;
				pointer-events: none;
			}
			.sm-side {
				width: 306px;
				flex: none;
				background: #20100f;
				border-left: 1px solid #4a2529;
				padding: 24px 20px;
				overflow-y: auto;
				display: flex;
				flex-direction: column;
				gap: 18px;
			}
			.sm-title {
				font-family: var(--font-newsreader);
				font-size: 24px;
				font-weight: 500;
				color: #f4e8d1;
				line-height: 1.1;
			}
			.sm-tot-st {
				margin-top: 10px;
				font-size: 13px;
				color: #d9b45a;
				font-weight: 600;
			}
			.sm-tot-sg {
				margin-top: 3px;
				font-size: 13px;
				color: #ddc9b4;
			}
			.sm-tot-pct {
				margin-top: 3px;
				font-size: 12px;
				color: #a2857a;
			}
			.sm-rule {
				height: 1px;
				background: #4a2529;
			}
			.sm-rows {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 12px 16px;
			}
			.sm-row {
				display: grid;
				grid-template-columns: 26px 1fr;
				align-items: center;
				gap: 9px;
			}
			.sm-bullet {
				width: 26px;
				height: 26px;
				border-radius: 50%;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				font: 700 13px Archivo, Arial, sans-serif;
			}
			.sm-bullet.sir {
				font-size: 9px;
				letter-spacing: 0.2px;
			}
			.sm-tip {
				position: absolute;
				pointer-events: none;
				display: flex;
				align-items: center;
				gap: 8px;
				background: #20100f;
				color: #f4e8d1;
				font: 500 12px Archivo, Arial, sans-serif;
				padding: 5px 10px 5px 5px;
				border-radius: 18px;
				white-space: nowrap;
			}
			.sm-tip[hidden] {
				display: none;
			}
			.sm-rowinfo {
				min-width: 0;
			}
			.sm-rowpct {
				font: 600 12px Archivo, Arial, sans-serif;
				color: #f4e8d1;
			}
			.sm-bar {
				height: 4px;
				background: #3a1d1f;
				border-radius: 2px;
				overflow: hidden;
				margin-top: 3px;
			}
			.sm-bar > div {
				height: 100%;
				border-radius: 2px;
			}
			.sm-io {
				display: flex;
				gap: 8px;
			}
			.sm-io button,
			.sm-io label {
				flex: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				border: 1px solid #6b3a3f;
				border-radius: 8px;
				background: transparent;
				color: #f4e8d1;
				font: 600 12px Archivo, Arial, sans-serif;
				padding: 9px 0;
				cursor: pointer;
			}
			.sm-io button:hover,
			.sm-io label:hover {
				border-color: #d9b45a;
			}
			.sm-note {
				margin: 0;
				font: 400 11px Archivo, Arial, sans-serif;
				color: #a2857a;
				line-height: 1.5;
			}
			@media (max-width: 760px) {
				.sm-body {
					flex-direction: column;
					height: auto;
				}
				.sm-mapwrap {
					height: 70vh;
				}
				.sm-side {
					width: 100%;
					border-left: none;
					border-top: 1px solid #4a2529;
				}
			}
		</style>

		<script>
			import { CANVAS, SERVICES, STATIONS, SEGMENTS } from '../scripts/subway-data.js';
			import { LINES } from '../scripts/subway-diagram.js';
			import { MILES } from '../scripts/subway-miles.js';
			import type { SubwaySegment, SubwayStation } from '../scripts/subway-data.js';
			import { loadMarks, saveMark, saveAll, type Marks } from '../scripts/subway-marks';


			const SVGNS = 'http://www.w3.org/2000/svg';

			const W = CANVAS.W, H = CANVAS.H;

			// Fixed on-screen sizes (viewBox units ≈ constant screen px since the group
			// only translates). Parallel service lines are SPACING apart.
			const SPACING = 4.8;

			const LINE_W = 3.0, LINE_W_ON = 3.9, HIT_W = 5.2;

			const PILL_TH = 5.4, PILL_PAD = 3.6, PILL_BORDER = 1.4;

			const TINT = 0.32; // faded amount for unridden track

			const LABEL_FONT = 11, LABEL_ZOOM = 2.0;

			// Below this zoom, lines/pills hold a fixed on-screen size; beyond it they
			// scale with zoom so parallel lines fan apart and are easier to click.
			const SIZE_K0 = 4;

			const sizeScaleFor = (z: number) => (z <= SIZE_K0 ? 1 : z / SIZE_K0);

			let curScale = 1;

			// The markup below always provides these, so the lookups are asserted rather
			// than guarded — a missing node is a broken page, not a case to handle.
			const svg = document.getElementById('sm-svg')!;

			svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);

			const bg = document.getElementById('sm-bg')!;

			bg.setAttribute('width', String(W));

 bg.setAttribute('height', String(H));

			const vp = document.getElementById('sm-vp')!;

			const gLines = document.getElementById('sm-lines')!;

			const gHit = document.getElementById('sm-hit')!;

			const gPills = document.getElementById('sm-pills')!;

			const gLabels = document.getElementById('sm-labels')!;

			const msgEl = document.getElementById('sm-msg')!;

			const stById: Record<number, SubwayStation> = {};

			STATIONS.forEach((s) => (stById[s.id] = s));

			// ---- state ----
			// Blank until loadMarks answers: the owner's saved log, or nothing for a visitor.
			let marks: Marks = { st: {}, seg: {} };

			let k = 1, tx = 0, ty = 0, showLabels = false;

			// ---- helpers ----
			function el(name: string, attrs: Record<string, string | number>): SVGElement {
				// SAFETY: created in the SVG namespace, so it is always an SVGElement.
				const e = document.createElementNS(SVGNS, name) as SVGElement;

				for (const kk in attrs) e.setAttribute(kk, String(attrs[kk]));

				return e;
			}

			function mix(hex: string, t: number) {
				const b = [0xee, 0xf1, 0xee];
				let c = '#';

				for (let j = 0; j < 3; j++) {
					const v = Math.round(parseInt(hex.slice(1 + j * 2, 3 + j * 2), 16) * t + b[j] * (1 - t));
					c += v.toString(16).padStart(2, '0');
				}

				return c;
			}

			function textOn(hex: string) {
				const r = parseInt(hex.slice(1, 3), 16), g = parseInt(hex.slice(3, 5), 16), b = parseInt(hex.slice(5, 7), 16);

				return 0.299 * r + 0.587 * g + 0.114 * b > 150 ? '#141414' : '#ffffff';
			}

			// A failed save keeps the mark on screen and says so, rather than silently losing it.
			function saved(p: Promise<unknown>) { p.catch(() => setMsg('Not saved. Check your connection and reload.')); }

			function setMsg(t: string) { if (t) { msgEl.textContent = t; msgEl.hidden = false; } else msgEl.hidden = true; }

			// ---- per-station markers + label priority ----
			// Group the lines meeting a station into 45° direction buckets and give each
			// bucket its own pill. A simple stop has one; a big crossing complex like
			// Atlantic Av-Barclays Ctr gets a long diagonal pill for the 2/3/4/5/Q/B plus
			// a shorter one across the R/N/D — matching how the diagram bends the marker.
			const stDirs: Record<number, Record<string, Set<string>>> = {}; // id -> { bucketAngle -> Set(svc) }

			const prio: Record<number, number> = {};

			function addDir(id: number, dx: number, dy: number, svc: string) {
				const l = Math.hypot(dx, dy) || 1;
				let ang = (Math.atan2(dy / l, dx / l) * 180) / Math.PI;
				ang = ((ang % 180) + 180) % 180; // a line's direction is unsigned
				const b = (Math.round(ang / 45) * 45) % 180; // snap to 0/45/90/135
				const m = stDirs[id] || (stDirs[id] = {});
				(m[b] = m[b] || new Set()).add(svc);
				prio[id] = (prio[id] || 0) + 1;
			}

			SEGMENTS.forEach((sg) => {
				const P = sg.pts, L = P.length;
				addDir(sg.a, P[1][0] - P[0][0], P[1][1] - P[0][1], sg.svc);
				addDir(sg.b, P[L - 2][0] - P[L - 1][0], P[L - 2][1] - P[L - 1][1], sg.svc);
			});

			// Pill length tracks how many lines run through the station — the number of
			// services stopping there — so mega-transfers (Fulton St) and express stops
			// (Queens Blvd) read larger. Centred on the station.
			/** One rounded bar drawn across a bundle of lines: its angle and length. */
			type Pill = { deg: number; len: number };

			const stMeta: Record<number, { pills: Pill[]; prio: number }> = {};

			STATIONS.forEach((s) => {
				const buckets = stDirs[s.id] || {};

				const pills: Pill[] = Object.keys(buckets).map((b) => ({
					deg: (Number(b) + 90) % 180, // the pill lies across its lines
					len: (buckets[b].size - 1) * SPACING + LINE_W_ON + PILL_PAD,
				}));

				if (!pills.length) pills.push({ deg: 90, len: LINE_W_ON + PILL_PAD });
				stMeta[s.id] = { pills, prio: prio[s.id] || 0 };
			});

			const stationsByPrio = [...STATIONS].sort((a, b) => stMeta[b.id].prio - stMeta[a.id].prio);

			// ---- build lines (visible + hit) ----
			/** The drawn form of one segment. */
			type SegEl = { sg: SubwaySegment; vis: SVGElement; hit: SVGElement };

			const segEls: Record<string, SegEl> = {};

			SEGMENTS.forEach((sg) => {
				const vis = el('path', {
					stroke: mix(sg.color, TINT), 'stroke-width': LINE_W, fill: 'none',
					'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'pointer-events': 'none',
				});

				gLines.appendChild(vis);

				const hit = el('path', {
					stroke: 'rgba(0,0,0,0)', 'stroke-width': HIT_W, fill: 'none',
					'stroke-linecap': 'round', style: 'cursor:pointer;',
				});

				hit.addEventListener('click', () => toggleSeg(sg.id));
				hit.addEventListener('pointermove', (e) => showTip(sg, e));
				hit.addEventListener('pointerleave', hideTip);
				gHit.appendChild(hit);
				segEls[sg.id] = { sg, vis, hit };
			});

			// ---- build station pills + labels ----
			const pillEls: Record<number, { s: SubwayStation; rects: { rect: SVGElement; title: SVGElement; p: Pill }[] }> = {};

			const labelEls: Record<number, { s: SubwayStation; label: SVGElement; right: boolean; w: number }> = {};

			STATIONS.forEach((s) => {
				const rects = stMeta[s.id].pills.map((p) => {
					const rect = el('rect', {
						x: (-p.len / 2).toFixed(2), y: (-PILL_TH / 2).toFixed(2),
						width: p.len.toFixed(2), height: PILL_TH, rx: (PILL_TH / 2).toFixed(2),
						'stroke-width': PILL_BORDER, 'vector-effect': 'non-scaling-stroke', style: 'cursor:pointer;',
					});

					const title = el('title', {});
					rect.appendChild(title);
					rect.addEventListener('click', () => stationClick(s.id));
					gPills.appendChild(rect);

					return { rect, title, p };
				});

				pillEls[s.id] = { s, rects };

				const right = s.x >= W / 2;

				const label = el('text', {
					'text-anchor': right ? 'start' : 'end',
					style: 'font:600 ' + LABEL_FONT + 'px Archivo,Arial,sans-serif; fill:#2a2620; paint-order:stroke; stroke:#eef1ee; stroke-width:3px; pointer-events:none;',
				});

				label.textContent = s.name;
				label.style.display = 'none';
				gLabels.appendChild(label);
				labelEls[s.id] = { s, label, right, w: s.name.length * LABEL_FONT * 0.54 };
			});

			// A polyline scaled by k, each point moved slot·sp px to the right of the
			// direction of travel (y points down), with mitred corners.
			function offsetPath(c: [number, number, number][], sp: number) {
				const right = (i: number) => {
					const dx = c[i + 1][0] - c[i][0], dy = c[i + 1][1] - c[i][1], l = Math.hypot(dx, dy);

					return l ? [-dy / l, dx / l] : null;
				};

				let d = '';

				for (let i = 0; i < c.length; i++) {
					const n0 = i > 0 ? right(i - 1) : null, n1 = i < c.length - 1 ? right(i) : null;
					const a = n0 ?? n1 ?? [0, 0], b = n1 ?? a;
					const mx = a[0] + b[0], my = a[1] + b[1], ml = Math.hypot(mx, my) || 1;
					// mitre: stretch the bisector so both offset edges keep their distance (capped at sharp turns)
					const s = (c[i][2] * sp) / Math.max(0.3, (mx * b[0] + my * b[1]) / ml);
					d += (i ? ' L ' : 'M ') + (c[i][0] * k + (s * mx) / ml).toFixed(1) + ' ' + (c[i][1] * k + (s * my) / ml).toFixed(1);
				}

				return d;
			}

			// ---- geometry (depends on zoom k). Positions scale; sizes/offsets fixed. ----
			function drawGeometry() {
				curScale = sizeScaleFor(k);
				const sp = SPACING * curScale;
				const hw = (HIT_W * curScale).toFixed(2);

				// Each line carries its slot per point (see scripts/generate-subway-diagram.mjs).
				for (const id in segEls) {
					const e = segEls[id], sg = e.sg, d = offsetPath(LINES[id], sp);

					e.vis.setAttribute('d', d);
					e.vis.setAttribute('stroke-width', ((marks.seg[sg.id] ? LINE_W_ON : LINE_W) * curScale).toFixed(2));
					e.hit.setAttribute('d', d);
					e.hit.setAttribute('stroke-width', hw);
				}

				STATIONS.forEach((s) => {
					const cx = (s.x * k).toFixed(1), cy = (s.y * k).toFixed(1), sf = curScale.toFixed(3);
					pillEls[s.id].rects.forEach((r) =>
						r.rect.setAttribute('transform', 'translate(' + cx + ' ' + cy + ') rotate(' + r.p.deg + ') scale(' + sf + ')')
					);
				});
				drawLabels();
			}

			function drawLabels() {
				if (!showLabels) { STATIONS.forEach((s) => (labelEls[s.id].label.style.display = 'none'));

 return; }

				const placed: number[][] = [];

				for (const s of stationsByPrio) {
					const e = labelEls[s.id], px = s.x * k, py = s.y * k;
					const bx = e.right ? px + 8 : px - 8 - e.w;
					const by = py - LABEL_FONT * 0.55;
					const box = [bx, by, bx + e.w, by + LABEL_FONT * 1.1];
					let clash = false;

					for (let i = 0; i < placed.length; i++) {
						const p = placed[i];

						if (box[0] < p[2] && box[2] > p[0] && box[1] < p[3] && box[3] > p[1]) { clash = true; break; }
					}

					if (clash) { e.label.style.display = 'none'; }
					else {
						placed.push(box);
						e.label.style.display = '';
						e.label.setAttribute('x', (e.right ? px + 8 : px - 8).toFixed(1));
						e.label.setAttribute('y', (py + LABEL_FONT * 0.34).toFixed(1));
					}
				}
			}

			// ---- state → styling (independent of zoom) ----
			function renderSegMark(sg: SubwaySegment) {
				const e = segEls[sg.id], on = !!marks.seg[sg.id];
				e.vis.setAttribute('stroke', on ? sg.color : mix(sg.color, TINT));
				e.vis.setAttribute('stroke-width', ((on ? LINE_W_ON : LINE_W) * curScale).toFixed(2));
			}

			function renderPillMark(s: SubwayStation) {
				const on = !!marks.st[s.id];
				const label = s.name + ' (' + s.svcs.join(' ') + ')' + (on ? ' — visited' : '');
				pillEls[s.id].rects.forEach((r) => {
					r.rect.setAttribute('fill', on ? '#26231f' : '#ffffff');
					r.rect.setAttribute('stroke', on ? '#26231f' : '#7a7264');
					r.title.textContent = label;
				});
			}

			function renderAllMarks() {
				SEGMENTS.forEach(renderSegMark);
				STATIONS.forEach(renderPillMark);
				renderSidebar();
			}

			function makeBullet(svc: string, color: string) {
				const b = document.createElement('span');
				b.className = 'sm-bullet' + (svc.length > 1 ? ' sir' : '');
				b.style.background = color;
				b.style.color = textOn(color);
				b.textContent = svc;

				return b;
			}

			// ---- hover tooltip: the line's bullet beside the cursor ----
			const tipEl = document.getElementById('sm-tip')!;

			function showTip(sg: SubwaySegment, e: PointerEvent) {
				if (drag) return hideTip();
				const text = stById[sg.a].name + ' ↔ ' + stById[sg.b].name + (marks.seg[sg.id] ? ' · ridden' : '');
				tipEl.replaceChildren(makeBullet(sg.svc, sg.color), text);
				const r = svg.getBoundingClientRect();
				tipEl.style.left = e.clientX - r.left + 14 + 'px';
				tipEl.style.top = e.clientY - r.top + 14 + 'px';
				tipEl.hidden = false;
			}

			function hideTip() { tipEl.hidden = true; }

			// ---- sidebar ----
			const rowEls: Record<string, { pct: HTMLElement; bar: HTMLElement }> = {};

			const rowsWrap = document.getElementById('sm-rows')!;

			SERVICES.forEach((sv) => {
				const row = document.createElement('div');
				row.className = 'sm-row';
				const bullet = makeBullet(sv.svc, sv.color);
				const info = document.createElement('div');
				info.className = 'sm-rowinfo';
				const pct = document.createElement('div');
				pct.className = 'sm-rowpct';
				const bar = document.createElement('div');
				bar.className = 'sm-bar';
				const barIn = document.createElement('div');
				barIn.style.background = sv.color;
				bar.appendChild(barIn);
				info.appendChild(pct);
				info.appendChild(bar);
				row.appendChild(bullet);
				row.appendChild(info);
				rowsWrap.appendChild(row);
				rowEls[sv.svc] = { pct, bar: barIn };
			});

			function renderSidebar() {
				// Counted in miles of real track, so a long express hop outweighs a short local one.
				const per: Record<string, { t: number; r: number }> = {};
				SERVICES.forEach((sv) => (per[sv.svc] = { t: 0, r: 0 }));
				let total = 0, ridden = 0;
				SEGMENTS.forEach((sg) => {
					const mi = MILES[sg.id] ?? 0, p = per[sg.svc];
					p.t += mi; total += mi;

					if (marks.seg[sg.id]) { p.r += mi; ridden += mi; }
				});
				SERVICES.forEach((sv) => {
					const p = per[sv.svc], pct = p.t ? Math.round((100 * p.r) / p.t) : 0;
					rowEls[sv.svc].pct.textContent = pct + '%';
					rowEls[sv.svc].bar.style.width = pct + '%';
				});
				const visited = STATIONS.filter((s) => marks.st[s.id]).length;
				document.getElementById('sm-tot-st')!.textContent = visited + ' / ' + STATIONS.length + ' stations visited';
				document.getElementById('sm-tot-sg')!.textContent = ridden.toFixed(1) + ' / ' + Math.round(total) + ' miles ridden';
				document.getElementById('sm-tot-pct')!.textContent = Math.round((100 * ridden) / total) + '% of the system ridden';
				geo?.show(marks);
			}

			// ---- marking ----
			function toggleSeg(id: string) {
				if (!dragMoved) markSeg(id);
			}

			function stationClick(id: number) {
				if (!dragMoved) markSt(id);
			}

			function markSeg(id: string) {
				if (marks.seg[id]) delete marks.seg[id]; else marks.seg[id] = 1;
				saved(saveMark('segment', id, !!marks.seg[id]));
				renderSegMark(segEls[id].sg);
				renderSidebar();
			}

			function markSt(id: number) {
				if (marks.st[id]) delete marks.st[id]; else marks.st[id] = 1;
				saved(saveMark('station', String(id), !!marks.st[id]));
				renderPillMark(stById[id]);
				renderSidebar();
			}

			// ---- pan / zoom ----
			function applyPan() { vp.setAttribute('transform', 'translate(' + tx.toFixed(2) + ' ' + ty.toFixed(2) + ')'); }

			function clampPan() {
				tx = Math.min(W * 0.4, Math.max(W * (1 - k) - W * 0.4, tx));
				ty = Math.min(H * 0.4, Math.max(H * (1 - k) - H * 0.4, ty));
			}

			function metrics() {
				const r = svg.getBoundingClientRect();
				const s = Math.min(r.width / W, r.height / H);

				return { r, s, ox: (r.width - W * s) / 2, oy: (r.height - H * s) / 2 };
			}

			function labelCheck() {
				const show = k >= LABEL_ZOOM;

				if (show !== showLabels) showLabels = show;
			}

			let rafPending = false;

			function scheduleDraw() {
				if (rafPending) return;
				rafPending = true;
				requestAnimationFrame(() => { rafPending = false; drawGeometry(); });
			}

			function zoomAt(qx: number, qy: number, factor: number) {
				const k2 = Math.max(1, Math.min(22, k * factor));
				tx = qx - (qx - tx) * (k2 / k);
				ty = qy - (qy - ty) * (k2 / k);
				k = k2;
				clampPan(); applyPan(); labelCheck(); scheduleDraw();
			}

			svg.addEventListener('wheel', (e) => {
				e.preventDefault();
				const m = metrics();
				const qx = (e.clientX - m.r.left - m.ox) / m.s;
				const qy = (e.clientY - m.r.top - m.oy) / m.s;
				zoomAt(qx, qy, Math.exp(-e.deltaY * 0.0015));
			}, { passive: false });

			let drag: { x: number; y: number } | null = null, dragMoved = false;

			svg.addEventListener('pointerdown', (e) => {
				if (e.button !== 0) return;
				drag = { x: e.clientX, y: e.clientY };
				dragMoved = false;
				svg.classList.add('dragging');
			});

			svg.addEventListener('pointermove', (e) => {
				if (!drag) return;
				const dx = e.clientX - drag.x, dy = e.clientY - drag.y;

				if (Math.abs(dx) + Math.abs(dy) > 4) dragMoved = true;
				const m = metrics();
				tx += dx / m.s; ty += dy / m.s;
				drag = { x: e.clientX, y: e.clientY };
				clampPan(); applyPan();
			});

			function endDrag() { drag = null; svg.classList.remove('dragging'); }

			svg.addEventListener('pointerup', endDrag);

			svg.addEventListener('pointerleave', endDrag);

			document.getElementById('sm-zin')!.addEventListener('click', () => zoomAt(W / 2, H / 2, 1.5));

			document.getElementById('sm-zout')!.addEventListener('click', () => zoomAt(W / 2, H / 2, 1 / 1.5));

			document.getElementById('sm-reset')!.addEventListener('click', () => {
				k = 1; tx = 0; ty = 0; applyPan(); labelCheck(); drawGeometry();
			});

			// ---- export / import ----
			document.getElementById('sm-export')!.addEventListener('click', () => {
				const data = { format: 'mta-subway-log', version: 2, stationsVisited: Object.keys(marks.st), segmentsRidden: Object.keys(marks.seg) };
				const a = document.createElement('a');
				a.href = URL.createObjectURL(new Blob([JSON.stringify(data, null, 1)], { type: 'application/json' }));
				a.download = 'mta-subway-log.json';
				a.click();
			});

			document.getElementById('sm-import')!.addEventListener('change', (e) => {
				// SAFETY: this listener is on #sm-import, an <input type="file">.
				const input = e.target as HTMLInputElement;
				const f = input.files && input.files[0];

				if (!f) return;
				f.text().then((t) => {
					try {
						const d = JSON.parse(t);
						marks = { st: {}, seg: {} };
						(d.stationsVisited || Object.keys(d.st || {})).forEach((id: string) => (marks.st[id] = 1));
						(d.segmentsRidden || Object.keys(d.seg || {})).forEach((kk: string) => (marks.seg[kk] = 1));
						renderAllMarks();
						saveAll(marks).then(() => setMsg('Imported.'), () => setMsg('Imported, but not saved. Reload and try again.'));
					} catch (err) { setMsg('Could not read that file.'); }
				});
				input.value = '';
			});

			// ---- diagram / map view ----
			// The map view is the same network over real streets; MapLibre only loads
			// the first time it is opened.
			const VIEW_KEY = 'mta-subway-view';

			const geoEl = document.getElementById('sm-geo')!;

			const zoomEl = document.querySelector<HTMLElement>('.sm-zoom')!;

			const viewBtns = { diagram: document.getElementById('sm-view-diagram')!, map: document.getElementById('sm-view-map')! };

			let geo: { show: (m: Marks) => void; resize: () => void } | null = null;

			async function setView(v: 'diagram' | 'map') {
				const isMap = v === 'map';
				svg.style.display = isMap ? 'none' : '';
				zoomEl.style.display = isMap ? 'none' : '';
				geoEl.hidden = !isMap;
				viewBtns.diagram.setAttribute('aria-pressed', String(!isMap));
				viewBtns.map.setAttribute('aria-pressed', String(isMap));

				try { localStorage.setItem(VIEW_KEY, v); } catch (e) {}

				if (!isMap) return;

				if (geo) { geo.resize();

 return; }

				const { mountGeoMap } = await import('../scripts/subway-geo-map');
				geo = mountGeoMap(geoEl, import.meta.env.PUBLIC_MAPTILER_KEY ?? '', markSeg, markSt);
				geo.show(marks);
			}

			viewBtns.diagram.addEventListener('click', () => setView('diagram'));

			viewBtns.map.addEventListener('click', () => setView('map'));

			// ---- go ----
			applyPan();

			drawGeometry();

			renderAllMarks();

			loadMarks().then((m) => { marks = m; renderAllMarks(); }, () => setMsg('Could not load your log.'));

			try { if (localStorage.getItem(VIEW_KEY) === 'map') setView('map'); } catch (e) {}
		</script>
	</body>
</html>
