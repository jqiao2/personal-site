---
// Interactive MTA subway log. The network geometry, stations and per-line track
// segments are generated from the official MTA schematic diagram — see
// src/scripts/subway-data.js. Rendering and interaction are handled client-side.
const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/films', label: 'Films' },
	{ href: '/subway', label: 'Subway Map', active: true },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Subway Map</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<section class="sm">
			<nav class="sm-nav">
				{
					nav.map((n) => (
						<a href={n.href} class={n.active ? 'active' : ''}>
							{n.label}
						</a>
					))
				}
			</nav>

			<div class="sm-body">
				<div class="sm-mapwrap">
					<svg id="sm-svg" viewBox="0 0 1040 1102" preserveAspectRatio="xMidYMid meet">
						<rect x="0" y="0" width="1040" height="1102" fill="#eef1ee"></rect>
						<g id="sm-vp">
							<g id="sm-base"></g>
							<g id="sm-ridden"></g>
							<g id="sm-hit"></g>
							<g id="sm-dots"></g>
							<g id="sm-labels"></g>
						</g>
					</svg>

					<div class="sm-controls">
						<div class="sm-zoom">
							<button id="sm-zin" title="Zoom in">+</button>
							<button id="sm-zout" title="Zoom out">&minus;</button>
							<button id="sm-reset" title="Reset view">&#8634;</button>
						</div>
						<button id="sm-range" class="sm-rangebtn">Mark a range</button>
						<div id="sm-msg" class="sm-msg" hidden></div>
					</div>

					<div class="sm-hint">
						Scroll to zoom &middot; drag to pan &middot; zoom in for station names &middot; click
						track to mark it ridden, stations to mark visited
					</div>

					<div id="sm-choices" class="sm-choices" hidden>
						<div class="sm-choices-title">Which line did you ride?</div>
						<div id="sm-choices-list"></div>
						<button id="sm-cancel" class="sm-cancel">Cancel</button>
					</div>
				</div>

				<aside class="sm-side">
					<div>
						<div class="sm-title">Subway log</div>
						<div id="sm-tot-st" class="sm-tot-st">Loading network…</div>
						<div id="sm-tot-sg" class="sm-tot-sg"></div>
						<div id="sm-tot-pct" class="sm-tot-pct"></div>
					</div>
					<div class="sm-rule"></div>
					<div id="sm-rows" class="sm-rows"></div>
					<div class="sm-rule"></div>
					<div class="sm-io">
						<button id="sm-export">Export JSON</button>
						<label>
							Import JSON
							<input id="sm-import" type="file" accept=".json,application/json" hidden />
						</label>
					</div>
					<p class="sm-note">
						A graph of real MTA stations linked by per-line track segments, laid out from the
						official schematic diagram and saved in this browser. The transfer stations are larger
						circles. Export to back up or move devices.
					</p>
				</aside>
			</div>
		</section>

		<style>
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				height: 100%;
			}
			body {
				background: #1c0d0e;
				font-family: 'Archivo', 'Helvetica Neue', Helvetica, Arial, sans-serif;
				-webkit-font-smoothing: antialiased;
			}
			.sm {
				min-height: 100vh;
				background: #2a1214;
				display: flex;
				flex-direction: column;
			}
			.sm-nav {
				display: flex;
				align-items: stretch;
				gap: 2px;
				padding: 0 28px;
				background: #20100f;
				border-bottom: 1px solid #4a2529;
			}
			.sm-nav a {
				font-size: 13px;
				letter-spacing: 0.4px;
				color: #c2a99a;
				text-decoration: none;
				padding: 22px 16px 20px;
				border-bottom: 2px solid transparent;
			}
			.sm-nav a:hover {
				color: #f4e8d1;
			}
			.sm-nav a.active {
				color: #f4e8d1;
				font-weight: 600;
				border-bottom-color: #d9b45a;
			}
			.sm-body {
				display: flex;
				flex: 1;
				height: calc(100vh - 62px);
				min-height: 520px;
			}
			.sm-mapwrap {
				flex: 1;
				min-width: 0;
				position: relative;
				background: #eef1ee;
			}
			#sm-svg {
				width: 100%;
				height: 100%;
				display: block;
				cursor: grab;
				touch-action: none;
			}
			#sm-svg.dragging {
				cursor: grabbing;
			}
			.sm-controls {
				position: absolute;
				top: 14px;
				left: 14px;
				display: flex;
				flex-direction: column;
				gap: 8px;
				align-items: flex-start;
			}
			.sm-zoom {
				display: flex;
				gap: 6px;
			}
			.sm-zoom button {
				width: 34px;
				height: 34px;
				border: none;
				border-radius: 8px;
				background: #20100f;
				color: #f4e8d1;
				font-size: 18px;
				cursor: pointer;
			}
			.sm-zoom button:hover {
				background: #3a1d1f;
			}
			.sm-rangebtn {
				border: none;
				border-radius: 8px;
				background: #20100f;
				color: #f4e8d1;
				font: 600 12px Archivo, Arial, sans-serif;
				padding: 9px 14px;
				cursor: pointer;
			}
			.sm-rangebtn.on {
				background: #d9b45a;
				color: #2a1214;
			}
			.sm-msg {
				background: #20100f;
				color: #f4e8d1;
				font: 500 12px Archivo, Arial, sans-serif;
				padding: 8px 12px;
				border-radius: 8px;
				max-width: 240px;
			}
			.sm-hint {
				position: absolute;
				bottom: 12px;
				left: 14px;
				right: 14px;
				font: 500 11px Archivo, Arial, sans-serif;
				color: #6b7370;
				pointer-events: none;
			}
			.sm-choices {
				position: absolute;
				top: 70px;
				left: 50%;
				transform: translateX(-50%);
				background: #20100f;
				border: 1px solid #4a2529;
				border-radius: 12px;
				padding: 16px;
				display: flex;
				flex-direction: column;
				gap: 8px;
				min-width: 260px;
				box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
			}
			.sm-choices-title {
				font: 600 13px Archivo, Arial, sans-serif;
				color: #f4e8d1;
			}
			#sm-choices-list {
				display: flex;
				flex-direction: column;
				gap: 8px;
			}
			.sm-choice {
				display: flex;
				align-items: center;
				gap: 10px;
				border: 1px solid #4a2529;
				border-radius: 8px;
				background: #2a1214;
				padding: 8px 12px;
				cursor: pointer;
				text-align: left;
			}
			.sm-choice:hover {
				border-color: #d9b45a;
			}
			.sm-bullet {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-width: 22px;
				height: 22px;
				border-radius: 50%;
				color: #fff;
				font: 700 11px Archivo, Arial, sans-serif;
				padding: 0 4px;
			}
			.sm-choice span:last-child {
				font: 500 12px Archivo, Arial, sans-serif;
				color: #ddc9b4;
			}
			.sm-cancel {
				border: none;
				background: none;
				color: #a2857a;
				font: 500 12px Archivo, Arial, sans-serif;
				cursor: pointer;
				padding: 4px;
			}
			.sm-cancel:hover {
				color: #f4e8d1;
			}
			.sm-side {
				width: 300px;
				flex: none;
				background: #20100f;
				border-left: 1px solid #4a2529;
				padding: 24px 20px;
				overflow-y: auto;
				display: flex;
				flex-direction: column;
				gap: 18px;
			}
			.sm-title {
				font-family: 'Newsreader', serif;
				font-size: 24px;
				font-weight: 500;
				color: #f4e8d1;
				line-height: 1.1;
			}
			.sm-tot-st {
				margin-top: 10px;
				font-size: 13px;
				color: #d9b45a;
				font-weight: 600;
			}
			.sm-tot-sg {
				margin-top: 3px;
				font-size: 13px;
				color: #ddc9b4;
			}
			.sm-tot-pct {
				margin-top: 3px;
				font-size: 12px;
				color: #a2857a;
			}
			.sm-rule {
				height: 1px;
				background: #4a2529;
			}
			.sm-rows {
				display: flex;
				flex-direction: column;
				gap: 12px;
			}
			.sm-row {
				display: grid;
				grid-template-columns: 34px 1fr auto;
				align-items: center;
				gap: 10px;
			}
			.sm-row-name {
				font: 600 12px Archivo, Arial, sans-serif;
				color: #f4e8d1;
			}
			.sm-bar {
				height: 4px;
				background: #3a1d1f;
				border-radius: 2px;
				overflow: hidden;
				margin: 4px 0;
			}
			.sm-bar > div {
				height: 100%;
			}
			.sm-row-sub {
				font: 500 11px Archivo, Arial, sans-serif;
				color: #a2857a;
			}
			.sm-row-pct {
				font: 600 12px Archivo, Arial, sans-serif;
				color: #ddc9b4;
			}
			.sm-io {
				display: flex;
				gap: 8px;
			}
			.sm-io button,
			.sm-io label {
				flex: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				border: 1px solid #6b3a3f;
				border-radius: 8px;
				background: transparent;
				color: #f4e8d1;
				font: 600 12px Archivo, Arial, sans-serif;
				padding: 9px 0;
				cursor: pointer;
			}
			.sm-io button:hover,
			.sm-io label:hover {
				border-color: #d9b45a;
			}
			.sm-note {
				margin: 0;
				font: 400 11px Archivo, Arial, sans-serif;
				color: #a2857a;
				line-height: 1.5;
			}
			@media (max-width: 720px) {
				.sm-body {
					flex-direction: column;
					height: auto;
				}
				.sm-mapwrap {
					height: 70vh;
				}
				.sm-side {
					width: 100%;
					border-left: none;
					border-top: 1px solid #4a2529;
				}
			}
		</style>

		<script>
			import { CANVAS, GROUPS, LINES, STATIONS, SEGMENTS } from '../scripts/subway-data.js';

			const KEY = 'mta-subway-log-v1';
			const TINT = 0.28; // faded amount for unridden track
			const SVGNS = 'http://www.w3.org/2000/svg';

			const svg = document.getElementById('sm-svg');
			const vp = document.getElementById('sm-vp');
			const gBase = document.getElementById('sm-base');
			const gRidden = document.getElementById('sm-ridden');
			const gHit = document.getElementById('sm-hit');
			const gDots = document.getElementById('sm-dots');
			const gLabels = document.getElementById('sm-labels');
			const msgEl = document.getElementById('sm-msg');

			const W = CANVAS.W,
				H = CANVAS.H;
			const stById = {};
			STATIONS.forEach((s) => (stById[s.id] = s));
			const colorByKey = {};
			GROUPS.concat(LINES).forEach((g) => (colorByKey[g.key] = g.color));

			// Per-group station adjacency (for range marking).
			const adj = {};
			GROUPS.forEach((g) => (adj[g.key] = {}));
			SEGMENTS.forEach((sg) => {
				const a = adj[sg.key];
				(a[sg.a] = a[sg.a] || []).push(sg.b);
				(a[sg.b] = a[sg.b] || []).push(sg.a);
			});

			// ---- state ----
			let marks = { st: {}, seg: {} };
			try {
				const s = JSON.parse(localStorage.getItem(KEY));
				if (s && s.st && s.seg) marks = s;
			} catch (e) {}
			let rangeOn = false,
				rangeA = null;
			const v = { x: 0, y: 0, k: 1 };
			let showLabels = false;

			// ---- helpers ----
			function el(name, attrs) {
				const e = document.createElementNS(SVGNS, name);
				for (const k in attrs) e.setAttribute(k, attrs[k]);
				return e;
			}
			function mix(hex, t) {
				const b = [0xee, 0xf1, 0xee];
				let c = '#';
				for (let j = 0; j < 3; j++) {
					const val = Math.round(parseInt(hex.slice(1 + j * 2, 3 + j * 2), 16) * t + b[j] * (1 - t));
					c += val.toString(16).padStart(2, '0');
				}
				return c;
			}
			function ptsToD(pts) {
				return 'M ' + pts.map((p) => p[0] + ' ' + p[1]).join(' L ');
			}
			function save() {
				try {
					localStorage.setItem(KEY, JSON.stringify(marks));
				} catch (e) {}
			}
			function setMsg(t) {
				if (t) {
					msgEl.textContent = t;
					msgEl.hidden = false;
				} else {
					msgEl.hidden = true;
				}
			}

			// ---- build static SVG ----
			// base trunk lines (faded, non-interactive)
			LINES.forEach((ln) => {
				ln.paths.forEach((p) => {
					gBase.appendChild(
						el('path', {
							d: ptsToD(p),
							stroke: mix(ln.color, TINT),
							'stroke-width': 5,
							fill: 'none',
							'stroke-linecap': 'round',
							'stroke-linejoin': 'round',
							'pointer-events': 'none',
						})
					);
				});
			});

			// ridden overlay + invisible hit target, one per segment
			const segEls = {};
			SEGMENTS.forEach((sg) => {
				const d = ptsToD(sg.pts);
				const ridden = el('path', {
					d,
					stroke: sg.color,
					'stroke-width': 7,
					fill: 'none',
					'stroke-linecap': 'round',
					'stroke-linejoin': 'round',
					'pointer-events': 'none',
				});
				gRidden.appendChild(ridden);
				const hit = el('path', {
					d,
					stroke: 'rgba(0,0,0,0)',
					'stroke-width': 16,
					fill: 'none',
					style: 'cursor:pointer;',
				});
				const an = stById[sg.a].name,
					bn = stById[sg.b].name;
				const title = el('title', {});
				title.textContent = sg.key + ' · ' + an + ' ↔ ' + bn;
				hit.appendChild(title);
				hit.addEventListener('click', () => toggleSeg(sg.id));
				gHit.appendChild(hit);
				segEls[sg.id] = { ridden, title, an, bn, key: sg.key };
			});

			// station dots + labels
			const dotEls = {};
			const labelEls = {};
			STATIONS.forEach((s) => {
				const xfer = s.svcs.length >= 2;
				const dot = el('circle', {
					cx: s.x,
					cy: s.y,
					r: xfer ? 5.5 : 3.6,
					style: 'cursor:pointer;',
				});
				const title = el('title', {});
				dot.appendChild(title);
				dot.addEventListener('click', () => stationClick(s.id));
				gDots.appendChild(dot);
				dotEls[s.id] = { dot, title, xfer };

				const right = s.x >= W / 2;
				const label = el('text', {
					x: s.x + (right ? 8 : -8),
					y: s.y + 3,
					'text-anchor': right ? 'start' : 'end',
					style:
						'font:600 9px Archivo,Arial,sans-serif; fill:#403b33; paint-order:stroke; stroke:#eef1ee; stroke-width:2.5px; pointer-events:none;',
				});
				label.textContent = s.name;
				label.style.display = 'none';
				gLabels.appendChild(label);
				labelEls[s.id] = label;
			});

			// ---- render dynamic state ----
			function renderSegments() {
				SEGMENTS.forEach((sg) => {
					const on = !!marks.seg[sg.id];
					const e = segEls[sg.id];
					e.ridden.style.display = on ? '' : 'none';
					e.title.textContent =
						sg.key + ' · ' + e.an + ' ↔ ' + e.bn + (on ? ' — ridden' : '');
				});
			}
			function renderDots() {
				STATIONS.forEach((s) => {
					const on = !!marks.st[s.id];
					const isA = rangeA === s.id;
					const e = dotEls[s.id];
					e.dot.setAttribute('fill', on ? '#26231f' : '#ffffff');
					e.dot.setAttribute('stroke', isA ? '#d9b45a' : on ? '#26231f' : '#7a7264');
					e.dot.setAttribute('stroke-width', isA ? 3 : e.xfer ? 2 : 1.4);
					e.title.textContent =
						s.name + ' (' + s.svcs.join(' ') + ')' + (on ? ' — visited' : '');
				});
			}
			function renderSidebar() {
				const per = {};
				GROUPS.forEach((g) => (per[g.key] = { stT: 0, stV: 0, sgT: 0, sgR: 0 }));
				STATIONS.forEach((s) =>
					s.groups.forEach((k) => {
						if (!per[k]) return;
						per[k].stT++;
						if (marks.st[s.id]) per[k].stV++;
					})
				);
				SEGMENTS.forEach((sg) => {
					per[sg.key].sgT++;
					if (marks.seg[sg.id]) per[sg.key].sgR++;
				});
				GROUPS.forEach((g) => {
					const p = per[g.key];
					const pct = p.sgT ? Math.round((100 * p.sgR) / p.sgT) : 0;
					const r = rowEls[g.key];
					r.bar.style.width = pct + '%';
					r.bar.style.background = g.color;
					r.sub.textContent = 'stations ' + p.stV + '/' + p.stT + ' · track ' + p.sgR + '/' + p.sgT;
					r.pct.textContent = pct + '%';
				});
				const visited = STATIONS.filter((s) => marks.st[s.id]).length;
				const ridden = SEGMENTS.filter((sg) => marks.seg[sg.id]).length;
				document.getElementById('sm-tot-st').textContent =
					visited + ' / ' + STATIONS.length + ' stations visited';
				document.getElementById('sm-tot-sg').textContent =
					ridden + ' / ' + SEGMENTS.length + ' track segments ridden';
				document.getElementById('sm-tot-pct').textContent =
					Math.round((100 * ridden) / SEGMENTS.length) + '% of the system ridden';
			}
			function renderAll() {
				renderSegments();
				renderDots();
				renderSidebar();
			}

			// ---- build sidebar rows ----
			const rowsWrap = document.getElementById('sm-rows');
			const rowEls = {};
			GROUPS.forEach((g) => {
				const row = document.createElement('div');
				row.className = 'sm-row';
				const bullet = document.createElement('span');
				bullet.className = 'sm-bullet';
				bullet.style.background = g.color;
				bullet.textContent = g.key === 'SIR' ? 'SIR' : g.key === 'S' ? 'S' : g.label.replace(/ /g, '');
				if (bullet.textContent.length > 4) bullet.style.fontSize = '8px';
				const mid = document.createElement('div');
				const name = document.createElement('div');
				name.className = 'sm-row-name';
				name.textContent = g.label;
				const bar = document.createElement('div');
				bar.className = 'sm-bar';
				const barIn = document.createElement('div');
				bar.appendChild(barIn);
				const sub = document.createElement('div');
				sub.className = 'sm-row-sub';
				mid.appendChild(name);
				mid.appendChild(bar);
				mid.appendChild(sub);
				const pct = document.createElement('span');
				pct.className = 'sm-row-pct';
				row.appendChild(bullet);
				row.appendChild(mid);
				row.appendChild(pct);
				rowsWrap.appendChild(row);
				rowEls[g.key] = { bar: barIn, sub, pct };
			});

			// ---- interactions: marking ----
			function toggleSeg(id) {
				if (dragMoved) return;
				if (rangeOn) {
					setMsg('Range mode: click two stations (not track).');
					return;
				}
				if (marks.seg[id]) delete marks.seg[id];
				else marks.seg[id] = 1;
				save();
				renderSegments();
				renderSidebar();
			}
			function stationClick(id) {
				if (dragMoved) return;
				if (rangeOn) {
					rangePick(id);
					return;
				}
				if (marks.st[id]) delete marks.st[id];
				else marks.st[id] = 1;
				save();
				renderDots();
				renderSidebar();
			}

			// ---- range marking (BFS shortest path within a single line) ----
			function pathBetween(key, a, b) {
				const prev = { [a]: null };
				const q = [a];
				while (q.length) {
					const cur = q.shift();
					if (cur === b) break;
					(adj[key][cur] || []).forEach((n) => {
						if (!(n in prev)) {
							prev[n] = cur;
							q.push(n);
						}
					});
				}
				if (!(b in prev)) return null;
				const chain = [];
				for (let c = b; c != null; c = prev[c]) chain.push(c);
				return chain.reverse();
			}
			function toggleRange() {
				rangeOn = !rangeOn;
				rangeA = null;
				document.getElementById('sm-range').classList.toggle('on', rangeOn);
				document.getElementById('sm-range').textContent = rangeOn ? 'Cancel range' : 'Mark a range';
				hideChoices();
				setMsg(rangeOn ? 'Range: click the first station.' : '');
				renderDots();
			}
			function rangePick(id) {
				if (!rangeA) {
					rangeA = id;
					setMsg('Now click the last station of the ride.');
					renderDots();
					return;
				}
				if (rangeA === id) {
					rangeA = null;
					setMsg('');
					renderDots();
					return;
				}
				const a = rangeA,
					b = id;
				const opts = [];
				GROUPS.forEach((g) => {
					const chain = pathBetween(g.key, a, b);
					if (chain) opts.push({ key: g.key, color: g.color, label: g.label, chain });
				});
				if (!opts.length) {
					rangeA = null;
					setMsg('No single line connects those two stations.');
					renderDots();
					return;
				}
				if (opts.length === 1) {
					applyRange(opts[0]);
					return;
				}
				showChoices(opts);
			}
			function applyRange(opt) {
				for (let i = 0; i < opt.chain.length; i++) {
					marks.st[opt.chain[i]] = 1;
					if (i < opt.chain.length - 1) {
						const x = opt.chain[i],
							y = opt.chain[i + 1];
						marks.seg[opt.key + '|' + (x < y ? x + '|' + y : y + '|' + x)] = 1;
					}
				}
				save();
				rangeOn = false;
				rangeA = null;
				document.getElementById('sm-range').classList.remove('on');
				document.getElementById('sm-range').textContent = 'Mark a range';
				hideChoices();
				setMsg('Marked ' + opt.chain.length + ' stations on the ' + opt.label + '.');
				renderAll();
			}

			// ---- choices popup ----
			const choicesEl = document.getElementById('sm-choices');
			const choicesList = document.getElementById('sm-choices-list');
			function showChoices(opts) {
				choicesList.innerHTML = '';
				opts.forEach((o) => {
					const btn = document.createElement('button');
					btn.className = 'sm-choice';
					const bullet = document.createElement('span');
					bullet.className = 'sm-bullet';
					bullet.style.background = o.color;
					bullet.textContent = o.label.replace(/ /g, '');
					if (bullet.textContent.length > 4) bullet.style.fontSize = '8px';
					const txt = document.createElement('span');
					txt.textContent = o.label + ' — ' + (o.chain.length - 1) + ' stops';
					btn.appendChild(bullet);
					btn.appendChild(txt);
					btn.addEventListener('click', () => applyRange(o));
					choicesList.appendChild(btn);
				});
				choicesEl.hidden = false;
				setMsg('');
			}
			function hideChoices() {
				choicesEl.hidden = true;
			}
			document.getElementById('sm-cancel').addEventListener('click', () => {
				hideChoices();
				rangeOn = false;
				rangeA = null;
				document.getElementById('sm-range').classList.remove('on');
				document.getElementById('sm-range').textContent = 'Mark a range';
				setMsg('');
				renderDots();
			});
			document.getElementById('sm-range').addEventListener('click', toggleRange);

			// ---- pan / zoom ----
			function tf() {
				return 'translate(' + v.x + ' ' + v.y + ') scale(' + v.k + ')';
			}
			function apply() {
				vp.setAttribute('transform', tf());
			}
			function metrics() {
				const r = svg.getBoundingClientRect();
				const s = Math.min(r.width / W, r.height / H);
				return { r, s, ox: (r.width - W * s) / 2, oy: (r.height - H * s) / 2 };
			}
			function clampPan() {
				v.x = Math.min(W * 0.4, Math.max(W * (1 - v.k) - W * 0.4, v.x));
				v.y = Math.min(H * 0.4, Math.max(H * (1 - v.k) - H * 0.4, v.y));
			}
			function labelCheck() {
				const show = v.k >= 2.2;
				if (show !== showLabels) {
					showLabels = show;
					STATIONS.forEach((s) => (labelEls[s.id].style.display = show ? '' : 'none'));
				}
			}
			function zoomAt(qx, qy, f) {
				const k2 = Math.max(1, Math.min(18, v.k * f));
				f = k2 / v.k;
				v.x = qx - (qx - v.x) * f;
				v.y = qy - (qy - v.y) * f;
				v.k = k2;
				clampPan();
				apply();
				labelCheck();
			}
			svg.addEventListener(
				'wheel',
				(e) => {
					e.preventDefault();
					const m = metrics();
					const qx = (e.clientX - m.r.left - m.ox) / m.s;
					const qy = (e.clientY - m.r.top - m.oy) / m.s;
					zoomAt(qx, qy, Math.exp(-e.deltaY * 0.0015));
				},
				{ passive: false }
			);
			let drag = null,
				dragMoved = false;
			svg.addEventListener('pointerdown', (e) => {
				if (e.button !== 0) return;
				drag = { x: e.clientX, y: e.clientY };
				dragMoved = false;
				svg.classList.add('dragging');
			});
			svg.addEventListener('pointermove', (e) => {
				if (!drag) return;
				const dx = e.clientX - drag.x,
					dy = e.clientY - drag.y;
				if (Math.abs(dx) + Math.abs(dy) > 4) dragMoved = true;
				const m = metrics();
				v.x += dx / m.s;
				v.y += dy / m.s;
				drag = { x: e.clientX, y: e.clientY };
				clampPan();
				apply();
			});
			function endDrag() {
				drag = null;
				svg.classList.remove('dragging');
			}
			svg.addEventListener('pointerup', endDrag);
			svg.addEventListener('pointerleave', endDrag);
			document.getElementById('sm-zin').addEventListener('click', () => zoomAt(W / 2, H / 2, 1.5));
			document.getElementById('sm-zout').addEventListener('click', () => zoomAt(W / 2, H / 2, 1 / 1.5));
			document.getElementById('sm-reset').addEventListener('click', () => {
				v.x = 0;
				v.y = 0;
				v.k = 1;
				apply();
				labelCheck();
			});

			// ---- export / import ----
			document.getElementById('sm-export').addEventListener('click', () => {
				const data = {
					format: 'mta-subway-log',
					version: 1,
					stationsVisited: Object.keys(marks.st),
					segmentsRidden: Object.keys(marks.seg),
				};
				const a = document.createElement('a');
				a.href = URL.createObjectURL(new Blob([JSON.stringify(data, null, 1)], { type: 'application/json' }));
				a.download = 'mta-subway-log.json';
				a.click();
			});
			document.getElementById('sm-import').addEventListener('change', (e) => {
				const f = e.target.files && e.target.files[0];
				if (!f) return;
				f.text().then((t) => {
					try {
						const d = JSON.parse(t);
						marks = { st: {}, seg: {} };
						(d.stationsVisited || Object.keys(d.st || {})).forEach((id) => (marks.st[id] = 1));
						(d.segmentsRidden || Object.keys(d.seg || {})).forEach((k) => (marks.seg[k] = 1));
						save();
						renderAll();
						setMsg('Imported.');
					} catch (err) {
						setMsg('Could not read that file.');
					}
				});
				e.target.value = '';
			});

			// ---- go ----
			apply();
			renderAll();
		</script>
	</body>
</html>
