---
import BookLayout from '../../layouts/BookLayout.astro';
import BooksBody from '../../components/BooksBody.astro';
import SiteHeader from '../../components/SiteHeader.astro';

// Rendered on demand so the header reflects the live session. The reading record
// is a server island (BooksBody, server:defer) so the shell paints immediately
// and the data-heavy body streams in on its own request.
export const prerender = false;
---

<BookLayout title="Books">
	<div class="page">
		<SiteHeader pathname={Astro.url.pathname} theme="book" />

		<div class="wrap">
			<div class="col">
				<header class="head">
					<h1 class="head__title">Books</h1>
					<p class="head__note">Logged automatically via Kindle</p>
				</header>

				<BooksBody server:defer>
					<div slot="fallback" class="body-skel" aria-hidden="true">
						{Array.from({ length: 3 }).map(() => (
							<div class="skel-block">
								<div class="skel-line skel-line--head"></div>
								<div class="skel-card"></div>
							</div>
						))}
					</div>
				</BooksBody>
			</div>
		</div>
	</div>
</BookLayout>

<style>
	.page {
		min-height: 100vh;
		background: #1a120a;
	}

	.wrap {
		display: flex;
		justify-content: center;
		padding: 34px clamp(14px, 4vw, 24px) 90px;
	}
	.col {
		width: 100%;
		max-width: 960px;
	}

	/* Header */
	.head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 14px;
		flex-wrap: wrap;
		margin-bottom: 40px;
	}
	.head__title {
		font-family: 'Newsreader', serif;
		font-weight: 500;
		font-size: clamp(38px, 9vw, 52px);
		color: #f2e6cd;
		letter-spacing: -0.5px;
		line-height: 1;
		margin: 0;
	}
	.head__note {
		margin: 0;
		font-size: 12.5px;
		color: #8a745a;
		line-height: 1.5;
		max-width: 280px;
	}

	/* Skeleton shown while the BooksBody island streams in. */
	.body-skel {
		display: flex;
		flex-direction: column;
		gap: 46px;
	}
	.skel-line--head {
		height: 20px;
		width: 40%;
		border-radius: 3px;
		background: #392a19;
		margin-bottom: 20px;
		animation: skel-pulse 1.4s ease-in-out infinite;
	}
	.skel-card {
		height: 120px;
		border-radius: 10px;
		border: 1px solid #392a19;
		background: #241a10;
		animation: skel-pulse 1.4s ease-in-out infinite;
	}
	@keyframes skel-pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.5;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.skel-line--head,
		.skel-card {
			animation: none;
		}
	}
</style>
