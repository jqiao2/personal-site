---
import BookShelf from '../../components/BookShelf.astro';
import BookThumb from '../../components/BookThumb.astro';
import BookLayout from '../../layouts/BookLayout.astro';
import { requireOwner } from '../../lib/auth';
import {
	getCurrentlyReading,
	getFinished,
	getHeatmap,
	getManualReads,
	getOfflineReads,
	getSetAside,
	getStats,
	getToRead,
} from '../../lib/books-queries';
import { finishedShelf, shelfSpan, toReadShelf } from '../../lib/shelf-view';
import { buildPile } from '../../lib/to-read-view';
import {
	activityMeta,
	buildHeatmap,
	buildShelf,
	buildSpells,
	DOW_LABELS,
	formatDuration,
	formatNumber,
	HEAT_LEVELS,
	prefersHeatmap,
	readDays,
	READING_DAY_MIN_PAGES,
	today,
	type BookView,
} from '../../lib/books-view';
import { siteNav } from '../../lib/nav';

// Rendered on demand — reflects whatever the Kindle last pushed.
export const prerender = false;

const nav = siteNav(Astro.url.pathname);

const todayDay = today();

const isOwner = await requireOwner(Astro.cookies);

const [stats, currentRaw, asideRaw, finishedRaw, offlineRaw, manualRaw, pileRaw] = await Promise.all([
	getStats(),
	getCurrentlyReading(),
	getSetAside(),
	getFinished(),
	getOfflineReads(),
	getManualReads(),
	getToRead(isOwner),
]);

// One heatmap query covers both activity views: the spells need the days with
// reading on them, the calendar needs the same set plus a date spine it can
// derive itself. Empty history means nothing to ask for.
const heatmapDays = stats.first_day ? await getHeatmap(stats.first_day, todayDay) : [];

const days = readDays(heatmapDays);
const maxPages = Math.max(1, ...days.map((d) => d.pages));

const { current, setAside, finished } = buildShelf(
	currentRaw,
	asideRaw,
	finishedRaw,
	offlineRaw,
	manualRaw,
	todayDay,
);

// The pile as a shelf, newest addition at the left. Its own page holds the
// sortable, filterable version; this is the whole pile as an object, and running
// out of board is the honest way to show how far behind it is.
//
// An empty pile says so to me and says nothing at all to a visitor — a zero
// there would report a fact about my intentions rather than my reading.
const toRead = toReadShelf(buildPile(pileRaw, todayDay));
const pileLabel = `${pileRaw.length} book${pileRaw.length === 1 ? '' : 's'} →`;

// Which books a spell covers is answered from every public book, not just the
// ones in flight — a spell three years ago was spent on something long finished.
//
// Books with recorded sessions only: a spell is a run of days that were actually
// logged, and a book with no sessions behind it that merely overlaps those dates
// was not what those page turns were spent on.
const shelf = [...current, ...setAside, ...finished].filter((b) => b.tracked);
const spells = buildSpells(days, shelf, maxPages);
const heatmap = buildHeatmap(days, maxPages, todayDay);

// The data picks the instrument. A year of near-daily reading is what a calendar
// is for; a fortnight in April surrounded by nothing is not.
const defaultView = days.length && prefersHeatmap(days, todayDay) ? 'heatmap' : 'spells';
const autoNote =
	defaultView === 'heatmap' ? 'dense enough for a calendar' : 'shown as spells';

// Everything read, newest finish at the left. There is no year filter: scrolling
// back along the shelf is the time axis, and a row of year pills would only let
// you cut the one continuous thing into pieces.
const done = finishedShelf(finished);
const doneSpan = shelfSpan(finished);

const metrics = [
	{ value: formatNumber(stats.current_streak), label: 'Current streak' },
	{ value: formatNumber(stats.longest_streak), label: 'Longest streak' },
	{ value: formatNumber(stats.days_read), label: 'Days read' },
	{ value: formatNumber(stats.total_pages), label: 'Pages' },
	{ value: formatDuration(stats.total_seconds), label: 'Time read' },
];

// Every book here is a page of its own. The picture of it is the strongest tie
// between the two views, so it links as well as the title does — see BookThumb
// for why that link is hidden from the keyboard and the screen reader.
const bookHref = (b: BookView) => `/books/${b.id}`;

// A heatmap with no reading in it has no scale to place the legend against, so
// both the view toggle and the grid stay out of the way until there is something
// to show.
const hasActivity = days.length > 0;
---

<BookLayout title="Books">
	<div class="page">
		<div class="tabs-bar">
			<nav class="tabs">
				{nav.map((n) => (
					<a
						class:list={['tabs__link', n.active && 'tabs__link--active']}
						href={n.href}
						aria-current={n.active ? 'page' : undefined}
					>
						{n.label}
					</a>
				))}
			</nav>
		</div>

		<div class="wrap">
			<div class="col">
				<header class="head">
					<h1 class="head__title">Books</h1>
					<p class="head__note">Logged automatically via Kindle</p>
				</header>

				<div class="metrics">
					{
						metrics.map((m) => (
							<div class="metric">
								<div class="metric__value">{m.value}</div>
								<div class="metric__label">{m.label}</div>
							</div>
						))
					}
				</div>

				<section class="section">
					<div class="sec-head">
						<h2 class="sec-head__title">Currently reading</h2>
					</div>

					{
						current.length > 0 ? (
							<div class="stack">
								{current.map((b) => (
									<article class="book">
										<BookThumb book={b} href={bookHref(b)} />
										<div class="book__main">
											<h3 class="book__title">
												<a class="book__link" href={bookHref(b)}>{b.main}</a>
											</h3>
											{b.sub && <div class="book__sub">{b.sub}</div>}
											{b.author && <div class="book__author">{b.author}</div>}

											{/*
												A book nobody is counting gets the sentence instead of the
												bar. An empty track would read as a stalled book,
												which is the opposite of what is true.
											*/}
											{
												b.untrackedNote ? (
													<div class="untracked-note">{b.untrackedNote}</div>
												) : (
													<div class="progress">
														{b.progress !== null && (
															<div class="bar">
																<div
																	class="bar__fill"
																	style={`width:${Math.max(1.5, b.progress * 100)}%`}
																/>
															</div>
														)}
														<div class="progress__row">
															<span class="progress__pages">
																{b.pagesLabel}
																{b.progress !== null && <span class="dim"> pages</span>}
															</span>
															<span class="progress__pct">{b.percent ?? 'length unknown'}</span>
														</div>
													</div>
												)
											}
										</div>
										<dl class="facts">
											{b.facts.map((f) => (
												<div class="fact">
													<dt class="fact__k">{f.k}</dt>
													<dd class="fact__v">{f.v}</dd>
												</div>
											))}
										</dl>
									</article>
								))}
							</div>
						) : (
							<div class="empty">
								<div class="empty__line">
									{days.length ? 'Between books right now.' : 'No reading logged yet.'}
								</div>
								<div class="empty__sub">
									The next page turn on the Kindle starts a new entry here.
								</div>
							</div>
						)
					}

				</section>

				{
					setAside.length > 0 && (
						<section class="section">
							<div class="sec-head sec-head--tight">
								<h2 class="sec-head__title">Set aside</h2>
							</div>
							{setAside.map((b) => (
								<div class="row">
									<BookThumb book={b} href={bookHref(b)} />
									<div class="row__main">
										<div class="row__title">
											<a class="book__link" href={bookHref(b)}>{b.main}</a>
										</div>
										<div class="row__meta">{b.asideMeta}</div>
									</div>
									<div class="row__bar">
										<div class="bar bar--slim">
											{b.progress !== null && (
												<div
													class="bar__fill"
													style={`width:${Math.max(1.5, b.progress * 100)}%`}
												/>
											)}
										</div>
									</div>
									<span class="row__pct">{b.percent ?? '—'}</span>
								</div>
							))}
						</section>
					)
				}

				<section class="section">
					<div class="sec-head">
						<h2 class="sec-head__title">Reading activity</h2>
						{
							hasActivity && (
								<div class="sec-head__tools">
									<span class="sec-head__meta">
										{activityMeta(days)}
										<span class="auto-note" data-auto-note> · {autoNote}</span>
									</span>
									<a class="month-link" href="/books/month">
										Month in reading →
									</a>
									<div class="pills">
										<button
											type="button"
											class:list={['pill', 'pill--sm', defaultView === 'spells' && 'pill--on']}
											data-view="spells"
											title="Only the stretches with reading in them"
										>
											Spells
										</button>
										<button
											type="button"
											class:list={['pill', 'pill--sm', defaultView === 'heatmap' && 'pill--on']}
											data-view="heatmap"
											title="Calendar heatmap of the last 12 months"
										>
											Year
										</button>
									</div>
								</div>
							)
						}
					</div>

					{
						hasActivity ? (
							<Fragment>
								<div class="view" data-panel="spells" hidden={defaultView !== 'spells'}>
									{spells.map((row) =>
										row.kind === 'break' ? (
											<div class="gap">
												<span class="gap__rule" />
												<span class="gap__label">{row.label}</span>
												<span class="gap__rule" />
											</div>
										) : (
											<div class="spell">
												<div class="spell__head">
													<div class="spell__label">{row.label}</div>
													<div class="spell__meta">{row.meta}</div>
												</div>
												<div class="spell__cells">
													{row.cells.map((c) => (
														<div
															class:list={[
																'cell',
																'cell--lg',
																`cell--l${c.level}`,
																!c.read && 'cell--off',
															]}
															title={c.title}
														/>
													))}
												</div>
												<div class="spell__books">{row.books}</div>
											</div>
										),
									)}
								</div>

								<div class="view" data-panel="heatmap" hidden={defaultView !== 'heatmap'}>
									<div class="heat-scroll" data-heat-scroll>
										<div class="heat" data-heat>
											<div class="heat__months">
												{heatmap.columns.map((col) => (
													<div class="heat__month" data-heat-label>{col.month}</div>
												))}
											</div>
											<div class="heat__body">
												<div class="heat__dows">
													{DOW_LABELS.map((d) => (
														<div class="heat__dow">{d}</div>
													))}
												</div>
												<div class="heat__grid">
													{heatmap.columns.map((col) => (
														<div class="heat__col" data-heat-col>
															{col.cells.map((c) => (
																<div
																	class:list={[
																		'cell',
																		`cell--l${c.level}`,
																		!c.inRange && 'cell--void',
																		c.inRange && !c.read && 'cell--off',
																	]}
																	title={c.title}
																/>
															))}
														</div>
													))}
												</div>
											</div>
										</div>
									</div>
									<div class="legend">
										<span class="legend__label">Fewer pages</span>
										<div class="legend__steps">
											{HEAT_LEVELS.map((l) => (
												<div class:list={['cell', `cell--l${l}`, l === 0 && 'cell--off']} />
											))}
										</div>
										<span class="legend__label">More</span>
										<span class="legend__span">{heatmap.span}</span>
									</div>
								</div>
							</Fragment>
						) : (
							<p class="none">Nothing logged yet — the first sync fills this in.</p>
						)
					}
				</section>

				{/*
					The two shelves. They sit at the foot of the page because they are the
					long views: what is waiting and what is done, both of them whole rather
					than sampled, and both of them a picture of the library before they are
					a list of it. Everything a row used to spell out — the read time, the
					exact finish date — is on the book's own page, one click away, and in
					the spine's tooltip meanwhile.
				*/}
				{
					(toRead.length > 0 || isOwner) && (
						<section class="section">
							<div class="sec-head sec-head--shelf">
								<h2 class="sec-head__title">To read</h2>
								<a class="sec-head__link" href="/books/to-read">
									{toRead.length > 0 ? pileLabel : 'Nothing on the pile'}
								</a>
							</div>
							<BookShelf spines={toRead} emptyLine="Nothing on the pile." />
						</section>
					)
				}

				<section class="section">
					<div class="sec-head sec-head--shelf">
						<h2 class="sec-head__title">Finished</h2>
						{doneSpan && <span class="sec-head__meta">{doneSpan}</span>}
					</div>
					<BookShelf spines={done} emptyLine="Nothing finished yet." />
				</section>

				{/*
					The two things the shelves cannot say for themselves. Every list on
					this page is filtered to `is_public`, and every number at the top is
					not — reading_stats aggregates across the lot, because hiding a book
					should not silently break a two-hundred-day streak.

					The second is the minimum from migration 0027, which is the reason a
					day you know you opened a book on can be blank up there. Worth stating
					plainly: a number that quietly disagrees with the reader's memory is
					worse than one that explains itself.
				*/}
				<p class="foot">
					Some books are read privately. They are counted in the totals and streaks
					above but never listed. A book counts towards a day once more than{' '}
					{READING_DAY_MIN_PAGES} of its pages have been turned — opening one to
					check a reference is not a day's reading.
				</p>
			</div>
		</div>
	</div>

	<script>
		// The toggle switches between markup that is already on the page: the server
		// sends both activity views, so switching is instant and the page still
		// reads correctly with JavaScript off, showing whichever view fits the data.
		const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
		const viewButtons = document.querySelectorAll<HTMLButtonElement>('[data-view]');
		const autoNote = document.querySelector<HTMLElement>('[data-auto-note]');

		for (const button of viewButtons) {
			button.addEventListener('click', () => {
				const wanted = button.dataset.view;
				for (const panel of panels) panel.hidden = panel.dataset.panel !== wanted;
				for (const other of viewButtons) other.classList.toggle('pill--on', other === button);
				// The note explains an automatic choice. Once it's been overruled it
				// is describing something that is no longer on screen.
				autoNote?.remove();
			});
		}

		// Fitting the year calendar to its column.
		//
		// The squares are sized by CSS — they take whatever width the column
		// gives them. That alone would shrink them to a few pixels on a phone,
		// so below the width a full year needs, this crops weeks off the left
		// until the rest are legible again. Cropping rather than scrolling: the
		// recent weeks are the ones being read, and a January parked off the
		// side of a scroll container is a January nobody ever sees.
		//
		// Both numbers are also in the stylesheet, in .heat's min-width.
		const CELL_MIN = 11;
		const CELL_GAP = 3;
		/** The day-label column plus the gap after it. */
		const GUTTER = 26;

		const heatScroll = document.querySelector<HTMLElement>('[data-heat-scroll]');
		const heat = document.querySelector<HTMLElement>('[data-heat]');
		const heatCols = document.querySelectorAll<HTMLElement>('[data-heat-col]');
		const heatLabels = document.querySelectorAll<HTMLElement>('[data-heat-label]');

		if (heatScroll && heat && heatCols.length) {
			const fit = () => {
				// Zero while the panel is hidden, which it is whenever the page
				// opened on the spells view. Measuring then would crop the grid to
				// its floor of eight weeks and leave it there.
				const available = heatScroll.clientWidth - GUTTER;
				if (available <= 0) return;

				const fits = Math.floor((available + CELL_GAP) / (CELL_MIN + CELL_GAP));
				// Eight weeks even if they have to go under 11px. Narrower than a
				// phone there is no width at which this reads well, and two months
				// is the least that still looks like a calendar.
				const weeks = Math.max(8, Math.min(heatCols.length, fits));
				const dropped = heatCols.length - weeks;

				heatCols.forEach((col, i) => (col.hidden = i < dropped));
				heatLabels.forEach((label, i) => (label.hidden = i < dropped));
				// Hands the width over to the flex fill. Dropping the min-width can
				// remove the scrollbar and so change clientWidth — the observer
				// picks that up and settles on the next pass.
				heat.classList.add('heat--fit');
			};

			new ResizeObserver(fit).observe(heatScroll);
		}
	</script>

	<style>
		.page {
			min-height: 100vh;
			background: #1a120a;
		}

		/* Site nav. The strip runs to both edges while the links sit on the same
		   960px column as the page content — 1008px is that column plus the
		   padding either side.

		   The mock reaches for the bleed with a pair of ±2000px box-shadows, but
		   an offset shadow of a box at most 1008px wide lands 1000px clear of it
		   and never meets the edge. A wrapper carries the background and the rule
		   out at every width instead. */
		.tabs-bar {
			background: #150e07;
			border-bottom: 1px solid #45341f;
		}
		.tabs {
			display: flex;
			align-items: stretch;
			gap: 2px;
			max-width: 1008px;
			margin: 0 auto;
			padding: 0 clamp(14px, 4vw, 24px);
			overflow-x: auto;
		}
		.tabs__link {
			font-size: 13px;
			letter-spacing: 0.4px;
			color: #bfa886;
			padding: 26px 16px 24px;
			border-bottom: 2px solid transparent;
			white-space: nowrap;
			transition: color 0.12s;
		}
		.tabs__link:hover {
			color: #f2e6cd;
		}
		.tabs__link--active {
			color: #f2e6cd;
			font-weight: 600;
			border-bottom-color: #cfa452;
		}
		.tabs__link--active:hover {
			color: #fff2da;
		}

		.wrap {
			display: flex;
			justify-content: center;
			padding: 34px clamp(14px, 4vw, 24px) 90px;
		}
		.col {
			width: 100%;
			max-width: 960px;
		}

		/* Header */
		.head {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			gap: 14px;
			flex-wrap: wrap;
			margin-bottom: 30px;
		}
		.head__title {
			font-family: 'Newsreader', serif;
			font-weight: 500;
			font-size: clamp(38px, 9vw, 52px);
			color: #f2e6cd;
			letter-spacing: -0.5px;
			line-height: 1;
			margin: 0;
		}
		.head__note {
			margin: 0;
			font-size: 12.5px;
			color: #8a745a;
			line-height: 1.5;
			max-width: 280px;
		}

		/* Metrics */
		.metrics {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
			gap: 12px;
			margin-bottom: 44px;
		}
		.metric {
			background: #241a10;
			border: 1px solid #45341f;
			border-radius: 10px;
			padding: 20px 18px;
		}
		.metric__value {
			font-family: 'Newsreader', serif;
			font-size: 36px;
			color: #cfa452;
			line-height: 1;
		}
		.metric__label {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #a68f6e;
			margin-top: 8px;
		}

		/* Sections */
		.section {
			margin-bottom: 46px;
		}
		.sec-head {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: 12px;
			flex-wrap: wrap;
			padding-bottom: 10px;
			border-bottom: 1px solid #392a19;
			margin-bottom: 20px;
		}
		.sec-head--tight {
			margin-bottom: 14px;
		}
		/* A shelf carries its own headroom for a pulled book, so the heading sits
		   nearly on top of it rather than opening a second gap. */
		.sec-head--shelf {
			margin-bottom: 6px;
		}
		.sec-head__link {
			font-size: 12.5px;
			flex: none;
		}
		.sec-head__title {
			font-family: 'Newsreader', serif;
			font-style: italic;
			font-weight: 400;
			font-size: 20px;
			color: #ead9b6;
			margin: 0;
		}
		.sec-head__tools {
			display: flex;
			align-items: center;
			gap: 8px;
			flex-wrap: wrap;
		}
		.sec-head__meta {
			font-size: 12px;
			color: #a68f6e;
		}
		.month-link {
			font-size: 12px;
			color: #cfa452;
			border-bottom: 1px solid #45341f;
			padding-bottom: 1px;
		}
		.month-link:hover {
			color: #ecc87c;
			border-bottom-color: #ecc87c;
		}

		/* Pills */
		.pills {
			display: flex;
			gap: 7px;
			flex-wrap: wrap;
		}
		.pill {
			font-family: 'Archivo', sans-serif;
			font-size: 12.5px;
			line-height: 1.2;
			padding: 7px 13px;
			border-radius: 20px;
			border: 1px solid #45341f;
			background: transparent;
			color: #dcc9a6;
			cursor: pointer;
		}
		.pill--sm {
			font-size: 12px;
			padding: 6px 12px;
		}
		.pill:hover {
			border-color: #6b5231;
			color: #f2e6cd;
		}
		.pill--on,
		.pill--on:hover {
			background: #cfa452;
			border-color: #cfa452;
			color: #241a10;
			font-weight: 600;
		}

		.book__link {
			color: inherit;
		}
		.book__link:hover {
			color: #ecc87c;
		}
		/* A book in flight that nothing is counting. */
		.untracked-note {
			margin-top: 18px;
			font-size: 12.5px;
			color: #8a745a;
			line-height: 1.5;
		}

		/* Currently reading */
		.stack {
			display: flex;
			flex-direction: column;
