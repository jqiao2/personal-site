---
import BookLayout from '../../layouts/BookLayout.astro';
import BooksBody from '../../components/BooksBody.astro';
import SiteHeader from '../../components/SiteHeader.astro';

// Rendered on demand so the header reflects the live session. The reading record
// is a server island (BooksBody, server:defer) so the shell paints immediately
// and the data-heavy body — feed + sidebar — streams in on its own request.
export const prerender = false;
---

<BookLayout title="Books">
	<div class="page">
		<div class="card">
			<SiteHeader pathname={Astro.url.pathname} theme="book" max="1120px" sidebar />

			<BooksBody pathname={Astro.url.pathname} server:defer>
				<div slot="fallback" class="shell-skel" aria-hidden="true">
					<div class="feed-skel">
						{Array.from({ length: 3 }).map(() => (
							<div class="skel-block">
								<div class="skel-line skel-line--head"></div>
								<div class="skel-card"></div>
							</div>
						))}
					</div>
					<div class="side-skel"></div>
				</div>
			</BooksBody>
		</div>
	</div>
</BookLayout>

<style>
	.page {
		min-height: 100vh;
		background: #1a120a;
		display: flex;
		justify-content: center;
		overflow-x: hidden;
	}
	.card {
		width: 100%;
		max-width: 1120px;
		display: flex;
		flex-direction: column;
	}

	/* Skeleton shown while the BooksBody island streams in. Mirrors the body's
	   two-column geometry so the shell doesn't reflow when it arrives.
	   ponytail: measured (1280px/420px), not derived — the reading record's
	   height follows how many books are open, so re-measure if that changes by
	   much. */
	.shell-skel {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 288px;
		min-height: 2100px;
	}
	.feed-skel {
		display: flex;
		flex-direction: column;
		gap: 46px;
		padding: 38px 40px 44px clamp(14px, 4vw, 32px);
	}
	.side-skel {
		border-left: 1px solid #392a19;
	}
	.skel-line--head {
		height: 20px;
		width: 40%;
		border-radius: 3px;
		background: #392a19;
		margin-bottom: 20px;
	}
	.skel-card {
		height: 120px;
		border-radius: 10px;
		border: 1px solid #392a19;
		background: #241a10;
	}
	@media (max-width: 820px) {
		.shell-skel {
			grid-template-columns: 1fr;
			min-height: 2380px;
		}
		.side-skel {
			display: none;
		}
		.feed-skel {
			padding: 28px 22px 34px;
		}
	}
</style>
