</style>

<script>
	// Back link: prefer real history when you arrived from inside the site, so
	// "← Books" returns you to the shelf you were scrolled to rather than the
	// top of a fresh one.
	document.querySelector<HTMLAnchorElement>('[data-back]')?.addEventListener('click', (e) => {
		if (document.referrer && new URL(document.referrer).origin === location.origin) {
			e.preventDefault();
			history.back();
		}
	});

	// Blurb: show the rest.
	const blurb = document.querySelector('[data-blurb]');
	const blurbToggle = document.querySelector<HTMLButtonElement>('[data-blurb-toggle]');
	blurbToggle?.addEventListener('click', () => {
		const open = blurbToggle.textContent === 'Less';
		blurb?.querySelectorAll<HTMLElement>('.blurb__p').forEach((p, i) => {
			if (i >= 2) p.hidden = open;
		});
		blurbToggle.textContent = open ? 'More' : 'Less';
	});

	// Highlights: 4, then all of them.
	const highlightsToggle = document.querySelector<HTMLButtonElement>('[data-highlights-toggle]');
	highlightsToggle?.addEventListener('click', () => {
		const list = document.querySelector('[data-highlights]');
		const all = Array.from(list?.querySelectorAll<HTMLElement>('.highlight') ?? []);
		const open = all.some((h) => h.hidden);
		all.forEach((h, i) => {
			if (i >= 4) h.hidden = !open;
		});
		highlightsToggle.textContent = open ? 'Show fewer' : `Show all ${all.length} highlights`;
	});

	// Attribute chips past the eighth.
	document.querySelectorAll<HTMLElement>('[data-chips]').forEach((box) => {
		const toggle = box.querySelector<HTMLButtonElement>('[data-chips-toggle]');
		toggle?.addEventListener('click', () => {
			const chips = Array.from(box.querySelectorAll<HTMLElement>('.chip'));
			const hidden = chips.filter((c) => c.hidden);
			const opening = hidden.length > 0;
			const extra = chips.length - 8;
			chips.forEach((c, i) => {
				if (i >= 8) c.hidden = !opening;
			});
			toggle.textContent = opening ? 'fewer' : `+${extra} more`;
		});
	});

	// Rail actions. Every one of these is a single-column patch, and the page is
	// rendered from the database on every request, so a reload is the render.
	document.querySelectorAll<HTMLButtonElement>('[data-book-action]').forEach((button) => {
		button.addEventListener('click', async () => {
			const action = button.dataset.bookAction;
			const id = Number(
				document.querySelector<HTMLElement>('#match-modal')?.dataset.bookId ??
					location.pathname.split('/').pop(),
			);
			const label = button.textContent;
			button.disabled = true;
			button.textContent = '…';
			const res = await fetch('/api/books/book', {
				method: 'PATCH',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ id, action }),
			});
			if (!res.ok) {
				button.disabled = false;
				button.textContent = label;
				return;
			}
			location.reload();
		});
	});

	// Match panel: search Open Library, pick an edition, correct the title.
	const matchModal = document.getElementById('match-modal');
	if (matchModal) {
		type Result = {
			key: string;
			title: string;
			author: string;
			year: number | null;
			pages: number | null;
			coverUrl: string | null;
		};

		const bookId = Number(matchModal.dataset.bookId);
		const search = matchModal.querySelector<HTMLElement>('[data-match-search]')!;
		const confirm = matchModal.querySelector<HTMLElement>('[data-match-confirm]')!;
		const input = document.getElementById('match-q') as HTMLInputElement;
		const meta = document.getElementById('match-meta')!;
		const list = document.getElementById('match-results')!;
		const confirmBtn = document.getElementById('match-confirm') as HTMLButtonElement;
		const editTitle = document.getElementById('edit-title') as HTMLInputElement;
		const editAuthor = document.getElementById('edit-author') as HTMLInputElement;
		let picked: Result | null = null;
		let timer: ReturnType<typeof setTimeout>;

		const show = (which: 'search' | 'confirm') => {
			search.hidden = which !== 'search';
			confirm.hidden = which !== 'confirm';
			confirmBtn.hidden = which !== 'confirm';
		};

		function thumb(result: Result): HTMLElement {
			if (result.coverUrl) {
				const img = document.createElement('img');
				img.className = 'thumb';
				img.src = result.coverUrl;
				img.alt = '';
				return img;
			}
			const div = document.createElement('div');
			div.className = 'thumb';
			return div;
		}

		// Open Library's cataloguing is inconsistently cased — "The power broker:
		// Robert Moses and the fall of New York" — so a title that has already
		// been corrected by hand wins over the one the edition arrives with.
		// There is nothing to preserve on an unmatched book, where the stored
		// title is the EPUB's filename and anything is an improvement.
		const correctedTitle = matchModal.dataset.correctedTitle || null;
		const correctedAuthor = matchModal.dataset.correctedAuthor || null;

		function pick(result: Result) {
			picked = result;
			editTitle.value = correctedTitle ?? result.title;
			editAuthor.value = correctedAuthor ?? result.author;
			document.getElementById('picked-title')!.textContent = result.title;
			document.getElementById('picked-meta')!.textContent = [
				result.author,
				result.year,
				result.pages ? `${result.pages} pages` : null,
			]
				.filter(Boolean)
				.join(' · ');
			const holder = document.getElementById('picked-thumb')!;
			holder.replaceWith(Object.assign(thumb(result), { id: 'picked-thumb' }));
			show('confirm');
		}

		async function run() {
			const q = input.value.trim();
			if (q.length < 2) {
				list.replaceChildren();
				meta.textContent = '';
				return;
			}
			meta.textContent = 'Searching Open Library…';
			const res = await fetch(`/api/books/openlibrary?q=${encodeURIComponent(q)}`);
			if (!res.ok) {
				meta.textContent = 'Open Library is not answering. Try again in a minute.';
				return;
			}
			const { results } = (await res.json()) as { results: Result[] };
			list.replaceChildren();
			meta.textContent = !results.length
				? 'Nothing on Open Library matches that. Try the author alone, or leave it unmatched — the reading log works without it.'
				: results.length === 1
					? 'One edition on Open Library.'
					: `${results.length} editions on Open Library — the year and page count are how you tell them apart`;

			for (const result of results) {
				const row = document.createElement('button');
				row.type = 'button';
				row.className = 'result';
				const main = document.createElement('div');
				main.className = 'result__main';
				const title = document.createElement('div');
				title.className = 'result__title';
				title.textContent = result.title;
				const author = document.createElement('div');
				author.className = 'result__author';
				author.textContent = result.author;
				main.append(title, author);

				const side = document.createElement('div');
				side.className = 'result__side';
				const year = document.createElement('div');
				year.className = 'result__year';
				year.textContent = result.year ? String(result.year) : '—';
				const pages = document.createElement('div');
				pages.className = 'result__pages';
				pages.textContent = result.pages ? `${result.pages} pp` : '';
				side.append(year, pages);

				row.append(thumb(result), main, side);
				row.addEventListener('click', () => pick(result));
				list.append(row);
			}
		}

		document.querySelectorAll<HTMLElement>('[data-open-match]').forEach((b) => {
			b.addEventListener('click', () => {
				matchModal.hidden = false;
				document.body.style.overflow = 'hidden';
				picked = null;
				show('search');
				run();
			});
		});
		matchModal.querySelectorAll<HTMLElement>('[data-match-close]').forEach((b) => {
			b.addEventListener('click', () => {
				matchModal.hidden = true;
				document.body.style.overflow = '';
			});
		});
		matchModal.querySelector('[data-match-back]')?.addEventListener('click', () => show('search'));
		input.addEventListener('input', () => {
			clearTimeout(timer);
			timer = setTimeout(run, 260);
		});

		confirmBtn.addEventListener('click', async () => {
			if (!picked) return;
			confirmBtn.disabled = true;
			confirmBtn.textContent = 'Linking…';
			const res = await fetch('/api/books/book', {
				method: 'PATCH',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({
					id: bookId,
					action: 'match',
					olKey: picked.key,
					title: editTitle.value,
					authors: editAuthor.value,
					pages: picked.pages,
					year: picked.year,
					coverUrl: picked.coverUrl,
				}),
			});
			if (!res.ok) {
				confirmBtn.disabled = false;
				confirmBtn.textContent = 'Link this edition';
				return;
			}
			location.reload();
		});
	}
</script>
