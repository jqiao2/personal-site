---
import BookReviewEditor from '../../components/BookReviewEditor.astro';
import BookLayout from '../../layouts/BookLayout.astro';
import {
	getBook,
	getBookDays,
	getBookHighlights,
	getBookReviews,
} from '../../lib/book-queries';
import { buildBookPage } from '../../lib/book-view';
import { requireOwner } from '../../lib/auth';
import { siteNav } from '../../lib/nav';

// Rendered on demand — reflects whatever the Kindle last pushed.
export const prerender = false;

const nav = siteNav(Astro.url.pathname);
const id = Number(Astro.params.id);
const isOwner = await requireOwner(Astro.cookies);
const book = Number.isInteger(id) ? await getBook(id, isOwner) : null;

// A private book does not exist to a visitor. Not a redacted page, not "you
// don't have access" — those both answer the question the privacy toggle is
// there to refuse. getBook returns null for both cases so this can't leak the
// difference by accident.
if (!book) {
	return new Response(
		`<!doctype html><html lang="en"><head><meta charset="utf-8">
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<title>Not found</title>
		<style>
			body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;
				padding:40px 24px;background:#1a120a;color:#f2e6cd;font-family:Archivo,Arial,sans-serif}
			.box{max-width:420px}
			.code{font-family:Georgia,serif;font-size:64px;color:#33261a;line-height:1;letter-spacing:-2px}
			.head{font-family:Georgia,serif;font-style:italic;font-size:22px;color:#ead9b6;margin-top:18px;line-height:1.4}
			p{font-size:13px;color:#8a745a;margin:12px 0 0;line-height:1.65}
			a{display:inline-block;margin-top:22px;font-size:13px;color:#cfa452;text-decoration:none}
		</style></head><body><div class="box">
		<div class="code">404</div>
		<div class="head">There is nothing at this address.</div>
		<p>No redacted page, no placeholder — as far as this site is concerned the book was never here.</p>
		<a href="/books">&larr; Back to Books</a>
		</div></body></html>`,
		{ status: 404, headers: { 'content-type': 'text/html; charset=utf-8' } },
	);
}

const [days, reviews, highlights] = await Promise.all([
	getBookDays(book.id),
	getBookReviews(book.id),
	getBookHighlights(book.id),
]);

const v = buildBookPage({ book, days, reviews, highlights, isOwner });

// Decorative shelf behind the hero: the spines from /books, out of focus. A
// fixed seed rather than Math.random so the same book draws the same shelf on
// every render instead of shuffling on each page load.
let seed = 90_210;
const random = () => ((seed = (seed * 9301 + 49_297) % 233_280), seed / 233_280);
const spines = Array.from({ length: 18 }, () => ({
	w: 8 + Math.round(random() * 20),
	h: 46 + Math.round(random() * 30),
}));
---

<BookLayout title={v.pageTitle}>
	<div class="page" style={`--hue:${v.hue}`}>
		<div class="tabs-bar">
			<nav class="tabs">
				{nav.map((n) => (
					<a
						class:list={['tabs__link', n.active && 'tabs__link--active']}
						href={n.href}
						aria-current={n.active ? 'page' : undefined}
					>
						{n.label}
					</a>
				))}
			</nav>
		</div>

		<!-- Hero: a wash pulled from the book, on a shelf with one book missing -->
		<div class="hero">
			<div class="hero__grain"></div>
			<div class="hero__shelf">
				{spines.map((s) => <div class="hero__spine" style={`width:${s.w}px;height:${s.h}px`} />)}
			</div>
			<div class="hero__inner">
				<div class="wrap hero__row">
					<a class="back" href="/books" data-back>
						<span class="back__arrow">←</span><span>Books</span>
					</a>
					<div class="hero__status">
						<span class:list={['dot', v.heroDotClass]}></span>
						<span class="hero__status-label">{v.heroStatus}</span>
					</div>
				</div>
			</div>
		</div>

		<div class="wrap layout">
			<!-- ============ LEFT RAIL ============ -->
			<aside class="rail">
				{
					v.coverUrl ? (
						<div class="cover">
							<img class="cover__art" src={v.coverUrl} alt={`${v.title} cover`} fetchpriority="high" />
							<div class="cover__scrim" />
							<div class="cover__edge" />
							<div class="cover__text">
								<div class="cover__title">{v.title}</div>
								<div class="cover__author">{v.authorLine}</div>
							</div>
							{v.badge && !!v.isPublic && <div class:list={['badge', `badge--${v.shelf}`]}>{v.badge}</div>}
							{
								!v.isPublic && (
									<Fragment>
										<div class="cover__hatch" />
										<div class="cover__private">
											<span class="dot dot--private" />
											<span>Private</span>
										</div>
									</Fragment>
								)
							}
						</div>
					) : (
						<div class="nocover">
							<div class="nocover__spine">
								<div class="nocover__fill" style={`height:${v.spineFill}px`} />
								<span class="nocover__title">{v.title}</span>
							</div>
							<div class="nocover__note">no cover on file</div>
						</div>
					)
				}

				{/* A reading, not a control — the state is reported, never asked for. */}
				{
					(v.shelf === 'reading' || v.shelf === 'aside' || v.shelf === 'gaveup') && (
						<div class:list={['status', `status--${v.shelf}`]}>
							<div class="status__head">
								<span class:list={['dot', `dot--${v.shelf}`]} />
								<span class="status__label">{v.statusLabel}</span>
								{v.lovedAny && <span class="status__heart" title="You loved this">♥</span>}
							</div>
							{
								v.showProgress ? (
									<Fragment>
										<div class="track">
											<div class="track__bar" style={`width:${v.barWidth}%`} />
										</div>
										<div class="status__pages">{v.railPageLine}</div>
									</Fragment>
								) : (
									<Fragment>
										<div class="status__pages">{v.railPageLine}</div>
										{!v.knowsTotal && (
											<div class="status__note">
												No page count on file, so there is no percentage and the automatic
												finish will never fire.
											</div>
										)}
									</Fragment>
								)
							}
							{v.statusNote && <div class="status__note">{v.statusNote}</div>}
							<dl class="facts">
								{
									v.railFacts.map((f) => (
										<div class="fact">
											<dt>{f.k}</dt>
											<dd>{f.v}</dd>
										</div>
									))
								}
							</dl>
						</div>
					)
				}

				{
					v.shelf === 'finished' && (
						<div class="status status--finished">
							<div class="status__head">
								<span class="dot dot--finished" />
								<span class="status__label">Finished</span>
								{v.lovedAny && <span class="status__heart" title="You loved this">♥</span>}
							</div>
							<div class="status__date">{v.finishedLong}</div>
							{
								v.byHand && (
									<Fragment>
										{v.stoppedLine && <div class="status__stopped">{v.stoppedLine}</div>}
										<div class="status__note">Called done by hand — the rest is endnotes and sources.</div>
									</Fragment>
								)
							}
							<dl class="facts">
								{
									v.railFacts.map((f) => (
										<div class="fact">
											<dt>{f.k}</dt>
											<dd>{f.v}</dd>
										</div>
									))
								}
							</dl>
						</div>
					)
				}

				{v.addedLine && <div class="rail__line">{v.addedLine}</div>}
				{v.autoNote && <div class="rail__auto">{v.autoNote}</div>}

				{/* One primary action, everything else quieter. */}
				{
					v.primaryLabel && (
						<button
							type="button"
							class:list={['btn-primary', v.shelf === 'toread' && 'btn-primary--on']}
							data-open-review={v.primaryAction === 'review' ? '' : undefined}
							data-seed={
								v.primaryAction === 'review' && v.reviews.length
									? JSON.stringify(v.reviews[0].seed)
									: undefined
							}
							data-read-label={
								v.primaryAction === 'review' && v.reviews.length
									? [v.reviews[0].readLabel, v.reviews[0].dates].filter(Boolean).join(' · ')
									: undefined
							}
							data-book-action={v.primaryAction === 'to-read' ? 'to-read' : undefined}
						>
							{v.primaryLabel}
						</button>
					)
				}

				{
					v.quietActions.length > 0 && (
						<div class="quiet">
							{
								v.quietActions.map((q) => (
									<button type="button" class="quiet__btn" title={q.hint} data-book-action={q.action}>
										{q.label}
									</button>
								))
							}
						</div>
					)
				}

				{
					isOwner && (
						<div class:list={['priv', !v.isPublic && 'priv--on']}>
							<button type="button" class="priv__toggle" data-book-action="private" aria-pressed={!v.isPublic}>
								<span class="priv__track"><span class="priv__knob" /></span>
								<span class="priv__label">
									{v.isPublic ? 'Private' : 'Private — only you can see this'}
								</span>
							</button>
							<div class="priv__caption">
								{
									v.isPublic
										? 'Hides the book, its reviews and its highlights from the public shelf. Your streak and totals keep counting it.'
										: 'Visitors get a 404, not a redacted page. The reading still counts: your streak, days read, pages and time all include it — the numbers say how much you read, not what.'
								}
							</div>
						</div>
					)
				}
			</aside>

			<!-- ============ RIGHT COLUMN ============ -->
			<div class="col">
				<h1 class="title">{v.title}</h1>
				{v.subtitle && <div class="subtitle">{v.subtitle}</div>}
				{v.series && <div class="series">{v.series}</div>}

				{
					v.authors.length > 0 && (
						<div class="byline">
							By{' '}
							{v.authors.map((a, i) => (
								<Fragment>
									{i > 0 && ' & '}
									<a class="byline__name" href={`/books?author=${encodeURIComponent(a)}`}>{a}</a>
								</Fragment>
							))}
						</div>
					)
				}

				{v.contributorLine && <div class="credits">{v.contributorLine}</div>}

				{
					(v.metaBits.length > 0 || isOwner) && (
						<div class="meta">
							{
								v.metaBits.map((m, i) => (
									<Fragment>
										{i > 0 && <span class="meta__dot">·</span>}
										<span class="meta__bit">{m}</span>
									</Fragment>
								))
							}
							{
								isOwner && v.matched && (
									<button type="button" class="meta__fix" data-open-match>wrong edition?</button>
								)
							}
						</div>
					)
				}

				{
					v.kind && (
						<div class="tags">
							<a class="tag tag--kind" href={`/books?kind=${encodeURIComponent(v.kind)}`}>{v.kind}</a>
							{
								v.genres.map((g) => (
									<a class="tag" href={`/books?subject=${encodeURIComponent(g)}`}>{g}</a>
								))
							}
						</div>
					)
				}

				{
					v.description.length > 0 && (
						<div class="blurb" data-blurb>
							{
								v.description.map((p, i) => (
									<p class="blurb__p" hidden={i >= v.descriptionPreview.length}>{p}</p>
								))
							}
							{
								v.description.length > v.descriptionPreview.length && (
									<button type="button" class="blurb__more" data-blurb-toggle>More</button>
								)
							}
						</div>
					)
				}

				{/* Unmatched: most of this column is simply absent, and says so. */}
				{
					!v.matched && (
						<div class="invite">
							<div class="invite__head">Nothing is known about this book yet.</div>
							<div class="invite__body">{v.missingLine}</div>
							<div class="invite__raw">{v.sourceTitle}</div>
							{
								isOwner && (
									<button type="button" class="btn-primary invite__cta" data-open-match>
										Find this book on Open Library
									</button>
								)
							}
						</div>
					)
				}

				{/* ============ YOUR READING ============ */}
				{
					v.hasActivity && (
						<section class="section">
							<div class="sec-head">
								<h2 class="sec-head__title">Your reading</h2>
								<span class="sec-head__meta">{v.lifetimeScope}</span>
							</div>

							{
								v.progressIsHero && (
									<div class="hero-progress">
										<div class="hero-progress__pct">{v.percent}</div>
										<div class="hero-progress__main">
											<div class="track track--lg">
												<div class="track__bar" style={`width:${v.barWidth}%`} />
											</div>
											<div class="hero-progress__row">
												<span>{v.pageLine}</span>
												<span class="dim">{v.pagesLeftLine}</span>
											</div>
										</div>
									</div>
								)
							}

							<div class="stats">
								{
									v.stats.map((s) => (
										<div class="stat">
											<div class="stat__value">{s.value}</div>
											<div class="stat__label">{s.label}</div>
										</div>
									))
								}
							</div>

							{
								v.pace && (
									<div class="pace">
										<div class="pace__head">
											<span class="pace__value">{v.pace.value}</span>
											<span class="pace__unit">{v.pace.unit}</span>
										</div>
										<div class="pace__projection">{v.pace.projection}</div>
										<div class="pace__basis">{v.pace.basis}</div>
									</div>
								)
							}
							{v.noPaceLine && <div class="nopace">{v.noPaceLine}</div>}
						</section>
					)
				}

				{/* ============ WHEN YOU READ IT ============ */}
				{
					v.hasActivity && (
						<section class="section">
							<div class="sec-head">
								<h2 class="sec-head__title">When you read it</h2>
								<span class="sec-head__meta">{v.activityMeta}</span>
							</div>
							<div class="stretches">
								{
									v.stretches.map((row) =>
										row.kind === 'gap' ? (
											<div class="gap">
												<span class="gap__rule" />
												<span class="gap__label">{row.label}</span>
												<span class="gap__rule" />
											</div>
										) : (
											<div class="stretch">
												<div class="stretch__head">
													<div class="stretch__names">
														<span class="stretch__range">{row.label}</span>
														{row.readLabel && <span class="stretch__read">{row.readLabel}</span>}
													</div>
													<span class="stretch__meta">{row.meta}</span>
												</div>
												<div class="stretch__cells">
													{
														row.cells.map((c) => (
															<div
																class:list={['cell', `cell--l${c.level}`, !c.read && 'cell--off']}
																title={c.title}
															/>
														))
													}
												</div>
											</div>
										),
									)
								}
							</div>
						</section>
					)
				}

				{/* ============ HIGHLIGHTS ============ */}
				{
					v.highlights.length > 0 && (
						<section class="section">
							<div class="sec-head sec-head--tight">
								<h2 class="sec-head__title">Highlights</h2>
								<span class="sec-head__meta">{v.highlightMeta}</span>
							</div>
							<div
								class:list={['highlights', v.highlights.length > 12 && 'highlights--scroll']}
								data-highlights
							>
								{
									v.highlights.map((h, i) => (
										<div class="highlight" hidden={i >= v.highlightPreview.length}>
											<div class="highlight__page">{h.page}</div>
											<div class="highlight__text">{h.text}</div>
										</div>
									))
								}
							</div>
							{
								v.highlights.length > v.highlightPreview.length && (
									<button type="button" class="btn-pill" data-highlights-toggle>
										Show all {v.highlights.length} highlights
									</button>
								)
							}
						</section>
					)
				}

				{/* ============ REVIEWS ============ */}
				{
					v.showReviews && (
						<section class="section">
							<div class="sec-head">
								<h2 class="sec-head__title">{v.reviewsHeading}</h2>
								{v.readsMeta && <span class="sec-head__meta">{v.readsMeta}</span>}
							</div>

							<div class="reviews">
								{
									v.reviews.map((r, i) => (
										<article class:list={['review', i === 0 && 'review--latest']}>
											<div class="review__head">
												{r.readLabel && <span class="review__read">{r.readLabel}</span>}
												<span class="review__dates">{r.dates}</span>
												{
													isOwner && (
														<button
															type="button"
															class="review__edit"
															data-open-review
															data-seed={JSON.stringify(r.seed)}
															data-read-label={[r.readLabel, r.dates].filter(Boolean).join(' · ')}
														>
															{r.editLabel}
														</button>
													)
												}
											</div>

											<div class="review__meta">
												{r.stars && <span class="review__stars">{r.stars}</span>}
												{
													r.loved && (
														<span class="review__loved" title="You loved this">
															<span class="review__heart">♥</span>
															{r.lovedWord}
														</span>
													)
												}
												{r.ending && <span class="review__ending">{r.ending}</span>}
												{r.readStats && <span class="review__stats">{r.readStats}</span>}
											</div>

											{
												r.text ? (
													<p class="review__text">{r.text}</p>
												) : (
													<div class="review__empty">{r.emptyLine}</div>
												)
											}

											{
												(r.chips.length > 0 || r.hiddenChips.length > 0) && (
													<div class="chips" data-chips>
														{
															r.chips.map((c) => (
																<span class:list={['chip', c.scale && 'chip--scale']}>{c.label}</span>
															))
														}
														{
															r.hiddenChips.map((c) => (
																<span class:list={['chip', c.scale && 'chip--scale']} hidden>
																	{c.label}
																</span>
															))
														}
														{
															r.hiddenChips.length > 0 && (
																<button type="button" class="chips__more" data-chips-toggle>
																	+{r.hiddenChips.length} more
																</button>
															)
														}
													</div>
												)
											}
										</article>
									))
								}
							</div>

							{v.noReadsLine && <div class="reviews__empty">{v.noReadsLine}</div>}
						</section>
					)
				}
			</div>
		</div>

		{/* ============ MATCH PANEL (owner) ============ */}
		{
			isOwner && (
				<div
					class="modal"
					id="match-modal"
					data-source-title={v.sourceTitle}
					data-book-id={v.id}
					data-corrected-title={v.titleIsCorrected ? v.fullTitle : undefined}
					data-corrected-author={v.authorLine || undefined}
					hidden
				>
					<div class="modal__backdrop" data-match-close />
					<div class="modal__panel" role="dialog" aria-modal="true" aria-labelledby="match-title">
						<div class="modal__head">
							<div class="modal__heading">
								<div class="modal__title" id="match-title">
									{v.matched ? 'Match a different edition' : 'Match this book'}
								</div>
								<div class="modal__raw">{v.sourceTitle || '(no filename on record)'}</div>
							</div>
							<button type="button" class="modal__close" data-match-close aria-label="Close">✕</button>
						</div>

						<div class="modal__body">
							<div data-match-search>
								<input
									type="text"
									id="match-q"
									placeholder="Title and author…"
									autocomplete="off"
									value={[v.title, v.authors[0]].filter(Boolean).join(' ')}
								/>
								<div class="modal__meta" id="match-meta"></div>
								<div class="results" id="match-results"></div>
							</div>

							<div data-match-confirm hidden>
								<div class="picked">
									<div class="thumb" id="picked-thumb"></div>
									<div class="picked__main">
										<div class="picked__title" id="picked-title"></div>
										<div class="picked__meta" id="picked-meta"></div>
										<button type="button" class="linkish" data-match-back>Pick a different edition</button>
									</div>
								</div>
								<div class="edits">
									<div>
										<label class="lbl" for="edit-title">Shown as</label>
										<input type="text" id="edit-title" class="input--serif" />
									</div>
									<div>
										<label class="lbl" for="edit-author">Author</label>
										<input type="text" id="edit-author" />
									</div>
									<div class="edits__note">
										The file the Kindle reports stays underneath as the identifier:<br />
										<span class="edits__raw">{v.sourceTitle || '(none)'}</span>
									</div>
								</div>
							</div>
						</div>

						<div class="modal__foot">
							<button type="button" class="btn-ghost" data-match-close>Cancel</button>
							<button type="button" class="btn-save" id="match-confirm" hidden>Link this edition</button>
						</div>
					</div>
				</div>
			)
		}

		{
			isOwner && (
				<BookReviewEditor
					bookId={v.id}
					bookTitle={v.title}
					newRead={v.newRead}
					latestRead={
						v.reviews.length
							? {
									from: v.reviews[0].seed.readFrom,
									to: v.reviews[0].seed.readTo,
									label: v.latestReadTitle ?? '',
								}
							: null
