---
import Layout from '../layouts/Layout.astro';

// SSR so the header's requireOwner() runs per request; prerendered, it bakes
// owner=false at build and shows the "Log in" button to the signed-in owner.
export const prerender = false;
---

<Layout title="404 — Page not found">
	<h1>This page does not exist</h1>
	<p>The address is not correct, or the page moved.</p>
	<p><a href="/">Go to the home page.</a></p>
</Layout>
