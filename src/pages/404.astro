---
import Layout from '../layouts/Layout.astro';

// Static (a real 404.html). The header's "Log in" button is hidden client-side
// for the owner now (see SiteHeader.astro), so baking owner=false at build no
// longer shows the button to the signed-in owner — the reason this was SSR.
---

<Layout title="404 — Page not found">
	<h1>This page does not exist</h1>
	<p>The address is not correct, or the page moved.</p>
	<p><a href="/">Go to the home page.</a></p>
</Layout>
