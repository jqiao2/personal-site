---
// No listing of its own — /month opens on the month it is now, and the picker
// on /month/[month] steps to any other. Same role /films/month/index.astro and
// /books/month/index.astro play: a request-time redirect, so the Journal nav
// tab and the home-feed link can stay pointed at the stable /month while still
// landing on the current month (a build-time hardcode would freeze to the
// month the prerendered pages were built in).
import { siteDay } from '../../lib/day';
import { requireOwner } from '../../lib/auth';

export const prerender = false;

// OWNER ONLY — the month in review is owner-gated at the destination anyway.
if (!(await requireOwner(Astro.cookies))) {
	return Astro.redirect(`/films/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

return Astro.redirect(`/month/${siteDay().slice(0, 7)}`, 302);
---
