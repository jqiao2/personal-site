---
// The month in review — films, books, meals and activities on one calendar.
//
// The fifth card in the family, and the first that isn't a section's. The four
// section cards each answer "how was the month in X"; this one answers "what
// were the days like", which none of them can, because a day is not made of one
// track. So a cell is a CLUSTER: one mark per thing done, each sized by the
// time it took (src/lib/journal-month.ts has the weights and the argument for
// them), tilted a little, overlapping its neighbours the way things stuck into
// a journal overlap.
//
// WHY IT LOOKS LIKE PAPER. The four section cards are each art-directed to
// their own section, and none of those directions can host the other three
// without annexing them. What all four have in common is upstream of all of
// them: I kept a paper journal first. Cream stock, a printed rule, a red margin
// line, ink. It is the one reference that belongs to no section, so it's the
// one that can hold all four.
//
// The calendar arithmetic and the artboard are the family's shared ones
// (share-card.ts), and the export is the same one the other four use.
import JournalLayout from '../../layouts/JournalLayout.astro';
import { listMonthWatches } from '../../lib/films';
import { getReadingMonth } from '../../lib/books-queries';
import { listMonthVisits } from '../../lib/restaurants';
import { listActivitiesForMonth } from '../../lib/activities';
import {
	activityItems,
	bookItems,
	buildCells,
	filmItems,
	headline,
	mealItems,
	summarise,
	TRACKS,
} from '../../lib/journal-month';
import {
	ASPECTS,
	aspectBySlug,
	monthLabel,
	monthQuery,
	parseMonthKey,
	shiftMonth,
	WEEKDAYS,
} from '../../lib/share-card';
import { listJournalMonths } from '../../lib/journal-months';

// The books query runs on the service-role client (the reading tables have RLS
// with no policies), so this can only ever be a request-time render.
export const prerender = false;

const key = Astro.params.month ?? '';
if (!parseMonthKey(key)) return Astro.redirect('/month');

// Four independent round trips; nothing here needs anything from the others.
const [watches, reading, visits, activities, months] = await Promise.all([
	listMonthWatches(key),
	getReadingMonth(key),
	listMonthVisits(key),
	listActivitiesForMonth(key),
	listJournalMonths(),
]);

const items = [
	...filmItems(watches),
	...bookItems(reading.days, reading.books),
	...mealItems(visits),
	...activityItems(activities),
];

const cells = buildCells(key, items);
const rows = Math.max(1, cells.length / 7);
const figures = summarise(items);
const total = headline(items);

const aspect = aspectBySlug(Astro.url.searchParams.get('fmt'));
const prev = shiftMonth(key, -1);
const next = shiftMonth(key, 1);
const has = (k: string) => months.some((m) => m.key === k);
const query = monthQuery(aspect);
---

<JournalLayout title={`${monthLabel(key)} · The month in review`}>
	<div class="j-page">
		<div class="head">
			<div>
				<a class="j-back" href="/projects">&larr; Projects</a>
				<div class="head__title">The month in review</div>
			</div>
			<div class="controls">
				<span class="controls__label">Export</span>
				{
					ASPECTS.map((a) => (
						<a
							class:list={['fmt', a.slug === aspect.slug && 'fmt--on']}
							href={`/month/${key}${monthQuery(a)}`}
						>
							{a.id}
						</a>
					))
				}
				<button type="button" class="j-btn" data-save-card>Save image</button>
			</div>
		</div>

		<nav class="stepper">
			{
				has(prev) ? (
					<a class="stepper__go" href={`/month/${prev}${query}`} data-replace>
						&larr; {monthLabel(prev)}
					</a>
				) : (
					<span class="stepper__go stepper__go--off">&larr;</span>
				)
			}
			<a class="stepper__all" href="/month">All months</a>
			{
				has(next) ? (
					<a class="stepper__go" href={`/month/${next}${query}`} data-replace>
						{monthLabel(next)} &rarr;
					</a>
				) : (
					<span class="stepper__go stepper__go--off">&rarr;</span>
				)
			}
		</nav>

		<div class="stage">
			<div class="viewport" data-viewport style={`--h:${aspect.height}px`}>
				<div class="scaler">
					<div class="card" data-card style={`--h:${aspect.height}px; --rows:${rows}`}>
						{/* The margin line and the punch holes are the whole paper
						    illusion; everything else is just warm and ruled. */}
						<span class="card__margin"></span>
						<span class="card__holes"></span>

						<div class="card__head">
							<div>
								<div class="card__kicker">The month in review</div>
								<div class="card__month">{monthLabel(key)}</div>
							</div>
							<div class="card__count">
								<div class="card__countn">{total.hours}</div>
								<div class="card__countl">
									over {total.days} day{total.days === 1 ? '' : 's'}
								</div>
							</div>
						</div>

						<div class="strip">
							<div class="strip__days">{WEEKDAYS.map((d) => <span>{d}</span>)}</div>
							<div class="strip__grid">
								{
									cells.map((c) => (
										<div class:list={['cell', c.outside && 'cell--pad', c.marks.length > 0 && 'cell--used']}>
											{!c.outside && <span class="cell__n">{c.date}</span>}
											{/* Biggest first and centred, so the cluster grows out
											    from the day's main event. Negative gap: the marks
											    overlap slightly, which is what a handful of things
											    stuck onto one square looks like. */}
											<div class="cluster" style={`--cs:${c.scale}`}>
												{c.marks.map((m) => (
													<a
														class:list={['mark', `mark--${m.track}`, !m.image && 'mark--bare']}
														href={m.href ?? undefined}
														style={`--z:${m.size}px; --t:${m.tilt}deg`}
														title={`${m.title} · ${m.detail} · ${Math.round(m.minutes)} min`}
													>
														{m.image ? (
															<img src={m.image} alt="" data-cover />
														) : m.icon ? (
															<svg viewBox="0 0 24 24" aria-hidden="true">
																<path d={m.icon} />
															</svg>
														) : (
															<span class="mark__initial">{m.title.slice(0, 1) || '·'}</span>
														)}
													</a>
												))}
											</div>
										</div>
									))
								}
							</div>
						</div>

						<div class="figures">
							{
								figures.map((f, i) => (
									<div class={`figure figure--${TRACKS[i].id}`}>
										<div class="figure__v">{f.value}</div>
										<div class="figure__l">{f.label}</div>
									</div>
								))
							}
						</div>

						<div class="card__foot">
							<span class="card__url">jqiao.vercel.app</span>
							<span class="card__note">Marks scaled by time spent</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</JournalLayout>

<script>
	// Fit, and save. Both lifted from the restaurant card, minus the map half it
	// doesn't have — see src/pages/restaurants/month/[month].astro for the long
	// version of why the export is a Blob and why touch devices get the share
	// sheet instead of a download.
	const button = document.querySelector<HTMLButtonElement>('[data-save-card]');
	const card = document.querySelector<HTMLElement>('[data-card]');
	const viewport = document.querySelector<HTMLElement>('[data-viewport]');
	const stage = viewport?.parentElement;

	function fit(): void {
		if (!viewport) return;
		const width = stage?.clientWidth ?? 1080;
		viewport.style.setProperty('--s', String(Math.max(0.2, Math.min(0.72, width / 1080))));
	}
	if (viewport) {
		if (stage && 'ResizeObserver' in window) new ResizeObserver(fit).observe(stage);
		else window.addEventListener('resize', fit);
		fit();
	}

	// A cover that never arrives falls back to the mark's own ground rather than
	// leaving a broken image in the cluster.
	for (const img of document.querySelectorAll<HTMLImageElement>('img[data-cover]')) {
		const drop = () => {
			const mark = img.closest('.mark');
			img.remove();
			mark?.classList.add('mark--bare');
		};
		if (img.complete && img.naturalWidth === 0) drop();
		else img.addEventListener('error', drop);
	}

	const shareFile =
		matchMedia('(pointer: coarse)').matches &&
		typeof navigator.share === 'function' &&
		(() => {
			try {
				return !!navigator.canShare?.({
					files: [new File([new Blob()], 'card.png', { type: 'image/png' })],
				});
			} catch {
				return false;
			}
		})();

	let rendered: { state: string; file: File } | null = null;
	const renderState = () => `${location.pathname}${location.search}`;

	const webkit =
		/AppleWebKit/.test(navigator.userAgent) && !/Chrome|Chromium|Edg\//.test(navigator.userAgent);

	async function render(): Promise<Blob | null> {
		if (!card) return null;
		const { toBlob } = await import('html-to-image');
		const options = {
			width: card.offsetWidth,
			height: card.offsetHeight,
			pixelRatio: 1,
			backgroundColor: '#fbf5e6',
			style: { transform: 'none' },
			cacheBust: true,
		};
		const first = await toBlob(card, options);
		return webkit ? await toBlob(card, options) : first;
	}

	button?.addEventListener('click', async () => {
		if (!card) return;
		const idle = button.dataset.label ?? button.textContent ?? 'Save image';
		button.dataset.label = idle;
		const name = `${document.title.split(' ·')[0].replace(/\s+/g, '-').toLowerCase()}-review.png`;

		if (shareFile && rendered?.state === renderState()) {
			try {
				await navigator.share({ files: [rendered.file] });
			} catch (error) {
				if ((error as DOMException)?.name !== 'AbortError')
					button.textContent = 'Could not open the share sheet';
			}
			return;
		}

		let next = idle;
		button.disabled = true;
		button.textContent = 'Drawing…';
		try {
			const blob = await render();
			if (!blob) throw new Error('nothing was rendered');

			if (shareFile) {
				const file = new File([blob], name, { type: 'image/png' });
				rendered = { state: renderState(), file };
				try {
					await navigator.share({ files: [file] });
				} catch (error) {
					const kind = (error as DOMException)?.name;
					if (kind === 'NotAllowedError') next = 'Ready — tap again';
					else if (kind !== 'AbortError') next = 'Could not open the share sheet';
				}
				return;
			}

			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = name;
			a.click();
			setTimeout(() => URL.revokeObjectURL(url), 10_000);
		} catch {
			next = 'Could not draw the card';
		} finally {
			button.disabled = false;
			button.textContent = next;
		}
	});
</script>

<style>
	.head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
	}
	.head__title {
		margin-top: 4px;
		font-family: var(--prose);
		font-size: 27px;
	}
	.controls {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}
	.controls__label {
		font-size: 11px;
		letter-spacing: 1.4px;
		text-transform: uppercase;
		color: var(--ink-3);
	}
	.fmt {
		background: var(--paper);
		border: 1px solid var(--rule-2);
		font-family: var(--mono);
		font-size: 11.5px;
		padding: 5px 10px;
		color: var(--ink-2);
	}
	.fmt--on {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--paper);
	}
	.fmt--on:hover {
		color: var(--paper);
	}

	.stepper {
		margin-top: 14px;
		display: flex;
		align-items: center;
		gap: 16px;
		font-size: 12.5px;
	}
	.stepper__go {
		color: var(--ink-2);
	}
	.stepper__all {
		margin-left: auto;
		color: var(--ink-3);
	}
	.stepper__go--off {
		color: var(--rule-2);
	}

	/* ---- the artboard ----
	   .viewport reserves the scaled footprint; .scaler shrinks the real 1080px
	   card into it, so the export is 1080 wide whatever the screen is. --s comes
	   from the script above. Same rig as the other four cards. */
	.stage {
		margin-top: 20px;
		display: flex;
		justify-content: center;
	}
	.viewport {
		position: relative;
		width: calc(1080px * var(--s, 0.5));
		height: calc(var(--h) * var(--s, 0.5));
	}
	.scaler {
		transform: scale(var(--s, 0.5));
		transform-origin: 0 0;
		width: 1080px;
	}

	.card {
		position: relative;
		width: 1080px;
		height: var(--h);
		/* The page: cream stock, with the grain of a laid paper faked by two very
		   quiet crossing gradients. Any stronger and it stops being paper and
		   starts being a texture. */
		background:
			repeating-linear-gradient(90deg, rgba(120, 96, 60, 0.035) 0 1px, transparent 1px 4px),
			repeating-linear-gradient(0deg, rgba(120, 96, 60, 0.028) 0 1px, transparent 1px 5px),
			#fbf5e6;
		border: 1px solid var(--rule);
		/* Left padding is wider: that column belongs to the margin rule. */
		padding: 52px 54px 44px 96px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}
	/* The red margin line, and the one thing on the card allowed to be red. */
	.card__margin {
		position: absolute;
		left: 74px;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--margin-red);
		opacity: 0.5;
	}
	/* Two punch holes in the margin, drawn as one element so neither of them
	   needs the card's height in its arithmetic — they sit at 30% and 70% of
	   whichever aspect is on screen. */
	.card__holes {
		position: absolute;
		left: 26px;
		top: 0;
		bottom: 0;
		width: 22px;
		background:
			radial-gradient(circle 11px at 50% 30%, var(--ground) 98%, transparent 100%),
			radial-gradient(circle 11px at 50% 70%, var(--ground) 98%, transparent 100%);
	}

	.card__head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		border-bottom: 2px solid var(--ink);
		padding-bottom: 16px;
	}
	.card__kicker {
		font-size: 19px;
		font-weight: 600;
		letter-spacing: 4px;
		text-transform: uppercase;
		color: var(--ink-3);
	}
	.card__month {
		margin-top: 8px;
		font-family: var(--prose);
		font-size: 76px;
		line-height: 0.98;
		letter-spacing: -1.5px;
	}
	.card__count {
		text-align: right;
		white-space: nowrap;
	}
	.card__countn {
		font-family: var(--prose);
		font-size: 60px;
		line-height: 1;
	}
	.card__countl {
		margin-top: 4px;
		font-size: 18px;
		letter-spacing: 1.6px;
		text-transform: uppercase;
		color: var(--ink-3);
	}

	/* The calendar takes whatever the head, the figures and the foot leave. Rows
	   share it evenly, so one grid serves all three aspects — capped so the tall
	   artboard doesn't stretch every cluster into a column of air. */
	.strip {
		margin-top: 22px;
		flex: 1 1 auto;
		min-height: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.strip__days {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 6px;
		font-size: 17px;
		letter-spacing: 2.6px;
		color: var(--ink-4);
		text-transform: uppercase;
		padding-bottom: 8px;
	}
	.strip__grid {
		flex: 1 1 auto;
		min-height: 0;
		max-height: calc(var(--rows) * 200px + (var(--rows) - 1) * 6px);
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		grid-auto-rows: 1fr;
		gap: 6px;
	}

	/* A day is a ruled box. The rules are the journal's, not the calendar's:
	   they run under the cluster the way a lined page runs under whatever you
	   taped onto it. */
	.cell {
		position: relative;
		border: 1px solid var(--rule-3);
		background: repeating-linear-gradient(
			0deg,
			transparent 0 21px,
			rgba(140, 115, 75, 0.14) 21px 22px
		);
		overflow: visible;
	}
	.cell--pad {
		border-color: transparent;
		background: none;
	}
	.cell--used {
		border-color: var(--rule-2);
		/* A day that happened sits on the page rather than in it. */
		z-index: 1;
	}
	.cell__n {
		position: absolute;
		left: 6px;
		top: 3px;
		z-index: 6;
		font-family: var(--mono);
		font-size: 15px;
		color: var(--ink-4);
	}
	.cell--used .cell__n {
		color: var(--ink-2);
	}

	.cluster {
		position: absolute;
		inset: 4px;
		display: flex;
		flex-wrap: wrap;
		align-content: center;
		align-items: center;
		justify-content: center;
		/* Negative, so the marks overlap a little. A cluster of things stuck onto
		   one square is never a neat row of them. */
		gap: 1px;
		margin: -3px;
		/* A busy day shrinks as a whole rather than dropping anything or capping
		   marks one by one — see clusterScale in src/lib/journal-month.ts. --cs
		   is 1 on nearly every day, so this transform usually does nothing. */
		transform: scale(var(--cs, 1));
	}

	.mark {
		display: block;
		position: relative;
		flex: 0 0 auto;
		width: var(--z);
		height: var(--z);
		margin: -3px;
		transform: rotate(var(--t));
		background: var(--paper-2);
		/* The white border is the print margin — it is what makes a poster and a
		   plate and a sport glyph read as the same KIND of object at four wildly
		   different sizes. */
		border: 2px solid #fdf9ef;
		box-shadow: 0 1px 3px rgba(70, 55, 35, 0.32);
		overflow: hidden;
		color: var(--ink-2);
	}
	.mark img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.mark svg {
		position: absolute;
		inset: 18%;
		width: 64%;
		height: 64%;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.mark__initial {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--prose);
		/* Scales with the mark, so a 22px snack and a 76px meal both get a letter
		   that fits rather than one that was sized for the average. */
		font-size: calc(var(--z) * 0.44);
		line-height: 1;
	}

	/* A mark with no picture keeps its track's ink, which is the only place the
	   four colours are load-bearing — a poster says "film" by itself, a blank
	   square doesn't. */
	.mark--bare {
		background: var(--paper);
	}
	.mark--film.mark--bare {
		color: var(--film);
		box-shadow:
			inset 0 0 0 1px var(--film),
			0 1px 3px rgba(70, 55, 35, 0.32);
	}
	.mark--book.mark--bare {
		color: var(--book);
		box-shadow:
			inset 0 0 0 1px var(--book),
			0 1px 3px rgba(70, 55, 35, 0.32);
	}
	.mark--meal.mark--bare {
		color: var(--meal);
		box-shadow:
			inset 0 0 0 1px var(--meal),
			0 1px 3px rgba(70, 55, 35, 0.32);
	}
	.mark--move {
		color: var(--move);
		background: #eef4f1;
		box-shadow:
			inset 0 0 0 1px var(--move),
			0 1px 3px rgba(70, 55, 35, 0.32);
	}

	.figures {
		margin-top: 24px;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
	}
	.figure {
		padding: 16px 18px;
		border-left: 1px solid var(--rule-3);
	}
	.figure:first-child {
		border-left: none;
		padding-left: 0;
	}
	.figure__v {
		font-family: var(--prose);
		font-size: 50px;
		line-height: 1;
	}
	/* The label carries the track's colour as a rule under it — the legend for
	   the marks above, without a legend row. */
	.figure__l {
		margin-top: 8px;
		display: inline-block;
		font-size: 18px;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: var(--ink-3);
		border-bottom: 3px solid currentColor;
		padding-bottom: 3px;
	}
	.figure--film .figure__l {
		color: var(--film);
	}
	.figure--book .figure__l {
		color: var(--book);
	}
	.figure--meal .figure__l {
		color: var(--meal);
	}
	.figure--move .figure__l {
		color: var(--move);
	}

	.card__foot {
		padding-top: 20px;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 24px;
	}
	.card__url {
		font-size: 24px;
		letter-spacing: 2.6px;
		text-transform: uppercase;
		color: var(--ink-4);
	}
	.card__note {
		font-size: 15px;
		letter-spacing: 1.2px;
		text-transform: uppercase;
		color: var(--rule);
	}
</style>
