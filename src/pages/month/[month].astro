---
// The month in review — films, books, meals and activities on one calendar.
//
// The fifth card in the family, and the first that isn't a section's. The four
// section cards each answer "how was the month in X"; this one answers "what
// were the days like", which none of them can, because a day is not made of one
// track. So a cell is a CLUSTER: one mark per thing done, each sized by the
// time it took (src/lib/journal-month.ts has the weights and the argument for
// them), tilted a little, overlapping its neighbours the way things stuck into
// a journal overlap.
//
// WHY IT LOOKS LIKE PAPER. The four section cards are each art-directed to
// their own section, and none of those directions can host the other three
// without annexing them. What all four have in common is upstream of all of
// them: I kept a paper journal first. Cream stock, a printed rule, ink. It is
// the one reference that belongs to no section, so it's the one that can hold
// all four.
//
// THE MARGIN AND THE PUNCH HOLES ARE GONE. They cost 42px of the artboard's
// width — a third of a day's square — and the calendar is what the card is
// for. The stock and the ruling carry the reference on their own.
//
// The calendar arithmetic and the artboard are the family's shared ones
// (share-card.ts), and the export is the same one the other four use.
import JournalLayout from '../../layouts/JournalLayout.astro';
import { listMonthWatches } from '../../lib/films';
import { getReadingMonth } from '../../lib/books-queries';
import { listMonthVisits } from '../../lib/restaurants';
import { listActivitiesForMonth } from '../../lib/activities';
import {
	activityItems,
	bookItems,
	buildCells,
	cellBox,
	filmItems,
	mealItems,
} from '../../lib/journal-month';
import {
	ASPECTS,
	aspectBySlug,
	monthLabel,
	monthQuery,
	parseMonthKey,
	shiftMonth,
	WEEKDAYS,
	weekRows,
} from '../../lib/share-card';
import { listJournalMonths } from '../../lib/journal-months';
import { requireOwner } from '../../lib/auth';

// The books query runs on the service-role client (the reading tables have RLS
// with no policies), so this can only ever be a request-time render.
export const prerender = false;

// OWNER ONLY, and more so than the per-section month pages: this is all four
// logs on one sheet — where they ate, what they read, what they watched and
// the routes they rode, day by day for a month. The single-section versions
// already gate (films, books, restaurants, activities); this one is their
// union and has to gate at least as hard.
if (!(await requireOwner(Astro.cookies))) {
	return Astro.redirect(`/films/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

const key = Astro.params.month ?? '';
if (!parseMonthKey(key)) return Astro.redirect('/month');

// Four independent round trips; nothing here needs anything from the others.
// `true` on the activities call is isOwner — unredacted, which the gate above
// has just established. Without it every activity arrives stripped to a sport
// and a date, since 0043 made them private by default.
const [watches, reading, visits, activities, months] = await Promise.all([
	listMonthWatches(key),
	getReadingMonth(key),
	listMonthVisits(key),
	listActivitiesForMonth(key, true),
	listJournalMonths(),
]);

const items = [
	...filmItems(watches),
	...bookItems(reading.days, reading.books),
	...mealItems(visits),
	// The one editorial filter on this page: activities the owner has ticked
	// "hide from the month in review" (0044). Applied here rather than in the
	// query so the column stays a /month concern and nothing else has to know
	// about it.
	...activityItems(activities.filter((a) => !a.hide_from_review)),
];

const aspect = aspectBySlug(Astro.url.searchParams.get('fmt'));
const rows = weekRows(key);

// The pile is scattered around the middle of a day rather than fitted inside
// it, so how far a print may travel is a question about the day's square — and
// that square is 167px tall on a Feed card and 230 on a Story one. Both the
// print sizes and the shape of the scatter come off it, which is why the aspect
// has to be known before the cells are built rather than after.
const cells = buildCells(key, items, cellBox(rows, aspect.height));

const prev = shiftMonth(key, -1);
const next = shiftMonth(key, 1);
const has = (k: string) => months.some((m) => m.key === k);
const query = monthQuery(aspect);
---

<JournalLayout title={`${monthLabel(key)} · The month in review`}>
	<div class="j-page">
		<div class="head">
			<div>
				<a class="j-back" href="/projects">&larr; Projects</a>
				<div class="head__title">The month in review</div>
			</div>
			<div class="controls">
				<span class="controls__label">Export</span>
				{
					ASPECTS.map((a) => (
						<a
							class:list={['fmt', a.slug === aspect.slug && 'fmt--on']}
							href={`/month/${key}${monthQuery(a)}`}
						>
							{a.id}
						</a>
					))
				}
				<button type="button" class="j-btn" data-save-card>Save image</button>
			</div>
		</div>

		<nav class="stepper">
			{
				has(prev) ? (
					<a class="stepper__go" href={`/month/${prev}${query}`} data-replace>
						&larr; {monthLabel(prev)}
					</a>
				) : (
					<span class="stepper__go stepper__go--off">&larr;</span>
				)
			}
			<a class="stepper__all" href="/month">All months</a>
			{
				has(next) ? (
					<a class="stepper__go" href={`/month/${next}${query}`} data-replace>
						{monthLabel(next)} &rarr;
					</a>
				) : (
					<span class="stepper__go stepper__go--off">&rarr;</span>
				)
			}
		</nav>

		<div class="stage">
			<div class="viewport" data-viewport style={`--h:${aspect.height}px`}>
				<div class="scaler">
					<div class="card" data-card style={`--h:${aspect.height}px; --rows:${rows}`}>
						<div class="card__head">
							<div class="card__kicker">The month in review</div>
							<div class="card__month">{monthLabel(key)}</div>
						</div>

						<div class="strip">
							<div class="strip__days">{WEEKDAYS.map((d) => <span>{d}</span>)}</div>
							<div class="strip__grid">
								{
									cells.map((c) => (
										<div
											class:list={['cell', c.outside && 'cell--pad', c.marks.length > 0 && 'cell--used']}
											style={`--layer:${c.layer}`}
										>
											{!c.outside && <span class="cell__n">{c.date}</span>}
											{/* Biggest first: the day's main event is placed at the
											    centre and the rest are scattered over it, so the later
											    ones in source order also paint on top — which is the
											    order you would have stuck them in. */}
											<div class="cluster">
												{c.marks.map((m) => (
													<a
														class:list={['mark', `mark--${m.track}`, !m.image && !m.route && 'mark--bare']}
														href={m.href ?? undefined}
														style={`--w:${m.box.w}px; --h:${m.box.h}px; --t:${m.tilt}deg; --dx:${m.dx}px; --dy:${m.dy}px`}
														title={`${m.title} · ${m.detail} · ${Math.round(m.minutes)} min`}
													>
														{m.image ? (
															<img src={m.image} alt="" data-cover />
														) : m.route ? (
															/* The route as it was ridden. route-shape.ts has
															   already fitted it to this square viewBox, so the
															   stroke is all that's left to say. */
															<svg
																class="mark__route"
																viewBox="0 0 100 100"
																preserveAspectRatio="xMidYMid meet"
																aria-hidden="true"
															>
																<path d={m.route} />
															</svg>
														) : m.icon ? (
															<svg class="mark__glyph" viewBox="0 0 24 24" aria-hidden="true">
																<path d={m.icon} />
															</svg>
														) : (
															<span class="mark__initial">{m.title.slice(0, 1) || '·'}</span>
														)}
													</a>
												))}
											</div>
										</div>
									))
								}
							</div>
						</div>

						<div class="card__foot">
							<span class="card__url">jqiao.vercel.app</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</JournalLayout>

<script>
	// Fit, and save. Both lifted from the restaurant card, minus the map half it
	// doesn't have — see src/pages/restaurants/month/[month].astro for the long
	// version of why the export is a Blob and why touch devices get the share
	// sheet instead of a download.
	const button = document.querySelector<HTMLButtonElement>('[data-save-card]');
	const card = document.querySelector<HTMLElement>('[data-card]');
	const viewport = document.querySelector<HTMLElement>('[data-viewport]');
	const stage = viewport?.parentElement;

	function fit(): void {
		if (!viewport) return;
		const width = stage?.clientWidth ?? 1080;
		viewport.style.setProperty('--s', String(Math.max(0.2, Math.min(0.72, width / 1080))));
	}
	if (viewport) {
		if (stage && 'ResizeObserver' in window) new ResizeObserver(fit).observe(stage);
		else window.addEventListener('resize', fit);
		fit();
	}

	// A cover that never arrives falls back to the mark's own ground rather than
	// leaving a broken image in the cluster.
	for (const img of document.querySelectorAll<HTMLImageElement>('img[data-cover]')) {
		const drop = () => {
			const mark = img.closest('.mark');
			img.remove();
			mark?.classList.add('mark--bare');
		};
		if (img.complete && img.naturalWidth === 0) drop();
		else img.addEventListener('error', drop);
	}

	const shareFile =
		matchMedia('(pointer: coarse)').matches &&
		typeof navigator.share === 'function' &&
		(() => {
			try {
				return !!navigator.canShare?.({
					files: [new File([new Blob()], 'card.png', { type: 'image/png' })],
				});
			} catch {
				return false;
			}
		})();

	let rendered: { state: string; file: File } | null = null;
	const renderState = () => `${location.pathname}${location.search}`;

	const webkit =
		/AppleWebKit/.test(navigator.userAgent) && !/Chrome|Chromium|Edg\//.test(navigator.userAgent);

	async function render(): Promise<Blob | null> {
		if (!card) return null;
		const { toBlob } = await import('html-to-image');
		const options = {
			width: card.offsetWidth,
			height: card.offsetHeight,
			pixelRatio: 1,
			backgroundColor: '#fbf5e6',
			style: { transform: 'none' },
			// EVERY OPTIMISED PHOTO IS THE SAME URL UNTIL THE `?`. html-to-image
			// caches each fetched resource under `url.replace(/\?.*/, '')` unless
			// this is set (dataurl.js, `getCacheKey`) — and `photoSrc` returns
			// `/_vercel/image?url=…&w=320`, so every photograph on the card hashes
			// to the one key `/_vercel/image`. The first one fetched was then
			// handed back for all of them, and the export came out with the same
			// plate on every day it drew. Posters and covers are absolute URLs with
			// distinct paths, which is why only the photographs collapsed.
			includeQueryParams: true,
			cacheBust: true,
		};
		const first = await toBlob(card, options);
		return webkit ? await toBlob(card, options) : first;
	}

	button?.addEventListener('click', async () => {
		if (!card) return;
		const idle = button.dataset.label ?? button.textContent ?? 'Save image';
		button.dataset.label = idle;
		const name = `${document.title.split(' ·')[0].replace(/\s+/g, '-').toLowerCase()}-review.png`;

		if (shareFile && rendered?.state === renderState()) {
			try {
				await navigator.share({ files: [rendered.file] });
			} catch (error) {
				if ((error as DOMException)?.name !== 'AbortError')
					button.textContent = 'Could not open the share sheet';
			}
			return;
		}

		let next = idle;
		button.disabled = true;
		button.textContent = 'Drawing…';
		try {
			const blob = await render();
			if (!blob) throw new Error('nothing was rendered');

			if (shareFile) {
				const file = new File([blob], name, { type: 'image/png' });
				rendered = { state: renderState(), file };
				try {
					await navigator.share({ files: [file] });
				} catch (error) {
					const kind = (error as DOMException)?.name;
					if (kind === 'NotAllowedError') next = 'Ready — tap again';
					else if (kind !== 'AbortError') next = 'Could not open the share sheet';
				}
				return;
			}

			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = name;
			a.click();
			setTimeout(() => URL.revokeObjectURL(url), 10_000);
		} catch {
			next = 'Could not draw the card';
		} finally {
			button.disabled = false;
			button.textContent = next;
		}
	});
</script>

<style>
	.head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
	}
	.head__title {
		margin-top: 4px;
		font-family: var(--prose);
		font-size: 27px;
	}
	.controls {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}
	.controls__label {
		font-size: 11px;
		letter-spacing: 1.4px;
		text-transform: uppercase;
		color: var(--ink-3);
	}
	.fmt {
		background: var(--paper);
		border: 1px solid var(--rule-2);
		font-family: var(--mono);
		font-size: 11.5px;
		padding: 5px 10px;
		color: var(--ink-2);
	}
	.fmt--on {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--paper);
	}
	.fmt--on:hover {
		color: var(--paper);
	}

	.stepper {
		margin-top: 14px;
		display: flex;
		align-items: center;
		gap: 16px;
		font-size: 12.5px;
	}
	.stepper__go {
		color: var(--ink-2);
	}
	.stepper__all {
		margin-left: auto;
		color: var(--ink-3);
	}
	.stepper__go--off {
		color: var(--rule-2);
	}

	/* ---- the artboard ----
	   .viewport reserves the scaled footprint; .scaler shrinks the real 1080px
	   card into it, so the export is 1080 wide whatever the screen is. --s comes
	   from the script above. Same rig as the other four cards. */
	.stage {
		margin-top: 20px;
		display: flex;
		justify-content: center;
	}
	.viewport {
		position: relative;
		width: calc(1080px * var(--s, 0.5));
		height: calc(var(--h) * var(--s, 0.5));
	}
	.scaler {
		transform: scale(var(--s, 0.5));
		transform-origin: 0 0;
		width: 1080px;
	}

	.card {
		position: relative;
		width: 1080px;
		height: var(--h);
		/* The page: cream stock, with the grain of a laid paper faked by two very
		   quiet crossing gradients. Any stronger and it stops being paper and
		   starts being a texture. */
		background:
			repeating-linear-gradient(90deg, rgba(120, 96, 60, 0.035) 0 1px, transparent 1px 4px),
			repeating-linear-gradient(0deg, rgba(120, 96, 60, 0.028) 0 1px, transparent 1px 5px),
			#fbf5e6;
		border: 1px solid var(--rule);
		padding: 52px 54px 44px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}
	.card__head {
		border-bottom: 2px solid var(--ink);
		padding-bottom: 16px;
	}
	.card__kicker {
		font-size: 19px;
		font-weight: 600;
		letter-spacing: 4px;
		text-transform: uppercase;
		color: var(--ink-3);
	}
	.card__month {
		margin-top: 8px;
		font-family: var(--prose);
		font-size: 76px;
		line-height: 0.98;
		letter-spacing: -1.5px;
	}

	/* The calendar takes everything the head and the foot leave, which since the
	   summary band came out is nearly the whole artboard. Rows share it evenly,
	   so one grid serves all three aspects — capped so the tall artboard doesn't
	   stretch every cluster into a column of air. */
	.strip {
		margin-top: 22px;
		flex: 1 1 auto;
		min-height: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.strip__days {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 6px;
		font-size: 17px;
		letter-spacing: 2.6px;
		color: var(--ink-4);
		text-transform: uppercase;
		padding-bottom: 8px;
	}
	.strip__grid {
		flex: 1 1 auto;
		min-height: 0;
		max-height: calc(var(--rows) * 230px + (var(--rows) - 1) * 6px);
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		grid-auto-rows: 1fr;
		gap: 6px;
	}

	/* A day is a ruled box. The rules are the journal's, not the calendar's:
	   they run under the cluster the way a lined page runs under whatever you
	   taped onto it. */
	.cell {
		position: relative;
		border: 1px solid var(--rule-3);
		background: repeating-linear-gradient(
			0deg,
			transparent 0 21px,
			rgba(140, 115, 75, 0.14) 21px 22px
		);
		overflow: visible;
	}
	.cell--pad {
		border-color: transparent;
		background: none;
	}
	/* THE SPILL. A day's marks are bigger than its square on purpose, so they
	   overlap the days around them, and the overlap needs a paint order: later
	   days on top, because that is the order things got stuck in. --layer is the
	   date, so the 31st covers the 30th covers the 29th. */
	.cell--used {
		border-color: var(--rule-2);
		z-index: var(--layer, 1);
	}
	.cell__n {
		position: absolute;
		left: 6px;
		top: 3px;
		z-index: 6;
		font-family: var(--mono);
		font-size: 15px;
		color: var(--ink-4);
	}
	.cell--used .cell__n {
		color: var(--ink-2);
	}

	/* The pile. Every print is placed by hand — an angle and a distance from the
	   middle of the day, worked out in src/lib/journal-month.ts — rather than
	   flowed. A flex line can only make rows, and rows use the top of a square
	   and leave the rest of it empty. */
	.cluster {
		position: absolute;
		inset: 0;
	}

	/* A mark is a print stuck to the page: its own shape, its own white margin,
	   a shadow that lifts it off the paper. The box comes from the lib — area is
	   the time it took, the ratio is the shape of the thing — so a poster is
	   tall, a plate is whatever it was shot at, and a route is square. */
	.mark {
		display: block;
		position: absolute;
		left: 50%;
		top: 50%;
		width: var(--w);
		height: var(--h);
		/* Centred on its own placement, then tilted. Order matters: rotating
		   before the centring translate would swing the print around the day's
		   centre instead of its own. */
		transform: translate(-50%, -50%) translate(var(--dx), var(--dy)) rotate(var(--t));
		background: var(--paper-2);
		border: 3px solid #fdfaf1;
		box-shadow:
			0 1px 2px rgba(70, 55, 35, 0.3),
			0 3px 8px rgba(70, 55, 35, 0.18);
		overflow: hidden;
		color: var(--ink-2);
	}
	/* A print sits above the ruled paper of whatever day it lands on, including
	   the date numeral — the grid is a scaffold, the pictures are the page. */
	.mark:hover {
		z-index: 40;
	}
	.mark img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	/* The route fills its print the way a photograph would; the fallback glyph
	   sits small and centred, so the two never read as the same kind of face. */
	.mark__route {
		position: absolute;
		inset: 8%;
		width: 84%;
		height: 84%;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.6;
		stroke-linecap: round;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}
	.mark__glyph {
		position: absolute;
		inset: 22%;
		width: 56%;
		height: 56%;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.mark__initial {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--prose);
		/* Scales with the mark, so a small snack and a big meal both get a letter
		   that fits rather than one sized for the average. */
		font-size: calc(var(--h) * 0.44);
		line-height: 1;
	}

	/* A mark with no picture keeps its track's ink, which is the only place the
	   four colours are load-bearing — a poster says "film" by itself, a blank
	   square doesn't.

	   THE RING IS A LAID-OUT BOX, NOT AN INSET SHADOW. It was
	   `box-shadow: inset 0 0 0 1px`, which the renderer the card gets exported
	   through paints a few px above the padding box: the top edge ends up buried
	   under the mark's own 3px white border and the bottom edge floats short of
	   it, so a bare meal or activity came out with three sides of a frame. An
	   ::after with a real border is placed by layout, so it cannot drift. */
	.mark--bare::after,
	.mark--move::after {
		content: '';
		position: absolute;
		inset: 0;
		border: 1px solid currentColor;
	}
	.mark--bare {
		background: var(--paper);
		box-shadow: 0 1px 3px rgba(70, 55, 35, 0.32);
	}
	.mark--film.mark--bare {
		color: var(--film);
	}
	.mark--book.mark--bare {
		color: var(--book);
	}
	.mark--meal.mark--bare {
		color: var(--meal);
	}
	.mark--move {
		color: var(--move);
		background: #eef4f1;
		box-shadow: 0 1px 3px rgba(70, 55, 35, 0.32);
	}

	.card__foot {
		padding-top: 20px;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 24px;
	}
	.card__url {
		font-size: 24px;
		letter-spacing: 2.6px;
		text-transform: uppercase;
		color: var(--ink-4);
	}
</style>
