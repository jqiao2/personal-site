---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About">
	<h1>About</h1>

	<section>
		<h2>Experience</h2>
		<p><em>Add your work history here — company, title, dates, and a couple of bullet points per role.</em></p>
	</section>

	<section>
		<h2>Skills</h2>
		<p><em>Add languages, frameworks, and tools here.</em></p>
	</section>

	<section>
		<h2>Education</h2>
		<p><em>Add degrees, schools, and dates here.</em></p>
	</section>
</Layout>
