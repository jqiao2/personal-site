---
// Owner-only: rank every watched film into one list, Beli-style. Each unranked
// film is binary-searched into the ranked list one A-or-B question at a time
// (A is already ranked, B is being placed); pivots favour similar films first,
// see film-rank-pick.ts. Three films are placed at once and each question goes
// to a random one of them, so the same film doesn't come up turn after turn.
// The list underneath can be edited: drag a film to move it, or ↻ to rank it
// again. The order is saved after every change, so the work can be spread over
// days. Films half-way through being placed are kept in localStorage.
import FilmLayout from '../../layouts/FilmLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { requireOwner } from '../../lib/auth';
import { loadRanking } from '../../lib/film-rank';

export const prerender = false;

if (!(await requireOwner(Astro.cookies))) return Astro.redirect('/films/login');

// `<` escaped so a title can never close the script tag it is embedded in.
const data = JSON.stringify(await loadRanking()).replace(/</g, '\\u003c');
---

<FilmLayout title="Rank — Jason's film log">
	<div class="page">
		<div class="wrap">
			<SiteHeader pathname={Astro.url.pathname} theme="film" max="1064px" />

			<header class="topbar">
				<a class="back" href="/films">
					<span class="back__arrow">←</span><span>Films</span>
				</a>
				<span class="topbar__tag" id="progress"></span>
			</header>

			<section id="duel" hidden>
				<div class="pair">
					<button type="button" class="card" data-pick="a">
						<span class="card__rank" id="a-rank"></span>
						<img class="card__poster" id="a-poster" alt="" />
						<span class="card__title" id="a-title"></span>
						<span class="card__meta" id="a-meta"></span>
					</button>
					<span class="or">or</span>
					<button type="button" class="card" data-pick="b">
						<span class="card__rank card__rank--new" id="b-range"></span>
						<img class="card__poster" id="b-poster" alt="" />
						<span class="card__title" id="b-title"></span>
						<span class="card__meta" id="b-meta"></span>
					</button>
					<div class="controls">
						<button type="button" class="btn-ghost" data-pick="tie">Too close <kbd>↑</kbd></button>
						<button type="button" class="btn-ghost" data-pick="skip">Skip <kbd>S</kbd></button>
						<button type="button" class="btn-ghost" data-pick="undo">Undo <kbd>Z</kbd></button>
					</div>
					<div class="info info--a" id="a-info"></div>
					<div class="info info--b" id="b-info"></div>
				</div>
				<p class="status" id="status" role="status"></p>
			</section>

			<p class="done" id="done" hidden>Every film is ranked.</p>

			<ol class="list" id="list"></ol>
		</div>
	</div>

	<script is:inline type="application/json" id="rank-data" set:html={data} />

	<style>
		.page {
			overflow-x: hidden;
			display: flex;
			justify-content: center;
			padding: 0 24px 80px;
		}
		.wrap {
			width: 100%;
			max-width: 1000px;
		}
		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 26px 0 22px;
			border-bottom: 1px solid #4a2529;
			margin-bottom: 34px;
		}
		.back {
			display: flex;
			align-items: center;
			gap: 9px;
			font-size: 13px;
			color: #a2857a;
		}
		.back:hover {
			color: #f4e8d1;
		}
		.back__arrow {
			font-size: 15px;
		}
		.topbar__tag {
			font-size: 11.5px;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #8a6f63;
		}

		.pair {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			gap: 14px 20px;
			max-width: 600px;
			margin: 0 auto;
		}
		.info {
			align-self: start;
			font-size: 13px;
			line-height: 1.5;
			color: #c9b59c;
		}
		.info--a {
			grid-column: 1;
		}
		.info--b {
			grid-column: 3;
		}
		.info :global(.rated) {
			margin: 0 0 6px;
			font-size: 15px;
			color: #d9b45a;
		}
		.info :global(.rated .liked) {
			color: #e0806a;
			margin-left: 6px;
		}
		.info :global(.rated .none) {
			font-size: 12.5px;
			color: #8a6f63;
		}
		.info :global(.links) {
			display: flex;
			gap: 14px;
			margin: 0 0 10px;
			font-size: 12.5px;
		}
		.info :global(.links a:hover) {
			color: #f4e8d1;
		}
		.info :global(.entries) {
			max-height: 260px;
			overflow-y: auto;
		}
		.info :global(.entry) {
			padding: 8px 0;
			border-top: 1px solid #4a2529;
		}
		.info :global(.entry__head) {
			font-size: 11.5px;
			color: #8a6f63;
		}
		.info :global(.entry p) {
			margin: 4px 0 0;
			white-space: pre-line;
		}
		.info :global(.entry .note) {
			font-style: italic;
			color: #a2857a;
		}
		.or {
			align-self: center;
			font-family: var(--font-newsreader);
			font-style: italic;
			font-size: 20px;
			color: #8a6f63;
		}
		.card {
			display: flex;
			flex-direction: column;
			gap: 8px;
			padding: 14px;
			border: 1px solid #4a2529;
			border-radius: 10px;
			background: transparent;
			color: inherit;
			font: inherit;
			text-align: left;
			cursor: pointer;
		}
		.card:hover,
		.card:focus-visible {
			border-color: #d9b45a;
		}
		.card__rank {
			font-size: 11.5px;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #a2857a;
		}
		.card__rank--new {
			color: #d9b45a;
		}
		.card__poster {
			width: 100%;
			aspect-ratio: 2 / 3;
			object-fit: cover;
			border-radius: 4px;
			background: #2a1517;
		}
		.card__title {
			font-family: var(--font-newsreader);
			font-size: 21px;
			line-height: 1.15;
			color: #f4e8d1;
		}
		.card__meta {
			font-size: 12.5px;
			color: #a2857a;
		}

		.controls {
			display: flex;
			grid-column: 1 / -1;
			justify-content: center;
			gap: 10px;
			flex-wrap: wrap;
		}
		.btn-ghost {
			font-size: 12.5px;
			padding: 10px 16px;
			border-radius: 8px;
			cursor: pointer;
			font-family: var(--font-archivo);
			border: 1px solid #6b4a42;
			background: transparent;
			color: #f0d488;
			white-space: nowrap;
		}
		.btn-ghost:hover {
			border-color: #d9b45a;
		}
		.btn-ghost:disabled {
			opacity: 0.4;
			cursor: default;
		}
		kbd {
			font-family: inherit;
			font-size: 11px;
			color: #8a6f63;
			margin-left: 4px;
		}
		.status {
			min-height: 1.2em;
			text-align: center;
			font-size: 12.5px;
			color: #e0806a;
		}
		.done {
			text-align: center;
			font-family: var(--font-newsreader);
			font-size: 24px;
		}

		.list {
			margin: 48px 0 0;
			padding: 24px 0 0 3em;
			border-top: 1px solid #4a2529;
			columns: 3 260px;
			column-gap: 32px;
			font-size: 13.5px;
			line-height: 1.7;
			color: #f4e8d1;
		}
		.list :global(li) {
			break-inside: avoid;
		}
		.list :global(li::marker) {
			color: #8a6f63;
			font-variant-numeric: tabular-nums;
		}
		.list :global(.yr) {
			color: #8a6f63;
		}
		.list :global(.just) {
			color: #d9b45a;
		}
		.list :global(li[draggable]) {
			cursor: grab;
		}
		.list :global(li.over) {
			box-shadow: 0 -2px 0 #d9b45a;
		}
		.list :global(.rerank) {
			margin-left: 4px;
			padding: 0 4px;
			border: 0;
			background: transparent;
			color: #8a6f63;
			font: inherit;
			cursor: pointer;
		}
		.list :global(.rerank:hover) {
			color: #f0d488;
		}
		@media (hover: hover) {
			.list :global(li:not(:hover) .rerank) {
				visibility: hidden;
			}
		}

		@media (max-width: 560px) {
			.pair {
				gap: 10px;
			}
			.card {
				padding: 8px;
			}
			.card__title {
				font-size: 17px;
			}
		}
	</style>

	<script>
		import { insertAt, pickPivot, removeAt, type Placing } from '../../lib/film-rank-pick';
		import type { RankCard } from '../../lib/film-rank';

		type State = {
			order: number[];
			queue: number[];
			/** Films being placed; each question goes to one of them. */
			open: Placing[];
			/** The question on screen: `id` (being placed) against order[pivot]. */
			q: { id: number; pivot: number } | null;
			just: number | null;
		};

		const IN_FLIGHT = 3;

		// SAFETY: the payload is loadRanking()'s return value, serialised by this page's frontmatter.
		const { films, order } = JSON.parse(document.getElementById('rank-data')!.textContent!) as {
			films: RankCard[];
			order: number[];
		};

		const byId = new Map(films.map((f) => [f.id, f]));

		const $ = (id: string) => document.getElementById(id)!;

		const shuffle = <T,>(xs: T[]) => {
			for (let i = xs.length - 1; i > 0; i--) {
				const j = Math.floor(Math.random() * (i + 1));
				[xs[i], xs[j]] = [xs[j], xs[i]];
			}

			return xs;
		};

		const ranked = new Set(order);

		// Half-placed films survive a reload in this browser. Their ranges are indexes
		// into the order they were narrowed against, so they're only kept while the
		// saved order still matches it.
		const OPEN_KEY = 'film-rank-open';

		const restoreOpen = (): Placing[] => {
			try {
				// SAFETY: written by persistOpen below; every field is checked before use.
				const kept = JSON.parse(localStorage.getItem(OPEN_KEY) ?? 'null') as { order: number[]; open: Placing[] } | null;

				if (kept?.order?.join() !== order.join()) return [];

				const seen = new Set<number>();

				return kept.open.filter((p) => {
					const ok =
						byId.has(p.id) &&
						!ranked.has(p.id) &&
						!seen.has(p.id) &&
						Number.isInteger(p.lo) &&
						Number.isInteger(p.hi) &&
						p.lo >= 0 &&
						p.lo < p.hi &&
						p.hi <= order.length;

					seen.add(p.id);

					return ok;
				});
			} catch {
				return [];
			}
		};

		const persistOpen = () => {
			try {
				localStorage.setItem(OPEN_KEY, JSON.stringify({ order: s.order, open: s.open }));
			} catch {
				// Storage blocked: half-placed films just start over on reload.
			}
		};

		const restored = restoreOpen();

		const placing = new Set(restored.map((p) => p.id));

		// `order` arrays are never mutated, only replaced, so a snapshot can share them.
		let s: State = {
			order,
			queue: shuffle(films.filter((f) => !ranked.has(f.id) && !placing.has(f.id)).map((f) => f.id)),
			open: restored,
			q: null,
			just: null,
		};

		const history: State[] = [];

		const remember = () => {
			history.push({ ...s, queue: s.queue.slice(), open: s.open.map((p) => ({ ...p })), q: s.q && { ...s.q } });

			if (history.length > 300) history.shift();
		};

		// The whole order goes up each time, so a failed save is healed by the next one.
		let saved = order;

		const save = async () => {
			const sending = s.order;

			if (sending === saved) return;

			try {
				const res = await fetch('/api/films/ranking', {
					method: 'PUT',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ order: sending }),
					keepalive: true,
				});

				if (!res.ok) throw new Error((await res.json().catch(() => null))?.error ?? res.statusText);

				saved = sending;
				$('status').textContent = '';
			} catch (e) {
				$('status').textContent = `Not saved: ${e instanceof Error ? e.message : e}`;
			}
		};

		const rankedFilms = () => s.order.map((id) => byId.get(id)!);

		const place = (p: Placing, at: number) => {
			s.open = s.open.filter((x) => x !== p);
			s.order = insertAt(s.order, at, p.id, s.open);
			s.just = p.id;
		};

		/**
		 * Top the open films up from the queue and set the next question: `prefer`'s if
		 * it is open, else a random open film other than the one just asked about.
		 */
		const ask = (prefer?: number) => {
			for (;;) {
				const settled = s.open.find((p) => p.lo >= p.hi);

				if (settled) {
					// An edit to the list can leave a range empty: its place is known.
					place(settled, settled.lo);
				} else if (s.open.length < IN_FLIGHT && s.queue.length) {
					const id = s.queue.shift()!;

					if (s.order.length === 0) {
						s.order = [id];
						s.just = id;
					} else s.open.push({ id, lo: 0, hi: s.order.length });
				} else break;
			}

			const others = s.open.filter((p) => p.id !== s.q?.id);
			const pool = others.length ? others : s.open;
			const p = s.open.find((x) => x.id === prefer) ?? pool[Math.floor(Math.random() * pool.length)];

			s.q = p ? { id: p.id, pivot: pickPivot(rankedFilms(), p.lo, p.hi, byId.get(p.id)!) } : null;
		};

		const meta = (f: RankCard) => [f.year, f.directors.join(', ')].filter(Boolean).join(' · ');

		const el = (tag: string, cls: string, text?: string) => {
			const n = document.createElement(tag);

			n.className = cls;

			if (text != null) n.textContent = text;

			return n;
		};

		const link = (href: string, text: string) => {
			const a = document.createElement('a');

			a.href = href;
			a.target = '_blank';
			a.rel = 'noopener';
			a.textContent = text;

			return a;
		};

		// The exact article via Wikidata's TMDB id (P4947); a search until that answers,
		// or for good when Wikidata has no match.
		const wikiSearch = (f: RankCard) =>
			`https://en.wikipedia.org/w/index.php?search=${encodeURIComponent(`${f.title} ${f.year ?? ''} film`)}`;

		const wikiCache = new Map<number, Promise<string | null>>();

		const wikiArticle = (tmdbId: number) => {
			let hit = wikiCache.get(tmdbId);

			if (!hit) {
				const q = `SELECT ?a WHERE { ?f wdt:P4947 "${tmdbId}" . ?a schema:about ?f ; schema:isPartOf <https://en.wikipedia.org/> . } LIMIT 1`;

				hit = fetch(`https://query.wikidata.org/sparql?format=json&query=${encodeURIComponent(q)}`)
					.then((r) => (r.ok ? r.json() : null))
					.then((j) => j?.results?.bindings?.[0]?.a?.value ?? null)
					.catch(() => null);
				wikiCache.set(tmdbId, hit);
			}

			return hit;
		};

		const showInfo = (side: 'a' | 'b', f: RankCard) => {
			const rated = el('p', 'rated', f.stars ?? '');

			if (!f.stars) rated.append(el('span', 'none', 'Unrated'));

			if (f.liked) rated.append(el('span', 'liked', '♥'));

			const wiki = link(wikiSearch(f), 'Wikipedia ↗');

			void wikiArticle(f.tmdbId).then((url) => {
				if (url) wiki.href = url;
			});

			const links = el('p', 'links');

			links.append(link(`/films/movie/${f.tmdbId}`, 'Film page ↗'), wiki);

			const entries = el('div', 'entries');

			for (const e of f.entries) {
				const entry = el('div', 'entry');

				entry.append(el('span', 'entry__head', [e.date, e.stars].filter(Boolean).join(' · ') || 'Undated'));

				if (e.review) entry.append(el('p', 'review', e.review));

				if (e.note) entry.append(el('p', 'note', e.note));
				entries.append(entry);
			}

			$(`${side}-info`).replaceChildren(rated, links, entries);
		};

		const show = (side: 'a' | 'b', f: RankCard) => {
			showInfo(side, f);
			const img = document.querySelector<HTMLImageElement>(`#${side}-poster`)!;

			if (f.poster) img.src = f.poster;
			else img.removeAttribute('src');
			$(`${side}-title`).textContent = f.title;
			$(`${side}-meta`).textContent = meta(f);
		};

		const render = () => {
			persistOpen();
			$('progress').textContent = `${s.order.length.toLocaleString()} of ${films.length.toLocaleString()} ranked`;

			$('duel').hidden = s.q == null;
			$('done').hidden = s.q != null;
			document.querySelector<HTMLButtonElement>('[data-pick="undo"]')!.disabled = history.length === 0;

			if (s.q) {
				const { id, pivot } = s.q;
				const { lo, hi } = s.open.find((p) => p.id === id)!;

				show('a', byId.get(s.order[pivot])!);
				show('b', byId.get(id)!);
				$('a-rank').textContent = `#${pivot + 1}`;
				$('b-range').textContent = `#${lo + 1}–${hi + 1}`;
			}

			const list = $('list');

			list.replaceChildren(
				...s.order.map((id, i) => {
					const f = byId.get(id)!;
					const li = document.createElement('li');

					li.textContent = `${f.title} `;
					li.draggable = true;
					li.dataset.i = String(i);

					if (f.year) li.insertAdjacentHTML('beforeend', `<span class="yr">${f.year}</span>`);

					const again = el('button', 'rerank', '↻');

					again.title = 'Rank again';
					li.append(again);

					if (id === s.just) li.className = 'just';

					return li;
				}),
			);
		};

		const pick = (what: string) => {
			if (what === 'undo') {
				const prev = history.pop();

				if (prev) s = prev;
			} else if (s.q) {
				remember();

				const { id, pivot } = s.q;
				const p = s.open.find((x) => x.id === id)!;

				if (what === 'skip') {
					s.open = s.open.filter((x) => x !== p);
					s.queue.push(id);
				} else if (what === 'tie') {
					place(p, pivot + 1);
				} else {
					// A wins: B goes below the pivot. B wins: above it.
					if (what === 'a') p.lo = pivot + 1;
					else p.hi = pivot;

					if (p.lo >= p.hi) place(p, p.lo);
				}

				ask();
			}

			render();
			void save();
		};

		// Editing the list. A move keeps the question on screen, with its pivot
		// re-picked since the indexes under it shifted.
		const rerank = (i: number) => {
			remember();

			const id = s.order[i];

			s.order = removeAt(s.order, i, s.open);
			s.open.push({ id, lo: 0, hi: s.order.length });
			ask(id);
			render();
			void save();
		};

		const move = (from: number, to: number) => {
			if (from === to) return;
			remember();

			const id = s.order[from];

			s.order = insertAt(removeAt(s.order, from, s.open), to, id, s.open);
			s.just = id;
			ask(s.q?.id);
			render();
			void save();
		};

		const list = $('list');

		const row = (e: Event) => (e.target instanceof Element ? e.target.closest('li') : null);

		let dragFrom = -1;

		list.addEventListener('click', (e) => {
			const li = row(e);

			if (li && e.target instanceof Element && e.target.closest('.rerank')) rerank(Number(li.dataset.i));
		});

		list.addEventListener('dragstart', (e) => {
			dragFrom = Number(row(e)?.dataset.i ?? -1);
		});

		list.addEventListener('dragover', (e) => {
			const li = row(e);

			if (dragFrom < 0 || !li) return;
			e.preventDefault();

			for (const o of list.querySelectorAll('.over')) if (o !== li) o.classList.remove('over');
			li.classList.add('over');
		});

		list.addEventListener('drop', (e) => {
			const li = row(e);

			e.preventDefault();

			if (li && dragFrom >= 0) move(dragFrom, Number(li.dataset.i));
		});

		list.addEventListener('dragend', () => {
			dragFrom = -1;

			for (const o of list.querySelectorAll('.over')) o.classList.remove('over');
		});

		for (const b of document.querySelectorAll<HTMLButtonElement>('[data-pick]')) {
			b.addEventListener('click', () => pick(b.dataset.pick!));
		}

		const KEYS = new Map([
			['ArrowLeft', 'a'],
			['ArrowRight', 'b'],
			['ArrowUp', 'tie'],
			['s', 'skip'],
			['z', 'undo'],
		]);

		document.addEventListener('keydown', (e) => {
			const what = KEYS.get(e.key.length === 1 ? e.key.toLowerCase() : e.key);

			if (!what || e.metaKey || e.ctrlKey || e.altKey) return;
			e.preventDefault();
			pick(what);
		});

		ask();

		render();
	</script>
</FilmLayout>
