---
import FilmLayout from '../../../layouts/FilmLayout.astro';
import EntryEditor from '../../../components/EntryEditor.astro';
import { getDiaryEntry, listTheaterNames, listTags, listFriends } from '../../../lib/films';
import { toEditorInitial } from '../../../lib/entry-editor';
import { requireOwner } from '../../../lib/auth';
import { imageUrl } from '../../../lib/tmdb';
import { formatWatchedDate, mediumLabel, starText } from '../../../lib/format';

// Rendered on demand — reflects the live database.
export const prerender = false;

const id = Number(Astro.params.id);
const [entry, isOwner] = await Promise.all([
	Number.isInteger(id) ? getDiaryEntry(id) : Promise.resolve(null),
	requireOwner(Astro.cookies),
]);

if (!entry) {
	return new Response('Diary entry not found', { status: 404 });
}

const { movie } = entry;
const poster = imageUrl(movie.poster_path, 'w342');
const posterThumb = imageUrl(movie.poster_path, 'w92');
const watched =
	formatWatchedDate(entry.watched_date) ?? formatWatchedDate(entry.created_at.slice(0, 10));
const medium = mediumLabel(entry.medium);
const venue = entry.theater
	? [entry.theater.name, entry.theater.city].filter(Boolean).join(', ')
	: null;
const inTheater = entry.medium === 'theater';
const filmHref = `/films/movie/${movie.tmdb_id}`;

// Every fact on the entry links to the "All films" grid pre-filtered by it, so a
// director, tag or theater is one click from everything else you've watched that
// shares it. The keys and values mirror what /films/watched reads from the URL:
// `medium` is the raw canonical value (not its label), `venue` the full
// "Name, City", the rest are the names as stored. `sort=year` (used for the
// director) orders that person's films by release date rather than recent.
const filterHref = (key: string, value: string, sort?: 'year') =>
	`/films/watched?${key}=${encodeURIComponent(value)}${sort ? `&sort=${sort}` : ''}`;

// Editor scaffolding (owner only): autocomplete options + the entry's current
// values, which the modal seeds its form from.
const [venueOptions, tagOptions, friendOptions] = isOwner
	? await Promise.all([listTheaterNames(), listTags(), listFriends()])
	: [[], [], []];
const editorFilm = {
	tmdbId: movie.tmdb_id,
	title: movie.title,
	year: movie.release_year,
	poster: posterThumb,
};
const editorInitial = toEditorInitial(entry);
---

<FilmLayout title={`${movie.title} — diary entry`}>
	<div class="page">
		<div class="wrap">
			<header class="topbar">
				<a class="back" href="/films/diary">
					<span class="back__arrow">←</span><span>Film diary</span>
				</a>
				<span class="topbar__tag">Diary entry</span>
			</header>

			<div class="entry">
				<!-- poster sidebar -->
				<div class="side">
					<a class="poster" href={filmHref}>
						{poster && <img src={poster} alt={`${movie.title} poster`} />}
						<div class="poster__title">
							{movie.title}
							{movie.release_year && <span class="poster__year">{movie.release_year}</span>}
						</div>
					</a>

					{medium && (
						<div class="how">
							<div class="how__label">Medium</div>
							<a class="how__medium" href={filterHref('medium', entry.medium ?? '')}>{medium}</a>
							{inTheater && (venue || entry.format) && (
								<div class="how__theater">
									{venue && (
										<div>
											<div class="how__sub">Venue</div>
											<a class="how__venue" href={filterHref('venue', venue)}>{venue}</a>
										</div>
									)}
									{entry.format && (
										<div>
											<div class="how__sub">Format</div>
											<a class="how__format" href={filterHref('format', entry.format)}>{entry.format}</a>
										</div>
									)}
								</div>
							)}
						</div>
					)}
				</div>

				<!-- details -->
				<div class="details">
					{isOwner ? (
						<div class="details__top">
							{watched && <div class="watched">Watched {watched}</div>}
							<button type="button" class="edit-btn" data-open-entry-editor>Edit entry</button>
						</div>
					) : (
						watched && <div class="watched">Watched {watched}</div>
					)}
					<a class="titlelink" href={filmHref}>
						<h1>
							{movie.title}
							{movie.release_year && <span class="year">{movie.release_year}</span>}
						</h1>
					</a>
					{movie.directors.length > 0 && (
						<div class="director">
							Directed by{' '}
							{movie.directors.map((d, i) => (
								<>
									{i > 0 && ', '}
									<a class="director__name" href={filterHref('director', d, 'year')}>{d}</a>
								</>
							))}
						</div>
					)}

					{movie.genres.length > 0 && (
						<div class="genres">
							{movie.genres.map((g) => (
								<a class="genre" href={filterHref('genre', g)}>{g}</a>
							))}
						</div>
					)}

					<div class="flags">
						{entry.rating != null && <span class="stars">{starText(entry.rating)}</span>}
						{entry.liked && (
							<span class="flag"><span class="flag__icon">♥</span> Liked</span>
						)}
						{entry.rewatched && (
							<span class="flag"><span class="flag__icon">↻</span> Rewatch</span>
						)}
					</div>

					{entry.review_text && (
						<div class="review">
							<div class="review__label">Review</div>
							<p class="review__body">{entry.review_text}</p>
						</div>
					)}

					{entry.tags.length > 0 && (
						<div class="tags">
							{entry.tags.map((t) => (
								<a class="tag" href={filterHref('tag', t)}>{t}</a>
							))}
						</div>
					)}

					{entry.friends.length > 0 && (
						<div class="friends">
							Watched with{' '}
							{entry.friends.map((f, i) => (
								<>
									{i > 0 && ', '}
									<a class="friends__name" href={filterHref('friend', f)}>{f}</a>
								</>
							))}
						</div>
					)}
				</div>
			</div>
		</div>
	</div>

	{isOwner && (
		<EntryEditor
			mode="edit"
			logId={entry.id}
			film={editorFilm}
			initial={editorInitial}
			venueOptions={venueOptions}
			tagOptions={tagOptions}
			friendOptions={friendOptions}
			redirect={`/films/diary/${entry.id}`}
		/>
	)}

	<style>
		.page {
			display: flex;
			justify-content: center;
			padding: 0 24px 90px;
		}
		.wrap {
			width: 100%;
			max-width: 760px;
		}
		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 26px 0 22px;
			border-bottom: 1px solid #4a2529;
			margin-bottom: 40px;
		}
		.back {
			display: flex;
			align-items: center;
			gap: 9px;
			font-size: 13px;
			color: #a2857a;
		}
		.back:hover {
			color: #f4e8d1;
		}
		.back__arrow {
			font-size: 15px;
		}
		.topbar__tag {
			font-size: 11.5px;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #8a6f63;
		}

		.entry {
			display: grid;
			grid-template-columns: 150px 1fr;
			gap: 34px;
			align-items: start;
		}
		.side {
			display: flex;
			flex-direction: column;
			gap: 16px;
		}
		.poster {
			display: block;
			position: relative;
			aspect-ratio: 2 / 3;
			border-radius: 7px;
			overflow: hidden;
			background-image: repeating-linear-gradient(135deg, #351a1d 0 9px, #2c1518 9px 18px);
			border: 1px solid #4a2529;
			box-shadow: 0 20px 40px -14px rgba(0, 0, 0, 0.55);
		}
		.poster:hover {
			border-color: #d9b45a;
		}
		.poster img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.poster__title {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: flex-end;
			padding: 12px;
			font-family: 'Newsreader', serif;
			font-size: 15px;
			color: #f2e5cd;
			line-height: 1.2;
		}
		/* Hidden when a real poster image is present. */
		.poster img ~ .poster__title {
			display: none;
		}
		.poster__year {
			color: #b0917f;
			font-style: italic;
			font-size: 13px;
			margin-left: 4px;
		}

		.how {
			background: #2a1214;
			border: 1px solid #4a2529;
			border-radius: 10px;
			padding: 15px 15px 16px;
		}
		.how__label,
		.how__sub {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
		}
		.how__label {
			margin-bottom: 12px;
		}
		.how__medium {
			display: inline-block;
			font-family: 'Newsreader', serif;
			font-size: 19px;
			color: #f4e8d1;
			line-height: 1.1;
		}
		.how__medium:hover {
			color: #f0d488;
		}
		.how__theater {
			margin-top: 12px;
			padding-top: 12px;
			border-top: 1px solid #402226;
			display: flex;
			flex-direction: column;
			gap: 12px;
		}
		.how__sub {
			letter-spacing: 1px;
			margin-bottom: 3px;
		}
		.how__venue {
			display: inline-block;
			font-size: 13px;
			color: #e9d9c4;
			line-height: 1.35;
		}
		.how__venue:hover {
			color: #f0d488;
		}
		.how__format {
			display: inline-block;
			font-size: 11px;
			font-weight: 700;
			letter-spacing: 0.5px;
			color: #ddc9b4;
			border: 1.5px solid #6b4a42;
			border-radius: 3px;
			padding: 2px 8px;
			margin-top: 2px;
		}
		.how__format:hover {
			color: #f0d488;
			border-color: #d9b45a;
		}

		.details__top {
			display: flex;
			align-items: flex-start;
			justify-content: space-between;
			gap: 16px;
			margin-bottom: 6px;
		}
		.details__top .watched {
			margin-bottom: 0;
		}
		.edit-btn {
			flex: none;
			font-size: 12px;
			font-weight: 600;
			color: #ddc9b4;
			background: transparent;
			border: 1px solid #4a2529;
			border-radius: 7px;
			padding: 7px 14px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
		}
		.edit-btn:hover {
			border-color: #d9b45a;
			color: #f4e8d1;
		}
		.watched {
			font-family: 'Newsreader', serif;
			font-style: italic;
			font-size: 15px;
			color: #c2a99a;
			margin-bottom: 6px;
		}
		.titlelink {
			color: inherit;
		}
		.titlelink:hover h1 {
			color: #f0d488;
		}
		h1 {
			font-family: 'Newsreader', serif;
			font-weight: 500;
			font-size: 40px;
			color: #f4e8d1;
			letter-spacing: -0.5px;
			line-height: 1.04;
			margin: 0;
		}
		.year {
			color: #a2857a;
			font-style: italic;
			font-weight: 400;
			font-size: 28px;
			margin-left: 6px;
		}
		.director {
			font-size: 14px;
			color: #c2a99a;
			margin-top: 8px;
		}
		.director__name {
			color: #f2e5cd;
			font-weight: 600;
		}
		.director__name:hover {
			color: #f0d488;
		}

		.genres {
			display: flex;
			gap: 8px;
			flex-wrap: wrap;
			margin-top: 16px;
		}
		.genre {
			font-size: 12px;
			color: #ddc9b4;
			border: 1px solid #4a2529;
			border-radius: 20px;
			padding: 5px 13px;
			background: #241012;
		}
		.genre:hover {
			color: #f0d488;
			border-color: #d9b45a;
		}

		.flags {
			display: flex;
			align-items: center;
			gap: 16px;
			margin-top: 18px;
			flex-wrap: wrap;
		}
		.stars {
			color: #d9b45a;
			font-size: 20px;
			letter-spacing: 2px;
		}
		.flag {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			font-size: 12px;
			color: #e9d9c4;
		}
		.flag__icon {
			color: #d9b45a;
			font-size: 15px;
		}

		.review {
			margin-top: 24px;
		}
		.review__label {
			font-family: 'Newsreader', serif;
			font-style: italic;
			font-size: 18px;
			color: #ecdcbd;
			padding-bottom: 10px;
			border-bottom: 1px solid #402226;
			margin-bottom: 16px;
		}
		.review__body {
			font-family: 'Newsreader', serif;
			font-size: 18px;
			color: #e6d8c3;
			line-height: 1.7;
			font-style: italic;
			margin: 0;
			white-space: pre-wrap;
		}

		.tags {
			display: flex;
			gap: 8px;
			flex-wrap: wrap;
			margin-top: 22px;
		}
		.tag {
			font-size: 12px;
			color: #ddc9b4;
			border: 1px solid #4a2529;
			border-radius: 20px;
			padding: 5px 13px;
			background: #241012;
		}
		.tag:hover {
			color: #f0d488;
			border-color: #d9b45a;
		}

		.friends {
			margin-top: 20px;
			font-size: 13px;
			color: #a2857a;
		}
		.friends__name {
			color: #e9d9c4;
		}
		.friends__name:hover {
			color: #f0d488;
		}

		@media (max-width: 640px) {
			.entry {
				grid-template-columns: 110px 1fr;
				gap: 20px;
			}
			h1 {
				font-size: 32px;
			}
			.year {
				font-size: 22px;
			}
		}
	</style>
</FilmLayout>
