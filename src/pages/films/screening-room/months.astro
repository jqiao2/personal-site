---
// Markup-only page of the Screening Room calendar, fetched as the run scrolls.
// A partial, so it comes back as bare rows with no layout or head around them —
// the styles are already on /films/screening-room, which renders the same
// component and so shares its scope hash.
import ScreeningCalendar from '../../../components/ScreeningCalendar.astro';
import { requireOwner } from '../../../lib/auth';
import { listQueue } from '../../../lib/screening-queue';
import { buildRows } from '../../../lib/screening-calendar';
import { siteDay } from '../../../lib/day';

export const prerender = false;
export const partial = true;

const DAY_RE = /^\d{4}-\d{2}-\d{2}$/;
const from = Astro.url.searchParams.get('from') ?? '';
const weeks = Math.min(26, Math.max(1, Number(Astro.url.searchParams.get('weeks')) || 8));

if (!DAY_RE.test(from)) return new Response('bad from', { status: 400 });

const [queue, isOwner] = await Promise.all([listQueue(), requireOwner(Astro.cookies)]);
const rows = buildRows({ startSunday: from, weeks, queue, today: siteDay() });
---

<ScreeningCalendar rows={rows} isOwner={isOwner} />
