---
import { getLogById } from '../../lib/films';

// Legacy log-keyed detail URL. The canonical film page is now keyed by TMDB id
// (/films/movie/[tmdbId]), so resolve the log to its film and redirect there —
// old links, bookmarks, and shared URLs keep working.
export const prerender = false;

const id = Number(Astro.params.id);
const log = Number.isInteger(id) ? await getLogById(id) : null;

if (!log) {
	return new Response('Log not found', { status: 404 });
}

return Astro.redirect(`/films/movie/${log.movie.tmdb_id}`, 301);
---
