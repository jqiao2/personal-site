---
import FilmLayout from '../../layouts/FilmLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { loadCloset, type ClosetSpine } from '../../lib/closet';

// Rendered on demand; the middleware lets the CDN hold the visitor copy.
export const prerender = false;

const { watchlist, watched, logs } = await loadCloset();

const walls: { key: string; name: string; spines: ClosetSpine[] }[] = [
	{ key: 'left', name: 'To watch', spines: watchlist },
	{ key: 'right', name: 'Watched', spines: watched },
];

// `<` escaped so a review containing "</script>" can't end the block early.
const logsJson = JSON.stringify(logs).replace(/</g, '\\u003c');

const num = (n: number) => n.toLocaleString('en-US');
---

<FilmLayout title="The closet — Jason's film log">
	<div class="page">
		<SiteHeader pathname={Astro.url.pathname} theme="film" max="1064px" />

		<header class="top">
			<a class="back" href="/films">← Jason's film log</a>
			<div class="sort" role="group" aria-label="Sort">
				<button type="button" data-sort="r" aria-pressed="true">Recent</button>
				<button type="button" data-sort="a" aria-pressed="false">A–Z</button>
				<button type="button" data-sort="y" aria-pressed="false">Year</button>
			</div>
		</header>

		<div class="room">
			{
				walls.map((w) => (
					<section class={`wall wall--${w.key}`}>
						<div class="rail">
							<h2 class="placard">
								{w.name} <span>{num(w.spines.length)}</span>
							</h2>
						</div>
						<div class="shelves" data-shelves>
							{w.spines.map((s) => (
								<a
									class="sp"
									href={`/films/movie/${s.tmdb}`}
									aria-label={`${s.title}${s.year ? ` (${s.year})` : ''}`}
									data-spine
									data-tmdb={s.tmdb}
									data-title={s.title}
									data-year={s.year ?? ''}
									data-stars={s.stars ?? ''}
									data-poster={s.poster ?? ''}
									data-when={s.when ?? ''}
									data-r={s.rank.recent}
									data-a={s.rank.alpha}
									data-y={s.rank.year}
									style={`--c:${s.case};--k:${s.ink}${s.thumb ? `;--p:url(${s.thumb})` : ''}`}
								>
									<span class="sp__case">
										<span class="sp__no">{s.number}</span>
										<span class="sp__t">{s.title}</span>
										{s.year && <span class="sp__y">{String(s.year).slice(2)}</span>}
									</span>
								</a>
							))}
						</div>
					</section>
				))
			}
			<div class="floor" aria-hidden="true" />
		</div>
	</div>

	<div class="bubble" data-bubble hidden></div>

	<dialog class="out" data-out aria-label="Film">
		<div class="out__inner">
			<a class="case" data-cover href="#">
				<span class="case__hinge"></span>
				<span class="case__sleeve">
					<img class="case__art" data-cover-img alt="" />
					<span class="case__blank" data-cover-blank></span>
				</span>
			</a>
			<div class="info">
				<h2 class="info__title" data-info-title></h2>
				<p class="info__when" data-info-when></p>
				<p class="info__stars" data-info-stars></p>
				<ol class="logs" data-logs></ol>
			</div>
		</div>
	</dialog>

	<script is:inline type="application/json" id="closet-logs" set:html={logsJson} />

	<script>
		interface Log {
			id: number;
			date: string | null;
			stars: string | null;
			liked: boolean;
			rewatched: boolean;
			note: string | null;
		}

		// SAFETY: the block is written by this page's own frontmatter from loadCloset's `logs`.
		const logs = JSON.parse(document.getElementById('closet-logs')!.textContent ?? '{}') as Record<string, Log[]>;

		const bubble = document.querySelector<HTMLElement>('[data-bubble]')!;

		const out = document.querySelector<HTMLDialogElement>('[data-out]')!;

		const q = <T extends HTMLElement>(sel: string) => out.querySelector<T>(sel)!;

		// Sort: reorder the spines already on each wall by the rank the server worked out.
		for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-sort]')) {
			btn.addEventListener('click', () => {
				const key = btn.dataset.sort!;

				for (const b of document.querySelectorAll('[data-sort]')) b.setAttribute('aria-pressed', String(b === btn));

				for (const shelves of document.querySelectorAll<HTMLElement>('[data-shelves]')) {
					const spines = [...shelves.querySelectorAll<HTMLElement>('[data-spine]')];
					spines.sort((a, b) => Number(a.dataset[key]) - Number(b.dataset[key]));
					shelves.append(...spines);
				}

				markEdges();
			});
		}

		// The disc ending each row has its side open to the room — the first on the
		// left wall, the last on the right. --gap is how far back that side can be
		// seen before the bookcase's own side cuts it off: the space beside it.
		function markEdges() {
			for (const shelves of document.querySelectorAll<HTMLElement>('[data-shelves]')) {
				const left = shelves.closest('.wall--left') !== null;

				const spines = [...shelves.querySelectorAll<HTMLElement>('[data-spine]')];

				spines.forEach((sp, i) => {
					const next = spines[left ? i - 1 : i + 1];

					const gap = left ? sp.offsetLeft : shelves.clientWidth - sp.offsetLeft - sp.offsetWidth;

					const edge = !next || next.offsetTop !== sp.offsetTop;

					sp.classList.toggle('sp--edge', edge);
					sp.style.setProperty('--gap', edge ? `${gap}px` : '0px');
				});
			}
		}

		markEdges();

		// Rows rewrap with the window, which moves every row's end.
		const relayout = new ResizeObserver(markEdges);

		for (const shelves of document.querySelectorAll('[data-shelves]')) relayout.observe(shelves);

		// Hover: a pill above the pulled-forward spine.
		function showBubble(spine: HTMLElement) {
			const { title, year, stars } = spine.dataset;
			bubble.replaceChildren(
				Object.assign(document.createElement('b'), { textContent: title }),
				...(year ? [Object.assign(document.createElement('span'), { textContent: ` ${year}` })] : []),
				...(stars ? [Object.assign(document.createElement('i'), { textContent: ` ${stars}` })] : []),
			);
			// Measured off the case, which has already moved out by the time this runs;
			// its top face rises a further half its depth above it on screen.
			const c = spine.firstElementChild!.getBoundingClientRect();
			// Mirrors --pull and --top in the styles below.
			const pull = ((spine.offsetHeight * 135) / 190) * 0.4;

			const rise = (31 + pull) / 2;

			// The cover hangs off the side facing the open end: left on the left wall.
			const side = spine.closest('.wall--left') ? -1 : 1;

			bubble.style.left = `${c.left + c.width / 2 + (side * pull) / 2}px`;
			bubble.style.top = `${c.top - rise - 8}px`;
			bubble.hidden = false;
		}

		const hideBubble = () => (bubble.hidden = true);

		let current: HTMLElement | null = null;

		function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, text?: string) {
			const node = document.createElement(tag);
			node.className = cls;

			if (text) node.textContent = text;

			return node;
		}

		// Click: take the case off the shelf and open it.
		function pull(spine: HTMLElement) {
			const d = spine.dataset;
			current = spine;
			spine.classList.add('sp--out');
			hideBubble();

			const cover = q<HTMLAnchorElement>('[data-cover]');
			cover.href = spine.getAttribute('href')!;
			cover.style.setProperty('--c', spine.style.getPropertyValue('--c'));
			cover.style.setProperty('--k', spine.style.getPropertyValue('--k'));
			const img = q<HTMLImageElement>('[data-cover-img]');
			img.hidden = !d.poster;
			img.src = d.poster ?? '';
			q('[data-cover-blank]').textContent = d.poster ? '' : (d.title ?? '');

			q('[data-info-title]').textContent = d.year ? `${d.title} (${d.year})` : (d.title ?? '');
			q('[data-info-when]').textContent = d.when ?? '';
			q('[data-info-stars]').textContent = d.stars ?? '';

			const list = q('[data-logs]');
			list.replaceChildren(
				...(logs[d.tmdb!] ?? []).map((l) => {
					const a = el('a', 'log');
					a.href = `/films/diary/${l.id}`;
					const head = el('span', 'log__head');
					head.append(
						el('span', 'log__date', l.date ?? 'Undated'),
						...(l.stars ? [el('span', 'log__stars', l.stars)] : []),
						...(l.liked ? [el('span', 'log__mark', '♥')] : []),
						...(l.rewatched ? [el('span', 'log__mark', '↻')] : []),
					);
					a.append(head);

					if (l.note) a.append(el('span', 'log__note', l.note));
					const li = document.createElement('li');
					li.append(a);

					return li;
				}),
			);

			out.showModal();
		}

		for (const spine of document.querySelectorAll<HTMLElement>('[data-spine]')) {
			spine.addEventListener('mouseenter', () => showBubble(spine));
			spine.addEventListener('mouseleave', hideBubble);
			spine.addEventListener('focus', () => showBubble(spine));
			spine.addEventListener('blur', hideBubble);
			spine.addEventListener('click', (e) => {
				e.preventDefault();
				pull(spine);
			});
		}

		window.addEventListener('scroll', hideBubble, { passive: true });

		// The cover and the reviews are links; a click anywhere else puts the case back.
		out.addEventListener('click', (e) => {
			if (!(e.target instanceof Element && e.target.closest('a'))) out.close();
		});

		out.addEventListener('close', () => {
			current?.classList.remove('sp--out');
			current?.focus({ preventScroll: true });
			hideBubble();
			current = null;
		});
	</script>

	<style>
		/* The walls are skewed rather than rotated in 3D, so the room is a true
		   isometric projection with no vanishing point — every shelf on a wall is
		   parallel. tan(26.565°) = 0.5, the classic 2:1 pixel-art iso angle. */
		.page {
			--iso: 26.565deg;
			--h: 148px;
			--pitch: 190px;
			/* How deep the bookcase is, front to wall: a little more than a case. */
			--d: calc(var(--cover) + 10px);
			/* A real keepcase is as deep as its cover is wide: 135 × 190 mm. */
			--cover: calc(var(--h) * 135 / 190);
			/* How far a hovered case slides out: enough to show some cover. */
			--pull: calc(var(--cover) * 0.4);
			/* How far back a case's top is seen: up to the board above it (whose
			   front edge is 11px thick), where the shelf hides the rest. */
			--top: calc(var(--pitch) - var(--h) - 11px);
			/* How far back a board's top catches the light before the shelf's
			   shadow takes it — the same falloff as a case's cover and top. */
			--board: 36px;
			min-height: 100vh;
			background: #1c1210;
			padding: 0 24px 40px;
			overflow-x: hidden;
		}
		.top {
			max-width: 1064px;
			margin: 18px auto 34px;
			display: flex;
			justify-content: space-between;
			align-items: center;
			gap: 16px;
			font-family: var(--font-archivo);
		}
		.back {
			color: #c8a98a;
			font-size: 13px;
			text-decoration: none;
		}
		.back:hover {
			color: #f0d488;
		}
		.sort {
			display: flex;
			border: 1px solid #6b4a42;
			border-radius: 8px;
			overflow: hidden;
		}
		.sort button {
			font: 700 12px var(--font-archivo);
			color: #c8a98a;
			background: none;
			border: none;
			padding: 7px 14px;
			cursor: pointer;
		}
		.sort button + button {
			border-left: 1px solid #6b4a42;
		}
		.sort button[aria-pressed='true'] {
			background: #d9b45a;
			color: #2a1214;
		}

		/* The two walls meet at the back corner, in the middle of the screen, and
		   fall away towards you on either side. Skewing drops each wall's outer edge
		   by half its width; the floor below starts exactly there.

		   Depth is drawn, not modelled. In a wall's own skewed frame "back" is a 45°
		   step — (-d, -d) on the left wall, (+d, -d) on the right — so every face
		   that recedes (book tops, the bookcase top, its end panel) is a strip
		   skewed by --lean. Only the faces towards the viewer are drawn: tops, and
		   the side facing the room's open end. */
		.room {
			position: relative;
			max-width: 1064px;
			/* Headroom for the bookcase's top, which peaks a full depth above the
			   corner. */
			margin: calc(var(--d) + 10px) auto 0;
			display: grid;
			grid-template-columns: 1fr 1fr;
		}
		.wall {
			position: relative;
			display: flex;
			flex-direction: column;
		}
		/* A pulled case comes out over everything: the other wall at the corner,
		   and the floor below the bottom shelf. */
		.wall:has(.sp:hover, .sp:focus-visible) {
			z-index: 2;
		}
		.wall--left {
			--lean: 45deg;
			--back: left;
			--front: right;
			--dir: 1;
			transform: skewY(calc(var(--iso) * -1));
			transform-origin: 100% 0;
			background: #3b2a1f;
			border-left: 12px solid #6b4c2e;
			/* The corner: the left wall is lit, the right sits in its shadow. */
			box-shadow: inset -18px 0 22px -14px rgba(0, 0, 0, 0.7);
		}
		.wall--right {
			--lean: -45deg;
			--back: right;
			--front: left;
			--dir: -1;
			transform: skewY(var(--iso));
			transform-origin: 0 0;
			background: #2a1d15;
			border-right: 12px solid #5a3f27;
			box-shadow: inset 18px 0 22px -14px rgba(0, 0, 0, 0.8);
		}
		/* Where the two bookcases meet, a square of top belongs to both: each
		   wall's top stops at the corner, so it is filled here — a diamond whose
		   front point is the corner and back point the true corner of the room. */
		.room::before {
			content: '';
			position: absolute;
			/* 1px proud on every side, so antialiasing leaves no seam against the
			   two tops it joins. */
			left: calc(50% - var(--d) - 1px);
			top: calc(var(--d) * -1 - 1px);
			width: calc(var(--d) * 2 + 2px);
			height: calc(var(--d) + 2px);
			clip-path: polygon(50% 100%, 0 50%, 50% 0, 100% 50%);
			background: #826240;
		}
		/* The bookcase's top, receding to the wall. */
		.wall::before {
			content: '';
			position: absolute;
			top: calc(var(--d) * -1);
			height: var(--d);
			left: -12px;
			right: -12px;
			transform: skewX(var(--lean));
			transform-origin: bottom;
			background: #826240;
		}
		/* Only the outer end runs past the wall, over the side panel's front; the
		   corner end stops at the corner, where the diamond above takes over. */
		.wall--left::before {
			right: 0;
		}
		.wall--right::before {
			left: 0;
		}
		/* The outer side of the bookcase, at the room's open end. */
		.wall::after {
			content: '';
			position: absolute;
			top: 0;
			bottom: 0;
			width: var(--d);
			transform: skewY(var(--lean));
			background: linear-gradient(180deg, #4a3420, #2e2014);
		}
		.wall--left::after {
			right: calc(100% + 12px);
			transform-origin: right;
		}
		.wall--right::after {
			left: calc(100% + 12px);
			transform-origin: left;
		}
		/* The floor the closet stands on: a diamond as wide as the room and half as
		   tall, its side corners meeting the walls' outer feet, on a slab. */
		.floor {
			grid-column: 1 / -1;
			position: relative;
			aspect-ratio: 2 / 1;
			margin-bottom: 18px;
			/* Its box is a rectangle over the walls' sloping feet; only the diamond
			   is painted, so let the pointer through to the bottom shelves. */
			pointer-events: none;
		}
		.floor::before,
		.floor::after {
			content: '';
			position: absolute;
			inset: 0;
			clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
		}
		.floor::before {
			transform: translateY(18px);
			background: #1a100a;
		}
		.floor::after {
			background:
				radial-gradient(ellipse at 50% 35%, rgba(255, 220, 160, 0.1), transparent 60%),
				repeating-linear-gradient(26.565deg, transparent 0 46px, rgba(0, 0, 0, 0.18) 46px 48px),
				#4a3424;
		}
		/* The bookcase's top board, built like every shelf board below it — the lit
		   front edge, then the wood — and the same distance above the first row as
		   a board is above any other. The wall's name is a plate fixed to it. */
		.rail {
			flex: none;
			display: flex;
			justify-content: center;
			align-items: center;
			height: 30px;
			background: linear-gradient(180deg, #9a7a52 0 2px, #5e4429 2px);
		}
		.placard {
			margin: 0;
			padding: 3px 12px;
			font: 700 11px var(--font-archivo);
			letter-spacing: 1.6px;
			text-transform: uppercase;
			color: #2a1214;
			background: #d9b45a;
		}
		.placard span {
			font-weight: 400;
			margin-left: 4px;
		}
		/* Every case is one height, so the shelves are just rows of a wrapping flex
		   box and the boards are painted at the row pitch behind them. Re-sorting
		   moves spines without ever touching a shelf. */
		/* The bookcase's outer side hides whatever reaches past it: clip the shelf
		   there, and only there, so a pulled case can still come out over the
		   corner and the floor. */
		.wall--left .shelves {
			clip-path: inset(-2000px -2000px -2000px 0);
			/* Both walls pack their rows into the corner, so a row's spare shelf is
			   at the open end — the same on both walls, and where its last disc's
			   side can be seen. */
			justify-content: flex-end;
		}
		.wall--right .shelves {
			clip-path: inset(-2000px 0 -2000px -2000px);
		}
		.shelves {
			flex: 1;
			display: flex;
			flex-wrap: wrap;
			align-content: flex-start;
			column-gap: 1px;
			row-gap: calc(var(--pitch) - var(--h));
			/* The side padding lives here, not on the wall, so the painted boards
			   run all the way to the bookcase's sides. */
			padding: var(--top) 20px 0;
			min-height: calc(var(--pitch) * 3);
			/* Each row stands on a board, painted behind the discs so it shows only
			   where a row runs out. Inside a cubby it is dark: the board's top is
			   lit at its front edge and falls into shadow over the same 36px a
			   case's cover does, and from there back — the rest of the board, the
			   back of the bookcase, the gap under the board above — is all the same
			   shadow. Lighter than that, an empty shelf reads as shallow next to
			   discs whose back two-thirds are dark. Then the board's lit front edge.

			   The stops are offset by --top rather than the background positioned:
			   positioning shifts the whole painted box and wraps its bottom around
			   to the top, which put a stray slice of board under the top rail. */
			--shade: #160e09;
			background: repeating-linear-gradient(
				180deg,
				var(--shade) var(--top) calc(var(--top) + var(--h) - var(--board)),
				#5c442c calc(var(--top) + var(--h) - var(--board) * 10 / 36),
				#7d5d3c calc(var(--top) + var(--h)),
				#9a7a52 calc(var(--top) + var(--h)) calc(var(--top) + var(--h) + 2px),
				#5e4429 calc(var(--top) + var(--h) + 2px) calc(var(--top) + var(--h) + 11px),
				var(--shade) calc(var(--top) + var(--h) + 11px) calc(var(--top) + var(--pitch))
			);
		}

		/* A disc case seen end-on. Criterion's grammar: number at the head, title
		   running down, year at the foot. */
		/* The link is the hit area and never moves; the case inside it is what
		   pulls forward, so the pointer can't slip off the spine it is lifting. */
		.sp {
			position: relative;
			flex: none;
			width: 20px;
			height: var(--h);
			text-decoration: none;
			outline: none;
		}
		.sp__case {
			position: absolute;
			inset: 0;
			display: flex;
			flex-direction: column;
			align-items: center;
			background: var(--c);
			color: var(--k);
			box-shadow:
				inset 1px 0 0 rgba(255, 255, 255, 0.18),
				inset -2px 0 0 rgba(0, 0, 0, 0.25);
			/* Both faces that recede darken sharply going back into the shelf.
			   The darkening starts at the shelf's front edge, so on a pulled case
			   it starts --o further back and what sticks out stays lit. Declared
			   here rather than on .page so --o resolves per case. */
			--o: 0px;
			--fade:
				rgba(16, 10, 6, 0) var(--o), rgba(16, 10, 6, 0.3) calc(var(--o) + 10px),
				rgba(16, 10, 6, 0.95) calc(var(--o) + 36px);
			/* How far back a face is seen before the board above hides it. */
			--reach: var(--top);
		}
		.sp:hover .sp__case,
		.sp:focus-visible .sp__case {
			--o: var(--pull);
			--reach: calc(var(--top) + var(--pull));
		}
		/* The case's top, and its side facing the open end of the room. That side
		   only exists where it can be seen: on the disc ending a row, as far back as
		   the gap beside it reaches (--gap, set by the script), and on a pulled disc
		   for the stretch that clears its neighbour. The cover printed on it darkens
		   sharply towards the back — a glimpse, not the whole poster. Nothing is
		   generated for any other disc, so their posters are never fetched. */
		.sp__case::after,
		.sp--edge .sp__case::before,
		.sp:hover .sp__case::before,
		.sp:focus-visible .sp__case::before {
			content: '';
			position: absolute;
		}
		.sp__case::after {
			left: 0;
			right: 0;
			bottom: 100%;
			height: var(--top);
			transform: skewX(var(--lean));
			transform-origin: bottom;
			background:
				linear-gradient(to top, var(--fade)),
				linear-gradient(rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.24)),
				var(--c);
			box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.3);
		}
		.sp__case::before {
			top: 0;
			bottom: 0;
			width: min(var(--cover), var(--gap, 0px));
			transform: skewY(var(--lean));
			background:
