---
import FilmLayout from '../../layouts/FilmLayout.astro';
import { listWatchedFacets, listWatchedPage } from '../../lib/films';
import { mediumLabel, starText } from '../../lib/format';
import { imageUrl } from '../../lib/tmdb';

// Rendered on demand — reflects the live database.
export const prerender = false;

/** Films per page. The first batch is server-rendered; the rest are fetched from
 * /api/films/watched/list as you scroll (that route caps `limit` at 100). */
const BATCH = 100;

/** How many chips a group shows before collapsing behind "+N other…". Tags and
 * friends follow the design; theaters get one too because there are 19 of them
 * and their names are long enough to swamp the panel. */
const CHIP_LIMIT = { tags: 7, friends: 4, venues: 6 };

// The default view: newest-watched first, unfiltered. Search, sort and every
// filter re-query from the server, so this is only the starting slice.
const [{ films, total }, facets] = await Promise.all([
	listWatchedPage({ limit: BATCH }),
	listWatchedFacets(),
]);
const hasMore = total > films.length;
const num = (n: number) => n.toLocaleString('en-US');

// End stops for the release-date slider. It needs two distinct decades to be worth
// drawing — with everything in one decade there's nothing to narrow to.
const decLo = facets.decades[0] ?? null;
const decHi = facets.decades[facets.decades.length - 1] ?? null;
const hasDecadeRange = decLo != null && decHi != null && decHi > decLo;
---

<FilmLayout title="Films watched — Jason's film log">
	<div class="page">
		<div class="wrap">
			<header class="topbar">
				<a class="back" href="/films">
					<span class="back__arrow">←</span><span>Jason's film log</span>
				</a>
				<span class="topbar__tag">Films watched</span>
			</header>

			<div class="titleblock">
				<div>
					<h1>All films</h1>
					<div class="sub">
						<span class="sub__n">{num(total)}</span> films watched · showing{' '}
						<span class="sub__n" id="shown">{num(total)}</span>
					</div>
				</div>
			</div>

			<div class="filterbar">
				<input
					type="search"
					id="search"
					placeholder="Search films…"
					autocomplete="off"
					aria-label="Search films"
				/>
				<button
					type="button"
					id="filters-toggle"
					class="pill pill--btn"
					aria-expanded="false"
					aria-controls="filters"
				>
					Filters<span id="filters-count"></span>
				</button>
				<div class="sortby">
					<span class="sortby__label">Sort</span>
					<button type="button" class="pill pill--on" data-sort="recent">Recent</button>
					<button type="button" class="pill" data-sort="year">Release date</button>
				</div>
			</div>

			<div class="panel" id="filters" hidden>
				<div class="panel__head">
					<span class="panel__title">Filter films</span>
					<button type="button" id="clear-all" class="clear" hidden>Clear all</button>
				</div>

				<div class="panel__grid">
					<section>
						<h2 class="grp">Rating</h2>
						<div class="rating">
							<div class="range" id="range">
								<div class="range__track"></div>
								<div class="range__fill" id="range-fill"></div>
								<input type="range" id="rmin" min="0.5" max="5" step="0.5" value="0.5" aria-label="Minimum rating" />
								<input type="range" id="rmax" min="0.5" max="5" step="0.5" value="5" aria-label="Maximum rating" />
								<div class="range__ends">
									<span id="rmin-stars">½</span><span id="rmax-stars">★★★★★</span>
								</div>
							</div>
							<button type="button" class="chip" data-flag="unrated" aria-pressed="false">Unrated only</button>
						</div>
					</section>

					<section>
						<h2 class="grp">Activity</h2>
						<div class="chips chips--gap">
							<button type="button" class="chip" data-flag="liked" aria-pressed="false">♥ Liked</button>
							<button type="button" class="chip" data-flag="rewatched" aria-pressed="false">↻ Rewatched</button>
						</div>
						{hasDecadeRange && (
							<>
								<h2 class="grp">Release date</h2>
								<div class="range range--dec" id="drange" data-lo={decLo} data-hi={decHi}>
									<div class="range__track"></div>
									<div class="range__fill" id="drange-fill"></div>
									<input
										type="range"
										id="dmin"
										min={decLo}
										max={decHi}
										step="10"
										value={decLo}
										aria-label="Earliest release decade"
									/>
									<input
										type="range"
										id="dmax"
										min={decLo}
										max={decHi}
										step="10"
										value={decHi}
										aria-label="Latest release decade"
									/>
									<div class="range__ends">
										<span id="dmin-label">{decLo}s</span><span id="dmax-label">{decHi}s</span>
									</div>
								</div>
							</>
						)}
					</section>

					<section>
						<h2 class="grp">Tags</h2>
						{facets.tags.length === 0 ? (
							<p class="grp__none">No tags yet</p>
						) : (
							<div class="chips">
								{facets.tags.map((t, i) => (
									<button
										type="button"
										class="chip"
										data-filter="tag"
										data-value={t}
										aria-pressed="false"
										hidden={i >= CHIP_LIMIT.tags}
									>
										{t}
									</button>
								))}
								{facets.tags.length > CHIP_LIMIT.tags && (
									<button type="button" class="chip chip--more">
										+{facets.tags.length - CHIP_LIMIT.tags} other…
									</button>
								)}
							</div>
						)}
					</section>

					<section>
						<div class="grp__row">
							<h2 class="grp">Watched with</h2>
							<div class="modes" data-mode="friendmode">
								<button type="button" class="mode mode--on" data-value="any">Any</button>
								<button type="button" class="mode" data-value="all">All</button>
							</div>
						</div>
						{facets.friends.length === 0 ? (
							<p class="grp__none">No one tagged yet</p>
						) : (
							<div class="chips">
								{facets.friends.map((f, i) => (
									<button
										type="button"
										class="chip"
										data-filter="friend"
										data-value={f}
										aria-pressed="false"
										hidden={i >= CHIP_LIMIT.friends}
									>
										{f}
									</button>
								))}
								{facets.friends.length > CHIP_LIMIT.friends && (
									<button type="button" class="chip chip--more">
										+{facets.friends.length - CHIP_LIMIT.friends} other…
									</button>
								)}
							</div>
						)}
					</section>

					{(facets.directors.length > 0 || facets.actors.length > 0) && (
						<section class="panel__wide">
							<div class="grp__row">
								<h2 class="grp">People</h2>
								<input
									type="search"
									id="people-search"
									class="people-search"
									placeholder="Search directors & cast…"
									autocomplete="off"
									aria-label="Search directors and cast"
								/>
							</div>
							<div class="where">
								<div class="where__row">
									<span class="where__label">Director</span>
									<div class="chips" data-people="director">
										<span class="people-none" hidden>No matches</span>
									</div>
								</div>
								<div class="where__row">
									<span class="where__label">Cast</span>
									<div class="chips" data-people="actor">
										<span class="people-none" hidden>No matches</span>
									</div>
								</div>
							</div>
							<script
								is:inline
								type="application/json"
								data-people-names
								set:html={JSON.stringify({ directors: facets.directors, actors: facets.actors })}
							/>
						</section>
					)}

					<section class="panel__wide">
						<div class="grp__row">
							<h2 class="grp">Medium · theater · format</h2>
							<div class="modes" data-mode="wheremode">
								<button type="button" class="mode mode--on" data-value="any">Any</button>
								<button type="button" class="mode" data-value="all">All</button>
							</div>
						</div>
						<div class="where">
							<div class="where__row">
								<span class="where__label">Medium</span>
								<div class="chips">
									{facets.mediums.map((m) => (
										<button type="button" class="chip" data-filter="medium" data-value={m} aria-pressed="false">
											{mediumLabel(m)}
										</button>
									))}
								</div>
							</div>
							<div class="where__row">
								<span class="where__label">Theater</span>
								<div class="chips">
									{facets.venues.map((v, i) => (
										<button
											type="button"
											class="chip"
											data-filter="venue"
											data-value={v.value}
											title={v.value}
											aria-pressed="false"
											hidden={i >= CHIP_LIMIT.venues}
										>
											{v.label}
										</button>
									))}
									{facets.venues.length > CHIP_LIMIT.venues && (
										<button type="button" class="chip chip--more">
											+{facets.venues.length - CHIP_LIMIT.venues} other…
										</button>
									)}
								</div>
							</div>
							<div class="where__row">
								<span class="where__label">Format</span>
								<div class="chips">
									{facets.formats.map((f) => (
										<button type="button" class="chip" data-filter="format" data-value={f} aria-pressed="false">
											{f}
										</button>
									))}
								</div>
							</div>
						</div>
					</section>
				</div>
			</div>

			<div class="filterinfo" id="filterinfo" hidden>
				<span class="filterinfo__tag">Filter</span>
				<p class="filterinfo__text" id="filterinfo-text"></p>
			</div>

			<div class="grid" id="grid">
				{films.map((f) => {
					const poster = imageUrl(f.poster_path, 'w342');
					return (
						<a class={poster ? 'tile' : 'tile tile--noimg'} href={`/films/movie/${f.tmdb_id}`}>
							{poster && <img src={poster} alt={`${f.title} poster`} loading="lazy" />}
							<div class="tile__overlay">
								<div class="tile__title">{f.title}</div>
								<div class="tile__year">{f.release_year}</div>
								<div class="tile__stars">{starText(f.rating) ?? 'Unrated'}</div>
							</div>
						</a>
					);
				})}
			</div>

			<p class="empty" id="empty" hidden>
				<span id="empty-by-query">No films match “<span id="empty-q"></span>”</span>
				<span id="empty-by-filters" hidden>No films match these filters</span>
			</p>

			<div id="sentinel" data-batch={BATCH} hidden={!hasMore}>
				<span class="sentinel__spinner" aria-hidden="true"></span>
				<span class="sentinel__text">Loading more…</span>
			</div>
			<p id="load-error" class="load-error" hidden>
				Couldn't load more films. <button type="button" id="retry">Retry</button>
			</p>
		</div>
	</div>

	<style>
		.page {
			display: flex;
			justify-content: center;
			padding: 0 24px 80px;
		}
		.wrap {
			width: 100%;
			max-width: 1000px;
		}
		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 26px 0 22px;
			border-bottom: 1px solid #4a2529;
			margin-bottom: 34px;
		}
		.back {
			display: flex;
			align-items: center;
			gap: 9px;
			font-size: 13px;
			color: #a2857a;
		}
		.back:hover {
			color: #f4e8d1;
		}
		.back__arrow {
			font-size: 15px;
		}
		.topbar__tag {
			font-size: 11.5px;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #8a6f63;
		}

		.titleblock {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			margin-bottom: 26px;
			flex-wrap: wrap;
			gap: 16px;
		}
		h1 {
			font-family: 'Newsreader', serif;
			font-weight: 500;
			font-size: 52px;
			color: #f4e8d1;
			letter-spacing: -0.5px;
			line-height: 1;
			margin: 0;
		}
		.sub {
			font-size: 13px;
			color: #a2857a;
			margin-top: 10px;
		}
		.sub__n {
			color: #d9b45a;
			font-weight: 600;
		}

		.filterbar {
			display: flex;
			gap: 12px;
			align-items: center;
			margin-bottom: 14px;
			flex-wrap: wrap;
		}
		#search {
			flex: 1;
			min-width: 220px;
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 8px;
			padding: 11px 14px;
			color: #f4e8d1;
			font-size: 14px;
			font-family: 'Archivo', sans-serif;
			outline: none;
		}
		#search::placeholder {
			color: #8a6f63;
		}
		#search:focus {
			border-color: #d9b45a;
		}
		.sortby {
			display: flex;
			align-items: center;
			gap: 8px;
		}
		.sortby__label {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
		}
		.pill {
			font-size: 12.5px;
			padding: 7px 13px;
			border-radius: 20px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			border: 1px solid #4a2529;
			background: transparent;
			color: #ddc9b4;
		}
		.pill:hover {
			border-color: #a2857a;
		}
		.pill--on {
			background: #d9b45a;
			color: #2a1214;
			font-weight: 600;
			border-color: #d9b45a;
		}
		.pill--btn {
			padding: 10px 16px;
			border-radius: 8px;
		}

		/* --- Filter description panel --- */
		.filterinfo {
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 12px;
			padding: 15px 20px;
			margin-bottom: 16px;
			display: flex;
			align-items: baseline;
			gap: 16px;
		}
		.filterinfo[hidden] {
			display: none;
		}
		.filterinfo__tag {
			font-size: 10.5px;
			text-transform: uppercase;
			letter-spacing: 1.8px;
			color: #8a6f63;
			flex: none;
		}
		.filterinfo__text {
			font-family: 'Newsreader', serif;
			font-size: 16px;
			line-height: 1.55;
			margin: 0;
			letter-spacing: 0.1px;
			color: #c2a99a;
		}
		.filterinfo__text .finfo__em {
			color: #f0d488;
			font-weight: 600;
		}

		/* --- Filter panel --- */
		.panel {
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 12px;
			padding: 24px 26px;
			margin-bottom: 26px;
		}
		.panel[hidden] {
			display: none;
		}
		.panel__head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 20px;
		}
		.panel__title {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.6px;
			color: #8a6f63;
		}
		.clear {
			font-size: 12px;
			font-weight: 600;
			color: #d9b45a;
			background: transparent;
			border: none;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			padding: 0;
		}
		.clear:hover {
			color: #f0d488;
		}
		.clear[hidden] {
			display: none;
		}
		.panel__grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 26px 40px;
		}
		.panel__wide {
			grid-column: 1 / -1;
		}
		.grp {
			font-size: 11px;
			font-weight: 400;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
			margin: 0 0 12px;
		}
		/* A second heading inside a section (Activity → Decade) needs the gap back. */
		.chips + .grp {
			margin-top: 16px;
		}
		.grp__row {
			display: flex;
			align-items: center;
			gap: 12px;
			margin-bottom: 12px;
		}
		.grp__row .grp {
			margin-bottom: 0;
		}
		.grp__none {
			font-size: 13px;
			font-style: italic;
			font-family: 'Newsreader', serif;
			color: #8a6f63;
			margin: 0;
		}
		.chips {
			display: flex;
			gap: 8px;
			flex-wrap: wrap;
		}
		.chip {
			font-size: 12.5px;
			padding: 7px 13px;
			border-radius: 20px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			border: 1px solid #4a2529;
			background: transparent;
			color: #ddc9b4;
		}
		.chip:hover {
			border-color: #a2857a;
		}
		.chip[aria-pressed='true'] {
			background: #d9b45a;
			color: #2a1214;
			font-weight: 600;
			border-color: #d9b45a;
		}
		.chip[hidden] {
			display: none;
		}
		.chip--more {
			background: transparent;
			color: #a2857a;
			border-style: dashed;
		}

		/* Dual-thumb rating range: two native sliders stacked on one track, so
		   keyboard and screen-reader support come for free. The inputs ignore
		   pointer events except on their thumbs, which lets whichever thumb is
		   under the cursor take the drag even though the boxes fully overlap. */
		.rating {
			display: flex;
			align-items: center;
			gap: 18px;
		}
		.rating--off .range {
			opacity: 0.35;
		}
		.range {
			flex: 1;
			max-width: 260px;
			position: relative;
			height: 32px;
		}
		.range__track,
		.range__fill {
			position: absolute;
			top: 14px;
			height: 4px;
			border-radius: 2px;
			pointer-events: none;
		}
		.range__track {
			left: 0;
			right: 0;
			background: #402226;
		}
		.range__fill {
			background: #d9b45a;
		}
		.range input[type='range'] {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 32px;
			margin: 0;
			background: none;
			appearance: none;
			-webkit-appearance: none;
			pointer-events: none;
		}
		.range input[type='range']:focus-visible {
			outline: none;
		}
		.range input[type='range']::-webkit-slider-thumb {
			appearance: none;
			-webkit-appearance: none;
			pointer-events: auto;
			width: 16px;
			height: 16px;
			border-radius: 50%;
			background: #f0d488;
			border: 2px solid #241012;
			box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
			cursor: pointer;
		}
		.range input[type='range']::-moz-range-thumb {
			pointer-events: auto;
			width: 16px;
			height: 16px;
			border-radius: 50%;
			background: #f0d488;
			border: 2px solid #241012;
			box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
			cursor: pointer;
		}
		.range input[type='range']:focus-visible::-webkit-slider-thumb {
			outline: 2px solid #f0d488;
			outline-offset: 2px;
		}
		.range input[type='range']:focus-visible::-moz-range-thumb {
			outline: 2px solid #f0d488;
			outline-offset: 2px;
		}
		.range__ends {
			position: absolute;
			top: 30px;
			left: 0;
			right: 0;
			display: flex;
			justify-content: space-between;
			font-size: 13px;
			color: #d9b45a;
			pointer-events: none;
		}
		/* The release-date slider reuses the rating track. Its end labels are
		   positioned out of flow, so reserve the room they occupy. */
		.range--dec {
			margin-bottom: 20px;
		}

		.where {
			display: flex;
			flex-direction: column;
			gap: 10px;
		}
		.where__row {
			display: flex;
			align-items: baseline;
			gap: 8px;
		}
		.where__label {
			font-size: 12px;
			color: #8a6f63;
			width: 60px;
			flex: none;
		}

		/* People filter: a chip-scoped search that sits beside the "People" heading. */
		.people-search {
			width: 220px;
			max-width: 100%;
			background: #1c0d0e;
			border: 1px solid #4a2529;
			border-radius: 14px;
			padding: 5px 12px;
			color: #f4e8d1;
			font-size: 12px;
			font-family: 'Archivo', sans-serif;
			outline: none;
		}
		.people-search::placeholder {
			color: #8a6f63;
		}
		.people-search:focus {
			border-color: #d9b45a;
		}
		.people-none {
			font-size: 12px;
			font-style: italic;
			font-family: 'Newsreader', serif;
			color: #8a6f63;
		}
		.people-none[hidden] {
			display: none;
		}
		.modes {
			display: flex;
			border: 1px solid #4a2529;
			border-radius: 14px;
			overflow: hidden;
		}
		.mode {
			font-size: 11px;
			font-weight: 600;
			padding: 5px 11px;
			border: none;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			background: transparent;
			color: #a2857a;
		}
		.mode--on {
			background: #d9b45a;
			color: #2a1214;
		}

		.grid {
			display: grid;
			grid-template-columns: repeat(6, 1fr);
			gap: 18px;
			margin-top: 16px;
		}
		.tile {
			position: relative;
			aspect-ratio: 2 / 3;
			border-radius: 5px;
			overflow: hidden;
			background-image: repeating-linear-gradient(135deg, #351a1d 0 9px, #2c1518 9px 18px);
			border: 1px solid #4a2529;
			transition: border-color 0.12s;
		}
		.tile:hover {
			border-color: #d9b45a;
		}
		.tile img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.tile__overlay {
			position: absolute;
			inset: 0;
			display: flex;
			flex-direction: column;
			justify-content: flex-end;
			padding: 12px;
			background: rgba(18, 8, 9, 0.82);
			opacity: 0;
			transition: opacity 0.18s ease;
		}
		.tile:hover .tile__overlay {
			opacity: 1;
		}
		/* Films with no poster: keep the caption visible over the striped tile. */
		.tile--noimg .tile__overlay {
			opacity: 1;
			background: transparent;
		}
		.tile__title {
			font-family: 'Newsreader', serif;
			font-size: 16px;
			font-weight: 500;
			color: #f4e8d1;
			line-height: 1.15;
		}
		.tile__year {
			font-family: 'Archivo', sans-serif;
			font-size: 11px;
			letter-spacing: 1.4px;
			text-transform: uppercase;
			color: #d9b45a;
			margin-top: 5px;
		}
		.tile__stars {
			font-size: 12px;
			color: #d9b45a;
			margin-top: 4px;
		}

		.empty {
			padding: 48px 0;
			text-align: center;
			color: #8a6f63;
			font-size: 15px;
			font-style: italic;
			font-family: 'Newsreader', serif;
		}
		.empty[hidden] {
			display: none;
		}

		#sentinel {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 10px;
			padding: 28px 0 8px;
			font-size: 12px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
		}
		#sentinel[hidden] {
			display: none;
		}
		.sentinel__spinner {
			width: 12px;
			height: 12px;
			border: 2px solid #4a2529;
			border-top-color: #d9b45a;
			border-radius: 50%;
			animation: spin 0.7s linear infinite;
		}
		@keyframes spin {
			to {
				transform: rotate(360deg);
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.sentinel__spinner {
				animation: none;
			}
		}
		.load-error {
			padding: 24px 0;
			text-align: center;
			font-size: 13px;
			color: #a2857a;
		}
		.load-error[hidden] {
			display: none;
		}
		.load-error button {
			font: inherit;
			color: #d9b45a;
			background: none;
			border: none;
			padding: 0;
			cursor: pointer;
			text-decoration: underline;
		}

		@media (max-width: 860px) {
			.grid {
				grid-template-columns: repeat(4, 1fr);
			}
			.panel__grid {
				grid-template-columns: minmax(0, 1fr);
			}
		}
		@media (max-width: 560px) {
			h1 {
				font-size: 40px;
			}
			.grid {
				grid-template-columns: repeat(3, 1fr);
			}
			.panel {
				padding: 20px 16px;
			}
			/* The slider needs its own line once "Unrated only" can't sit beside it. */
			.rating {
				flex-wrap: wrap;
				gap: 12px;
			}
			.range {
				max-width: none;
			}
			.where__row {
				flex-direction: column;
				align-items: stretch;
			}
		}
	</style>

	<script>
		import { mediumLabel, starText } from '../../lib/format';

		interface WatchedFilm {
			tmdb_id: number;
			title: string;
			release_year: number | null;
			poster_path: string | null;
			rating: number | null;
		}

		const grid = document.getElementById('grid');
		const sentinel = document.getElementById('sentinel');

		if (grid && sentinel) {
			const search = document.getElementById('search') as HTMLInputElement;
			const shown = document.getElementById('shown')!;
			// Latest server-reported match count, echoed into the filter sentence. The
			// grid only ever holds a slice, so this comes from the response, not the DOM.
			let shownTotal = Number((shown.textContent ?? '').replace(/[^0-9]/g, '')) || 0;
			const empty = document.getElementById('empty')!;
			const emptyQ = document.getElementById('empty-q')!;
			const emptyByQuery = document.getElementById('empty-by-query')!;
			const emptyByFilters = document.getElementById('empty-by-filters')!;
			const errorBox = document.getElementById('load-error')!;
			const retry = document.getElementById('retry')!;
			const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.pill[data-sort]'));
			const BATCH = Number(sentinel.dataset.batch);

			// Search, sort and the filters all re-query the server rather than filtering
			// the DOM: the grid only holds the pages loaded so far, so filtering here
			// would search a slice instead of the whole collection.
			let sort = 'recent';
			let q = '';
			let offset = grid.childElementCount;
			let loading = false;
			// The server hides the sentinel when the first page is already everything.
			let done = sentinel.hidden;
			// Identifies the newest request; a response from an older one is discarded so
			// fast typing can't let a stale batch land after the one it superseded.
			let seq = 0;
			// Whether the failed request was a reset, so Retry repeats it in the same mode
			// rather than appending a fresh query's page onto the previous query's grid.
			let retryReset = false;

			const fmt = (n: number) => n.toLocaleString('en-US');

			// --- Filter state ---------------------------------------------------
			// Mirrors the API's params. The multi-value sets hold the chips' raw
			// data-value (a theater's full "Name, City"), never the shortened label.
			const RATING_FLOOR = 0.5;
			const RATING_CEIL = 5;
			const sets = {
				tag: new Set<string>(),
				friend: new Set<string>(),
				medium: new Set<string>(),
				venue: new Set<string>(),
				format: new Set<string>(),
				director: new Set<string>(),
				actor: new Set<string>(),
			};
			type SetKey = keyof typeof sets;
			const flags = { liked: false, rewatched: false, unrated: false };
			const modes = { friendmode: 'any', wheremode: 'any' };
			let rMin = RATING_FLOOR;
			let rMax = RATING_CEIL;

			// Release-date bounds, as a decade's first year. The slider is only drawn
			// when the collection spans more than one decade; without it these stay at
			// the ends and the filter never engages.
			const drange = document.getElementById('drange');
			const DEC_LO = drange ? Number(drange.dataset.lo) : 0;
			const DEC_HI = drange ? Number(drange.dataset.hi) : 0;
			let dMin = DEC_LO;
			let dMax = DEC_HI;

			/** Whether the rating control narrows anything. */
			const ratingActive = () =>
				flags.unrated || rMin > RATING_FLOOR || rMax < RATING_CEIL;

			/** Whether the release-date range narrows anything. */
			const decadeActive = () => Boolean(drange) && (dMin > DEC_LO || dMax < DEC_HI);

			/** Number of active filters — the count on the Filters button. The rating
			 * and release-date ranges each count once however many steps they span. */
			function activeCount(): number {
				let n =
					(ratingActive() ? 1 : 0) +
					(decadeActive() ? 1 : 0) +
					(flags.liked ? 1 : 0) +
					(flags.rewatched ? 1 : 0);
				for (const s of Object.values(sets)) n += s.size;
				return n;
			}

			function buildQuery(from: number): string {
				const p = new URLSearchParams();
				p.set('limit', String(BATCH));
				p.set('offset', String(from));
				p.set('sort', sort);
				if (q) p.set('q', q);
				if (flags.unrated) p.set('unrated', '1');
				else {
					// Omit a bound at its extreme so the server can tell "any rating"
					// from a range that happens to reach the end.
					if (rMin > RATING_FLOOR) p.set('rmin', String(rMin));
					if (rMax < RATING_CEIL) p.set('rmax', String(rMax));
				}
				if (flags.liked) p.set('liked', '1');
				if (flags.rewatched) p.set('rewatched', '1');
				// The API matches a list of decades, not a span, so send every decade the
				// slider covers. At most a dozen — the collection doesn't predate film.
				if (decadeActive()) {
					for (let d = dMin; d <= dMax; d += 10) p.append('decade', String(d));
				}
				for (const [key, values] of Object.entries(sets)) {
					for (const v of values) p.append(key, v);
				}
				if (sets.friend.size) p.set('friendmode', modes.friendmode);
				if (sets.medium.size || sets.venue.size || sets.format.size) {
					p.set('wheremode', modes.wheremode);
				}
				return p.toString();
			}

			// Astro scopes this page's CSS behind a generated data-astro-cid-* attribute,
			// so every node we build has to carry it or it renders unstyled. Read the name
			// off a server-rendered element rather than hard-coding the hash, which
			// changes whenever this file does.
			const scopeAttr = Array.from(grid.attributes)
				.map((a) => a.name)
				.find((n) => n.startsWith('data-astro-cid-'));

			function el(tag: string, className?: string, text?: string): HTMLElement {
				const node = document.createElement(tag);
				if (scopeAttr) node.setAttribute(scopeAttr, '');
				if (className) node.className = className;
				if (text != null) node.textContent = text;
				return node;
			}

			// Mirrors the server-rendered tile markup above.
			function buildTile(f: WatchedFilm): HTMLAnchorElement {
				const tile = el('a', f.poster_path ? 'tile' : 'tile tile--noimg') as HTMLAnchorElement;
				tile.href = `/films/movie/${f.tmdb_id}`;
				if (f.poster_path) {
					const img = el('img') as HTMLImageElement;
					img.src = `https://image.tmdb.org/t/p/w342${f.poster_path}`;
					img.alt = `${f.title} poster`;
					img.loading = 'lazy';
					tile.append(img);
				}
				const overlay = el('div', 'tile__overlay');
				overlay.append(
					el('div', 'tile__title', f.title),
					el('div', 'tile__year', f.release_year == null ? '' : String(f.release_year)),
					el('div', 'tile__stars', starText(f.rating) ?? 'Unrated'),
				);
				tile.append(overlay);
				return tile;
			}

			// The observer only fires on a crossing, so re-arm it after every load: a batch
			// too short to push the sentinel out of view still loads the next one.
			function armSentinel() {
				observer.unobserve(sentinel!);
				sentinel!.hidden = done;
				if (!done) observer.observe(sentinel!);
			}

			/** `reset` restarts from offset 0 for a new query/sort, replacing the grid. */
			async function load(reset = false) {
				if (!reset && (loading || done)) return;
				// Every re-query is a filter change; paging isn't, and offset stays out
				// of the URL so a shared link opens at the top.
				if (reset) writeUrl();
				const mySeq = ++seq;
				loading = true;
				errorBox.hidden = true;
				const from = reset ? 0 : offset;
				try {
					const res = await fetch(`/api/films/watched/list?${buildQuery(from)}`);
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					const { films, total } = (await res.json()) as { films: WatchedFilm[]; total: number };
					if (mySeq !== seq) return; // superseded by a newer query

					if (reset) {
						grid!.replaceChildren();
						offset = 0;
					}
					for (const f of films) grid!.append(buildTile(f));
					offset += films.length;

					shown.textContent = fmt(total);
					shownTotal = total;
					renderFilterInfo();
					// Quote the search term when it's the only thing narrowing; once a
					// filter is on too, the term alone no longer explains the emptiness.
					const onlyQuery = q !== '' && activeCount() === 0;
					emptyQ.textContent = q;
					emptyByQuery.hidden = !onlyQuery;
					emptyByFilters.hidden = onlyQuery;
					empty.hidden = total > 0 || (!q && activeCount() === 0);
					done = offset >= total || films.length < BATCH;
					armSentinel();
				} catch (e) {
					if (mySeq !== seq) return;
					// Leave the observer parked so a failure can't hot-loop the API; the
					// retry button is the way back.
					console.error('watched: failed to load films', e);
					retryReset = reset;
					errorBox.hidden = false;
				} finally {
					if (mySeq === seq) loading = false;
				}
			}

			// Start fetching a screenful early so scrolling stays continuous.
			const observer = new IntersectionObserver(
				(entries) => {
					if (entries.some((entry) => entry.isIntersecting)) load();
				},
				{ rootMargin: '600px' },
			);
			armSentinel();

			let debounce = 0;
			search.addEventListener('input', () => {
				window.clearTimeout(debounce);
				debounce = window.setTimeout(() => {
					const next = search.value.trim();
					if (next === q) return;
					q = next;
					load(true);
				}, 250);
			});

			for (const pill of pills) {
				pill.addEventListener('click', () => {
					if (pill.dataset.sort === sort) return;
					sort = pill.dataset.sort!;
					for (const p of pills) p.classList.toggle('pill--on', p === pill);
					load(true);
				});
			}

			retry.addEventListener('click', () => load(retryReset));

			// --- Filter panel ---------------------------------------------------
			const panel = document.getElementById('filters')!;
			const toggle = document.getElementById('filters-toggle')!;
			const countBadge = document.getElementById('filters-count')!;
			const clearAll = document.getElementById('clear-all') as HTMLButtonElement;
			const filterChips = Array.from(
				panel.querySelectorAll<HTMLButtonElement>('.chip[data-filter]'),
			);
			const flagChips = Array.from(panel.querySelectorAll<HTMLButtonElement>('.chip[data-flag]'));
			const rminInput = document.getElementById('rmin') as HTMLInputElement;
			const rmaxInput = document.getElementById('rmax') as HTMLInputElement;
			const rangeFill = document.getElementById('range-fill')!;
			const rminStars = document.getElementById('rmin-stars')!;
			const rmaxStars = document.getElementById('rmax-stars')!;
			const ratingBox = document.querySelector('.rating')!;
			const dminInput = document.getElementById('dmin') as HTMLInputElement | null;
			const dmaxInput = document.getElementById('dmax') as HTMLInputElement | null;
			const drangeFill = document.getElementById('drange-fill');
			const dminLabel = document.getElementById('dmin-label');
			const dmaxLabel = document.getElementById('dmax-label');

			/** Reflect state that isn't owned by the control the user just touched. */
			function syncChrome() {
				const n = activeCount();
				countBadge.textContent = n ? ` · ${n}` : '';
				toggle.classList.toggle('pill--on', panel.hidden === false || n > 0);
				clearAll.hidden = n === 0;

				const pct = (v: number) =>
					((v - RATING_FLOOR) / (RATING_CEIL - RATING_FLOOR)) * 100;
				rangeFill.style.left = `${pct(rMin)}%`;
				rangeFill.style.width = `${pct(rMax) - pct(rMin)}%`;
				rminStars.textContent = starText(rMin);
				rmaxStars.textContent = starText(rMax);
				// The two inputs cover the same box, so where the thumbs overlap the
				// later one in the DOM (max) swallows the drag. Raise min once it's past
				// the midpoint, which is the only place the two can meet.
				const overlapping = rMin > (RATING_FLOOR + RATING_CEIL) / 2;
				rminInput.style.zIndex = overlapping ? '2' : '1';
				rmaxInput.style.zIndex = overlapping ? '1' : '2';
				// "Unrated only" and a star range are mutually exclusive; dim the one
				// that isn't in play rather than hiding it.
				ratingBox.classList.toggle('rating--off', flags.unrated);

				if (drange && drangeFill && dminLabel && dmaxLabel) {
					const dpct = (v: number) => ((v - DEC_LO) / (DEC_HI - DEC_LO)) * 100;
					drangeFill.style.left = `${dpct(dMin)}%`;
					drangeFill.style.width = `${dpct(dMax) - dpct(dMin)}%`;
					dminLabel.textContent = `${dMin}s`;
					dmaxLabel.textContent = `${dMax}s`;
					const dOverlap = dMin > (DEC_LO + DEC_HI) / 2;
					dminInput!.style.zIndex = dOverlap ? '2' : '1';
					dmaxInput!.style.zIndex = dOverlap ? '1' : '2';
				}

				renderFilterInfo();
			}

			// --- Filter description sentence ------------------------------------
			// A plain-English summary of every active filter, e.g. "You have
			// rewatched 3 criterion films directed by … rated between ★★★★ and
			// ★★★★★ … with Maya or Dana seen at the Metrograph or in 70mm." It reads
			// the same state buildQuery does, so it can never disagree with the grid.
			const filterInfo = document.getElementById('filterinfo')!;
			const filterInfoText = document.getElementById('filterinfo-text')!;

			/** Join names as "a", "a and b", "a, b, and c" — conjunction configurable
			 * so the any/all toggles can read "or" vs "and". */
			function andList(items: string[], conj = 'and'): string {
				if (items.length <= 1) return items.join('');
				if (items.length === 2) return `${items[0]} ${conj} ${items[1]}`;
				return `${items.slice(0, -1).join(', ')}, ${conj} ${items[items.length - 1]}`;
			}

			// A theater's short chip label, keyed by its raw "Name, City" value — the
			// sentence says "at the Metrograph", not the full stored string.
			const venueLabelByValue = new Map<string, string>();
			for (const chip of Array.from(
				panel.querySelectorAll<HTMLElement>('.chip[data-filter="venue"]'),
			)) {
				venueLabelByValue.set(chip.dataset.value!, (chip.textContent ?? '').trim());
			}
			// Each medium reads with its own natural preposition.
			const MEDIUM_PHRASE: Record<string, string> = {
				theater: 'in a theater',
				tv: 'on TV',
				computer: 'on a computer',
				plane: 'on a plane',
				tablet: 'on an iPad',
				ipad: 'on an iPad',
			};
			const mediumPhrase = (v: string) => MEDIUM_PHRASE[v] ?? `on ${mediumLabel(v)}`;
			const venuePhrase = (v: string) => {
				const label = venueLabelByValue.get(v) ?? v;
				// Names that already lead with "The" don't want a second article.
				return /^the\s/i.test(label) ? `at ${label}` : `at the ${label}`;
			};

			/** Rebuild the filter sentence from current state and show/hide the panel. */
			function renderFilterInfo() {
				filterInfo.hidden = activeCount() === 0;
				if (filterInfo.hidden) return;

				const parts: { t: string; em: boolean }[] = [];
				const lit = (t: string) => parts.push({ t, em: false });
				const em = (t: string) => parts.push({ t, em: true });

				lit(flags.rewatched ? 'You have rewatched ' : 'You have watched ');
				em(fmt(shownTotal));
				// Tags fill the design's "{genre(s)}" adjective slot.
				if (sets.tag.size) {
					lit(' ');
					em(andList([...sets.tag]));
				}
				lit(shownTotal === 1 ? ' film' : ' films');
				if (sets.director.size) {
					lit(' directed by ');
					em(andList([...sets.director]));
				}
				if (sets.actor.size) {
					lit(' starring ');
					em(andList([...sets.actor]));
				}
				if (flags.unrated) {
					lit(' that are ');
					em('unrated');
				} else if (ratingActive()) {
					if (rMin === rMax) {
						lit(' rated ');
						em(starText(rMin)!);
					} else {
						lit(' rated between ');
						em(`${starText(rMin)} and ${starText(rMax)}`);
					}
				}
				if (flags.liked) {
					lit(' that you ');
					em('liked');
				}
				if (decadeActive()) {
					if (dMin === dMax) {
						lit(' released in the ');
						em(`${dMin}s`);
					} else {
						lit(' released between ');
						em(`${dMin}s and ${dMax}s`);
					}
				}
				if (sets.friend.size) {
					lit(' with ');
					em(andList([...sets.friend], modes.friendmode === 'all' ? 'and' : 'or'));
				}
				// Medium, theater and format share one any/all toggle, so they read as a
				// single pool. Each carries its own preposition and is emphasized on its
				// own, joined by the toggle's conjunction. A named theater already says
				// "in a theater", so drop the redundant theater medium when a venue is set.
				const mediums =
					sets.venue.size > 0
						? [...sets.medium].filter((m) => m !== 'theater')
						: [...sets.medium];
				const whereItems = [
					...[...sets.venue].map(venuePhrase),
					...[...sets.format].map((f) => `in ${f}`),
					...mediums.map(mediumPhrase),
				];
				if (whereItems.length) {
					const conj = modes.wheremode === 'all' ? 'and' : 'or';
					lit(' seen ');
					whereItems.forEach((item, i) => {
						if (i > 0) {
							const last = i === whereItems.length - 1;
							lit(whereItems.length > 2 ? (last ? `, ${conj} ` : ', ') : ` ${conj} `);
						}
						em(item);
					});
				}
				lit('.');

				filterInfoText.replaceChildren(
					...parts.map((p) => el('span', p.em ? 'finfo__em' : undefined, p.t)),
				);
			}

			function applyFilters() {
				syncChrome();
				load(true);
			}

			toggle.addEventListener('click', () => {
				panel.hidden = !panel.hidden;
				toggle.setAttribute('aria-expanded', String(!panel.hidden));
				syncChrome();
			});

			// --- People (director / cast) ---------------------------------------
			// The credit lists run to thousands of names, so — unlike the other groups —
			// these chips aren't all shipped in the DOM. Each row shows the top few by
			// frequency and the search box builds matching chips on demand from the JSON
			// payload. The picks live in sets.director / sets.actor, so buildQuery, the
			// URL and the active-filter count read them the same as any other group.
			type PeopleKind = 'director' | 'actor';
			const PEOPLE_TOP = 12; // default quick chips per row, before searching
			const PEOPLE_MAX = 40; // most chips one search shows at once
			const peopleSearch = document.getElementById('people-search') as HTMLInputElement | null;
			const peopleNames: Record<PeopleKind, string[]> = { director: [], actor: [] };
			const namesEl = panel.querySelector('script[data-people-names]');
			if (namesEl?.textContent) {
				try {
					const parsed = JSON.parse(namesEl.textContent) as {
						directors?: string[];
						actors?: string[];
					};
					peopleNames.director = parsed.directors ?? [];
					peopleNames.actor = parsed.actors ?? [];
				} catch (e) {
					console.error('watched: could not parse people names', e);
				}
			}

			interface PeopleRow {
				kind: PeopleKind;
				host: HTMLElement;
				none: HTMLElement;
			}
			const peopleRows: PeopleRow[] = Array.from(
				panel.querySelectorAll<HTMLElement>('.chips[data-people]'),
			).map((host) => ({
				kind: host.dataset.people as PeopleKind,
				host,
				none: host.querySelector<HTMLElement>('.people-none')!,
			}));
			let peopleQ = '';

			function makePeopleChip(kind: PeopleKind, name: string): HTMLButtonElement {
				const chip = el('button', 'chip') as HTMLButtonElement;
				chip.type = 'button';
				chip.dataset.filter = kind;
				chip.dataset.value = name;
				chip.setAttribute('aria-pressed', String(sets[kind].has(name)));
				chip.textContent = name;
				chip.addEventListener('click', () => {
					if (sets[kind].has(name)) sets[kind].delete(name);
					else sets[kind].add(name);
					chip.setAttribute('aria-pressed', String(sets[kind].has(name)));
					applyFilters();
				});
				return chip;
			}

			function renderPeopleRow(row: PeopleRow) {
				const selected = sets[row.kind];
				let names: string[];
				if (peopleQ) {
					names = peopleNames[row.kind]
						.filter((n) => n.toLowerCase().includes(peopleQ))
						.slice(0, PEOPLE_MAX);
					// Keep picked names on screen even when they don't match the search, so
					// they can be seen and cleared without retyping.
					for (const s of selected) if (!names.includes(s)) names.unshift(s);
				} else {
					// Default view: the most-frequent few, plus any pick reaching past them.
					names = peopleNames[row.kind].slice(0, PEOPLE_TOP);
					for (const s of selected) if (!names.includes(s)) names.push(s);
				}
				const chips = names.map((n) => makePeopleChip(row.kind, n));
				row.host.replaceChildren(...chips, row.none);
				// "No matches" shows only when a search turned up nothing to display.
				row.none.hidden = !(peopleQ !== '' && chips.length === 0);
			}

			function renderPeople() {
				for (const row of peopleRows) renderPeopleRow(row);
			}

			peopleSearch?.addEventListener('input', () => {
				peopleQ = peopleSearch.value.trim().toLowerCase();
				renderPeople();
			});

			for (const chip of filterChips) {
				chip.addEventListener('click', () => {
					const key = chip.dataset.filter as SetKey;
					const value = chip.dataset.value!;
					const on = !sets[key].has(value);
					if (on) sets[key].add(value);
					else sets[key].delete(value);
					chip.setAttribute('aria-pressed', String(on));
					applyFilters();
				});
			}

			for (const chip of flagChips) {
				chip.addEventListener('click', () => {
					const key = chip.dataset.flag as keyof typeof flags;
					flags[key] = !flags[key];
					chip.setAttribute('aria-pressed', String(flags[key]));
					// Turning on "Unrated only" resets the star range it overrides, so
					// clearing it later doesn't restore a range the user can't see.
					if (key === 'unrated' && flags.unrated) setRange(RATING_FLOOR, RATING_CEIL);
					applyFilters();
				});
			}

			// "+N other…" reveals the rest of a chip group and then removes itself:
			// collapsing again would have to hide chips the user may have just picked.
			for (const more of Array.from(panel.querySelectorAll<HTMLButtonElement>('.chip--more'))) {
				more.addEventListener('click', () => {
					for (const sibling of Array.from(more.parentElement!.children)) {
						(sibling as HTMLElement).hidden = false;
					}
					more.remove();
				});
			}

			for (const group of Array.from(panel.querySelectorAll<HTMLElement>('.modes'))) {
				const key = group.dataset.mode as keyof typeof modes;
				const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('.mode'));
				for (const button of buttons) {
					button.addEventListener('click', () => {
						if (modes[key] === button.dataset.value) return;
						modes[key] = button.dataset.value!;
						for (const b of buttons) b.classList.toggle('mode--on', b === button);
						// A mode toggle only changes results once something is selected.
						const relevant =
							key === 'friendmode'
								? sets.friend.size > 0
								: sets.medium.size + sets.venue.size + sets.format.size > 0;
						if (relevant) applyFilters();
					});
				}
			}

			/** Move both thumbs, keeping min ≤ max and the inputs in step. */
			function setRange(min: number, max: number) {
				rMin = Math.min(min, max);
				rMax = Math.max(min, max);
				rminInput.value = String(rMin);
				rmaxInput.value = String(rMax);
			}

			for (const input of [rminInput, rmaxInput]) {
				input.addEventListener('input', () => {
					// The thumbs share a track, so each one pushes rather than crosses.
					const min = Number(rminInput.value);
					const max = Number(rmaxInput.value);
					if (input === rminInput) setRange(Math.min(min, max), max);
					else setRange(min, Math.max(min, max));
					// Dragging a star range is a choice to filter by stars.
					if (flags.unrated) {
						flags.unrated = false;
						const chip = panel.querySelector<HTMLButtonElement>('.chip[data-flag="unrated"]')!;
						chip.setAttribute('aria-pressed', 'false');
					}
					syncChrome();
				});
				// Re-query on release rather than per half-star: a drag across the track
				// would otherwise fire ten requests.
				input.addEventListener('change', applyFilters);
			}

			/** Move both release-date thumbs, keeping min ≤ max. */
			function setDecades(min: number, max: number) {
				dMin = Math.min(min, max);
				dMax = Math.max(min, max);
				dminInput!.value = String(dMin);
				dmaxInput!.value = String(dMax);
			}

			if (dminInput && dmaxInput) {
				for (const input of [dminInput, dmaxInput]) {
					input.addEventListener('input', () => {
						const min = Number(dminInput.value);
						const max = Number(dmaxInput.value);
						if (input === dminInput) setDecades(Math.min(min, max), max);
						else setDecades(min, Math.max(min, max));
						syncChrome();
					});
					input.addEventListener('change', applyFilters);
				}
			}

			clearAll.addEventListener('click', () => {
				for (const s of Object.values(sets)) s.clear();
				for (const chip of [...filterChips, ...flagChips]) {
					chip.setAttribute('aria-pressed', 'false');
				}
				flags.liked = flags.rewatched = flags.unrated = false;
				setRange(RATING_FLOOR, RATING_CEIL);
				if (dminInput && dmaxInput) setDecades(DEC_LO, DEC_HI);
				// Deselecting the People chips lets their rows collapse back to the limit.
				renderPeople();
				applyFilters();
			});

			// --- URL state ------------------------------------------------------
			// The filters live in the query string so a narrowed grid is linkable and
			// survives a reload. Always replaceState, never pushState: a chip press is
			// not a navigation, and stacking one entry per press would leave Back
			// walking the filter history instead of returning to wherever you came
			// from. This mirrors the API's param names, minus paging.
			const URL_SETS: SetKey[] = ['tag', 'friend', 'medium', 'venue', 'format', 'director', 'actor'];

			function writeUrl() {
				const p = new URLSearchParams();
				if (q) p.set('q', q);
				if (sort !== 'recent') p.set('sort', sort);
				if (flags.unrated) p.set('unrated', '1');
				else {
					if (rMin > RATING_FLOOR) p.set('rmin', String(rMin));
					if (rMax < RATING_CEIL) p.set('rmax', String(rMax));
				}
				if (flags.liked) p.set('liked', '1');
				if (flags.rewatched) p.set('rewatched', '1');
				// A span, not the expanded decade list buildQuery sends — the URL is read
				// by people.
				if (decadeActive()) {
					p.set('dmin', String(dMin));
					p.set('dmax', String(dMax));
				}
				for (const key of URL_SETS) for (const v of sets[key]) p.append(key, v);
				if (sets.friend.size) p.set('friendmode', modes.friendmode);
				if (sets.medium.size || sets.venue.size || sets.format.size) {
					p.set('wheremode', modes.wheremode);
				}
				const qs = p.toString();
				const url = location.pathname + (qs ? `?${qs}` : '');
				if (url !== location.pathname + location.search) history.replaceState(null, '', url);
			}

			/** Re-label "+N other…" once restoring reveals chips from past the cut. */
			function syncMore() {
				for (const more of Array.from(panel.querySelectorAll<HTMLButtonElement>('.chip--more'))) {
					const hidden = Array.from(more.parentElement!.children).filter(
						(c) => (c as HTMLElement).hidden,
					).length;
					if (hidden === 0) more.remove();
					else more.textContent = `+${hidden} other…`;
				}
			}

			const snap = (raw: string | null, lo: number, hi: number, step: number, fallback: number) => {
				const n = Number(raw);
				if (raw == null || !Number.isFinite(n)) return fallback;
				return Math.min(hi, Math.max(lo, Math.round(n / step) * step));
			};

			/** Restore filters from the query string. Returns whether any were applied. */
			function readUrl(): boolean {
				const p = new URLSearchParams(location.search);
				if ([...p.keys()].length === 0) return false;

				q = p.get('q')?.trim() ?? '';
				search.value = q;
				const urlSort = p.get('sort');
				if (urlSort === 'recent' || urlSort === 'year') {
					sort = urlSort;
					for (const pill of pills) pill.classList.toggle('pill--on', pill.dataset.sort === sort);
				}

				flags.unrated = p.get('unrated') === '1';
				flags.liked = p.get('liked') === '1';
				flags.rewatched = p.get('rewatched') === '1';
				for (const chip of flagChips) {
					chip.setAttribute('aria-pressed', String(flags[chip.dataset.flag as keyof typeof flags]));
				}
				if (!flags.unrated) {
					setRange(
						snap(p.get('rmin'), RATING_FLOOR, RATING_CEIL, 0.5, RATING_FLOOR),
						snap(p.get('rmax'), RATING_FLOOR, RATING_CEIL, 0.5, RATING_CEIL),
					);
				}
				if (dminInput && dmaxInput) {
					setDecades(
						snap(p.get('dmin'), DEC_LO, DEC_HI, 10, DEC_LO),
						snap(p.get('dmax'), DEC_LO, DEC_HI, 10, DEC_HI),
					);
				}

				// Drive the sets from the chips rather than straight off the params, so a
				// stale or hand-typed value can't end up selected with no control to
				// clear it — and a restored chip from past its group's cut gets revealed.
				const wanted = new Map(URL_SETS.map((key) => [key, new Set(p.getAll(key))]));
				for (const chip of filterChips) {
					const key = chip.dataset.filter as SetKey;
					if (!wanted.get(key)?.has(chip.dataset.value!)) continue;
					sets[key].add(chip.dataset.value!);
					chip.setAttribute('aria-pressed', 'true');
					chip.hidden = false;
				}
				syncMore();

				// People chips aren't shipped in the DOM, so restore their picks straight
				// into the sets — validated against the known names so a stale or hand-typed
				// value can't select with no chip to clear it. renderPeople() draws them.
				for (const kind of ['director', 'actor'] as const) {
					const known = new Set(peopleNames[kind]);
					for (const v of p.getAll(kind)) if (known.has(v)) sets[kind].add(v);
				}

				for (const key of ['friendmode', 'wheremode'] as const) {
					const mode = p.get(key);
					if (mode !== 'any' && mode !== 'all') continue;
					modes[key] = mode;
					const group = panel.querySelector<HTMLElement>(`.modes[data-mode="${key}"]`);
					for (const b of Array.from(group?.querySelectorAll<HTMLButtonElement>('.mode') ?? [])) {
						b.classList.toggle('mode--on', b.dataset.value === mode);
					}
				}

				return q !== '' || sort !== 'recent' || activeCount() > 0;
			}

			// The server rendered the unfiltered first page, so a URL carrying filters
			// has to re-query before the grid matches what it claims to show.
			const restored = readUrl();
			syncChrome();
			// Draw the People chips — the top few plus any names restored from the URL.
			renderPeople();
			if (restored) load(true);
		}
	</script>
</FilmLayout>
