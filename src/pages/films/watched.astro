---
import FilmLayout from '../../layouts/FilmLayout.astro';
import { countWatchedFilms, listWatchedPage } from '../../lib/films';
import { starText } from '../../lib/format';
import { filterSentence } from '../../lib/watched-filters';
import { watchedFilterCount, watchedQueryFromParams } from '../../lib/watched-params';
import { imageUrl } from '../../lib/tmdb';
import { requireOwner } from '../../lib/auth';
import SiteHeader from '../../components/SiteHeader.astro';

// Rendered on demand — reflects the live database.
export const prerender = false;

/** Films per page. The first batch is server-rendered; the rest are fetched from
 * /api/films/watched/list as you scroll (that route caps `limit` at 100). */
const BATCH = 100;

// The first page is rendered with the URL's filters already applied, through the
// same parser the paging API uses. A deep link — a director from a film page, a
// genre, a Stats bar — therefore paints its own films once, instead of shipping
// the newest 100 (and starting 100 poster downloads) only for the script to throw
// them away and re-query the moment it ran.
//
// The filter chips deliberately aren't part of this await. Deriving them means
// reading every watched film's credits plus the whole diary — several times the
// cost of the 100 tiles below, for a panel that starts collapsed. They come from
// /api/films/watched/facets once the page has painted (see applyFacets in the
// script), which is what lets the grid show up as soon as its own query returns.
const isOwner = await requireOwner(Astro.cookies);
const parsed = watchedQueryFromParams(Astro.url.searchParams);
// Friends are owner-only everywhere on the site. Dropping them from the query
// before anything reads it keeps a hand-typed `?friend=…` out of the filter
// sentence, the Filters count and the grid alike (listWatchedPage guards too).
const query = isOwner ? parsed : { ...parsed, friends: [], friendMode: 'any' as const };
// Search is a filter for counting purposes but not for describing: the filter
// sentence and the Filters badge belong to the panel's filters proper, while the
// term has its own box beside them.
const filterCount = watchedFilterCount(query);
const hasFilters = filterCount > 0;
const filtered = hasFilters || query.q !== '';
const [{ films, total }, watchedCount] = await Promise.all([
	listWatchedPage({ ...query, limit: BATCH }, isOwner),
	// "N films watched" counts the whole collection, so a filtered page needs its
	// own count; unfiltered, the query's own total already is that number.
	filtered ? countWatchedFilms() : Promise.resolve(null),
]);
const collectionTotal = watchedCount ?? total;
const hasMore = total > films.length;
const num = (n: number) => n.toLocaleString('en-US');

// An empty grid quotes the search term only when the term is the only thing
// narrowing; once a filter is on too, the term alone no longer explains it.
const onlyQuery = query.q !== '' && !hasFilters;

// The filter sentence, drawn server-side for the same reason the tiles are: it
// sits above the grid, so having the script add it after paint would shove the
// posters down. The script rebuilds it from live state on every change (and once
// at startup), from this same builder.
const summary = hasFilters
	? filterSentence({
			total,
			rewatched: Boolean(query.rewatched),
			liked: Boolean(query.liked),
			unrated: Boolean(query.unratedOnly),
			ratingMin: query.ratingMin ?? null,
			ratingMax: query.ratingMax ?? null,
			releaseYearMin: query.releaseYearMin ?? null,
			releaseYearMax: query.releaseYearMax ?? null,
			releaseYears: query.releaseYears ?? [],
			diaryYearMin: query.diaryYearMin ?? null,
			diaryYearMax: query.diaryYearMax ?? null,
			tags: query.tags ?? [],
			directors: query.directors ?? [],
			actors: query.actors ?? [],
			genres: query.genres ?? [],
			languages: query.languages ?? [],
			countries: query.countries ?? [],
			friends: query.friends ?? [],
			friendMode: query.friendMode ?? 'any',
			mediums: query.mediums ?? [],
			// Theater names shorten only once the facets carrying the labels land;
			// until then the sentence reads the full stored "Name, City".
			venues: query.venues ?? [],
			formats: query.formats ?? [],
		})
	: [];
---

<FilmLayout title="Films watched — Jason's film log">
	<div class="page">
		<div class="wrap">
			<SiteHeader pathname={Astro.url.pathname} theme="film" max="1064px" />

			<header class="topbar">
				<a class="back" href="/films">
					<span class="back__arrow">←</span><span>Jason's film log</span>
				</a>
				<span class="topbar__tag">Films watched</span>
			</header>

			<div class="titleblock">
				<div>
					<h1>All films</h1>
					<div class="sub">
						<span class="sub__n">{num(collectionTotal)}</span> films watched · showing{' '}
						<span class="sub__n" id="shown">{num(total)}</span>
					</div>
				</div>
			</div>

			<div class="filterbar">
				<input
					type="search"
					id="search"
					placeholder="Search films…"
					autocomplete="off"
					aria-label="Search films"
				/>
				<button
					type="button"
					id="filters-toggle"
					class={hasFilters ? 'pill pill--btn pill--on' : 'pill pill--btn'}
					aria-expanded="false"
					aria-controls="filters"
				>
					Filters<span id="filters-count">{hasFilters ? ` · ${filterCount}` : ''}</span>
				</button>
				<div class="sortby">
					<span class="sortby__label">Sort</span>
					<button type="button" class="pill pill--on" data-sort="recent">Recent</button>
					<button type="button" class="pill" data-sort="year">Release date</button>
				</div>
			</div>

			{/* Everything chip- or range-shaped in here is filled in by applyFacets()
			    from /api/films/watched/facets. Only the controls that need no
			    knowledge of the collection — search, sort, the star range, the
			    activity flags — are usable before that lands. */}
			<div class="panel" id="filters" hidden>
				<div class="panel__head">
					<span class="panel__title">Filter films</span>
					<span class="panel__loading" id="facets-loading">Loading filters…</span>
					<button type="button" id="clear-all" class="clear" hidden>Clear all</button>
				</div>
				<p class="panel__error" id="facets-error" hidden>
					Could not load the filters. <button type="button" id="facets-retry">Retry</button>
				</p>

				<div class="panel__grid">
					<section>
						<h2 class="grp">Rating</h2>
						<div class="rating">
							<div class="range" id="range">
								<div class="range__track"></div>
								<div class="range__fill" id="range-fill"></div>
								<input type="range" id="rmin" min="0.5" max="5" step="0.5" value="0.5" aria-label="Minimum rating" />
								<input type="range" id="rmax" min="0.5" max="5" step="0.5" value="5" aria-label="Maximum rating" />
								<div class="range__ends">
									<span id="rmin-stars">½</span><span id="rmax-stars">★★★★★</span>
								</div>
							</div>
							<button type="button" class="chip" data-flag="unrated" aria-pressed="false">Unrated only</button>
						</div>
					</section>

					<section>
						<h2 class="grp">Activity</h2>
						<div class="chips chips--gap">
							<button type="button" class="chip" data-flag="liked" aria-pressed="false">♥ Liked</button>
							<button type="button" class="chip" data-flag="rewatched" aria-pressed="false">↻ Rewatched</button>
						</div>
					</section>

					{/* Bounds arrive with the facets; until then the slider isn't drawn,
					    same as when the collection spans a single year. */}
					<section id="yrange-section" hidden>
						<h2 class="grp">Diary date</h2>
						<div class="range range--dec" id="yrange">
							<div class="range__track"></div>
							<div class="range__fill" id="yrange-fill"></div>
							<input type="range" id="ymin" step="1" aria-label="Earliest diary year" />
							<input type="range" id="ymax" step="1" aria-label="Latest diary year" />
							<div class="range__ends">
								<span id="ymin-label"></span><span id="ymax-label"></span>
							</div>
						</div>
					</section>

					<section data-group="tag">
						<h2 class="grp">Tags</h2>
						<p class="grp__none" data-none hidden>No tags yet</p>
						<div class="chips" data-chips="tag"></div>
					</section>

					{isOwner && (
						<section data-group="friend">
							<div class="grp__row">
								<h2 class="grp">Watched with</h2>
								<div class="modes" data-mode="friendmode">
									<button type="button" class="mode mode--on" data-value="any">Any</button>
									<button type="button" class="mode" data-value="all">All</button>
								</div>
							</div>
							<p class="grp__none" data-none hidden>No one tagged yet</p>
							<div class="chips" data-chips="friend"></div>
						</section>
					)}

					<section class="panel__wide">
						<div class="grp__row">
							<h2 class="grp">Medium · theater · format</h2>
							<div class="modes" data-mode="wheremode">
								<button type="button" class="mode mode--on" data-value="any">Any</button>
								<button type="button" class="mode" data-value="all">All</button>
							</div>
						</div>
						<div class="where">
							<div class="where__row">
								<span class="where__label">Medium</span>
								<div class="chips" data-chips="medium"></div>
							</div>
							<div class="where__row">
								<span class="where__label">Theater</span>
								<div class="chips" data-chips="venue"></div>
							</div>
							<div class="where__row">
								<span class="where__label">Format</span>
								<div class="chips" data-chips="format"></div>
							</div>
						</div>
					</section>
				</div>

				<div class="moviedetails">
					<button
						type="button"
						id="md-toggle"
						class="md__toggle"
						aria-expanded="false"
						aria-controls="md-body"
					>
						<span class="md__chevron" aria-hidden="true">▸</span>
						<span class="md__label">Movie details</span>
						<span class="md__count" id="md-count"></span>
					</button>

					<div class="md__body" id="md-body" hidden>
						<div class="panel__grid">
							{/* Bounds arrive with the facets; until then the slider isn't drawn,
							    same as when the collection sits inside one year. */}
							<section id="drange-section" hidden>
								<h2 class="grp">Release date</h2>
								<div class="range range--dec" id="drange">
									<div class="range__track"></div>
									<div class="range__fill" id="drange-fill"></div>
									<input type="range" id="dmin" step="1" aria-label="Earliest release year" />
									<input type="range" id="dmax" step="1" aria-label="Latest release year" />
									<div class="range__ends">
										<span id="dmin-label"></span><span id="dmax-label"></span>
									</div>
								</div>
							</section>

							{/* Exact release years. No chips are shipped — the section is
							    populated only when a Stats "Films by release year" deep-link
							    arrives (?ryear=…), and stays hidden otherwise. */}
							<section id="ryear-section" hidden>
								<h2 class="grp">Release year</h2>
								<div class="chips" id="ryears"></div>
							</section>

							<section data-group="genre" hidden>
								<h2 class="grp">Genre</h2>
								<div class="chips" data-chips="genre"></div>
							</section>

							<section data-group="language" hidden>
								<h2 class="grp">Language</h2>
								<div class="chips" data-chips="language"></div>
							</section>

							<section data-group="country" hidden>
								<h2 class="grp">Country</h2>
								<div class="chips" data-chips="country"></div>
							</section>

							{/* The credit lists run to thousands of names, so these two rows
							    never hold the whole set — the search box builds matching chips
							    on demand from the facet payload. */}
							<section class="panel__wide" id="people-section" hidden>
								<div class="grp__row">
									<h2 class="grp">People</h2>
									<input
										type="search"
										id="people-search"
										class="people-search"
										placeholder="Search directors & cast…"
										autocomplete="off"
										aria-label="Search directors and cast"
									/>
								</div>
								<div class="where">
									<div class="where__row">
										<span class="where__label">Director</span>
										<div class="chips" data-people="director">
											<span class="people-none" hidden>No matches</span>
										</div>
									</div>
									<div class="where__row">
										<span class="where__label">Cast</span>
										<div class="chips" data-people="actor">
											<span class="people-none" hidden>No matches</span>
										</div>
									</div>
								</div>
							</section>
						</div>
					</div>
				</div>
			</div>

			<div class="filterinfo" id="filterinfo" hidden={!hasFilters}>
				<span class="filterinfo__tag">Filter</span>
				<p class="filterinfo__text" id="filterinfo-text">
					{summary.map((part) => <span class={part.em ? 'finfo__em' : undefined}>{part.t}</span>)}
				</p>
			</div>

			<div class="grid" id="grid">
				{films.map((f) => {
					const poster = imageUrl(f.poster_path, 'w342');
					return (
						<a class={poster ? 'tile' : 'tile tile--noimg'} href={`/films/movie/${f.tmdb_id}`}>
							{poster && <img data-poster={poster} alt={`${f.title} poster`} decoding="async" />}
							<div class="tile__overlay">
								<div class="tile__title">{f.title}</div>
								<div class="tile__year">{f.release_year}</div>
								<div class="tile__stars">{starText(f.rating) ?? 'Unrated'}</div>
							</div>
						</a>
					);
				})}
			</div>

			<p class="empty" id="empty" hidden={total > 0 || !filtered}>
				<span id="empty-by-query" hidden={!onlyQuery}>
					No films match “<span id="empty-q">{query.q}</span>”
				</span>
				<span id="empty-by-filters" hidden={onlyQuery}>No films match these filters</span>
			</p>

			<div id="sentinel" data-batch={BATCH} hidden={!hasMore}>
				<span class="sentinel__spinner" aria-hidden="true"></span>
				<span class="sentinel__text">Loading more…</span>
			</div>
			<p id="load-error" class="load-error" hidden>
				Could not load more films. <button type="button" id="retry">Retry</button>
			</p>
		</div>
	</div>

	<style>
		.page {
			overflow-x: hidden;
			display: flex;
			justify-content: center;
			padding: 0 24px 80px;
		}
		.wrap {
			width: 100%;
			max-width: 1000px;
		}
		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 26px 0 22px;
			border-bottom: 1px solid #4a2529;
			margin-bottom: 34px;
		}
		.back {
			display: flex;
			align-items: center;
			gap: 9px;
			font-size: 13px;
			color: #a2857a;
		}
		.back:hover {
			color: #f4e8d1;
		}
		.back__arrow {
			font-size: 15px;
		}
		.topbar__tag {
			font-size: 11.5px;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #8a6f63;
		}

		.titleblock {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			margin-bottom: 26px;
			flex-wrap: wrap;
			gap: 16px;
		}
		h1 {
			font-family: 'Newsreader', serif;
			font-weight: 500;
			font-size: 52px;
			color: #f4e8d1;
			letter-spacing: -0.5px;
			line-height: 1;
			margin: 0;
		}
		.sub {
			font-size: 13px;
			color: #a2857a;
			margin-top: 10px;
		}
		.sub__n {
			color: #d9b45a;
			font-weight: 600;
		}

		.filterbar {
			display: flex;
			gap: 12px;
			align-items: center;
			margin-bottom: 14px;
			flex-wrap: wrap;
		}
		#search {
			flex: 1;
			min-width: 220px;
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 8px;
			padding: 11px 14px;
			color: #f4e8d1;
			font-size: 14px;
			font-family: 'Archivo', sans-serif;
			outline: none;
		}
		#search::placeholder {
			color: #8a6f63;
		}
		#search:focus {
			border-color: #d9b45a;
		}
		.sortby {
			display: flex;
			align-items: center;
			gap: 8px;
		}
		.sortby__label {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
		}
		.pill {
			font-size: 12.5px;
			padding: 7px 13px;
			border-radius: 20px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			border: 1px solid #4a2529;
			background: transparent;
			color: #ddc9b4;
		}
		.pill:hover {
			border-color: #a2857a;
		}
		.pill--on {
			background: #d9b45a;
			color: #2a1214;
			font-weight: 600;
			border-color: #d9b45a;
		}
		.pill--btn {
			padding: 10px 16px;
			border-radius: 8px;
		}

		/* --- Filter description panel --- */
		.filterinfo {
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 12px;
			padding: 15px 20px;
			margin-bottom: 16px;
			display: flex;
			align-items: baseline;
			gap: 16px;
		}
		.filterinfo[hidden] {
			display: none;
		}
		.filterinfo__tag {
			font-size: 10.5px;
			text-transform: uppercase;
			letter-spacing: 1.8px;
			color: #8a6f63;
			flex: none;
		}
		.filterinfo__text {
			font-family: 'Newsreader', serif;
			font-size: 16px;
			line-height: 1.55;
			margin: 0;
			letter-spacing: 0.1px;
			color: #c2a99a;
		}
		.filterinfo__text .finfo__em {
			color: #f0d488;
			font-weight: 600;
		}

		/* --- Filter panel --- */
		.panel {
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 12px;
			padding: 24px 26px;
			margin-bottom: 26px;
		}
		.panel[hidden] {
			display: none;
		}
		.panel__head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 20px;
		}
		.panel__title {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.6px;
			color: #8a6f63;
		}
		/* Sits between the title and "Clear all" while the chips are on their way.
		   Quiet on purpose: the panel is usable without it (search, stars, activity),
		   so this is a note, not a blocker. */
		.panel__loading {
			margin-right: auto;
			padding-left: 12px;
			font-size: 12px;
			color: #7c6156;
			font-style: italic;
		}
		.panel__loading[hidden] {
			display: none;
		}
		.panel__error {
			margin: -8px 0 16px;
			font-size: 13px;
			color: #a2857a;
		}
		.panel__error[hidden] {
			display: none;
		}
		.panel__error button {
			font: inherit;
			color: #d9b45a;
			background: none;
			border: none;
			padding: 0;
			cursor: pointer;
			text-decoration: underline;
		}
		.clear {
			font-size: 12px;
			font-weight: 600;
			color: #d9b45a;
			background: transparent;
			border: none;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			padding: 0;
		}
		.clear:hover {
			color: #f0d488;
		}
		.clear[hidden] {
			display: none;
		}
		.panel__grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 26px 40px;
		}
		.panel__wide {
			grid-column: 1 / -1;
		}
		#ryear-section[hidden] {
			display: none;
		}

		/* --- Movie details drawer --- */
		/* An expandable section under the main filters holding the film-metadata
		   filters (release date, genre, language, country, people) so they don't
		   crowd the diary-side controls above. */
		.moviedetails {
			margin-top: 20px;
			padding-top: 18px;
			border-top: 1px solid #4a2529;
		}
		.md__toggle {
			display: flex;
			align-items: center;
			gap: 8px;
			background: transparent;
			border: none;
			cursor: pointer;
			padding: 0;
			font-family: 'Archivo', sans-serif;
		}
		.md__chevron {
			font-size: 11px;
			color: #8a6f63;
			transition: transform 0.15s ease;
		}
		.md__toggle[aria-expanded='true'] .md__chevron {
			transform: rotate(90deg);
		}
		@media (prefers-reduced-motion: reduce) {
			.md__chevron {
				transition: none;
			}
		}
		.md__label {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.6px;
			color: #8a6f63;
		}
		.md__toggle:hover .md__label,
		.md__toggle:hover .md__chevron {
			color: #a2857a;
		}
		.md__count {
			font-size: 11px;
			font-weight: 600;
			color: #d9b45a;
		}
		.md__count:empty {
			display: none;
		}
		.md__body {
			margin-top: 18px;
		}
		.md__body[hidden] {
			display: none;
		}
		.grp {
			font-size: 11px;
			font-weight: 400;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
			margin: 0 0 12px;
		}
		/* A second heading inside a section (Activity → Decade) needs the gap back. */
		.chips + .grp {
			margin-top: 16px;
		}
		.grp__row {
			display: flex;
			align-items: center;
			gap: 12px;
			margin-bottom: 12px;
		}
		.grp__row .grp {
			margin-bottom: 0;
		}
		.grp__none {
			font-size: 13px;
			font-style: italic;
			font-family: 'Newsreader', serif;
			color: #8a6f63;
			margin: 0;
		}
		.chips {
			display: flex;
			gap: 8px;
			flex-wrap: wrap;
		}
		.chip {
			font-size: 12.5px;
			padding: 7px 13px;
			border-radius: 20px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			border: 1px solid #4a2529;
			background: transparent;
			color: #ddc9b4;
		}
		.chip:hover {
			border-color: #a2857a;
		}
		.chip[aria-pressed='true'] {
			background: #d9b45a;
			color: #2a1214;
			font-weight: 600;
			border-color: #d9b45a;
		}
		.chip[hidden] {
			display: none;
		}
		.chip--more {
			background: transparent;
			color: #a2857a;
			border-style: dashed;
		}

		/* Dual-thumb rating range: two native sliders stacked on one track, so
		   keyboard and screen-reader support come for free. The inputs ignore
		   pointer events except on their thumbs, which lets whichever thumb is
		   under the cursor take the drag even though the boxes fully overlap. */
		.rating {
			display: flex;
			align-items: center;
			gap: 18px;
		}
		.rating--off .range {
			opacity: 0.35;
		}
		.range {
			flex: 1;
			max-width: 260px;
			position: relative;
			height: 32px;
		}
		.range__track,
		.range__fill {
			position: absolute;
			top: 14px;
			height: 4px;
			border-radius: 2px;
			pointer-events: none;
		}
		.range__track {
			left: 0;
			right: 0;
			background: #402226;
		}
		.range__fill {
			background: #d9b45a;
		}
		.range input[type='range'] {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 32px;
			margin: 0;
			background: none;
			appearance: none;
			-webkit-appearance: none;
			pointer-events: none;
		}
		.range input[type='range']:focus-visible {
			outline: none;
		}
		.range input[type='range']::-webkit-slider-thumb {
			appearance: none;
			-webkit-appearance: none;
			pointer-events: auto;
			width: 16px;
			height: 16px;
			border-radius: 50%;
			background: #f0d488;
			border: 2px solid #241012;
			box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
			cursor: pointer;
		}
		.range input[type='range']::-moz-range-thumb {
			pointer-events: auto;
			width: 16px;
			height: 16px;
			border-radius: 50%;
			background: #f0d488;
			border: 2px solid #241012;
			box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
			cursor: pointer;
		}
		.range input[type='range']:focus-visible::-webkit-slider-thumb {
			outline: 2px solid #f0d488;
			outline-offset: 2px;
		}
		.range input[type='range']:focus-visible::-moz-range-thumb {
			outline: 2px solid #f0d488;
			outline-offset: 2px;
		}
		.range__ends {
			position: absolute;
			top: 30px;
			left: 0;
			right: 0;
			display: flex;
			justify-content: space-between;
			font-size: 13px;
			color: #d9b45a;
			pointer-events: none;
		}
		/* The release-date slider reuses the rating track. Its end labels are
		   positioned out of flow, so reserve the room they occupy. */
		.range--dec {
			margin-bottom: 20px;
		}

		.where {
			display: flex;
			flex-direction: column;
			gap: 10px;
		}
		.where__row {
			display: flex;
			align-items: baseline;
			gap: 8px;
		}
		.where__label {
			font-size: 12px;
			color: #8a6f63;
			width: 60px;
			flex: none;
		}

		/* People filter: a chip-scoped search that sits beside the "People" heading. */
		.people-search {
			width: 220px;
			max-width: 100%;
			background: #1c0d0e;
			border: 1px solid #4a2529;
			border-radius: 14px;
			padding: 5px 12px;
			color: #f4e8d1;
			font-size: 12px;
			font-family: 'Archivo', sans-serif;
			outline: none;
		}
		.people-search::placeholder {
			color: #8a6f63;
		}
		.people-search:focus {
			border-color: #d9b45a;
		}
		.people-none {
			font-size: 12px;
			font-style: italic;
			font-family: 'Newsreader', serif;
			color: #8a6f63;
		}
		.people-none[hidden] {
			display: none;
		}
		.modes {
			display: flex;
			border: 1px solid #4a2529;
			border-radius: 14px;
			overflow: hidden;
		}
		.mode {
			font-size: 11px;
			font-weight: 600;
			padding: 5px 11px;
			border: none;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			background: transparent;
			color: #a2857a;
		}
		.mode--on {
			background: #d9b45a;
			color: #2a1214;
		}

		.grid {
			display: grid;
			grid-template-columns: repeat(6, 1fr);
			gap: 18px;
			margin-top: 16px;
		}
		.tile {
			position: relative;
			aspect-ratio: 2 / 3;
			border-radius: 5px;
			overflow: hidden;
			background-image: repeating-linear-gradient(135deg, #351a1d 0 9px, #2c1518 9px 18px);
			border: 1px solid #4a2529;
			transition: border-color 0.12s;
		}
		.tile:hover {
			border-color: #d9b45a;
		}
		.tile img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.tile__overlay {
			position: absolute;
			inset: 0;
			display: flex;
			flex-direction: column;
			justify-content: flex-end;
			padding: 12px;
			background: rgba(18, 8, 9, 0.82);
			opacity: 0;
			transition: opacity 0.18s ease;
		}
		.tile:hover .tile__overlay {
			opacity: 1;
		}
		/* Films with no poster: keep the caption visible over the striped tile. */
		.tile--noimg .tile__overlay {
			opacity: 1;
			background: transparent;
		}
		.tile__title {
			font-family: 'Newsreader', serif;
			font-size: 16px;
			font-weight: 500;
			color: #f4e8d1;
			line-height: 1.15;
		}
		.tile__year {
			font-family: 'Archivo', sans-serif;
			font-size: 11px;
			letter-spacing: 1.4px;
			text-transform: uppercase;
			color: #d9b45a;
			margin-top: 5px;
		}
		.tile__stars {
			font-size: 12px;
			color: #d9b45a;
			margin-top: 4px;
		}

		.empty {
			padding: 48px 0;
			text-align: center;
			color: #8a6f63;
			font-size: 15px;
			font-style: italic;
			font-family: 'Newsreader', serif;
		}
		.empty[hidden] {
			display: none;
		}

		#sentinel {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 10px;
			padding: 28px 0 8px;
			font-size: 12px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
		}
		#sentinel[hidden] {
			display: none;
		}
		.sentinel__spinner {
			width: 12px;
			height: 12px;
			border: 2px solid #4a2529;
			border-top-color: #d9b45a;
			border-radius: 50%;
			animation: spin 0.7s linear infinite;
		}
		@keyframes spin {
			to {
				transform: rotate(360deg);
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.sentinel__spinner {
				animation: none;
			}
		}
		.load-error {
			padding: 24px 0;
			text-align: center;
			font-size: 13px;
			color: #a2857a;
		}
		.load-error[hidden] {
			display: none;
		}
		.load-error button {
			font: inherit;
			color: #d9b45a;
			background: none;
			border: none;
			padding: 0;
			cursor: pointer;
			text-decoration: underline;
		}

		@media (max-width: 860px) {
			.grid {
				grid-template-columns: repeat(4, 1fr);
			}
			.panel__grid {
				grid-template-columns: minmax(0, 1fr);
			}
		}
		@media (max-width: 560px) {
			h1 {
				font-size: 40px;
			}
			.grid {
				grid-template-columns: repeat(3, 1fr);
			}
			.panel {
				padding: 20px 16px;
			}
			/* The slider needs its own line once "Unrated only" can't sit beside it. */
			.rating {
				flex-wrap: wrap;
				gap: 12px;
			}
			.range {
				max-width: none;
			}
			.where__row {
				flex-direction: column;
				align-items: stretch;
			}
		}
	</style>

	<script>
		import { mediumLabel, starText } from '../../lib/format';
		import { filterSentence } from '../../lib/watched-filters';

		interface WatchedFilm {
			tmdb_id: number;
			title: string;
			release_year: number | null;
			poster_path: string | null;
			rating: number | null;
		}

		const grid = document.getElementById('grid');
		const sentinel = document.getElementById('sentinel');

		if (grid && sentinel) {
			const search = document.getElementById('search') as HTMLInputElement;
			const shown = document.getElementById('shown')!;
			// Latest server-reported match count, echoed into the filter sentence. The
			// grid only ever holds a slice, so this comes from the response, not the DOM.
			let shownTotal = Number((shown.textContent ?? '').replace(/[^0-9]/g, '')) || 0;
			const empty = document.getElementById('empty')!;
			const emptyQ = document.getElementById('empty-q')!;
			const emptyByQuery = document.getElementById('empty-by-query')!;
			const emptyByFilters = document.getElementById('empty-by-filters')!;
			const errorBox = document.getElementById('load-error')!;
			const retry = document.getElementById('retry')!;
			const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.pill[data-sort]'));
			const BATCH = Number(sentinel.dataset.batch);

			// Search, sort and the filters all re-query the server rather than filtering
			// the DOM: the grid only holds the pages loaded so far, so filtering here
			// would search a slice instead of the whole collection.
			let sort = 'recent';
			let q = '';
			let offset = grid.childElementCount;
			let loading = false;
			// The server hides the sentinel when the first page is already everything.
			let done = sentinel.hidden;
			// Identifies the newest request; a response from an older one is discarded so
			// fast typing can't let a stale batch land after the one it superseded.
			let seq = 0;
			// Whether the failed request was a reset, so Retry repeats it in the same mode
			// rather than appending a fresh query's page onto the previous query's grid.
			let retryReset = false;

			const fmt = (n: number) => n.toLocaleString('en-US');

			// --- Filter state ---------------------------------------------------
			// Mirrors the API's params. The multi-value sets hold the chips' raw
			// data-value (a theater's full "Name, City"), never the shortened label.
			const RATING_FLOOR = 0.5;
			const RATING_CEIL = 5;
			const sets = {
				tag: new Set<string>(),
				friend: new Set<string>(),
				medium: new Set<string>(),
				venue: new Set<string>(),
				format: new Set<string>(),
				director: new Set<string>(),
				actor: new Set<string>(),
				genre: new Set<string>(),
				language: new Set<string>(),
				country: new Set<string>(),
			};
			type SetKey = keyof typeof sets;
			const flags = { liked: false, rewatched: false, unrated: false };
			const modes = { friendmode: 'any', wheremode: 'any' };
			let rMin = RATING_FLOOR;
			let rMax = RATING_CEIL;

			// Release-date bounds and diary-date bounds, both as calendar years. Each
			// comes from the facet payload, so they're zero — and their sliders undrawn
			// — until that lands. Each is only worth drawing when the collection spans
			// more than one year; while `hasReleaseRange` / `hasDiaryRange` are false the
			// bounds stay at the ends and the filter never engages. A film watched across
			// several years matches whenever any of them lands in range, so one film can
			// answer to more than one year.
			let hasReleaseRange = false;
			let REL_LO = 0;
			let REL_HI = 0;
			let dMin = 0;
			let dMax = 0;

			let hasDiaryRange = false;
			let YR_LO = 0;
			let YR_HI = 0;
			let yMin = 0;
			let yMax = 0;

			// Exact release years. Unlike every other filter these ship no chips in the
			// panel — the set is populated only when a Stats "Films by release year"
			// deep-link arrives (?ryear=…), and each selected year is drawn as a
			// removable chip in the Movie details drawer's "Release year" section.
			const releaseYears = new Set<number>();

			// The raw ?dmin/?dmax and ?dymin/?dymax this page was served with — the
			// numbers the server both filtered and wrote its filter sentence from. The
			// sliders can't take over until the facets bring the bounds they snap to, so
			// these stand in for them until applyFacets clears them.
			let urlRelMin: number | null = null;
			let urlRelMax: number | null = null;
			let urlDiaryMin: number | null = null;
			let urlDiaryMax: number | null = null;

			/** Whether a date range from the URL is still standing in for its slider. */
			const urlRangePending = () =>
				(!hasReleaseRange && (urlRelMin != null || urlRelMax != null)) ||
				(!hasDiaryRange && (urlDiaryMin != null || urlDiaryMax != null));

			/** Whether the rating control narrows anything. */
			const ratingActive = () =>
				flags.unrated || rMin > RATING_FLOOR || rMax < RATING_CEIL;

			/** Whether the release-date range narrows anything. */
			const releaseActive = () => hasReleaseRange && (dMin > REL_LO || dMax < REL_HI);

			/** Whether the diary-date range narrows anything. */
			const diaryActive = () => hasDiaryRange && (yMin > YR_LO || yMax < YR_HI);

			/** Active filters that live in the "Movie details" drawer — the count shown on
			 * that section's own toggle. Release date, credits, genre, language, country. */
			function movieActiveCount(): number {
				return (
					(releaseActive() ? 1 : 0) +
					releaseYears.size +
					sets.director.size +
					sets.actor.size +
					sets.genre.size +
					sets.language.size +
					sets.country.size
				);
			}

			/** Number of active filters — the count on the Filters button. The rating,
			 * release-date and diary-date ranges each count once however many steps they
			 * span. This is every filter, drawer ones included. */
			function activeCount(): number {
				let n =
					(ratingActive() ? 1 : 0) +
					(releaseActive() ? 1 : 0) +
					(diaryActive() ? 1 : 0) +
					(flags.liked ? 1 : 0) +
					(flags.rewatched ? 1 : 0) +
					releaseYears.size;
				for (const s of Object.values(sets)) n += s.size;
				return n;
			}

			function buildQuery(from: number): string {
				const p = new URLSearchParams();
				p.set('limit', String(BATCH));
				p.set('offset', String(from));
				p.set('sort', sort);
				if (q) p.set('q', q);
				if (flags.unrated) p.set('unrated', '1');
				else {
					// Omit a bound at its extreme so the server can tell "any rating"
					// from a range that happens to reach the end.
					if (rMin > RATING_FLOOR) p.set('rmin', String(rMin));
					if (rMax < RATING_CEIL) p.set('rmax', String(rMax));
				}
				if (flags.liked) p.set('liked', '1');
				if (flags.rewatched) p.set('rewatched', '1');
				// Release date is a year span; the server keeps a film released inside it,
				// which drops films with no release year at all. Send a bound only when it
				// narrows, so the slider's extremes read as "any year".
				if (releaseActive()) {
					if (dMin > REL_LO) p.set('dmin', String(dMin));
					if (dMax < REL_HI) p.set('dmax', String(dMax));
				}
				// Exact release years, one param each — the API reads these as `ryear`.
				for (const y of releaseYears) p.append('ryear', String(y));
				// Diary date is a true year span; the server keeps a film whose watch years
				// intersect it. Send a bound only when it narrows, so the slider's extremes
				// read as "any date".
				if (diaryActive()) {
					if (yMin > YR_LO) p.set('dymin', String(yMin));
					if (yMax < YR_HI) p.set('dymax', String(yMax));
				}
				// sets.genre/language/country ride along here as `genre`/`language`/`country`
				// — the same keys the API reads.
				for (const [key, values] of Object.entries(sets)) {
					for (const v of values) p.append(key, v);
				}
				if (sets.friend.size) p.set('friendmode', modes.friendmode);
				if (sets.medium.size || sets.venue.size || sets.format.size) {
					p.set('wheremode', modes.wheremode);
				}
				return p.toString();
			}

			// Astro scopes this page's CSS behind a generated data-astro-cid-* attribute,
			// so every node we build has to carry it or it renders unstyled. Read the name
			// off a server-rendered element rather than hard-coding the hash, which
			// changes whenever this file does.
			const scopeAttr = Array.from(grid.attributes)
				.map((a) => a.name)
				.find((n) => n.startsWith('data-astro-cid-'));

			function el(tag: string, className?: string, text?: string): HTMLElement {
				const node = document.createElement(tag);
				if (scopeAttr) node.setAttribute(scopeAttr, '');
				if (className) node.className = className;
				if (text != null) node.textContent = text;
				return node;
			}

			// Mirrors the server-rendered tile markup above.
			function buildTile(f: WatchedFilm): HTMLAnchorElement {
				const tile = el('a', f.poster_path ? 'tile' : 'tile tile--noimg') as HTMLAnchorElement;
				tile.href = `/films/movie/${f.tmdb_id}`;
				if (f.poster_path) {
					const img = el('img') as HTMLImageElement;
					// Deferred like the server-rendered tiles: the URL sits in data-poster
					// until PosterLoader's observer reaches this tile (see the
					// observePosters call after a batch is appended).
					img.dataset.poster = `https://image.tmdb.org/t/p/w342${f.poster_path}`;
					img.alt = `${f.title} poster`;
					img.decoding = 'async';
					tile.append(img);
				}
				const overlay = el('div', 'tile__overlay');
				overlay.append(
					el('div', 'tile__title', f.title),
					el('div', 'tile__year', f.release_year == null ? '' : String(f.release_year)),
					el('div', 'tile__stars', starText(f.rating) ?? 'Unrated'),
				);
				tile.append(overlay);
				return tile;
			}

			// The observer only fires on a crossing, so re-arm it after every load: a batch
			// too short to push the sentinel out of view still loads the next one.
			function armSentinel() {
				observer.unobserve(sentinel!);
				sentinel!.hidden = done;
				if (!done) observer.observe(sentinel!);
			}

			/** `reset` restarts from offset 0 for a new query/sort, replacing the grid. */
			async function load(reset = false) {
				if (!reset && (loading || done)) return;
				// Every re-query is a filter change; paging isn't, and offset stays out
				// of the URL so a shared link opens at the top.
				if (reset) writeUrl();
				const mySeq = ++seq;
				loading = true;
				errorBox.hidden = true;
				const from = reset ? 0 : offset;
				try {
					const res = await fetch(`/api/films/watched/list?${buildQuery(from)}`);
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					const { films, total } = (await res.json()) as { films: WatchedFilm[]; total: number };
					if (mySeq !== seq) return; // superseded by a newer query

					if (reset) {
						grid!.replaceChildren();
						offset = 0;
					}
					const batch = document.createDocumentFragment();
					for (const f of films) batch.append(buildTile(f));
					grid!.append(batch);
					// The tiles ship their posters in data-poster like the server-rendered
					// ones, so hand them to the loader; it skips anything already in flight.
					window.observePosters?.(grid!);
					offset += films.length;

					shown.textContent = fmt(total);
					shownTotal = total;
					renderFilterInfo();
					// Quote the search term when it's the only thing narrowing; once a
					// filter is on too, the term alone no longer explains the emptiness.
					const onlyQuery = q !== '' && activeCount() === 0;
					emptyQ.textContent = q;
					emptyByQuery.hidden = !onlyQuery;
					emptyByFilters.hidden = onlyQuery;
					empty.hidden = total > 0 || (!q && activeCount() === 0);
					done = offset >= total || films.length < BATCH;
					armSentinel();
				} catch (e) {
					if (mySeq !== seq) return;
					// Leave the observer parked so a failure can't hot-loop the API; the
					// retry button is the way back.
					console.error('watched: failed to load films', e);
					retryReset = reset;
					errorBox.hidden = false;
				} finally {
					if (mySeq === seq) loading = false;
				}
			}

			// Start fetching a screenful early so scrolling stays continuous.
			const observer = new IntersectionObserver(
				(entries) => {
					if (entries.some((entry) => entry.isIntersecting)) load();
				},
				{ rootMargin: '600px' },
			);
			armSentinel();

			let debounce = 0;
			search.addEventListener('input', () => {
				window.clearTimeout(debounce);
				debounce = window.setTimeout(() => {
					const next = search.value.trim();
					if (next === q) return;
					q = next;
					load(true);
				}, 250);
			});

			for (const pill of pills) {
				pill.addEventListener('click', () => {
					if (pill.dataset.sort === sort) return;
					sort = pill.dataset.sort!;
					for (const p of pills) p.classList.toggle('pill--on', p === pill);
					load(true);
				});
			}

			retry.addEventListener('click', () => load(retryReset));

			// --- Filter panel ---------------------------------------------------
			const panel = document.getElementById('filters')!;
			const toggle = document.getElementById('filters-toggle')!;
			const countBadge = document.getElementById('filters-count')!;
			const clearAll = document.getElementById('clear-all') as HTMLButtonElement;
			// Every chip in these groups is built by applyFacets(), so this starts empty
			// and is refilled there rather than being a snapshot of the server's markup.
			let filterChips: HTMLButtonElement[] = [];
			const flagChips = Array.from(panel.querySelectorAll<HTMLButtonElement>('.chip[data-flag]'));
			const rminInput = document.getElementById('rmin') as HTMLInputElement;
			const rmaxInput = document.getElementById('rmax') as HTMLInputElement;
			const rangeFill = document.getElementById('range-fill')!;
			const rminStars = document.getElementById('rmin-stars')!;
			const rmaxStars = document.getElementById('rmax-stars')!;
			const ratingBox = document.querySelector('.rating')!;
			const drangeSection = document.getElementById('drange-section')!;
			const dminInput = document.getElementById('dmin') as HTMLInputElement;
			const dmaxInput = document.getElementById('dmax') as HTMLInputElement;
			const drangeFill = document.getElementById('drange-fill')!;
			const dminLabel = document.getElementById('dmin-label')!;
			const dmaxLabel = document.getElementById('dmax-label')!;
			const yrangeSection = document.getElementById('yrange-section')!;
			const yminInput = document.getElementById('ymin') as HTMLInputElement;
			const ymaxInput = document.getElementById('ymax') as HTMLInputElement;
			const yrangeFill = document.getElementById('yrange-fill')!;
			const yminLabel = document.getElementById('ymin-label')!;
			const ymaxLabel = document.getElementById('ymax-label')!;
			const mdToggle = document.getElementById('md-toggle')!;
			const mdBody = document.getElementById('md-body')!;
			const mdCount = document.getElementById('md-count')!;
			const ryearSection = document.getElementById('ryear-section')!;
			const ryears = document.getElementById('ryears')!;

			/** Reflect state that isn't owned by the control the user just touched. */
			function syncChrome() {
				const n = activeCount();
				countBadge.textContent = n ? ` · ${n}` : '';
				toggle.classList.toggle('pill--on', panel.hidden === false || n > 0);
				clearAll.hidden = n === 0;

				const pct = (v: number) =>
					((v - RATING_FLOOR) / (RATING_CEIL - RATING_FLOOR)) * 100;
				rangeFill.style.left = `${pct(rMin)}%`;
				rangeFill.style.width = `${pct(rMax) - pct(rMin)}%`;
				rminStars.textContent = starText(rMin);
				rmaxStars.textContent = starText(rMax);
				// The two inputs cover the same box, so where the thumbs overlap the
				// later one in the DOM (max) swallows the drag. Raise min once it's past
				// the midpoint, which is the only place the two can meet.
				const overlapping = rMin > (RATING_FLOOR + RATING_CEIL) / 2;
				rminInput.style.zIndex = overlapping ? '2' : '1';
				rmaxInput.style.zIndex = overlapping ? '1' : '2';
				// "Unrated only" and a star range are mutually exclusive; dim the one
				// that isn't in play rather than hiding it.
				ratingBox.classList.toggle('rating--off', flags.unrated);

				if (hasReleaseRange) {
					const dpct = (v: number) => ((v - REL_LO) / (REL_HI - REL_LO)) * 100;
					drangeFill.style.left = `${dpct(dMin)}%`;
					drangeFill.style.width = `${dpct(dMax) - dpct(dMin)}%`;
					dminLabel.textContent = String(dMin);
					dmaxLabel.textContent = String(dMax);
					const dOverlap = dMin > (REL_LO + REL_HI) / 2;
					dminInput.style.zIndex = dOverlap ? '2' : '1';
					dmaxInput.style.zIndex = dOverlap ? '1' : '2';
				}

				if (hasDiaryRange) {
					const ypct = (v: number) => ((v - YR_LO) / (YR_HI - YR_LO)) * 100;
					yrangeFill.style.left = `${ypct(yMin)}%`;
					yrangeFill.style.width = `${ypct(yMax) - ypct(yMin)}%`;
					yminLabel.textContent = String(yMin);
					ymaxLabel.textContent = String(yMax);
					const yOverlap = yMin > (YR_LO + YR_HI) / 2;
					yminInput.style.zIndex = yOverlap ? '2' : '1';
					ymaxInput.style.zIndex = yOverlap ? '1' : '2';
				}

				// The drawer's own badge counts just its filters; the drawer springs open on
				// its own when a restored URL lands a filter inside it, so its state isn't a
				// reliable signal of whether anything within is active.
				const mv = movieActiveCount();
				mdCount.textContent = mv ? `· ${mv}` : '';

				renderFilterInfo();
			}

			// --- Filter description sentence ------------------------------------
			// A plain-English summary of every active filter, e.g. "You have
			// rewatched 3 criterion films directed by … rated between ★★★★ and
			// ★★★★★ … with Maya or Dana seen at the Metrograph or in 70mm." It reads
			// the same state buildQuery does, so it can never disagree with the grid.
			// The wording lives in lib/watched-filters so the server can paint the
			// same sentence before this script runs; here it's rebuilt from live state
			// on every change.
			const filterInfo = document.getElementById('filterinfo')!;
			const filterInfoText = document.getElementById('filterinfo-text')!;

			// A theater's short chip label, keyed by its raw "Name, City" value — the
			// sentence says "at the Metrograph", not the full stored string. Filled in
			// by applyFacets; until then a venue restored from the URL reads as its full
			// value, which is correct if verbose.
			const venueLabelByValue = new Map<string, string>();

			/** Rebuild the filter sentence from current state and show/hide the panel. */
			function renderFilterInfo() {
				filterInfo.hidden = activeCount() === 0 && !urlRangePending();
				if (filterInfo.hidden) return;

				const parts = filterSentence({
					total: shownTotal,
					rewatched: flags.rewatched,
					liked: flags.liked,
					unrated: flags.unrated,
					// Only a bound that narrows is a bound; the other end reads as "any",
					// which is what a null says.
					ratingMin: !flags.unrated && rMin > RATING_FLOOR ? rMin : null,
					ratingMax: !flags.unrated && rMax < RATING_CEIL ? rMax : null,
					// A slider with no bounds yet can't speak for a range the URL asked
					// for, so until the facets arrive the raw params stand in — the same
					// numbers the server drew its sentence from.
					releaseYearMin: hasReleaseRange ? (releaseActive() ? dMin : null) : urlRelMin,
					releaseYearMax: hasReleaseRange ? (releaseActive() ? dMax : null) : urlRelMax,
					releaseYears: [...releaseYears],
					diaryYearMin: hasDiaryRange ? (diaryActive() ? yMin : null) : urlDiaryMin,
					diaryYearMax: hasDiaryRange ? (diaryActive() ? yMax : null) : urlDiaryMax,
					tags: [...sets.tag],
					directors: [...sets.director],
					actors: [...sets.actor],
					genres: [...sets.genre],
					languages: [...sets.language],
					countries: [...sets.country],
					friends: [...sets.friend],
					friendMode: modes.friendmode as 'any' | 'all',
					mediums: [...sets.medium],
					venues: [...sets.venue],
					venueLabels: venueLabelByValue,
					formats: [...sets.format],
				});

				filterInfoText.replaceChildren(
					...parts.map((p) => el('span', p.em ? 'finfo__em' : undefined, p.t)),
				);
			}

			function applyFilters() {
				syncChrome();
				load(true);
			}

			toggle.addEventListener('click', () => {
				panel.hidden = !panel.hidden;
				toggle.setAttribute('aria-expanded', String(!panel.hidden));
				syncChrome();
			});

			// The Movie details drawer just shows/hides; nothing inside re-queries on open.
			mdToggle.addEventListener('click', () => {
				mdBody.hidden = !mdBody.hidden;
				mdToggle.setAttribute('aria-expanded', String(!mdBody.hidden));
			});

			// --- People (director / cast) ---------------------------------------
			// The credit lists run to thousands of names, so — unlike the other groups —
			// these chips are never all in the DOM. Each row shows the top few by
			// frequency and the search box builds matching chips on demand from the facet
			// payload. The picks live in sets.director / sets.actor, so buildQuery, the
			// URL and the active-filter count read them the same as any other group.
			type PeopleKind = 'director' | 'actor';
			const PEOPLE_TOP = 12; // default quick chips per row, before searching
			const PEOPLE_MAX = 40; // most chips one search shows at once
			const peopleSection = document.getElementById('people-section')!;
			const peopleSearch = document.getElementById('people-search') as HTMLInputElement | null;
			const peopleNames: Record<PeopleKind, string[]> = { director: [], actor: [] };

			interface PeopleRow {
				kind: PeopleKind;
				host: HTMLElement;
				none: HTMLElement;
			}
			const peopleRows: PeopleRow[] = Array.from(
				panel.querySelectorAll<HTMLElement>('.chips[data-people]'),
			).map((host) => ({
				kind: host.dataset.people as PeopleKind,
				host,
				none: host.querySelector<HTMLElement>('.people-none')!,
			}));
			let peopleQ = '';

			function makePeopleChip(kind: PeopleKind, name: string): HTMLButtonElement {
				const chip = el('button', 'chip') as HTMLButtonElement;
				chip.type = 'button';
				chip.dataset.filter = kind;
				chip.dataset.value = name;
				chip.setAttribute('aria-pressed', String(sets[kind].has(name)));
				chip.textContent = name;
				chip.addEventListener('click', () => {
					if (sets[kind].has(name)) sets[kind].delete(name);
					else sets[kind].add(name);
					chip.setAttribute('aria-pressed', String(sets[kind].has(name)));
					applyFilters();
				});
				return chip;
			}

			function renderPeopleRow(row: PeopleRow) {
				const selected = sets[row.kind];
				let names: string[];
				if (peopleQ) {
					names = peopleNames[row.kind]
						.filter((n) => n.toLowerCase().includes(peopleQ))
						.slice(0, PEOPLE_MAX);
					// Keep picked names on screen even when they don't match the search, so
					// they can be seen and cleared without retyping.
					for (const s of selected) if (!names.includes(s)) names.unshift(s);
				} else {
					// Default view: the most-frequent few, plus any pick reaching past them.
					names = peopleNames[row.kind].slice(0, PEOPLE_TOP);
					for (const s of selected) if (!names.includes(s)) names.push(s);
				}
				const chips = names.map((n) => makePeopleChip(row.kind, n));
				row.host.replaceChildren(...chips, row.none);
				// "No matches" shows only when a search turned up nothing to display.
				row.none.hidden = !(peopleQ !== '' && chips.length === 0);
			}

			function renderPeople() {
				for (const row of peopleRows) renderPeopleRow(row);
			}

			peopleSearch?.addEventListener('input', () => {
				peopleQ = peopleSearch.value.trim().toLowerCase();
				renderPeople();
			});

			// --- Release year (deep-link only) ----------------------------------
			// One removable chip per selected year, sorted ascending. The section hides
			// itself when nothing is selected, since no year chips ship in the panel.
			function makeReleaseYearChip(year: number): HTMLButtonElement {
				const chip = el('button', 'chip') as HTMLButtonElement;
				chip.type = 'button';
				chip.setAttribute('aria-pressed', 'true');
				chip.textContent = `${year} ✕`;
				chip.setAttribute('aria-label', `Remove release year ${year}`);
				chip.addEventListener('click', () => {
					releaseYears.delete(year);
					renderReleaseYears();
					applyFilters();
				});
				return chip;
			}

			function renderReleaseYears() {
				const years = [...releaseYears].sort((a, b) => a - b);
				ryearSection.hidden = years.length === 0;
				ryears.replaceChildren(...years.map(makeReleaseYearChip));
			}

			// --- Facet-driven chip groups ---------------------------------------
			// Tags, friends, medium, theater, format, genre, language and country all
			// come from /api/films/watched/facets. Each renders into its `data-chips`
			// host; a group with nothing in it shows its "none" line instead.

			/** How many chips a group shows before collapsing behind "+N other…". Tags
			 * and friends follow the design; theaters get one too because there are ~20
			 * and their names are long enough to swamp the panel. Genre / language /
			 * country live in the Movie details drawer and each shows a healthy handful. */
			const CHIP_LIMIT: Partial<Record<SetKey, number>> = {
				tag: 7,
				friend: 4,
				venue: 6,
				genre: 8,
				language: 8,
				country: 8,
			};

			/** One selectable value: `value` is what the API reads, `label` what's drawn. */
			interface ChipValue {
				value: string;
				label: string;
				/** Full value as a tooltip, for labels shortened to fit (theaters). */
				title?: string;
			}

			function makeFilterChip(key: SetKey, v: ChipValue): HTMLButtonElement {
				const chip = el('button', 'chip') as HTMLButtonElement;
				chip.type = 'button';
				chip.dataset.filter = key;
				chip.dataset.value = v.value;
				chip.textContent = v.label;
				if (v.title) chip.title = v.title;
				chip.setAttribute('aria-pressed', String(sets[key].has(v.value)));
				chip.addEventListener('click', () => {
					const on = !sets[key].has(v.value);
					if (on) sets[key].add(v.value);
					else sets[key].delete(v.value);
					chip.setAttribute('aria-pressed', String(on));
					applyFilters();
				});
				return chip;
			}

			/**
			 * Fill one chip group. Values past the group's limit ship hidden behind a
			 * "+N other…" button — except any already selected, which stay visible so a
			 * filter restored from the URL always has a control that can clear it.
			 */
			function renderChipGroup(key: SetKey, values: ChipValue[]) {
				const host = panel.querySelector<HTMLElement>(`.chips[data-chips="${key}"]`);
				if (!host) return;
				// Only a section that is *only* this group can be hidden on its behalf —
				// medium / theater / format share one section and are matched by no
				// [data-group], so an empty format row never hides its two neighbours.
				const section = host.closest<HTMLElement>(`section[data-group="${key}"]`);
				const none = section?.querySelector<HTMLElement>('[data-none]') ?? null;

				// A group with a "none" line says so in place of its chips; one without
				// (genre / language / country) hides its whole section when empty.
				if (none) none.hidden = values.length > 0;
				else if (section) section.hidden = values.length === 0;

				const limit = CHIP_LIMIT[key] ?? values.length;
				const chips = values.map((v, i) => {
					const chip = makeFilterChip(key, v);
					chip.hidden = i >= limit && !sets[key].has(v.value);
					return chip;
				});
				const hiddenCount = chips.filter((c) => c.hidden).length;
				if (hiddenCount > 0) chips.push(makeMoreChip(hiddenCount));
				host.replaceChildren(...chips);
			}

			/** "+N other…" reveals the rest of its group and then removes itself:
			 * collapsing again would have to hide chips the user may have just picked. */
			function makeMoreChip(count: number): HTMLButtonElement {
				const more = el('button', 'chip chip--more') as HTMLButtonElement;
				more.type = 'button';
				more.textContent = `+${count} other…`;
				more.addEventListener('click', () => {
					for (const sibling of Array.from(more.parentElement!.children)) {
						(sibling as HTMLElement).hidden = false;
					}
					more.remove();
				});
				return more;
			}

			for (const chip of flagChips) {
				chip.addEventListener('click', () => {
					const key = chip.dataset.flag as keyof typeof flags;
					flags[key] = !flags[key];
					chip.setAttribute('aria-pressed', String(flags[key]));
					// Turning on "Unrated only" resets the star range it overrides, so
					// clearing it later doesn't restore a range the user can't see.
					if (key === 'unrated' && flags.unrated) setRange(RATING_FLOOR, RATING_CEIL);
					applyFilters();
				});
			}

			for (const group of Array.from(panel.querySelectorAll<HTMLElement>('.modes'))) {
				const key = group.dataset.mode as keyof typeof modes;
				const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('.mode'));
				for (const button of buttons) {
					button.addEventListener('click', () => {
						if (modes[key] === button.dataset.value) return;
						modes[key] = button.dataset.value!;
						for (const b of buttons) b.classList.toggle('mode--on', b === button);
						// A mode toggle only changes results once something is selected.
						const relevant =
							key === 'friendmode'
								? sets.friend.size > 0
								: sets.medium.size + sets.venue.size + sets.format.size > 0;
						if (relevant) applyFilters();
					});
				}
			}

			/** Move both thumbs, keeping min ≤ max and the inputs in step. */
			function setRange(min: number, max: number) {
				rMin = Math.min(min, max);
				rMax = Math.max(min, max);
				rminInput.value = String(rMin);
				rmaxInput.value = String(rMax);
			}

			for (const input of [rminInput, rmaxInput]) {
				input.addEventListener('input', () => {
					// The thumbs share a track, so each one pushes rather than crosses.
					const min = Number(rminInput.value);
					const max = Number(rmaxInput.value);
					if (input === rminInput) setRange(Math.min(min, max), max);
					else setRange(min, Math.max(min, max));
					// Dragging a star range is a choice to filter by stars.
					if (flags.unrated) {
						flags.unrated = false;
						const chip = panel.querySelector<HTMLButtonElement>('.chip[data-flag="unrated"]')!;
						chip.setAttribute('aria-pressed', 'false');
					}
					syncChrome();
				});
				// Re-query on release rather than per half-star: a drag across the track
				// would otherwise fire ten requests.
				input.addEventListener('change', applyFilters);
			}

			/** Move both release-date thumbs, keeping min ≤ max. */
			function setReleaseRange(min: number, max: number) {
				dMin = Math.min(min, max);
				dMax = Math.max(min, max);
				dminInput.value = String(dMin);
				dmaxInput.value = String(dMax);
			}

			for (const input of [dminInput, dmaxInput]) {
				input.addEventListener('input', () => {
					const min = Number(dminInput.value);
					const max = Number(dmaxInput.value);
					if (input === dminInput) setReleaseRange(Math.min(min, max), max);
					else setReleaseRange(min, Math.max(min, max));
					syncChrome();
				});
				input.addEventListener('change', applyFilters);
			}

			/** Move both diary-year thumbs, keeping min ≤ max. */
			function setYears(min: number, max: number) {
				yMin = Math.min(min, max);
				yMax = Math.max(min, max);
				yminInput.value = String(yMin);
				ymaxInput.value = String(yMax);
			}

			for (const input of [yminInput, ymaxInput]) {
				input.addEventListener('input', () => {
					const min = Number(yminInput.value);
					const max = Number(ymaxInput.value);
					if (input === yminInput) setYears(Math.min(min, max), max);
					else setYears(min, Math.max(min, max));
					syncChrome();
				});
				input.addEventListener('change', applyFilters);
			}

			clearAll.addEventListener('click', () => {
				for (const s of Object.values(sets)) s.clear();
				for (const chip of [...filterChips, ...flagChips]) {
					chip.setAttribute('aria-pressed', 'false');
				}
				flags.liked = flags.rewatched = flags.unrated = false;
				setRange(RATING_FLOOR, RATING_CEIL);
				setReleaseRange(REL_LO, REL_HI);
				setYears(YR_LO, YR_HI);
				releaseYears.clear();
				renderReleaseYears();
				// Deselecting the People chips lets their rows collapse back to the limit.
				renderPeople();
				applyFilters();
			});

			// --- URL state ------------------------------------------------------
			// The filters live in the query string so a narrowed grid is linkable and
			// survives a reload. Always replaceState, never pushState: a chip press is
			// not a navigation, and stacking one entry per press would leave Back
			// walking the filter history instead of returning to wherever you came
			// from. This mirrors the API's param names, minus paging.
			const URL_SETS: SetKey[] = [
				'tag',
				'friend',
				'medium',
				'venue',
				'format',
				'director',
				'actor',
				'genre',
				'language',
				'country',
			];

			function writeUrl() {
				const p = new URLSearchParams();
				if (q) p.set('q', q);
				if (sort !== 'recent') p.set('sort', sort);
				if (flags.unrated) p.set('unrated', '1');
				else {
					if (rMin > RATING_FLOOR) p.set('rmin', String(rMin));
					if (rMax < RATING_CEIL) p.set('rmax', String(rMax));
				}
				if (flags.liked) p.set('liked', '1');
				if (flags.rewatched) p.set('rewatched', '1');
				// Both ends, even where one sits at its extreme — the URL is read by
				// people, and a half-written span reads as an open end.
				if (releaseActive()) {
					p.set('dmin', String(dMin));
					p.set('dmax', String(dMax));
				}
				for (const y of releaseYears) p.append('ryear', String(y));
				if (diaryActive()) {
					p.set('dymin', String(yMin));
					p.set('dymax', String(yMax));
				}
				for (const key of URL_SETS) for (const v of sets[key]) p.append(key, v);
				if (sets.friend.size) p.set('friendmode', modes.friendmode);
				if (sets.medium.size || sets.venue.size || sets.format.size) {
					p.set('wheremode', modes.wheremode);
				}
				const qs = p.toString();
				const url = location.pathname + (qs ? `?${qs}` : '');
				if (url !== location.pathname + location.search) history.replaceState(null, '', url);
			}

			const snap = (raw: string | null, lo: number, hi: number, step: number, fallback: number) => {
				const n = Number(raw);
				if (raw == null || !Number.isFinite(n)) return fallback;
				return Math.min(hi, Math.max(lo, Math.round(n / step) * step));
			};

			/**
			 * Restore the controls from the query string — the same params the server
			 * rendered the grid from, so this only puts the panel in step with what's
			 * already on screen. Nothing here re-queries.
			 */
			function readUrl() {
				const p = new URLSearchParams(location.search);
				if ([...p.keys()].length === 0) return;

				// Kept for the filter sentence and for applyFacets, which has to tell
				// whether snapping these to the collection's bounds moved them.
				const numParam = (raw: string | null) => {
					const n = Number(raw);
					return raw != null && Number.isFinite(n) ? n : null;
				};
				urlRelMin = numParam(p.get('dmin'));
				urlRelMax = numParam(p.get('dmax'));
				urlDiaryMin = numParam(p.get('dymin'));
				urlDiaryMax = numParam(p.get('dymax'));

				q = p.get('q')?.trim() ?? '';
				search.value = q;
				const urlSort = p.get('sort');
				if (urlSort === 'recent' || urlSort === 'year') {
					sort = urlSort;
					for (const pill of pills) pill.classList.toggle('pill--on', pill.dataset.sort === sort);
				}

				flags.unrated = p.get('unrated') === '1';
				flags.liked = p.get('liked') === '1';
				flags.rewatched = p.get('rewatched') === '1';
				for (const chip of flagChips) {
					chip.setAttribute('aria-pressed', String(flags[chip.dataset.flag as keyof typeof flags]));
				}
				if (!flags.unrated) {
					setRange(
						snap(p.get('rmin'), RATING_FLOOR, RATING_CEIL, 0.5, RATING_FLOOR),
						snap(p.get('rmax'), RATING_FLOOR, RATING_CEIL, 0.5, RATING_CEIL),
					);
				}
				// Exact release years arrive only via deep-link. Keep whole four-digit years
				// in a sane range; renderReleaseYears() draws the removable chips.
				const nowYear = new Date().getFullYear();
				for (const raw of p.getAll('ryear')) {
					const y = Number(raw);
					if (Number.isInteger(y) && y >= 1870 && y <= nowYear + 5) releaseYears.add(y);
				}

				// The chips these values belong to don't exist yet, so the sets are filled
				// straight from the params: the first query has to carry a deep-link's
				// filter (a Stats "Top directors" link, say) or the grid would open on the
				// wrong films and only correct itself once the facets landed. applyFacets
				// then marks the matching chips pressed and drops anything the collection
				// doesn't actually offer.
				for (const key of URL_SETS) for (const v of p.getAll(key)) sets[key].add(v);

				for (const key of ['friendmode', 'wheremode'] as const) {
					const mode = p.get(key);
					if (mode !== 'any' && mode !== 'all') continue;
					modes[key] = mode;
					const group = panel.querySelector<HTMLElement>(`.modes[data-mode="${key}"]`);
					for (const b of Array.from(group?.querySelectorAll<HTMLButtonElement>('.mode') ?? [])) {
						b.classList.toggle('mode--on', b.dataset.value === mode);
					}
				}
			}

			// --- Filters, loaded after the grid ---------------------------------
			// Everything the panel offers is derived from the whole collection, which
			// costs several times what the first page of tiles does — so the page doesn't
			// wait on it. The chips, the two sliders' end stops and the People names all
			// arrive here.
			interface Facets {
				releaseYearLo: number | null;
				releaseYearHi: number | null;
				diaryYearLo: number | null;
				diaryYearHi: number | null;
				tags: string[];
				friends: string[];
				mediums: string[];
				venues: { value: string; label: string }[];
				formats: string[];
				directors: string[];
				actors: string[];
				genres: string[];
				languages: string[];
				countries: string[];
			}

			const facetsLoading = document.getElementById('facets-loading')!;
			const facetsError = document.getElementById('facets-error')!;
			const facetsRetry = document.getElementById('facets-retry')!;
			let facetsState: 'idle' | 'loading' | 'done' = 'idle';

			function applyFacets(f: Facets) {
				// Theater chips carry the full "Name, City" as their value but show the
				// shortest unambiguous label, which is also what the filter sentence says.
				venueLabelByValue.clear();
				for (const v of f.venues) venueLabelByValue.set(v.value, v.label);

				const plain = (values: string[]): ChipValue[] =>
					values.map((v) => ({ value: v, label: v }));
				renderChipGroup('tag', plain(f.tags));
				renderChipGroup('friend', plain(f.friends));
				renderChipGroup('medium', f.mediums.map((m) => ({ value: m, label: mediumLabel(m) ?? m })));
				renderChipGroup(
					'venue',
					f.venues.map((v) => ({ value: v.value, label: v.label, title: v.value })),
				);
				renderChipGroup('format', plain(f.formats));
				renderChipGroup('genre', plain(f.genres));
				renderChipGroup('language', plain(f.languages));
				renderChipGroup('country', plain(f.countries));
				filterChips = Array.from(panel.querySelectorAll<HTMLButtonElement>('.chip[data-filter]'));

				// A value that isn't on offer can't be cleared, and shouldn't silently keep
				// narrowing the grid — so drop it and re-query. Only reachable from a stale
				// or hand-typed link; the People sets are checked against their own names.
				const offered: Partial<Record<SetKey, Set<string>>> = {
					tag: new Set(f.tags),
					friend: new Set(f.friends),
					medium: new Set(f.mediums),
					venue: new Set(f.venues.map((v) => v.value)),
					format: new Set(f.formats),
					genre: new Set(f.genres),
					language: new Set(f.languages),
					country: new Set(f.countries),
					director: new Set(f.directors),
					actor: new Set(f.actors),
				};
				let dropped = false;
				for (const key of URL_SETS) {
					const known = offered[key];
					if (!known) continue;
					for (const v of sets[key]) {
						if (known.has(v)) continue;
						sets[key].delete(v);
						dropped = true;
					}
				}

				// Release-date and diary-date sliders: each is only worth drawing when the
				// collection spans more than one year to narrow between.
				hasReleaseRange =
					f.releaseYearLo != null && f.releaseYearHi != null && f.releaseYearHi > f.releaseYearLo;
				if (hasReleaseRange) {
					REL_LO = f.releaseYearLo!;
					REL_HI = f.releaseYearHi!;
					for (const input of [dminInput, dmaxInput]) {
						input.min = String(REL_LO);
						input.max = String(REL_HI);
					}
					const p = new URLSearchParams(location.search);
					setReleaseRange(
						snap(p.get('dmin'), REL_LO, REL_HI, 1, REL_LO),
						snap(p.get('dmax'), REL_LO, REL_HI, 1, REL_HI),
					);
					drangeSection.hidden = false;
				}

				hasDiaryRange =
					f.diaryYearLo != null && f.diaryYearHi != null && f.diaryYearHi > f.diaryYearLo;
				if (hasDiaryRange) {
					YR_LO = f.diaryYearLo!;
					YR_HI = f.diaryYearHi!;
					for (const input of [yminInput, ymaxInput]) {
						input.min = String(YR_LO);
						input.max = String(YR_HI);
					}
					const p = new URLSearchParams(location.search);
					setYears(
						snap(p.get('dymin'), YR_LO, YR_HI, 1, YR_LO),
						snap(p.get('dymax'), YR_LO, YR_HI, 1, YR_HI),
					);
					yrangeSection.hidden = false;
				}

				peopleNames.director = f.directors;
				peopleNames.actor = f.actors;
				peopleSection.hidden = f.directors.length === 0 && f.actors.length === 0;
				renderPeople();

				// The server filtered by the raw ?dmin/?dymin numbers. Snapping them to
				// the collection's bounds just now may have moved them — and a slider
				// that turned out to have no range to draw can't reproduce its filter at
				// all — either of which leaves the grid saying something the controls no
				// longer do. Only that needs a re-query; a range that survived intact is
				// already on screen.
				const moved = (
					rawMin: number | null,
					rawMax: number | null,
					has: boolean,
					min: number,
					max: number,
				) => {
					if (rawMin == null && rawMax == null) return false;
					if (!has) return true;
					return (rawMin != null && rawMin !== min) || (rawMax != null && rawMax !== max);
				};
				const rangeMoved =
					moved(urlRelMin, urlRelMax, hasReleaseRange, dMin, dMax) ||
					moved(urlDiaryMin, urlDiaryMax, hasDiaryRange, yMin, yMax);
				// The sliders are authoritative from here on.
				urlRelMin = urlRelMax = urlDiaryMin = urlDiaryMax = null;
				facetsLoading.hidden = true;
				facetsState = 'done';
				// Reveal the Movie details drawer when a restored link lands a filter
				// inside it, so its active filters aren't hidden behind a collapsed section.
				if (movieActiveCount() > 0) {
					mdBody.hidden = false;
					mdToggle.setAttribute('aria-expanded', 'true');
				}
				syncChrome();
				if (dropped || rangeMoved) {
					writeUrl();
					load(true);
				}
			}

			async function loadFacets() {
				if (facetsState !== 'idle') return;
				facetsState = 'loading';
				facetsError.hidden = true;
				facetsLoading.hidden = false;
				try {
					const res = await fetch('/api/films/watched/facets');
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					applyFacets((await res.json()) as Facets);
				} catch (e) {
					console.error('watched: failed to load filter facets', e);
					facetsState = 'idle'; // let Retry (or opening the panel again) try once more
					facetsLoading.hidden = true;
					facetsError.hidden = false;
				}
			}

			facetsRetry.addEventListener('click', loadFacets);

			// The server rendered the first page from these same params, so restoring
			// them only catches the controls up to a grid that's already right — no
			// opening re-query, and no swapping out a screenful of posters to get there.
			readUrl();
			syncChrome();
			// Draw any release-year chips restored from a ?ryear=… deep-link. These need
			// no facets — the years come from the URL itself.
			renderReleaseYears();

			// Fetch the filters once the page has settled — or straight away if the panel
			// is opened first, so it's never waiting on an idle callback to start.
			toggle.addEventListener('click', loadFacets);
			if (document.readyState === 'complete') loadFacets();
			else window.addEventListener('load', loadFacets, { once: true });
		}
	</script>
</FilmLayout>
