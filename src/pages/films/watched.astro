---
import FilmLayout from '../../layouts/FilmLayout.astro';
import { listWatchedPage } from '../../lib/films';
import { starText } from '../../lib/format';
import { imageUrl } from '../../lib/tmdb';

// Rendered on demand — reflects the live database.
export const prerender = false;

/** Films per page. The first batch is server-rendered; the rest are fetched from
 * /api/films/watched/list as you scroll (that route caps `limit` at 100). */
const BATCH = 100;

// The default view: newest-watched first, unfiltered. Search, sort and every
// filter re-query from the server, so this is only the starting slice.
//
// The filter chips deliberately aren't part of this await. Deriving them means
// reading every watched film's credits plus the whole diary — several times the
// cost of the 100 tiles below, for a panel that starts collapsed. They come from
// /api/films/watched/facets once the page has painted (see applyFacets in the
// script), which is what lets the grid show up as soon as its own query returns.
const { films, total } = await listWatchedPage({ limit: BATCH });
const hasMore = total > films.length;
const num = (n: number) => n.toLocaleString('en-US');
---

<FilmLayout title="Films watched — Jason's film log">
	<div class="page">
		<div class="wrap">
			<header class="topbar">
				<a class="back" href="/films">
					<span class="back__arrow">←</span><span>Jason's film log</span>
				</a>
				<span class="topbar__tag">Films watched</span>
			</header>

			<div class="titleblock">
				<div>
					<h1>All films</h1>
					<div class="sub">
						<span class="sub__n">{num(total)}</span> films watched · showing{' '}
						<span class="sub__n" id="shown">{num(total)}</span>
					</div>
				</div>
			</div>

			<div class="filterbar">
				<input
					type="search"
					id="search"
					placeholder="Search films…"
					autocomplete="off"
					aria-label="Search films"
				/>
				<button
					type="button"
					id="filters-toggle"
					class="pill pill--btn"
					aria-expanded="false"
					aria-controls="filters"
				>
					Filters<span id="filters-count"></span>
				</button>
				<div class="sortby">
					<span class="sortby__label">Sort</span>
					<button type="button" class="pill pill--on" data-sort="recent">Recent</button>
					<button type="button" class="pill" data-sort="year">Release date</button>
				</div>
			</div>

			{/* Everything chip- or range-shaped in here is filled in by applyFacets()
			    from /api/films/watched/facets. Only the controls that need no
			    knowledge of the collection — search, sort, the star range, the
			    activity flags — are usable before that lands. */}
			<div class="panel" id="filters" hidden>
				<div class="panel__head">
					<span class="panel__title">Filter films</span>
					<span class="panel__loading" id="facets-loading">Loading filters…</span>
					<button type="button" id="clear-all" class="clear" hidden>Clear all</button>
				</div>
				<p class="panel__error" id="facets-error" hidden>
					Couldn't load the filters. <button type="button" id="facets-retry">Retry</button>
				</p>

				<div class="panel__grid">
					<section>
						<h2 class="grp">Rating</h2>
						<div class="rating">
							<div class="range" id="range">
								<div class="range__track"></div>
								<div class="range__fill" id="range-fill"></div>
								<input type="range" id="rmin" min="0.5" max="5" step="0.5" value="0.5" aria-label="Minimum rating" />
								<input type="range" id="rmax" min="0.5" max="5" step="0.5" value="5" aria-label="Maximum rating" />
								<div class="range__ends">
									<span id="rmin-stars">½</span><span id="rmax-stars">★★★★★</span>
								</div>
							</div>
							<button type="button" class="chip" data-flag="unrated" aria-pressed="false">Unrated only</button>
						</div>
					</section>

					<section>
						<h2 class="grp">Activity</h2>
						<div class="chips chips--gap">
							<button type="button" class="chip" data-flag="liked" aria-pressed="false">♥ Liked</button>
							<button type="button" class="chip" data-flag="rewatched" aria-pressed="false">↻ Rewatched</button>
						</div>
					</section>

					{/* Bounds arrive with the facets; until then the slider isn't drawn,
					    same as when the collection spans a single year. */}
					<section id="yrange-section" hidden>
						<h2 class="grp">Diary date</h2>
						<div class="range range--dec" id="yrange">
							<div class="range__track"></div>
							<div class="range__fill" id="yrange-fill"></div>
							<input type="range" id="ymin" step="1" aria-label="Earliest diary year" />
							<input type="range" id="ymax" step="1" aria-label="Latest diary year" />
							<div class="range__ends">
								<span id="ymin-label"></span><span id="ymax-label"></span>
							</div>
						</div>
					</section>

					<section data-group="tag">
						<h2 class="grp">Tags</h2>
						<p class="grp__none" data-none hidden>No tags yet</p>
						<div class="chips" data-chips="tag"></div>
					</section>

					<section data-group="friend">
						<div class="grp__row">
							<h2 class="grp">Watched with</h2>
							<div class="modes" data-mode="friendmode">
								<button type="button" class="mode mode--on" data-value="any">Any</button>
								<button type="button" class="mode" data-value="all">All</button>
							</div>
						</div>
						<p class="grp__none" data-none hidden>No one tagged yet</p>
						<div class="chips" data-chips="friend"></div>
					</section>

					<section class="panel__wide">
						<div class="grp__row">
							<h2 class="grp">Medium · theater · format</h2>
							<div class="modes" data-mode="wheremode">
								<button type="button" class="mode mode--on" data-value="any">Any</button>
								<button type="button" class="mode" data-value="all">All</button>
							</div>
						</div>
						<div class="where">
							<div class="where__row">
								<span class="where__label">Medium</span>
								<div class="chips" data-chips="medium"></div>
							</div>
							<div class="where__row">
								<span class="where__label">Theater</span>
								<div class="chips" data-chips="venue"></div>
							</div>
							<div class="where__row">
								<span class="where__label">Format</span>
								<div class="chips" data-chips="format"></div>
							</div>
						</div>
					</section>
				</div>

				<div class="moviedetails">
					<button
						type="button"
						id="md-toggle"
						class="md__toggle"
						aria-expanded="false"
						aria-controls="md-body"
					>
						<span class="md__chevron" aria-hidden="true">▸</span>
						<span class="md__label">Movie details</span>
						<span class="md__count" id="md-count"></span>
					</button>

					<div class="md__body" id="md-body" hidden>
						<div class="panel__grid">
							{/* Bounds arrive with the facets; until then the slider isn't drawn,
							    same as when the collection sits inside one decade. */}
							<section id="drange-section" hidden>
								<h2 class="grp">Release date</h2>
								<div class="range range--dec" id="drange">
									<div class="range__track"></div>
									<div class="range__fill" id="drange-fill"></div>
									<input type="range" id="dmin" step="10" aria-label="Earliest release decade" />
									<input type="range" id="dmax" step="10" aria-label="Latest release decade" />
									<div class="range__ends">
										<span id="dmin-label"></span><span id="dmax-label"></span>
									</div>
								</div>
							</section>

							{/* Exact release years. No chips are shipped — the section is
							    populated only when a Stats "Films by release year" deep-link
							    arrives (?ryear=…), and stays hidden otherwise. */}
							<section id="ryear-section" hidden>
								<h2 class="grp">Release year</h2>
								<div class="chips" id="ryears"></div>
							</section>

							<section data-group="genre" hidden>
								<h2 class="grp">Genre</h2>
								<div class="chips" data-chips="genre"></div>
							</section>

							<section data-group="language" hidden>
								<h2 class="grp">Language</h2>
								<div class="chips" data-chips="language"></div>
							</section>

							<section data-group="country" hidden>
								<h2 class="grp">Country</h2>
								<div class="chips" data-chips="country"></div>
							</section>

							{/* The credit lists run to thousands of names, so these two rows
							    never hold the whole set — the search box builds matching chips
							    on demand from the facet payload. */}
							<section class="panel__wide" id="people-section" hidden>
								<div class="grp__row">
									<h2 class="grp">People</h2>
									<input
										type="search"
										id="people-search"
										class="people-search"
										placeholder="Search directors & cast…"
										autocomplete="off"
										aria-label="Search directors and cast"
									/>
								</div>
								<div class="where">
									<div class="where__row">
										<span class="where__label">Director</span>
										<div class="chips" data-people="director">
											<span class="people-none" hidden>No matches</span>
										</div>
									</div>
									<div class="where__row">
										<span class="where__label">Cast</span>
										<div class="chips" data-people="actor">
											<span class="people-none" hidden>No matches</span>
										</div>
									</div>
								</div>
							</section>
						</div>
					</div>
				</div>
			</div>

			<div class="filterinfo" id="filterinfo" hidden>
				<span class="filterinfo__tag">Filter</span>
				<p class="filterinfo__text" id="filterinfo-text"></p>
			</div>

			<div class="grid" id="grid">
				{films.map((f) => {
					const poster = imageUrl(f.poster_path, 'w342');
					return (
						<a class={poster ? 'tile' : 'tile tile--noimg'} href={`/films/movie/${f.tmdb_id}`}>
							{poster && <img data-poster={poster} alt={`${f.title} poster`} decoding="async" />}
							<div class="tile__overlay">
								<div class="tile__title">{f.title}</div>
								<div class="tile__year">{f.release_year}</div>
								<div class="tile__stars">{starText(f.rating) ?? 'Unrated'}</div>
							</div>
						</a>
					);
				})}
			</div>

			<p class="empty" id="empty" hidden>
				<span id="empty-by-query">No films match “<span id="empty-q"></span>”</span>
				<span id="empty-by-filters" hidden>No films match these filters</span>
			</p>

			<div id="sentinel" data-batch={BATCH} hidden={!hasMore}>
				<span class="sentinel__spinner" aria-hidden="true"></span>
				<span class="sentinel__text">Loading more…</span>
			</div>
			<p id="load-error" class="load-error" hidden>
				Couldn't load more films. <button type="button" id="retry">Retry</button>
			</p>
		</div>
	</div>

	<style>
		.page {
			display: flex;
			justify-content: center;
			padding: 0 24px 80px;
		}
		.wrap {
			width: 100%;
			max-width: 1000px;
		}
		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 26px 0 22px;
			border-bottom: 1px solid #4a2529;
			margin-bottom: 34px;
		}
		.back {
			display: flex;
			align-items: center;
			gap: 9px;
			font-size: 13px;
			color: #a2857a;
		}
		.back:hover {
			color: #f4e8d1;
		}
		.back__arrow {
			font-size: 15px;
		}
		.topbar__tag {
			font-size: 11.5px;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #8a6f63;
		}

		.titleblock {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			margin-bottom: 26px;
			flex-wrap: wrap;
			gap: 16px;
		}
		h1 {
			font-family: 'Newsreader', serif;
			font-weight: 500;
			font-size: 52px;
			color: #f4e8d1;
			letter-spacing: -0.5px;
			line-height: 1;
			margin: 0;
		}
		.sub {
			font-size: 13px;
			color: #a2857a;
			margin-top: 10px;
		}
		.sub__n {
			color: #d9b45a;
			font-weight: 600;
		}

		.filterbar {
			display: flex;
			gap: 12px;
			align-items: center;
			margin-bottom: 14px;
			flex-wrap: wrap;
		}
		#search {
			flex: 1;
			min-width: 220px;
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 8px;
			padding: 11px 14px;
			color: #f4e8d1;
			font-size: 14px;
			font-family: 'Archivo', sans-serif;
			outline: none;
		}
		#search::placeholder {
			color: #8a6f63;
		}
		#search:focus {
			border-color: #d9b45a;
		}
		.sortby {
			display: flex;
			align-items: center;
			gap: 8px;
		}
		.sortby__label {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
		}
		.pill {
			font-size: 12.5px;
			padding: 7px 13px;
			border-radius: 20px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			border: 1px solid #4a2529;
			background: transparent;
			color: #ddc9b4;
		}
		.pill:hover {
			border-color: #a2857a;
		}
		.pill--on {
			background: #d9b45a;
			color: #2a1214;
			font-weight: 600;
			border-color: #d9b45a;
		}
		.pill--btn {
			padding: 10px 16px;
			border-radius: 8px;
		}

		/* --- Filter description panel --- */
		.filterinfo {
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 12px;
			padding: 15px 20px;
			margin-bottom: 16px;
			display: flex;
			align-items: baseline;
			gap: 16px;
		}
		.filterinfo[hidden] {
			display: none;
		}
		.filterinfo__tag {
			font-size: 10.5px;
			text-transform: uppercase;
			letter-spacing: 1.8px;
			color: #8a6f63;
			flex: none;
		}
		.filterinfo__text {
			font-family: 'Newsreader', serif;
			font-size: 16px;
			line-height: 1.55;
			margin: 0;
			letter-spacing: 0.1px;
			color: #c2a99a;
		}
		.filterinfo__text .finfo__em {
			color: #f0d488;
			font-weight: 600;
		}

		/* --- Filter panel --- */
		.panel {
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 12px;
			padding: 24px 26px;
			margin-bottom: 26px;
		}
		.panel[hidden] {
			display: none;
		}
		.panel__head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 20px;
		}
		.panel__title {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.6px;
			color: #8a6f63;
		}
		/* Sits between the title and "Clear all" while the chips are on their way.
		   Quiet on purpose: the panel is usable without it (search, stars, activity),
		   so this is a note, not a blocker. */
		.panel__loading {
			margin-right: auto;
			padding-left: 12px;
			font-size: 12px;
			color: #7c6156;
			font-style: italic;
		}
		.panel__loading[hidden] {
			display: none;
		}
		.panel__error {
			margin: -8px 0 16px;
			font-size: 13px;
			color: #a2857a;
		}
		.panel__error[hidden] {
			display: none;
		}
		.panel__error button {
			font: inherit;
			color: #d9b45a;
			background: none;
			border: none;
			padding: 0;
			cursor: pointer;
			text-decoration: underline;
		}
		.clear {
			font-size: 12px;
			font-weight: 600;
			color: #d9b45a;
			background: transparent;
			border: none;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			padding: 0;
		}
		.clear:hover {
			color: #f0d488;
		}
		.clear[hidden] {
			display: none;
		}
		.panel__grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 26px 40px;
		}
		.panel__wide {
			grid-column: 1 / -1;
		}
		#ryear-section[hidden] {
			display: none;
		}

		/* --- Movie details drawer --- */
		/* An expandable section under the main filters holding the film-metadata
		   filters (release date, genre, language, country, people) so they don't
		   crowd the diary-side controls above. */
		.moviedetails {
			margin-top: 20px;
			padding-top: 18px;
			border-top: 1px solid #4a2529;
		}
		.md__toggle {
			display: flex;
			align-items: center;
			gap: 8px;
			background: transparent;
			border: none;
			cursor: pointer;
			padding: 0;
			font-family: 'Archivo', sans-serif;
		}
		.md__chevron {
			font-size: 11px;
			color: #8a6f63;
			transition: transform 0.15s ease;
		}
		.md__toggle[aria-expanded='true'] .md__chevron {
			transform: rotate(90deg);
		}
		@media (prefers-reduced-motion: reduce) {
			.md__chevron {
				transition: none;
			}
		}
		.md__label {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.6px;
			color: #8a6f63;
		}
		.md__toggle:hover .md__label,
		.md__toggle:hover .md__chevron {
			color: #a2857a;
		}
		.md__count {
			font-size: 11px;
			font-weight: 600;
			color: #d9b45a;
		}
		.md__count:empty {
			display: none;
		}
		.md__body {
			margin-top: 18px;
		}
		.md__body[hidden] {
			display: none;
		}
		.grp {
			font-size: 11px;
			font-weight: 400;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
			margin: 0 0 12px;
		}
		/* A second heading inside a section (Activity → Decade) needs the gap back. */
		.chips + .grp {
			margin-top: 16px;
		}
		.grp__row {
			display: flex;
			align-items: center;
			gap: 12px;
			margin-bottom: 12px;
		}
		.grp__row .grp {
			margin-bottom: 0;
		}
		.grp__none {
			font-size: 13px;
			font-style: italic;
			font-family: 'Newsreader', serif;
			color: #8a6f63;
			margin: 0;
		}
		.chips {
			display: flex;
			gap: 8px;
			flex-wrap: wrap;
		}
		.chip {
			font-size: 12.5px;
			padding: 7px 13px;
			border-radius: 20px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			border: 1px solid #4a2529;
			background: transparent;
			color: #ddc9b4;
		}
		.chip:hover {
			border-color: #a2857a;
		}
		.chip[aria-pressed='true'] {
			background: #d9b45a;
			color: #2a1214;
			font-weight: 600;
			border-color: #d9b45a;
		}
		.chip[hidden] {
			display: none;
		}
		.chip--more {
			background: transparent;
			color: #a2857a;
			border-style: dashed;
		}

		/* Dual-thumb rating range: two native sliders stacked on one track, so
		   keyboard and screen-reader support come for free. The inputs ignore
		   pointer events except on their thumbs, which lets whichever thumb is
		   under the cursor take the drag even though the boxes fully overlap. */
		.rating {
			display: flex;
			align-items: center;
			gap: 18px;
		}
		.rating--off .range {
			opacity: 0.35;
		}
		.range {
			flex: 1;
			max-width: 260px;
			position: relative;
			height: 32px;
		}
		.range__track,
		.range__fill {
			position: absolute;
			top: 14px;
			height: 4px;
			border-radius: 2px;
			pointer-events: none;
		}
		.range__track {
			left: 0;
			right: 0;
			background: #402226;
		}
		.range__fill {
			background: #d9b45a;
		}
		.range input[type='range'] {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 32px;
			margin: 0;
			background: none;
			appearance: none;
			-webkit-appearance: none;
			pointer-events: none;
		}
		.range input[type='range']:focus-visible {
			outline: none;
		}
		.range input[type='range']::-webkit-slider-thumb {
			appearance: none;
			-webkit-appearance: none;
			pointer-events: auto;
			width: 16px;
			height: 16px;
			border-radius: 50%;
			background: #f0d488;
			border: 2px solid #241012;
			box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
			cursor: pointer;
		}
		.range input[type='range']::-moz-range-thumb {
			pointer-events: auto;
			width: 16px;
			height: 16px;
			border-radius: 50%;
			background: #f0d488;
			border: 2px solid #241012;
			box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
			cursor: pointer;
		}
		.range input[type='range']:focus-visible::-webkit-slider-thumb {
			outline: 2px solid #f0d488;
