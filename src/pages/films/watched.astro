		.people-none {
			font-size: 12px;
			font-style: italic;
			font-family: 'Newsreader', serif;
			color: #8a6f63;
		}
		.people-none[hidden] {
			display: none;
		}
		.modes {
			display: flex;
			border: 1px solid #4a2529;
			border-radius: 14px;
			overflow: hidden;
