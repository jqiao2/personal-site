---
// The Screening Room — the "queued" watchlist as one continuous calendar. Films
// you've scheduled to watch (at home or in a theatre) sit on the day you plan to
// see them. The run is a plain 7-column grid that scrolls forever, month seams
// marked by nothing but a bolder grid line stepping around the 1st; the owner
// can schedule a film onto any day, drag one to another day, remove one, and
// pull AMC-style events in from the connected Movies calendar.
import FilmLayout from '../../layouts/FilmLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ScreeningComposer from '../../components/ScreeningComposer.astro';
import ScreeningCalendar from '../../components/ScreeningCalendar.astro';
import { requireOwner } from '../../lib/auth';
import { listQueue } from '../../lib/screening-queue';
import { isConfigured as calendarConfigured } from '../../lib/google-calendar';
import { siteDay } from '../../lib/day';
import { addWeeks, buildWeeks, firstMonday, runStartMonth } from '../../lib/screening-calendar';

// Rendered on demand — reflects the live database.
export const prerender = false;

const [queue, isOwner] = await Promise.all([listQueue(), requireOwner(Astro.cookies)]);
const calSync = isOwner && calendarConfigured();

const today = siteDay();
const PAGE_WEEKS = 12;
const start = firstMonday(runStartMonth(queue, today));
const rendered = buildWeeks({ startMonday: start, weeks: PAGE_WEEKS, queue, today });
const next = addWeeks(start, PAGE_WEEKS);

const WEEKDAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
---

<FilmLayout title="Screening Room — Jason's film log">
	<div class="page">
		<div class="wrap">
			<SiteHeader pathname={Astro.url.pathname} theme="film" max="1064px" />

			<header class="topbar">
				<a class="back" href="/films/watchlist">
					<span class="back__arrow">←</span><span>Watchlist</span>
				</a>
				<span class="topbar__tag">Screening Room</span>
			</header>

			<div class="titleblock">
				<div>
					<h1>Screening Room</h1>
				</div>
				{isOwner && (
					<div class="titleblock__actions">
						{calSync && (
							<button type="button" class="btn-ghost" id="sync-btn" data-configured>
								↻ Sync from calendar
							</button>
						)}
						<button type="button" class="btn-add" data-open-screening>+ Schedule a film</button>
					</div>
				)}
			</div>

			{isOwner && <p class="sync-msg" id="sync-msg" hidden></p>}

			<div class="calendar">
				<div class="dow" aria-hidden="true">
					{WEEKDAYS.map((d) => <span>{d}</span>)}
				</div>
				<div class="grid" id="run" data-next={next} data-weeks={PAGE_WEEKS} data-today={today}>
					<ScreeningCalendar weeks={rendered} isOwner={isOwner} />
				</div>
			</div>
			<div class="sentinel" id="sentinel"></div>
		</div>
	</div>

	{isOwner && <ScreeningComposer />}

	<style>
		.page {
			overflow-x: hidden;
			display: flex;
			justify-content: center;
			padding: 0 24px 80px;
		}
		.wrap {
			width: 100%;
			max-width: 1000px;
		}
		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 26px 0 22px;
			border-bottom: 1px solid #4a2529;
			margin-bottom: 34px;
		}
		.back {
			display: flex;
			align-items: center;
			gap: 9px;
			font-size: 13px;
			color: #a2857a;
		}
		.back:hover {
			color: #f4e8d1;
		}
		.back__arrow {
			font-size: 15px;
		}
		.topbar__tag {
			font-size: 11.5px;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #8a6f63;
		}

		.titleblock {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			margin-bottom: 20px;
			flex-wrap: wrap;
			gap: 16px;
		}
		h1 {
			font-family: var(--font-newsreader);
			font-weight: 500;
			font-size: 52px;
			color: #f4e8d1;
			letter-spacing: -0.5px;
			line-height: 1;
			margin: 0;
		}
		.titleblock__actions {
			display: flex;
			align-items: center;
			gap: 10px;
		}
		.btn-add {
			font-size: 13px;
			font-weight: 700;
			color: #2a1214;
			background: #d9b45a;
			border: none;
			border-radius: 8px;
			padding: 10px 18px;
			cursor: pointer;
			font-family: var(--font-archivo);
			white-space: nowrap;
		}
		.btn-add:hover {
			background: #f0d488;
		}
		.btn-ghost {
			font-size: 12.5px;
			padding: 10px 16px;
			border-radius: 8px;
			cursor: pointer;
			font-family: var(--font-archivo);
			border: 1px solid #6b4a42;
			background: transparent;
			color: #f0d488;
			white-space: nowrap;
		}
		.btn-ghost:hover {
			border-color: #d9b45a;
			background: #241012;
		}
		.btn-ghost:disabled {
			opacity: 0.6;
			cursor: default;
		}
		.sync-msg {
			margin: 0 0 18px;
			font-size: 13px;
			color: #a2857a;
		}
		.sync-msg[hidden] {
			display: none;
		}
		.sync-msg.error {
			color: #e0736f;
		}

		.calendar {
			display: flex;
			flex-direction: column;
			gap: 10px;
		}
		/* The weekday strip stays put while the run scrolls under it. */
		.dow {
			position: sticky;
			top: 0;
			z-index: 3;
			display: grid;
			grid-template-columns: repeat(7, minmax(0, 1fr));
			gap: 10px;
			font-size: 11.5px;
			letter-spacing: 1.5px;
			text-transform: uppercase;
			color: #8a6f63;
			padding: 10px 2px;
			background: #140809;
		}
		/* One grid for the whole run — nothing but days, month to month. */
		.grid {
			display: grid;
			grid-template-columns: repeat(7, minmax(0, 1fr));
			gap: 10px;
			align-items: start;
		}
		.sentinel {
			height: 1px;
		}

		@media (max-width: 640px) {
			h1 {
				font-size: 40px;
			}
		}
	</style>

	<script>
		const run = document.getElementById('run') as HTMLElement | null;

		// --- Infinite scroll ---
		// Pages are whole weeks, so a boundary never splits one. The partial route
		// returns the same rows this page rendered, ready to append.
		if (run) {
			const sentinel = document.getElementById('sentinel')!;
			const weeks = Number(run.dataset.weeks) || 12;
			let loading = false;

			const loadMore = async () => {
				if (loading) return;
				loading = true;
				const from = run.dataset.next!;
				try {
					const res = await fetch(`/films/screening-room/months?from=${from}&weeks=${weeks}`);
					if (!res.ok) throw new Error();
					run.insertAdjacentHTML('beforeend', await res.text());
					const d = new Date(`${from}T00:00:00`);
					d.setDate(d.getDate() + weeks * 7);
					run.dataset.next = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
					loading = false;
				} catch {
					// Left loading — a failed page stops the run rather than hammering
					// the endpoint on every scroll tick.
				}
			};

			new IntersectionObserver((entries) => entries[0].isIntersecting && loadMore(), {
				rootMargin: '600px',
			}).observe(sentinel);

			// Open on today rather than at the top of the scrollback.
			run.querySelector(`[data-date="${run.dataset.today}"]`)?.scrollIntoView({ block: 'center' });
		}

		// --- Remove a queued film (owner) ---
		// Delegated, so films on pages appended later behave the same.
		run?.addEventListener('click', async (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.film__remove');
			if (!btn) return;
			const film = btn.closest<HTMLElement>('.film');
			const tmdbId = film?.dataset.tmdbId;
			if (!tmdbId) return;
			btn.disabled = true;
			try {
				const res = await fetch(`/api/films/screening-queue?tmdbId=${tmdbId}`, { method: 'DELETE' });
				if (res.status === 401) {
					window.location.href = '/films/login?redirect=/films/screening-room';
					return;
				}
				if (!res.ok) throw new Error();
				film!.remove();
			} catch {
				btn.disabled = false;
			}
		});

		// --- Drag a film onto another day (owner) ---
		// Native HTML5 drag and drop. The poster moves first and the write follows;
		// a failed write puts it back where it came from.
		if (run) {
			let dragged: HTMLElement | null = null;

			run.addEventListener('dragstart', (e) => {
				const film = (e.target as HTMLElement).closest<HTMLElement>('.film[draggable="true"]');
				if (!film) return;
				dragged = film;
				film.classList.add('is-dragging');
				e.dataTransfer!.effectAllowed = 'move';
				// Firefox refuses to start a drag with an empty payload.
				e.dataTransfer!.setData('text/plain', film.dataset.tmdbId ?? '');
			});
			run.addEventListener('dragend', () => {
				dragged?.classList.remove('is-dragging');
				run.querySelectorAll('.cell.is-over').forEach((c) => c.classList.remove('is-over'));
				dragged = null;
			});

			const cellUnder = (e: DragEvent) =>
				dragged ? (e.target as HTMLElement).closest<HTMLElement>('.cell') : null;

			run.addEventListener('dragover', (e) => {
				const cell = cellUnder(e);
				if (!cell) return;
				e.preventDefault();
				e.dataTransfer!.dropEffect = 'move';
				if (!cell.classList.contains('is-over')) {
					run.querySelectorAll('.cell.is-over').forEach((c) => c.classList.remove('is-over'));
					cell.classList.add('is-over');
				}
			});
			run.addEventListener('dragleave', (e) => {
				const cell = cellUnder(e);
				if (cell && !cell.contains(e.relatedTarget as Node)) cell.classList.remove('is-over');
			});

			run.addEventListener('drop', async (e) => {
				const cell = cellUnder(e);
				const film = dragged;
				if (!cell || !film) return;
				e.preventDefault();
				cell.classList.remove('is-over');

				const home = film.parentElement!;
				const target = cell.querySelector('.cell__films')!;
				if (home === target) return;

				const sibling = film.nextSibling;
				target.appendChild(film);
				film.classList.add('is-saving');
				try {
					const res = await fetch('/api/films/screening-queue', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({
							tmdbId: Number(film.dataset.tmdbId),
							date: cell.dataset.date,
							// Carried through so a move doesn't drop the theatre.
							venue: film.dataset.venue || null,
						}),
					});
					if (res.status === 401) {
						window.location.href = '/films/login?redirect=/films/screening-room';
						return;
					}
					if (!res.ok) throw new Error();
				} catch {
					home.insertBefore(film, sibling);
				} finally {
					film.classList.remove('is-saving');
				}
			});
		}

		// --- Sync from the Movies calendar (owner) ---
		// Pulls AMC-style events in, then reloads to show them. Reports what came back.
		const syncBtn = document.getElementById('sync-btn') as HTMLButtonElement | null;
		const syncMsg = document.getElementById('sync-msg');
		syncBtn?.addEventListener('click', async () => {
			syncBtn.disabled = true;
			if (syncMsg) {
				syncMsg.hidden = false;
				syncMsg.className = 'sync-msg';
				syncMsg.textContent = 'Syncing from calendar…';
			}
			try {
				const res = await fetch('/api/films/screening-queue/sync', { method: 'POST' });
				const data = await res.json().catch(() => ({}));
				if (!res.ok) throw new Error(data.error || 'Sync failed');
				if (data.added > 0) {
					window.location.reload();
					return;
				}
				if (syncMsg) {
					const bits = [`${data.added} added`, `${data.skipped} already synced`];
					if (data.unresolved?.length) bits.push(`couldn't match: ${data.unresolved.join(', ')}`);
					syncMsg.textContent = bits.join(' · ');
				}
				syncBtn.disabled = false;
			} catch (err) {
				if (syncMsg) {
					syncMsg.className = 'sync-msg error';
					syncMsg.textContent = err instanceof Error ? err.message : 'Sync failed';
				}
				syncBtn.disabled = false;
			}
		});
	</script>
</FilmLayout>
