---
import FilmLayout from '../../layouts/FilmLayout.astro';
import EntryEditor from '../../components/EntryEditor.astro';
import {
	getFilmLogStats,
	listFavorites,
	listWatchlist,
	listLogs,
	listTheaterNames,
	listTags,
	listFriends,
} from '../../lib/films';
import { requireOwner } from '../../lib/auth';
import { starText } from '../../lib/format';
import { imageUrl } from '../../lib/tmdb';

// Rendered on demand — reflects the live database.
export const prerender = false;

const [stats, favorites, watchlist, recent, isOwner] = await Promise.all([
	getFilmLogStats(),
	listFavorites(4),
	listWatchlist(4),
	listLogs(4),
	requireOwner(Astro.cookies),
]);

// Composer autocomplete (owner only): known theaters, tags and friends.
const [venueOptions, tagOptions, friendOptions] = isOwner
	? await Promise.all([listTheaterNames(), listTags(), listFriends()])
	: [[], [], []];

/** "YYYY-MM-DD" (or ISO timestamp) → "Jul 8". */
function shortDate(date: string | null): string {
	if (!date) return '';
	const [y, m, d] = date.slice(0, 10).split('-').map(Number);
	if (!y || !m || !d) return '';
	return new Date(y, m - 1, d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

const histMax = Math.max(...stats.histogram, 1);
const num = (n: number) => n.toLocaleString('en-US');
---

<FilmLayout title="Jason's film log">
	<div class="page">
		<div class="card">
			<!-- Site nav -->
			<nav class="tabs">
				<a class="tabs__link" href="/">Home</a>
				<a class="tabs__link" href="/about">About</a>
				<a class="tabs__link" href="/projects">Projects</a>
				<a class="tabs__link tabs__link--active" href="/films" aria-current="page">Films</a>
				<a class="tabs__link" href="/subway">Subway</a>
				{isOwner ? (
					<button type="button" class="nav-btn nav-btn--log" data-open-entry-editor>+ Log film</button>
				) : (
					<button type="button" class="nav-btn nav-btn--login" id="open-login">Log in</button>
				)}
			</nav>

			<div class="card__body">
			<!-- Sidebar -->
			<aside class="side">
				<div class="brand">Jason's<br />film log</div>
				<div class="brand__sub">{stats.thisYear} films this year</div>

				<div class="side__rule"></div>
				<nav class="side__nav">
					<a class="navrow navrow--link" href="/films/watched">
						<span>Films watched</span><span class="navrow__n">{num(stats.watched)}</span>
					</a>
					<a class="navrow navrow--link" href="/films/diary">
						<span>Diary</span><span class="navrow__n">{num(stats.diary)}</span>
					</a>
					<a class="navrow navrow--link" href="/films/watchlist">
						<span>Watchlist</span><span class="navrow__n">{num(stats.watchlist)}</span>
					</a>
					<div class="navrow">
						<span>Liked films</span><span class="navrow__n">{num(stats.liked)}</span>
					</div>
					<a class="navrow navrow--link navrow--last" href="/films/stats">
						<span>Stats</span><span class="navrow__n">→</span>
					</a>
				</nav>
			</aside>

			<!-- Main -->
			<main class="main">
				{(favorites.length > 0 || isOwner) && (
					<section>
						<div class="sec-head">
							<span class="sec-head__title">Favorite films</span>
							{isOwner && (
								<a class="sec-head__link" href="/films/favorites">Edit favorites</a>
							)}
						</div>
						{favorites.length > 0 ? (
							<div class="grid4">
								{favorites.map((f) => (
									<a class="tile" href={`/films/movie/${f.tmdb_id}`}>
										{imageUrl(f.poster_path, 'w342') && (
											<img data-poster={imageUrl(f.poster_path, 'w342')} alt={`${f.title} poster`} decoding="async" />
										)}
										<div class="tile__cap">
											{f.title} <span class="tile__year">{f.release_year}</span>
										</div>
									</a>
								))}
							</div>
						) : (
							<p class="fav-empty">No favorites yet — <a href="/films/favorites">choose up to four</a>.</p>
						)}
					</section>
				)}

				{recent.length > 0 && (
					<section>
						<div class="sec-head">
							<span class="sec-head__title">Recent from diary</span>
							<a class="sec-head__link" href="/films/diary">See more →</a>
						</div>
						<div class="grid4">
							{recent.map((f) => (
								<a class="tile-wrap" href={`/films/diary/${f.id}`}>
									<div class="tile">
										{imageUrl(f.poster_path, 'w342') && (
											<img data-poster={imageUrl(f.poster_path, 'w342')} alt={`${f.title} poster`} decoding="async" />
										)}
										<div class="tile__cap">
											{f.title} <span class="tile__year">{f.release_year}</span>
										</div>
									</div>
									<div class="tile__meta">
										<span class="stars">{starText(f.rating) ?? ''}</span>
										<span class="tile__date">{shortDate(f.watched_date ?? f.created_at)}</span>
									</div>
								</a>
							))}
						</div>
					</section>
				)}

				{stats.ratedTotal > 0 && (
					<section>
						<div class="sec-head">
							<span class="sec-head__title">Ratings</span>
							<span class="sec-head__meta">
								{num(stats.ratedTotal)} rated · <span class="hl">{stats.ratedAvg}</span> avg
							</span>
						</div>
						<div class="hist">
							{stats.histogram.map((c) => (
								<div class="hist__col" title={`${num(c)}`}>
									<div class="hist__bar" style={`height:${Math.round((c / histMax) * 100)}%`}></div>
								</div>
							))}
						</div>
						<div class="hist__axis">
							<span>½★</span>
							<span>★★★★★</span>
						</div>
					</section>
				)}

				{watchlist.length > 0 && (
					<section>
						<div class="sec-head">
							<span class="sec-head__title">Recently added to watchlist</span>
							<a class="sec-head__link" href="/films/watchlist">See more →</a>
						</div>
						<div class="grid4">
							{watchlist.map((f) => (
								// Matches the watchlist grid: tiles lead to the film's own page,
								// which is where the download link lives.
								<a class="tile tile--dim" href={`/films/movie/${f.tmdb_id}`}>
									{imageUrl(f.poster_path, 'w342') && (
										<img data-poster={imageUrl(f.poster_path, 'w342')} alt={`${f.title} poster`} decoding="async" />
									)}
									<div class="tile__cap tile__cap--dim">
										{f.title} <span class="tile__year">{f.release_year}</span>
									</div>
								</a>
							))}
						</div>
					</section>
				)}
			</main>
			</div>
		</div>
	</div>

	{isOwner ? (
		<EntryEditor
			mode="select"
			venueOptions={venueOptions}
			tagOptions={tagOptions}
			friendOptions={friendOptions}
			redirect="/films"
		/>
	) : (
		<div class="login" id="login" hidden>
			<div class="login__backdrop" id="login-backdrop"></div>
			<div class="login__box" role="dialog" aria-modal="true" aria-labelledby="login-title">
				<div class="login__title" id="login-title">Admin sign in</div>
				<div class="login__sub">Enter the admin password to log films and edit this profile.</div>
				<form class="login__form" id="login-form">
					<input
						type="password"
						id="login-pw"
						placeholder="Password"
						autocomplete="current-password"
						required
					/>
					<div class="login__err" id="login-err" hidden>Incorrect password. Try again.</div>
					<div class="login__actions">
						<button type="button" class="login__cancel" id="login-cancel">Cancel</button>
						<button type="submit" class="login__submit">Sign in</button>
					</div>
				</form>
			</div>
		</div>
	)}

	<style>
		/* The section runs full-bleed rather than floating a card on the body
		   background. overflow-x guards the 100vw nav against a scrollbar. */
		.page {
			min-height: 100vh;
			background: #2a1214;
			display: flex;
			justify-content: center;
			overflow-x: hidden;
		}
		.card {
			width: 100%;
			max-width: 1120px;
			display: flex;
			flex-direction: column;
		}
		.card__body {
			display: flex;
		}

		/* Site nav — spans the viewport while its content stays aligned to the
		   1120px column. */
		.tabs {
			display: flex;
			align-items: stretch;
			gap: 2px;
			width: 100vw;
			margin-left: calc(50% - 50vw);
			padding: 0 calc(50vw - 50% + 28px);
			background: #20100f;
			border-bottom: 1px solid #4a2529;
		}
		.tabs__link {
			font-size: 13px;
			letter-spacing: 0.4px;
			color: #c2a99a;
			padding: 26px 16px 24px;
			border-bottom: 2px solid transparent;
			transition: color 0.12s;
		}
		.nav-btn {
			margin-left: auto;
			align-self: center;
			white-space: nowrap;
			font-size: 13px;
			font-weight: 700;
			border-radius: 8px;
			padding: 8px 16px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
		}
		.nav-btn--log {
			color: #2a1214;
			background: #d9b45a;
			border: none;
		}
		.nav-btn--log:hover {
			background: #f0d488;
		}
		.nav-btn--login {
			color: #f4e8d1;
			background: transparent;
			border: 1px solid #6b3a3f;
		}
		.nav-btn--login:hover {
			border-color: #d9b45a;
			color: #fff3df;
		}
		.tabs__link:hover {
			color: #f4e8d1;
		}
		.tabs__link--active {
			color: #f4e8d1;
			font-weight: 600;
			border-bottom-color: #d9b45a;
		}
		.tabs__link--active:hover {
			color: #fff3df;
		}

		/* Sidebar */
		.side {
			width: 288px;
			flex: none;
			background: #2a1214;
			border-right: 1px solid #4a2529;
			padding: 36px 28px;
			display: flex;
			flex-direction: column;
		}
		.brand {
			font-family: 'Newsreader', serif;
			font-size: 29px;
			font-weight: 500;
			color: #f4e8d1;
			letter-spacing: -0.3px;
			line-height: 1.05;
		}
		.brand__sub {
			margin-top: 8px;
			font-size: 13px;
			color: #d9b45a;
			font-weight: 600;
		}
		.side__rule {
			height: 1px;
			background: #4a2529;
			margin: 26px 0 8px;
		}
		.side__nav {
			display: flex;
			flex-direction: column;
		}
		.navrow {
			display: flex;
			justify-content: space-between;
			align-items: center;
			padding: 11px 0;
			font-size: 14px;
			color: #ddc9b4;
			border-bottom: 1px solid #402226;
		}
		.navrow--last {
			border-bottom: none;
		}
		.navrow--link {
			cursor: pointer;
		}
		.navrow--link:hover {
			color: #fff3df;
		}
		.navrow__n {
			color: #a2857a;
			font-size: 13px;
		}

		/* Main */
		.main {
			flex: 1;
			min-width: 0;
			padding: 38px 40px 44px;
			display: flex;
			flex-direction: column;
			gap: 38px;
		}
		.sec-head {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			border-bottom: 1px solid #4a2529;
			padding-bottom: 9px;
			margin-bottom: 16px;
			gap: 12px;
		}
		.sec-head__title {
			font-family: 'Newsreader', serif;
			font-style: italic;
			font-size: 19px;
			color: #ecdcbd;
		}
		.sec-head__link {
			font-size: 12px;
			color: #d9b45a;
			font-weight: 600;
			letter-spacing: 0.3px;
			white-space: nowrap;
		}
		.sec-head__link:hover {
			color: #f0d488;
		}
		.fav-empty {
			margin: 0;
			padding: 6px 0 2px;
			font-size: 14px;
			color: #8a6f63;
		}
		.fav-empty a {
			color: #d9b45a;
		}
		.sec-head__meta {
			font-size: 12px;
			color: #a2857a;
			white-space: nowrap;
		}
		.sec-head__meta .hl {
			color: #d9b45a;
			font-weight: 600;
		}

		.grid4 {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 16px;
		}
		.tile-wrap {
			display: block;
			color: inherit;
		}
		.tile {
			position: relative;
			aspect-ratio: 2 / 3;
			border-radius: 5px;
			overflow: hidden;
			background-image: repeating-linear-gradient(135deg, #351a1d 0 9px, #2c1518 9px 18px);
			border: 1px solid #4a2529;
			display: flex;
			align-items: flex-end;
			transition: border-color 0.12s;
		}
		.tile--dim {
			opacity: 0.9;
		}
		.tile:hover {
			border-color: #d9b45a;
		}
		.tile--dim:hover {
			opacity: 1;
		}
		.tile img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.tile__cap {
			position: relative;
			padding: 11px;
			font-family: 'Newsreader', serif;
			font-size: 14px;
			font-weight: 500;
			color: #f2e5cd;
			line-height: 1.2;
		}
		.tile__cap--dim {
			color: #d8c6ad;
		}
		.tile img ~ .tile__cap {
			display: none;
		}
		.tile__year {
			color: #b0917f;
			font-style: italic;
		}
		.tile__meta {
			display: flex;
			justify-content: space-between;
			align-items: center;
			margin-top: 9px;
		}
		.stars {
			color: #d9b45a;
			font-size: 13px;
			letter-spacing: 0.5px;
			white-space: nowrap;
		}
		.tile__date {
			color: #a2857a;
			font-size: 12px;
		}

		/* Histogram */
		.hist {
			display: flex;
			align-items: flex-end;
			gap: 6px;
			height: 104px;
		}
		.hist__col {
			flex: 1;
			height: 100%;
			display: flex;
			align-items: flex-end;
		}
		.hist__bar {
			width: 100%;
			min-height: 3px;
			background: #d9b45a;
			border-radius: 2px 2px 0 0;
		}
		.hist__axis {
			display: flex;
			justify-content: space-between;
			margin-top: 8px;
			font-size: 13px;
			color: #d9b45a;
		}

		/* Admin sign in */
		.login {
			position: fixed;
			inset: 0;
			z-index: 200;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 24px;
		}
		.login[hidden] {
			display: none;
		}
		.login__backdrop {
			position: absolute;
			inset: 0;
			background: rgba(15, 7, 8, 0.72);
			backdrop-filter: blur(3px);
		}
		.login__box {
			position: relative;
			width: 100%;
			max-width: 380px;
			background: #2a1214;
			border: 1px solid #6b3a3f;
			border-radius: 14px;
			padding: 32px 30px;
			box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
		}
		.login__title {
			font-family: 'Newsreader', serif;
			font-size: 24px;
			color: #f4e8d1;
			letter-spacing: -0.3px;
		}
		.login__sub {
			margin-top: 6px;
			font-size: 13px;
			color: #c2a99a;
			line-height: 1.4;
		}
		.login__form {
			margin-top: 22px;
			display: flex;
			flex-direction: column;
			gap: 12px;
		}
		#login-pw {
			width: 100%;
			background: #20100f;
			border: 1px solid #4a2529;
			border-radius: 8px;
			padding: 12px 14px;
			font-size: 14px;
			color: #f4e8d1;
			font-family: 'Archivo', sans-serif;
			outline: none;
		}
		#login-pw:focus {
			border-color: #d9b45a;
		}
		.login__err {
			font-size: 12.5px;
			color: #e08a8a;
		}
		.login__err[hidden] {
			display: none;
		}
		.login__actions {
			display: flex;
			gap: 10px;
			margin-top: 6px;
		}
		.login__cancel,
		.login__submit {
			flex: 1;
			font-size: 13px;
			border-radius: 8px;
			padding: 11px 0;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
		}
		.login__cancel {
			font-weight: 600;
			color: #ddc9b4;
			background: transparent;
			border: 1px solid #4a2529;
		}
		.login__cancel:hover {
			border-color: #6b3a3f;
		}
		.login__submit {
			font-weight: 700;
			color: #2a1214;
			background: #d9b45a;
			border: none;
		}
		.login__submit:hover {
			background: #f0d488;
		}

		@media (max-width: 720px) {
			.card__body {
				flex-direction: column;
			}
			.side {
				width: 100%;
				border-right: none;
				border-bottom: 1px solid #4a2529;
			}
			.main {
				padding: 28px 22px 34px;
			}
			.grid4 {
				grid-template-columns: repeat(2, 1fr);
			}
			/* Tighten the tabs so the action button still fits; it wraps to its own
			   row rather than overflowing, since the page clips horizontally. */
			.tabs {
				flex-wrap: wrap;
				padding-left: calc(50vw - 50% + 14px);
				padding-right: calc(50vw - 50% + 14px);
			}
			.tabs__link {
				padding: 18px 10px 16px;
			}
			.nav-btn {
				margin: 8px 0 8px auto;
			}
		}
	</style>

	<script>
		// Admin sign in, shown to signed-out visitors only. Astro always hoists this
		// script; bail out when the modal isn't in the DOM (the owner sees the
		// "+ Log film" button instead).
		const openBtn = document.getElementById('open-login');
		const modal = document.getElementById('login') as HTMLDivElement | null;

		if (openBtn && modal) {
			const form = document.getElementById('login-form') as HTMLFormElement;
			const pw = document.getElementById('login-pw') as HTMLInputElement;
			const err = document.getElementById('login-err') as HTMLDivElement;
			const cancel = document.getElementById('login-cancel') as HTMLButtonElement;
			const backdrop = document.getElementById('login-backdrop') as HTMLDivElement;

			const close = () => {
				modal.hidden = true;
				form.reset();
				err.hidden = true;
			};
			openBtn.addEventListener('click', () => {
				modal.hidden = false;
				pw.focus();
			});
			cancel.addEventListener('click', close);
			backdrop.addEventListener('click', close);
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && !modal.hidden) close();
			});

			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				err.hidden = true;
				try {
					const res = await fetch('/api/auth/login', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ password: pw.value }),
					});
					if (!res.ok) {
						err.hidden = false;
						pw.select();
						return;
					}
					// Reload so the server re-renders with the owner's controls.
					window.location.reload();
				} catch {
					err.hidden = false;
					pw.select();
				}
			});
		}
	</script>
</FilmLayout>
