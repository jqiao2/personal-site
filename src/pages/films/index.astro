---
import FilmLayout from '../../layouts/FilmLayout.astro';
import EntryEditor from '../../components/EntryEditor.astro';
import FilmsFeed from '../../components/FilmsFeed.astro';
import { listTheaterNames, listTags, listFriends } from '../../lib/films';
import { requireOwner } from '../../lib/auth';
import SiteHeader from '../../components/SiteHeader.astro';

// Rendered on demand so the header reflects the live session. The data-heavy
// feed is a server island (FilmsFeed, server:defer): only the fast owner check
// blocks this response, and the feed streams in after.
export const prerender = false;

const isOwner = await requireOwner(Astro.cookies);

// Composer autocomplete (owner only): known theaters, tags and friends.
const [venueOptions, tagOptions, friendOptions] = isOwner
	? await Promise.all([listTheaterNames(), listTags(), listFriends()])
	: [[], [], []];
---

<FilmLayout title="Jason's film log">
	<div class="page">
		<div class="card">
			<SiteHeader pathname={Astro.url.pathname} theme="film">
				<Fragment slot="actions">
					{isOwner && (
						<button type="button" class="nav-btn nav-btn--log" data-open-entry-editor>+ Log film</button>
					)}
				</Fragment>
			</SiteHeader>

			<FilmsFeed server:defer>
				<div slot="fallback" class="shell-skel" aria-hidden="true">
					<div class="feed-skel">
						{Array.from({ length: 6 }).map(() => (
							<div class="skel-item">
								<div class="skel-body">
									<div class="skel-line skel-line--meta"></div>
									<div class="skel-line skel-line--title"></div>
									<div class="skel-line skel-line--note"></div>
								</div>
								<div class="skel-thumb"></div>
							</div>
						))}
					</div>
					<div class="side-skel"></div>
				</div>
			</FilmsFeed>
		</div>
	</div>

	{isOwner && (
		<EntryEditor
			mode="select"
			venueOptions={venueOptions}
			tagOptions={tagOptions}
			friendOptions={friendOptions}
			redirect="/films"
		/>
	)}

	<style>
		.page {
			min-height: 100vh;
			background: #2a1214;
			display: flex;
			justify-content: center;
			overflow-x: hidden;
		}
		.card {
			width: 100%;
			max-width: 1120px;
			display: flex;
			flex-direction: column;
		}

		/* Owner/login buttons carried in SiteHeader's actions slot. */
		.nav-btn {
			white-space: nowrap;
			font-size: 13px;
			font-weight: 700;
			border-radius: 8px;
			padding: 8px 16px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
		}
		.nav-btn--log {
			color: #2a1214;
			background: #d9b45a;
			border: none;
		}
		.nav-btn--log:hover {
			background: #f0d488;
		}

		/* Skeleton shown while the FilmsFeed island streams in. Mirrors the feed's
		   two-column geometry so the shell doesn't reflow when it arrives. */
		.shell-skel {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 288px;
		}
		.feed-skel {
			padding: 38px 40px 44px;
		}
		.side-skel {
			background: #2a1214;
			border-left: 1px solid #4a2529;
		}
		.skel-item {
			display: flex;
			gap: 20px;
			align-items: flex-start;
			padding: 16px 0 18px;
			border-bottom: 1px solid #402226;
		}
		.skel-body {
			flex: 1;
			min-width: 0;
		}
		.skel-thumb {
			flex: none;
			width: 46px;
			height: 69px;
			border: 1px solid #4a2529;
			background: #351a1d;
		}
		.skel-line {
			height: 11.5px;
			border-radius: 2px;
			background: #402226;
			animation: skel-pulse 1.4s ease-in-out infinite;
		}
		.skel-line--meta {
			width: 38%;
			margin-bottom: 8px;
		}
		.skel-line--title {
			width: 72%;
			height: 21px;
			margin-bottom: 8px;
		}
		.skel-line--note {
			width: 90%;
		}
		@keyframes skel-pulse {
			0%,
			100% {
				opacity: 1;
			}
			50% {
				opacity: 0.45;
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.skel-line {
				animation: none;
			}
		}
		@media (max-width: 720px) {
			.shell-skel {
				grid-template-columns: 1fr;
			}
			.side-skel {
				display: none;
			}
			.feed-skel {
				padding: 28px 22px 34px;
			}
		}
	</style>
</FilmLayout>
