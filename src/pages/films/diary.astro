		}
		.row__rewatch {
			font-size: 14px;
			color: #7a5a52;
		}

		/* Composer modal */
		.modal {
			position: fixed;
			inset: 0;
			z-index: 50;
			display: flex;
			align-items: flex-start;
			justify-content: center;
			padding: 56px 24px;
		}
		.modal[hidden] {
			display: none;
		}
		.modal__backdrop {
			position: absolute;
			inset: 0;
			background: rgba(10, 4, 5, 0.72);
			backdrop-filter: blur(3px);
		}
		.modal__panel {
			position: relative;
			width: 100%;
			max-width: 560px;
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 14px;
			box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.7);
			overflow: hidden;
		}
		.modal__head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 20px 24px;
			border-bottom: 1px solid #402226;
		}
		.modal__title {
			font-family: 'Newsreader', serif;
			font-style: italic;
			font-size: 22px;
			color: #f4e8d1;
		}
