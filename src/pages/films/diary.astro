			line-height: 1.5;
			resize: vertical;
		}
		.results {
			list-style: none;
			margin: 6px 0 0;
			padding: 0;
			position: absolute;
			z-index: 10;
			width: 100%;
			max-height: 280px;
			overflow-y: auto;
			background: #1c0d0e;
