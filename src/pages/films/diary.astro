			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		.row__meta {
			display: flex;
			align-items: center;
			gap: 14px;
			justify-content: flex-end;
