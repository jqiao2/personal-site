			padding: 9px 18px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
		}
		.btn-discard:hover {
			background: #e89b70;
		}
		.rating-row {
			display: flex;
			align-items: center;
			gap: 14px;
		}
		.starpicker {
			position: relative;
			display: inline-block;
			line-height: 1;
			font-size: 26px;
			cursor: pointer;
			user-select: none;
		}
		.sp-empty {
			color: #4a2529;
		}
		.sp-fill {
			position: absolute;
			top: 0;
			left: 0;
			width: 0;
			overflow: hidden;
			white-space: nowrap;
			color: #d9b45a;
			pointer-events: none;
		}
		.sp-fill::before {
			content: '★★★★★';
		}
		.sp-hits {
			position: absolute;
			inset: 0;
			display: flex;
		}
		.sp-hits :global(span) {
			flex: 1;
		}
		.rating-label {
			font-size: 13px;
			color: #a2857a;
		}
		.toggles {
			display: flex;
			gap: 10px;
		}
		.toggle {
			font-size: 13px;
			font-weight: 600;
			border-radius: 20px;
			padding: 9px 16px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			background: transparent;
			color: #ddc9b4;
			border: 1px solid #4a2529;
		}
		.toggle.on {
			background: #d9b45a;
			color: #2a1214;
			border-color: #d9b45a;
		}
		.mediums {
			display: flex;
			gap: 8px;
			flex-wrap: wrap;
		}
		.theater-fields {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 12px;
			margin-top: 12px;
		}
		.theater-fields[hidden],
		.other-field[hidden] {
			display: none;
		}
		.other-field {
			margin-top: 12px;
		}
		#c-venue,
		#c-format,
		#c-other {
			width: 100%;
			background: #1c0d0e;
			border: 1px solid #4a2529;
			border-radius: 8px;
			color: #f4e8d1;
			font-family: 'Archivo', sans-serif;
			font-size: 14px;
			padding: 11px 13px;
			outline: none;
		}
		#c-venue:focus,
		#c-format:focus,
		#c-other:focus {
			border-color: #d9b45a;
		}

		/* Tags field: input + autocomplete dropdown (opens upward) + chips */
		.tags-field {
			position: relative;
		}
		#c-tag-input {
			width: 100%;
			background: #1c0d0e;
			border: 1px solid #4a2529;
			border-radius: 8px;
			color: #f4e8d1;
			font-family: 'Archivo', sans-serif;
			font-size: 14px;
			padding: 11px 13px;
			outline: none;
		}
		#c-tag-input:focus {
			border-color: #d9b45a;
		}
		.tag-suggest {
			list-style: none;
			margin: 0;
			padding: 0;
			position: absolute;
			bottom: 100%;
			left: 0;
			right: 0;
			margin-bottom: 6px;
			z-index: 10;
			max-height: 200px;
			overflow-y: auto;
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 8px;
			box-shadow: 0 -18px 40px -14px rgba(0, 0, 0, 0.7);
		}
		.tag-suggest[hidden] {
			display: none;
		}
		.tag-suggest :global(li) {
			padding: 9px 13px;
			cursor: pointer;
			font-size: 14px;
			color: #f2e5cd;
			border-bottom: 1px solid #351a1d;
		}
		.tag-suggest :global(li:last-child) {
			border-bottom: none;
		}
		.tag-suggest :global(li:hover),
		.tag-suggest :global(li.active) {
			background: #331619;
		}
		.tag-chips {
			display: flex;
			gap: 7px;
			flex-wrap: wrap;
			margin-top: 10px;
		}
		.tag-chips[hidden] {
			display: none;
		}
		.tag-chips :global(.tag-chip) {
			display: inline-flex;
			align-items: center;
			gap: 7px;
			font-size: 12px;
			color: #ddc9b4;
			border: 1px solid #4a2529;
			border-radius: 20px;
			padding: 4px 8px 4px 12px;
			background: #241012;
		}
		.tag-chips :global(.tag-chip button) {
			background: none;
			border: none;
			cursor: pointer;
			color: #a2857a;
			font-size: 13px;
			line-height: 1;
			padding: 0;
			font-family: 'Archivo', sans-serif;
		}
		.tag-chips :global(.tag-chip button:hover) {
			color: #f4e8d1;
		}
		.modal__foot {
			display: flex;
			align-items: center;
			justify-content: flex-end;
			gap: 12px;
			padding: 16px 24px;
			border-top: 1px solid #402226;
			background: #1f0e10;
		}
		.btn-ghost {
			font-size: 14px;
			font-weight: 600;
			color: #ddc9b4;
			background: transparent;
			border: 1px solid #4a2529;
			border-radius: 8px;
			padding: 10px 20px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
		}
		.btn-ghost:hover {
			border-color: #a2857a;
			color: #f4e8d1;
		}
		.btn-save {
			font-size: 14px;
			font-weight: 700;
			border: none;
			border-radius: 8px;
			padding: 10px 22px;
			font-family: 'Archivo', sans-serif;
			background: #d9b45a;
			color: #2a1214;
			cursor: pointer;
		}
		.btn-save:disabled {
			background: #4a2529;
			color: #8a6f63;
			cursor: not-allowed;
		}
		.save-msg {
			font-size: 13px;
			color: #a2857a;
			margin-right: auto;
		}
		.save-msg.error {
			color: #e0736f;
		}

		@media (max-width: 640px) {
			h1 {
				font-size: 40px;
			}
			.row {
				grid-template-columns: 44px 40px 1fr auto;
				gap: 12px;
			}
			.field-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>

	<script>
		// Owner-only composer. Astro always hoists this script; bail out when the
		// modal isn't in the DOM (non-owner viewing the diary).
		const openBtn = document.getElementById('open-composer');
		const modal = document.getElementById('composer') as HTMLDivElement | null;

		if (openBtn && modal) {
			const IMG = 'https://image.tmdb.org/t/p/w92';
			const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
			const close = $('composer-close');
			const cancel = $('composer-cancel');
			const backdrop = $('composer-backdrop');
			const save = $<HTMLButtonElement>('composer-save');
			const msg = $<HTMLSpanElement>('save-msg');
			const q = $<HTMLInputElement>('c-q');
			const results = $<HTMLUListElement>('c-results');
			const searchWrap = $('c-search');
			const selected = $('c-selected');
			const selPoster = $<HTMLImageElement>('c-sel-poster');
			const selTitle = $<HTMLSpanElement>('c-sel-title');
			const selYear = $<HTMLSpanElement>('c-sel-year');
			const priorHint = $<HTMLDivElement>('c-prior');
			const change = $('c-change');
			const dateInput = $<HTMLInputElement>('c-date');
			const reviewInput = $<HTMLTextAreaElement>('c-review');
			const likeBtn = $<HTMLButtonElement>('c-like');
			const rewatchBtn = $<HTMLButtonElement>('c-rewatch');
			const fill = $<HTMLSpanElement>('sp-fill');
			const hits = $<HTMLSpanElement>('sp-hits');
			const ratingLabel = $<HTMLSpanElement>('rating-label');
			const discard = $<HTMLDivElement>('discard');
			const discardKeep = $('discard-keep');
			const discardConfirm = $('discard-confirm');
			const mediums = $<HTMLDivElement>('c-mediums');
			const theaterFields = $<HTMLDivElement>('c-theater-fields');
			const otherField = $<HTMLDivElement>('c-other-field');
			const venueInput = $<HTMLInputElement>('c-venue');
			const formatInput = $<HTMLInputElement>('c-format');
			const otherInput = $<HTMLInputElement>('c-other');
			const tagInput = $<HTMLInputElement>('c-tag-input');
			const tagSuggest = $<HTMLUListElement>('c-tag-suggest');
			const tagChipsBox = $<HTMLDivElement>('c-tag-chips');
			const tagOptions = Array.from(
				document.querySelectorAll<HTMLOptionElement>('#tag-options option'),
			).map((o) => o.value);
			const mediumBtns = Array.from(
				mediums.querySelectorAll<HTMLButtonElement>('button[data-medium]'),
			);
			const defaultDate = dateInput.value;

			let tmdbId: number | null = null;
			let rating: number | null = null;
			let liked = false;
			let rewatch = false;
			let medium: string | null = null; // 'theater'|'tv'|'computer'|'plane'|'other'|null
			let tags: string[] = [];

			// --- TMDB search (debounced) ---
			let timer: number | undefined;
			q.addEventListener('input', () => {
				window.clearTimeout(timer);
				const query = q.value.trim();
				if (!query) return hideResults();
				timer = window.setTimeout(() => runSearch(query), 300);
			});
			async function runSearch(query: string) {
				try {
					const res = await fetch(`/api/tmdb/search?query=${encodeURIComponent(query)}`);
					if (!res.ok) return hideResults();
					const data = await res.json();
					renderResults(data.results ?? []);
				} catch {
					hideResults();
				}
			}
			function renderResults(items: any[]) {
				results.textContent = '';
				if (!items.length) return hideResults();
				for (const m of items.slice(0, 8)) {
					const li = document.createElement('li');
					const img = document.createElement('img');
					if (m.poster_path) img.src = IMG + m.poster_path;
					img.alt = '';
					const label = document.createElement('span');
					label.textContent = m.title;
					if (m.release_date) {
						const yr = document.createElement('span');
						yr.className = 'r-year';
						yr.textContent = m.release_date.slice(0, 4);
						label.appendChild(yr);
					}
					li.append(img, label);
					li.addEventListener('click', () => selectMovie(m));
					results.appendChild(li);
				}
				results.hidden = false;
			}
			function hideResults() {
				results.hidden = true;
				results.textContent = '';
			}
			function selectMovie(m: any) {
				tmdbId = m.id;
				selTitle.textContent = m.title;
				selYear.textContent = m.release_date ? m.release_date.slice(0, 4) : '';
				if (m.poster_path) {
					selPoster.src = IMG + m.poster_path;
					selPoster.hidden = false;
				} else {
					selPoster.removeAttribute('src');
					selPoster.hidden = true;
				}
				hideResults();
				searchWrap.hidden = true;
				selected.hidden = false;
				save.disabled = false;
				// A film's rating/like/rewatch is film-specific — start each entry
				// clean, then let the prior-watch lookup suggest a rewatch.
				resetEntryFields();
				loadPrior(m.id);
			}
			// Clear rating / like / rewatch / prior hint, keeping film + date + review.
			function resetEntryFields() {
				rating = null;
				setFill(0);
				ratingLabel.textContent = 'Not rated';
				liked = false;
				likeBtn.classList.remove('on');
				rewatch = false;
				rewatchBtn.classList.remove('on');
				priorHint.hidden = true;
				priorHint.textContent = '';
			}
			// Look up whether this film was watched before; if so, suggest a rewatch
			// and pre-fill the previous rating/like. Guarded against a stale response
			// when the user switches films mid-request.
			async function loadPrior(id: number) {
				try {
					const res = await fetch(`/api/films/prior-watch?tmdbId=${id}`);
					if (!res.ok) return;
					const prior = await res.json();
					if (tmdbId !== id || !prior.watched) return;
					rewatch = true;
					rewatchBtn.classList.add('on');
					if (prior.rating != null) {
						rating = prior.rating;
						setFill(rating);
						ratingLabel.textContent = labelFor(rating);
					}
					liked = Boolean(prior.liked);
					likeBtn.classList.toggle('on', liked);
					const n = prior.logCount;
					priorHint.textContent =
						n > 0
							? `Logged ${n} time${n === 1 ? '' : 's'} before — marked as a rewatch.`
							: `You've watched this before — marked as a rewatch.`;
					priorHint.hidden = false;
				} catch {
					/* network hiccup — leave the entry clean */
				}
			}
			change.addEventListener('click', () => {
				tmdbId = null;
				selected.hidden = true;
				searchWrap.hidden = false;
				save.disabled = true;
				q.value = '';
				resetEntryFields();
				q.focus();
			});
			document.addEventListener('click', (e) => {
				if (!searchWrap.contains(e.target as Node)) hideResults();
			});

			// --- Half-star picker (10 hotspots over 5 stars) ---
			const setFill = (value: number) => {
				fill.style.width = `${(value / 5) * 100}%`;
			};
			const labelFor = (v: number) =>
				v === 0 ? 'Not rated' : `${Math.floor(v)}${v % 1 ? '½' : ''}★`;
			for (let i = 1; i <= 10; i++) {
				const hit = document.createElement('span');
				const value = i / 2;
				hit.addEventListener('mousemove', () => {
					setFill(value);
					ratingLabel.textContent = labelFor(value);
				});
				hit.addEventListener('click', () => {
					rating = value;
					setFill(value);
					ratingLabel.textContent = labelFor(value);
				});
				hits.appendChild(hit);
			}
			hits.addEventListener('mouseleave', () => {
				setFill(rating ?? 0);
				ratingLabel.textContent = labelFor(rating ?? 0);
			});

			likeBtn.addEventListener('click', () => {
				liked = !liked;
				likeBtn.classList.toggle('on', liked);
			});
			rewatchBtn.addEventListener('click', () => {
				rewatch = !rewatch;
				rewatchBtn.classList.toggle('on', rewatch);
			});

			// --- Medium picker (single-select; click active to deselect) ---
			function renderMedium() {
				for (const b of mediumBtns) b.classList.toggle('on', b.dataset.medium === medium);
				theaterFields.hidden = medium !== 'theater';
				otherField.hidden = medium !== 'other';
			}
			for (const b of mediumBtns) {
				b.addEventListener('click', () => {
					const m = b.dataset.medium ?? null;
					medium = medium === m ? null : m;
					renderMedium();
				});
			}

			// --- Tags (chips + autocomplete over known tags) ---
			let tagActive = -1; // keyboard-highlighted suggestion, -1 = none
			function renderChips() {
				tagChipsBox.textContent = '';
				tags.forEach((t, i) => {
					const chip = document.createElement('span');
					chip.className = 'tag-chip';
					chip.append(t);
					const x = document.createElement('button');
					x.type = 'button';
					x.setAttribute('aria-label', `Remove ${t}`);
					x.textContent = '✕';
					x.addEventListener('click', () => removeTag(i));
					chip.appendChild(x);
					tagChipsBox.appendChild(chip);
				});
				tagChipsBox.hidden = tags.length === 0;
			}
			function removeTag(i: number) {
				tags.splice(i, 1);
				renderChips();
				renderTagSuggest();
			}
			function commitTag(raw: string) {
				const name = raw.trim();
				if (name && !tags.some((t) => t.toLowerCase() === name.toLowerCase())) tags.push(name);
				tagInput.value = '';
				renderChips();
				renderTagSuggest();
			}
			function tagCandidates(): string[] {
				const token = tagInput.value.trim().toLowerCase();
				const used = new Set(tags.map((t) => t.toLowerCase()));
				return tagOptions
					.filter((t) => !used.has(t.toLowerCase()))
					.filter((t) => !token || t.toLowerCase().includes(token))
					.slice(0, 6);
			}
			function renderTagSuggest() {
				const items = tagCandidates();
				tagSuggest.textContent = '';
				tagActive = -1;
				if (!items.length) {
					tagSuggest.hidden = true;
					return;
				}
				for (const t of items) {
					const li = document.createElement('li');
					li.textContent = t;
					li.addEventListener('mousedown', (e) => {
						e.preventDefault();
						commitTag(t);
					});
					tagSuggest.appendChild(li);
				}
				tagSuggest.hidden = false;
			}
			tagInput.addEventListener('input', renderTagSuggest);
			tagInput.addEventListener('focus', renderTagSuggest);
			tagInput.addEventListener('blur', () => {
				tagSuggest.hidden = true;
			});
			tagInput.addEventListener('keydown', (e) => {
				const lis = Array.from(tagSuggest.querySelectorAll('li'));
				if (e.key === 'Enter') {
					e.preventDefault();
					if (tagActive >= 0 && lis[tagActive]) commitTag(lis[tagActive].textContent || '');
					else commitTag(tagInput.value);
				} else if (e.key === 'ArrowDown' && lis.length) {
					e.preventDefault();
					tagActive = (tagActive + 1) % lis.length;
					lis.forEach((li, i) => li.classList.toggle('active', i === tagActive));
				} else if (e.key === 'ArrowUp' && lis.length) {
					e.preventDefault();
					tagActive = (tagActive - 1 + lis.length) % lis.length;
					lis.forEach((li, i) => li.classList.toggle('active', i === tagActive));
				} else if (e.key === 'Backspace' && !tagInput.value && tags.length) {
					removeTag(tags.length - 1);
				}
			});

			// The film selection is intentionally excluded from the dirty check —
			// picking a film alone isn't "work worth confirming"; a rating, like,
			// rewatch flag, or review text is.
			const isDirty = () =>
				(rating ?? 0) > 0 ||
				liked ||
				rewatch ||
				medium != null ||
				tags.length > 0 ||
				reviewInput.value.trim().length > 0;

			const resetForm = () => {
				tmdbId = null;
				rating = null;
				liked = false;
				rewatch = false;
				medium = null;
				tags = [];
				q.value = '';
				reviewInput.value = '';
				venueInput.value = '';
				formatInput.value = '';
				otherInput.value = '';
				tagInput.value = '';
				renderChips();
				tagSuggest.hidden = true;
				dateInput.value = defaultDate;
				likeBtn.classList.remove('on');
				rewatchBtn.classList.remove('on');
				renderMedium();
				selected.hidden = true;
				searchWrap.hidden = false;
				save.disabled = true;
				setFill(0);
				ratingLabel.textContent = 'Not rated';
				priorHint.hidden = true;
				priorHint.textContent = '';
				msg.className = 'save-msg';
				msg.textContent = '';
				hideResults();
			};

			const closeModal = () => {
				modal.hidden = true;
				discard.hidden = true;
				resetForm();
			};
			const attemptClose = () => {
				if (isDirty()) discard.hidden = false;
				else closeModal();
			};

			openBtn.addEventListener('click', () => {
				modal.hidden = false;
			});
			close.addEventListener('click', attemptClose);
			cancel.addEventListener('click', attemptClose);
			backdrop.addEventListener('click', attemptClose);
			discardKeep.addEventListener('click', () => {
				discard.hidden = true;
			});
			discardConfirm.addEventListener('click', closeModal);
			document.addEventListener('keydown', (e) => {
				if (e.key !== 'Escape' || modal.hidden) return;
				if (!discard.hidden) discard.hidden = true;
				else attemptClose();
			});

			save.addEventListener('click', async () => {
				if (!tmdbId) return;
				save.disabled = true;
				msg.className = 'save-msg';
				msg.textContent = 'Saving…';
				try {
					// medium: 'other' sends the free-text value; theater carries venue+format.
					const outMedium =
						medium === 'other' ? otherInput.value.trim() || null : medium;
					const res = await fetch('/api/films/logs', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({
							tmdbId,
							watchedDate: dateInput.value || null,
							rating,
							reviewText: reviewInput.value,
							rewatched: rewatch,
							liked,
							tags,
							medium: outMedium,
							venue: medium === 'theater' ? venueInput.value.trim() || null : null,
							format: medium === 'theater' ? formatInput.value.trim() || null : null,
						}),
					});
					if (res.status === 401) {
						window.location.href = '/films/login?redirect=/films/diary';
						return;
					}
					const data = await res.json();
					if (!res.ok) throw new Error(data.error || 'Save failed');
					window.location.reload();
				} catch (err) {
					msg.className = 'save-msg error';
					msg.textContent = err instanceof Error ? err.message : 'Save failed';
					save.disabled = false;
				}
			});
		}
	</script>
</FilmLayout>
