---
import FilmLayout from '../../layouts/FilmLayout.astro';
import EntryEditor from '../../components/EntryEditor.astro';
import { listLogs, getFilmLogStats, listTheaterNames, listTags, listFriends } from '../../lib/films';
import { requireOwner } from '../../lib/auth';
import { starText } from '../../lib/format';
import { imageUrl } from '../../lib/tmdb';

// Rendered on demand — reflects the live database.
export const prerender = false;

/** Logs per page. The first batch is server-rendered; the rest are fetched from
 * /api/films/logs as you scroll (that route caps `limit` at 100). */
const BATCH = 100;

const [logs, stats, isOwner] = await Promise.all([
	listLogs(BATCH),
	getFilmLogStats(),
	requireOwner(Astro.cookies),
]);

// A short first page means we already have everything — no sentinel, no fetching.
const hasMore = logs.length === BATCH;

// Composer autocomplete (owner only): known theaters, tags and friends.
const [venueOptions, tagOptions, friendOptions] = isOwner
	? await Promise.all([listTheaterNames(), listTags(), listFriends()])
	: [[], [], []];

function parseDate(date: string | null): Date | null {
	if (!date) return null;
	const [y, m, d] = date.slice(0, 10).split('-').map(Number);
	if (!y || !m || !d) return null;
	return new Date(y, m - 1, d);
}
interface Row {
	logId: number;
	day: number;
	weekday: string;
	title: string;
	year: number | null;
	poster: string | null;
	tmdbId: number;
	stars: string;
	review: string | null;
	liked: boolean;
	rewatched: boolean;
}

// Group logs into months, preserving the (newest-first) order.
const months: { label: string; items: Row[] }[] = [];
const byLabel = new Map<string, Row[]>();
for (const log of logs) {
	const dt = parseDate(log.watched_date) ?? parseDate(log.created_at);
	const label = dt
		? dt.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
		: 'Undated';
	if (!byLabel.has(label)) {
		const items: Row[] = [];
		byLabel.set(label, items);
		months.push({ label, items });
	}
	byLabel.get(label)!.push({
		logId: log.id,
		day: dt ? dt.getDate() : 0,
		weekday: dt ? dt.toLocaleDateString('en-US', { weekday: 'short' }) : '',
		title: log.title,
		year: log.release_year,
		poster: imageUrl(log.poster_path, 'w154'),
		tmdbId: log.tmdb_id,
		stars: starText(log.rating) ?? '',
		review: log.review_text,
		liked: log.liked,
		rewatched: log.rewatched,
	});
}
const num = (n: number) => n.toLocaleString('en-US');
---

<FilmLayout title="Film diary — Jason's film log">
	<div class="page">
		<div class="wrap">
			<header class="topbar">
				<a class="back" href="/films">
					<span class="back__arrow">←</span><span>Jason's film log</span>
				</a>
				<span class="topbar__tag">Diary</span>
			</header>

			<div class="titleblock">
				<div class="titleblock__left">
					<h1>Film diary</h1>
					{isOwner && (
						<button type="button" class="log-btn" data-open-entry-editor>+ Log film</button>
					)}
				</div>
				<div class="titleblock__stats">
					<div class="stat">
						<div class="stat__n">{num(stats.diary)}</div>
						<div class="stat__l">films logged</div>
					</div>
					<div class="stat">
						<div class="stat__n">{num(stats.thisYear)}</div>
						<div class="stat__l">this year</div>
					</div>
				</div>
			</div>

			{months.length === 0 && <p class="empty">No films logged yet.</p>}

			<div id="months">
				{months.map((m) => (
					<section class="month" data-month={m.label}>
						<div class="month__label">{m.label}</div>
						{m.items.map((f) => (
							<a class="row" href={`/films/diary/${f.logId}`}>
								<div class="row__date">
									<div class="row__day">{f.day || '·'}</div>
									<div class="row__wd">{f.weekday}</div>
								</div>
								<div class="row__poster">
									{f.poster && <img src={f.poster} alt="" loading="lazy" />}
								</div>
								<div class="row__body">
									<div class="row__title">
										{f.title} <span class="row__year">{f.year}</span>
									</div>
									{f.review && <div class="row__review">{f.review}</div>}
								</div>
								<div class="row__meta">
									<span class="row__stars">{f.stars}</span>
									{f.liked && <span class="row__like">♥</span>}
									{f.rewatched && <span class="row__rewatch">↻</span>}
								</div>
							</a>
						))}
					</section>
				))}
			</div>

			{hasMore && (
				<div id="sentinel" data-batch={BATCH} data-offset={logs.length}>
					<span class="sentinel__spinner" aria-hidden="true"></span>
					<span class="sentinel__text">Loading more…</span>
				</div>
			)}
			<p id="load-error" class="load-error" hidden>
				Couldn't load more entries. <button type="button" id="retry">Retry</button>
			</p>
		</div>
	</div>

	{isOwner && (
		<EntryEditor
			mode="select"
			venueOptions={venueOptions}
			tagOptions={tagOptions}
			friendOptions={friendOptions}
			redirect="/films/diary"
		/>
	)}

	<style>
		.page {
			display: flex;
			justify-content: center;
			padding: 0 24px 80px;
		}
		.wrap {
			width: 100%;
			max-width: 900px;
		}
		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 26px 0 22px;
			border-bottom: 1px solid #4a2529;
			margin-bottom: 34px;
		}
		.back {
			display: flex;
			align-items: center;
			gap: 9px;
			font-size: 13px;
			color: #a2857a;
		}
		.back:hover {
			color: #f4e8d1;
		}
		.back__arrow {
			font-size: 15px;
		}
		.topbar__tag {
			font-size: 11.5px;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #8a6f63;
		}

		.titleblock {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			margin-bottom: 38px;
			flex-wrap: wrap;
			gap: 14px;
		}
		.titleblock__left {
			display: flex;
			align-items: center;
			gap: 20px;
		}
		h1 {
			font-family: 'Newsreader', serif;
			font-weight: 500;
			font-size: 52px;
			color: #f4e8d1;
			letter-spacing: -0.5px;
			line-height: 1;
			margin: 0;
		}
		.log-btn {
			font-size: 13px;
			font-weight: 700;
			color: #2a1214;
			background: #d9b45a;
			border: none;
			border-radius: 8px;
			padding: 10px 18px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
		}
		.log-btn:hover {
			background: #f0d488;
		}
		.titleblock__stats {
			display: flex;
			gap: 26px;
		}
		.stat__n {
			font-family: 'Newsreader', serif;
			font-size: 26px;
			color: #d9b45a;
		}
		.stat__l {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
			margin-top: 2px;
		}
		.empty {
			color: #8a6f63;
		}

		.month {
			margin-bottom: 40px;
		}
		.month__label {
			font-family: 'Newsreader', serif;
			font-style: italic;
			font-size: 20px;
			color: #ecdcbd;
			padding-bottom: 10px;
			border-bottom: 1px solid #402226;
			margin-bottom: 6px;
		}
		.row {
			display: grid;
			grid-template-columns: 56px 46px 1fr auto;
			gap: 18px;
			align-items: center;
			padding: 14px 10px;
			border-bottom: 1px solid #351a1d;
			border-radius: 6px;
			color: inherit;
		}
		.row:hover {
			background: #331619;
		}
		.row__date {
			text-align: center;
		}
		.row__day {
			font-family: 'Newsreader', serif;
			font-size: 28px;
			color: #f4e8d1;
			line-height: 1;
		}
		.row__wd {
			font-size: 10.5px;
			text-transform: uppercase;
			letter-spacing: 1px;
			color: #8a6f63;
			margin-top: 3px;
		}
		.row__poster {
			width: 46px;
			height: 69px;
			border-radius: 4px;
			overflow: hidden;
			background-image: repeating-linear-gradient(135deg, #351a1d 0 8px, #2c1518 8px 16px);
			border: 1px solid #4a2529;
		}
		.row__poster img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.row__body {
			min-width: 0;
		}
		.row__title {
			font-family: 'Newsreader', serif;
			font-size: 18px;
			color: #f2e5cd;
			line-height: 1.2;
		}
		.row__year {
			color: #b0917f;
			font-style: italic;
			font-size: 15px;
		}
		.row__review {
			font-size: 13px;
			color: #a2857a;
			margin-top: 5px;
			line-height: 1.4;
			display: -webkit-box;
			-webkit-line-clamp: 1;
			-webkit-box-orient: vertical;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		.row__meta {
			display: flex;
			align-items: center;
			gap: 14px;
			justify-content: flex-end;
		}
		.row__stars {
			color: #d9b45a;
			font-size: 15px;
			letter-spacing: 1px;
			white-space: nowrap;
		}
		.row__like {
			font-size: 15px;
			color: #d9b45a;
		}
		.row__rewatch {
			font-size: 14px;
			color: #7a5a52;
		}

		#sentinel {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 10px;
			padding: 18px 0 40px;
			font-size: 12px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
		}
		.sentinel__spinner {
			width: 12px;
			height: 12px;
			border: 2px solid #4a2529;
			border-top-color: #d9b45a;
			border-radius: 50%;
			animation: spin 0.7s linear infinite;
		}
		@keyframes spin {
			to {
				transform: rotate(360deg);
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.sentinel__spinner {
				animation: none;
			}
		}
		.load-error {
			padding: 18px 0 40px;
			text-align: center;
			font-size: 13px;
			color: #a2857a;
		}
		.load-error button {
			font: inherit;
			color: #d9b45a;
			background: none;
			border: none;
			padding: 0;
			cursor: pointer;
			text-decoration: underline;
		}

		@media (max-width: 640px) {
			h1 {
				font-size: 40px;
			}
			.row {
				grid-template-columns: 44px 40px 1fr auto;
				gap: 12px;
			}
		}
	</style>

	<script>
		import { starText } from '../../lib/format';

		interface DiaryLog {
			id: number;
			watched_date: string | null;
			created_at: string;
			rating: number | null;
			review_text: string | null;
			rewatched: boolean;
			liked: boolean;
			title: string;
			release_year: number | null;
			poster_path: string | null;
		}

		const sentinel = document.getElementById('sentinel');
		const months = document.getElementById('months');

		if (sentinel && months) {
			const errorBox = document.getElementById('load-error')!;
			const retry = document.getElementById('retry')!;
			const BATCH = Number(sentinel.dataset.batch);

			let offset = Number(sentinel.dataset.offset);
			let loading = false;
			let done = false;

			// Mirrors the server-side row rendering above — same markup, same date and
			// star formatting, so an appended batch is indistinguishable from the first.
			function parseDate(date: string | null): Date | null {
				if (!date) return null;
				const [y, m, d] = date.slice(0, 10).split('-').map(Number);
				if (!y || !m || !d) return null;
				return new Date(y, m - 1, d);
			}
			// Astro scopes this page's CSS behind a generated data-astro-cid-* attribute,
			// so every node we build has to carry it or it renders unstyled. Read the
			// name off a server-rendered element rather than hard-coding the hash, which
			// changes whenever this file does.
			const scopeAttr = Array.from(months.attributes)
				.map((a) => a.name)
				.find((n) => n.startsWith('data-astro-cid-'));

			function el(tag: string, className?: string, text?: string): HTMLElement {
				const node = document.createElement(tag);
				if (scopeAttr) node.setAttribute(scopeAttr, '');
				if (className) node.className = className;
				if (text != null) node.textContent = text;
				return node;
			}

			function buildRow(log: DiaryLog): HTMLAnchorElement {
				const dt = parseDate(log.watched_date) ?? parseDate(log.created_at);

				const row = el('a', 'row') as HTMLAnchorElement;
				row.href = `/films/diary/${log.id}`;

				const date = el('div', 'row__date');
				date.append(
					el('div', 'row__day', dt ? String(dt.getDate()) : '·'),
					el('div', 'row__wd', dt ? dt.toLocaleDateString('en-US', { weekday: 'short' }) : ''),
				);

				const poster = el('div', 'row__poster');
				if (log.poster_path) {
					const img = el('img') as HTMLImageElement;
					img.src = `https://image.tmdb.org/t/p/w154${log.poster_path}`;
					img.alt = '';
					img.loading = 'lazy';
					poster.append(img);
				}

				const body = el('div', 'row__body');
				const title = el('div', 'row__title', `${log.title} `);
				title.append(el('span', 'row__year', log.release_year == null ? '' : String(log.release_year)));
				body.append(title);
				if (log.review_text) body.append(el('div', 'row__review', log.review_text));

				const meta = el('div', 'row__meta');
				meta.append(el('span', 'row__stars', starText(log.rating) ?? ''));
				if (log.liked) meta.append(el('span', 'row__like', '♥'));
				if (log.rewatched) meta.append(el('span', 'row__rewatch', '↻'));

				row.append(date, poster, body, meta);
				return row;
			}

			/** Append a batch, continuing the trailing month section when the label matches. */
			function render(logs: DiaryLog[]) {
				for (const log of logs) {
					const dt = parseDate(log.watched_date) ?? parseDate(log.created_at);
					const label = dt
						? dt.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
						: 'Undated';

					let section = months!.lastElementChild as HTMLElement | null;
					if (!section || section.dataset.month !== label) {
						section = el('section', 'month');
						section.dataset.month = label;
						section.append(el('div', 'month__label', label));
						months!.append(section);
					}
					section.append(buildRow(log));
				}
			}

			function finish() {
				done = true;
				observer.disconnect();
				sentinel!.remove();
			}

			async function loadMore() {
				if (loading || done) return;
				loading = true;
				errorBox.hidden = true;
				try {
					const res = await fetch(`/api/films/logs?limit=${BATCH}&offset=${offset}`);
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					const { logs } = (await res.json()) as { logs: DiaryLog[] };
					render(logs);
					offset += logs.length;
					// A short batch is the last one.
					if (logs.length < BATCH) {
						finish();
					} else {
						// The observer only fires on a crossing, so re-observe to re-check the
						// sentinel: a batch too short to push it out of view still loads on.
						observer.unobserve(sentinel!);
						observer.observe(sentinel!);
					}
				} catch (e) {
					// Leave the observer parked so a failure can't hot-loop the API; the
					// retry button is the way back.
					console.error('diary: failed to load more logs', e);
					errorBox.hidden = false;
				} finally {
					loading = false;
				}
			}

			// Start fetching a screenful early so scrolling stays continuous.
			const observer = new IntersectionObserver(
				(entries) => {
					if (entries.some((entry) => entry.isIntersecting)) loadMore();
				},
				{ rootMargin: '600px' },
			);
			observer.observe(sentinel);
			retry.addEventListener('click', loadMore);
		}
	</script>
</FilmLayout>
