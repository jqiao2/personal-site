---
import FilmLayout from '../../layouts/FilmLayout.astro';
import { listLogs, getFilmLogStats, listTheaterNames, listTags } from '../../lib/films';
import { requireOwner } from '../../lib/auth';
import { imageUrl } from '../../lib/tmdb';

// Rendered on demand — reflects the live database.
export const prerender = false;

const [logs, stats, isOwner] = await Promise.all([
	listLogs(120),
	getFilmLogStats(),
	requireOwner(Astro.cookies),
]);

// Composer autocomplete (owner only): known theaters, canonical formats, tags.
const [venueOptions, tagOptions] = isOwner
	? await Promise.all([listTheaterNames(), listTags()])
	: [[], []];
const formatOptions = [
	'Digital',
	'35mm',
	'70mm',
	'IMAX',
	'IMAX 70mm',
	'IMAX 3D',
	'3D',
	'Dolby Cinema',
	'VistaVision',
	'DCP',
];

function parseDate(date: string | null): Date | null {
	if (!date) return null;
	const [y, m, d] = date.slice(0, 10).split('-').map(Number);
	if (!y || !m || !d) return null;
	return new Date(y, m - 1, d);
}
function starText(r: number | null): string {
	if (r == null) return '';
	return '★'.repeat(Math.floor(r)) + (r % 1 >= 0.5 ? '½' : '');
}

interface Row {
	logId: number;
	day: number;
	weekday: string;
	title: string;
	year: number | null;
	poster: string | null;
	tmdbId: number;
	stars: string;
	review: string | null;
	liked: boolean;
	rewatched: boolean;
}

// Group logs into months, preserving the (newest-first) order.
const months: { label: string; items: Row[] }[] = [];
const byLabel = new Map<string, Row[]>();
for (const log of logs) {
	const dt = parseDate(log.watched_date) ?? parseDate(log.created_at);
	const label = dt
		? dt.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
		: 'Undated';
	if (!byLabel.has(label)) {
		const items: Row[] = [];
		byLabel.set(label, items);
		months.push({ label, items });
	}
	byLabel.get(label)!.push({
		logId: log.id,
		day: dt ? dt.getDate() : 0,
		weekday: dt ? dt.toLocaleDateString('en-US', { weekday: 'short' }) : '',
		title: log.title,
		year: log.release_year,
		poster: imageUrl(log.poster_path, 'w154'),
		tmdbId: log.tmdb_id,
		stars: starText(log.rating),
		review: log.review_text,
		liked: log.liked,
		rewatched: log.rewatched,
	});
}
const num = (n: number) => n.toLocaleString('en-US');
const today = new Date().toISOString().slice(0, 10);
---

<FilmLayout title="Film diary — Jason's film log">
	<div class="page">
		<div class="wrap">
			<header class="topbar">
				<a class="back" href="/films">
					<span class="back__arrow">←</span><span>Jason's film log</span>
				</a>
				<span class="topbar__tag">Diary</span>
			</header>

			<div class="titleblock">
				<div class="titleblock__left">
					<h1>Film diary</h1>
					{isOwner && (
						<button type="button" class="log-btn" id="open-composer">+ Log film</button>
					)}
				</div>
				<div class="titleblock__stats">
					<div class="stat">
						<div class="stat__n">{num(stats.diary)}</div>
						<div class="stat__l">films logged</div>
					</div>
					<div class="stat">
						<div class="stat__n">{num(stats.thisYear)}</div>
						<div class="stat__l">this year</div>
					</div>
				</div>
			</div>

			{months.length === 0 ? (
				<p class="empty">No films logged yet.</p>
			) : (
				months.map((m) => (
					<section class="month">
						<div class="month__label">{m.label}</div>
						{m.items.map((f) => (
							<a class="row" href={`/films/diary/${f.logId}`}>
								<div class="row__date">
									<div class="row__day">{f.day || '·'}</div>
									<div class="row__wd">{f.weekday}</div>
								</div>
								<div class="row__poster">
									{f.poster && <img src={f.poster} alt="" loading="lazy" />}
								</div>
								<div class="row__body">
									<div class="row__title">
										{f.title} <span class="row__year">{f.year}</span>
									</div>
									{f.review && <div class="row__review">{f.review}</div>}
								</div>
								<div class="row__meta">
									<span class="row__stars">{f.stars}</span>
									{f.liked && <span class="row__like">♥</span>}
									{f.rewatched && <span class="row__rewatch">↻</span>}
								</div>
							</a>
						))}
					</section>
				))
			)}
		</div>
	</div>

	{isOwner && (
		<div class="modal" id="composer" hidden>
			<div class="modal__backdrop" id="composer-backdrop"></div>
			<div class="modal__panel" role="dialog" aria-modal="true" aria-label="Log a film">
				<div class="modal__head">
					<span class="modal__title">Log a film</span>
					<button type="button" class="modal__close" id="composer-close" aria-label="Close">✕</button>
				</div>

				<div class="discard" id="discard" hidden>
					<div class="discard__box">
						<div class="discard__title">Discard this entry?</div>
						<div class="discard__msg">Your entry has unsaved changes.</div>
						<div class="discard__actions">
							<button type="button" class="btn-ghost" id="discard-keep">Keep editing</button>
							<button type="button" class="btn-discard" id="discard-confirm">Discard</button>
						</div>
					</div>
				</div>

				<div class="modal__body">
					<div class="field-grid">
						<div>
							<label class="lbl" for="c-q">Film</label>
							<div class="search" id="c-search">
								<input type="text" id="c-q" placeholder="Search a film…" autocomplete="off" />
								<ul class="results" id="c-results" hidden></ul>
							</div>
							<div class="selected" id="c-selected" hidden>
								<div class="selected__poster">
									<img id="c-sel-poster" alt="" />
								</div>
								<div class="selected__info">
									<div class="selected__title">
										<span id="c-sel-title"></span>
										<span class="selected__year" id="c-sel-year"></span>
									</div>
								</div>
								<button type="button" class="selected__change" id="c-change">Change</button>
							</div>
							<div class="prior-hint" id="c-prior" hidden></div>
						</div>
						<div>
							<label class="lbl" for="c-date">Watched</label>
							<input type="date" id="c-date" value={today} />
						</div>
					</div>

					<div>
						<label class="lbl">Rating</label>
						<div class="rating-row">
							<span class="starpicker" id="starpicker">
								<span class="sp-empty">★★★★★</span>
								<span class="sp-fill" id="sp-fill"></span>
								<span class="sp-hits" id="sp-hits"></span>
							</span>
							<span class="rating-label" id="rating-label">Not rated</span>
						</div>
					</div>

					<div class="toggles">
						<button type="button" class="toggle" id="c-like">♥ Like</button>
						<button type="button" class="toggle" id="c-rewatch">↻ Rewatch</button>
					</div>

					<div>
						<label class="lbl">Medium</label>
						<div class="mediums" id="c-mediums">
							<button type="button" class="toggle" data-medium="theater">Theater</button>
							<button type="button" class="toggle" data-medium="tv">TV</button>
							<button type="button" class="toggle" data-medium="computer">Computer</button>
							<button type="button" class="toggle" data-medium="plane">Airplane</button>
							<button type="button" class="toggle" data-medium="other">Other…</button>
						</div>
						<div class="theater-fields" id="c-theater-fields" hidden>
							<div>
								<label class="lbl" for="c-venue">Theater</label>
								<input type="text" id="c-venue" list="venue-options" placeholder="e.g. Metrograph, NYC" autocomplete="off" />
								<datalist id="venue-options">
									{venueOptions.map((v) => (
										<option value={v}></option>
									))}
								</datalist>
							</div>
							<div>
								<label class="lbl" for="c-format">Format</label>
								<input type="text" id="c-format" list="format-options" placeholder="e.g. 35mm, IMAX, 70mm" autocomplete="off" />
								<datalist id="format-options">
									{formatOptions.map((f) => (
										<option value={f}></option>
									))}
								</datalist>
							</div>
						</div>
						<div class="other-field" id="c-other-field" hidden>
							<label class="lbl" for="c-other">Other medium</label>
							<input type="text" id="c-other" placeholder="e.g. projector, phone, drive-in…" autocomplete="off" />
						</div>
					</div>

					<div>
						<label class="lbl" for="c-review">Review</label>
						<textarea id="c-review" rows="4" placeholder="Add your thoughts…"></textarea>
					</div>

					<div class="tags-field">
						<label class="lbl" for="c-tag-input">Tags</label>
						<input
							type="text"
							id="c-tag-input"
							placeholder="Type a tag, press Enter…"
							autocomplete="off"
						/>
						<datalist id="tag-options">
							{tagOptions.map((t) => (
								<option value={t}></option>
							))}
						</datalist>
						<ul class="tag-suggest" id="c-tag-suggest" hidden></ul>
						<div class="tag-chips" id="c-tag-chips" hidden></div>
					</div>
				</div>

				<div class="modal__foot">
					<span class="save-msg" id="save-msg"></span>
					<button type="button" class="btn-ghost" id="composer-cancel">Cancel</button>
					<button type="button" class="btn-save" id="composer-save" disabled>Log film</button>
				</div>
			</div>
		</div>
	)}

	<style>
		.page {
			display: flex;
			justify-content: center;
			padding: 0 24px 80px;
		}
		.wrap {
			width: 100%;
			max-width: 900px;
		}
		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 26px 0 22px;
			border-bottom: 1px solid #4a2529;
			margin-bottom: 34px;
		}
		.back {
			display: flex;
			align-items: center;
			gap: 9px;
			font-size: 13px;
			color: #a2857a;
		}
		.back:hover {
			color: #f4e8d1;
		}
		.back__arrow {
			font-size: 15px;
		}
		.topbar__tag {
			font-size: 11.5px;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #8a6f63;
		}

		.titleblock {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			margin-bottom: 38px;
			flex-wrap: wrap;
			gap: 14px;
		}
		.titleblock__left {
			display: flex;
			align-items: center;
			gap: 20px;
		}
		h1 {
			font-family: 'Newsreader', serif;
			font-weight: 500;
			font-size: 52px;
			color: #f4e8d1;
			letter-spacing: -0.5px;
			line-height: 1;
			margin: 0;
		}
		.log-btn {
			font-size: 13px;
			font-weight: 700;
			color: #2a1214;
			background: #d9b45a;
			border: none;
			border-radius: 8px;
			padding: 10px 18px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
		}
		.log-btn:hover {
			background: #f0d488;
		}
		.titleblock__stats {
			display: flex;
			gap: 26px;
		}
		.stat__n {
			font-family: 'Newsreader', serif;
			font-size: 26px;
			color: #d9b45a;
		}
		.stat__l {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
			margin-top: 2px;
		}
		.empty {
			color: #8a6f63;
		}

		.month {
			margin-bottom: 40px;
		}
