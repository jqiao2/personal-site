---
import FilmLayout from '../../layouts/FilmLayout.astro';
import EntryEditor from '../../components/EntryEditor.astro';
import { listLogs, getFilmLogStats, listTheaterNames, listTags } from '../../lib/films';
import { requireOwner } from '../../lib/auth';
import { imageUrl } from '../../lib/tmdb';

// Rendered on demand — reflects the live database.
export const prerender = false;

const [logs, stats, isOwner] = await Promise.all([
	listLogs(120),
	getFilmLogStats(),
	requireOwner(Astro.cookies),
]);

// Composer autocomplete (owner only): known theaters and tags.
const [venueOptions, tagOptions] = isOwner
	? await Promise.all([listTheaterNames(), listTags()])
	: [[], []];

function parseDate(date: string | null): Date | null {
	if (!date) return null;
	const [y, m, d] = date.slice(0, 10).split('-').map(Number);
	if (!y || !m || !d) return null;
	return new Date(y, m - 1, d);
}
function starText(r: number | null): string {
	if (r == null) return '';
	return '★'.repeat(Math.floor(r)) + (r % 1 >= 0.5 ? '½' : '');
}

interface Row {
	logId: number;
	day: number;
	weekday: string;
	title: string;
	year: number | null;
	poster: string | null;
	tmdbId: number;
	stars: string;
	review: string | null;
	liked: boolean;
	rewatched: boolean;
}

// Group logs into months, preserving the (newest-first) order.
const months: { label: string; items: Row[] }[] = [];
const byLabel = new Map<string, Row[]>();
for (const log of logs) {
	const dt = parseDate(log.watched_date) ?? parseDate(log.created_at);
	const label = dt
		? dt.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
		: 'Undated';
	if (!byLabel.has(label)) {
		const items: Row[] = [];
		byLabel.set(label, items);
		months.push({ label, items });
	}
	byLabel.get(label)!.push({
		logId: log.id,
		day: dt ? dt.getDate() : 0,
		weekday: dt ? dt.toLocaleDateString('en-US', { weekday: 'short' }) : '',
		title: log.title,
		year: log.release_year,
		poster: imageUrl(log.poster_path, 'w154'),
		tmdbId: log.tmdb_id,
		stars: starText(log.rating),
		review: log.review_text,
		liked: log.liked,
		rewatched: log.rewatched,
	});
}
const num = (n: number) => n.toLocaleString('en-US');
---

<FilmLayout title="Film diary — Jason's film log">
	<div class="page">
		<div class="wrap">
			<header class="topbar">
				<a class="back" href="/films">
					<span class="back__arrow">←</span><span>Jason's film log</span>
				</a>
				<span class="topbar__tag">Diary</span>
			</header>

			<div class="titleblock">
				<div class="titleblock__left">
					<h1>Film diary</h1>
					{isOwner && (
						<button type="button" class="log-btn" data-open-entry-editor>+ Log film</button>
					)}
				</div>
				<div class="titleblock__stats">
					<div class="stat">
						<div class="stat__n">{num(stats.diary)}</div>
						<div class="stat__l">films logged</div>
					</div>
					<div class="stat">
						<div class="stat__n">{num(stats.thisYear)}</div>
						<div class="stat__l">this year</div>
					</div>
				</div>
			</div>

			{months.length === 0 ? (
				<p class="empty">No films logged yet.</p>
			) : (
				months.map((m) => (
					<section class="month">
						<div class="month__label">{m.label}</div>
						{m.items.map((f) => (
							<a class="row" href={`/films/diary/${f.logId}`}>
								<div class="row__date">
									<div class="row__day">{f.day || '·'}</div>
									<div class="row__wd">{f.weekday}</div>
								</div>
								<div class="row__poster">
									{f.poster && <img src={f.poster} alt="" loading="lazy" />}
								</div>
								<div class="row__body">
									<div class="row__title">
										{f.title} <span class="row__year">{f.year}</span>
									</div>
									{f.review && <div class="row__review">{f.review}</div>}
								</div>
								<div class="row__meta">
									<span class="row__stars">{f.stars}</span>
									{f.liked && <span class="row__like">♥</span>}
									{f.rewatched && <span class="row__rewatch">↻</span>}
								</div>
							</a>
						))}
					</section>
				))
			)}
		</div>
	</div>

	{isOwner && (
		<EntryEditor
			mode="select"
			venueOptions={venueOptions}
			tagOptions={tagOptions}
			redirect="/films/diary"
		/>
	)}

	<style>
		.page {
			display: flex;
			justify-content: center;
			padding: 0 24px 80px;
		}
		.wrap {
			width: 100%;
			max-width: 900px;
		}
		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 26px 0 22px;
			border-bottom: 1px solid #4a2529;
			margin-bottom: 34px;
		}
		.back {
			display: flex;
			align-items: center;
			gap: 9px;
			font-size: 13px;
			color: #a2857a;
		}
		.back:hover {
			color: #f4e8d1;
		}
		.back__arrow {
			font-size: 15px;
		}
		.topbar__tag {
			font-size: 11.5px;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #8a6f63;
		}

		.titleblock {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			margin-bottom: 38px;
			flex-wrap: wrap;
			gap: 14px;
		}
		.titleblock__left {
			display: flex;
			align-items: center;
			gap: 20px;
		}
		h1 {
			font-family: 'Newsreader', serif;
			font-weight: 500;
			font-size: 52px;
			color: #f4e8d1;
			letter-spacing: -0.5px;
			line-height: 1;
			margin: 0;
		}
		.log-btn {
			font-size: 13px;
			font-weight: 700;
			color: #2a1214;
			background: #d9b45a;
			border: none;
			border-radius: 8px;
			padding: 10px 18px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
		}
		.log-btn:hover {
			background: #f0d488;
		}
		.titleblock__stats {
			display: flex;
			gap: 26px;
		}
		.stat__n {
			font-family: 'Newsreader', serif;
			font-size: 26px;
			color: #d9b45a;
		}
		.stat__l {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
			margin-top: 2px;
		}
		.empty {
			color: #8a6f63;
		}

		.month {
			margin-bottom: 40px;
		}
		.month__label {
			font-family: 'Newsreader', serif;
			font-style: italic;
			font-size: 20px;
			color: #ecdcbd;
			padding-bottom: 10px;
			border-bottom: 1px solid #402226;
			margin-bottom: 6px;
		}
		.row {
			display: grid;
			grid-template-columns: 56px 46px 1fr auto;
			gap: 18px;
			align-items: center;
			padding: 14px 10px;
			border-bottom: 1px solid #351a1d;
			border-radius: 6px;
			color: inherit;
		}
		.row:hover {
			background: #331619;
		}
		.row__date {
			text-align: center;
		}
		.row__day {
			font-family: 'Newsreader', serif;
			font-size: 28px;
			color: #f4e8d1;
			line-height: 1;
		}
		.row__wd {
			font-size: 10.5px;
			text-transform: uppercase;
			letter-spacing: 1px;
			color: #8a6f63;
			margin-top: 3px;
		}
		.row__poster {
			width: 46px;
			height: 69px;
			border-radius: 4px;
			overflow: hidden;
			background-image: repeating-linear-gradient(135deg, #351a1d 0 8px, #2c1518 8px 16px);
			border: 1px solid #4a2529;
		}
		.row__poster img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.row__body {
			min-width: 0;
		}
		.row__title {
			font-family: 'Newsreader', serif;
			font-size: 18px;
			color: #f2e5cd;
			line-height: 1.2;
		}
		.row__year {
			color: #b0917f;
			font-style: italic;
			font-size: 15px;
		}
		.row__review {
			font-size: 13px;
			color: #a2857a;
			margin-top: 5px;
			line-height: 1.4;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		.row__meta {
			display: flex;
			align-items: center;
			gap: 14px;
			justify-content: flex-end;
		}
		.row__stars {
			color: #d9b45a;
			font-size: 15px;
			letter-spacing: 1px;
			white-space: nowrap;
		}
		.row__like {
			font-size: 15px;
			color: #d9b45a;
		}
		.row__rewatch {
			font-size: 14px;
			color: #7a5a52;
		}

		@media (max-width: 640px) {
			h1 {
				font-size: 40px;
			}
			.row {
				grid-template-columns: 44px 40px 1fr auto;
				gap: 12px;
			}
		}
	</style>
</FilmLayout>
