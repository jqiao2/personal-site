---
import EntryEditor from '../../../components/EntryEditor.astro';
import {
	getFilmByTmdbId,
	listFriends,
	listMovieEntries,
	listTags,
	listTheaterNames,
} from '../../../lib/films';
import { toEditorInitial } from '../../../lib/entry-editor';
import { imageUrl } from '../../../lib/tmdb';
import { formatWatchedDate, starText } from '../../../lib/format';
import { requireOwner } from '../../../lib/auth';

// Rendered on demand — reflects the live database.
export const prerender = false;

const tmdbId = Number(Astro.params.tmdbId);
const film = Number.isInteger(tmdbId) ? await getFilmByTmdbId(tmdbId) : null;

if (!film) {
	return new Response('Film not found', { status: 404 });
}

const { movie, watched } = film;
const isOwner = await requireOwner(Astro.cookies);

// Every diary entry for this film (newest first) → the "Your reviews" list, and
// the values the editor reopens each of them with. A film can be watched with no
// logs at all (Letterboxd import), in which case this is empty and the reviews
// section says so.
const movieLogs = await listMovieEntries(movie.id);

// Director / cast / genres / language / country / rating come from our cache row
// (migrations 0008 + 0009), so the page renders without a live TMDB call.
const directors = movie.directors;
const cast = movie.actors.slice(0, 5);
const genres = movie.genres;
const runtime = movie.runtime;
// The film's original language + its primary production country for the meta row.
const country = movie.countries[0] ?? null;
const language = movie.original_language;
const mpaRating = movie.mpa_rating;
// The runtime · country · language row, with only the facts we actually have.
const metaItems = [formatRuntime(runtime), country, language].filter(Boolean) as string[];

const backdrop = imageUrl(movie.backdrop_path, 'w780');
const poster = imageUrl(movie.poster_path, 'w342');
const tmdbUrl = `https://www.themoviedb.org/movie/${movie.tmdb_id}`;
const filmHref = `/films/movie/${movie.tmdb_id}`;

// The director and each cast member link to the "All films" grid pre-filtered to
// them, so this film's people are one click from everything else you've watched
// with them. `director` / `actor` are the URL params /films/watched reads, and the
// names match the cached credit facets its chips are built from. `sort=year` orders
// that person's films by release date rather than the default (recent) order.
const filterHref = (key: string, value: string) =>
	`/films/watched?${key}=${encodeURIComponent(value)}&sort=year`;

/** Minutes → "2h 4m" / "48m". */
function formatRuntime(min: number | null): string | null {
	if (!min || min <= 0) return null;
	const h = Math.floor(min / 60);
	const m = min % 60;
	return h > 0 ? `${h}h ${m}m` : `${m}m`;
}

/** Watched date if set, otherwise the diary date (created_at). */
function logDate(l: { watched_date: string | null; created_at: string }): string {
	return (
		formatWatchedDate(l.watched_date) ??
		new Date(l.created_at).toLocaleDateString('en-US', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	);
}

// "Your activity" reflects your current relationship to the film: the most recent
// diary entry's rating/like (composer logs intentionally don't touch the
// film-level `watched` row — see logFilm), falling back to the film-level values
// from the Letterboxd import when there are no diary logs. Watched date stays the
// first-watched stat, falling back to the latest log's date.
const latestLog = movieLogs[0] ?? null;
const activityRating = latestLog?.rating ?? watched?.rating ?? null;
const activityLiked = latestLog?.liked ?? watched?.liked ?? false;
const yourRating = starText(activityRating) ?? '';
const yourWatched = watched?.first_watched
	? formatWatchedDate(watched.first_watched.slice(0, 10))
	: latestLog
		? logDate(latestLog)
		: null;

// Editor scaffolding (owner only). One editor serves the whole page: the film is
// already known, so the log button opens it on a new entry for this film, and
// each review's Edit button reopens it on that entry.
const [venueOptions, tagOptions, friendOptions] = isOwner
	? await Promise.all([listTheaterNames(), listTags(), listFriends()])
	: [[], [], []];
const editorFilm = {
	tmdbId: movie.tmdb_id,
	title: movie.title,
	year: movie.release_year,
	poster: imageUrl(movie.poster_path, 'w92'),
};
const editorEntries = movieLogs.map((l) => ({ logId: l.id, initial: toEditorInitial(l) }));
// Rewatches and re-reviews are the norm once a film is already logged, so the
// button says so rather than implying this would be the first entry.
const logButtonLabel = movieLogs.length > 0 ? 'Log or review again' : 'Log or review';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{movie.title} — Jason's film log</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="page">
			<!-- Backdrop -->
			<div class="backdrop" style={backdrop ? `background-image:url(${backdrop})` : undefined}>
				<div class="backdrop__scrim"></div>
				<div class="backdrop__bar">
					<div class="wrap">
						<a class="back" href="/films/watched">
							<span class="back__arrow">←</span><span>Films watched</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Content -->
			<div class="content">
				<div class="wrap layout">
					<!-- Left: poster + your activity -->
					<aside class="col-left">
						<div class="poster">
							{poster && <img src={poster} alt={`${movie.title} poster`} />}
							<div class="poster__title">
								{movie.title}
								{movie.release_year && <span class="poster__year">{movie.release_year}</span>}
							</div>
						</div>

						{isOwner && (
							<button type="button" class="btn-primary" data-open-entry-editor>
								{logButtonLabel}
							</button>
						)}

						<div class="activity">
							<div class="activity__head">Your activity</div>
							<div class="activity__row">
								<span class="activity__key">Your rating</span>
								<span class="stars">{yourRating || '—'}</span>
							</div>
							<div class="activity__row">
								<span class="activity__key">Liked</span>
								<span class="stars">{activityLiked ? '♥' : '—'}</span>
							</div>
							<div class="activity__row">
								<span class="activity__key">Watched</span>
								<span class="activity__val">{yourWatched ?? '—'}</span>
							</div>
						</div>
					</aside>

					<!-- Right: details -->
					<div class="col-right">
						<h1>
							{movie.title}
							{movie.release_year && <span class="h1-year">{movie.release_year}</span>}
						</h1>

						{directors.length > 0 && (
							<div class="directed">
								Directed by{' '}
								{directors.map((d, i) => (
									<>
										{i > 0 && ', '}
										<a class="directed__name" href={filterHref('director', d)}>{d}</a>
									</>
								))}
							</div>
						)}

						{(mpaRating || metaItems.length > 0) && (
							<div class="meta">
								{mpaRating && <span class="cert" title="US content rating">{mpaRating}</span>}
								{metaItems.map((item, i) => (
									<>
										{i > 0 && <span class="meta__dot">·</span>}
										<span class="meta__dim">{item}</span>
									</>
								))}
							</div>
						)}

						{genres.length > 0 && (
							<div class="genres">
								{genres.map((g) => (
									<span class="genre">{g}</span>
								))}
							</div>
						)}

						{movie.overview && <p class="synopsis">{movie.overview}</p>}

						{cast.length > 0 && (
							<section class="block">
								<div class="block__head">Cast</div>
								<div class="cast">
									{cast.map((c) => (
										<a class="cast__chip" href={filterHref('actor', c)}>{c}</a>
									))}
								</div>
							</section>
						)}

						<section class="block">
							<div class="block__head block__head--row">
								<span>Your reviews</span>
								<span class="block__count">{movieLogs.length} {movieLogs.length === 1 ? 'entry' : 'entries'}</span>
							</div>
							{movieLogs.length === 0 ? (
								<p class="empty">No review yet — just marked watched.</p>
							) : (
								<div class="reviews">
									{movieLogs.map((r) => (
										<article class="review">
											<div class="review__meta">
												{r.rating != null && <span class="stars">{starText(r.rating)}</span>}
												{r.liked && <span class="stars review__heart">♥</span>}
												<span class="review__label">
													{r.rewatched ? 'Rewatch' : 'Watched'} · {logDate(r)}
												</span>
												{isOwner && (
													<button
														type="button"
														class="review__edit"
														data-open-entry-editor
														data-entry-editor-log-id={r.id}
													>
														Edit
													</button>
												)}
											</div>
											{r.review_text && <p class="review__text">{r.review_text}</p>}
										</article>
									))}
								</div>
							)}
						</section>

						<footer class="attribution">
							Metadata from{' '}
							<a href={tmdbUrl} rel="noopener" target="_blank">TMDB ↗</a>. This product uses the
							TMDB API but is not endorsed or certified by TMDB.
						</footer>
					</div>
				</div>
			</div>
		</div>

		{/* Entry editor (owner only): the log button and every review's Edit share it. */}
		{isOwner && (
			<EntryEditor
				mode="log"
				film={editorFilm}
				entries={editorEntries}
				venueOptions={venueOptions}
				tagOptions={tagOptions}
				friendOptions={friendOptions}
				redirect={filmHref}
				deleteRedirect={filmHref}
			/>
		)}

		<style>
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
			}
			body {
				background: #1c0d0e;
				color: #f4e8d1;
				font-family: 'Archivo', Arial, sans-serif;
				-webkit-font-smoothing: antialiased;
			}
			a {
				text-decoration: none;
				color: #d9b45a;
			}
			.page {
				min-height: 100vh;
				background: #1c0d0e;
			}
			.wrap {
				width: 100%;
				max-width: 960px;
				margin: 0 auto;
				padding: 0 24px;
			}

			/* Backdrop */
			.backdrop {
				position: relative;
				height: 360px;
				background-color: #2c1518;
				background-image: repeating-linear-gradient(135deg, #3a1c20 0 14px, #2c1518 14px 28px);
				background-size: cover;
				background-position: center;
				overflow: hidden;
			}
			.backdrop__scrim {
				position: absolute;
				inset: 0;
				background: linear-gradient(
					180deg,
					rgba(28, 13, 14, 0.35) 0%,
					rgba(28, 13, 14, 0.72) 55%,
					#1c0d0e 100%
				);
			}
			.backdrop__bar {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				padding: 24px 0;
			}
			.back {
				display: inline-flex;
				align-items: center;
				gap: 9px;
				font-size: 13px;
				color: #e9d9c4;
			}
			.back:hover {
				color: #fff;
			}
			.back__arrow {
				font-size: 15px;
			}

			/* Content layout */
			.content {
				padding-bottom: 80px;
			}
			.layout {
				margin-top: -150px;
				position: relative;
				display: grid;
				grid-template-columns: 230px 1fr;
				gap: 36px;
				align-items: start;
			}

			/* Left column */
			.col-left {
				display: flex;
				flex-direction: column;
				gap: 18px;
			}
			.poster {
				position: relative;
				aspect-ratio: 2 / 3;
				border-radius: 7px;
				overflow: hidden;
				background-image: repeating-linear-gradient(135deg, #351a1d 0 9px, #2c1518 9px 18px);
				border: 1px solid #4a2529;
				box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.6);
				display: flex;
				align-items: flex-end;
			}
			.poster img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.poster__title {
				position: relative;
				padding: 14px;
				font-family: 'Newsreader', serif;
				font-size: 18px;
				color: #f2e5cd;
				line-height: 1.2;
			}
			.poster img ~ .poster__title {
				/* Hidden when a real poster is present. */
				display: none;
			}
			.poster__year {
				color: #b0917f;
				font-style: italic;
				font-size: 15px;
				margin-left: 4px;
			}

			.activity {
				background: #2a1214;
				border: 1px solid #4a2529;
				border-radius: 10px;
				padding: 16px 16px 18px;
			}
			.activity__head {
				font-size: 11px;
				text-transform: uppercase;
				letter-spacing: 1.4px;
				color: #8a6f63;
				margin-bottom: 12px;
			}
			.activity__row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 10px;
			}
			.activity__row:last-child {
				margin-bottom: 0;
			}
			.activity__key {
				font-size: 12px;
				color: #a2857a;
			}
			.activity__val {
				font-size: 13px;
				color: #e9d9c4;
			}
			.stars {
				color: #d9b45a;
				font-size: 15px;
				letter-spacing: 1px;
				white-space: nowrap;
			}

			.btn-primary {
				width: 100%;
				font-size: 14px;
				font-weight: 700;
				color: #2a1214;
				background: #d9b45a;
				border: none;
				border-radius: 9px;
				padding: 12px;
				cursor: pointer;
				font-family: 'Archivo', sans-serif;
			}
			.btn-primary:hover {
				background: #f0d488;
			}

			/* Right column */
			.col-right {
				padding-top: 150px;
			}
			h1 {
				font-family: 'Newsreader', serif;
				font-weight: 500;
				font-size: 46px;
				color: #f4e8d1;
				letter-spacing: -0.5px;
				line-height: 1.02;
				margin: 0;
			}
			.h1-year {
				color: #a2857a;
				font-style: italic;
				font-weight: 400;
				font-size: 32px;
				margin-left: 8px;
			}
			.directed {
				font-size: 14px;
				color: #c2a99a;
				margin-top: 10px;
			}
			.directed__name {
				color: #f2e5cd;
				font-weight: 600;
			}
			.directed__name:hover {
				color: #f0d488;
			}
			.meta {
				display: flex;
				gap: 22px;
				align-items: center;
				margin-top: 18px;
				flex-wrap: wrap;
			}
			.meta__dim {
				font-size: 12px;
				color: #8a6f63;
			}
			.meta__dot {
				font-size: 12px;
				color: #8a6f63;
			}
			.cert {
				font-size: 11px;
				font-weight: 700;
				letter-spacing: 0.5px;
				line-height: 1.2;
				color: #ddc9b4;
				border: 1.5px solid #6b4a42;
				border-radius: 3px;
				padding: 2px 7px;
			}
			.genres {
				display: flex;
				gap: 8px;
				flex-wrap: wrap;
				margin-top: 20px;
			}
			.genre {
				font-size: 12px;
				color: #ddc9b4;
				border: 1px solid #4a2529;
				border-radius: 20px;
				padding: 5px 13px;
				background: #241012;
			}
			.synopsis {
				font-size: 15px;
				color: #d8c6ad;
				line-height: 1.65;
				margin-top: 22px;
				max-width: 560px;
			}
			.block {
				margin-top: 28px;
			}
			.block__head {
				font-family: 'Newsreader', serif;
				font-style: italic;
				font-size: 17px;
				color: #ecdcbd;
				padding-bottom: 9px;
				border-bottom: 1px solid #402226;
				margin-bottom: 12px;
			}
			.block__head--row {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
			}
			.block__count {
				font-family: 'Archivo', sans-serif;
				font-style: normal;
				font-size: 12px;
				color: #8a6f63;
			}
			.cast {
				display: flex;
				gap: 8px;
				flex-wrap: wrap;
			}
			.cast__chip {
				font-size: 13px;
				color: #e9d9c4;
				background: #241012;
				border: 1px solid #4a2529;
				border-radius: 6px;
				padding: 7px 12px;
			}
			.cast__chip:hover {
				color: #f0d488;
				border-color: #d9b45a;
			}
			.reviews {
				display: flex;
				flex-direction: column;
				gap: 20px;
			}
			.review {
				border-left: 2px solid #4a2529;
				padding-left: 16px;
			}
			.review__meta {
				display: flex;
				align-items: center;
				gap: 12px;
				margin-bottom: 9px;
			}
			.review__heart {
				font-size: 13px;
			}
			.review__label {
				font-size: 12px;
				color: #8a6f63;
			}
			.review__edit {
				margin-left: auto;
				font-size: 11px;
				font-weight: 600;
				color: #a2857a;
				background: transparent;
				border: 1px solid #4a2529;
				border-radius: 6px;
				padding: 5px 11px;
				cursor: pointer;
				font-family: 'Archivo', sans-serif;
			}
			.review__edit:hover {
				border-color: #d9b45a;
				color: #f4e8d1;
			}
			.review__text {
				font-family: 'Newsreader', serif;
				font-size: 16px;
				color: #e6d8c3;
				line-height: 1.6;
				font-style: italic;
				max-width: 560px;
				margin: 0;
			}
			.empty {
				font-size: 14px;
				color: #8a6f63;
				margin: 0;
			}
			.attribution {
				margin-top: 40px;
				padding-top: 16px;
				border-top: 1px solid #402226;
				font-size: 11px;
				color: #6f584e;
				max-width: 560px;
				line-height: 1.5;
			}
			.attribution a {
				color: #8a6f63;
			}

			@media (max-width: 720px) {
				.layout {
					grid-template-columns: 1fr;
					margin-top: -110px;
					gap: 24px;
				}
				.col-left {
					max-width: 200px;
				}
				.col-right {
					padding-top: 0;
				}
				h1 {
					font-size: 34px;
				}
				.h1-year {
					font-size: 24px;
				}
			}
		</style>

		<script>
			// "Back" links go to the actual previous page when you arrived from within
			// the site; the href stays a fallback for direct loads / new tabs / external
			// referrers (where history.back() would leave the site).
			for (const a of document.querySelectorAll('a.back')) {
				a.addEventListener('click', (e) => {
					const ref = document.referrer;
					const sameOrigin = !!ref && new URL(ref).origin === location.origin;
					if (history.length > 1 && sameOrigin) {
						e.preventDefault();
						history.back();
					}
				});
			}
		</script>
	</body>
</html>
