				border-color: #d9b45a;
			}
			.related__title {
				font-size: 11px;
				color: #c2a99a;
				line-height: 1.3;
			}
			.related__tile:hover .related__title {
				color: #f0d488;
			}
			.related__why {
				font-size: 10px;
				letter-spacing: 0.4px;
				text-transform: uppercase;
				color: #7d6355;
			}
			.attribution {
				margin-top: 40px;
				padding-top: 16px;
				border-top: 1px solid #402226;
				font-size: 11px;
				color: #6f584e;
				max-width: 560px;
				line-height: 1.5;
			}
			.attribution a {
				color: #8a6f63;
			}

			@media (max-width: 720px) {
				.layout {
					grid-template-columns: 1fr;
					margin-top: -110px;
					gap: 24px;
				}
				.col-left {
					max-width: 200px;
				}
				.col-right {
					padding-top: 0;
				}
				h1 {
					font-size: 34px;
				}
				.h1-year {
					font-size: 24px;
				}
			}
		</style>

		<script>
			// "Back" links go to the actual previous page when you arrived from within
			// the site; the href stays a fallback for direct loads / new tabs / external
			// referrers (where history.back() would leave the site).
			for (const a of document.querySelectorAll('a.back')) {
				a.addEventListener('click', (e) => {
					const ref = document.referrer;
					const sameOrigin = !!ref && new URL(ref).origin === location.origin;
					if (history.length > 1 && sameOrigin) {
						e.preventDefault();
						history.back();
					}
				});
			}

			// Watchlist toggle (unwatched films, owner only). Optimistic-free: the
			// button waits for the write, so its state always matches the list.
			const toggle = document.getElementById('watchlist-toggle');
			if (toggle instanceof HTMLButtonElement) {
				toggle.addEventListener('click', async () => {
					const id = toggle.dataset.tmdbId;
					const adding = !toggle.dataset.on;
					toggle.disabled = true;
					try {
						const res = adding
							? await fetch('/api/films/watchlist', {
									method: 'POST',
									headers: { 'Content-Type': 'application/json' },
									body: JSON.stringify({ tmdbId: Number(id) }),
								})
							: await fetch(`/api/films/watchlist?tmdbId=${id}`, { method: 'DELETE' });
						if (res.status === 401) {
							window.location.href = `/films/login?redirect=${encodeURIComponent(location.pathname)}`;
							return;
						}
						if (!res.ok) throw new Error(String(res.status));
						if (adding) toggle.dataset.on = '1';
						else delete toggle.dataset.on;
						toggle.textContent = adding ? '✓ On watchlist' : '+ Add to watchlist';
						toggle.setAttribute('aria-pressed', adding ? 'true' : 'false');
					} catch {
						toggle.textContent = "Couldn't save — try again";
					} finally {
						toggle.disabled = false;
					}
				});
			}

			// --- Play on Jellyfin (owner only, and only when it's configured) ------
			// All of this runs in the browser rather than on the server because
			// Jellyfin is tailnet-only: Vercel can't reach it, this device might.
			// Every failure is silent by design — off the tailnet, machine asleep,
			// Jellyfin restarting — because the page already has a working answer for
			// "I want to watch this" in the YTS link. A broken button would be worse
			// than no button, so the button only ever appears once we've confirmed
			// both that the server answered and that the film is really in it.
			const play = document.getElementById('jellyfin-play');
			if (play instanceof HTMLButtonElement) {
				const tmdbId = play.dataset.tmdb!;
				const label = play.querySelector('[data-label]')!;
				// Key travels as a header, not a query param, so it stays out of URLs
				// and Jellyfin's request log. Verified to pass CORS preflight.
				const auth = { Authorization: `MediaBrowser Token="${play.dataset.key}"` };

				// Which origin can see Jellyfin depends on where you're reading this:
				// the tailnet name from other devices, localhost from the machine it
				// runs on (which can't reach its own serve endpoint). Rather than guess
				// from the URL, ask both at once and keep whichever replies. The probe
				// is unauthenticated and tiny, and the winner is cached for the tab.
				const BASE_KEY = 'jellyfin:base:v1';
				const bases: string[] = JSON.parse(play.dataset.bases!);
				// Empty when JELLYFIN_LOCAL_URL isn't set, in which case no device ever
				// counts as the host and every play goes to the web player.
				const localUrl = play.dataset.local || null;
				async function pickBase(): Promise<string | null> {
					const cached = sessionStorage.getItem(BASE_KEY);
					if (cached && bases.includes(cached)) return cached;
					try {
						const winner = await Promise.any(
							bases.map(async (b) => {
								const res = await fetch(`${b}/System/Info/Public`, {
									signal: AbortSignal.timeout(5000),
								});
								if (!res.ok) throw new Error(String(res.status));
								return b;
							}),
						);
						try {
							sessionStorage.setItem(BASE_KEY, winner);
						} catch {
							// Storage unavailable — we'll just probe again next page.
						}
						return winner;
					} catch {
						return null; // Every candidate failed: not on the tailnet, or it's asleep.
					}
				}

				let base = '';
				// True once we know this browser is running on the Jellyfin machine —
				// localhost only resolves there, so the winning URL settles it.
				let onHost = false;
				// A sleeping or absent server should fail fast, not hang the button.
				const jf = (path: string, init?: RequestInit) =>
					fetch(`${base}${path}`, { ...init, headers: auth, signal: AbortSignal.timeout(6000) });

				// 10.10 has no "find by TMDB id" filter — only a hasTmdbId boolean — so
				// the lookup is one pass over the movie library, reduced to the id map
				// we actually want and cached for the tab. That's a single request per
				// session rather than one per film page.
				const CACHE_KEY = 'jellyfin:movies:v2';
				const CACHE_TTL = 10 * 60 * 1000;

				// Rows from a library's previous location linger in /Items indefinitely:
				// a scan only walks the folders currently configured, so it never visits
				// the strays and never prunes them. They collide with the live entries on
				// TMDB id, and handing one to a player starts a file that isn't there
				// (NSURLErrorDomain -1008 on iOS). Scoping the query to the configured
				// movies library leaves them out by construction.
				async function moviesLibraryId(): Promise<string | null> {
					try {
						const res = await jf('/Library/VirtualFolders');
						if (!res.ok) return null;
						const lib = (await res.json()).find((v: any) => v.CollectionType === 'movies');
						return lib?.ItemId ?? null;
					} catch {
						return null;
					}
				}

				async function libraryMap(): Promise<Record<string, string>> {
					try {
						const cached = JSON.parse(sessionStorage.getItem(CACHE_KEY) || 'null');
						if (cached && Date.now() - cached.ts < CACHE_TTL) return cached.map;
					} catch {
						// Unparseable or storage disabled — just refetch.
					}
					// Unscoped only if the server has no movies library to scope to, in
					// which case there's nothing better to ask for.
					const libId = await moviesLibraryId();
					const res = await jf(
						`/Items?recursive=true&includeItemTypes=Movie&fields=ProviderIds` +
							`${libId ? `&parentId=${libId}` : ''}` +
							'&enableImages=false&enableTotalRecordCount=false',
					);
					if (!res.ok) throw new Error(String(res.status));
					const map: Record<string, string> = {};
					for (const item of (await res.json()).Items ?? []) {
						const id = item.ProviderIds?.Tmdb;
						if (id) map[String(id)] = item.Id;
					}
					try {
						sessionStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), map }));
					} catch {
						// Private mode / quota — the map just won't survive this page.
					}
					return map;
				}

				// Every Jellyfin client registers as a remote-controllable session while
				// it's open, which is what lets a click here start playback over there.
				// The trick is picking the session that belongs to the device in your
				// hand: casting to the desktop from a phone puts the film on in an empty
				// room. Which URL answered identifies the desktop; the user agent
				// identifies the rest.
				//
				// In practice this only ever fires on the desktop, where the player is an
				// ordinary app that stays controllable while you browse. A phone can't
				// cast to itself: the mobile clients set SupportsRemoteControl only while
				// foregrounded and drop their session within seconds of being backgrounded
				// — and reading this page means the browser is foregrounded, not the app.
				// The phone branches are kept because they're correct when a session does
				// exist, but don't expect them to. Playing on a phone would mean the web
				// client, which needs that browser signed into Jellyfin separately.
				function deviceClient(): RegExp | null {
					if (onHost) return /jellyfin media player/i;
					const ua = navigator.userAgent;
					if (/iPhone|iPad|iPod/.test(ua)) return /jellyfin ios|swiftfin/i;
					if (/Android/.test(ua)) return /jellyfin android/i;
					return null;
				}

				// The session to play on, or null if this device has no Jellyfin client
				// open to receive it.
				async function deviceSession(): Promise<string | null> {
					const pattern = deviceClient();
					if (!pattern) return null;
					try {
						const res = await jf('/Sessions');
						if (!res.ok) return null;
						const found = (await res.json()).find(
							(s: any) => s.SupportsRemoteControl && pattern.test(s.Client ?? ''),
						);
						return found?.Id ?? null;
					} catch {
						return null;
					}
				}

				// The button plays the film in a real Jellyfin client on the device you're
				// holding, so it appears only when there is one to play it in: Jellyfin
				// answers, it has the film, and this device has a client open.
				//
				// Deliberately no web-client fallback. Deep-linking into /web only lands
				// on the film if that browser already holds a Jellyfin session; otherwise
				// it bounces to a login page — which, on a phone where you use the app
				// rather than Safari, is every time. A button that opens a login screen
				// isn't playing the film, so we show nothing instead.
				(async () => {
					const found = await pickBase();
					if (!found) return; // Jellyfin isn't reachable from here — stay hidden.
					base = found;
					onHost = !!localUrl && base === localUrl;

					let itemId: string | null = null;
					let sessionId: string | null = null;
					try {
						[itemId, sessionId] = await Promise.all([
							libraryMap().then((m) => m[tmdbId] ?? null),
							deviceSession(),
						]);
					} catch {
						return; // Unreachable server — leave the button hidden.
					}
					if (!itemId) return; // Not in the library — the YTS link is the answer.
					if (!sessionId) return; // No Jellyfin client open here to play it in.

					label.textContent = 'Play';
					play.hidden = false;

					play.addEventListener('click', async () => {
						// Re-resolve rather than trusting the load-time answer: the client
						// may have been closed since the page rendered.
						const target = await deviceSession();
						if (!target) {
							play.hidden = true;
							return;
						}
						play.disabled = true;
						play.dataset.busy = '1';
						label.textContent = 'Starting…';
						try {
							const res = await jf(
								`/Sessions/${target}/Playing?playCommand=PlayNow&itemIds=${itemId}`,
								{ method: 'POST' },
							);
							if (!res.ok) throw new Error(String(res.status));
							label.textContent = 'Playing';
						} catch {
							play.hidden = true;
						} finally {
							play.disabled = false;
							delete play.dataset.busy;
						}
					});
				})();
			}
		</script>
	</body>
</html>
