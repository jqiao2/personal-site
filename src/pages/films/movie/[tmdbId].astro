				display: flex;
				flex-direction: column;
				gap: 7px;
			}
			.related__art {
				position: relative;
				aspect-ratio: 2 / 3;
				border-radius: 5px;
				overflow: hidden;
				background-image: repeating-linear-gradient(135deg, #351a1d 0 8px, #2c1518 8px 16px);
				border: 1px solid #4a2529;
