---
import EntryEditor from '../../../components/EntryEditor.astro';
import PosterLoader from '../../../components/PosterLoader.astro';
import {
	ensureMovieCached,
	getFilmByTmdbId,
	isOnWatchlist,
	listFriends,
	listMovieEntries,
	listRelatedWatched,
	listTags,
	listTheaterNames,
	type RelatedFilm,
} from '../../../lib/films';
import { imageUrl } from '../../../lib/tmdb';
import { formatWatchedDate, starText, ytsUrl } from '../../../lib/format';
import { requireOwner } from '../../../lib/auth';
import { jellyfinConfig } from '../../../lib/jellyfin';

// Rendered on demand — reflects the live database.
export const prerender = false;

const tmdbId = Number(Astro.params.tmdbId);
const isOwner = await requireOwner(Astro.cookies);
let film = Number.isInteger(tmdbId) ? await getFilmByTmdbId(tmdbId) : null;

// A film reached from the log composer's search results usually isn't cached yet —
// nothing has watchlisted or logged it. For the owner, pull it from TMDB and cache
// it (the same path adding to the watchlist takes) so any film they can search for
// has a page. A visitor still gets a 404 rather than the power to write rows.
if (!film && isOwner && Number.isInteger(tmdbId)) {
	try {
		await ensureMovieCached(tmdbId);
		film = await getFilmByTmdbId(tmdbId);
	} catch {
		film = null; // TMDB miss or outage — fall through to the 404 below.
	}
}

if (!film) {
	return new Response('Film not found', { status: 404 });
}

const { movie, watched } = film;

// Every diary entry for this film (newest first) → the "Your reviews" list, and
// the values the editor reopens each of them with. A film can be watched with no
// logs at all (Letterboxd import), in which case this is empty and the reviews
// section says so.
const movieLogs = await listMovieEntries(movie.id);

// The page has two modes off one route. A film with no `watched` row and no diary
// entry is one you haven't seen: the left column trades "Your activity" for the
// watchlist and download actions, and the right column trades your reviews for
// films you've already watched that it resembles.
const seen = !!watched || movieLogs.length > 0;
const [onWatchlist, related] = seen
	? ([false, []] as [boolean, RelatedFilm[]])
	: await Promise.all([isOnWatchlist(movie.id), listRelatedWatched(movie)]);

// Director / cast / genres / language / country / rating come from our cache row
// (migrations 0008 + 0009), so the page renders without a live TMDB call.
const directors = movie.directors;
const cast = movie.actors.slice(0, 5);
const genres = movie.genres;
const runtime = movie.runtime;
// The film's primary production country for the meta row.
const country = movie.countries[0] ?? null;
const mpaRating = movie.mpa_rating;
// The release date · runtime · country row, with only the facts we actually have.
// The full date earns its place here because the title only carries the year;
// original_language is still cached, it just isn't part of this row.
const metaItems = [
	formatWatchedDate(movie.release_date),
	formatRuntime(runtime),
	country,
].filter(Boolean) as string[];

const backdrop = imageUrl(movie.backdrop_path, 'w780');
const poster = imageUrl(movie.poster_path, 'w342');
const tmdbUrl = `https://www.themoviedb.org/movie/${movie.tmdb_id}`;
const filmHref = `/films/movie/${movie.tmdb_id}`;

// The director, each cast member and each genre link to the "All films" grid
// pre-filtered to them, so this film's people and genres are one click from
// everything else you've watched that shares them. `director` / `actor` / `genre`
// are the URL params /films/watched reads, and the values match the cached facets
// its chips are built from. People pass `sort=year` to order that person's films by
// release date rather than the default (recent) order; genre keeps the default.
const filterHref = (key: string, value: string, sort?: 'year') =>
	`/films/watched?${key}=${encodeURIComponent(value)}${sort ? `&sort=${sort}` : ''}`;

/** Minutes → "2h 4m" / "48m". */
function formatRuntime(min: number | null): string | null {
	if (!min || min <= 0) return null;
	const h = Math.floor(min / 60);
	const m = min % 60;
	return h > 0 ? `${h}h ${m}m` : `${m}m`;
}

/** Watched date if set, otherwise the diary date (created_at). */
function logDate(l: { watched_date: string | null; created_at: string }): string {
	return (
		formatWatchedDate(l.watched_date) ??
		new Date(l.created_at).toLocaleDateString('en-US', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	);
}

// "Your activity" reflects your current relationship to the film: the most recent
// diary entry's rating/like (composer logs intentionally don't touch the
// film-level `watched` row — see logFilm), falling back to the film-level values
// from the Letterboxd import when there are no diary logs. Watched date stays the
// first-watched stat, falling back to the latest log's date.
const latestLog = movieLogs[0] ?? null;
const activityRating = latestLog?.rating ?? watched?.rating ?? null;
const activityLiked = latestLog?.liked ?? watched?.liked ?? false;
const yourRating = starText(activityRating) ?? '';
const yourWatched = watched?.first_watched
	? formatWatchedDate(watched.first_watched.slice(0, 10))
	: latestLog
		? logDate(latestLog)
		: null;

// Editor scaffolding (owner only). The film is already known, so the log button
// opens the editor on a new entry for it. Existing entries are edited from their
// own diary page (behind "View") rather than from this list.
const [venueOptions, tagOptions, friendOptions] = isOwner
	? await Promise.all([listTheaterNames(), listTags(), listFriends()])
	: [[], [], []];
const editorFilm = {
	tmdbId: movie.tmdb_id,
	title: movie.title,
	year: movie.release_year,
	poster: imageUrl(movie.poster_path, 'w92'),
};
// Rewatches and re-reviews are the norm once a film is already logged, so the
// button says so rather than implying this would be the first entry.
const logButtonLabel = movieLogs.length > 0 ? 'Log or review again' : 'Log or review';

// An unwatched film is nearly always arrived at from the watchlist, a watched one
// from the "All films" grid, so the back link's fallback follows the mode. The
// click handler below still prefers real history when you came from within the site.
const back = seen
	? { href: '/films/watched', label: 'Films watched' }
	: { href: '/films/watchlist', label: 'Watchlist' };

// The YTS search the watchlist tiles used to link out to directly, now the
// "Download" action on the film itself. Owner-only, as those links were.
const downloadHref = ytsUrl(movie.title, movie.release_year);

// Whether this film is actually in the Jellyfin library can't be answered here —
// the server is tailnet-only and this render happens on Vercel. So we ship the
// config and let the page ask from the browser; see the script at the foot of the
// file. Null when Jellyfin isn't configured, which renders no button at all.
const jellyfin = isOwner ? jellyfinConfig() : null;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{movie.title} — Jason's film log</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&display=swap"
			rel="stylesheet"
		/>
		<link rel="preconnect" href="https://image.tmdb.org" />
	</head>
	<body>
		<div class="page">
			<!-- Backdrop -->
			<div class="backdrop" style={backdrop ? `background-image:url(${backdrop})` : undefined}>
				<div class="backdrop__scrim"></div>
				<div class="backdrop__bar">
					<div class="wrap">
						<a class="back" href={back.href}>
							<span class="back__arrow">←</span><span>{back.label}</span>
						</a>
					</div>
				</div>
			</div>

			<!-- Content -->
			<div class="content">
				<div class="wrap layout">
					<!-- Left: poster, then your activity (seen) or what to do about it (not) -->
					<aside class="col-left">
						<div class="poster">
							{/* The one poster on the page and the largest thing above the
							    fold — this is the image to fetch first, not to defer. */}
							{poster && (
								<img src={poster} alt={`${movie.title} poster`} fetchpriority="high" />
							)}
							{!seen && <span class="poster__badge">Not seen</span>}
							<div class="poster__title">
								{movie.title}
								{movie.release_year && <span class="poster__year">{movie.release_year}</span>}
							</div>
						</div>

						{isOwner && (
							<button type="button" class="btn-primary" data-open-entry-editor>
								{logButtonLabel}
							</button>
						)}

						{/* Sits above the seen/unseen split because it belongs to both: a
						    film you've watched is the one you're most likely to put on
						    again. Ships hidden and is revealed only once the browser has
						    reached Jellyfin and found this film in the library — so off
						    the tailnet, nothing here ever appears. */}
						{jellyfin && (
							<button
								type="button"
								class="btn-ghost btn-ghost--play"
								id="jellyfin-play"
								data-bases={JSON.stringify(jellyfin.baseUrls)}
								data-local={jellyfin.localUrl ?? ''}
								data-key={jellyfin.apiKey}
								data-tmdb={movie.tmdb_id}
								hidden
							>
								<span class="btn-ghost__icon">▶</span><span data-label>Play</span>
							</button>
						)}

						{seen ? (
							<div class="activity">
								<div class="activity__head">Your activity</div>
								<div class="activity__row">
									<span class="activity__key">Your rating</span>
									<span class="stars">{yourRating || '—'}</span>
								</div>
								<div class="activity__row">
									<span class="activity__key">Liked</span>
									<span class="stars">{activityLiked ? '♥' : '—'}</span>
								</div>
								<div class="activity__row">
									<span class="activity__key">Watched</span>
									<span class="activity__val">{yourWatched ?? '—'}</span>
								</div>
							</div>
						) : (
							isOwner && (
								<>
									<a class="btn-ghost" href={downloadHref} target="_blank" rel="noopener noreferrer">
										<span class="btn-ghost__icon">↓</span><span>Download</span>
									</a>
									{/* Label and pressed state are re-rendered by the toggle script. */}
									<button
										type="button"
										class="btn-ghost btn-ghost--toggle"
										id="watchlist-toggle"
										data-tmdb-id={movie.tmdb_id}
										data-on={onWatchlist ? '1' : undefined}
										aria-pressed={onWatchlist ? 'true' : 'false'}
									>
										{onWatchlist ? '✓ On watchlist' : '+ Add to watchlist'}
									</button>
								</>
							)
						)}
					</aside>

					<!-- Right: details -->
					<div class="col-right">
						<h1>
							{movie.title}
							{movie.release_year && <span class="h1-year">{movie.release_year}</span>}
						</h1>

						{directors.length > 0 && (
							<div class="directed">
								Directed by{' '}
								{directors.map((d, i) => (
									<>
										{i > 0 && ', '}
										<a class="directed__name" href={filterHref('director', d, 'year')}>{d}</a>
									</>
								))}
							</div>
						)}

						{(mpaRating || metaItems.length > 0) && (
							<div class="meta">
								{mpaRating && <span class="cert" title="US content rating">{mpaRating}</span>}
								{metaItems.map((item, i) => (
									<>
										{i > 0 && <span class="meta__dot">·</span>}
										<span class="meta__dim">{item}</span>
									</>
								))}
							</div>
						)}

						{genres.length > 0 && (
							<div class="genres">
								{genres.map((g) => (
									<a class="genre" href={filterHref('genre', g)}>{g}</a>
								))}
							</div>
						)}

						{movie.overview && <p class="synopsis">{movie.overview}</p>}

						{cast.length > 0 && (
							<section class="block">
								<div class="block__head">Cast</div>
								<div class="cast">
									{cast.map((c) => (
										<a class="cast__chip" href={filterHref('actor', c, 'year')}>{c}</a>
									))}
								</div>
							</section>
						)}

						{seen ? (
							<section class="block">
								<div class="block__head block__head--row">
									<span>Your reviews</span>
									<span class="block__count">{movieLogs.length} {movieLogs.length === 1 ? 'entry' : 'entries'}</span>
								</div>
								{movieLogs.length === 0 ? (
									<p class="empty">No review yet — just marked watched.</p>
								) : (
									<div class="reviews">
										{movieLogs.map((r) => (
											<article class="review">
												<div class="review__meta">
													{r.rating != null && <span class="stars">{starText(r.rating)}</span>}
													{r.liked && <span class="stars review__heart">♥</span>}
													<span class="review__label">
														{r.rewatched ? 'Rewatch' : 'Watched'} · {logDate(r)}
													</span>
													<a class="review__view" href={`/films/diary/${r.id}`}>
														View <span class="review__view-arrow">→</span>
													</a>
												</div>
												{r.review_text && <p class="review__text">{r.review_text}</p>}
											</article>
										))}
									</div>
								)}
							</section>
						) : (
							related.length > 0 && (
								<section class="block">
									<div class="block__head">If you liked</div>
									<div class="related">
										{related.map((f) => {
											const src = imageUrl(f.poster_path, 'w185');
											return (
												<a class="related__tile" href={`/films/movie/${f.tmdb_id}`}>
													<div class="related__art">
														{src && (
															<img data-poster={src} alt={`${f.title} poster`} decoding="async" />
														)}
													</div>
													<span class="related__title">{f.title}</span>
													{f.sharedDirector && (
														<span class="related__why">Same director</span>
													)}
												</a>
											);
										})}
									</div>
								</section>
							)
						)}

						<footer class="attribution">
							Metadata from{' '}
							<a href={tmdbUrl} rel="noopener" target="_blank">TMDB ↗</a>. This product uses the
							TMDB API but is not endorsed or certified by TMDB.
						</footer>
					</div>
				</div>
			</div>
		</div>

		{/* The "If you liked" posters are below the fold and secondary to this film's
		    own — they wait for the page to paint. */}
		{related.length > 0 && <PosterLoader />}

		{/* Entry editor (owner only): the log button and every review's Edit share it. */}
		{isOwner && (
			<EntryEditor
				mode="log"
				film={editorFilm}
				venueOptions={venueOptions}
				tagOptions={tagOptions}
				friendOptions={friendOptions}
				redirect={filmHref}
				deleteRedirect={filmHref}
			/>
		)}

		<style>
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
			}
			body {
				background: #1c0d0e;
				color: #f4e8d1;
				font-family: 'Archivo', Arial, sans-serif;
				-webkit-font-smoothing: antialiased;
			}
			a {
				text-decoration: none;
				color: #d9b45a;
			}
			.page {
				min-height: 100vh;
				background: #1c0d0e;
			}
			.wrap {
				width: 100%;
				max-width: 960px;
				margin: 0 auto;
				padding: 0 24px;
			}

			/* Backdrop */
			.backdrop {
				position: relative;
				height: 360px;
				background-color: #2c1518;
				background-image: repeating-linear-gradient(135deg, #3a1c20 0 14px, #2c1518 14px 28px);
				background-size: cover;
				background-position: center;
				overflow: hidden;
			}
			.backdrop__scrim {
				position: absolute;
				inset: 0;
				background: linear-gradient(
					180deg,
					rgba(28, 13, 14, 0.35) 0%,
					rgba(28, 13, 14, 0.72) 55%,
					#1c0d0e 100%
				);
			}
			.backdrop__bar {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				padding: 24px 0;
			}
			.back {
				display: inline-flex;
				align-items: center;
				gap: 9px;
				font-size: 13px;
				color: #e9d9c4;
			}
			.back:hover {
				color: #fff;
			}
			.back__arrow {
				font-size: 15px;
			}

			/* Content layout */
			.content {
				padding-bottom: 80px;
			}
			.layout {
				margin-top: -150px;
				position: relative;
				display: grid;
				grid-template-columns: 230px 1fr;
				gap: 36px;
				align-items: start;
			}

			/* Left column */
			.col-left {
				display: flex;
				flex-direction: column;
				gap: 18px;
			}
			.poster {
				position: relative;
				aspect-ratio: 2 / 3;
				border-radius: 7px;
				overflow: hidden;
				background-image: repeating-linear-gradient(135deg, #351a1d 0 9px, #2c1518 9px 18px);
				border: 1px solid #4a2529;
				box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.6);
				display: flex;
				align-items: flex-end;
			}
			.poster img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.poster__title {
				position: relative;
				padding: 14px;
				font-family: 'Newsreader', serif;
				font-size: 18px;
				color: #f2e5cd;
				line-height: 1.2;
			}
			.poster img ~ .poster__title {
				/* Hidden when a real poster is present. */
				display: none;
			}
			.poster__year {
				color: #b0917f;
				font-style: italic;
				font-size: 15px;
				margin-left: 4px;
			}
			/* Sits over the artwork, so it reads on a real poster as well as on the
			   striped placeholder behind it. */
			.poster__badge {
				position: absolute;
				top: 12px;
				left: 12px;
				font-size: 10px;
				font-weight: 700;
				letter-spacing: 1.2px;
				text-transform: uppercase;
				color: #e9d9c4;
				background: rgba(28, 13, 14, 0.72);
				border: 1px solid #5d3036;
				border-radius: 20px;
				padding: 4px 10px;
			}

			.activity {
				background: #2a1214;
				border: 1px solid #4a2529;
				border-radius: 10px;
				padding: 16px 16px 18px;
			}
			.activity__head {
				font-size: 11px;
				text-transform: uppercase;
				letter-spacing: 1.4px;
				color: #8a6f63;
				margin-bottom: 12px;
			}
			.activity__row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 10px;
			}
			.activity__row:last-child {
				margin-bottom: 0;
			}
			.activity__key {
				font-size: 12px;
				color: #a2857a;
			}
			.activity__val {
				font-size: 13px;
				color: #e9d9c4;
			}
			.stars {
				color: #d9b45a;
				font-size: 15px;
				letter-spacing: 1px;
				white-space: nowrap;
			}

			.btn-primary {
				width: 100%;
				font-size: 14px;
				font-weight: 700;
				color: #2a1214;
				background: #d9b45a;
				border: none;
				border-radius: 9px;
				padding: 12px;
				cursor: pointer;
				font-family: 'Archivo', sans-serif;
			}
			.btn-primary:hover {
				background: #f0d488;
			}
			/* Download / watchlist: one outlined shape shared by a link and a button, so
			   they stack as a matched pair under the primary action. */
			.btn-ghost {
				width: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 8px;
				line-height: 15px;
				font-size: 13px;
				font-weight: 600;
				font-family: 'Archivo', sans-serif;
				border-radius: 9px;
				padding: 11px;
				background: transparent;
				border: 1px solid #4a2529;
				color: #c2a99a;
				cursor: pointer;
			}
			.btn-ghost:hover {
				border-color: #d9b45a;
				color: #f4e8d1;
			}
			.btn-ghost__icon {
				font-size: 13px;
			}
			/* Off the watchlist is the state that invites a click, so it carries the
			   brighter border and text; on it, the button recedes. */
			.btn-ghost--toggle:not([data-on]) {
				border-color: #5d3036;
				color: #e9d9c4;
			}
			.btn-ghost--toggle[disabled] {
				opacity: 0.6;
				cursor: default;
			}
			/* Having the file on hand is the best outcome the page can offer, so when
			   this button does appear it outranks Download and the watchlist toggle. */
			.btn-ghost--play {
				border-color: #d9b45a;
				color: #f4e8d1;
			}
			.btn-ghost--play:hover {
				background: #d9b45a;
				border-color: #d9b45a;
				color: #2a1518;
			}
			.btn-ghost--play[disabled] {
				opacity: 0.6;
				cursor: default;
			}
			/* Reaching a sleeping machine takes a moment; dim rather than jump. */
			.btn-ghost--play[data-busy] {
				color: #c2a99a;
				border-color: #5d3036;
			}

			/* Right column */
			.col-right {
				padding-top: 150px;
			}
			h1 {
				font-family: 'Newsreader', serif;
				font-weight: 500;
				font-size: 46px;
				color: #f4e8d1;
				letter-spacing: -0.5px;
				line-height: 1.02;
				margin: 0;
			}
			.h1-year {
				color: #a2857a;
				font-style: italic;
				font-weight: 400;
				font-size: 32px;
				margin-left: 8px;
			}
			.directed {
				font-size: 14px;
				color: #c2a99a;
				margin-top: 10px;
			}
			.directed__name {
				color: #f2e5cd;
				font-weight: 600;
			}
			.directed__name:hover {
				color: #f0d488;
			}
			.meta {
