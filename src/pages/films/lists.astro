---
import FilmLayout from '../../layouts/FilmLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { listFilmLists } from '../../lib/film-lists';
import { imageUrl } from '../../lib/tmdb';
import { requireOwner } from '../../lib/auth';

// Rendered on demand — reflects the live database.
export const prerender = false;

const isOwner = await requireOwner(Astro.cookies);

const lists = await listFilmLists(isOwner);
---

<FilmLayout title="Lists — Jason's film log">
	<div class="page">
		<div class="wrap">
			<SiteHeader pathname={Astro.url.pathname} theme="film" max="1064px" />

			<header class="topbar">
				<a class="back" href="/films">
					<span class="back__arrow">←</span><span>Jason's film log</span>
				</a>
				<span class="topbar__tag">Lists</span>
			</header>

			<div class="titleblock">
				<h1>Lists</h1>
				{isOwner && (
					<div class="actions">
						<form id="new-list" class="new">
							<input name="name" placeholder="New list…" autocomplete="off" aria-label="New list name" required />
							<button type="submit" class="btn">Create</button>
						</form>
						<a class="btn btn--ghost" href="/films/watched">Smart list →</a>
					</div>
				)}
			</div>

			{lists.length === 0 && <p class="empty">No lists yet.</p>}

			<ol class="lists" id="lists">
				{lists.map((l) => (
					<li class="row" data-id={l.id}>
						<a class="row__link" href={`/films/lists/${l.id}`}>
							<div class="row__posters">
								{l.preview.map((f) => {
									const src = imageUrl(f.poster_path, 'w185');
									return <div class="row__poster">{src && <img data-poster={src} alt="" decoding="async" />}</div>;
								})}
							</div>
							<div class="row__text">
								<div class="row__name">
									{l.name}
									{l.query != null && <span class="badge">Smart</span>}
								</div>
								{l.description && <p class="row__desc">{l.description}</p>}
								<div class="row__n">{l.total} {l.total === 1 ? 'film' : 'films'}</div>
							</div>
						</a>
						{isOwner && (
							<div class="row__order">
								<button type="button" class="move" data-move="-1" aria-label={`Move ${l.name} up`}>↑</button>
								<button type="button" class="move" data-move="1" aria-label={`Move ${l.name} down`}>↓</button>
							</div>
						)}
					</li>
				))}
			</ol>
		</div>
	</div>

	<style>
		.page {
			overflow-x: hidden;
			display: flex;
			justify-content: center;
			padding: 0 24px 80px;
		}
		.wrap {
			width: 100%;
			max-width: 1000px;
		}
		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 26px 0 22px;
			border-bottom: 1px solid #4a2529;
			margin-bottom: 34px;
		}
		.back {
			display: flex;
			align-items: center;
			gap: 9px;
			font-size: 13px;
			color: #a2857a;
		}
		.back:hover {
			color: #f4e8d1;
		}
		.back__arrow {
			font-size: 15px;
		}
		.topbar__tag {
			font-size: 11.5px;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #8a6f63;
		}
		.titleblock {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			flex-wrap: wrap;
			gap: 16px;
			margin-bottom: 26px;
		}
		h1 {
			font-family: var(--font-newsreader);
			font-weight: 500;
			font-size: 52px;
			color: #f4e8d1;
			letter-spacing: -0.5px;
			line-height: 1;
			margin: 0;
		}
		.actions,
		.new {
			display: flex;
			gap: 10px;
			flex-wrap: wrap;
		}
		.new input {
			width: 220px;
			max-width: 100%;
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 8px;
			padding: 10px 14px;
			color: #f4e8d1;
			font-size: 14px;
			font-family: var(--font-archivo);
			outline: none;
		}
		.new input:focus {
			border-color: #d9b45a;
		}
		.btn {
			font-size: 13px;
			font-weight: 700;
			font-family: var(--font-archivo);
			border-radius: 8px;
			padding: 10px 16px;
			cursor: pointer;
			color: #2a1214;
			background: #d9b45a;
			border: 1px solid #d9b45a;
		}
		.btn:hover {
			background: #f0d488;
		}
		.btn--ghost {
			color: #f0d488;
			background: transparent;
			border-color: #6b4a42;
		}
		.btn--ghost:hover {
			background: #241012;
			border-color: #d9b45a;
		}
		.empty {
			color: #8a6f63;
			font-family: var(--font-newsreader);
			font-style: italic;
			font-size: 17px;
		}
		.lists {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
		}
		.row {
			display: flex;
			align-items: center;
			gap: 12px;
			border-bottom: 1px solid #402226;
		}
		.row__link {
			flex: 1;
			min-width: 0;
			display: flex;
			align-items: center;
			gap: 22px;
			padding: 18px 0;
		}
		.row__posters {
			display: flex;
			flex: none;
		}
		.row__poster {
			width: 52px;
			aspect-ratio: 2 / 3;
			border-radius: 4px;
			overflow: hidden;
			background-image: repeating-linear-gradient(135deg, #351a1d 0 7px, #2c1518 7px 14px);
			border: 1px solid #4a2529;
			box-shadow: 4px 0 8px -2px rgba(0, 0, 0, 0.5);
		}
		.row__poster + .row__poster {
			margin-left: -18px;
		}
		.row__poster img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}
		.row__text {
			min-width: 0;
		}
		.row__name {
			font-family: var(--font-newsreader);
			font-size: 22px;
			color: #f4e8d1;
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 4px 10px;
		}
		.row__link:hover .row__name {
			color: #f0d488;
		}
		.badge {
			font-family: var(--font-archivo);
			font-size: 10px;
			font-weight: 700;
			letter-spacing: 1.2px;
			text-transform: uppercase;
			color: #d9b45a;
			border: 1px solid #6b4a42;
			border-radius: 20px;
			padding: 3px 8px;
		}
		.row__desc {
			margin: 4px 0 0;
			font-size: 13px;
			color: #c2a99a;
			line-height: 1.5;
		}
		.row__n {
			margin-top: 4px;
			font-size: 12px;
			color: #8a6f63;
		}
		.row__order {
			display: flex;
			flex-direction: column;
			gap: 4px;
		}
		.move {
			width: 30px;
			height: 26px;
			font-size: 13px;
			background: transparent;
			border: 1px solid #4a2529;
			border-radius: 6px;
			color: #c2a99a;
			cursor: pointer;
		}
		.move:hover {
			border-color: #d9b45a;
			color: #f4e8d1;
		}
		@media (max-width: 560px) {
			h1 {
				font-size: 40px;
			}
			.row__link {
				gap: 14px;
			}
			.row__poster {
				width: 40px;
			}
			.row__poster:nth-child(n + 4) {
				display: none;
			}
		}
	</style>

	<script>
		const form = document.getElementById('new-list');

		if (form instanceof HTMLFormElement) {
			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const name = new FormData(form).get('name');

				const res = await fetch('/api/films/lists', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ name }),
				});

				if (res.ok) location.href = `/films/lists/${(await res.json()).id}`;
			});
		}

		// Reorder: move the row in the DOM straight away, then save the whole order.
		const lists = document.getElementById('lists');

		lists?.addEventListener('click', async (e) => {
			const btn = e.target instanceof Element ? e.target.closest<HTMLButtonElement>('[data-move]') : null;
			const row = btn?.closest('li');

			if (!btn || !row) return;

			if (btn.dataset.move === '-1') row.previousElementSibling?.before(row);
			else row.nextElementSibling?.after(row);
			btn.focus();

			const order = [...lists.querySelectorAll<HTMLElement>(':scope > li')].map((li) => Number(li.dataset.id));

			await fetch('/api/films/lists', {
				method: 'PATCH',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ order }),
			});
		});
	</script>
</FilmLayout>
