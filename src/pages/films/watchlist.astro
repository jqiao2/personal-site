---
import FilmLayout from '../../layouts/FilmLayout.astro';
import { listAllWatchlist } from '../../lib/films';
import { requireOwner } from '../../lib/auth';
import { imageUrl } from '../../lib/tmdb';

// Rendered on demand — reflects the live database.
export const prerender = false;

const [films, isOwner] = await Promise.all([listAllWatchlist(), requireOwner(Astro.cookies)]);

/** "YYYY-MM-DD" (or ISO timestamp) → "Jul 8", or "Aug 30, 2025" when it's not the current year. */
const currentYear = new Date().getFullYear();
function shortDate(date: string | null): string {
	if (!date) return '';
	const [y, m, d] = date.slice(0, 10).split('-').map(Number);
	if (!y || !m || !d) return '';
	const opts: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric' };
	if (y !== currentYear) opts.year = 'numeric';
	return new Date(y, m - 1, d).toLocaleDateString('en-US', opts);
}

const num = (n: number) => n.toLocaleString('en-US');

/** YTS search URL for a film, e.g. "bridge of spies 2015" → …/browse-movies/bridge%20of%20spies%202015/all/all/0/latest/0/all */
function ytsUrl(title: string, year: number | null): string {
	const query = year ? `${title} ${year}` : title;
	return `https://yts.gg/browse-movies/${encodeURIComponent(query.toLowerCase())}/all/all/0/latest/0/all`;
}
---

<FilmLayout title="Watchlist — Jason's film log">
	<div class="page">
		<div class="wrap">
			<header class="topbar">
				<a class="back" href="/films">
					<span class="back__arrow">←</span><span>Jason's film log</span>
				</a>
				<span class="topbar__tag">Watchlist</span>
			</header>

			<div class="titleblock">
				<div class="titleblock__left">
					<div class="titleblock__head">
						<h1>Watchlist</h1>
						{isOwner && (
							<button type="button" class="add-btn" id="open-composer">+ Add film</button>
						)}
					</div>
					<div class="sub">
						<span class="sub__n" id="wl-count">{num(films.length)}</span>
						<span id="wl-noun">{films.length === 1 ? ' film' : ' films'}</span> · the next screening awaits
					</div>
				</div>
				<div class="sortby">
					<span class="sortby__label">Sort by</span>
					<span class="sortby__pill">Recently added ▾</span>
				</div>
			</div>

			<p class="empty" id="empty" hidden={films.length > 0}>Nothing on the watchlist yet.</p>

			<div class="grid" id="grid">
				{films.map((f) => (
					<div class="item" data-tmdb-id={f.tmdb_id}>
						{isOwner && (
							<button type="button" class="remove" aria-label={`Remove ${f.title} from watchlist`}>✕</button>
						)}
						{isOwner ? (
							<a class="tile" href={ytsUrl(f.title, f.release_year)} target="_blank" rel="noopener noreferrer">
								{imageUrl(f.poster_path, 'w342') && (
									<img src={imageUrl(f.poster_path, 'w342')} alt={`${f.title} poster`} loading="lazy" />
								)}
								<div class="tile__cap">
									{f.title} <span class="tile__year">{f.release_year}</span>
								</div>
							</a>
						) : (
							<div class="tile">
								{imageUrl(f.poster_path, 'w342') && (
									<img src={imageUrl(f.poster_path, 'w342')} alt={`${f.title} poster`} loading="lazy" />
								)}
								<div class="tile__cap">
									{f.title} <span class="tile__year">{f.release_year}</span>
								</div>
							</div>
						)}
						<div class="item__added">Added {shortDate(f.added_at)}</div>
					</div>
				))}
			</div>
		</div>
	</div>

	{isOwner && (
		<div class="modal" id="composer" hidden>
			<div class="modal__backdrop" id="composer-backdrop"></div>
			<div class="modal__panel" role="dialog" aria-modal="true" aria-label="Add a film to your watchlist">
				<div class="modal__head">
					<span class="modal__title">Add to watchlist</span>
					<button type="button" class="modal__close" id="composer-close" aria-label="Close">✕</button>
				</div>

				<div class="modal__body">
					<label class="lbl" for="c-q">Film</label>
					<div class="search" id="c-search">
						<input type="text" id="c-q" placeholder="Search a film…" autocomplete="off" />
						<ul class="results" id="c-results" hidden></ul>
					</div>
					<div class="selected" id="c-selected" hidden>
						<img id="c-sel-poster" alt="" width="26" height="39" />
						<span id="c-sel-title"></span>
						<button type="button" class="link" id="c-change">change</button>
					</div>
				</div>

				<div class="modal__foot">
					<span class="save-msg" id="save-msg"></span>
					<button type="button" class="btn-ghost" id="composer-cancel">Cancel</button>
					<button type="button" class="btn-save" id="composer-save" disabled>Add film</button>
				</div>
			</div>
		</div>
	)}

	<style>
		.page {
			display: flex;
			justify-content: center;
			padding: 0 24px 80px;
		}
		.wrap {
			width: 100%;
			max-width: 960px;
		}
		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 26px 0 22px;
			border-bottom: 1px solid #4a2529;
			margin-bottom: 34px;
		}
		.back {
			display: flex;
			align-items: center;
			gap: 9px;
			font-size: 13px;
			color: #a2857a;
		}
		.back:hover {
			color: #f4e8d1;
		}
		.back__arrow {
			font-size: 15px;
		}
		.topbar__tag {
			font-size: 11.5px;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #8a6f63;
		}

		.titleblock {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			margin-bottom: 36px;
			flex-wrap: wrap;
			gap: 16px;
		}
		.titleblock__head {
			display: flex;
			align-items: center;
			gap: 18px;
		}
		h1 {
			font-family: 'Newsreader', serif;
			font-weight: 500;
			font-size: 52px;
			color: #f4e8d1;
			letter-spacing: -0.5px;
			line-height: 1;
			margin: 0;
		}
		.add-btn {
			font-size: 13px;
			font-weight: 700;
			color: #2a1214;
			background: #d9b45a;
			border: none;
			border-radius: 8px;
			padding: 10px 18px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			white-space: nowrap;
		}
		.add-btn:hover {
			background: #f0d488;
		}
		.sub {
			font-size: 13px;
			color: #a2857a;
			margin-top: 10px;
		}
		.sub__n {
			color: #d9b45a;
			font-weight: 600;
		}
		.sortby {
			display: flex;
			align-items: center;
			gap: 8px;
		}
		.sortby__label {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
		}
		.sortby__pill {
			font-size: 13px;
			color: #f2e5cd;
			border: 1px solid #4a2529;
			border-radius: 20px;
			padding: 7px 14px;
			background: #331619;
		}

		.grid {
			display: grid;
			grid-template-columns: repeat(6, 1fr);
			gap: 18px;
		}
		.item {
			position: relative;
		}
		.remove {
			position: absolute;
			top: 7px;
			right: 7px;
			z-index: 2;
			width: 26px;
			height: 26px;
			border-radius: 50%;
			background: rgba(20, 8, 9, 0.82);
			border: 1px solid #4a2529;
			color: #f2e5cd;
			font-size: 12px;
			line-height: 1;
			cursor: pointer;
			opacity: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			transition: opacity 0.12s, background 0.12s, color 0.12s;
		}
		.item:hover .remove,
		.remove:focus-visible {
			opacity: 1;
		}
		.remove:hover {
			background: #d9b45a;
			color: #2a1214;
			border-color: #d9b45a;
		}
		.remove:disabled {
			cursor: default;
			opacity: 0.5;
		}
		.tile {
			position: relative;
			color: inherit;
			aspect-ratio: 2 / 3;
			border-radius: 5px;
			overflow: hidden;
			background-image: repeating-linear-gradient(135deg, #351a1d 0 9px, #2c1518 9px 18px);
			border: 1px solid #4a2529;
			display: flex;
			align-items: flex-end;
			transition: border-color 0.12s;
		}
		.item:hover .tile {
			border-color: #d9b45a;
		}
		.tile img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.tile__cap {
			position: relative;
			padding: 10px;
			font-family: 'Newsreader', serif;
			font-size: 13px;
			font-weight: 500;
			color: #f2e5cd;
			line-height: 1.2;
		}
		.tile img ~ .tile__cap {
			display: none;
		}
		.tile__year {
			color: #b0917f;
			font-style: italic;
		}
		.item__added {
			font-size: 11px;
			color: #8a6f63;
			margin-top: 6px;
		}
		.empty {
			color: #8a6f63;
		}
		.empty[hidden] {
			display: none;
		}

		/* Add-to-watchlist modal */
		.modal {
			position: fixed;
			inset: 0;
			z-index: 50;
			display: flex;
			align-items: flex-start;
			justify-content: center;
			padding: 72px 24px;
		}
		.modal[hidden] {
			display: none;
		}
		.modal__backdrop {
			position: absolute;
			inset: 0;
			background: rgba(10, 4, 5, 0.72);
			backdrop-filter: blur(3px);
		}
		.modal__panel {
			position: relative;
			width: 100%;
			max-width: 480px;
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 14px;
			box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.7);
			overflow: hidden;
		}
		.modal__head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 20px 24px;
			border-bottom: 1px solid #402226;
		}
		.modal__title {
			font-family: 'Newsreader', serif;
			font-style: italic;
			font-size: 22px;
			color: #f4e8d1;
		}
		.modal__close {
			width: 30px;
			height: 30px;
			border: 1px solid #4a2529;
			background: transparent;
			color: #c2a99a;
			border-radius: 7px;
			cursor: pointer;
			font-size: 14px;
			line-height: 1;
		}
		.modal__close:hover {
			background: #402226;
			color: #f4e8d1;
		}
		.modal__body {
			padding: 22px 24px 26px;
		}
		.lbl {
			display: block;
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
			margin-bottom: 7px;
		}
		.search {
			position: relative;
		}
		#c-q {
			width: 100%;
			background: #1c0d0e;
			border: 1px solid #4a2529;
			border-radius: 8px;
			color: #f4e8d1;
			font-family: 'Archivo', sans-serif;
			padding: 11px 13px;
			font-size: 14px;
			outline: none;
		}
		#c-q:focus {
			border-color: #d9b45a;
		}
		.results {
			list-style: none;
			margin: 6px 0 0;
			padding: 0;
			position: absolute;
			z-index: 10;
			width: 100%;
			max-height: 300px;
			overflow-y: auto;
			background: #1c0d0e;
			border: 1px solid #4a2529;
			border-radius: 8px;
		}
		.results :global(li) {
			display: flex;
			gap: 10px;
			align-items: center;
			padding: 7px 9px;
			cursor: pointer;
			color: #e9d9c4;
			font-size: 13px;
		}
		.results :global(li:hover) {
			background: #331619;
		}
		.results :global(img) {
			width: 30px;
			height: 45px;
			object-fit: cover;
			border-radius: 3px;
			background: #4a2529;
			flex-shrink: 0;
		}
		.results :global(.r-year) {
			color: #a2857a;
			margin-left: 6px;
		}
		.selected {
			display: flex;
			align-items: center;
			gap: 10px;
			margin-top: 12px;
			font-family: 'Newsreader', serif;
			font-size: 15px;
			color: #f2e5cd;
		}
		.selected img {
			object-fit: cover;
			border-radius: 3px;
			background: #4a2529;
		}
		.link {
			background: none;
			border: none;
			color: #a2857a;
			cursor: pointer;
			font-size: 12px;
			text-decoration: underline;
			font-family: 'Archivo', sans-serif;
			padding: 0;
		}
		.link:hover {
			color: #f4e8d1;
		}
		.modal__foot {
			display: flex;
			align-items: center;
			justify-content: flex-end;
			gap: 12px;
			padding: 16px 24px;
			border-top: 1px solid #402226;
			background: #1f0e10;
		}
		.btn-ghost {
			font-size: 14px;
			font-weight: 600;
			color: #ddc9b4;
			background: transparent;
			border: 1px solid #4a2529;
			border-radius: 8px;
			padding: 10px 20px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
		}
		.btn-ghost:hover {
			border-color: #a2857a;
			color: #f4e8d1;
		}
		.btn-save {
			font-size: 14px;
			font-weight: 700;
			border: none;
			border-radius: 8px;
			padding: 10px 22px;
			font-family: 'Archivo', sans-serif;
			background: #d9b45a;
			color: #2a1214;
			cursor: pointer;
		}
		.btn-save:disabled {
			background: #4a2529;
			color: #8a6f63;
			cursor: not-allowed;
		}
		.save-msg {
			font-size: 13px;
			color: #a2857a;
			margin-right: auto;
		}
		.save-msg.error {
			color: #e0736f;
		}

		@media (max-width: 860px) {
			.grid {
				grid-template-columns: repeat(4, 1fr);
			}
		}
		@media (max-width: 560px) {
			h1 {
				font-size: 40px;
			}
			.grid {
				grid-template-columns: repeat(3, 1fr);
			}
		}
	</style>

	<script>
		// Owner-only controls. Astro always hoists this script; bail out cleanly when
		// the owner-only elements aren't in the DOM (a visitor viewing the page).
		const REDIRECT = '/films/login?redirect=/films/watchlist';

		// --- Remove a film from the watchlist ---
		const grid = document.getElementById('grid');
		grid?.addEventListener('click', async (e) => {
			const btn = (e.target as HTMLElement).closest('.remove') as HTMLButtonElement | null;
			if (!btn) return;
			const item = btn.closest('.item') as HTMLElement;
			const tmdbId = item.dataset.tmdbId;
			if (!tmdbId) return;
			btn.disabled = true;
			try {
				const res = await fetch(`/api/films/watchlist?tmdbId=${tmdbId}`, { method: 'DELETE' });
				if (res.status === 401) {
					window.location.href = REDIRECT;
					return;
				}
				if (!res.ok) throw new Error();
				item.remove();
				updateCount(-1);
			} catch {
				btn.disabled = false;
			}
		});

		function updateCount(delta: number) {
			const countEl = document.getElementById('wl-count');
			const nounEl = document.getElementById('wl-noun');
			const empty = document.getElementById('empty');
			if (!countEl) return;
			const n = Math.max(0, Number(countEl.textContent?.replace(/,/g, '') || '0') + delta);
			countEl.textContent = n.toLocaleString('en-US');
			if (nounEl) nounEl.textContent = n === 1 ? ' film' : ' films';
			if (empty) empty.hidden = n > 0;
		}

		// --- Add a film to the watchlist (search overlay) ---
		const openBtn = document.getElementById('open-composer');
		const modal = document.getElementById('composer') as HTMLDivElement | null;

		if (openBtn && modal) {
			const IMG = 'https://image.tmdb.org/t/p/w92';
			const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
			const close = $('composer-close');
			const cancel = $('composer-cancel');
			const backdrop = $('composer-backdrop');
			const save = $<HTMLButtonElement>('composer-save');
			const msg = $<HTMLSpanElement>('save-msg');
			const q = $<HTMLInputElement>('c-q');
			const results = $<HTMLUListElement>('c-results');
			const searchWrap = $('c-search');
			const selected = $('c-selected');
			const selPoster = $<HTMLImageElement>('c-sel-poster');
			const selTitle = $<HTMLSpanElement>('c-sel-title');
			const change = $('c-change');

			let tmdbId: number | null = null;

			// --- TMDB search (debounced) ---
			let timer: number | undefined;
			q.addEventListener('input', () => {
				window.clearTimeout(timer);
				const query = q.value.trim();
				if (!query) return hideResults();
				timer = window.setTimeout(() => runSearch(query), 300);
			});
			async function runSearch(query: string) {
				try {
					const res = await fetch(`/api/tmdb/search?query=${encodeURIComponent(query)}`);
					if (!res.ok) return hideResults();
					const data = await res.json();
					renderResults(data.results ?? []);
				} catch {
					hideResults();
				}
			}
			function renderResults(items: any[]) {
				results.textContent = '';
				if (!items.length) return hideResults();
				for (const m of items.slice(0, 8)) {
					const li = document.createElement('li');
					const img = document.createElement('img');
					if (m.poster_path) img.src = IMG + m.poster_path;
					img.alt = '';
					const label = document.createElement('span');
					label.textContent = m.title;
					if (m.release_date) {
						const yr = document.createElement('span');
						yr.className = 'r-year';
						yr.textContent = m.release_date.slice(0, 4);
						label.appendChild(yr);
					}
					li.append(img, label);
					li.addEventListener('click', () => selectMovie(m));
					results.appendChild(li);
				}
				results.hidden = false;
			}
			function hideResults() {
				results.hidden = true;
				results.textContent = '';
			}
			function selectMovie(m: any) {
				tmdbId = m.id;
				selTitle.textContent = m.title + (m.release_date ? ` (${m.release_date.slice(0, 4)})` : '');
				if (m.poster_path) {
					selPoster.src = IMG + m.poster_path;
					selPoster.hidden = false;
				} else {
					selPoster.removeAttribute('src');
					selPoster.hidden = true;
				}
				hideResults();
				searchWrap.hidden = true;
				selected.hidden = false;
				save.disabled = false;
				msg.className = 'save-msg';
				msg.textContent = '';
			}
			change.addEventListener('click', () => {
				tmdbId = null;
				selected.hidden = true;
				searchWrap.hidden = false;
				save.disabled = true;
				q.value = '';
				q.focus();
			});
			document.addEventListener('click', (e) => {
				if (!searchWrap.contains(e.target as Node)) hideResults();
			});

			const closeModal = () => {
				modal.hidden = true;
			};
			const openModal = () => {
				modal.hidden = false;
				q.focus();
			};
			openBtn.addEventListener('click', openModal);
			close.addEventListener('click', closeModal);
			cancel.addEventListener('click', closeModal);
			backdrop.addEventListener('click', closeModal);
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && !modal.hidden) closeModal();
			});

			save.addEventListener('click', async () => {
				if (!tmdbId) return;
				save.disabled = true;
				msg.className = 'save-msg';
				msg.textContent = 'Adding…';
				try {
					const res = await fetch('/api/films/watchlist', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ tmdbId }),
					});
					if (res.status === 401) {
						window.location.href = REDIRECT;
						return;
					}
					const data = await res.json().catch(() => ({}));
					if (!res.ok) throw new Error(data.error || 'Add failed');
					// New entries sort to the top (added just now) — reload to show it.
					window.location.reload();
				} catch (err) {
					msg.className = 'save-msg error';
					msg.textContent = err instanceof Error ? err.message : 'Add failed';
					save.disabled = false;
				}
			});
		}
	</script>
</FilmLayout>
