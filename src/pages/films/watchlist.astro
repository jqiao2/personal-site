---
import FilmLayout from '../../layouts/FilmLayout.astro';
import { listAllWatchlist } from '../../lib/films';
import { imageUrl } from '../../lib/tmdb';

// Rendered on demand — reflects the live database.
export const prerender = false;

const films = await listAllWatchlist();

/** "YYYY-MM-DD" (or ISO timestamp) → "Jul 8". */
function shortDate(date: string | null): string {
	if (!date) return '';
	const [y, m, d] = date.slice(0, 10).split('-').map(Number);
	if (!y || !m || !d) return '';
	return new Date(y, m - 1, d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

const num = (n: number) => n.toLocaleString('en-US');
---

<FilmLayout title="Watchlist — Jason's film log">
	<div class="page">
		<div class="wrap">
			<header class="topbar">
				<a class="back" href="/films">
					<span class="back__arrow">←</span><span>Jason's film log</span>
				</a>
				<span class="topbar__tag">Watchlist</span>
			</header>

			<div class="titleblock">
				<div>
					<h1>Watchlist</h1>
					<div class="sub">
						<span class="sub__n">{num(films.length)}</span>
						{films.length === 1 ? ' film' : ' films'} · the next screening awaits
					</div>
				</div>
				<div class="sortby">
					<span class="sortby__label">Sort by</span>
					<span class="sortby__pill">Recently added ▾</span>
				</div>
			</div>

			{films.length === 0 ? (
				<p class="empty">Nothing on the watchlist yet.</p>
			) : (
				<div class="grid">
					{films.map((f) => (
						<div class="item">
							<div class="tile">
								{imageUrl(f.poster_path, 'w342') && (
									<img src={imageUrl(f.poster_path, 'w342')} alt={`${f.title} poster`} loading="lazy" />
								)}
								<div class="tile__cap">
									{f.title} <span class="tile__year">{f.release_year}</span>
								</div>
							</div>
							<div class="item__added">Added {shortDate(f.added_at)}</div>
						</div>
					))}
				</div>
			)}
		</div>
	</div>

	<style>
		.page {
			display: flex;
			justify-content: center;
			padding: 0 24px 80px;
		}
		.wrap {
			width: 100%;
			max-width: 960px;
		}
		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 26px 0 22px;
			border-bottom: 1px solid #4a2529;
			margin-bottom: 34px;
		}
		.back {
			display: flex;
			align-items: center;
			gap: 9px;
			font-size: 13px;
			color: #a2857a;
		}
		.back:hover {
			color: #f4e8d1;
		}
		.back__arrow {
			font-size: 15px;
		}
		.topbar__tag {
			font-size: 11.5px;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #8a6f63;
		}

		.titleblock {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			margin-bottom: 36px;
			flex-wrap: wrap;
			gap: 16px;
		}
		h1 {
			font-family: 'Newsreader', serif;
			font-weight: 500;
			font-size: 52px;
			color: #f4e8d1;
			letter-spacing: -0.5px;
			line-height: 1;
			margin: 0;
		}
		.sub {
			font-size: 13px;
			color: #a2857a;
			margin-top: 10px;
		}
		.sub__n {
			color: #d9b45a;
			font-weight: 600;
		}
		.sortby {
			display: flex;
			align-items: center;
			gap: 8px;
		}
		.sortby__label {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
		}
		.sortby__pill {
			font-size: 13px;
			color: #f2e5cd;
			border: 1px solid #4a2529;
			border-radius: 20px;
			padding: 7px 14px;
			background: #331619;
		}

		.grid {
			display: grid;
			grid-template-columns: repeat(6, 1fr);
			gap: 18px;
		}
		.tile {
			position: relative;
			aspect-ratio: 2 / 3;
			border-radius: 5px;
			overflow: hidden;
			background-image: repeating-linear-gradient(135deg, #351a1d 0 9px, #2c1518 9px 18px);
			border: 1px solid #4a2529;
			display: flex;
			align-items: flex-end;
			transition: border-color 0.12s;
		}
		.tile:hover {
			border-color: #d9b45a;
		}
		.tile img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.tile__cap {
			position: relative;
			padding: 10px;
			font-family: 'Newsreader', serif;
			font-size: 13px;
			font-weight: 500;
			color: #f2e5cd;
			line-height: 1.2;
		}
		.tile img ~ .tile__cap {
			display: none;
		}
		.tile__year {
			color: #b0917f;
			font-style: italic;
		}
		.item__added {
			font-size: 11px;
			color: #8a6f63;
			margin-top: 6px;
		}
		.empty {
			color: #8a6f63;
		}

		@media (max-width: 860px) {
			.grid {
				grid-template-columns: repeat(4, 1fr);
			}
		}
		@media (max-width: 560px) {
			h1 {
				font-size: 40px;
			}
			.grid {
				grid-template-columns: repeat(3, 1fr);
			}
		}
	</style>
</FilmLayout>
