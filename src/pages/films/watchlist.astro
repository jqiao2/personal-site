---
import FilmLayout from '../../layouts/FilmLayout.astro';
import WatchlistComposer from '../../components/WatchlistComposer.astro';
import { listAllWatchlist } from '../../lib/films';
import { requireOwner } from '../../lib/auth';
import { siteDay } from '../../lib/day';
import { formatWatchedDate } from '../../lib/format';
import { imageUrl } from '../../lib/tmdb';
import SiteHeader from '../../components/SiteHeader.astro';

// Rendered on demand — reflects the live database.
export const prerender = false;

// The tiles, and nothing the filter panel needs. Genres, directors and cast are a
// separate read the browser makes after paint (/api/films/watchlist/facets): they
// roughly double the query and, written out as per-tile data attributes, more than
// double this page — all for a panel that starts collapsed. Nothing on a tile shows
// them; they only ever feed the filters. See applyFacets in the script.
const [films, isOwner] = await Promise.all([listAllWatchlist(), requireOwner(Astro.cookies)]);

// The whole watchlist ships to the browser, which does the filtering and sorting
// from data attributes on the tiles. Unlike the "All films" grid — which pages
// through ~1.5k watched films and so has to re-query the server — a few hundred
// entries all fit in the DOM, and searching a slice would be a bug.

const num = (n: number) => n.toLocaleString('en-US');

/** "Added Jul 9" — the short date shown on a tile's hover overlay. */
const addedLabel = (iso: string) =>
	new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

// A film is upcoming when its release date is still ahead of us. This needs the
// full date, not release_year: for most of a year, "released in 2026" and "out in
// 2026" are different claims. Films TMDB has no date for (announced, no schedule
// yet) aren't badged — unknown isn't the same as future. The badge is baked into
// the HTML, so there's no client to ask what day it is: the site's zone it is.
const today = siteDay();
const isUpcoming = (f: (typeof films)[number]) => f.release_date != null && f.release_date > today;

// "Out Mar 6, 2026" — the opening date on an upcoming film's hover overlay, where a
// released film shows nothing. `release_date` is the cached *US* opening (see
// preferredReleaseDate): the earliest of its theatrical, limited or digital dates,
// falling back to a non-US one only for films with no US release at all. That's the
// theatrical date for anything with a theatrical run, which is why the label stays
// "Out" rather than claiming a screen.
const releaseLabel = (iso: string) => `Out ${formatWatchedDate(iso)}`;

// Whether the watchlist holds anything still ahead of us. The "Include upcoming"
// toggle is only worth drawing when there's something for it to exclude.
const hasUpcoming = films.some(isUpcoming);

// End stops for the release-date slider, as calendar years. It needs two distinct
// years to be worth drawing. Films with no release_year at all sit outside any
// year and drop out once the slider is narrowed.
const releaseYears = [
	...new Set(films.map((f) => f.release_year).filter((y): y is number => y != null)),
].sort((a, b) => a - b);
const relLo = releaseYears[0] ?? null;
const relHi = releaseYears[releaseYears.length - 1] ?? null;
const hasReleaseRange = relLo != null && relHi != null && relHi > relLo;
---

<FilmLayout title="Watchlist — Jason's film log">
	<div class="page">
		<div class="wrap">
			<SiteHeader pathname={Astro.url.pathname} theme="film" max="1064px" />

			<header class="topbar">
				<a class="back" href="/films">
					<span class="back__arrow">←</span><span>Jason's film log</span>
				</a>
				<span class="topbar__tag">Watchlist</span>
			</header>

			<div class="titleblock">
				<div>
					<div class="titleblock__head">
						<h1>Watchlist</h1>
						{isOwner && <button type="button" class="add-btn" data-open-watchlist>+ Add film</button>}
					</div>
					<div class="sub">
						<span class="sub__n" id="wl-count">{num(films.length)}</span>{' '}
						<span id="wl-noun">{films.length === 1 ? 'film' : 'films'}</span> to watch · showing{' '}
						<span class="sub__n" id="shown">{num(films.length)}</span>
					</div>
				</div>
			</div>

			<div class="filterbar">
				<input
					type="search"
					id="search"
					placeholder="Search watchlist…"
					autocomplete="off"
					aria-label="Search watchlist"
				/>
				<button
					type="button"
					id="filters-toggle"
					class="pill pill--btn"
					aria-expanded="false"
					aria-controls="filters"
				>
					Filters<span id="filters-count"></span>
				</button>
				{isOwner && (
						<button type="button" id="open-wheel" class="wheel-open">◎ Spin the wheel</button>
					)}
				<div class="sortby">
					<span class="sortby__label">Sort</span>
					<button type="button" class="pill pill--on" data-sort="added">Recently added</button>
					<button type="button" class="pill" data-sort="year">Release date</button>
					<button type="button" class="pill" data-sort="shuffle">⇄ Shuffle</button>
				</div>
			</div>

			<div class="panel" id="filters" hidden>
				<div class="panel__head">
					<span class="panel__title">Filter watchlist</span>
					<span class="panel__loading" id="facets-loading">Loading filters…</span>
					<button type="button" id="clear-all" class="clear" hidden>Clear all</button>
				</div>
				<p class="panel__error" id="facets-error" hidden>
					Couldn't load the filters. <button type="button" id="facets-retry">Retry</button>
				</p>

				<div class="panel__grid">
					<section>
						<h2 class="grp">Release date</h2>
						{hasReleaseRange ? (
							<div class="range range--dec" id="drange" data-lo={relLo} data-hi={relHi}>
								<div class="range__track"></div>
								<div class="range__fill" id="drange-fill"></div>
								<input
									type="range"
									id="dmin"
									min={relLo}
									max={relHi}
									step="1"
									value={relLo}
									aria-label="Earliest release year"
								/>
								<input
									type="range"
									id="dmax"
									min={relLo}
									max={relHi}
									step="1"
									value={relHi}
									aria-label="Latest release year"
								/>
								<div class="range__ends">
									<span id="dmin-label">{relLo}</span><span id="dmax-label">{relHi}</span>
								</div>
							</div>
						) : (
							<p class="grp__none">Not enough range to filter</p>
						)}
						{hasUpcoming && (
							<label class="toggle">
								<input type="checkbox" id="upcoming-toggle" checked />
								<span class="toggle__track"><span class="toggle__thumb"></span></span>
								<span class="toggle__text">Include upcoming</span>
							</label>
						)}
					</section>

					{/* Genre, Language and People are all built by applyFacets() from
					    /api/films/watchlist/facets. Only search, sort, the release-date
					    range and the upcoming toggle work before that lands — they read
					    facts the tiles already carry. */}
					<section data-group="genre">
						<div class="grp__row">
							<h2 class="grp">Genre</h2>
							<div class="modes" data-mode="genremode" hidden>
								<button type="button" class="mode mode--on" data-value="any">Any</button>
								<button type="button" class="mode" data-value="all">All</button>
							</div>
						</div>
						<p class="grp__none" data-none hidden>No genres yet</p>
						<div class="chips" data-chips="genre"></div>
					</section>

					<section data-group="language" hidden>
						<h2 class="grp">Language</h2>
						<div class="chips" data-chips="language"></div>
					</section>

					<section class="panel__wide" id="people-section" hidden>
						<div class="grp__row">
							<h2 class="grp">People</h2>
							<input
								type="search"
								id="people-search"
								class="people-search"
								placeholder="Search directors & cast…"
								autocomplete="off"
								aria-label="Search directors and cast"
							/>
						</div>
						<div class="where">
							<div class="where__row">
								<span class="where__label">Director</span>
								<div class="chips" data-people="director">
									<span class="people-none" hidden>No matches</span>
								</div>
							</div>
							<div class="where__row">
								<span class="where__label">Cast</span>
								<div class="chips" data-people="actor">
									<span class="people-none" hidden>No matches</span>
								</div>
							</div>
						</div>
					</section>
				</div>
			</div>

			<div class="grid" id="grid">
				{films.map((f, i) => {
					const poster = imageUrl(f.poster_path, 'w342');
					const upcoming = isUpcoming(f);
					// No genres / directors / cast / language on the tile: across ~500 of
					// them they'd be most of this page's HTML, and nothing here displays
					// them. applyFacets attaches them to the matching Item once the facet
					// payload lands, for the filters to read.
					return (
						<div
							class="item"
							data-tmdb-id={f.tmdb_id}
							data-order={i}
							data-title={f.title.toLowerCase()}
							data-year={f.release_year ?? ''}
							data-premiere-date={f.premiere_date ?? ''}
							data-upcoming={upcoming ? '1' : ''}
						>
							{isOwner && (
								<button type="button" class="remove" aria-label={`Remove ${f.title} from watchlist`}>
									✕
								</button>
							)}
							{/* Tiles lead to the film's own page — where the download link now
							    lives, alongside the synopsis, cast and the watchlist toggle. */}
							<a class={poster ? 'tile' : 'tile tile--noimg'} href={`/films/movie/${f.tmdb_id}`}>
								{poster && <img data-poster={poster} alt={`${f.title} poster`} decoding="async" />}
								{upcoming && <span class="badge">Upcoming</span>}
								<div class="tile__overlay">
									<div class="tile__title">{f.title}</div>
									<div class="tile__year">{f.release_year}</div>
									{/* Only upcoming films carry a date here: for one already out,
									    the year above is the whole story, and the day it opened
									    isn't what you're scanning the watchlist for. */}
									{upcoming && f.release_date && (
										<div class="tile__release">{releaseLabel(f.release_date)}</div>
									)}
									<div class="tile__added">Added {addedLabel(f.added_at)}</div>
								</div>
							</a>
						</div>
					);
				})}
			</div>

			<p class="empty" id="empty" hidden={films.length > 0}>
				<span id="empty-none" hidden={films.length > 0}>Nothing on the watchlist yet.</span>
				<span id="empty-by-query" hidden>No films match “<span id="empty-q"></span>”</span>
				<span id="empty-by-filters" hidden>No films match these filters</span>
			</p>
		</div>
	</div>

	{isOwner && <WatchlistComposer />}

	{/* Spin the wheel — a random pick from the owner's current filtered set. Owner
	    only, so the winner card always links out (to YTS), matching the tiles. */}
	{isOwner && (
		<div class="wheel" id="wheel" hidden>
			<div class="wheel__backdrop" id="wheel-backdrop"></div>
			<div class="wheel__panel" role="dialog" aria-modal="true" aria-label="Pick a film to watch">
				<div class="wheel__head">
					<span class="wheel__eyebrow">Pick for me</span>
					<button type="button" class="wheel__close" id="wheel-close" aria-label="Close">✕</button>
				</div>
				<p class="wheel__sub">
					Spinning <span class="wheel__n" id="wheel-count">0</span> films from your current filters
				</p>

				<div class="wheel__stage" id="wheel-stage" hidden>
					<div class="wheel__pointer"></div>
					<div class="wheel__disc" id="wheel-disc"></div>
					<button type="button" class="wheel__hub" id="wheel-hub">Spin</button>
					<canvas class="wheel__confetti" id="wheel-confetti" width="600" height="600" aria-hidden="true"></canvas>
				</div>

				<a class="wheel__winner" id="wheel-winner" hidden>
					<div class="wheel__winner-eyebrow">Tonight you're watching</div>
					<div class="wheel__winner-title" id="wheel-winner-title"></div>
				</a>

				<p class="wheel__empty" id="wheel-empty" hidden>No films match these filters</p>
			</div>
		</div>
	)}

	<style>
		.page {
			overflow-x: hidden;
			display: flex;
			justify-content: center;
			padding: 0 24px 80px;
		}
		.wrap {
			width: 100%;
			max-width: 1000px;
		}
		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 26px 0 22px;
			border-bottom: 1px solid #4a2529;
			margin-bottom: 34px;
		}
		.back {
			display: flex;
			align-items: center;
			gap: 9px;
			font-size: 13px;
			color: #a2857a;
		}
		.back:hover {
			color: #f4e8d1;
		}
		.back__arrow {
			font-size: 15px;
		}
		.topbar__tag {
			font-size: 11.5px;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #8a6f63;
		}

		.titleblock {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			margin-bottom: 26px;
			flex-wrap: wrap;
			gap: 16px;
		}
		.titleblock__head {
			display: flex;
			align-items: center;
			gap: 18px;
		}
		h1 {
			font-family: 'Newsreader', serif;
			font-weight: 500;
			font-size: 52px;
			color: #f4e8d1;
			letter-spacing: -0.5px;
			line-height: 1;
			margin: 0;
		}
		.add-btn {
			font-size: 13px;
			font-weight: 700;
			color: #2a1214;
			background: #d9b45a;
			border: none;
			border-radius: 8px;
			padding: 10px 18px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			white-space: nowrap;
		}
		.add-btn:hover {
			background: #f0d488;
		}
		.sub {
			font-size: 13px;
			color: #a2857a;
			margin-top: 10px;
		}
		.sub__n {
			color: #d9b45a;
			font-weight: 600;
		}

		.filterbar {
			display: flex;
			gap: 12px;
			align-items: center;
			margin-bottom: 14px;
			flex-wrap: wrap;
		}
		#search {
			flex: 1;
			min-width: 220px;
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 8px;
			padding: 11px 14px;
			color: #f4e8d1;
			font-size: 14px;
			font-family: 'Archivo', sans-serif;
			outline: none;
		}
		#search::placeholder {
			color: #8a6f63;
		}
		#search:focus {
			border-color: #d9b45a;
		}
		.sortby {
			display: flex;
			align-items: center;
			gap: 8px;
		}
		.sortby__label {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
		}
		.pill {
			font-size: 12.5px;
			padding: 7px 13px;
			border-radius: 20px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			border: 1px solid #4a2529;
			background: transparent;
			color: #ddc9b4;
		}
		.pill:hover {
			border-color: #a2857a;
		}
		.pill--on {
			background: #d9b45a;
			color: #2a1214;
			font-weight: 600;
			border-color: #d9b45a;
		}
		.pill--btn {
			padding: 10px 16px;
			border-radius: 8px;
		}

		/* --- Filter panel --- */
		.panel {
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 12px;
			padding: 24px 26px;
			margin-bottom: 26px;
		}
		.panel[hidden] {
			display: none;
		}
		.panel__head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 20px;
		}
		.panel__title {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.6px;
			color: #8a6f63;
		}
		/* Sits between the title and "Clear all" while the chips are on their way.
		   Quiet on purpose: search, sort, the release-date range and the upcoming
		   toggle all work without them, so this is a note, not a blocker. */
		.panel__loading {
			margin-right: auto;
			padding-left: 12px;
			font-size: 12px;
			color: #7c6156;
			font-style: italic;
		}
		.panel__loading[hidden] {
			display: none;
		}
		.panel__error {
			margin: -8px 0 16px;
			font-size: 13px;
			color: #a2857a;
		}
		.panel__error[hidden] {
			display: none;
		}
		.panel__error button {
			font: inherit;
			color: #d9b45a;
			background: none;
			border: none;
			padding: 0;
			cursor: pointer;
			text-decoration: underline;
		}
		.modes[hidden],
		section[hidden] {
			display: none;
		}
		.clear {
			font-size: 12px;
			font-weight: 600;
			color: #d9b45a;
			background: transparent;
			border: none;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			padding: 0;
		}
		.clear:hover {
			color: #f0d488;
		}
		.clear[hidden] {
			display: none;
		}
		.panel__grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 26px 40px;
		}
		.panel__wide {
			grid-column: 1 / -1;
		}
		.grp {
			font-size: 11px;
			font-weight: 400;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
			margin: 0 0 12px;
		}
		.grp__none {
			font-size: 13px;
			font-style: italic;
			font-family: 'Newsreader', serif;
			color: #8a6f63;
			margin: 0;
		}
		.grp__row {
			display: flex;
			align-items: center;
			gap: 12px;
			margin-bottom: 12px;
		}
		.grp__row .grp {
			margin-bottom: 0;
		}
		.chips {
			display: flex;
			gap: 8px;
			flex-wrap: wrap;
		}
		.chip {
			font-size: 12.5px;
			padding: 7px 13px;
			border-radius: 20px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			border: 1px solid #4a2529;
			background: transparent;
			color: #ddc9b4;
		}
		.chip:hover {
			border-color: #a2857a;
		}
		.chip[aria-pressed='true'] {
			background: #d9b45a;
			color: #2a1214;
			font-weight: 600;
			border-color: #d9b45a;
		}
		.chip[hidden] {
			display: none;
		}
		.chip--more {
			background: transparent;
			color: #a2857a;
			border-style: dashed;
		}

		/* Any/All mode toggle — mirrors the "All films" filter groups. */
		.modes {
			display: flex;
			border: 1px solid #4a2529;
			border-radius: 14px;
			overflow: hidden;
		}
		.mode {
			font-size: 11px;
			font-weight: 600;
			padding: 5px 11px;
			border: none;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			background: transparent;
			color: #a2857a;
		}
		.mode--on {
			background: #d9b45a;
			color: #2a1214;
		}

		/* Labelled chip rows (People → Director / Cast). */
		.where {
			display: flex;
			flex-direction: column;
			gap: 10px;
		}
		.where__row {
			display: flex;
			align-items: baseline;
			gap: 8px;
		}
		.where__label {
			font-size: 12px;
			color: #8a6f63;
			width: 60px;
			flex: none;
		}

		/* People filter: a chip-scoped search that sits beside the "People" heading. */
		.people-search {
			width: 220px;
			max-width: 100%;
			background: #1c0d0e;
			border: 1px solid #4a2529;
			border-radius: 14px;
			padding: 5px 12px;
			color: #f4e8d1;
			font-size: 12px;
			font-family: 'Archivo', sans-serif;
			outline: none;
		}
		.people-search::placeholder {
			color: #8a6f63;
		}
		.people-search:focus {
			border-color: #d9b45a;
		}
		.people-none {
			font-size: 12px;
			font-style: italic;
			font-family: 'Newsreader', serif;
			color: #8a6f63;
		}
		.people-none[hidden] {
			display: none;
		}

		/* Dual-thumb release-date range: two native sliders stacked on one track, so
		   keyboard and screen-reader support come for free. The inputs ignore pointer
		   events except on their thumbs, which lets whichever thumb is under the
		   cursor take the drag even though the boxes fully overlap. Mirrors the
		   "All films" grid's sliders. */
		.range {
			max-width: 260px;
			position: relative;
			height: 32px;
		}
		.range__track,
		.range__fill {
			position: absolute;
			top: 14px;
			height: 4px;
			border-radius: 2px;
			pointer-events: none;
		}
		.range__track {
			left: 0;
			right: 0;
			background: #402226;
		}
		.range__fill {
			background: #d9b45a;
		}
		.range input[type='range'] {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 32px;
			margin: 0;
			background: none;
			appearance: none;
			-webkit-appearance: none;
			pointer-events: none;
		}
		.range input[type='range']:focus-visible {
			outline: none;
		}
		.range input[type='range']::-webkit-slider-thumb {
			appearance: none;
			-webkit-appearance: none;
			pointer-events: auto;
			width: 16px;
			height: 16px;
			border-radius: 50%;
			background: #f0d488;
			border: 2px solid #241012;
			box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
