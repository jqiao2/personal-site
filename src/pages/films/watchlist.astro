	<script>
		// --- Browse: search, sort and filter ---------------------------------
		// The whole watchlist is server-rendered, so all of this reorders and hides
		// tiles already in the DOM — no re-querying. Each tile carries the facts the
		// filters read as data attributes.
		const grid = document.getElementById('grid');

		if (grid) {
			const search = document.getElementById('search') as HTMLInputElement;
			const shown = document.getElementById('shown')!;
			const empty = document.getElementById('empty')!;
			const emptyNone = document.getElementById('empty-none')!;
			const emptyQ = document.getElementById('empty-q')!;
			const emptyByQuery = document.getElementById('empty-by-query')!;
			const emptyByFilters = document.getElementById('empty-by-filters')!;
			const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.pill[data-sort]'));
			const panel = document.getElementById('filters')!;
			const toggle = document.getElementById('filters-toggle')!;
			const countBadge = document.getElementById('filters-count')!;
			const clearAll = document.getElementById('clear-all') as HTMLButtonElement;
			// Every chip — genre, language, director, cast — is built from the facet
			// payload, so this starts empty and is refilled by applyFacets.
			let filterChips: HTMLButtonElement[] = [];
			const peopleSearch = document.getElementById('people-search') as HTMLInputElement | null;
			const drange = document.getElementById('drange');
			const dminInput = document.getElementById('dmin') as HTMLInputElement | null;
			const dmaxInput = document.getElementById('dmax') as HTMLInputElement | null;
			const drangeFill = document.getElementById('drange-fill');
			const dminLabel = document.getElementById('dmin-label');
			const dmaxLabel = document.getElementById('dmax-label');
			const upcomingToggle = document.getElementById('upcoming-toggle') as HTMLInputElement | null;

			const fmt = (n: number) => n.toLocaleString('en-US');

			/** A tile's facts. Title, year and upcoming come off its data attributes;
			 * the rest are attached by applyFacets when the facet payload lands. */
			interface Item {
				el: HTMLElement;
				tmdbId: number;
				title: string;
				/** Release year, or null when TMDB has none — such a film can't satisfy
				 * any year range, so a narrowed slider drops it. */
				year: number | null;
				/** Sort key for "Release date": the full TMDB date when there is one,
				 * else `YYYY-00-00` so a year-only film sits below every dated film of
				 * its own year, else null when TMDB has neither. Compared as a string —
				 * both forms are fixed-width and zero-padded. */
				releaseKey: string | null;
				/** Empty until the facets arrive; the chips that match on them don't
				 * exist before then either, so nothing can filter on a blank. */
				genres: string[];
				directors: string[];
				actors: string[];
				/** Original language as an English name; '' when TMDB has none. */
				language: string;
				/** A release date still ahead of us. Governed by the "Include upcoming"
				 * toggle, not the year range — a year alone can't tell an upcoming 2026
				 * film from one already out. */
				upcoming: boolean;
				/** Position in the server's added_at-descending order. */
				order: number;
			}

			const items: Item[] = Array.from(grid.querySelectorAll<HTMLElement>('.item')).map((el) => {
				const year = el.dataset.year ? Number(el.dataset.year) : null;
				const premiereDate = el.dataset.premiereDate ?? '';
				return {
					el,
					tmdbId: Number(el.dataset.tmdbId),
					title: el.dataset.title ?? '',
					year,
					releaseKey: premiereDate || (year != null ? `${year}-00-00` : null),
					genres: [],
					directors: [],
					actors: [],
					language: '',
					upcoming: el.dataset.upcoming === '1',
					order: Number(el.dataset.order),
				};
			});

			// --- Filter state ---
			let sort = 'added';
			let q = '';
			// One set per chip group; director/cast join genre/language here so the
			// filter loop, the URL and the active count all read them the same way.
			const sets = {
				genre: new Set<string>(),
				language: new Set<string>(),
				director: new Set<string>(),
				actor: new Set<string>(),
			};
			type SetKey = keyof typeof sets;
			// Genre is the one group with an any/all toggle, mirroring "All films".
			let genreMode: 'any' | 'all' = 'any';
			// Re-rolled on every press of Shuffle. Held so that re-filtering keeps the
			// order you're looking at instead of reshuffling under you.
			let shuffleSeed = 1;

			const REL_LO = drange ? Number(drange.dataset.lo) : 0;
			const REL_HI = drange ? Number(drange.dataset.hi) : 0;
			let dMin = REL_LO;
			let dMax = REL_HI;
			// The "Include upcoming" toggle. On by default, so the page opens on the
			// full list the server rendered; when off, films with a future release date
			// drop out whatever the year range says.
			let includeUpcoming = true;

			/** Whether the release-date range narrows anything. */
			const releaseActive = () => Boolean(drange) && (dMin > REL_LO || dMax < REL_HI);

			/** Number of active filters — the count on the Filters button. The
			 * release-date range counts once however many years it spans. */
			const activeCount = () =>
				(releaseActive() ? 1 : 0) +
				sets.genre.size +
				sets.language.size +
				sets.director.size +
				sets.actor.size +
				(includeUpcoming ? 0 : 1);

			/** A cheap deterministic hash, so a shuffle holds still while you filter
			 * and each press of Shuffle deals a different order. */
			function shuffleRank(item: Item): number {
				let h = shuffleSeed;
				for (const ch of item.title) h = (h * 31 + ch.charCodeAt(0)) % 100000;
				return h;
			}

			function matches(item: Item): boolean {
				if (q && !item.title.includes(q)) return false;
				// Genre, language and the credits can only be judged once the facet
				// payload has attached them. Until then a filter restored from the URL is
				// held rather than matched: every tile's arrays are still empty, so
				// applying it would empty the grid and claim nothing matched. applyFacets
				// re-runs this the moment it can answer honestly.
				if (facetsState !== 'done') return upcomingOk(item) && releaseOk(item);
				// Genre honours the any/all toggle; the other groups are always "any of".
				if (sets.genre.size) {
					const has = (g: string) => item.genres.includes(g);
					if (genreMode === 'all' ? ![...sets.genre].every(has) : !item.genres.some((g) => sets.genre.has(g))) {
						return false;
					}
				}
				if (sets.language.size && !sets.language.has(item.language)) return false;
				if (sets.director.size && !item.directors.some((d) => sets.director.has(d))) return false;
				if (sets.actor.size && !item.actors.some((a) => sets.actor.has(a))) return false;
				return upcomingOk(item) && releaseOk(item);
			}

			/** The two filters that read only what a tile already carries, so they hold
			 * before the facet payload lands as well as after. */
			const upcomingOk = (item: Item) => includeUpcoming || !item.upcoming;
			const releaseOk = (item: Item) =>
				!releaseActive() || (item.year != null && item.year >= dMin && item.year <= dMax);

			function apply() {
				const visible = items.filter(matches);
				const shownSet = new Set(visible);
				for (const item of items) item.el.hidden = !shownSet.has(item);

				const ordered = visible.slice();
				if (sort === 'shuffle') ordered.sort((a, b) => shuffleRank(a) - shuffleRank(b));
				// Newest release first, by the full premiere date (earliest release
				// anywhere) — the widely-accepted release, not the US opening — so two
				// films from the same year keep their real order. Films TMDB has no date
				// for fall back to their year; films with neither go last, rather than
				// sorting as year 0 and burying the top. Ties keep added_at order (stable).
				else if (sort === 'year') {
					ordered.sort((a, b) => {
						if (a.releaseKey == null || b.releaseKey == null) {
							return (a.releaseKey == null ? 1 : 0) - (b.releaseKey == null ? 1 : 0);
						}
						if (a.releaseKey === b.releaseKey) return 0;
						return a.releaseKey < b.releaseKey ? 1 : -1;
					});
				} else ordered.sort((a, b) => a.order - b.order);

				// One reflow rather than one per tile. Hidden tiles stay put; they're
				// display:none, so where they sit doesn't matter until they're shown.
				const frag = document.createDocumentFragment();
				for (const item of ordered) frag.append(item.el);
				grid!.prepend(frag);

				shown.textContent = fmt(visible.length);
				// Quote the search term when it's the only thing narrowing; once a filter
				// is on too, the term alone no longer explains the emptiness.
				const onlyQuery = q !== '' && activeCount() === 0;
				emptyQ.textContent = q;
				emptyNone.hidden = items.length > 0;
				emptyByQuery.hidden = !onlyQuery || items.length === 0;
				emptyByFilters.hidden = onlyQuery || items.length === 0;
				empty.hidden = visible.length > 0;

				syncChrome();
				writeUrl();
			}

			/** Reflect state that isn't owned by the control the user just touched. */
			function syncChrome() {
				const n = activeCount();
				countBadge.textContent = n ? ` · ${n}` : '';
				toggle.classList.toggle('pill--on', panel.hidden === false || n > 0);
				clearAll.hidden = n === 0;
				if (upcomingToggle) upcomingToggle.checked = includeUpcoming;

				if (drange && drangeFill && dminLabel && dmaxLabel) {
					const pct = (v: number) => ((v - REL_LO) / (REL_HI - REL_LO)) * 100;
					drangeFill.style.left = `${pct(dMin)}%`;
					drangeFill.style.width = `${pct(dMax) - pct(dMin)}%`;
					dminLabel.textContent = String(dMin);
					dmaxLabel.textContent = String(dMax);
					// The two inputs cover the same box, so where the thumbs overlap the
					// later one in the DOM (max) swallows the drag. Raise min once it's
					// past the midpoint, which is the only place the two can meet.
					const overlapping = dMin > (REL_LO + REL_HI) / 2;
					dminInput!.style.zIndex = overlapping ? '2' : '1';
					dmaxInput!.style.zIndex = overlapping ? '1' : '2';
				}
			}

			toggle.addEventListener('click', () => {
				panel.hidden = !panel.hidden;
				toggle.setAttribute('aria-expanded', String(!panel.hidden));
				syncChrome();
			});

			let debounce = 0;
			search.addEventListener('input', () => {
				window.clearTimeout(debounce);
				debounce = window.setTimeout(() => {
					const next = search.value.trim().toLowerCase();
					if (next === q) return;
					q = next;
					apply();
				}, 150);
			});

			for (const pill of pills) {
				pill.addEventListener('click', () => {
					// Shuffle is the one sort that does something when it's already on:
					// pressing it again deals a new order.
					if (pill.dataset.sort === sort && sort !== 'shuffle') return;
					sort = pill.dataset.sort!;
					if (sort === 'shuffle') shuffleSeed = 1 + Math.floor(Math.random() * 99998);
					for (const p of pills) p.classList.toggle('pill--on', p === pill);
					apply();
				});
			}

			// Genre any/all toggle. A mode flip only changes results once genres are
			// picked; only genre carries a toggle, but the wiring stays general.
			for (const group of Array.from(panel.querySelectorAll<HTMLElement>('.modes'))) {
				const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('.mode'));
				for (const button of buttons) {
					button.addEventListener('click', () => {
						const value = button.dataset.value as 'any' | 'all';
						if (genreMode === value) return;
						genreMode = value;
						for (const b of buttons) b.classList.toggle('mode--on', b === button);
						if (sets.genre.size) apply();
					});
				}
			}

			// --- People (director / cast) ---------------------------------------
			// Mirrors the "All films" People filter: each row shows the top few names
			// by frequency and the search box reveals matches on demand. Picks live in
			// sets.director / sets.actor, read the same as any other chip group.
			type PeopleKind = 'director' | 'actor';
			const PEOPLE_TOP_JS = 12; // quick chips per row before searching
			const PEOPLE_MAX = 40; // most chips one search reveals
			const peopleSection = document.getElementById('people-section')!;
			const peopleNames: Record<PeopleKind, string[]> = { director: [], actor: [] };

			interface PeopleRow {
				kind: PeopleKind;
				host: HTMLElement;
				none: HTMLElement;
			}
			const peopleRows: PeopleRow[] = Array.from(
				panel.querySelectorAll<HTMLElement>('.chips[data-people]'),
			).map((host) => ({
				kind: host.dataset.people as PeopleKind,
				host,
				none: host.querySelector<HTMLElement>('.people-none')!,
			}));
			let peopleQ = '';

			// Astro scopes this page's CSS behind a generated data-astro-cid-* attribute,
			// so a chip built here has to carry it or it renders unstyled. Read the name
			// off a server-rendered element rather than hard-coding the hash, which
			// changes whenever this file does.
			const scopeAttr = Array.from(panel.attributes)
				.map((a) => a.name)
				.find((n) => n.startsWith('data-astro-cid-'));

			/** A `.chip` button carrying the page's style scope. */
			function newChip(className = 'chip'): HTMLButtonElement {
				const chip = document.createElement('button');
				if (scopeAttr) chip.setAttribute(scopeAttr, '');
				chip.className = className;
				chip.type = 'button';
				return chip;
			}

			function makePeopleChip(kind: PeopleKind, name: string): HTMLButtonElement {
				const chip = newChip();
				chip.dataset.filter = kind;
				chip.dataset.value = name;
				chip.setAttribute('aria-pressed', String(sets[kind].has(name)));
				chip.textContent = name;
				chip.addEventListener('click', () => {
					if (sets[kind].has(name)) sets[kind].delete(name);
					else sets[kind].add(name);
					chip.setAttribute('aria-pressed', String(sets[kind].has(name)));
					apply();
				});
				return chip;
			}

			function renderPeopleRow(row: PeopleRow) {
				const selected = sets[row.kind];
				let names: string[];
				if (peopleQ) {
					names = peopleNames[row.kind]
						.filter((n) => n.toLowerCase().includes(peopleQ))
						.slice(0, PEOPLE_MAX);
					// Keep picked names on screen even when they don't match the search.
					for (const s of selected) if (!names.includes(s)) names.unshift(s);
				} else {
					names = peopleNames[row.kind].slice(0, PEOPLE_TOP_JS);
					for (const s of selected) if (!names.includes(s)) names.push(s);
				}
				const chips = names.map((n) => makePeopleChip(row.kind, n));
				row.host.replaceChildren(...chips, row.none);
				row.none.hidden = !(peopleQ !== '' && chips.length === 0);
			}

			function renderPeople() {
				for (const row of peopleRows) renderPeopleRow(row);
			}

			peopleSearch?.addEventListener('input', () => {
				peopleQ = peopleSearch.value.trim().toLowerCase();
				renderPeople();
			});

			// --- Genre / Language chip groups -----------------------------------
			// Both are built from the facet payload. Values past the group's limit ship
			// hidden behind "+N other…" — except any already picked, which stay visible
			// so a filter restored from the URL always has a control that can clear it.

			/** How many chips a group shows before collapsing behind "+N other…". */
			const CHIP_LIMIT: Record<'genre' | 'language', number> = { genre: 8, language: 8 };

			function makeFilterChip(key: SetKey, value: string): HTMLButtonElement {
				const chip = newChip();
				chip.dataset.filter = key;
				chip.dataset.value = value;
				chip.textContent = value;
				chip.setAttribute('aria-pressed', String(sets[key].has(value)));
				chip.addEventListener('click', () => {
					const on = !sets[key].has(value);
					if (on) sets[key].add(value);
					else sets[key].delete(value);
					chip.setAttribute('aria-pressed', String(on));
					apply();
				});
				return chip;
			}

			/** "+N other…" reveals the rest of its group and then removes itself:
			 * collapsing again would have to hide chips the user may have just picked. */
			function makeMoreChip(count: number): HTMLButtonElement {
				const more = newChip('chip chip--more');
				more.textContent = `+${count} other…`;
				more.addEventListener('click', () => {
					for (const sibling of Array.from(more.parentElement!.children)) {
						(sibling as HTMLElement).hidden = false;
					}
					more.remove();
				});
				return more;
			}

			function renderChipGroup(key: 'genre' | 'language', values: string[]) {
				const host = panel.querySelector<HTMLElement>(`.chips[data-chips="${key}"]`);
				if (!host) return;
				const section = host.closest<HTMLElement>(`section[data-group="${key}"]`);
				const none = section?.querySelector<HTMLElement>('[data-none]') ?? null;
				// Genre keeps its section and says "No genres yet"; language just hides.
				if (none) none.hidden = values.length > 0;
				else if (section) section.hidden = values.length === 0;

				const chips = values.map((v, i) => {
					const chip = makeFilterChip(key, v);
					chip.hidden = i >= CHIP_LIMIT[key] && !sets[key].has(v);
					return chip;
				});
				const hiddenCount = chips.filter((c) => c.hidden).length;
				if (hiddenCount > 0) chips.push(makeMoreChip(hiddenCount));
				host.replaceChildren(...chips);
			}

			/** Move both release-year thumbs, keeping min ≤ max and the inputs in step. */
			function setReleaseRange(min: number, max: number) {
				dMin = Math.min(min, max);
				dMax = Math.max(min, max);
				dminInput!.value = String(dMin);
				dmaxInput!.value = String(dMax);
			}

			if (dminInput && dmaxInput) {
				for (const input of [dminInput, dmaxInput]) {
					input.addEventListener('input', () => {
						// The thumbs share a track, so each one pushes rather than crosses.
						const min = Number(dminInput.value);
						const max = Number(dmaxInput.value);
						if (input === dminInput) setReleaseRange(Math.min(min, max), max);
						else setReleaseRange(min, Math.max(min, max));
						apply();
					});
				}
			}

			if (upcomingToggle) {
				upcomingToggle.addEventListener('change', () => {
					includeUpcoming = upcomingToggle.checked;
					apply();
				});
			}

			clearAll.addEventListener('click', () => {
				for (const s of Object.values(sets)) s.clear();
				for (const chip of filterChips) chip.setAttribute('aria-pressed', 'false');
				genreMode = 'any';
				for (const b of Array.from(panel.querySelectorAll<HTMLButtonElement>('.mode'))) {
					b.classList.toggle('mode--on', b.dataset.value === 'any');
				}
				if (dminInput && dmaxInput) setReleaseRange(REL_LO, REL_HI);
				includeUpcoming = true;
				// Deselecting the People chips lets their rows collapse back to the top few.
				renderPeople();
				apply();
			});

			// --- URL state ------------------------------------------------------
			// The filters live in the query string so a narrowed grid is linkable and
			// survives a reload. Always replaceState, never pushState: a chip press is
			// not a navigation, and stacking one entry per press would leave Back
			// walking the filter history instead of returning to wherever you came
			// from. Mirrors the "All films" grid's param names.
			function writeUrl() {
				const p = new URLSearchParams();
				if (q) p.set('q', q);
				// The shuffle seed stays out: it's re-rolled on load anyway, and a link
				// that promised one order but dealt another would be worse than neither.
				if (sort !== 'added') p.set('sort', sort);
				if (releaseActive()) {
					p.set('dmin', String(dMin));
					p.set('dmax', String(dMax));
				}
				// Set keys (genre/language/director/actor) double as the URL param names.
				for (const [key, values] of Object.entries(sets)) {
					for (const v of values) p.append(key, v);
				}
				if (sets.genre.size && genreMode === 'all') p.set('genremode', 'all');
				if (!includeUpcoming) p.set('upcoming', '0');
				const qs = p.toString();
				const url = location.pathname + (qs ? `?${qs}` : '');
				if (url !== location.pathname + location.search) history.replaceState(null, '', url);
			}

			const snap = (raw: string | null, lo: number, hi: number, step: number, fallback: number) => {
				const n = Number(raw);
				if (raw == null || !Number.isFinite(n)) return fallback;
				return Math.min(hi, Math.max(lo, Math.round(n / step) * step));
			};

			/** Restore filters from the query string. Returns whether any were applied. */
			function readUrl(): boolean {
				const p = new URLSearchParams(location.search);
				if ([...p.keys()].length === 0) return false;

				q = p.get('q')?.trim().toLowerCase() ?? '';
				search.value = q;
				const urlSort = p.get('sort');
				if (urlSort === 'added' || urlSort === 'year' || urlSort === 'shuffle') {
					sort = urlSort;
					if (sort === 'shuffle') shuffleSeed = 1 + Math.floor(Math.random() * 99998);
					for (const pill of pills) pill.classList.toggle('pill--on', pill.dataset.sort === sort);
				}
				if (dminInput && dmaxInput) {
					setReleaseRange(
						snap(p.get('dmin'), REL_LO, REL_HI, 1, REL_LO),
						snap(p.get('dmax'), REL_LO, REL_HI, 1, REL_HI),
					);
				}
				if (upcomingToggle && p.get('upcoming') === '0') {
					includeUpcoming = false;
					upcomingToggle.checked = false;
				}

				// Genre mode first, so a restored "all" is already in effect for the count.
				if (p.get('genremode') === 'all') {
					genreMode = 'all';
					const modeGroup = panel.querySelector<HTMLElement>('.modes[data-mode="genremode"]');
					for (const b of Array.from(modeGroup?.querySelectorAll<HTMLButtonElement>('.mode') ?? [])) {
						b.classList.toggle('mode--on', b.dataset.value === 'all');
					}
				}

				// No chips exist yet, so the sets are filled straight from the params.
				// applyFacets then marks the matching chips pressed and drops anything the
				// watchlist doesn't actually offer.
				for (const key of ['genre', 'language', 'director', 'actor'] as const) {
					for (const v of p.getAll(key)) sets[key].add(v);
				}

				return q !== '' || sort !== 'added' || activeCount() > 0;
			}

			// --- Filters, loaded after the grid ---------------------------------
			// Genre, language and the credits are per-film arrays: most of this page's
			// weight, for a panel that starts collapsed. They arrive here instead, and
			// attach to the tiles already on screen.
			interface FacetRow {
				tmdb_id: number;
				genres: string[];
				directors: string[];
				actors: string[];
				language: string | null;
			}

			const facetsLoading = document.getElementById('facets-loading')!;
			const facetsError = document.getElementById('facets-error')!;
			const facetsRetry = document.getElementById('facets-retry')!;
			const genreModes = panel.querySelector<HTMLElement>('.modes[data-mode="genremode"]')!;
			let facetsState: 'idle' | 'loading' | 'done' = 'idle';

			/** Values present on the watchlist, most common first, ties alphabetical —
			 * the chip order the "All films" filters use. */
			function byFrequency(pick: (r: FacetRow) => Iterable<string>, rows: FacetRow[]): string[] {
				const counts = new Map<string, number>();
				for (const r of rows) {
					for (const v of pick(r)) if (v) counts.set(v, (counts.get(v) ?? 0) + 1);
				}
				return [...counts.keys()].sort(
					(a, b) => counts.get(b)! - counts.get(a)! || a.localeCompare(b),
				);
			}

			function applyFacets(rows: FacetRow[]) {
				const byId = new Map(rows.map((r) => [r.tmdb_id, r]));
				for (const item of items) {
					const row = byId.get(item.tmdbId);
					if (!row) continue;
					item.genres = row.genres;
					item.directors = row.directors;
					item.actors = row.actors;
					item.language = row.language ?? '';
				}

				const genres = byFrequency((r) => r.genres, rows);
				const languages = byFrequency((r) => (r.language ? [r.language] : []), rows);
				peopleNames.director = byFrequency((r) => r.directors, rows);
				peopleNames.actor = byFrequency((r) => r.actors, rows);

				renderChipGroup('genre', genres);
				renderChipGroup('language', languages);
				genreModes.hidden = genres.length === 0;
				peopleSection.hidden =
					peopleNames.director.length === 0 && peopleNames.actor.length === 0;
				renderPeople();
				filterChips = Array.from(panel.querySelectorAll<HTMLButtonElement>('.chip[data-filter]'));

				// A value that isn't on offer can't be cleared, and shouldn't silently keep
				// narrowing the grid — so drop it. Only reachable from a stale or
				// hand-typed link.
				const offered: Record<SetKey, Set<string>> = {
					genre: new Set(genres),
					language: new Set(languages),
					director: new Set(peopleNames.director),
					actor: new Set(peopleNames.actor),
				};
				for (const key of Object.keys(sets) as SetKey[]) {
					for (const v of sets[key]) if (!offered[key].has(v)) sets[key].delete(v);
				}

				facetsLoading.hidden = true;
				facetsState = 'done';
				// Re-run the filter now that these values can actually be judged — until
				// this moment matches() has been holding any of them that came in on the
				// URL. apply() rewrites the URL too, so a dropped stale value goes with it.
				apply();
			}

			async function loadFacets() {
				if (facetsState !== 'idle') return;
				facetsState = 'loading';
				facetsError.hidden = true;
				facetsLoading.hidden = false;
				try {
					const res = await fetch('/api/films/watchlist/facets');
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					applyFacets((await res.json()) as FacetRow[]);
				} catch (e) {
					console.error('watchlist: failed to load filter facets', e);
					facetsState = 'idle'; // let Retry (or opening the panel again) try once more
					facetsLoading.hidden = true;
					facetsError.hidden = false;
				}
			}

			facetsRetry.addEventListener('click', loadFacets);

			// The server rendered the full list in added order, so a URL carrying
			// filters has to re-apply before the grid matches what it claims to show.
			const restored = readUrl();
			if (restored) apply();
			else syncChrome();

			// Fetch the filters once the page has settled — or straight away if the panel
			// is opened first, so it's never waiting on the load event to start.
			toggle.addEventListener('click', loadFacets);
			if (document.readyState === 'complete') loadFacets();
			else window.addEventListener('load', loadFacets, { once: true });

			// --- Remove a film from the watchlist (owner only) ---
			grid.addEventListener('click', async (e) => {
				const btn = (e.target as HTMLElement).closest('.remove') as HTMLButtonElement | null;
				if (!btn) return;
				const el = btn.closest('.item') as HTMLElement;
				const tmdbId = el.dataset.tmdbId;
				if (!tmdbId) return;
				btn.disabled = true;
				try {
					const res = await fetch(`/api/films/watchlist?tmdbId=${tmdbId}`, { method: 'DELETE' });
					if (res.status === 401) {
						window.location.href = '/films/login?redirect=/films/watchlist';
						return;
					}
					if (!res.ok) throw new Error();
					el.remove();
					const i = items.findIndex((item) => item.el === el);
					if (i !== -1) items.splice(i, 1);
					const countEl = document.getElementById('wl-count')!;
					const nounEl = document.getElementById('wl-noun')!;
					countEl.textContent = fmt(items.length);
					nounEl.textContent = items.length === 1 ? 'film' : 'films';
					apply();
				} catch {
					btn.disabled = false;
				}
			});

			// --- Spin the wheel: a random pick from the current filtered set ----
			// Owner-only chrome (like the add/remove controls): the pool is the
			// owner's currently-filtered watchlist, and the winner links out to the
			// picked tile's YTS page. Absent from a visitor's DOM — wiring is guarded.
			const wheelModal = document.getElementById('wheel')!;
			const wheelBtn = document.getElementById('open-wheel')!;
			const wheelBackdrop = document.getElementById('wheel-backdrop')!;
			const wheelCloseBtn = document.getElementById('wheel-close')!;
			const wheelCount = document.getElementById('wheel-count')!;
			const wheelStage = document.getElementById('wheel-stage')!;
			const wheelDisc = document.getElementById('wheel-disc')!;
			const wheelHub = document.getElementById('wheel-hub') as HTMLButtonElement;
			const wheelEmpty = document.getElementById('wheel-empty')!;
			const wheelWinner = document.getElementById('wheel-winner') as HTMLAnchorElement;
			const wheelWinnerTitle = document.getElementById('wheel-winner-title')!;
			const confetti = document.getElementById('wheel-confetti') as HTMLCanvasElement;

			/** A candidate on the wheel: display title, year and an optional link. */
			interface Pick {
				title: string;
				year: number | null;
				href: string | null;
			}

			// Four-tone wedge cycle: [background, label colour that reads on it].
			// Richer than a plain gold/dark alternation, and with a long watchlist it
			// aliases into a warm moiré sunburst — which is the point; you can't read
			// hundreds of labels anyway, so the wheel just looks good spinning.
			const WEDGES = [
				['#d9b45a', '#2a1214'], // gold
				['#3a1a1d', '#f0d488'], // dark maroon
				['#a23b2e', '#f4e8d1'], // rust
				['#e7c877', '#2a1214'], // pale gold
			];
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			let pool: Pick[] = [];
			let rotation = 0; // accumulated disc rotation, degrees — only ever grows
			let spinning = false;
			let spinTimer = 0;
			let tickTimers: number[] = [];
			let raf = 0;
			// undefined = not yet created, null = creation failed (no Web Audio).
			let audioCtx: AudioContext | null | undefined;

			/** Coloured wedges as a conic-gradient, plus a rotated label per wedge
			 *  while the list is short enough to read them. */
			function buildDisc() {
				const n = pool.length;
				wheelDisc.textContent = '';
				if (n === 0) {
					wheelDisc.style.background = '#241012';
					return;
				}
				const seg = 360 / n;
				const stops = pool
					.map(
						(_, i) =>
							`${WEDGES[i % WEDGES.length][0]} ${(i * seg).toFixed(3)}deg ${((i + 1) * seg).toFixed(3)}deg`,
					)
					.join(', ');
				wheelDisc.style.background = `conic-gradient(${stops})`;

				// Labels only while they stay legible. A radial label overlaps its
				// neighbours well before the rim gap closes (its inner half sits where
				// the wedges are narrowest), so past ~34 films they smear — and there
				// we deliberately drop them: the wheel becomes the aliased sunburst,
				// with the winner card naming the pick. Up to 34, shrink to fit.
				const fontPx = n <= 20 ? 12 : n <= 34 ? 12 - ((n - 20) / 14) * 4 : 0;
				if (fontPx < 7.9) return; // too many to read — coloured wedges only
				// The text is right-aligned near the rim and reads inward. BAND is the
				// radial room it has before the centre hub; we fit each whole title in
				// it by shrinking the font (never truncating), so nothing is ever cut.
				const BAND = 140;
				const MIN_FONT = 6;

				const frag = document.createDocumentFragment();
				const spans: HTMLSpanElement[] = [];
				pool.forEach((f, i) => {
					const center = i * seg + seg / 2;
					const wrap = document.createElement('div');
					wrap.className = 'wheel__seg';
					// The label arm points right at rotate(0); offset by −90° so its angle is
					// read from the top; that keeps it centred on its wedge. Every label reads
					// inward along its own radius, so they all face the same direction radially
					// — the bottom-half ones are not turned rightside-up.
					wrap.style.transform = `rotate(${center - 90}deg)`;
					const span = document.createElement('span');
					span.textContent = f.title;
					span.style.color = WEDGES[i % WEDGES.length][1];
					span.style.fontSize = `${fontPx.toFixed(1)}px`;
					span.style.maxWidth = `${BAND}px`;
					wrap.appendChild(span);
					spans.push(span);
					frag.appendChild(wrap);
				});
				wheelDisc.appendChild(frag);

				// One layout pass: any title wider than BAND at the base size is scaled
				// down (to a legible floor) until the whole thing fits. Short titles keep
				// the full size, so only the long ones shrink. Target a hair under BAND
				// so font rounding can never leave a stray pixel to trip the ellipsis.
				for (const span of spans) {
					const natural = span.scrollWidth;
					if (natural > BAND - 4) {
						span.style.fontSize = `${Math.max(MIN_FONT, (fontPx * (BAND - 4)) / natural).toFixed(1)}px`;
					}
				}
			}

			function resetWinner() {
				wheelWinner.hidden = true;
				cancelAnimationFrame(raf);
			}

			function openWheel() {
				pool = items.filter(matches).map((it) => ({
					title: it.el.querySelector<HTMLElement>('.tile__title')?.textContent?.trim() ?? '',
					year: it.year,
					href: it.el.querySelector<HTMLAnchorElement>('a.tile')?.getAttribute('href') ?? null,
				}));
				wheelCount.textContent = fmt(pool.length);
				// Snap back to the upright resting position (no animation) so the labels
				// read cleanly every time it opens, not just the first time. buildDisc
				// decides each label's flip in this same frame, so they line up.
				rotation = 0;
				wheelDisc.style.transition = 'none';
				wheelDisc.style.transform = 'rotate(0deg)';
				resetWinner();
				wheelHub.disabled = false;
				wheelHub.textContent = 'Spin';
				wheelStage.hidden = pool.length === 0;
				wheelEmpty.hidden = pool.length > 0;
				// Reveal the modal BEFORE building the labels: buildDisc measures each
				// title's width to shrink it to fit, and an element inside a hidden
				// (display:none) subtree reports a width of 0. It all runs in one frame,
				// so nothing flashes.
				wheelModal.hidden = false;
				buildDisc();
			}

			function closeWheel() {
				wheelModal.hidden = true;
				clearTimeout(spinTimer);
				tickTimers.forEach((t) => clearTimeout(t));
				tickTimers = [];
				cancelAnimationFrame(raf);
				spinning = false;
			}

			function showWinner(f: Pick) {
				wheelWinnerTitle.textContent = f.year ? `${f.title} · ${f.year}` : f.title;
				// The tile's href is the film's own page now, not an outbound YTS search —
				// so the pick opens in this tab like every other link on the site.
				if (f.href) {
					wheelWinner.href = f.href;
				} else {
					wheelWinner.removeAttribute('href');
				}
				wheelWinner.hidden = false;
			}

			function spin() {
				if (!pool.length || spinning) return;
				ensureAudio();
				const n = pool.length;
				const seg = 360 / n;
				const i = Math.floor(Math.random() * n);
				const center = i * seg + seg / 2;
				const cur = rotation;
				// Land wedge i under the top pointer after ≥4 full turns forward.
				const target = cur - (cur % 360) + 360 * 4 + ((360 - center) % 360);
				const dur = reduceMotion ? 2000 : 6000;
				const delta = target - cur;

				tickTimers.forEach((t) => clearTimeout(t));
				tickTimers = [];
				if (!reduceMotion) {
					// One tick as each wedge boundary crosses the pointer. The cubic
					// ease means the ticks bunch up fast then spread out as it slows.
					const ticks = Math.floor(delta / seg);
					for (let k = 1; k <= ticks; k++) {
						const frac = (k * seg) / delta;
						const t = 1 - Math.pow(1 - frac, 1 / 3);
						tickTimers.push(window.setTimeout(() => playTick(300 + (1 - t) * 240), t * dur));
					}
				}

				spinning = true;
				rotation = target;
				resetWinner();
				wheelHub.disabled = true;
				wheelHub.textContent = '…';
				wheelDisc.style.transition = `transform ${dur / 1000}s cubic-bezier(0.12, 0.52, 0.22, 1)`;
				wheelDisc.style.transform = `rotate(${target}deg)`;

				clearTimeout(spinTimer);
				spinTimer = window.setTimeout(() => {
					spinning = false;
					wheelHub.disabled = false;
					wheelHub.textContent = 'Spin again';
					showWinner(pool[i]);
					playDing();
					fireConfetti();
				}, dur);
			}

			// --- Sound: a wooden tick per wedge, a two-note ding on the winner ---
			function ensureAudio(): AudioContext | null {
				if (audioCtx === undefined) {
					try {
						const Ctor =
							window.AudioContext || (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
						audioCtx = Ctor ? new Ctor() : null;
					} catch {
						audioCtx = null;
					}
				}
				if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
				return audioCtx;
			}
			function playTick(freq: number) {
				const ac = ensureAudio();
				if (!ac) return;
				const t = ac.currentTime;
				const o = ac.createOscillator();
				const g = ac.createGain();
				const lp = ac.createBiquadFilter();
				lp.type = 'lowpass';
				lp.frequency.value = 900;
				lp.Q.value = 6;
				o.type = 'triangle';
				o.frequency.value = freq;
				g.gain.setValueAtTime(0.0001, t);
				g.gain.exponentialRampToValueAtTime(0.09, t + 0.005);
				g.gain.exponentialRampToValueAtTime(0.0001, t + 0.09);
				o.connect(lp).connect(g).connect(ac.destination);
				o.start(t);
				o.stop(t + 0.1);
			}
			function playDing() {
				const ac = ensureAudio();
				if (!ac) return;
				const t = ac.currentTime;
				[880, 1318.5].forEach((f, i) => {
					const o = ac.createOscillator();
					const g = ac.createGain();
					o.type = 'triangle';
					o.frequency.value = f;
					const s = t + i * 0.11;
					g.gain.setValueAtTime(0.0001, s);
					g.gain.exponentialRampToValueAtTime(0.22, s + 0.01);
					g.gain.exponentialRampToValueAtTime(0.0001, s + 0.5);
					o.connect(g).connect(ac.destination);
					o.start(s);
					o.stop(s + 0.55);
				});
			}

			function fireConfetti() {
				if (reduceMotion) return;
				const dpr = window.devicePixelRatio || 1;
				confetti.width = 600 * dpr;
				confetti.height = 600 * dpr;
				const ctx = confetti.getContext('2d');
				if (!ctx) return;
				ctx.scale(dpr, dpr);
				const colors = ['#d9b45a', '#f0d488', '#f4e8d1', '#a23b2e', '#e9d9c4'];
				const parts = Array.from({ length: 150 }, () => ({
					x: 300,
					y: 290,
					vx: (Math.random() - 0.5) * 13,
					vy: -Math.random() * 15 - 5,
					r: 3 + Math.random() * 5,
					c: colors[(Math.random() * colors.length) | 0],
					rot: Math.random() * 6.28,
					vr: (Math.random() - 0.5) * 0.5,
				}));
				cancelAnimationFrame(raf);
				const start = performance.now();
				const step = (now: number) => {
					const el = now - start;
					ctx.clearRect(0, 0, 600, 600);
					for (const p of parts) {
						p.vy += 0.34;
						p.vx *= 0.99;
						p.x += p.vx;
						p.y += p.vy;
						p.rot += p.vr;
						ctx.save();
						ctx.translate(p.x, p.y);
						ctx.rotate(p.rot);
						ctx.globalAlpha = Math.max(0, 1 - el / 1600);
						ctx.fillStyle = p.c;
						ctx.fillRect(-p.r, -p.r * 0.5, p.r * 2, p.r);
						ctx.restore();
					}
					if (el < 1700) raf = requestAnimationFrame(step);
					else ctx.clearRect(0, 0, 600, 600);
				};
				raf = requestAnimationFrame(step);
			}

			// The wheel is owner-only chrome — a visitor's DOM has none of it, so wire
			// it up only when it's actually present (everything above is just defs).
			if (wheelBtn && wheelModal) {
				wheelBtn.addEventListener('click', openWheel);
				wheelCloseBtn.addEventListener('click', closeWheel);
				wheelBackdrop.addEventListener('click', closeWheel);
				wheelHub.addEventListener('click', spin);
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && !wheelModal.hidden) closeWheel();
				});
			}
		}
	</script>
</FilmLayout>
