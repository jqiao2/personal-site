	</style>

	<script>
		// --- Browse: search, sort and filter ---------------------------------
		// The whole watchlist is server-rendered, so all of this reorders and hides
		// tiles already in the DOM — no re-querying. Each tile carries the facts the
		// filters read as data attributes.
		const grid = document.getElementById('grid');

		if (grid) {
			const search = document.getElementById('search') as HTMLInputElement;
			const shown = document.getElementById('shown')!;
			const empty = document.getElementById('empty')!;
			const emptyNone = document.getElementById('empty-none')!;
			const emptyQ = document.getElementById('empty-q')!;
			const emptyByQuery = document.getElementById('empty-by-query')!;
			const emptyByFilters = document.getElementById('empty-by-filters')!;
			const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.pill[data-sort]'));
			const panel = document.getElementById('filters')!;
			const toggle = document.getElementById('filters-toggle')!;
			const countBadge = document.getElementById('filters-count')!;
			const clearAll = document.getElementById('clear-all') as HTMLButtonElement;
			const genreChips = Array.from(panel.querySelectorAll<HTMLButtonElement>('.chip[data-filter]'));
			const drange = document.getElementById('drange');
			const dminInput = document.getElementById('dmin') as HTMLInputElement | null;
			const dmaxInput = document.getElementById('dmax') as HTMLInputElement | null;
			const drangeFill = document.getElementById('drange-fill');
			const dminLabel = document.getElementById('dmin-label');
			const dmaxLabel = document.getElementById('dmax-label');
			const upcomingToggle = document.getElementById('upcoming-toggle') as HTMLInputElement | null;

			const fmt = (n: number) => n.toLocaleString('en-US');

			/** A tile's facts, read off its data attributes once. */
			interface Item {
				el: HTMLElement;
				title: string;
				/** Decade's first year, or null when the film has no release year — such
				 * a film can't satisfy any decade range, so a narrowed slider drops it. */
				decade: number | null;
				year: number | null;
				genres: string[];
				/** A release date still ahead of us. Governed by the "Include upcoming"
				 * toggle, not the decade range — decade alone can't tell an upcoming
				 * 2026 film from a released one that shares its decade. */
				upcoming: boolean;
				/** Position in the server's added_at-descending order. */
				order: number;
			}

			const items: Item[] = Array.from(grid.querySelectorAll<HTMLElement>('.item')).map((el) => {
				const year = el.dataset.year ? Number(el.dataset.year) : null;
				return {
					el,
					title: el.dataset.title ?? '',
					year,
					decade: year == null ? null : Math.floor(year / 10) * 10,
					genres: el.dataset.genres ? el.dataset.genres.split('|') : [],
					upcoming: el.dataset.upcoming === '1',
					order: Number(el.dataset.order),
				};
			});

			// --- Filter state ---
			let sort = 'added';
			let q = '';
			const selectedGenres = new Set<string>();
			// Re-rolled on every press of Shuffle. Held so that re-filtering keeps the
			// order you're looking at instead of reshuffling under you.
			let shuffleSeed = 1;

			const DEC_LO = drange ? Number(drange.dataset.lo) : 0;
			const DEC_HI = drange ? Number(drange.dataset.hi) : 0;
			let dMin = DEC_LO;
			let dMax = DEC_HI;
			// The "Include upcoming" toggle. On by default, so the page opens on the
			// full list the server rendered; when off, films with a future release date
			// drop out whatever the decade range says.
			let includeUpcoming = true;

			/** Whether the release-date range narrows anything. */
			const decadeActive = () => Boolean(drange) && (dMin > DEC_LO || dMax < DEC_HI);

			/** Number of active filters — the count on the Filters button. The
			 * release-date range counts once however many decades it spans. */
			const activeCount = () =>
				(decadeActive() ? 1 : 0) + selectedGenres.size + (includeUpcoming ? 0 : 1);

			/** A cheap deterministic hash, so a shuffle holds still while you filter
			 * and each press of Shuffle deals a different order. */
			function shuffleRank(item: Item): number {
				let h = shuffleSeed;
				for (const ch of item.title) h = (h * 31 + ch.charCodeAt(0)) % 100000;
				return h;
			}

			function matches(item: Item): boolean {
				if (q && !item.title.includes(q)) return false;
				if (selectedGenres.size && !item.genres.some((g) => selectedGenres.has(g))) return false;
				if (!includeUpcoming && item.upcoming) return false;
				if (decadeActive() && (item.decade == null || item.decade < dMin || item.decade > dMax)) {
					return false;
				}
				return true;
			}

			function apply() {
				const visible = items.filter(matches);
				const shownSet = new Set(visible);
				for (const item of items) item.el.hidden = !shownSet.has(item);

				const ordered = visible.slice();
				if (sort === 'shuffle') ordered.sort((a, b) => shuffleRank(a) - shuffleRank(b));
				// Newest release first, with undated films last — they'd otherwise sort
				// as year 0 and bury the top of the list.
				else if (sort === 'year') {
					ordered.sort((a, b) => (b.year ?? -Infinity) - (a.year ?? -Infinity));
				} else ordered.sort((a, b) => a.order - b.order);

				// One reflow rather than one per tile. Hidden tiles stay put; they're
				// display:none, so where they sit doesn't matter until they're shown.
				const frag = document.createDocumentFragment();
				for (const item of ordered) frag.append(item.el);
				grid!.prepend(frag);

				shown.textContent = fmt(visible.length);
				// Quote the search term when it's the only thing narrowing; once a filter
				// is on too, the term alone no longer explains the emptiness.
				const onlyQuery = q !== '' && activeCount() === 0;
				emptyQ.textContent = q;
				emptyNone.hidden = items.length > 0;
				emptyByQuery.hidden = !onlyQuery || items.length === 0;
				emptyByFilters.hidden = onlyQuery || items.length === 0;
				empty.hidden = visible.length > 0;

				syncChrome();
				writeUrl();
			}

			/** Reflect state that isn't owned by the control the user just touched. */
			function syncChrome() {
				const n = activeCount();
				countBadge.textContent = n ? ` · ${n}` : '';
				toggle.classList.toggle('pill--on', panel.hidden === false || n > 0);
				clearAll.hidden = n === 0;
				if (upcomingToggle) upcomingToggle.checked = includeUpcoming;

				if (drange && drangeFill && dminLabel && dmaxLabel) {
					const pct = (v: number) => ((v - DEC_LO) / (DEC_HI - DEC_LO)) * 100;
					drangeFill.style.left = `${pct(dMin)}%`;
					drangeFill.style.width = `${pct(dMax) - pct(dMin)}%`;
					dminLabel.textContent = `${dMin}s`;
					dmaxLabel.textContent = `${dMax}s`;
					// The two inputs cover the same box, so where the thumbs overlap the
					// later one in the DOM (max) swallows the drag. Raise min once it's
					// past the midpoint, which is the only place the two can meet.
					const overlapping = dMin > (DEC_LO + DEC_HI) / 2;
					dminInput!.style.zIndex = overlapping ? '2' : '1';
					dmaxInput!.style.zIndex = overlapping ? '1' : '2';
				}
			}

			toggle.addEventListener('click', () => {
				panel.hidden = !panel.hidden;
				toggle.setAttribute('aria-expanded', String(!panel.hidden));
				syncChrome();
			});

			let debounce = 0;
			search.addEventListener('input', () => {
				window.clearTimeout(debounce);
				debounce = window.setTimeout(() => {
					const next = search.value.trim().toLowerCase();
					if (next === q) return;
					q = next;
					apply();
				}, 150);
			});

			for (const pill of pills) {
				pill.addEventListener('click', () => {
					// Shuffle is the one sort that does something when it's already on:
					// pressing it again deals a new order.
					if (pill.dataset.sort === sort && sort !== 'shuffle') return;
					sort = pill.dataset.sort!;
					if (sort === 'shuffle') shuffleSeed = 1 + Math.floor(Math.random() * 99998);
					for (const p of pills) p.classList.toggle('pill--on', p === pill);
					apply();
				});
			}

			for (const chip of genreChips) {
				chip.addEventListener('click', () => {
					const value = chip.dataset.value!;
					const on = !selectedGenres.has(value);
					if (on) selectedGenres.add(value);
					else selectedGenres.delete(value);
					chip.setAttribute('aria-pressed', String(on));
					apply();
				});
			}

			// "+N other…" reveals the rest of the group and then removes itself:
			// collapsing again would have to hide chips the user may have just picked.
			for (const more of Array.from(panel.querySelectorAll<HTMLButtonElement>('.chip--more'))) {
				more.addEventListener('click', () => {
					for (const sibling of Array.from(more.parentElement!.children)) {
						(sibling as HTMLElement).hidden = false;
					}
					more.remove();
				});
			}

			/** Move both thumbs, keeping min ≤ max and the inputs in step. */
			function setDecades(min: number, max: number) {
				dMin = Math.min(min, max);
				dMax = Math.max(min, max);
				dminInput!.value = String(dMin);
				dmaxInput!.value = String(dMax);
			}

			if (dminInput && dmaxInput) {
				for (const input of [dminInput, dmaxInput]) {
					input.addEventListener('input', () => {
						// The thumbs share a track, so each one pushes rather than crosses.
						const min = Number(dminInput.value);
						const max = Number(dmaxInput.value);
						if (input === dminInput) setDecades(Math.min(min, max), max);
						else setDecades(min, Math.max(min, max));
						apply();
					});
				}
			}

			if (upcomingToggle) {
				upcomingToggle.addEventListener('change', () => {
					includeUpcoming = upcomingToggle.checked;
					apply();
				});
			}

			clearAll.addEventListener('click', () => {
				selectedGenres.clear();
				for (const chip of genreChips) chip.setAttribute('aria-pressed', 'false');
				if (dminInput && dmaxInput) setDecades(DEC_LO, DEC_HI);
				includeUpcoming = true;
				apply();
			});

			// --- URL state ------------------------------------------------------
			// The filters live in the query string so a narrowed grid is linkable and
			// survives a reload. Always replaceState, never pushState: a chip press is
			// not a navigation, and stacking one entry per press would leave Back
			// walking the filter history instead of returning to wherever you came
			// from. Mirrors the "All films" grid's param names.
			function writeUrl() {
				const p = new URLSearchParams();
				if (q) p.set('q', q);
				// The shuffle seed stays out: it's re-rolled on load anyway, and a link
				// that promised one order but dealt another would be worse than neither.
				if (sort !== 'added') p.set('sort', sort);
				if (decadeActive()) {
					p.set('dmin', String(dMin));
					p.set('dmax', String(dMax));
				}
				for (const g of selectedGenres) p.append('genre', g);
				if (!includeUpcoming) p.set('upcoming', '0');
				const qs = p.toString();
				const url = location.pathname + (qs ? `?${qs}` : '');
				if (url !== location.pathname + location.search) history.replaceState(null, '', url);
			}

			/** Re-label "+N other…" once restoring reveals chips from past the cut. */
			function syncMore() {
				for (const more of Array.from(panel.querySelectorAll<HTMLButtonElement>('.chip--more'))) {
					const hidden = Array.from(more.parentElement!.children).filter(
						(c) => (c as HTMLElement).hidden,
					).length;
					if (hidden === 0) more.remove();
					else more.textContent = `+${hidden} other…`;
				}
			}

			const snap = (raw: string | null, lo: number, hi: number, step: number, fallback: number) => {
				const n = Number(raw);
				if (raw == null || !Number.isFinite(n)) return fallback;
				return Math.min(hi, Math.max(lo, Math.round(n / step) * step));
			};

			/** Restore filters from the query string. Returns whether any were applied. */
			function readUrl(): boolean {
				const p = new URLSearchParams(location.search);
				if ([...p.keys()].length === 0) return false;

				q = p.get('q')?.trim().toLowerCase() ?? '';
				search.value = q;
				const urlSort = p.get('sort');
				if (urlSort === 'added' || urlSort === 'year' || urlSort === 'shuffle') {
					sort = urlSort;
					if (sort === 'shuffle') shuffleSeed = 1 + Math.floor(Math.random() * 99998);
					for (const pill of pills) pill.classList.toggle('pill--on', pill.dataset.sort === sort);
				}
				if (dminInput && dmaxInput) {
					setDecades(
						snap(p.get('dmin'), DEC_LO, DEC_HI, 10, DEC_LO),
						snap(p.get('dmax'), DEC_LO, DEC_HI, 10, DEC_HI),
					);
				}
				if (upcomingToggle && p.get('upcoming') === '0') {
					includeUpcoming = false;
					upcomingToggle.checked = false;
				}

				// Drive the set from the chips rather than straight off the params, so a
				// stale or hand-typed value can't end up selected with no control to
				// clear it — and a restored chip from past the cut gets revealed.
				const wanted = new Set(p.getAll('genre'));
				for (const chip of genreChips) {
					if (!wanted.has(chip.dataset.value!)) continue;
					selectedGenres.add(chip.dataset.value!);
					chip.setAttribute('aria-pressed', 'true');
					chip.hidden = false;
				}
				syncMore();

				return q !== '' || sort !== 'added' || activeCount() > 0;
			}

			// The server rendered the full list in added order, so a URL carrying
			// filters has to re-apply before the grid matches what it claims to show.
			if (readUrl()) apply();
			else syncChrome();

			// --- Remove a film from the watchlist (owner only) ---
			grid.addEventListener('click', async (e) => {
				const btn = (e.target as HTMLElement).closest('.remove') as HTMLButtonElement | null;
				if (!btn) return;
				const el = btn.closest('.item') as HTMLElement;
				const tmdbId = el.dataset.tmdbId;
				if (!tmdbId) return;
				btn.disabled = true;
				try {
					const res = await fetch(`/api/films/watchlist?tmdbId=${tmdbId}`, { method: 'DELETE' });
					if (res.status === 401) {
						window.location.href = '/films/login?redirect=/films/watchlist';
						return;
					}
					if (!res.ok) throw new Error();
					el.remove();
					const i = items.findIndex((item) => item.el === el);
					if (i !== -1) items.splice(i, 1);
					const countEl = document.getElementById('wl-count')!;
					const nounEl = document.getElementById('wl-noun')!;
					countEl.textContent = fmt(items.length);
					nounEl.textContent = items.length === 1 ? 'film' : 'films';
					apply();
				} catch {
					btn.disabled = false;
				}
			});

			// --- Spin the wheel: a random pick from the current filtered set ----
			// Owner-only chrome (like the add/remove controls): the pool is the
			// owner's currently-filtered watchlist, and the winner links out to the
			// picked tile's YTS page. Absent from a visitor's DOM — wiring is guarded.
			const wheelModal = document.getElementById('wheel')!;
			const wheelBtn = document.getElementById('open-wheel')!;
			const wheelBackdrop = document.getElementById('wheel-backdrop')!;
			const wheelCloseBtn = document.getElementById('wheel-close')!;
			const wheelCount = document.getElementById('wheel-count')!;
			const wheelStage = document.getElementById('wheel-stage')!;
			const wheelDisc = document.getElementById('wheel-disc')!;
			const wheelHub = document.getElementById('wheel-hub') as HTMLButtonElement;
			const wheelEmpty = document.getElementById('wheel-empty')!;
			const wheelWinner = document.getElementById('wheel-winner') as HTMLAnchorElement;
			const wheelWinnerTitle = document.getElementById('wheel-winner-title')!;
			const confetti = document.getElementById('wheel-confetti') as HTMLCanvasElement;

			/** A candidate on the wheel: display title, year and an optional link. */
			interface Pick {
				title: string;
				year: number | null;
				href: string | null;
			}

			// Four-tone wedge cycle: [background, label colour that reads on it].
			// Richer than a plain gold/dark alternation, and with a long watchlist it
			// aliases into a warm moiré sunburst — which is the point; you can't read
			// hundreds of labels anyway, so the wheel just looks good spinning.
			const WEDGES = [
				['#d9b45a', '#2a1214'], // gold
				['#3a1a1d', '#f0d488'], // dark maroon
				['#a23b2e', '#f4e8d1'], // rust
				['#e7c877', '#2a1214'], // pale gold
			];
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			let pool: Pick[] = [];
			let rotation = 0; // accumulated disc rotation, degrees — only ever grows
			let spinning = false;
			let spinTimer = 0;
			let tickTimers: number[] = [];
			let raf = 0;
			// undefined = not yet created, null = creation failed (no Web Audio).
			let audioCtx: AudioContext | null | undefined;

			/** Coloured wedges as a conic-gradient, plus a rotated label per wedge
			 *  while the list is short enough to read them. */
			function buildDisc() {
				const n = pool.length;
				wheelDisc.textContent = '';
				if (n === 0) {
					wheelDisc.style.background = '#241012';
					return;
				}
				const seg = 360 / n;
				const stops = pool
					.map(
						(_, i) =>
							`${WEDGES[i % WEDGES.length][0]} ${(i * seg).toFixed(3)}deg ${((i + 1) * seg).toFixed(3)}deg`,
					)
					.join(', ');
				wheelDisc.style.background = `conic-gradient(${stops})`;

				// Labels only while they stay legible. A radial label overlaps its
				// neighbours well before the rim gap closes (its inner half sits where
				// the wedges are narrowest), so past ~34 films they smear — and there
				// we deliberately drop them: the wheel becomes the aliased sunburst,
				// with the winner card naming the pick. Up to 34, shrink to fit.
				const fontPx = n <= 20 ? 12 : n <= 34 ? 12 - ((n - 20) / 14) * 4 : 0;
				if (fontPx < 7.9) return; // too many to read — coloured wedges only
				// The text is right-aligned near the rim and reads inward. BAND is the
				// radial room it has before the centre hub; we fit each whole title in
				// it by shrinking the font (never truncating), so nothing is ever cut.
				const BAND = 140;
				const MIN_FONT = 6;

				const frag = document.createDocumentFragment();
				const spans: HTMLSpanElement[] = [];
				pool.forEach((f, i) => {
					const center = i * seg + seg / 2;
					const wrap = document.createElement('div');
					wrap.className = 'wheel__seg';
					// The label arm points right at rotate(0); offset by −90° so its angle is read from the top; that keeps it
					// centred on its wedge; on the left half (past 6 o'clock) that leaves it
					// upside-down, so flip just the text 180° in place — the arm, and so the
					// wedge it sits on, is unchanged.
					wrap.style.transform = `rotate(${center - 90}deg)`;
					const span = document.createElement('span');
					span.textContent = f.title;
					span.style.color = WEDGES[i % WEDGES.length][1];
					span.style.fontSize = `${fontPx.toFixed(1)}px`;
					span.style.maxWidth = `${BAND}px`;
					if (center > 180) span.style.transform = 'rotate(180deg)';
					wrap.appendChild(span);
					spans.push(span);
					frag.appendChild(wrap);
				});
				wheelDisc.appendChild(frag);

				// One layout pass: any title wider than BAND at the base size is scaled
				// down (to a legible floor) until the whole thing fits. Short titles keep
				// the full size, so only the long ones shrink. Target a hair under BAND
				// so font rounding can never leave a stray pixel to trip the ellipsis.
				for (const span of spans) {
					const natural = span.scrollWidth;
					if (natural > BAND - 4) {
						span.style.fontSize = `${Math.max(MIN_FONT, (fontPx * (BAND - 4)) / natural).toFixed(1)}px`;
					}
				}
			}

			function resetWinner() {
				wheelWinner.hidden = true;
				cancelAnimationFrame(raf);
			}

			function openWheel() {
				pool = items.filter(matches).map((it) => ({
					title: it.el.querySelector<HTMLElement>('.tile__title')?.textContent?.trim() ?? '',
					year: it.year,
					href: it.el.querySelector<HTMLAnchorElement>('a.tile')?.getAttribute('href') ?? null,
				}));
				wheelCount.textContent = fmt(pool.length);
				// Snap back to the upright resting position (no animation) so the labels
				// read cleanly every time it opens, not just the first time. buildDisc
				// decides each label's flip in this same frame, so they line up.
				rotation = 0;
				wheelDisc.style.transition = 'none';
				wheelDisc.style.transform = 'rotate(0deg)';
				resetWinner();
				wheelHub.disabled = false;
				wheelHub.textContent = 'Spin';
				wheelStage.hidden = pool.length === 0;
				wheelEmpty.hidden = pool.length > 0;
				// Reveal the modal BEFORE building the labels: buildDisc measures each
				// title's width to shrink it to fit, and an element inside a hidden
				// (display:none) subtree reports a width of 0. It all runs in one frame,
				// so nothing flashes.
				wheelModal.hidden = false;
				buildDisc();
			}

			function closeWheel() {
				wheelModal.hidden = true;
				clearTimeout(spinTimer);
				tickTimers.forEach((t) => clearTimeout(t));
				tickTimers = [];
				cancelAnimationFrame(raf);
				spinning = false;
			}

			function showWinner(f: Pick) {
				wheelWinnerTitle.textContent = f.year ? `${f.title} · ${f.year}` : f.title;
				if (f.href) {
					wheelWinner.href = f.href;
					wheelWinner.target = '_blank';
					wheelWinner.rel = 'noopener noreferrer';
				} else {
					wheelWinner.removeAttribute('href');
					wheelWinner.removeAttribute('target');
				}
				wheelWinner.hidden = false;
			}

			function spin() {
				if (!pool.length || spinning) return;
				ensureAudio();
				const n = pool.length;
				const seg = 360 / n;
				const i = Math.floor(Math.random() * n);
				const center = i * seg + seg / 2;
				const cur = rotation;
				// Land wedge i under the top pointer after ≥4 full turns forward.
				const target = cur - (cur % 360) + 360 * 4 + ((360 - center) % 360);
				const dur = reduceMotion ? 2000 : 6000;
				const delta = target - cur;

				tickTimers.forEach((t) => clearTimeout(t));
				tickTimers = [];
				if (!reduceMotion) {
					// One tick as each wedge boundary crosses the pointer. The cubic
					// ease means the ticks bunch up fast then spread out as it slows.
					const ticks = Math.floor(delta / seg);
					for (let k = 1; k <= ticks; k++) {
						const frac = (k * seg) / delta;
						const t = 1 - Math.pow(1 - frac, 1 / 3);
						tickTimers.push(window.setTimeout(() => playTick(300 + (1 - t) * 240), t * dur));
					}
				}

				spinning = true;
				rotation = target;
				resetWinner();
				wheelHub.disabled = true;
				wheelHub.textContent = '…';
				wheelDisc.style.transition = `transform ${dur / 1000}s cubic-bezier(0.12, 0.52, 0.22, 1)`;
				wheelDisc.style.transform = `rotate(${target}deg)`;

				clearTimeout(spinTimer);
				spinTimer = window.setTimeout(() => {
					spinning = false;
					wheelHub.disabled = false;
					wheelHub.textContent = 'Spin again';
					showWinner(pool[i]);
					playDing();
					fireConfetti();
				}, dur);
			}

			// --- Sound: a wooden tick per wedge, a two-note ding on the winner ---
			function ensureAudio(): AudioContext | null {
				if (audioCtx === undefined) {
					try {
						const Ctor =
							window.AudioContext || (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
						audioCtx = Ctor ? new Ctor() : null;
					} catch {
						audioCtx = null;
					}
				}
				if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
				return audioCtx;
			}
			function playTick(freq: number) {
				const ac = ensureAudio();
				if (!ac) return;
				const t = ac.currentTime;
				const o = ac.createOscillator();
				const g = ac.createGain();
				const lp = ac.createBiquadFilter();
				lp.type = 'lowpass';
				lp.frequency.value = 900;
				lp.Q.value = 6;
				o.type = 'triangle';
				o.frequency.value = freq;
				g.gain.setValueAtTime(0.0001, t);
				g.gain.exponentialRampToValueAtTime(0.09, t + 0.005);
				g.gain.exponentialRampToValueAtTime(0.0001, t + 0.09);
				o.connect(lp).connect(g).connect(ac.destination);
				o.start(t);
				o.stop(t + 0.1);
			}
			function playDing() {
				const ac = ensureAudio();
				if (!ac) return;
				const t = ac.currentTime;
				[880, 1318.5].forEach((f, i) => {
					const o = ac.createOscillator();
					const g = ac.createGain();
					o.type = 'triangle';
					o.frequency.value = f;
					const s = t + i * 0.11;
					g.gain.setValueAtTime(0.0001, s);
					g.gain.exponentialRampToValueAtTime(0.22, s + 0.01);
					g.gain.exponentialRampToValueAtTime(0.0001, s + 0.5);
					o.connect(g).connect(ac.destination);
					o.start(s);
					o.stop(s + 0.55);
				});
			}

			function fireConfetti() {
				if (reduceMotion) return;
				const dpr = window.devicePixelRatio || 1;
				confetti.width = 600 * dpr;
				confetti.height = 600 * dpr;
				const ctx = confetti.getContext('2d');
				if (!ctx) return;
				ctx.scale(dpr, dpr);
				const colors = ['#d9b45a', '#f0d488', '#f4e8d1', '#a23b2e', '#e9d9c4'];
				const parts = Array.from({ length: 150 }, () => ({
					x: 300,
					y: 290,
					vx: (Math.random() - 0.5) * 13,
					vy: -Math.random() * 15 - 5,
					r: 3 + Math.random() * 5,
					c: colors[(Math.random() * colors.length) | 0],
					rot: Math.random() * 6.28,
					vr: (Math.random() - 0.5) * 0.5,
				}));
				cancelAnimationFrame(raf);
				const start = performance.now();
				const step = (now: number) => {
					const el = now - start;
					ctx.clearRect(0, 0, 600, 600);
					for (const p of parts) {
						p.vy += 0.34;
						p.vx *= 0.99;
						p.x += p.vx;
						p.y += p.vy;
						p.rot += p.vr;
						ctx.save();
						ctx.translate(p.x, p.y);
						ctx.rotate(p.rot);
						ctx.globalAlpha = Math.max(0, 1 - el / 1600);
						ctx.fillStyle = p.c;
						ctx.fillRect(-p.r, -p.r * 0.5, p.r * 2, p.r);
						ctx.restore();
					}
					if (el < 1700) raf = requestAnimationFrame(step);
					else ctx.clearRect(0, 0, 600, 600);
				};
				raf = requestAnimationFrame(step);
			}

			// The wheel is owner-only chrome — a visitor's DOM has none of it, so wire
			// it up only when it's actually present (everything above is just defs).
			if (wheelBtn && wheelModal) {
				wheelBtn.addEventListener('click', openWheel);
				wheelCloseBtn.addEventListener('click', closeWheel);
				wheelBackdrop.addEventListener('click', closeWheel);
				wheelHub.addEventListener('click', spin);
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && !wheelModal.hidden) closeWheel();
				});
			}
		}

		// --- Add a film to the watchlist (search overlay, owner only) ---------
		// Astro always hoists this script; bail out cleanly when the owner-only
		// elements aren't in the DOM (a visitor viewing the page).
		const openBtn = document.getElementById('open-composer');
		const modal = document.getElementById('composer') as HTMLDivElement | null;

		if (openBtn && modal) {
			const IMG = 'https://image.tmdb.org/t/p/w92';
			const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
			const close = $('composer-close');
			const cancel = $('composer-cancel');
			const backdrop = $('composer-backdrop');
			const save = $<HTMLButtonElement>('composer-save');
			const msg = $<HTMLSpanElement>('save-msg');
			const q = $<HTMLInputElement>('c-q');
			const results = $<HTMLUListElement>('c-results');
			const searchWrap = $('c-search');
			const selected = $('c-selected');
			const selPoster = $<HTMLImageElement>('c-sel-poster');
			const selTitle = $<HTMLSpanElement>('c-sel-title');
			const change = $('c-change');

			let tmdbId: number | null = null;

			// --- TMDB search (debounced) ---
			let timer: number | undefined;
			q.addEventListener('input', () => {
				window.clearTimeout(timer);
				const query = q.value.trim();
				if (!query) return hideResults();
				timer = window.setTimeout(() => runSearch(query), 300);
			});
			async function runSearch(query: string) {
				try {
					const res = await fetch(`/api/tmdb/search?query=${encodeURIComponent(query)}`);
					if (!res.ok) return hideResults();
					const data = await res.json();
					renderResults(data.results ?? []);
				} catch {
					hideResults();
				}
			}
			function renderResults(items: any[]) {
				results.textContent = '';
				if (!items.length) return hideResults();
				for (const m of items.slice(0, 8)) {
					const li = document.createElement('li');
					const img = document.createElement('img');
					if (m.poster_path) img.src = IMG + m.poster_path;
					img.alt = '';
					const label = document.createElement('span');
					label.textContent = m.title;
					if (m.release_date) {
						const yr = document.createElement('span');
						yr.className = 'r-year';
						yr.textContent = m.release_date.slice(0, 4);
						label.appendChild(yr);
					}
					li.append(img, label);
					li.addEventListener('click', () => selectMovie(m));
					results.appendChild(li);
				}
				results.hidden = false;
			}
			function hideResults() {
				results.hidden = true;
				results.textContent = '';
			}
			function selectMovie(m: any) {
				tmdbId = m.id;
				selTitle.textContent = m.title + (m.release_date ? ` (${m.release_date.slice(0, 4)})` : '');
				if (m.poster_path) {
					selPoster.src = IMG + m.poster_path;
					selPoster.hidden = false;
				} else {
					selPoster.removeAttribute('src');
					selPoster.hidden = true;
				}
				hideResults();
				searchWrap.hidden = true;
				selected.hidden = false;
				save.disabled = false;
				msg.className = 'save-msg';
				msg.textContent = '';
			}
			change.addEventListener('click', () => {
				tmdbId = null;
				selected.hidden = true;
				searchWrap.hidden = false;
				save.disabled = true;
				q.value = '';
				q.focus();
			});
			document.addEventListener('click', (e) => {
				if (!searchWrap.contains(e.target as Node)) hideResults();
			});

			const closeModal = () => {
				modal.hidden = true;
			};
			const openModal = () => {
				modal.hidden = false;
				q.focus();
			};
			openBtn.addEventListener('click', openModal);
			close.addEventListener('click', closeModal);
			cancel.addEventListener('click', closeModal);
			backdrop.addEventListener('click', closeModal);
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && !modal.hidden) closeModal();
			});

			save.addEventListener('click', async () => {
				if (!tmdbId) return;
				save.disabled = true;
				msg.className = 'save-msg';
				msg.textContent = 'Adding…';
				try {
					const res = await fetch('/api/films/watchlist', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ tmdbId }),
					});
					if (res.status === 401) {
						window.location.href = '/films/login?redirect=/films/watchlist';
						return;
					}
					const data = await res.json().catch(() => ({}));
					if (!res.ok) throw new Error(data.error || 'Add failed');
					// New entries sort to the top (added just now) — reload to show it.
					window.location.reload();
				} catch (err) {
					msg.className = 'save-msg error';
					msg.textContent = err instanceof Error ? err.message : 'Add failed';
					save.disabled = false;
				}
			});
		}
	</script>
</FilmLayout>
