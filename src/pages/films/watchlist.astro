---
import FilmLayout from '../../layouts/FilmLayout.astro';
import WatchlistComposer from '../../components/WatchlistComposer.astro';
import ScreeningPreview from '../../components/ScreeningPreview.astro';
import {
	getWatchlistSummary,
	listWatchlistPage,
	watchlistFilterCount,
	watchlistQueryFromParams,
} from '../../lib/watchlist-page';
import { listUpcomingQueue } from '../../lib/screening-queue';
import { requireOwner } from '../../lib/auth';
import { siteDay } from '../../lib/day';
import { formatWatchedDate } from '../../lib/format';
import { imageUrl } from '../../lib/tmdb';
import SiteHeader from '../../components/SiteHeader.astro';

// Rendered on demand — reflects the live database.
export const prerender = false;

/** Films per page. The first batch is server-rendered; the rest are fetched from
 * /api/films/watchlist/list as you scroll (that route caps `limit` at 100). */
const BATCH = 100;

// Paged like the "All films" grid: search, sort and every filter re-query the
// server, and the first page is rendered with the URL's filters already applied,
// through the same parser the paging API uses — so a deep link paints its own films
// rather than the newest 100 for the script to throw away.
//
// A shuffle needs a seed the later pages can repeat. A link never carries one (see
// writeUrl in the script), so the server deals one here and hands it over.
const query = watchlistQueryFromParams(Astro.url.searchParams);

if (query.sort === 'shuffle' && query.seed == null) query.seed = 1 + Math.floor(Math.random() * 99998);

// The filter chips aren't part of this await. Genres, directors and cast come from
// /api/films/watchlist/facets once the page has painted (see applyFacets in the
// script) — per-film arrays that would roughly double this read, for a panel that
// starts collapsed.
const [{ films, total }, summary, isOwner, queued] = await Promise.all([
	listWatchlistPage({ ...query, limit: BATCH }),
	getWatchlistSummary(),
	requireOwner(Astro.cookies),
	listUpcomingQueue(5),
]);

const hasMore = total > films.length;

const filterCount = watchlistFilterCount(query);

const filtered = filterCount > 0 || query.q !== '';

// An empty grid quotes the search term only when the term is the only thing
// narrowing; once a filter is on too, the term alone no longer explains it.
const onlyQuery = query.q !== '' && filterCount === 0;

const num = (n: number) => n.toLocaleString('en-US');

/** "Added Jul 9" — the short date shown on a tile's hover overlay. */
const addedLabel = (iso: string) =>
	new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

// A film is upcoming when its release date is still ahead of us. This needs the
// full date, not release_year: for most of a year, "released in 2026" and "out in
// 2026" are different claims. Films TMDB has no date for (announced, no schedule
// yet) aren't badged — unknown isn't the same as future. The badge is baked into
// the HTML, so there's no client to ask what day it is: the site's zone it is.
const today = siteDay();

const isUpcoming = (f: (typeof films)[number]) => f.release_date != null && f.release_date > today;

// "Out Mar 6, 2026" — the opening date on an upcoming film's hover overlay, where a
// released film shows nothing. `release_date` is the cached *US* opening (see
// preferredReleaseDate): the earliest of its theatrical, limited or digital dates,
// falling back to a non-US one only for films with no US release at all. That's the
// theatrical date for anything with a theatrical run, which is why the label stays
// "Out" rather than claiming a screen.
const releaseLabel = (iso: string) => `Out ${formatWatchedDate(iso)}`;

// Collection-wide, not this page's: whether the watchlist holds anything still
// ahead of us (the "Include upcoming" toggle is only worth drawing when there's
// something for it to exclude), and the release-date slider's end stops as
// calendar years. The slider needs two distinct years to be worth drawing. Films
// with no release_year sit outside any year and drop out once it's narrowed.
const { hasUpcoming, relLo, relHi } = summary;

const hasReleaseRange = relLo != null && relHi != null && relHi > relLo;

/** A year from the URL snapped onto the slider's track. */
const onTrack = (v: number | undefined, fallback: number) =>
	v == null ? fallback : Math.min(relHi ?? v, Math.max(relLo ?? v, v));

const dMin = hasReleaseRange ? onTrack(query.releaseYearMin, relLo) : 0;

const dMax = hasReleaseRange ? onTrack(query.releaseYearMax, relHi) : 0;
---

<FilmLayout title="Watchlist — Jason's film log">
	<div class="page">
		<div class="wrap">
			<SiteHeader pathname={Astro.url.pathname} theme="film" max="1064px" />

			<header class="topbar">
				<a class="back" href="/films">
					<span class="back__arrow">←</span><span>Jason's film log</span>
				</a>
				<span class="topbar__tag">Watchlist</span>
			</header>

			<div class="titleblock">
				<div>
					<div class="titleblock__head">
						<h1>Watchlist</h1>
						{isOwner && <button type="button" class="add-btn" data-open-watchlist>+ Add film</button>}
					</div>
					<div class="sub">
						<span class="sub__n" id="wl-count">{num(summary.total)}</span>{' '}
						<span id="wl-noun">{summary.total === 1 ? 'film' : 'films'}</span> to watch · showing{' '}
						<span class="sub__n" id="shown">{num(total)}</span>
					</div>
				</div>
				<ScreeningPreview entries={queued} />
			</div>

			<div class="filterbar">
				<input
					type="search"
					id="search"
					placeholder="Search watchlist…"
					autocomplete="off"
					aria-label="Search watchlist"
					value={query.q}
				/>
				<button
					type="button"
					id="filters-toggle"
					class={filterCount > 0 ? 'pill pill--btn pill--on' : 'pill pill--btn'}
					aria-expanded="false"
					aria-controls="filters"
				>
					Filters<span id="filters-count">{filterCount > 0 ? ` · ${filterCount}` : ''}</span>
				</button>
				<div class="sortby">
					<span class="sortby__label">Sort</span>
					{[
						['added', 'Recently added'],
						['year', 'Release date'],
						['shuffle', '⇄ Shuffle'],
					].map(([key, label]) => (
						<button type="button" class={query.sort === key ? 'pill pill--on' : 'pill'} data-sort={key}>
							{label}
						</button>
					))}
				</div>
			</div>

			<div class="panel" id="filters" hidden>
				<div class="panel__head">
					<span class="panel__title">Filter watchlist</span>
					<span class="panel__loading" id="facets-loading">Loading filters…</span>
					<button type="button" id="clear-all" class="clear" hidden>Clear all</button>
				</div>
				<p class="panel__error" id="facets-error" hidden>
					Could not load the filters. <button type="button" id="facets-retry">Retry</button>
				</p>

				<div class="panel__grid">
					<section>
						<h2 class="grp">Release date</h2>
						{hasReleaseRange ? (
							<div class="range range--dec" id="drange" data-lo={relLo} data-hi={relHi}>
								<div class="range__track"></div>
								<div class="range__fill" id="drange-fill"></div>
								<input
									type="range"
									id="dmin"
									min={relLo}
									max={relHi}
									step="1"
									value={dMin}
									aria-label="Earliest release year"
								/>
								<input
									type="range"
									id="dmax"
									min={relLo}
									max={relHi}
									step="1"
									value={dMax}
									aria-label="Latest release year"
								/>
								<div class="range__ends">
									<span id="dmin-label">{dMin}</span><span id="dmax-label">{dMax}</span>
								</div>
							</div>
						) : (
							<p class="grp__none">Not enough range to filter</p>
						)}
						{hasUpcoming && (
							<label class="toggle">
								<input type="checkbox" id="upcoming-toggle" checked={query.includeUpcoming !== false} />
								<span class="toggle__track"><span class="toggle__thumb"></span></span>
								<span class="toggle__text">Include upcoming</span>
							</label>
						)}
					</section>

					{/* Genre, Language and People are all built by applyFacets() from
					    /api/films/watchlist/facets. Only search, sort, the release-date
					    range and the upcoming toggle work before that lands — they read
					    facts the tiles already carry. */}
					<section data-group="genre">
						<div class="grp__row">
							<h2 class="grp">Genre</h2>
							<div class="modes" data-mode="genremode" hidden>
								<button type="button" class={query.genreMode === 'all' ? 'mode' : 'mode mode--on'} data-value="any">
									Any
								</button>
								<button type="button" class={query.genreMode === 'all' ? 'mode mode--on' : 'mode'} data-value="all">
									All
								</button>
							</div>
						</div>
						<p class="grp__none" data-none hidden>No genres yet</p>
						<div class="chips" data-chips="genre"></div>
					</section>

					<section data-group="language" hidden>
						<h2 class="grp">Language</h2>
						<div class="chips" data-chips="language"></div>
					</section>

					<section class="panel__wide" id="people-section" hidden>
						<div class="grp__row">
							<h2 class="grp">People</h2>
							<input
								type="search"
								id="people-search"
								class="people-search"
								placeholder="Search directors & cast…"
								autocomplete="off"
								aria-label="Search directors and cast"
							/>
						</div>
						<div class="where">
							<div class="where__row">
								<span class="where__label">Director</span>
								<div class="chips" data-people="director">
									<span class="people-none" hidden>No matches</span>
								</div>
							</div>
							<div class="where__row">
								<span class="where__label">Cast</span>
								<div class="chips" data-people="actor">
									<span class="people-none" hidden>No matches</span>
								</div>
							</div>
						</div>
					</section>
				</div>
			</div>

			{/* data-seed is the shuffle deal the first page was cut from, so the pages
			    after it continue the same order. data-today lets the script badge
			    tiles it builds by the same day the server badged these. */}
			<div class="grid" id="grid" data-seed={query.seed ?? ''} data-today={today} data-owner={isOwner ? '1' : ''}>
				{films.map((f) => {
					const poster = imageUrl(f.poster_path, 'w342');
					const upcoming = isUpcoming(f);
					return (
						<div class="item" data-tmdb-id={f.tmdb_id}>
							{isOwner && (
								<button type="button" class="remove" aria-label={`Remove ${f.title} from watchlist`}>
									✕
								</button>
							)}
							{/* Tiles lead to the film's own page — where the download link now
							    lives, alongside the synopsis, cast and the watchlist toggle. */}
							<a class={poster ? 'tile' : 'tile tile--noimg'} href={`/films/movie/${f.tmdb_id}`}>
								{poster && <img data-poster={poster} alt={`${f.title} poster`} decoding="async" />}
								{upcoming && <span class="badge">Upcoming</span>}
								<div class="tile__overlay">
									<div class="tile__title">{f.title}</div>
									<div class="tile__year">{f.release_year}</div>
									{/* Only upcoming films carry a date here: for one already out,
									    the year above is the whole story, and the day it opened
									    isn't what you're scanning the watchlist for. */}
									{upcoming && f.release_date && (
										<div class="tile__release">{releaseLabel(f.release_date)}</div>
									)}
									<div class="tile__added">Added {addedLabel(f.added_at)}</div>
								</div>
							</a>
						</div>
					);
				})}
			</div>

			<p class="empty" id="empty" hidden={total > 0}>
				<span id="empty-none" hidden={filtered}>Nothing on the watchlist yet.</span>
				<span id="empty-by-query" hidden={!filtered || !onlyQuery}>
					No films match “<span id="empty-q">{query.q}</span>”
				</span>
				<span id="empty-by-filters" hidden={!filtered || onlyQuery}>No films match these filters</span>
			</p>

			<div id="sentinel" data-batch={BATCH} hidden={!hasMore}>
				<span class="sentinel__spinner" aria-hidden="true"></span>
				<span class="sentinel__text">Loading more…</span>
			</div>
			<p id="load-error" class="load-error" hidden>
				Could not load more films. <button type="button" id="retry">Retry</button>
			</p>
		</div>
	</div>

	{isOwner && <WatchlistComposer />}

	<style>
		.page {
			overflow-x: hidden;
			display: flex;
			justify-content: center;
			padding: 0 24px 80px;
		}
		.wrap {
			width: 100%;
			max-width: 1000px;
		}
		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 26px 0 22px;
			border-bottom: 1px solid #4a2529;
			margin-bottom: 34px;
		}
		.back {
			display: flex;
			align-items: center;
			gap: 9px;
			font-size: 13px;
			color: #a2857a;
		}
		.back:hover {
			color: #f4e8d1;
		}
		.back__arrow {
			font-size: 15px;
		}
		.topbar__tag {
			font-size: 11.5px;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #8a6f63;
		}

		.titleblock {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			margin-bottom: 26px;
			flex-wrap: wrap;
			gap: 16px;
		}
		.titleblock__head {
			display: flex;
			align-items: center;
			gap: 18px;
		}
		h1 {
			font-family: var(--font-newsreader);
			font-weight: 500;
			font-size: 52px;
			color: #f4e8d1;
			letter-spacing: -0.5px;
			line-height: 1;
			margin: 0;
		}
		.add-btn {
			font-size: 13px;
			font-weight: 700;
			color: #2a1214;
			background: #d9b45a;
			border: none;
			border-radius: 8px;
			padding: 10px 18px;
			cursor: pointer;
			font-family: var(--font-archivo);
			white-space: nowrap;
		}
		.add-btn:hover {
			background: #f0d488;
		}
		.sub {
			font-size: 13px;
			color: #a2857a;
			margin-top: 10px;
		}
		.sub__n {
			color: #d9b45a;
			font-weight: 600;
		}

		.filterbar {
			display: flex;
			gap: 12px;
			align-items: center;
			margin-bottom: 14px;
			flex-wrap: wrap;
		}
		#search {
			flex: 1;
			min-width: 220px;
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 8px;
			padding: 11px 14px;
			color: #f4e8d1;
			font-size: 14px;
			font-family: var(--font-archivo);
			outline: none;
		}
		#search::placeholder {
			color: #8a6f63;
		}
		#search:focus {
			border-color: #d9b45a;
		}
		.sortby {
			display: flex;
			align-items: center;
			gap: 8px;
		}
		.sortby__label {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
		}
		.pill {
			font-size: 12.5px;
			padding: 7px 13px;
			border-radius: 20px;
			cursor: pointer;
			font-family: var(--font-archivo);
			border: 1px solid #4a2529;
			background: transparent;
			color: #ddc9b4;
		}
		.pill:hover {
			border-color: #a2857a;
		}
		.pill--on {
			background: #d9b45a;
			color: #2a1214;
			font-weight: 600;
			border-color: #d9b45a;
		}
		.pill--btn {
			padding: 10px 16px;
			border-radius: 8px;
		}

		/* --- Filter panel --- */
		.panel {
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 12px;
			padding: 24px 26px;
			margin-bottom: 26px;
		}
		.panel[hidden] {
			display: none;
		}
		.panel__head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 20px;
		}
		.panel__title {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.6px;
			color: #8a6f63;
		}
		/* Sits between the title and "Clear all" while the chips are on their way.
		   Quiet on purpose: search, sort, the release-date range and the upcoming
		   toggle all work without them, so this is a note, not a blocker. */
		.panel__loading {
			margin-right: auto;
			padding-left: 12px;
			font-size: 12px;
			color: #7c6156;
			font-style: italic;
		}
		.panel__loading[hidden] {
			display: none;
		}
		.panel__error {
			margin: -8px 0 16px;
			font-size: 13px;
			color: #a2857a;
		}
		.panel__error[hidden] {
			display: none;
		}
		.panel__error button {
			font: inherit;
			color: #d9b45a;
			background: none;
			border: none;
			padding: 0;
			cursor: pointer;
			text-decoration: underline;
		}
		.modes[hidden],
		section[hidden] {
			display: none;
		}
		.clear {
			font-size: 12px;
			font-weight: 600;
			color: #d9b45a;
			background: transparent;
			border: none;
			cursor: pointer;
			font-family: var(--font-archivo);
			padding: 0;
		}
		.clear:hover {
			color: #f0d488;
		}
		.clear[hidden] {
			display: none;
		}
		.panel__grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 26px 40px;
		}
		.panel__wide {
			grid-column: 1 / -1;
		}
		.grp {
			font-size: 11px;
			font-weight: 400;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
			margin: 0 0 12px;
		}
		.grp__none {
			font-size: 13px;
			font-style: italic;
			font-family: var(--font-newsreader);
			color: #8a6f63;
			margin: 0;
		}
		.grp__row {
			display: flex;
			align-items: center;
			gap: 12px;
			margin-bottom: 12px;
		}
		.grp__row .grp {
			margin-bottom: 0;
		}
		.chips {
			display: flex;
			gap: 8px;
			flex-wrap: wrap;
		}
		.chip {
			font-size: 12.5px;
			padding: 7px 13px;
			border-radius: 20px;
			cursor: pointer;
			font-family: var(--font-archivo);
			border: 1px solid #4a2529;
			background: transparent;
			color: #ddc9b4;
		}
		.chip:hover {
			border-color: #a2857a;
		}
		.chip[aria-pressed='true'] {
			background: #d9b45a;
			color: #2a1214;
			font-weight: 600;
			border-color: #d9b45a;
		}
		.chip[hidden] {
			display: none;
		}
		.chip--more {
			background: transparent;
			color: #a2857a;
			border-style: dashed;
		}

		/* Any/All mode toggle — mirrors the "All films" filter groups. */
		.modes {
			display: flex;
			border: 1px solid #4a2529;
			border-radius: 14px;
			overflow: hidden;
		}
		.mode {
			font-size: 11px;
			font-weight: 600;
			padding: 5px 11px;
			border: none;
			cursor: pointer;
			font-family: var(--font-archivo);
			background: transparent;
			color: #a2857a;
		}
		.mode--on {
			background: #d9b45a;
			color: #2a1214;
		}

		/* Labelled chip rows (People → Director / Cast). */
		.where {
			display: flex;
			flex-direction: column;
			gap: 10px;
		}
		.where__row {
			display: flex;
			align-items: baseline;
			gap: 8px;
		}
		.where__label {
			font-size: 12px;
			color: #8a6f63;
			width: 60px;
			flex: none;
		}

		/* People filter: a chip-scoped search that sits beside the "People" heading. */
		.people-search {
			width: 220px;
			max-width: 100%;
			background: #1c0d0e;
			border: 1px solid #4a2529;
			border-radius: 14px;
			padding: 5px 12px;
			color: #f4e8d1;
			font-size: 12px;
			font-family: var(--font-archivo);
			outline: none;
		}
		.people-search::placeholder {
			color: #8a6f63;
		}
		.people-search:focus {
			border-color: #d9b45a;
		}
		.people-none {
			font-size: 12px;
			font-style: italic;
			font-family: var(--font-newsreader);
			color: #8a6f63;
		}
		.people-none[hidden] {
			display: none;
		}

		/* Dual-thumb release-date range: two native sliders stacked on one track, so
		   keyboard and screen-reader support come for free. The inputs ignore pointer
		   events except on their thumbs, which lets whichever thumb is under the
		   cursor take the drag even though the boxes fully overlap. Mirrors the
		   "All films" grid's sliders. */
		.range {
			max-width: 260px;
			position: relative;
			height: 32px;
		}
		.range__track,
		.range__fill {
			position: absolute;
			top: 14px;
			height: 4px;
			border-radius: 2px;
			pointer-events: none;
		}
		.range__track {
			left: 0;
			right: 0;
			background: #402226;
		}
		.range__fill {
			background: #d9b45a;
		}
		.range input[type='range'] {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 32px;
			margin: 0;
			background: none;
			appearance: none;
			-webkit-appearance: none;
			pointer-events: none;
		}
		.range input[type='range']:focus-visible {
			outline: none;
		}
		.range input[type='range']::-webkit-slider-thumb {
			appearance: none;
			-webkit-appearance: none;
			pointer-events: auto;
			width: 16px;
			height: 16px;
			border-radius: 50%;
			background: #f0d488;
			border: 2px solid #241012;
			box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
			cursor: pointer;
		}
		.range input[type='range']::-moz-range-thumb {
			pointer-events: auto;
			width: 16px;
			height: 16px;
			border-radius: 50%;
			background: #f0d488;
			border: 2px solid #241012;
			box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
			cursor: pointer;
		}
		.range input[type='range']:focus-visible::-webkit-slider-thumb {
			outline: 2px solid #f0d488;
			outline-offset: 2px;
		}
		.range input[type='range']:focus-visible::-moz-range-thumb {
			outline: 2px solid #f0d488;
			outline-offset: 2px;
		}
		.range__ends {
			position: absolute;
			top: 30px;
			left: 0;
			right: 0;
			display: flex;
			justify-content: space-between;
			font-size: 13px;
			color: #d9b45a;
			pointer-events: none;
		}
		/* The end labels are positioned out of flow, so reserve the room they occupy. */
		.range--dec {
			margin-bottom: 20px;
		}

		/* "Include upcoming" switch. A native checkbox drives it — the track and thumb
		   are drawn from its :checked state, so keyboard and screen-reader support come
		   for free. */
		.toggle {
			display: inline-flex;
			align-items: center;
			gap: 10px;
			cursor: pointer;
			user-select: none;
		}
		.toggle input {
			position: absolute;
			width: 1px;
			height: 1px;
			opacity: 0;
			pointer-events: none;
		}
		.toggle__track {
			position: relative;
			flex-shrink: 0;
			width: 34px;
			height: 18px;
			border-radius: 9px;
			background: #402226;
			border: 1px solid #4a2529;
		}
		.toggle__thumb {
			position: absolute;
			top: 2px;
			left: 2px;
			width: 12px;
			height: 12px;
			border-radius: 50%;
			background: #8a6f63;
		}
		.toggle input:checked + .toggle__track {
			background: #d9b45a;
			border-color: #d9b45a;
		}
		.toggle input:checked + .toggle__track .toggle__thumb {
			transform: translateX(16px);
			background: #2a1214;
		}
		.toggle input:focus-visible + .toggle__track {
			outline: 2px solid #f0d488;
			outline-offset: 2px;
		}
		.toggle__text {
			font-size: 13px;
			color: #ddc9b4;
		}

		.grid {
			display: grid;
			grid-template-columns: repeat(6, 1fr);
			gap: 18px;
			margin-top: 16px;
		}
		.item {
			position: relative;
		}
		.item[hidden] {
			display: none;
		}
		.remove {
			position: absolute;
			top: 7px;
			right: 7px;
			z-index: 2;
			width: 26px;
			height: 26px;
			border-radius: 50%;
			background: rgba(20, 8, 9, 0.82);
			border: 1px solid #4a2529;
			color: #f2e5cd;
			font-size: 12px;
			line-height: 1;
			cursor: pointer;
			opacity: 0;
			display: flex;
			align-items: center;
			justify-content: center;
		}
		.item:hover .remove,
		.remove:focus-visible {
			opacity: 1;
		}
		.remove:hover {
			background: #d9b45a;
			color: #2a1214;
			border-color: #d9b45a;
		}
		.remove:disabled {
			cursor: default;
			opacity: 0.5;
		}
		.tile {
			position: relative;
			display: block;
			color: inherit;
			aspect-ratio: 2 / 3;
			border-radius: 5px;
			overflow: hidden;
			background-image: repeating-linear-gradient(135deg, #351a1d 0 9px, #2c1518 9px 18px);
			border: 1px solid #4a2529;
		}
		.item:hover .tile {
			border-color: #d9b45a;
		}
		.tile img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.badge {
			position: absolute;
			top: 8px;
			left: 8px;
			z-index: 1;
			font-size: 9.5px;
			font-weight: 700;
			letter-spacing: 1px;
			text-transform: uppercase;
			color: #2a1214;
			background: #d9b45a;
			border-radius: 3px;
			padding: 3px 6px;
		}
		.tile__overlay {
			position: absolute;
			inset: 0;
			display: flex;
			flex-direction: column;
			justify-content: flex-end;
			padding: 12px;
			background: rgba(18, 8, 9, 0.82);
			opacity: 0;
		}
		.item:hover .tile__overlay {
			opacity: 1;
		}
		/* Films with no poster: keep the caption visible over the striped tile. */
		.tile--noimg .tile__overlay {
			opacity: 1;
			background: transparent;
		}
		.tile__title {
			font-family: var(--font-newsreader);
			font-size: 16px;
			font-weight: 500;
			color: #f4e8d1;
			line-height: 1.15;
		}
		.tile__year {
			font-family: var(--font-archivo);
			font-size: 11px;
			letter-spacing: 1.4px;
			text-transform: uppercase;
			color: #d9b45a;
			margin-top: 5px;
		}
		.tile__release {
			font-size: 12px;
			color: #a2857a;
			margin-top: 4px;
		}
		.tile__added {
			font-size: 11px;
			color: #8a6f63;
			margin-top: 3px;
		}

		.empty {
			padding: 48px 0;
			text-align: center;
			color: #8a6f63;
			font-size: 15px;
			font-style: italic;
			font-family: var(--font-newsreader);
		}
		.empty[hidden],
		.empty span[hidden] {
			display: none;
		}

		#sentinel {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 10px;
			padding: 28px 0 8px;
			font-size: 12px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
		}
		#sentinel[hidden] {
			display: none;
		}
		/* The site's one sanctioned animation: a spinner on a pending request. */
		.sentinel__spinner {
			width: 12px;
			height: 12px;
			border: 2px solid #4a2529;
			border-top-color: #d9b45a;
			border-radius: 50%;
			animation: spin 0.7s linear infinite;
		}
		@keyframes spin {
			to {
				transform: rotate(360deg);
			}
		}
		.load-error {
			padding: 24px 0;
			text-align: center;
			font-size: 13px;
			color: #a2857a;
		}
		.load-error[hidden] {
			display: none;
		}
		.load-error button {
			font: inherit;
			color: #d9b45a;
			background: none;
			border: none;
			padding: 0;
			cursor: pointer;
			text-decoration: underline;
		}

		@media (max-width: 860px) {
			.grid {
				grid-template-columns: repeat(4, 1fr);
			}
			.panel__grid {
				grid-template-columns: minmax(0, 1fr);
			}
		}
		@media (max-width: 560px) {
			h1 {
				font-size: 40px;
			}
			.grid {
				grid-template-columns: repeat(3, 1fr);
			}
			.panel {
				padding: 20px 16px;
			}
			.range {
				max-width: none;
			}
			.where__row {
				flex-direction: column;
				align-items: stretch;
			}
		}
	</style>

	<script>
		import { formatWatchedDate } from '../../lib/format';

		interface WatchlistFilm {
			tmdb_id: number;
			title: string;
			release_year: number | null;
			release_date: string | null;
			premiere_date: string | null;
			poster_path: string | null;
			added_at: string;
		}

		// --- Browse: search, sort, filter and paging ---------------------------
		// Paged like the "All films" grid. The server renders the first page with
		// the URL's filters applied; the rest arrive from /api/films/watchlist/list
		// as you scroll. Search, sort and the filters all re-query rather than
		// hiding tiles: the grid only holds the pages loaded so far, so filtering
		// here would search a slice instead of the whole list.
		const grid = document.getElementById('grid');

		const sentinel = document.getElementById('sentinel');

		if (grid && sentinel) {
			const search = document.getElementById('search') as HTMLInputElement;
			const shown = document.getElementById('shown')!;
			const countEl = document.getElementById('wl-count')!;
			const nounEl = document.getElementById('wl-noun')!;
			const empty = document.getElementById('empty')!;
			const emptyNone = document.getElementById('empty-none')!;
			const emptyQ = document.getElementById('empty-q')!;
			const emptyByQuery = document.getElementById('empty-by-query')!;
			const emptyByFilters = document.getElementById('empty-by-filters')!;
			const errorBox = document.getElementById('load-error')!;
			const retry = document.getElementById('retry')!;
			const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.pill[data-sort]'));
			const panel = document.getElementById('filters')!;
			const toggle = document.getElementById('filters-toggle')!;
			const countBadge = document.getElementById('filters-count')!;
			const clearAll = document.getElementById('clear-all') as HTMLButtonElement;
			// Every chip — genre, language, director, cast — is built from the facet
			// payload, so this starts empty and is refilled by applyFacets.
			let filterChips: HTMLButtonElement[] = [];
			const peopleSearch = document.getElementById('people-search') as HTMLInputElement | null;
			const drange = document.getElementById('drange');
			const dminInput = document.getElementById('dmin') as HTMLInputElement | null;
			const dmaxInput = document.getElementById('dmax') as HTMLInputElement | null;
			const drangeFill = document.getElementById('drange-fill');
			const dminLabel = document.getElementById('dmin-label');
			const dmaxLabel = document.getElementById('dmax-label');
			const upcomingToggle = document.getElementById('upcoming-toggle') as HTMLInputElement | null;
			const BATCH = Number(sentinel.dataset.batch);
			const TODAY = grid.dataset.today ?? '';
			const isOwner = grid.dataset.owner === '1';

			const fmt = (n: number) => n.toLocaleString('en-US');

			// --- Filter state ---
			// Seeded from what the server rendered, which it read off the URL through
			// the same parser the paging API uses.
			const initial = new URLSearchParams(location.search);
			let sort = pills.find((p) => p.classList.contains('pill--on'))?.dataset.sort ?? 'added';
			let q = search.value.trim();
			// Shuffle's deal. The server picks the first one; each press of Shuffle
			// re-rolls it, and every page of one shuffle sends the same seed.
			let shuffleSeed = Number(grid.dataset.seed) || 1;

			// One set per chip group; the keys double as the API's and the URL's
			// param names.
			const sets = {
				genre: new Set(initial.getAll('genre')),
				language: new Set(initial.getAll('language')),
				director: new Set(initial.getAll('director')),
				actor: new Set(initial.getAll('actor')),
			};

			type SetKey = keyof typeof sets;

			// Genre is the one group with an any/all toggle, mirroring "All films".
			let genreMode: 'any' | 'all' = initial.get('genremode') === 'all' ? 'all' : 'any';

			const REL_LO = drange ? Number(drange.dataset.lo) : 0;
			const REL_HI = drange ? Number(drange.dataset.hi) : 0;
			let dMin = dminInput ? Number(dminInput.value) : REL_LO;
			let dMax = dmaxInput ? Number(dmaxInput.value) : REL_HI;
			// The "Include upcoming" toggle. When off, films with a future release
			// date drop out whatever the year range says.
			let includeUpcoming = upcomingToggle ? upcomingToggle.checked : true;

			// Paging. The server hides the sentinel when the first page is already
			// everything.
			let offset = grid.childElementCount;
			let shownTotal = Number((shown.textContent ?? '').replace(/[^0-9]/g, '')) || 0;
			let collectionTotal = Number((countEl.textContent ?? '').replace(/[^0-9]/g, '')) || 0;
			let loading = false;
			let done = sentinel.hidden;
			// Identifies the newest request; a response from an older one is
			// discarded so fast typing can't let a stale batch land after the one it
			// superseded.
			let seq = 0;
			// Whether the failed request was a reset, so Retry repeats it in the same
			// mode rather than appending a fresh query's page onto the previous grid.
			let retryReset = false;

			/** Whether the release-date range narrows anything. */
			const releaseActive = () => Boolean(drange) && (dMin > REL_LO || dMax < REL_HI);

			/** Number of active filters — the count on the Filters button. The
			 * release-date range counts once however many years it spans. */
			const activeCount = () =>
				(releaseActive() ? 1 : 0) +
				sets.genre.size +
				sets.language.size +
				sets.director.size +
				sets.actor.size +
				(includeUpcoming ? 0 : 1);

			/** The filter params, shared by the API request and the address bar. */
			function filterParams(): URLSearchParams {
				const p = new URLSearchParams();

				if (q) p.set('q', q);

				if (sort !== 'added') p.set('sort', sort);

				if (releaseActive()) {
					p.set('dmin', String(dMin));
					p.set('dmax', String(dMax));
				}

				for (const [key, values] of Object.entries(sets)) {
					for (const v of values) p.append(key, v);
				}

				if (sets.genre.size && genreMode === 'all') p.set('genremode', 'all');

				if (!includeUpcoming) p.set('upcoming', '0');

				return p;
			}

			function buildQuery(from: number): string {
				const p = filterParams();
				p.set('limit', String(BATCH));
				p.set('offset', String(from));

				if (sort === 'shuffle') p.set('seed', String(shuffleSeed));

				return p.toString();
			}

			// --- URL state ------------------------------------------------------
			// The filters live in the query string so a narrowed grid is linkable and
			// survives a reload. Always replaceState, never pushState: a chip press is
			// not a navigation. The shuffle seed and the paging offset stay out, so a
			// shared link opens at the top of a fresh deal.
			function writeUrl() {
				const qs = filterParams().toString();
				const url = location.pathname + (qs ? `?${qs}` : '');

				if (url !== location.pathname + location.search) history.replaceState(null, '', url);
			}

			// Astro scopes this page's CSS behind a generated data-astro-cid-* attribute,
			// so every node built here has to carry it or it renders unstyled. Read the
			// name off a server-rendered element rather than hard-coding the hash, which
			// changes whenever this file does.
			const scopeAttr = Array.from(panel.attributes)
				.map((a) => a.name)
				.find((n) => n.startsWith('data-astro-cid-'));

			function el(tag: string, className?: string, text?: string): HTMLElement {
				const node = document.createElement(tag);

				if (scopeAttr) node.setAttribute(scopeAttr, '');

				if (className) node.className = className;

				if (text != null) node.textContent = text;

				return node;
			}

			/** "Added Jul 9" — the short date on a tile's hover overlay. */
			const addedLabel = (iso: string) =>
				new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

			// Mirrors the server-rendered tile markup above.
			function buildTile(f: WatchlistFilm): HTMLElement {
				const item = el('div', 'item');
				item.dataset.tmdbId = String(f.tmdb_id);

				if (isOwner) {
					const remove = el('button', 'remove', '✕') as HTMLButtonElement;
					remove.type = 'button';
					remove.setAttribute('aria-label', `Remove ${f.title} from watchlist`);
					item.append(remove);
				}

				const upcoming = f.release_date != null && f.release_date > TODAY;
				const tile = el('a', f.poster_path ? 'tile' : 'tile tile--noimg') as HTMLAnchorElement;
				tile.href = `/films/movie/${f.tmdb_id}`;

				if (f.poster_path) {
					const img = el('img') as HTMLImageElement;
					// Deferred like the server-rendered tiles: the URL sits in data-poster
					// until PosterLoader's observer reaches this tile.
					img.dataset.poster = `https://image.tmdb.org/t/p/w342${f.poster_path}`;
					img.alt = `${f.title} poster`;
					img.decoding = 'async';
					tile.append(img);
				}

				if (upcoming) tile.append(el('span', 'badge', 'Upcoming'));
				const overlay = el('div', 'tile__overlay');
				overlay.append(
					el('div', 'tile__title', f.title),
					el('div', 'tile__year', f.release_year == null ? '' : String(f.release_year)),
				);

				if (upcoming && f.release_date) {
					overlay.append(el('div', 'tile__release', `Out ${formatWatchedDate(f.release_date)}`));
				}

				overlay.append(el('div', 'tile__added', `Added ${addedLabel(f.added_at)}`));
				tile.append(overlay);
				item.append(tile);

				return item;
			}

			/** Counts and the empty-state line, from the latest server totals. */
			function renderCounts() {
				shown.textContent = fmt(shownTotal);
				countEl.textContent = fmt(collectionTotal);
				nounEl.textContent = collectionTotal === 1 ? 'film' : 'films';
				const filtered = q !== '' || activeCount() > 0;
				// Quote the search term when it's the only thing narrowing; once a
				// filter is on too, the term alone no longer explains the emptiness.
				const onlyQuery = q !== '' && activeCount() === 0;
				emptyQ.textContent = q;
				emptyNone.hidden = filtered;
				emptyByQuery.hidden = !filtered || !onlyQuery;
				emptyByFilters.hidden = !filtered || onlyQuery;
				empty.hidden = shownTotal > 0;
			}

			// The observer only fires on a crossing, so re-arm it after every load: a
			// batch too short to push the sentinel out of view still loads the next.
			function armSentinel() {
				observer.unobserve(sentinel!);
				sentinel!.hidden = done;

				if (!done) observer.observe(sentinel!);
			}

			/** `reset` restarts from offset 0 for a new query/sort, replacing the grid. */
			async function load(reset = false) {
				if (!reset && (loading || done)) return;

				// Every re-query is a filter change; paging isn't.
				if (reset) writeUrl();
				const mySeq = ++seq;
				loading = true;
				errorBox.hidden = true;
				const from = reset ? 0 : offset;

				try {
					const res = await fetch(`/api/films/watchlist/list?${buildQuery(from)}`);

					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					const { films, total } = (await res.json()) as { films: WatchlistFilm[]; total: number };

					if (mySeq !== seq) return; // superseded by a newer query

					if (reset) {
						grid!.replaceChildren();
						offset = 0;
					}

					const batch = document.createDocumentFragment();

					for (const f of films) batch.append(buildTile(f));
					grid!.append(batch);
					// The tiles ship their posters in data-poster like the server-rendered
					// ones, so hand them to the loader; it skips anything already in flight.
					window.observePosters?.(grid!);
					offset += films.length;
					shownTotal = total;
					renderCounts();
					done = offset >= total || films.length < BATCH;
					armSentinel();
				} catch (e) {
					if (mySeq !== seq) return;
					// Leave the observer parked so a failure can't hot-loop the API; the
					// retry button is the way back.
					console.error('watchlist: failed to load films', e);
					retryReset = reset;
					errorBox.hidden = false;
				} finally {
					if (mySeq === seq) loading = false;
				}
			}

			// Start fetching a screenful early so scrolling stays continuous.
			const observer = new IntersectionObserver(
				(entries) => {
					if (entries.some((entry) => entry.isIntersecting)) load();
				},
				{ rootMargin: '600px' },
			);

			armSentinel();
			retry.addEventListener('click', () => load(retryReset));

			/** Reflect state that isn't owned by the control the user just touched. */
			function syncChrome() {
				const n = activeCount();
				countBadge.textContent = n ? ` · ${n}` : '';
				toggle.classList.toggle('pill--on', panel.hidden === false || n > 0);
				clearAll.hidden = n === 0;

				if (upcomingToggle) upcomingToggle.checked = includeUpcoming;

				if (drange && drangeFill && dminLabel && dmaxLabel) {
					const pct = (v: number) => ((v - REL_LO) / (REL_HI - REL_LO)) * 100;
					drangeFill.style.left = `${pct(dMin)}%`;
					drangeFill.style.width = `${pct(dMax) - pct(dMin)}%`;
					dminLabel.textContent = String(dMin);
					dmaxLabel.textContent = String(dMax);
					// The two inputs cover the same box, so where the thumbs overlap the
					// later one in the DOM (max) swallows the drag. Raise min once it's
					// past the midpoint, which is the only place the two can meet.
					const overlapping = dMin > (REL_LO + REL_HI) / 2;
					dminInput!.style.zIndex = overlapping ? '2' : '1';
					dmaxInput!.style.zIndex = overlapping ? '1' : '2';
				}
			}

			function applyFilters() {
				syncChrome();
				load(true);
			}

			toggle.addEventListener('click', () => {
				panel.hidden = !panel.hidden;
				toggle.setAttribute('aria-expanded', String(!panel.hidden));
				syncChrome();
			});

			let debounce = 0;
			search.addEventListener('input', () => {
				window.clearTimeout(debounce);
				debounce = window.setTimeout(() => {
					const next = search.value.trim();

					if (next === q) return;
					q = next;
					load(true);
				}, 250);
			});

			for (const pill of pills) {
				pill.addEventListener('click', () => {
					// Shuffle is the one sort that does something when it's already on:
					// pressing it again deals a new order.
					if (pill.dataset.sort === sort && sort !== 'shuffle') return;
					sort = pill.dataset.sort!;

					if (sort === 'shuffle') shuffleSeed = 1 + Math.floor(Math.random() * 99998);

					for (const p of pills) p.classList.toggle('pill--on', p === pill);
					load(true);
				});
			}

			// Genre any/all toggle. A mode flip only changes results once genres are
			// picked; only genre carries a toggle, but the wiring stays general.
			for (const group of Array.from(panel.querySelectorAll<HTMLElement>('.modes'))) {
				const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('.mode'));

				for (const button of buttons) {
					button.addEventListener('click', () => {
						const value = button.dataset.value as 'any' | 'all';

						if (genreMode === value) return;
						genreMode = value;

						for (const b of buttons) b.classList.toggle('mode--on', b === button);

						if (sets.genre.size) applyFilters();
					});
				}
			}

			// --- People (director / cast) ---------------------------------------
			// Mirrors the "All films" People filter: each row shows the top few names
			// by frequency and the search box reveals matches on demand. Picks live in
			// sets.director / sets.actor, read the same as any other chip group.
			type PeopleKind = 'director' | 'actor';

			const PEOPLE_TOP_JS = 12; // quick chips per row before searching
			const PEOPLE_MAX = 40; // most chips one search reveals
			const peopleSection = document.getElementById('people-section')!;
			const peopleNames: Record<PeopleKind, string[]> = { director: [], actor: [] };

			interface PeopleRow {
				kind: PeopleKind;
				host: HTMLElement;
				none: HTMLElement;
			}

			const peopleRows: PeopleRow[] = Array.from(
				panel.querySelectorAll<HTMLElement>('.chips[data-people]'),
			).map((host) => ({
				kind: host.dataset.people as PeopleKind,
				host,
				none: host.querySelector<HTMLElement>('.people-none')!,
			}));

			let peopleQ = '';

			/** A `.chip` button carrying the page's style scope. */
			function newChip(className = 'chip'): HTMLButtonElement {
				const chip = el('button', className) as HTMLButtonElement;
				chip.type = 'button';

				return chip;
			}

			function makePeopleChip(kind: PeopleKind, name: string): HTMLButtonElement {
				const chip = newChip();
				chip.dataset.filter = kind;
				chip.dataset.value = name;
				chip.setAttribute('aria-pressed', String(sets[kind].has(name)));
				chip.textContent = name;
				chip.addEventListener('click', () => {
					if (sets[kind].has(name)) sets[kind].delete(name);
					else sets[kind].add(name);
					chip.setAttribute('aria-pressed', String(sets[kind].has(name)));
					applyFilters();
				});

				return chip;
			}

			function renderPeopleRow(row: PeopleRow) {
				const selected = sets[row.kind];
				let names: string[];

				if (peopleQ) {
					names = peopleNames[row.kind]
						.filter((n) => n.toLowerCase().includes(peopleQ))
						.slice(0, PEOPLE_MAX);

					// Keep picked names on screen even when they don't match the search.
					for (const s of selected) if (!names.includes(s)) names.unshift(s);
				} else {
					names = peopleNames[row.kind].slice(0, PEOPLE_TOP_JS);

					for (const s of selected) if (!names.includes(s)) names.push(s);
				}

				const chips = names.map((n) => makePeopleChip(row.kind, n));
				row.host.replaceChildren(...chips, row.none);
				row.none.hidden = !(peopleQ !== '' && chips.length === 0);
			}

			function renderPeople() {
				for (const row of peopleRows) renderPeopleRow(row);
			}

			peopleSearch?.addEventListener('input', () => {
				peopleQ = peopleSearch.value.trim().toLowerCase();
				renderPeople();
			});

			// --- Genre / Language chip groups -----------------------------------
			// Both are built from the facet payload. Values past the group's limit ship
			// hidden behind "+N other…" — except any already picked, which stay visible
			// so a filter restored from the URL always has a control that can clear it.

			/** How many chips a group shows before collapsing behind "+N other…". */
			const CHIP_LIMIT: Record<'genre' | 'language', number> = { genre: 8, language: 8 };

			function makeFilterChip(key: SetKey, value: string): HTMLButtonElement {
				const chip = newChip();
				chip.dataset.filter = key;
				chip.dataset.value = value;
				chip.textContent = value;
				chip.setAttribute('aria-pressed', String(sets[key].has(value)));
				chip.addEventListener('click', () => {
					const on = !sets[key].has(value);

					if (on) sets[key].add(value);
					else sets[key].delete(value);
					chip.setAttribute('aria-pressed', String(on));
					applyFilters();
				});

				return chip;
			}

			/** "+N other…" reveals the rest of its group and then removes itself:
			 * collapsing again would have to hide chips the user may have just picked. */
			function makeMoreChip(count: number): HTMLButtonElement {
				const more = newChip('chip chip--more');
				more.textContent = `+${count} other…`;
				more.addEventListener('click', () => {
					for (const sibling of Array.from(more.parentElement!.children)) {
						(sibling as HTMLElement).hidden = false;
					}

					more.remove();
				});

				return more;
			}

			function renderChipGroup(key: 'genre' | 'language', values: string[]) {
				const host = panel.querySelector<HTMLElement>(`.chips[data-chips="${key}"]`);

				if (!host) return;
				const section = host.closest<HTMLElement>(`section[data-group="${key}"]`);
				const none = section?.querySelector<HTMLElement>('[data-none]') ?? null;

				// Genre keeps its section and says "No genres yet"; language just hides.
				if (none) none.hidden = values.length > 0;
				else if (section) section.hidden = values.length === 0;

				const chips = values.map((v, i) => {
					const chip = makeFilterChip(key, v);
					chip.hidden = i >= CHIP_LIMIT[key] && !sets[key].has(v);

					return chip;
				});

				const hiddenCount = chips.filter((c) => c.hidden).length;

				if (hiddenCount > 0) chips.push(makeMoreChip(hiddenCount));
				host.replaceChildren(...chips);
			}

			/** Move both release-year thumbs, keeping min ≤ max and the inputs in step. */
			function setReleaseRange(min: number, max: number) {
				dMin = Math.min(min, max);
				dMax = Math.max(min, max);
				dminInput!.value = String(dMin);
				dmaxInput!.value = String(dMax);
			}

			if (dminInput && dmaxInput) {
				for (const input of [dminInput, dmaxInput]) {
					input.addEventListener('input', () => {
						// The thumbs share a track, so each one pushes rather than crosses.
						const min = Number(dminInput.value);
						const max = Number(dmaxInput.value);

						if (input === dminInput) setReleaseRange(Math.min(min, max), max);
						else setReleaseRange(min, Math.max(min, max));
						syncChrome();
					});
					// Re-query on release rather than per year: a drag across the track
					// would otherwise fire a request for every step.
					input.addEventListener('change', applyFilters);
				}
			}

			if (upcomingToggle) {
				upcomingToggle.addEventListener('change', () => {
					includeUpcoming = upcomingToggle.checked;
					applyFilters();
				});
			}

			clearAll.addEventListener('click', () => {
				for (const s of Object.values(sets)) s.clear();

				for (const chip of filterChips) chip.setAttribute('aria-pressed', 'false');
				genreMode = 'any';

				for (const b of Array.from(panel.querySelectorAll<HTMLButtonElement>('.mode'))) {
					b.classList.toggle('mode--on', b.dataset.value === 'any');
				}

				if (dminInput && dmaxInput) setReleaseRange(REL_LO, REL_HI);
				includeUpcoming = true;
				// Deselecting the People chips lets their rows collapse back to the top few.
				renderPeople();
				applyFilters();
			});

			// --- Filters, loaded after the grid ---------------------------------
			// Genre, language and the credits are per-film arrays: the chips are
			// derived from them, for a panel that starts collapsed. The grid itself is
			// already filtered server-side, so these only build the controls.
			interface FacetRow {
				tmdb_id: number;
				genres: string[];
				directors: string[];
				actors: string[];
				language: string | null;
			}

			const facetsLoading = document.getElementById('facets-loading')!;
			const facetsError = document.getElementById('facets-error')!;
			const facetsRetry = document.getElementById('facets-retry')!;
			const genreModes = panel.querySelector<HTMLElement>('.modes[data-mode="genremode"]')!;
			let facetsState: 'idle' | 'loading' | 'done' = 'idle';

			/** Values present on the watchlist, most common first, ties alphabetical —
			 * the chip order the "All films" filters use. */
			function byFrequency(pick: (r: FacetRow) => Iterable<string>, rows: FacetRow[]): string[] {
				const counts = new Map<string, number>();

				for (const r of rows) {
					for (const v of pick(r)) if (v) counts.set(v, (counts.get(v) ?? 0) + 1);
				}

				return [...counts.keys()].sort(
					(a, b) => counts.get(b)! - counts.get(a)! || a.localeCompare(b),
				);
			}

			function applyFacets(rows: FacetRow[]) {
				const genres = byFrequency((r) => r.genres, rows);
				const languages = byFrequency((r) => (r.language ? [r.language] : []), rows);
				peopleNames.director = byFrequency((r) => r.directors, rows);
				peopleNames.actor = byFrequency((r) => r.actors, rows);

				// A value that isn't on offer can't be cleared, and shouldn't silently
				// keep narrowing the grid — so drop it. Only reachable from a stale or
				// hand-typed link.
				const offered: Record<SetKey, Set<string>> = {
					genre: new Set(genres),
					language: new Set(languages),
					director: new Set(peopleNames.director),
					actor: new Set(peopleNames.actor),
				};

				let dropped = false;

				for (const key of Object.keys(sets) as SetKey[]) {
					for (const v of sets[key]) {
						if (!offered[key].has(v)) {
							sets[key].delete(v);
							dropped = true;
						}
					}
				}

				renderChipGroup('genre', genres);
				renderChipGroup('language', languages);
				genreModes.hidden = genres.length === 0;
				peopleSection.hidden =
					peopleNames.director.length === 0 && peopleNames.actor.length === 0;
				renderPeople();
				filterChips = Array.from(panel.querySelectorAll<HTMLButtonElement>('.chip[data-filter]'));

				facetsLoading.hidden = true;
				facetsState = 'done';

				// The server filtered by the stale value too, so re-query without it
				// (which also rewrites the URL).
				if (dropped) applyFilters();
				else syncChrome();
			}

			async function loadFacets() {
				if (facetsState !== 'idle') return;
				facetsState = 'loading';
				facetsError.hidden = true;
				facetsLoading.hidden = false;

				try {
					const res = await fetch('/api/films/watchlist/facets');

					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					applyFacets((await res.json()) as FacetRow[]);
				} catch (e) {
					console.error('watchlist: failed to load filter facets', e);
					facetsState = 'idle'; // let Retry (or opening the panel again) try once more
					facetsLoading.hidden = true;
					facetsError.hidden = false;
				}
			}

			facetsRetry.addEventListener('click', loadFacets);
			syncChrome();

			// Fetch the filters once the page has settled — or straight away if the panel
			// is opened first, so it's never waiting on the load event to start.
			toggle.addEventListener('click', loadFacets);

			if (document.readyState === 'complete') loadFacets();
			else window.addEventListener('load', loadFacets, { once: true });

			// --- Remove a film from the watchlist (owner only) ---
			grid.addEventListener('click', async (e) => {
				const btn = (e.target as HTMLElement).closest('.remove') as HTMLButtonElement | null;

				if (!btn) return;
				const item = btn.closest('.item') as HTMLElement;
				const tmdbId = item.dataset.tmdbId;

				if (!tmdbId) return;
				btn.disabled = true;

				try {
					const res = await fetch(`/api/films/watchlist?tmdbId=${tmdbId}`, { method: 'DELETE' });

					if (res.status === 401) {
						window.location.href = '/films/login?redirect=/films/watchlist';

						return;
					}

					if (!res.ok) throw new Error();
					item.remove();
					// The film is gone from the server's list too, so the next page starts
					// one earlier — otherwise it would skip the film that slides up.
					offset = Math.max(0, offset - 1);
					shownTotal = Math.max(0, shownTotal - 1);
					collectionTotal = Math.max(0, collectionTotal - 1);
					renderCounts();
				} catch {
					btn.disabled = false;
				}
			});
		}
	</script>
</FilmLayout>
