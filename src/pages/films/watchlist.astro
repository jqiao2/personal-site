---
import FilmLayout from '../../layouts/FilmLayout.astro';
import { listAllWatchlist } from '../../lib/films';
import { requireOwner } from '../../lib/auth';
import { imageUrl } from '../../lib/tmdb';

// Rendered on demand — reflects the live database.
export const prerender = false;

/** How many genre chips show before collapsing behind "+N other…". TMDB has 19
 * movie genres and the watchlist spans nearly all of them, which is more than the
 * panel's column can hold. */
const GENRE_CHIP_LIMIT = 8;

const [films, isOwner] = await Promise.all([listAllWatchlist(), requireOwner(Astro.cookies)]);

// The whole watchlist ships to the browser, which does the filtering and sorting
// from data attributes on the tiles. Unlike the "All films" grid — which pages
// through ~1.5k watched films and so has to re-query the server — a few hundred
// entries all fit in the DOM, and searching a slice would be a bug.

/** "YYYY-MM-DD" (or ISO timestamp) → "Jul 8", or "Aug 30, 2025" when it's not the current year. */
const currentYear = new Date().getFullYear();
function shortDate(date: string | null): string {
	if (!date) return '';
	const [y, m, d] = date.slice(0, 10).split('-').map(Number);
	if (!y || !m || !d) return '';
	const opts: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric' };
	if (y !== currentYear) opts.year = 'numeric';
	return new Date(y, m - 1, d).toLocaleDateString('en-US', opts);
}

const num = (n: number) => n.toLocaleString('en-US');

/** YTS search URL for a film, e.g. "bridge of spies 2015" → …/browse-movies/bridge%20of%20spies%202015/all/all/0/latest/0/all */
function ytsUrl(title: string, year: number | null): string {
	const query = year ? `${title} ${year}` : title;
	return `https://yts.gg/browse-movies/${encodeURIComponent(query.toLowerCase())}/all/all/0/latest/0/all`;
}

// A film is upcoming when its release date is still ahead of us. This needs the
// full date, not release_year: for most of a year, "released in 2026" and "out in
// 2026" are different claims. Films TMDB has no date for (announced, no schedule
// yet) aren't badged — unknown isn't the same as future.
const today = new Date().toISOString().slice(0, 10);
const isUpcoming = (f: (typeof films)[number]) => f.release_date != null && f.release_date > today;

/** Genres present on the watchlist, most common first — matches the chip order the
 * "All films" filters use. */
const genreCounts = new Map<string, number>();
for (const f of films) {
	for (const g of f.genres) genreCounts.set(g, (genreCounts.get(g) ?? 0) + 1);
}
const genres = [...genreCounts.keys()].sort((a, b) => genreCounts.get(b)! - genreCounts.get(a)!);

// End stops for the release-date slider, as a decade's first year. It needs two
// distinct decades to be worth drawing. Films with no release_year at all sit
// outside every decade and drop out once the slider is narrowed.
const decades = [...new Set(films.map((f) => f.release_year).filter((y): y is number => y != null))]
	.map((y) => Math.floor(y / 10) * 10)
	.sort((a, b) => a - b);
const decLo = decades[0] ?? null;
const decHi = decades[decades.length - 1] ?? null;
const hasDecadeRange = decLo != null && decHi != null && decHi > decLo;
---

<FilmLayout title="Watchlist — Jason's film log">
	<div class="page">
		<div class="wrap">
			<header class="topbar">
				<a class="back" href="/films">
					<span class="back__arrow">←</span><span>Jason's film log</span>
				</a>
				<span class="topbar__tag">Watchlist</span>
			</header>

			<div class="titleblock">
				<div>
					<div class="titleblock__head">
						<h1>Watchlist</h1>
						{isOwner && <button type="button" class="add-btn" id="open-composer">+ Add film</button>}
					</div>
					<div class="sub">
						<span class="sub__n" id="wl-count">{num(films.length)}</span>{' '}
						<span id="wl-noun">{films.length === 1 ? 'film' : 'films'}</span> to watch · showing{' '}
						<span class="sub__n" id="shown">{num(films.length)}</span>
					</div>
				</div>
			</div>

			<div class="filterbar">
				<input
					type="search"
					id="search"
					placeholder="Search watchlist…"
					autocomplete="off"
					aria-label="Search watchlist"
				/>
				<button
					type="button"
					id="filters-toggle"
					class="pill pill--btn"
					aria-expanded="false"
					aria-controls="filters"
				>
					Filters<span id="filters-count"></span>
				</button>
				<div class="sortby">
					<span class="sortby__label">Sort</span>
					<button type="button" class="pill pill--on" data-sort="added">Recently added</button>
					<button type="button" class="pill" data-sort="year">Release date</button>
					<button type="button" class="pill" data-sort="shuffle">⇄ Shuffle</button>
				</div>
			</div>

			<div class="panel" id="filters" hidden>
				<div class="panel__head">
					<span class="panel__title">Filter watchlist</span>
					<button type="button" id="clear-all" class="clear" hidden>Clear all</button>
				</div>

				<div class="panel__grid">
					<section>
						<h2 class="grp">
							Release date <span class="grp__note">· includes upcoming</span>
						</h2>
						{hasDecadeRange ? (
							<div class="range range--dec" id="drange" data-lo={decLo} data-hi={decHi}>
								<div class="range__track"></div>
								<div class="range__fill" id="drange-fill"></div>
								<input
									type="range"
									id="dmin"
									min={decLo}
									max={decHi}
									step="10"
									value={decLo}
									aria-label="Earliest release decade"
								/>
								<input
									type="range"
									id="dmax"
									min={decLo}
									max={decHi}
									step="10"
									value={decHi}
									aria-label="Latest release decade"
								/>
								<div class="range__ends">
									<span id="dmin-label">{decLo}s</span><span id="dmax-label">{decHi}s</span>
								</div>
							</div>
						) : (
							<p class="grp__none">Not enough range to filter</p>
						)}
					</section>

					<section>
						<h2 class="grp">Genre</h2>
						{genres.length === 0 ? (
							<p class="grp__none">No genres yet</p>
						) : (
							<div class="chips">
								{genres.map((g, i) => (
									<button
										type="button"
										class="chip"
										data-filter="genre"
										data-value={g}
										aria-pressed="false"
										hidden={i >= GENRE_CHIP_LIMIT}
									>
										{g}
									</button>
								))}
								{genres.length > GENRE_CHIP_LIMIT && (
									<button type="button" class="chip chip--more">
										+{genres.length - GENRE_CHIP_LIMIT} other…
									</button>
								)}
							</div>
						)}
					</section>
				</div>
			</div>

			<div class="grid" id="grid">
				{films.map((f, i) => {
					const poster = imageUrl(f.poster_path, 'w342');
					const upcoming = isUpcoming(f);
					const added = shortDate(f.added_at);
					// The owner's tiles link out to YTS; a visitor's aren't links at all.
					const Tag = isOwner ? 'a' : 'div';
					return (
						<div
							class="item"
							data-tmdb-id={f.tmdb_id}
							data-order={i}
							data-title={f.title.toLowerCase()}
							data-year={f.release_year ?? ''}
							data-genres={f.genres.join('|')}
						>
							{isOwner && (
								<button type="button" class="remove" aria-label={`Remove ${f.title} from watchlist`}>
									✕
								</button>
							)}
							<Tag
								class={poster ? 'tile' : 'tile tile--noimg'}
								{...(isOwner
									? { href: ytsUrl(f.title, f.release_year), target: '_blank', rel: 'noopener noreferrer' }
									: {})}
							>
								{poster && <img src={poster} alt={`${f.title} poster`} loading="lazy" />}
								{upcoming && <span class="badge">Upcoming</span>}
								<div class="tile__overlay">
									<div class="tile__title">{f.title}</div>
									<div class="tile__year">{f.release_year}</div>
									<div class="tile__genre">{f.genres[0]}</div>
									{added && <div class="tile__added">Added {added}</div>}
								</div>
							</Tag>
						</div>
					);
				})}
			</div>

			<p class="empty" id="empty" hidden={films.length > 0}>
				<span id="empty-none" hidden={films.length > 0}>Nothing on the watchlist yet.</span>
				<span id="empty-by-query" hidden>No films match “<span id="empty-q"></span>”</span>
				<span id="empty-by-filters" hidden>No films match these filters</span>
			</p>
		</div>
	</div>

	{isOwner && (
		<div class="modal" id="composer" hidden>
			<div class="modal__backdrop" id="composer-backdrop"></div>
			<div class="modal__panel" role="dialog" aria-modal="true" aria-label="Add a film to your watchlist">
				<div class="modal__head">
					<span class="modal__title">Add to watchlist</span>
					<button type="button" class="modal__close" id="composer-close" aria-label="Close">✕</button>
				</div>

				<div class="modal__body">
					<label class="lbl" for="c-q">Film</label>
					<div class="search" id="c-search">
						<input type="text" id="c-q" placeholder="Search a film…" autocomplete="off" />
						<ul class="results" id="c-results" hidden></ul>
					</div>
					<div class="selected" id="c-selected" hidden>
						<img id="c-sel-poster" alt="" width="26" height="39" />
						<span id="c-sel-title"></span>
						<button type="button" class="link" id="c-change">change</button>
					</div>
				</div>

				<div class="modal__foot">
					<span class="save-msg" id="save-msg"></span>
					<button type="button" class="btn-ghost" id="composer-cancel">Cancel</button>
					<button type="button" class="btn-save" id="composer-save" disabled>Add film</button>
				</div>
			</div>
		</div>
	)}

	<style>
		.page {
			display: flex;
			justify-content: center;
			padding: 0 24px 80px;
		}
		.wrap {
			width: 100%;
			max-width: 1000px;
		}
		.topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 26px 0 22px;
			border-bottom: 1px solid #4a2529;
			margin-bottom: 34px;
		}
		.back {
			display: flex;
			align-items: center;
			gap: 9px;
			font-size: 13px;
			color: #a2857a;
		}
		.back:hover {
			color: #f4e8d1;
		}
		.back__arrow {
			font-size: 15px;
		}
		.topbar__tag {
			font-size: 11.5px;
			text-transform: uppercase;
			letter-spacing: 2px;
			color: #8a6f63;
		}

		.titleblock {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			margin-bottom: 26px;
			flex-wrap: wrap;
			gap: 16px;
		}
		.titleblock__head {
			display: flex;
			align-items: center;
			gap: 18px;
		}
		h1 {
			font-family: 'Newsreader', serif;
			font-weight: 500;
			font-size: 52px;
			color: #f4e8d1;
			letter-spacing: -0.5px;
			line-height: 1;
			margin: 0;
		}
		.add-btn {
			font-size: 13px;
			font-weight: 700;
			color: #2a1214;
			background: #d9b45a;
			border: none;
			border-radius: 8px;
			padding: 10px 18px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			white-space: nowrap;
		}
		.add-btn:hover {
			background: #f0d488;
		}
		.sub {
			font-size: 13px;
			color: #a2857a;
			margin-top: 10px;
		}
		.sub__n {
			color: #d9b45a;
			font-weight: 600;
		}

		.filterbar {
			display: flex;
			gap: 12px;
			align-items: center;
			margin-bottom: 14px;
			flex-wrap: wrap;
		}
		#search {
			flex: 1;
			min-width: 220px;
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 8px;
			padding: 11px 14px;
			color: #f4e8d1;
			font-size: 14px;
			font-family: 'Archivo', sans-serif;
			outline: none;
		}
		#search::placeholder {
			color: #8a6f63;
		}
		#search:focus {
			border-color: #d9b45a;
		}
		.sortby {
			display: flex;
			align-items: center;
			gap: 8px;
		}
		.sortby__label {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
		}
		.pill {
			font-size: 12.5px;
			padding: 7px 13px;
			border-radius: 20px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			border: 1px solid #4a2529;
			background: transparent;
			color: #ddc9b4;
		}
		.pill:hover {
			border-color: #a2857a;
		}
		.pill--on {
			background: #d9b45a;
			color: #2a1214;
			font-weight: 600;
			border-color: #d9b45a;
		}
		.pill--btn {
			padding: 10px 16px;
			border-radius: 8px;
		}

		/* --- Filter panel --- */
		.panel {
			background: #241012;
			border: 1px solid #4a2529;
			border-radius: 12px;
			padding: 24px 26px;
			margin-bottom: 26px;
		}
		.panel[hidden] {
			display: none;
		}
		.panel__head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 20px;
		}
		.panel__title {
			font-size: 11px;
			text-transform: uppercase;
			letter-spacing: 1.6px;
			color: #8a6f63;
		}
		.clear {
			font-size: 12px;
			font-weight: 600;
			color: #d9b45a;
			background: transparent;
			border: none;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			padding: 0;
		}
		.clear:hover {
			color: #f0d488;
		}
		.clear[hidden] {
			display: none;
		}
		.panel__grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 26px 40px;
		}
		.grp {
			font-size: 11px;
			font-weight: 400;
			text-transform: uppercase;
			letter-spacing: 1.4px;
			color: #8a6f63;
			margin: 0 0 12px;
		}
		.grp__note {
			letter-spacing: 0.4px;
			text-transform: none;
			color: #6f5850;
		}
		.grp__none {
			font-size: 13px;
			font-style: italic;
			font-family: 'Newsreader', serif;
			color: #8a6f63;
			margin: 0;
		}
		.chips {
			display: flex;
			gap: 8px;
			flex-wrap: wrap;
		}
		.chip {
			font-size: 12.5px;
			padding: 7px 13px;
			border-radius: 20px;
			cursor: pointer;
			font-family: 'Archivo', sans-serif;
			border: 1px solid #4a2529;
			background: transparent;
			color: #ddc9b4;
		}
		.chip:hover {
			border-color: #a2857a;
		}
		.chip[aria-pressed='true'] {
			background: #d9b45a;
			color: #2a1214;
			font-weight: 600;
			border-color: #d9b45a;
		}
		.chip[hidden] {
			display: none;
		}
		.chip--more {
			background: transparent;
			color: #a2857a;
			border-style: dashed;
		}

		/* Dual-thumb release-date range: two native sliders stacked on one track, so
		   keyboard and screen-reader support come for free. The inputs ignore pointer
		   events except on their thumbs, which lets whichever thumb is under the
		   cursor take the drag even though the boxes fully overlap. Mirrors the
		   "All films" grid's sliders. */
		.range {
			max-width: 260px;
			position: relative;
			height: 32px;
		}
		.range__track,
		.range__fill {
			position: absolute;
			top: 14px;
			height: 4px;
			border-radius: 2px;
			pointer-events: none;
		}
		.range__track {
			left: 0;
			right: 0;
			background: #402226;
		}
		.range__fill {
			background: #d9b45a;
		}
		.range input[type='range'] {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 32px;
			margin: 0;
			background: none;
			appearance: none;
			-webkit-appearance: none;
			pointer-events: none;
		}
		.range input[type='range']:focus-visible {
			outline: none;
		}
		.range input[type='range']::-webkit-slider-thumb {
			appearance: none;
			-webkit-appearance: none;
			pointer-events: auto;
			width: 16px;
			height: 16px;
			border-radius: 50%;
			background: #f0d488;
			border: 2px solid #241012;
			box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
			cursor: pointer;
		}
		.range input[type='range']::-moz-range-thumb {
			pointer-events: auto;
			width: 16px;
			height: 16px;
			border-radius: 50%;
			background: #f0d488;
			border: 2px solid #241012;
			box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
			cursor: pointer;
		}
		.range input[type='range']:focus-visible::-webkit-slider-thumb {
			outline: 2px solid #f0d488;
			outline-offset: 2px;
		}
		.range input[type='range']:focus-visible::-moz-range-thumb {
			outline: 2px solid #f0d488;
			outline-offset: 2px;
		}
		.range__ends {
			position: absolute;
			top: 30px;
			left: 0;
			right: 0;
			display: flex;
			justify-content: space-between;
			font-size: 13px;
			color: #d9b45a;
			pointer-events: none;
		}
		/* The end labels are positioned out of flow, so reserve the room they occupy. */
		.range--dec {
			margin-bottom: 20px;
		}

		.grid {
			display: grid;
			grid-template-columns: repeat(6, 1fr);
			gap: 18px;
			margin-top: 16px;
		}
		.item {
			position: relative;
		}
		.item[hidden] {
			display: none;
		}
		.remove {
			position: absolute;
			top: 7px;
			right: 7px;
			z-index: 2;
			width: 26px;
			height: 26px;
			border-radius: 50%;
			background: rgba(20, 8, 9, 0.82);
			border: 1px solid #4a2529;
			color: #f2e5cd;
			font-size: 12px;
			line-height: 1;
			cursor: pointer;
			opacity: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			transition: opacity 0.12s, background 0.12s, color 0.12s;
		}
		.item:hover .remove,
		.remove:focus-visible {
			opacity: 1;
		}
		.remove:hover {
			background: #d9b45a;
			color: #2a1214;
			border-color: #d9b45a;
		}
		.remove:disabled {
			cursor: default;
			opacity: 0.5;
		}
		.tile {
			position: relative;
			display: block;
			color: inherit;
			aspect-ratio: 2 / 3;
			border-radius: 5px;
			overflow: hidden;
			background-image: repeating-linear-gradient(135deg, #351a1d 0 9px, #2c1518 9px 18px);
			border: 1px solid #4a2529;
			transition: border-color 0.12s;
		}
		.item:hover .tile {
			border-color: #d9b45a;
		}
		.tile img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.badge {
			position: absolute;
			top: 8px;
			left: 8px;
			z-index: 1;
			font-size: 9.5px;
			font-weight: 700;
			letter-spacing: 1px;
			text-transform: uppercase;
			color: #2a1214;
			background: #d9b45a;
			border-radius: 3px;
			padding: 3px 6px;
		}
		.tile__overlay {
			position: absolute;
			inset: 0;
			display: flex;
			flex-direction: column;
			justify-content: flex-end;
			padding: 12px;
			background: rgba(18, 8, 9, 0.82);
			opacity: 0;
			transition: opacity 0.18s ease;
		}
		.item:hover .tile__overlay {
			opacity: 1;
		}
		/* Films with no poster: keep the caption visible over the striped tile. */
		.tile--noimg .tile__overlay {
			opacity: 1;
			background: transparent;
		}
		.tile__title {
			font-family: 'Newsreader', serif;
			font-size: 16px;
			font-weight: 500;
			color: #f4e8d1;
			line-height: 1.15;
		}
		.tile__year {
			font-family: 'Archivo', sans-serif;
			font-size: 11px;
			letter-spacing: 1.4px;
			text-transform: uppercase;
			color: #d9b45a;
			margin-top: 5px;
		}
		.tile__genre {
			font-size: 12px;
			color: #a2857a;
			margin-top: 4px;
		}
		.tile__added {
			font-size: 11px;
			color: #8a6f63;
			margin-top: 3px;
		}

		.empty {
			padding: 48px 0;
			text-align: center;
			color: #8a6f63;
			font-size: 15px;
