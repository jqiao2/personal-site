---
// Owner-only: the recipes saved from Instagram, newest first, as a blog with a
// filter sidebar. Filters are links, so the state lives in the query string. The
// rows come from the recipes repo (see src/lib/recipes-db.ts); the site edits none.
import Layout from '../../layouts/Layout.astro';
import RecipeFilterGroup from '../../components/RecipeFilterGroup.astro';
import { requireOwner } from '../../lib/auth';
import { formatWatchedDate } from '../../lib/format';
import { COMPLETENESS_LABEL, courseLabel, formatMinutes, recipeIndexView, totalMinutes } from '../../lib/recipes';
import { listRecipes } from '../../lib/recipes-db';

export const prerender = false;

if (!(await requireOwner(Astro.cookies))) {
	return Astro.redirect(`/films/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

const recipes = await listRecipes();

const view = recipeIndexView(recipes, Astro.url.searchParams);
---

<Layout title="Recipes" wide>
	<div class="shell">
		<div class="feed">
			<p class="count">{view.shown.length} of {recipes.length} recipes</p>

			{
				view.active.length > 0 && (
					<p class="active">
						{view.active.map((a) => (
							<a class="active__chip" href={a.href} aria-label={`Remove ${a.label}`}>
								{a.label} ×
							</a>
						))}
						<a class="active__clear" href="/recipes">Clear</a>
					</p>
				)
			}

			{
				view.shown.map((r) => {
					const total = totalMinutes(r);

					return (
						<article class="entry">
							<p class="entry__meta">
								<time datetime={r.added}>{formatWatchedDate(r.added)}</time>
								<span>{courseLabel(r.course)}</span>
								{r.cuisine && <span>{r.cuisine}</span>}
								{total != null && <span>{formatMinutes(total)}</span>}
								{r.completeness !== 'full' && <span class="tag">{COMPLETENESS_LABEL[r.completeness]}</span>}
							</p>
							<h2 class="entry__title">
								<a href={`/recipes/${r.id}`}>{r.title}</a>
							</h2>
							{r.summary && <p class="entry__summary">{r.summary}</p>}
							<p class="entry__ingredients">
								{r.key_ingredients.join(', ')}
								{r.creator && <span class="entry__creator"> · @{r.creator}</span>}
							</p>
						</article>
					);
				})
			}

			{recipes.length === 0 && <p class="empty">No recipes yet.</p>}
			{recipes.length > 0 && view.shown.length === 0 && <p class="empty">No recipes match.</p>}
		</div>

		<aside class="side">
			<form class="search" method="get" action="/recipes" role="search">
				{view.carried.map(([k, v]) => <input type="hidden" name={k} value={v} />)}
				<input type="search" name="q" value={view.query.q} placeholder="Search…" aria-label="Search recipes" />
			</form>

			<details class="filters" open data-active={view.active.length > 0 || undefined}>
				<summary>Filters</summary>
				<RecipeFilterGroup title="Type" chips={view.courses} />
				<RecipeFilterGroup title="Time" chips={view.times} />
				<RecipeFilterGroup title="Ingredient" chips={view.ingredients} head={14} />
				<RecipeFilterGroup title="Cuisine" chips={view.cuisines} />
				<RecipeFilterGroup title="Tag" chips={view.tags} />
				<RecipeFilterGroup title="Source" chips={[view.full]} />
				<button type="button" class="sync" data-recipe-sync>Sync</button>
				<pre class="sync__out" data-recipe-sync-out hidden></pre>
			</details>

			{/* Runs before paint: on a phone the filters start closed unless some are on. */}
			<script is:inline>
				{
					const filters = document.querySelector('.filters');

					if (matchMedia('(max-width: 820px)').matches && !filters.dataset.active) filters.open = false;
				}
			</script>
		</aside>
	</div>
</Layout>

<script>
	const button = document.querySelector<HTMLButtonElement>('[data-recipe-sync]');

	const out = document.querySelector<HTMLPreElement>('[data-recipe-sync-out]');

	button?.addEventListener('click', async () => {
		if (!out) return;

		button.disabled = true;
		button.textContent = 'Syncing…';

		const res = await fetch('/api/recipes/sync', { method: 'POST' });

		const body = await res.json();

		button.disabled = false;
		button.textContent = 'Sync';

		if (res.ok && body.skipped.length === 0) {
			location.reload();

			return;
		}

		out.hidden = false;
		out.textContent = res.ok
			? [
					`${body.synced} synced`,
					...body.skipped.map((s: { id: string; reason: string }) => `${s.id}: ${s.reason}`),
				].join('\n')
			: body.error;
	});
</script>

<style>
	.shell {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 280px;
		gap: 2.5rem;
	}
	.count {
		font-family: var(--sans);
		font-size: 0.8rem;
		color: var(--ink-soft);
		margin: 0 0 0.75rem;
	}
	.active {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		align-items: baseline;
		margin: 0 0 1rem;
		font-family: var(--sans);
		font-size: 0.8rem;
	}
	.active__chip {
		padding: 0.1rem 0.45rem;
		border: 1px solid var(--accent);
		border-radius: 2px;
		background: var(--accent-bg);
		color: var(--accent);
		text-decoration: none;
	}
	.active__chip:visited {
		color: var(--accent);
	}
	.entry {
		padding: 0.75rem 0 1.05rem;
		border-bottom: 1px solid var(--rule-soft);
	}
	.entry__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		align-items: baseline;
		margin: 0 0 0.2rem;
		font-family: var(--sans);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}
	.tag {
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		padding: 0.1rem 0.4rem;
		border: 1px solid var(--rule);
		border-radius: 2px;
		background: var(--accent-bg);
		color: var(--accent);
	}
	.entry__title {
		font-size: 1.3rem;
		font-weight: 600;
		line-height: 1.25;
		margin: 0;
	}
	.entry__title a,
	.entry__title a:visited {
		color: var(--ink);
		text-decoration: none;
	}
	.entry__title a:hover {
		text-decoration: underline;
	}
	.entry__summary {
		margin: 0.35rem 0 0;
	}
	.entry__ingredients {
		margin: 0.3rem 0 0;
		font-size: 0.92rem;
		color: var(--ink-soft);
	}
	.empty {
		color: var(--ink-soft);
		padding: 1rem 0;
	}
	.search {
		margin-bottom: 1rem;
	}
	.search input {
		box-sizing: border-box;
		width: 100%;
		padding: 0.4rem 0.55rem;
		font: inherit;
		font-family: var(--sans);
		font-size: 0.9rem;
		color: var(--ink);
		background: var(--card);
		border: 1px solid var(--rule);
		border-radius: 2px;
	}
	.filters summary {
		display: none;
		font-family: var(--sans);
		font-size: 0.85rem;
		color: var(--ink-soft);
		cursor: pointer;
		margin-bottom: 0.75rem;
	}
	.sync {
		font-family: var(--sans);
		font-size: 0.75rem;
		padding: 0.2rem 0.6rem;
		color: var(--ink-soft);
		background: none;
		border: 1px solid var(--rule);
		border-radius: 2px;
		cursor: pointer;
	}
	.sync__out {
		margin: 0.5rem 0 0;
		font-size: 0.75rem;
		white-space: pre-wrap;
		color: var(--ink-soft);
	}
	@media (max-width: 820px) {
		.shell {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
		.side {
			order: -1;
		}
		.filters summary {
			display: list-item;
		}
	}
</style>
