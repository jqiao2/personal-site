---
// MTA Savant leaderboards: every subway line and bus route over the last 12
// months, each cell shaded by percentile. Static — built from data.ny.gov at
// deploy time.
import '../../../styles/mta.css';
import Layout from '../../../layouts/Layout.astro';
import MtaBullet from '../../../components/MtaBullet.astro';
import { MODES, leaderboard } from '../../../lib/mta-savant-view';

const boards = await Promise.all(MODES.map(async (mode) => ({ mode, ...(await leaderboard(mode)) })));
---

<Layout title="MTA Savant" wide>
	<h1 class="sign">MTA Savant</h1>
	<p class="sub">
		Every subway line and bus route, last 12 months through {boards[0].latest}. Shaded by percentile, <span class="poor">poor</span> to <span class="great">great</span>. Click a column to sort.
	</p>

	{
		boards.map((b) => (
			<section>
				<h2 class="sign">{b.mode === 'subway' ? 'Subway' : 'Bus'}</h2>
				<div class:list={['scroll', { tall: b.mode === 'subway' }]}>
					<table class="stats" data-sortable>
						<thead>
							<tr>
								<th class="lead">
									{b.mode === 'bus' && (
										<input type="search" class="search" data-search placeholder="Route or neighborhood" aria-label="Search bus routes" />
									)}
									{b.mode === 'subway' ? 'Line' : 'Route'}
								</th>
								{b.columns.map((c, i) => (
									<th>
										<button type="button" data-col={i + 1} title={c.label}>
											{c.abbr}
										</button>
									</th>
								))}
							</tr>
						</thead>
						<tbody>
							{b.rows.map((r) => (
								<tr>
									<th>
										<a href={`/projects/mta-savant/${b.mode}/${r.line.slug}`}>
											<MtaBullet line={r.line} />
											{b.mode === 'bus' && <span class="name">{r.line.name}</span>}
										</a>
									</th>
									{r.cells.map((c) =>
										c ? (
											<td data-v={c.pct} style={`background:${c.color};color:${c.ink}`}>
												{c.text}
											</td>
										) : (
											<td data-v="-1">—</td>
										)
									)}
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>
		))
	}

	<p class="sub">
		Source: MTA performance datasets on <a href="https://data.ny.gov/">data.ny.gov</a>. Modeled after
		<a href="https://baseballsavant.mlb.com/">Baseball Savant</a>.
	</p>
</Layout>

<script>
	// Sort a leaderboard by a column's percentile. Clicking the same column cycles
	// best first → worst first → the original order; a new column starts at best first.
	// Lines with no value for the column stay at the bottom either way.
	for (const table of document.querySelectorAll<HTMLTableElement>('[data-sortable]')) {
		const body = table.tBodies[0];
		const original = [...body.rows];

		table.tHead!.addEventListener('click', (e) => {
			// SAFETY: a click inside the thead always targets an element, never a text node.
			const button = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-col]');

			if (!button) return;

			const th = button.parentElement!;
			const was = th.getAttribute('aria-sort');
			const dir = was === 'descending' ? 'ascending' : was === 'ascending' ? 'none' : 'descending';

			for (const other of table.tHead!.querySelectorAll('th[aria-sort]')) other.removeAttribute('aria-sort');

			if (dir === 'none') {
				body.append(...original);

				return;
			}

			th.setAttribute('aria-sort', dir);

			const col = Number(button.dataset.col);
			const v = (tr: HTMLTableRowElement) => Number(tr.cells[col].dataset.v);
			const sign = dir === 'descending' ? 1 : -1;

			body.append(
				...[...body.rows].sort((a, b) => {
					if (v(a) < 0 || v(b) < 0) return v(b) - v(a);

					return sign * (v(b) - v(a));
				})
			);
		});
	}

	// Bus search: hide rows whose route id and name don't contain the query.
	for (const input of document.querySelectorAll<HTMLInputElement>('[data-search]')) {
		const rows = [...input.closest('table')!.tBodies[0].rows];

		input.addEventListener('input', () => {
			const q = input.value.trim().toLowerCase();

			for (const tr of rows) tr.toggleAttribute('hidden', !tr.cells[0].textContent!.toLowerCase().includes(q));
		});
	}
</script>

<style>
	h2 {
		font-size: 1.15rem;
		margin: 2rem 0 0.5rem;
	}
	.sub {
		font-family: var(--sans);
		font-size: 0.85rem;
		color: var(--ink-soft);
	}
	.poor {
		color: rgb(53, 97, 173);
	}
	.great {
		color: rgb(215, 33, 41);
	}
	.stats thead th.lead {
		text-align: left;
	}
	.search {
		display: block;
		font: inherit;
		font-family: var(--sans);
		font-size: 0.9rem;
		width: 16rem;
		padding: 0.35rem 0.55rem;
		margin-bottom: 0.4rem;
		font-weight: 400;
		background: var(--card);
		color: var(--ink);
		border: 1px solid var(--rule);
		border-radius: 4px;
	}
	.scroll {
		overflow-x: auto;
		max-height: 80vh;
		overflow-y: auto;
	}
	/* The subway's two dozen lines fit; only the 350-odd bus routes need their own scroll. */
	.scroll.tall {
		max-height: none;
		overflow-y: visible;
	}
	.stats {
		border-collapse: collapse;
		font-family: var(--sans);
		font-size: 0.85rem;
		font-variant-numeric: tabular-nums;
		width: 100%;
	}
	.stats th,
	.stats td {
		padding: 0.3rem 0.6rem;
		text-align: right;
		border-bottom: 1px solid var(--rule-soft);
		white-space: nowrap;
	}
	.stats thead th {
		position: sticky;
		top: 0;
		background: var(--paper);
		border-bottom: 2px solid var(--rule);
		vertical-align: bottom;
		white-space: normal;
	}
	.stats thead button {
		font: inherit;
		font-weight: 600;
		color: inherit;
		background: none;
		border: 0;
		padding: 0;
		cursor: pointer;
		text-align: right;
	}
	.stats thead button:hover {
		color: var(--link);
	}
	.stats th[aria-sort] button {
		color: var(--link);
	}
	.stats th[aria-sort='descending'] button::after {
		content: ' ▼';
	}
	.stats th[aria-sort='ascending'] button::after {
		content: ' ▲';
	}
	.stats tbody th {
		text-align: left;
	}
	.stats tbody th a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
	}
	.name {
		font-weight: 400;
		max-width: 16rem;
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>
