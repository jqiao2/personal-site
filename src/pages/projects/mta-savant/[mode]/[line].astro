---
// One line's page, Baseball Savant player-page style: percentile rankings for the
// trailing 12 months, a year-by-year table and monthly trends against the
// field's median. Static — built from data.ny.gov at deploy time.
import Layout from '../../../../layouts/Layout.astro';
import MtaBullet from '../../../../components/MtaBullet.astro';
import { loadDataset, type Mode } from '../../../../lib/mta-savant';
import { MODES, TREND_VIEWBOX, linePage } from '../../../../lib/mta-savant-view';

export async function getStaticPaths() {
	const sets = await Promise.all(MODES.map(loadDataset));

	return sets.flatMap((ds) => ds.lines.map((l) => ({ params: { mode: ds.mode, line: l.slug } })));
}

// SAFETY: getStaticPaths above only emits modes from MODES and slugs from the dataset.
const { mode, line: slug } = Astro.params as { mode: Mode; line: string };

const page = await linePage(mode, slug);

const { line } = page;
---

<Layout title={`${line.short} · MTA Savant`} wide>
	<p class="crumb"><a href="/projects/mta-savant">MTA Savant</a> / {mode === 'subway' ? 'Subway' : 'Bus'}</p>

	<header class="hero">
		<MtaBullet line={line} size="lg" />
		<div>
			<h1>{line.name}</h1>
			<p class="meta">{line.group} · data through {page.latest}</p>
		</div>
	</header>

	<div class="grid">
		<section>
			<h2>Percentile rankings</h2>
			<p class="sub">Last 12 months, against every {mode === 'subway' ? 'line' : 'route'}</p>
			<div class="savant">
				<div class="row scalehead" aria-hidden="true">
					<span></span>
					<span class="marks">
						<span class="poor">Poor<i>▲</i></span>
						<span class="avg">Average<i>▲</i></span>
						<span class="great">Great<i>▲</i></span>
					</span>
					<span></span>
				</div>
				{
					page.rankingGroups.map((g) => (
						<>
							<h3 class="group">{g.name}</h3>
							<ul class="ranks">
								{g.rows.map((r) => (
									<li class="row">
										<span class="label" title={r.label}>
											{r.abbr}
										</span>
										<span class="bar" style={r.pct === null ? undefined : `--p:${r.pct}%;--c:${r.color}`}>
											{r.pct !== null && (
												<>
													<span class="fill" />
													<span class="dot" style={`color:${r.ink}`}>
														{r.pct}
													</span>
												</>
											)}
										</span>
										<span class="value" title={r.rank}>
											{r.value}
										</span>
									</li>
								))}
							</ul>
						</>
					))
				}
			</div>
		</section>

		<section>
			<h2>Trends</h2>
			<p class="sub">Monthly, <span class="key own" style={`background:${line.color}`}></span> this {mode === 'subway' ? 'line' : 'route'} vs <span class="key median"></span> median</p>
			<div class="trends">
				{
					page.trends.map((t) => (
						<figure data-trend={JSON.stringify(t.points)}>
							<figcaption title={t.label}>{t.abbr}</figcaption>
							<div class="plot">
								<svg viewBox={TREND_VIEWBOX} role="img" aria-label={`${t.label}, ${t.from} to ${t.to}`}>
									<path d={t.median} class="median" />
									<path d={t.line} stroke={line.color} class="own" />
									<g data-cross display="none">
										<line class="cross" y1="0" y2="100%" />
										<circle class="mark" r="3" fill="var(--ink-soft)" data-mark-median />
										<circle class="mark" r="3.5" fill={line.color} data-mark-own />
									</g>
								</svg>
								<div class="tip" data-tip hidden aria-hidden="true">
									<div class="tip-date" data-tip-date></div>
									<div class="tip-row">
										<span class="tip-sw" style={`background:${line.color}`}></span>
										{line.short}
										<b data-tip-own></b>
									</div>
									<div class="tip-row">
										<span class="tip-sw median"></span>
										Median
										<b data-tip-median></b>
									</div>
								</div>
							</div>
							<div class="scale">
								<span>{t.bottom} – {t.top}</span>
								<span>{t.from.slice(-4)}–{t.to.slice(-4)}</span>
							</div>
						</figure>
					))
				}
			</div>
		</section>
	</div>

	<section>
		<h2>By year</h2>
		<div class="scroll">
			<table class="stats">
				<thead>
					<tr>
						<th>Year</th>
						{page.columns.map((c) => <th title={c.label}>{c.abbr}</th>)}
					</tr>
				</thead>
				<tbody>
					{
						page.table.map((row) => (
							<tr>
								<th>{row.label}</th>
								{row.cells.map((c) => (
									<td style={c.color ? `background:${c.color};color:${c.ink}` : undefined}>{c.text}</td>
								))}
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
		<p class="sub">Cells shaded by percentile within that year.</p>
	</section>

	<nav class="others" aria-label={mode === 'subway' ? 'Other lines' : 'Other routes'}>
		{
			page.siblings.map((l) => (
				<a href={`/projects/mta-savant/${mode}/${l.slug}`} aria-current={l.id === line.id ? 'page' : undefined}>
					<MtaBullet line={l} />
				</a>
			))
		}
	</nav>
</Layout>

<script>
	// Hover a trend: snap a crosshair and readout to the month nearest the pointer,
	// as on /activities/fitness. The SVG scales to its box, so the pointer's x is
	// mapped back into viewBox units before the nearest month is found.
	type Point = [number, number | null, number | null, string, string, string];

	for (const fig of document.querySelectorAll<HTMLElement>('[data-trend]')) {
		// SAFETY: the page writes this attribute from Trend['points'], which is Point[].
		const points = JSON.parse(fig.dataset.trend!) as Point[];
		const svg = fig.querySelector('svg')!;
		const cross = svg.querySelector<SVGGElement>('[data-cross]')!;
		const line = cross.querySelector('line')!;
		const own = cross.querySelector<SVGCircleElement>('[data-mark-own]')!;
		const median = cross.querySelector<SVGCircleElement>('[data-mark-median]')!;
		const tip = fig.querySelector<HTMLElement>('[data-tip]')!;
		const width = svg.viewBox.baseVal.width;

		const place = (dot: SVGCircleElement, x: number, y: number | null) => {
			dot.setAttribute('display', y === null ? 'none' : 'inline');
			dot.setAttribute('cx', String(x));
			dot.setAttribute('cy', String(y ?? 0));
		};

		const scrub = (clientX: number) => {
			const rect = svg.getBoundingClientRect();

			if (rect.width === 0 || points.length === 0) return;

			const vbX = ((clientX - rect.left) / rect.width) * width;
			let best = points[0];

			for (const p of points) if (Math.abs(p[0] - vbX) < Math.abs(best[0] - vbX)) best = p;

			const [x, yOwn, yMedian, month, ownText, medianText] = best;

			cross.removeAttribute('display');
			line.setAttribute('x1', String(x));
			line.setAttribute('x2', String(x));
			place(own, x, yOwn);
			place(median, x, yMedian);

			tip.removeAttribute('hidden');
			tip.querySelector('[data-tip-date]')!.textContent = month;
			tip.querySelector('[data-tip-own]')!.textContent = ownText;
			tip.querySelector('[data-tip-median]')!.textContent = medianText;

			// Follow the crosshair, flipping left past the middle so the box stays on the chart.
			const px = (x / width) * rect.width;

			tip.style.left = `${px}px`;
			tip.style.transform = px > rect.width / 2 ? 'translateX(calc(-100% - 8px))' : 'translateX(8px)';
		};

		svg.addEventListener('pointermove', (e) => scrub(e.clientX));
		svg.addEventListener('pointerdown', (e) => scrub(e.clientX));
		svg.addEventListener('pointerleave', () => {
			cross.setAttribute('display', 'none');
			tip.setAttribute('hidden', '');
		});
	}
</script>

<style>
	.crumb {
		font-family: var(--sans);
		font-size: 0.85rem;
		color: var(--ink-soft);
		margin: 0;
	}
	.hero {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 1rem 0 1.5rem;
		border-bottom: 1px solid var(--rule);
		margin-bottom: 1.5rem;
	}
	.hero h1 {
		margin: 0;
	}
	.meta,
	.sub {
		font-family: var(--sans);
		font-size: 0.85rem;
		color: var(--ink-soft);
		margin: 0;
	}
	h2 {
		font-size: 1.15rem;
		margin: 0 0 0.15rem;
	}
	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 2.5rem;
		margin-bottom: 2rem;
	}
	@media (max-width: 800px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* Savant's percentile panel: right-aligned names, a full-height bar filled to
	   the percentile, a thin track after it, the number in a ringed dot at the end. */
	.savant {
		--great: rgb(215, 33, 41);
		--avg: rgb(140, 170, 178);
		--poor: rgb(53, 97, 173);
		--teal: #5b8f97;
		font-family: var(--sans);
		margin-top: 0.75rem;
	}
	.row {
		display: grid;
		grid-template-columns: 5rem 1fr 5rem;
		align-items: center;
		column-gap: 0.6rem;
	}
	.scalehead {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}
	.marks {
		display: flex;
		justify-content: space-between;
	}
	.marks > span {
		display: flex;
		flex-direction: column;
		align-items: center;
		line-height: 1.1;
	}
	.marks i {
		font-style: normal;
		font-size: 0.6rem;
	}
	.poor {
		color: var(--poor);
	}
	.avg {
		color: var(--avg);
	}
	.great {
		color: var(--great);
	}
	.group {
		font-family: var(--serif);
		font-size: 1rem;
		font-weight: 700;
		margin: 0.9rem 0 0.3rem;
		padding-bottom: 0.15rem;
		border-bottom: 2px solid var(--teal);
	}
	.ranks {
		list-style: none;
		padding: 0;
		margin: 0;
		font-size: 0.85rem;
	}
	.ranks li {
		height: 1.9rem;
	}
	.label,
	.value {
		align-self: stretch;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		text-align: right;
		border-bottom: 1px dashed var(--teal);
		white-space: nowrap;
	}
	.ranks li:last-child .label,
	.ranks li:last-child .value {
		border-bottom: 0;
	}
	.value {
		font-variant-numeric: tabular-nums;
	}
	.bar {
		position: relative;
		height: 1.45rem;
		/* The track: a thin rule through the middle, the full width. */
		background: linear-gradient(var(--rule), var(--rule)) 0 50% / 100% 0.3rem no-repeat;
	}
	.fill {
		position: absolute;
		inset: 0 auto 0 0;
		width: var(--p);
		background: var(--c);
	}
	/* Savant's faint guides at the 10th, 50th and 90th percentiles. */
	.bar::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			linear-gradient(rgb(255 255 255 / 0.45), rgb(255 255 255 / 0.45)) 10% 0 / 2px 100% no-repeat,
			linear-gradient(rgb(255 255 255 / 0.45), rgb(255 255 255 / 0.45)) 50% 0 / 2px 100% no-repeat,
			linear-gradient(rgb(255 255 255 / 0.45), rgb(255 255 255 / 0.45)) 90% 0 / 2px 100% no-repeat;
		pointer-events: none;
	}
	.dot {
		position: absolute;
		top: 50%;
		left: clamp(0.85rem, var(--p), calc(100% - 0.85rem));
		transform: translate(-50%, -50%);
		width: 1.7rem;
		height: 1.7rem;
		border-radius: 999px;
		display: grid;
		place-items: center;
		background: var(--c);
		border: 2px solid #fff;
		font-size: 0.75rem;
		font-weight: 700;
		z-index: 1;
	}

	/* Phones: give the bar more of the width. */
	@media (max-width: 600px) {
		.row {
			grid-template-columns: 3.75rem 1fr 4.25rem;
			column-gap: 0.45rem;
		}
	}

	.key {
		display: inline-block;
		width: 1rem;
		height: 3px;
		vertical-align: middle;
	}
	.key.median {
		border-top: 2px dashed var(--ink-soft);
		height: 0;
	}
	.trends {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
		gap: 1rem;
		margin-top: 1rem;
	}
	figure {
		margin: 0;
		font-family: var(--sans);
		font-size: 0.75rem;
	}
	figcaption {
		font-weight: 600;
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
		background: var(--card);
		border: 1px solid var(--rule-soft);
	}
	svg path {
		fill: none;
		stroke-linejoin: round;
	}
	path.own {
		stroke-width: 2;
	}
	path.median {
		stroke: var(--ink-soft);
		stroke-width: 1;
		stroke-dasharray: 3 3;
	}
	.scale {
		display: flex;
		justify-content: space-between;
		color: var(--ink-soft);
	}
	.plot {
		position: relative;
	}
	.cross {
		stroke: var(--ink-soft);
		stroke-width: 0.75;
		opacity: 0.6;
	}
	.mark {
		stroke: var(--card);
		stroke-width: 1.5;
	}
	[hidden] {
		display: none;
	}
	.tip {
		position: absolute;
		top: 4px;
		left: 0;
		pointer-events: none;
		background: var(--card);
		border: 1px solid var(--rule);
		border-radius: 0.4rem;
		padding: 0.3rem 0.5rem;
		box-shadow: 0 2px 8px rgb(0 0 0 / 0.12);
		z-index: 2;
		min-width: 7.5rem;
		white-space: nowrap;
	}
	.tip-date {
		font-weight: 600;
	}
	.tip-row {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--ink-soft);
	}
	.tip-row b {
		margin-left: auto;
		padding-left: 0.6rem;
		color: var(--ink);
		font-variant-numeric: tabular-nums;
	}
	.tip-sw {
		width: 10px;
		height: 3px;
		flex: none;
	}
	.tip-sw.median {
		height: 0;
		border-top: 2px dashed var(--ink-soft);
	}

	.scroll {
		overflow-x: auto;
		margin: 0.75rem 0 0.35rem;
	}
	.stats {
		border-collapse: collapse;
		font-family: var(--sans);
		font-size: 0.85rem;
		font-variant-numeric: tabular-nums;
		width: 100%;
	}
	.stats th,
	.stats td {
		padding: 0.35rem 0.6rem;
		text-align: right;
		border-bottom: 1px solid var(--rule-soft);
		white-space: nowrap;
	}
	.stats thead th {
		font-weight: 600;
		border-bottom: 2px solid var(--rule);
		vertical-align: bottom;
		white-space: normal;
	}
	.stats tbody th {
		text-align: left;
	}
	.stats tbody tr:last-child th,
	.stats tbody tr:last-child td {
		font-weight: 700;
		border-top: 2px solid var(--rule);
	}

	.others {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 2.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--rule);
	}
	.others a {
		text-decoration: none;
		opacity: 0.75;
	}
	.others a:hover,
	.others a[aria-current] {
		opacity: 1;
	}
</style>
