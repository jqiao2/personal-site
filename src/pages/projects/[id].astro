---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// SSR so the header's requireOwner() runs per request; prerendered, it bakes
// owner=false at build and shows the "Log in" button to the signed-in owner.
export const prerender = false;

const project = await getEntry('projects', Astro.params.id!);
if (!project) return Astro.rewrite('/404');
const { Content } = await render(project);
---

<Layout title={project.data.title}>
	<a href="/projects">&larr; Back to projects</a>
	<h1>{project.data.title}</h1>
	<p>
		<a href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">View on GitHub</a>
	</p>
	<Content />
</Layout>
