---
// Film credit collaboration network. Nodes are people who clear a per-role
// threshold (actor >= 5 films, director >= 2, composer >= 2); edges join people
// who share at least 2 films, weighted by how many. People who clear more than
// one role are drawn as split-colour pie nodes.
//
// Full-bleed rather than inside Layout.astro, whose 800px column would strangle a
// force-directed graph — same reasoning as /subway. The graph itself is rendered
// client-side by src/scripts/credit-network.js from a static JSON built by
// scripts/credit-graph/build.mjs.
import SiteHeader from '../../components/SiteHeader.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Credit Network</title>
		<meta
			name="description"
			content="A collaboration network of actors, directors and composers built from ~36,000 TMDB films."
		/>
	</head>
	<body>
		<SiteHeader pathname={Astro.url.pathname} theme="root" />

		<div class="cn-shell">
			<aside class="cn-side">
				<div class="cn-head">
					<h1>Credit Network</h1>
					<p id="meta" class="muted small"></p>
					<p id="counts" class="counts"></p>
				</div>

				<section class="physics">
					<div class="actions">
						<button id="layout-toggle" type="button">&#9654; Re-settle</button>
						<button id="reset-view" type="button">Reset view</button>
					</div>
					<label class="check">
						<input id="auto-resettle" type="checkbox" checked />
						Re-settle on filter change
					</label>
				</section>

				<section class="search-wrap">
					<label class="field">
						<span>Find someone</span>
						<input id="search" type="search" placeholder="e.g. mifune, coen, zimmer" autocomplete="off" />
					</label>
					<ul id="search-results" hidden></ul>
				</section>

				<section>
					<h2>Size &amp; rank by</h2>
					<label class="field">
						<select id="metric"></select>
					</label>
					<p id="metric-note" class="muted small"></p>
				</section>

				<section>
					<h2>How much to show</h2>
					<label class="field">
						<span>Top <output id="top-n-out"></output> people</span>
						<input id="top-n" type="range" min="100" step="50" />
					</label>
					<p class="muted small">All 25,236 puts the dots ~4px apart. Fewer is easier to read.</p>
				</section>

				<section>
					<h2>Colour by</h2>
					<label class="field">
						<select id="color-by"></select>
					</label>
					<p id="color-note" class="muted small"></p>
				</section>

				<section>
					<h2>Show</h2>
					<div id="filter-groups"></div>
					<p class="muted small">
						Combines across groups. Untick all but Actor and United States to get US actors. A role
						needs a quarter of someone's credits to count.
					</p>
				</section>

				<section>
					<h2>Filters</h2>
					<label class="field">
						<span>Min. shared films <output id="min-weight-out"></output></span>
						<input id="min-weight" type="range" min="2" max="12" step="1" />
					</label>
					<label class="field">
						<span>Min. films credited <output id="min-films-out">0</output></span>
						<input id="min-films" type="range" min="0" max="80" step="1" value="0" />
					</label>
				</section>

				<section id="details" class="details"></section>

				<section class="about">
					<p class="muted small">
						~36,000 TMDB films with 50+ votes. Each contributes its top 15 cast, directors and
						composers. People are joined when they share a film.
						<a href="/data/credit-network.gexf" download>Download GEXF</a> for Gephi.
					</p>
				</section>
			</aside>

			<main class="cn-main">
				<div id="graph"></div>
				<p id="loading">Loading network…</p>
			</main>
		</div>

		<script>
			import '../../scripts/credit-network.js';
		</script>

		<!--
			is:global is required, not stylistic. The sidebar's contents — the
			details panel, both legends and the search results — are built in JS
			with innerHTML, so those elements never receive the data-astro-cid
			attribute that scoped styles compile against, and every rule aimed at
			them silently fails to match. Left scoped, the collaborator list renders
			as default browser buttons and the legend swatches collapse to 0x0.
			/subway does the same thing for the same reason. Selectors here are all
			page-specific (cn-*, #graph, .partners …) and this page owns its own
			<html>, so nothing leaks.
		-->
		<style is:global>
			:root {
				color-scheme: light dark;
				--bg: #fff;
				--fg: #111;
				--muted: #666;
				--border: #ddd;
				--panel: #fafafa;
				--accent: #4a8fd4;
			}
			@media (prefers-color-scheme: dark) {
				:root {
					--bg: #111;
					--fg: #eee;
					--muted: #999;
					--border: #333;
					--panel: #181818;
				}
			}
			* {
				box-sizing: border-box;
			}
			body {
				font-family: system-ui, sans-serif;
				background: var(--bg);
				color: var(--fg);
				margin: 0;
				height: 100dvh;
				display: flex;
				flex-direction: column;
				overflow: hidden;
			}
			.cn-shell {
				flex: 1 1 auto;
				display: grid;
				grid-template-columns: 320px 1fr;
				min-height: 0;
			}
			.cn-side {
				border-right: 1px solid var(--border);
				background: var(--panel);
				padding: 1.25rem;
				overflow-y: auto;
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}
			/* Without this the details panel — whose height depends on how many
			   collaborators a person has — gets compressed by flex and its content
			   spills over the section below it. */
			.cn-side > section {
				flex: 0 0 auto;
			}
			/* Re-settle and reset stay reachable from anywhere in the sidebar —
			   they're the controls you want after changing a filter further down. */
			.physics {
				position: sticky;
				top: -1.25rem;
				z-index: 4;
				background: var(--panel);
				padding: 0.6rem 0;
				margin-bottom: -0.4rem;
				border-bottom: 1px solid var(--border);
			}
			.cn-main {
				position: relative;
				min-width: 0;
			}
			#graph {
				position: absolute;
				inset: 0;
			}
			#loading {
				position: absolute;
				inset: 0;
				display: grid;
				place-content: center;
				margin: 0;
				color: var(--muted);
			}

			h1 {
				font-size: 1.35rem;
				margin: 0 0 0.35rem;
			}
			h2 {
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--muted);
				margin: 0 0 0.6rem;
			}
			h3 {
				font-size: 1rem;
				margin: 0 0 0.4rem;
			}
			p {
				margin: 0 0 0.5rem;
			}
			.muted {
				color: var(--muted);
			}
			.small {
				font-size: 0.78rem;
				line-height: 1.45;
			}
			.counts {
				font-variant-numeric: tabular-nums;
				font-size: 0.85rem;
				margin: 0;
			}

			.field {
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
				font-size: 0.82rem;
			}
			.field + .field {
				margin-top: 0.75rem;
			}
			.field input[type='search'] {
				padding: 0.45rem 0.55rem;
				border: 1px solid var(--border);
				border-radius: 6px;
				background: var(--bg);
				color: var(--fg);
				font: inherit;
			}
			.field input[type='range'] {
				width: 100%;
				accent-color: var(--accent);
			}
			output {
				font-variant-numeric: tabular-nums;
				font-weight: 600;
			}

			.search-wrap {
				position: relative;
			}
			#search-results {
				list-style: none;
				margin: 0.35rem 0 0;
				padding: 0;
				border: 1px solid var(--border);
				border-radius: 6px;
				background: var(--bg);
				max-height: 17rem;
				overflow-y: auto;
				position: absolute;
				left: 0;
				right: 0;
				z-index: 5;
				box-shadow: 0 6px 18px rgb(0 0 0 / 0.14);
			}
			#search-results button {
				display: flex;
				flex-direction: column;
				gap: 0.1rem;
				width: 100%;
				border: 0;
				border-radius: 0;
				background: none;
				text-align: left;
				padding: 0.4rem 0.6rem;
				cursor: pointer;
			}
			#search-results button:hover {
				background: var(--panel);
			}
			#search-results em {
				font-style: normal;
				font-size: 0.72rem;
				color: var(--muted);
			}
			#search-results .empty {
				padding: 0.5rem 0.6rem;
				font-size: 0.78rem;
				color: var(--muted);
			}
			select {
				font: inherit;
				font-size: 0.85rem;
				padding: 0.4rem 0.5rem;
				border: 1px solid var(--border);
				border-radius: 6px;
				background: var(--bg);
				color: var(--fg);
				width: 100%;
			}
			.minor {
				opacity: 0.8;
			}

			#filter-groups {
				display: flex;
				flex-direction: column;
				gap: 0.9rem;
			}
			.group-head {
				display: flex;
				align-items: baseline;
				gap: 0.4rem;
				margin-bottom: 0.15rem;
			}
			.group-head h3 {
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: var(--muted);
				margin: 0;
				flex: 1 1 auto;
				font-weight: 600;
			}
			.group-head .muted {
				text-transform: none;
				letter-spacing: 0;
			}
			button.link {
				border: 0;
				background: none;
				padding: 0;
				font-size: 0.72rem;
				color: var(--muted);
				cursor: pointer;
				text-decoration: underline;
			}
			button.link:hover {
				color: var(--accent);
			}
			.check {
				display: flex;
				align-items: center;
				gap: 0.45rem;
				font-size: 0.82rem;
				margin-top: 0.6rem;
				cursor: pointer;
			}
			/* Role swatches would contradict the nodes when colour encodes region
			   or era, so they're hidden outside role mode. */
			#legend.no-swatch .swatch {
				display: none;
			}

			.legend-item {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.85rem;
				padding: 0.15rem 0;
				cursor: pointer;
			}
			.swatch {
				width: 0.85rem;
				height: 0.85rem;
				border-radius: 50%;
				flex: 0 0 auto;
			}

			.actions {
				display: flex;
				gap: 0.5rem;
			}
			button {
				font: inherit;
				font-size: 0.82rem;
				padding: 0.45rem 0.7rem;
				border: 1px solid var(--border);
				border-radius: 6px;
				background: var(--bg);
				color: var(--fg);
				cursor: pointer;
			}
			button:hover {
				border-color: var(--accent);
			}
			button.running {
				border-color: var(--accent);
				color: var(--accent);
			}

			.details {
				border-top: 1px solid var(--border);
				padding-top: 1rem;
				min-height: 6rem;
			}
			.chips {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
				margin-bottom: 0.5rem;
			}
			.chip {
				font-size: 0.72rem;
				padding: 0.15rem 0.45rem;
				border-radius: 999px;
				border: 1px solid var(--c);
				color: var(--c);
				white-space: nowrap;
			}
			.partners {
				list-style: none;
				margin: 0.5rem 0;
				padding: 0;
				max-height: 15rem;
				overflow-y: auto;
				font-size: 0.82rem;
			}
			.partners li {
				display: flex;
				justify-content: space-between;
				gap: 0.5rem;
				padding: 0.12rem 0;
			}
			.partners button {
				border: 0;
				background: none;
				padding: 0;
				text-align: left;
				color: var(--fg);
				cursor: pointer;
				font-size: inherit;
			}
			.partners button:hover {
				color: var(--accent);
				text-decoration: underline;
			}
			.partners span {
				font-variant-numeric: tabular-nums;
				color: var(--muted);
			}
			.about a {
				color: var(--accent);
			}
			.details a {
				color: var(--accent);
			}

			@media (max-width: 800px) {
				body {
					overflow: auto;
					height: auto;
				}
				.cn-shell {
					grid-template-columns: 1fr;
				}
				.cn-side {
					border-right: 0;
					border-bottom: 1px solid var(--border);
					overflow: visible;
				}
				.cn-main {
					height: 70dvh;
				}
			}
		</style>
	</body>
</html>
