---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Projects that live on this site rather than in a repo, so they aren't in the
// content collection — they're pages, and they link straight to the thing itself.
// Kept out of the collection deliberately: an entry with id "credit-network"
// would collide with the real /projects/credit-network route.
const interactive = [
	{
		href: '/films',
		title: 'Film Log',
		tag: 'live',
		description:
			'My own Letterboxd replacement — diary, watchlist, ratings and stats over TMDB data, ' +
			'built end to end with Claude Code so it does the handful of things I actually wanted ' +
			'and none of the ones I did not.',
	},
	{
		href: '/projects/credit-network',
		title: 'Credit Network',
		tag: 'interactive',
		description:
			'A collaboration graph of actors, directors and composers drawn from ~36,000 TMDB films — ' +
			'force-directed, filterable and draggable.',
	},
];
---

<Layout title="Projects">
	<h1>Projects</h1>
	<ul>
		{
			interactive.map((project) => (
				<li>
					<a href={project.href}>{project.title}</a> <span class="tag">{project.tag}</span>
					<p>{project.description}</p>
				</li>
			))
		}
		{
			projects.map((project) => (
				<li>
					<a href={`/projects/${project.id}`}>{project.data.title}</a>
					<p>{project.data.description}</p>
				</li>
			))
		}
	</ul>
</Layout>

<style>
	.tag {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.05rem 0.4rem;
		opacity: 0.7;
		vertical-align: 0.1em;
	}
</style>
