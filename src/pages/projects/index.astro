---
// Static. The header's "Log in" button is hidden client-side for the owner now
// (see SiteHeader.astro), so this page prerenders to one CDN-served file. The
// project list is a build-time content collection either way.
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Projects that live on this site rather than in a repo, so they aren't in the
// content collection — they're pages, and they link straight to the thing itself.
// Kept out of the collection deliberately: an entry with id "credit-network"
// would collide with the real /projects/credit-network route.
const interactive: {
	href: string;
	title: string;
	tag: string;
	description: string;
	ownerOnly?: boolean;
}[] = [
	{
		// The four logs and their combined calendar are one build, so they read as
		// one project here rather than four rows plus a fifth for the calendar.
		// Links to the month-in-review page, which is where all four meet — the
		// same place the site's own Journal tab points.
		href: '/month',
		title: 'Journal',
		tag: 'live',
		description:
			'My own Letterboxd, Goodreads, restaurant diary and Strava, built end to end with Claude ' +
			'Code — films, books, meals and activities, each logged its own way, then drawn together on ' +
			'one paper calendar where every day is a cluster of what I did, each mark sized by the time it took.',
	},
	{
		href: '/projects/credit-network',
		title: 'Credit Network',
		tag: 'interactive',
		ownerOnly: true,
		description:
			'A collaboration graph of actors, directors and composers drawn from ~36,000 TMDB films — ' +
			'force-directed, filterable and draggable.',
	},
	{
		href: '/subway',
		title: 'Subway Map',
		tag: 'wip',
		description:
			'An interactive MTA map, its geometry generated from the official schematic — click a line ' +
			'to mark it ridden, a station to mark it visited, and watch the coverage add up.',
	},
	{
		href: '/bike-outline',
		title: 'Bike Outline Generator',
		tag: 'interactive',
		ownerOnly: true,
		description:
			'I ride the routes shaped like countries. Load a silhouette, float it over the map as a fixed-size ' +
			'stencil, pan and zoom to drop it on roads you want to ride, and it routes the shape there — ' +
			'clockwise or counter-clockwise — scores how faithfully the roads trace it, and exports a GPX.',
	},
];
---

<Layout title="Projects">
	<h1>Projects</h1>
	<ul>
		{
			interactive.map((project) => (
				<li data-owner-only-nav={project.ownerOnly ? '' : undefined}>
					<a href={project.href}>{project.title}</a> <span class="tag">{project.tag}</span>
					<p>{project.description}</p>
				</li>
			))
		}
		{
			projects.map((project) => (
				<li>
					<a href={`/projects/${project.id}`}>{project.data.title}</a>
					<p>{project.data.description}</p>
				</li>
			))
		}
	</ul>
</Layout>

<style>
	.tag {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.05rem 0.4rem;
		opacity: 0.7;
		vertical-align: 0.1em;
	}
</style>
