---
// Static. The header's "Log in" button is hidden client-side for the owner now
// (see SiteHeader.astro), so this page prerenders to one CDN-served file. The
// project list is a build-time content collection either way.
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Projects that live on this site rather than in a repo, so they aren't in the
// content collection — they're pages, and they link straight to the thing itself.
// Kept out of the collection deliberately: an entry with id "credit-network"
// would collide with the real /projects/credit-network route.
const interactive: {
	href: string;
	title: string;
	tags: string[];
	description: string;
	// Last real work on it. Set by hand: Vercel builds from a shallow clone, so
	// git can't say, and repo-wide sweeps shouldn't count as touching a project.
	date: string;
	ownerOnly?: boolean;
}[] = [
	{
		// The four logs and their combined calendar are one build, so they read as
		// one project here rather than four rows plus a fifth for the calendar.
		// Links to the month-in-review page, which is where all four meet — the
		// same place the site's own Journal tab points.
		href: '/month',
		date: '2026-11-12',
		title: 'Journal',
		tags: ['web', 'data viz'],
		description: 'Films, books, meals and activities, logged and drawn together on one calendar.',
	},
	{
		href: '/projects/credit-network',
		date: '2026-09-16',
		title: 'Credit Network',
		tags: ['data viz', 'film'],
		ownerOnly: true,
		description: 'A collaboration graph of actors, directors and composers across ~36,000 films.',
	},
	{
		href: '/subway',
		date: '2026-10-14',
		title: 'Subway Map',
		tags: ['map', 'transit'],
		description: 'An interactive map for tracking every NYC subway line I’ve ridden and station I’ve visited.',
	},
	{
		href: '/projects/mta-savant',
		date: '2026-11-20',
		title: 'MTA Savant',
		tags: ['data viz', 'transit'],
		description: 'Baseball Savant for NYC transit: percentile rankings for every subway line and bus route.',
	},
	{
		href: '/projects/flight-poster',
		date: '2026-11-22',
		title: 'Flight Poster',
		tags: ['hardware', 'e-ink'],
		description: 'A framed e-ink display that shows a vintage travel poster for the plane flying over my apartment.',
	},
	{
		href: '/bike-outline',
		date: '2026-09-12',
		title: 'Bike Outline Generator',
		tags: ['map', 'cycling'],
		ownerOnly: true,
		description: 'Turns the outline of a country into a bike route on real roads, exported as a GPX.',
	},
];

// Most recently touched first, wherever the project lives.
const projects = [
	...interactive.map((project) => ({ ...project, date: new Date(project.date) })),
	...(await getCollection('projects')).map(({ id, data }) => ({
		href: `/projects/${id}`,
		title: data.title,
		tags: data.tags,
		description: data.description,
		date: data.date,
		ownerOnly: false,
	})),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<Layout title="Projects">
	<h1>Projects</h1>
	<ul>
		{
			projects.map((project) => (
				<li data-owner-only-nav={project.ownerOnly ? '' : undefined}>
					<a href={project.href}>{project.title}</a> {project.tags.map((tag) => <><span class="tag">{tag}</span>{' '}</>)}
					<p>{project.description}</p>
				</li>
			))
		}
	</ul>
</Layout>

<style>
	.tag {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.05rem 0.4rem;
		opacity: 0.7;
		vertical-align: 0.1em;
	}
</style>
