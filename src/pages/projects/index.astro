---
// Static. The header's "Log in" button is hidden client-side for the owner now
// (see SiteHeader.astro), so this page prerenders to one CDN-served file. The
// project list is a build-time content collection either way.
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Projects that live on this site rather than in a repo, so they aren't in the
// content collection — they're pages, and they link straight to the thing itself.
// Kept out of the collection deliberately: an entry with id "credit-network"
// would collide with the real /projects/credit-network route.
const interactive: {
	href: string;
	title: string;
	tag: string;
	description: string;
	// Last real work on it. Set by hand: Vercel builds from a shallow clone, so
	// git can't say, and repo-wide sweeps shouldn't count as touching a project.
	date: string;
	ownerOnly?: boolean;
}[] = [
	{
		// The four logs and their combined calendar are one build, so they read as
		// one project here rather than four rows plus a fifth for the calendar.
		// Links to the month-in-review page, which is where all four meet — the
		// same place the site's own Journal tab points.
		href: '/month',
		date: '2026-11-12',
		title: 'Journal',
		tag: 'live',
		description:
			'My own Letterboxd, Goodreads, restaurant diary and Strava, built end to end with Claude ' +
			'Code — films, books, meals and activities, each logged its own way, then drawn together on ' +
			'one paper calendar where every day is a cluster of what I did, each mark sized by the time it took.',
	},
	{
		href: '/projects/credit-network',
		date: '2026-09-16',
		title: 'Credit Network',
		tag: 'interactive',
		ownerOnly: true,
		description:
			'A collaboration graph of actors, directors and composers drawn from ~36,000 TMDB films — ' +
			'force-directed, filterable and draggable.',
	},
	{
		href: '/subway',
		date: '2026-10-14',
		title: 'Subway Map',
		tag: 'wip',
		description:
			'An interactive MTA map, its geometry generated from the official schematic — click a line ' +
			'to mark it ridden, a station to mark it visited, and watch the coverage add up.',
	},
	{
		href: '/projects/mta-savant',
		date: '2026-11-20',
		title: 'MTA Savant',
		tag: 'data',
		description:
			'Baseball Savant for the subway and buses — every line and route gets a player page of percentile ' +
			'rankings, season-by-season stats and monthly trends, built from the MTA’s open performance data.',
	},
	{
		href: '/projects/flight-poster',
		date: '2026-11-22',
		title: 'Flight Poster',
		tag: 'hardware',
		description:
			'A framed 13.3″ color e-ink poster that shows a vintage travel poster for wherever the plane ' +
			'flying over the apartment is coming from or going to. An ESP32 picks the flight from live ADS-B data.',
	},
	{
		href: '/bike-outline',
		date: '2026-09-12',
		title: 'Bike Outline Generator',
		tag: 'interactive',
		ownerOnly: true,
		description:
			'I ride the routes shaped like countries. Load a silhouette, float it over the map as a fixed-size ' +
			'stencil, pan and zoom to drop it on roads you want to ride, and it routes the shape there — ' +
			'clockwise or counter-clockwise — scores how faithfully the roads trace it, and exports a GPX.',
	},
];

// Most recently touched first, wherever the project lives.
const projects = [
	...interactive.map((project) => ({ ...project, date: new Date(project.date) })),
	...(await getCollection('projects')).map(({ id, data }) => ({
		href: `/projects/${id}`,
		title: data.title,
		tag: undefined,
		description: data.description,
		date: data.date,
		ownerOnly: false,
	})),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<Layout title="Projects">
	<h1>Projects</h1>
	<ul>
		{
			projects.map((project) => (
				<li data-owner-only-nav={project.ownerOnly ? '' : undefined}>
					<a href={project.href}>{project.title}</a> {project.tag && <span class="tag">{project.tag}</span>}
					<p>{project.description}</p>
				</li>
			))
		}
	</ul>
</Layout>

<style>
	.tag {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.05rem 0.4rem;
		opacity: 0.7;
		vertical-align: 0.1em;
	}
</style>
