---
// A route-shape stencil. Load a shape (a country silhouette, or pasted GeoJSON)
// and it floats above the map at a fixed screen size. Pan and zoom the real map
// underneath to place the shape over roads you'd actually ride — the map's zoom
// sets how many km the fixed-size stencil covers. Generate, and the stencil's
// on-screen pixels are unprojected to wherever they sit and routed on real roads
// there, clockwise or counter-clockwise. The maths is in src/lib/bike-route.ts;
// this page is the map, the overlay, and the wiring.
//
// Owner-only. The map and routing are entirely client-side, but the generator
// is admin-only, so the page is server-rendered purely to bounce visitors to
// the login. PUBLIC_MAPTILER_KEY is inlined at build the same as it was read at
// runtime — it is a public, client-visible key already.
import Layout from '../layouts/Layout.astro';
import { PROFILES } from '../lib/bike-route';
import { requireOwner } from '../lib/auth';

export const prerender = false;

if (!(await requireOwner(Astro.cookies))) {
	return Astro.redirect(`/films/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

const key = import.meta.env.PUBLIC_MAPTILER_KEY ?? '';
---

<Layout title="Bike outline generator" wide>
	<h1>Bike outline generator</h1>

	<div class="bo">
		<div class="bo__controls">
			<div class="bo__field">
				<label for="bo-place">Shape</label>
				<div class="bo__row">
					<input id="bo-place" type="text" placeholder="Italy, France, a country…" />
					<button id="bo-load" type="button">Find</button>
				</div>
			</div>

			<details class="bo__geo">
				<summary>…or paste GeoJSON</summary>
				<textarea id="bo-geojson" rows="4" placeholder='{"type":"Polygon","coordinates":[[[…]]]}'></textarea>
				<button id="bo-loadgeo" type="button">Load shape</button>
			</details>

			<details class="bo__geo">
				<summary>…or trace a line drawing</summary>
				<input id="bo-image" type="file" accept="image/*" />
				<div class="bo__field bo__field--inline">
					<label for="bo-threshold">Ink threshold</label>
					<input id="bo-threshold" type="number" min="20" max="250" step="5" value="128" />
				</div>
				<p class="bo__hint">A clean black-on-white sketch traces best. Its strokes ride as one route, backtracking where the drawing forces it.</p>
			</details>

			<div class="bo__field bo__field--inline">
				<label for="bo-direction">Direction</label>
				<select id="bo-direction">
					<option value="cw">Clockwise</option>
					<option value="ccw">Counter-clockwise</option>
				</select>
			</div>

			<div class="bo__field bo__field--inline">
				<label for="bo-spacing">Spacing (km)</label>
				<input id="bo-spacing" type="number" min="0.2" max="200" step="0.5" value="3" />
			</div>

			<div class="bo__field bo__field--inline">
				<label for="bo-profile">Profile</label>
				<select id="bo-profile">
					{PROFILES.map((p) => (
						<option value={p} selected={p === 'fastbike'}>
							{p === 'fastbike' ? 'cycling' : p}
						</option>
					))}
				</select>
			</div>

			<div class="bo__field bo__field--inline">
				<label for="bo-maxscale">Max scale (%)</label>
				<input id="bo-maxscale" type="number" min="0" max="50" step="5" value="15" />
			</div>

			<div class="bo__field bo__field--inline">
				<label for="bo-homepull" title="How strongly the optimizer stays near where you placed the shape. 0 = chase the best road fit anywhere; higher = only move when it clearly helps.">Stay near start</label>
				<input id="bo-homepull" type="number" min="0" max="3" step="0.25" value="0.5" />
			</div>

			<div class="bo__field bo__field--inline">
				<label for="bo-shrink">Spacing shrink</label>
				<input id="bo-shrink" type="number" min="0.5" max="0.95" step="0.05" value="0.85" />
			</div>

			<div class="bo__actions">
				<button id="bo-generate" type="button" disabled>Generate route</button>
				<button id="bo-optimize" type="button" disabled>Optimize</button>
				<button id="bo-export" type="button" disabled>Export GPX</button>
			</div>

			<p id="bo-status" class="bo__status"></p>

			<dl class="bo__stats" id="bo-stats" hidden>
				<div><dt>Distance</dt><dd id="bo-dist">—</dd></div>
				<div><dt>Climb</dt><dd id="bo-climb">—</dd></div>
				<div><dt>Waypoints</dt><dd id="bo-wps">—</dd></div>
				<div><dt>Shape deviation</dt><dd id="bo-dev">—</dd></div>
				<div><dt>Retraced road</dt><dd id="bo-retraced">—</dd></div>
			</dl>
		</div>

		<div class="bo__mapwrap">
			<div id="bo-map" class="bo__map"></div>
			<svg id="bo-stencil" class="bo__stencil" aria-hidden="true"></svg>
			{
				!key && (
					<p class="bo__nokey">
						Basemap needs <code>PUBLIC_MAPTILER_KEY</code>. Routes still draw on bare ground.
					</p>
				)
			}
		</div>
	</div>
</Layout>

<script type="application/json" id="bo-config" set:html={JSON.stringify({ key })} is:inline />

<script>
	import * as maplibregl from 'maplibre-gl';
	import 'maplibre-gl/dist/maplibre-gl.css';
	import maplibreWorkerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';
	maplibregl.setWorkerUrl(maplibreWorkerUrl);
	import { alpineBasemap, bareAlpineGround } from '../lib/activity-map';
	import {
		outerRing,
		normalizeShape,
		orientRing,
		resample,
		deviation,
		toGPX,
		fetchOutline,
		routeWaypoints,
		descend,
		type LngLat,
		type Profile,
	} from '../lib/bike-route';
	import { imageToGraph } from '../lib/line-art';
	import { eulerRoute, type Graph, type Pt } from '../lib/postman';
	import TraceSkeleton from 'skeleton-tracing-wasm';

	const cfg = JSON.parse(document.getElementById('bo-config')!.textContent || '{}') as { key: string };
	const SVGNS = 'http://www.w3.org/2000/svg';
	// The stencil's longer axis is this fraction of the map's shorter side.
	const STENCIL_FRACTION = 0.55;

	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const placeIn = $<HTMLInputElement>('bo-place');
	const geojsonIn = $<HTMLTextAreaElement>('bo-geojson');
	const imageIn = $<HTMLInputElement>('bo-image');
	const thresholdIn = $<HTMLInputElement>('bo-threshold');
	const directionIn = $<HTMLSelectElement>('bo-direction');
	const spacingIn = $<HTMLInputElement>('bo-spacing');
	const profileIn = $<HTMLSelectElement>('bo-profile');
	const scaleIn = $<HTMLInputElement>('bo-maxscale');
	const homePullIn = $<HTMLInputElement>('bo-homepull');
	const shrinkIn = $<HTMLInputElement>('bo-shrink');
	const genBtn = $<HTMLButtonElement>('bo-generate');
	const optBtn = $<HTMLButtonElement>('bo-optimize');
	const exportBtn = $<HTMLButtonElement>('bo-export');
	const statusEl = $<HTMLParagraphElement>('bo-status');
	const statsEl = $<HTMLElement>('bo-stats');
	const mapEl = $<HTMLElement>('bo-map');
	const stencilEl = document.getElementById('bo-stencil') as unknown as SVGSVGElement;

	// The loaded shape as one or more normalized paths (a country is a single
	// closed ring; a line drawing is many strokes). Null until a shape loads.
	let shapePaths: Pt[][] | null = null;
	// For a line drawing, its graph in normalized coords — the strokes and how they
	// join — which the route inspector orders into one rideable trail. Null for a
	// country (a country is already a single loop, so it needs no ordering).
	let lineGraph: Graph | null = null;
	let name = 'outline';
	let routeCoords: LngLat[] = [];

	function status(msg: string, kind: 'info' | 'error' | 'busy' = 'info') {
		statusEl.textContent = msg;
		statusEl.dataset.kind = kind;
	}

	const map = new maplibregl.Map({
		container: mapEl,
		style: cfg.key
			? (alpineBasemap(cfg.key) as maplibregl.StyleSpecification)
			: (bareAlpineGround() as maplibregl.StyleSpecification),
		center: [-73.97, 40.75],
		zoom: 10,
		attributionControl: { compact: true },
		dragRotate: false,
		pitchWithRotate: false,
		touchPitch: false,
	});
	map.touchZoomRotate.disableRotation();
	map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
	// Dev-only handle so the page can be driven from a screenshot script; the
	// `import.meta.env.DEV` guard dead-code-eliminates it from the production build.
	if (import.meta.env.DEV) (window as any).__map = map;
	map.on('error', (e) => console.warn('bike-outline map:', e.error?.message ?? 'tile/style request failed'));

	function whenReady(fn: () => void) {
		if (map.isStyleLoaded()) fn();
		else map.once('styledata', fn);
	}

	// --- the fixed-screen stencil -------------------------------------------

	/** A normalized point → map-container pixel at the current stencil size. */
	function normToPx([nx, ny]: Pt): [number, number] {
		const w = mapEl.clientWidth, h = mapEl.clientHeight;
		const scale = STENCIL_FRACTION * Math.min(w, h);
		return [w / 2 + nx * scale, h / 2 + ny * scale];
	}

	/** Every stencil path in map-container pixels. The overlay and generate both
	 *  read this, so what you see is what gets placed. */
	function stencilPaths(): [number, number][][] {
		return shapePaths ? shapePaths.map((path) => path.map(normToPx)) : [];
	}

	function drawStencil() {
		stencilEl.replaceChildren();
		if (!shapePaths) return;
		const paths = stencilPaths();
		for (const px of paths) {
			const poly = document.createElementNS(SVGNS, 'polyline');
			poly.setAttribute('points', px.map((p) => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(' '));
			poly.setAttribute('class', 'bo__stencil-shape');
			stencilEl.appendChild(poly);
		}
		// A dot at the first vertex of the first path — where the ride starts.
		const first = paths[0]?.[0];
		if (first) {
			const dot = document.createElementNS(SVGNS, 'circle');
			dot.setAttribute('cx', first[0].toFixed(1));
			dot.setAttribute('cy', first[1].toFixed(1));
			dot.setAttribute('r', '5');
			dot.setAttribute('class', 'bo__stencil-start');
			stencilEl.appendChild(dot);
		}
	}

	// Keep the stencil the same screen size and centred as the map resizes.
	if (typeof ResizeObserver !== 'undefined') new ResizeObserver(drawStencil).observe(mapEl);

	// --- the generated route (a real map layer, moves with the map) ----------

	function setRoute(coords: LngLat[]) {
		const data = {
			type: 'Feature' as const,
			geometry: { type: 'LineString' as const, coordinates: coords },
			properties: {},
		} as maplibregl.GeoJSONSourceSpecification['data'];
		const src = map.getSource('route') as maplibregl.GeoJSONSource | undefined;
		if (src) src.setData(data);
		else {
			map.addSource('route', { type: 'geojson', data });
			map.addLayer({
				id: 'bo-route',
				type: 'line',
				source: 'route',
				layout: { 'line-cap': 'round', 'line-join': 'round' },
				paint: { 'line-color': '#1c6e8c', 'line-width': 3.2 },
			});
		}
	}

	// The nudged outline from a descent, drawn as a faint dashed layer so you can
	// see where the stencil was pulled to. Empty coords clear it.
	function setOutline(coords: LngLat[]) {
		const data = {
			type: 'Feature' as const,
			geometry: { type: 'LineString' as const, coordinates: coords },
			properties: {},
		} as maplibregl.GeoJSONSourceSpecification['data'];
		const src = map.getSource('outline') as maplibregl.GeoJSONSource | undefined;
		if (src) src.setData(data);
		else {
			map.addSource('outline', { type: 'geojson', data });
			map.addLayer({
				id: 'bo-outline',
				type: 'line',
				source: 'outline',
				layout: { 'line-cap': 'round', 'line-join': 'round' },
				paint: { 'line-color': '#8c4a2f', 'line-width': 1.5, 'line-dasharray': [3, 2], 'line-opacity': 0.7 },
			});
		}
	}

	/** A normalized point unprojected to where it now sits on the map. */
	function normToLngLat(p: Pt): LngLat {
		const ll = map.unproject(normToPx(p) as maplibregl.PointLike);
		return [ll.lng, ll.lat];
	}

	// The ordered geographic path both Generate and Optimize start from, for the
	// shape at its current placement. A country: the single ring, wound cw/ccw. A
	// line drawing: its strokes unprojected into a graph, then ordered by the route
	// inspector into one trail that covers every stroke with the least backtracking.
	// `close` says whether the path loops (a country) or runs end to end (a trail);
	// `doubled` is the trail's planned backtracking length, in degrees (0 for a ring).
	function placedPath(): { path: LngLat[]; close: boolean; doubled: number } {
		if (lineGraph) {
			const g: Graph = {
				nodes: lineGraph.nodes.map(normToLngLat),
				edges: lineGraph.edges.map((e) => ({ a: e.a, b: e.b, pts: e.pts.map(normToLngLat) })),
			};
			const { path, doubled } = eulerRoute(g);
			return { path, close: false, doubled };
		}
		const ring = orientRing(stencilPaths()[0].map((p) => {
			const ll = map.unproject(p as maplibregl.PointLike);
			return [ll.lng, ll.lat] as LngLat;
		}), directionIn.value === 'cw');
		return { path: ring, close: true, doubled: 0 };
	}

	// Fill the stats panel from a routed result against its waypoints.
	function showStats(waypoints: LngLat[], routed: Awaited<ReturnType<typeof routeWaypoints>>) {
		const dev = deviation(routed.coords, waypoints);
		$('bo-dist').textContent = `${(routed.length / 1000).toFixed(1)} km`;
		$('bo-climb').textContent = routed.ascend != null ? `${routed.ascend.toLocaleString()} m` : '—';
		$('bo-wps').textContent = String(waypoints.length);
		$('bo-dev').textContent = `${(dev.mean / 1000).toFixed(2)} km avg · ${(dev.max / 1000).toFixed(2)} km max`;
		$('bo-retraced').textContent = `${(routed.retraced * 100).toFixed(1)}%`;
		statsEl.hidden = false;
	}

	// --- load a shape --------------------------------------------------------

	// Common tail of loading any shape: draw it, enable the buttons, clear the map.
	function afterLoad(label: string) {
		name = label;
		drawStencil();
		genBtn.disabled = false;
		optBtn.disabled = false;
		exportBtn.disabled = true;
		statsEl.hidden = true;
		routeCoords = [];
		whenReady(() => {
			setRoute([]); // clear any previous route
			setOutline([]);
		});
		status('Pan and zoom the map to place the shape, then generate.');
	}

	function loadRing(ring: LngLat[], label: string) {
		shapePaths = [normalizeShape(ring)];
		lineGraph = null; // a country is a single loop — no ordering needed
		afterLoad(label);
	}

	// A line drawing: sanitize and vectorize the image into a stroke graph, place
	// it like a country. Heavy work (the WASM tracer) loads lazily on first use.
	let tracerPromise: ReturnType<typeof TraceSkeleton.load> | null = null;
	async function loadImage(file: File) {
		const bitmap = await createImageBitmap(file);
		// Cap the raster the tracer sees — skeleton tracing a huge image is slow and
		// buys no detail a rideable route can use. Longest side to ~500px.
		const cap = 500;
		const s = Math.min(1, cap / Math.max(bitmap.width, bitmap.height));
		const w = Math.max(1, Math.round(bitmap.width * s)), h = Math.max(1, Math.round(bitmap.height * s));
		const canvas = document.createElement('canvas');
		canvas.width = w; canvas.height = h;
		const ctx = canvas.getContext('2d')!;
		ctx.drawImage(bitmap, 0, 0, w, h);
		const img = ctx.getImageData(0, 0, w, h);
		const tracer = await (tracerPromise ??= TraceSkeleton.load());
		const threshold = Math.min(250, Math.max(20, Number(thresholdIn.value) || 128));
		const { graph, paths } = imageToGraph(img, tracer, { threshold });
		shapePaths = paths;
		lineGraph = graph;
		afterLoad(file.name.replace(/\.[^.]+$/, '') || 'drawing');
		status(`${graph.edges.length} strokes traced. Pan and zoom to place, then generate.`);
	}

	$<HTMLButtonElement>('bo-load').addEventListener('click', async () => {
		const q = placeIn.value.trim();
		if (!q) return;
		status(`Looking up “${q}”…`, 'busy');
		try {
			const outline = await fetchOutline(q);
			loadRing(outline.ring, outline.name);
		} catch (err) {
			status(err instanceof Error ? err.message : 'Lookup failed.', 'error');
		}
	});
	placeIn.addEventListener('keydown', (e) => {
		if (e.key === 'Enter') $<HTMLButtonElement>('bo-load').click();
	});

	$<HTMLButtonElement>('bo-loadgeo').addEventListener('click', () => {
		try {
			loadRing(outerRing(JSON.parse(geojsonIn.value)) as LngLat[], 'outline');
		} catch (err) {
			status(err instanceof Error ? err.message : 'That is not valid GeoJSON.', 'error');
		}
	});

	imageIn.addEventListener('change', async () => {
		const file = imageIn.files?.[0];
		if (!file) return;
		status(`Tracing “${file.name}”…`, 'busy');
		try {
			await loadImage(file);
		} catch (err) {
			status(err instanceof Error ? err.message : 'Could not trace that image.', 'error');
		}
	});

	// --- generate the route where the stencil sits ---------------------------

	genBtn.addEventListener('click', async () => {
		if (!shapePaths) return;
		const { path, close } = placedPath();
		const spacingKm = Math.max(0.2, Number(spacingIn.value) || 3);
		const waypoints = resample(path, spacingKm * 1000, close);
		status(`Routing ${waypoints.length} waypoints on real roads…`, 'busy');
		genBtn.disabled = true;
		optBtn.disabled = true;
		setOutline([]); // this is a fresh manual placement, not a descent
		try {
			// A line drawing's route plans its backtracking, so don't strip retracing.
			const routed = await routeWaypoints(waypoints, profileIn.value as Profile, close);
			routeCoords = routed.coords;
			setRoute(routeCoords);
			showStats(waypoints, routed);
			exportBtn.disabled = false;
			status('Route placed. Reposition and generate again, or export.');
		} catch (err) {
			status(err instanceof Error ? err.message : 'Routing failed.', 'error');
		} finally {
			genBtn.disabled = false;
			optBtn.disabled = false;
		}
	});

	// --- descend: fit the outline to the roads, tightening spacing each round ---

	// The finest spacing the descent will try (km). It also stops on its own when
	// a finer step would exceed the router's waypoint budget.
	const MIN_SPACING_KM = 0.5;

	optBtn.addEventListener('click', async () => {
		if (!shapePaths) return;
		const { path, close } = placedPath();
		const startKm = Math.max(0.2, Number(spacingIn.value) || 3);
		const maxScale = Math.min(0.5, Math.max(0, (Number(scaleIn.value) || 15) / 100));
		const homePull = Math.max(0, Number(homePullIn.value) || 0);
		genBtn.disabled = true;
		optBtn.disabled = true;
		try {
			const best = await descend(path, (wps) => routeWaypoints(wps, profileIn.value as Profile, close), {
				startSpacing: startKm * 1000,
				minSpacing: MIN_SPACING_KM * 1000,
				maxScale,
				homePull,
				close,
				shrink: Math.min(0.95, Math.max(0.5, Number(shrinkIn.value) || 0.85)),
				onRound: (r) => {
					// Draw each accepted move as it lands so the search is watchable.
					setOutline(r.ring);
					setRoute(r.routed.coords);
					status(
						`Round ${r.round + 1}: ${r.spacingKm.toFixed(1)} km spacing, ` +
							`${r.waypoints} wps, scale ${(r.scale * 100).toFixed(0)}%, ` +
							`deviation ${(r.meanDev / 1000).toFixed(2)} km avg…`,
						'busy',
					);
				},
			});
			routeCoords = best.routed.coords;
			setOutline(best.ring);
			setRoute(routeCoords);
			showStats(best.waypoints, best.routed);
			spacingIn.value = (best.spacing / 1000).toFixed(1);
			exportBtn.disabled = false;
			status(
				`Settled after ${best.rounds} moves at ${(best.spacing / 1000).toFixed(1)} km spacing, ` +
					`scale ${(best.scale * 100).toFixed(0)}%.`,
			);
		} catch (err) {
			status(err instanceof Error ? err.message : 'Optimization failed.', 'error');
		} finally {
			genBtn.disabled = false;
			optBtn.disabled = false;
		}
	});

	// --- export --------------------------------------------------------------

	exportBtn.addEventListener('click', () => {
		if (routeCoords.length < 2) return;
		const gpx = toGPX(routeCoords, `${name} outline ride`);
		const a = document.createElement('a');
		a.href = URL.createObjectURL(new Blob([gpx], { type: 'application/gpx+xml' }));
		a.download = `${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-outline.gpx`;
		a.click();
		URL.revokeObjectURL(a.href);
	});
</script>

<style>
	h1 {
		margin-bottom: 1rem;
	}
	.bo {
		display: grid;
		grid-template-columns: 300px minmax(0, 1fr);
		gap: 1.5rem;
		align-items: start;
	}
	@media (max-width: 820px) {
		.bo {
			grid-template-columns: 1fr;
		}
	}

	.bo__controls {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-family: var(--sans);
		font-size: 0.9rem;
	}
	.bo__field {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.bo__field--inline {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}
	.bo__controls label {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--ink-soft);
	}
	.bo__row {
		display: flex;
		gap: 0.4rem;
	}
	.bo__row input {
		flex: 1;
		min-width: 0;
	}
	input,
	select,
	textarea,
	button {
		font: inherit;
		color: var(--ink);
		background: var(--card);
		border: 1px solid var(--rule);
		border-radius: 4px;
		padding: 0.4rem 0.55rem;
	}
	.bo__field--inline input,
	.bo__field--inline select {
		width: 52%;
	}
	button {
		cursor: pointer;
		background: var(--accent-bg);
		font-weight: 600;
	}
	button:hover {
		border-color: var(--accent);
	}
	button:disabled {
		opacity: 0.5;
		cursor: default;
	}
	.bo__geo summary {
		cursor: pointer;
		color: var(--ink-soft);
		font-size: 0.8rem;
	}
	.bo__geo textarea {
		width: 100%;
		margin: 0.5rem 0;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.75rem;
		resize: vertical;
	}
	.bo__geo button {
		width: 100%;
	}
