---
// A route-shape stencil. Load a shape (a country silhouette, or pasted GeoJSON)
// and it floats above the map at a fixed screen size. Pan and zoom the real map
// underneath to place the shape over roads you'd actually ride — the map's zoom
// sets how many km the fixed-size stencil covers. Generate, and the stencil's
// on-screen pixels are unprojected to wherever they sit and routed on real roads
// there, clockwise or counter-clockwise. The maths is in src/lib/bike-route.ts;
// this page is the map, the overlay, and the wiring.
//
// Server-rendered so the header's owner check runs per-request, not at build.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { PROFILES } from '../lib/bike-route';

const key = import.meta.env.PUBLIC_MAPTILER_KEY ?? '';
---

<Layout title="Bike outline generator" wide>
	<h1>Bike outline generator</h1>

	<div class="bo">
		<div class="bo__controls">
			<div class="bo__field">
				<label for="bo-place">Shape</label>
				<div class="bo__row">
					<input id="bo-place" type="text" placeholder="Italy, France, a country…" />
					<button id="bo-load" type="button">Find</button>
				</div>
			</div>

			<details class="bo__geo">
				<summary>…or paste GeoJSON</summary>
				<textarea id="bo-geojson" rows="4" placeholder='{"type":"Polygon","coordinates":[[[…]]]}'></textarea>
				<button id="bo-loadgeo" type="button">Load shape</button>
			</details>

			<div class="bo__field bo__field--inline">
				<label for="bo-direction">Direction</label>
				<select id="bo-direction">
					<option value="cw">Clockwise</option>
					<option value="ccw">Counter-clockwise</option>
				</select>
			</div>

			<div class="bo__field bo__field--inline">
				<label for="bo-spacing">Spacing (km)</label>
				<input id="bo-spacing" type="number" min="0.2" max="200" step="0.5" value="3" />
			</div>

			<div class="bo__field bo__field--inline">
				<label for="bo-profile">Profile</label>
				<select id="bo-profile">
					{PROFILES.map((p) => <option value={p}>{p}</option>)}
				</select>
			</div>

			<div class="bo__actions">
				<button id="bo-generate" type="button" disabled>Generate route</button>
				<button id="bo-export" type="button" disabled>Export GPX</button>
			</div>

			<p id="bo-status" class="bo__status"></p>

			<dl class="bo__stats" id="bo-stats" hidden>
				<div><dt>Distance</dt><dd id="bo-dist">—</dd></div>
				<div><dt>Climb</dt><dd id="bo-climb">—</dd></div>
				<div><dt>Waypoints</dt><dd id="bo-wps">—</dd></div>
				<div><dt>Shape deviation</dt><dd id="bo-dev">—</dd></div>
			</dl>
		</div>

		<div class="bo__mapwrap">
			<div id="bo-map" class="bo__map"></div>
			<svg id="bo-stencil" class="bo__stencil" aria-hidden="true"></svg>
			{
				!key && (
					<p class="bo__nokey">
						Basemap needs <code>PUBLIC_MAPTILER_KEY</code>. Routes still draw on bare ground.
					</p>
				)
			}
		</div>
	</div>
</Layout>

<script type="application/json" id="bo-config" set:html={JSON.stringify({ key })} is:inline />

<script>
	import * as maplibregl from 'maplibre-gl';
	import 'maplibre-gl/dist/maplibre-gl.css';
	import maplibreWorkerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';
	maplibregl.setWorkerUrl(maplibreWorkerUrl);
	import { alpineBasemap, bareAlpineGround } from '../lib/activity-map';
	import {
		outerRing,
		normalizeShape,
		orientRing,
		resample,
		deviation,
		toGPX,
		fetchOutline,
		routeWaypoints,
		type LngLat,
		type Profile,
	} from '../lib/bike-route';

	const cfg = JSON.parse(document.getElementById('bo-config')!.textContent || '{}') as { key: string };
	const SVGNS = 'http://www.w3.org/2000/svg';
	// The stencil's longer axis is this fraction of the map's shorter side.
	const STENCIL_FRACTION = 0.55;

	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const placeIn = $<HTMLInputElement>('bo-place');
	const geojsonIn = $<HTMLTextAreaElement>('bo-geojson');
	const directionIn = $<HTMLSelectElement>('bo-direction');
	const spacingIn = $<HTMLInputElement>('bo-spacing');
	const profileIn = $<HTMLSelectElement>('bo-profile');
	const genBtn = $<HTMLButtonElement>('bo-generate');
	const exportBtn = $<HTMLButtonElement>('bo-export');
	const statusEl = $<HTMLParagraphElement>('bo-status');
	const statsEl = $<HTMLElement>('bo-stats');
	const mapEl = $<HTMLElement>('bo-map');
	const stencilEl = document.getElementById('bo-stencil') as unknown as SVGSVGElement;

	// The loaded shape, normalized to a centred unit box (null until one loads).
	let shapeNorm: [number, number][] | null = null;
	let name = 'outline';
	let routeCoords: LngLat[] = [];

	function status(msg: string, kind: 'info' | 'error' | 'busy' = 'info') {
		statusEl.textContent = msg;
		statusEl.dataset.kind = kind;
	}

	const map = new maplibregl.Map({
		container: mapEl,
		style: cfg.key
			? (alpineBasemap(cfg.key) as maplibregl.StyleSpecification)
			: (bareAlpineGround() as maplibregl.StyleSpecification),
		center: [-73.97, 40.75],
		zoom: 10,
		attributionControl: { compact: true },
		dragRotate: false,
		pitchWithRotate: false,
		touchPitch: false,
	});
	map.touchZoomRotate.disableRotation();
	map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
	// Dev-only handle so the page can be driven from a screenshot script; the
	// `import.meta.env.DEV` guard dead-code-eliminates it from the production build.
	if (import.meta.env.DEV) (window as any).__map = map;
	map.on('error', (e) => console.warn('bike-outline map:', e.error?.message ?? 'tile/style request failed'));

	function whenReady(fn: () => void) {
		if (map.isStyleLoaded()) fn();
		else map.once('styledata', fn);
	}

	// --- the fixed-screen stencil -------------------------------------------

	/** The stencil's vertices in map-container pixels, at the current size. The
	 *  overlay and generate both read this, so what you see is what gets placed. */
	function stencilPixels(): [number, number][] {
		if (!shapeNorm) return [];
		const w = mapEl.clientWidth, h = mapEl.clientHeight;
		const scale = STENCIL_FRACTION * Math.min(w, h);
		return shapeNorm.map(([nx, ny]) => [w / 2 + nx * scale, h / 2 + ny * scale]);
	}

	function drawStencil() {
		stencilEl.replaceChildren();
		if (!shapeNorm) return;
		const px = stencilPixels();
		const poly = document.createElementNS(SVGNS, 'polygon');
		poly.setAttribute('points', px.map((p) => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(' '));
		poly.setAttribute('class', 'bo__stencil-shape');
		stencilEl.appendChild(poly);
		// A dot at the first vertex — where the ride starts.
		const dot = document.createElementNS(SVGNS, 'circle');
		dot.setAttribute('cx', px[0][0].toFixed(1));
		dot.setAttribute('cy', px[0][1].toFixed(1));
		dot.setAttribute('r', '5');
		dot.setAttribute('class', 'bo__stencil-start');
		stencilEl.appendChild(dot);
	}

	// Keep the stencil the same screen size and centred as the map resizes.
	if (typeof ResizeObserver !== 'undefined') new ResizeObserver(drawStencil).observe(mapEl);

	// --- the generated route (a real map layer, moves with the map) ----------

	function setRoute(coords: LngLat[]) {
		const data = {
			type: 'Feature' as const,
			geometry: { type: 'LineString' as const, coordinates: coords },
			properties: {},
		} as maplibregl.GeoJSONSourceSpecification['data'];
		const src = map.getSource('route') as maplibregl.GeoJSONSource | undefined;
		if (src) src.setData(data);
		else {
			map.addSource('route', { type: 'geojson', data });
			map.addLayer({
				id: 'bo-route',
				type: 'line',
				source: 'route',
				layout: { 'line-cap': 'round', 'line-join': 'round' },
				paint: { 'line-color': '#1c6e8c', 'line-width': 3.2 },
			});
		}
	}

	// --- load a shape --------------------------------------------------------

	function loadRing(ring: LngLat[], label: string) {
		shapeNorm = normalizeShape(ring);
		name = label;
		drawStencil();
		genBtn.disabled = false;
		exportBtn.disabled = true;
		statsEl.hidden = true;
		routeCoords = [];
		whenReady(() => setRoute([])); // clear any previous route
		status('Pan and zoom the map to place the shape, then generate.');
	}

	$<HTMLButtonElement>('bo-load').addEventListener('click', async () => {
		const q = placeIn.value.trim();
		if (!q) return;
		status(`Looking up “${q}”…`, 'busy');
		try {
			const outline = await fetchOutline(q);
			loadRing(outline.ring, outline.name);
		} catch (err) {
			status(err instanceof Error ? err.message : 'Lookup failed.', 'error');
		}
	});
	placeIn.addEventListener('keydown', (e) => {
		if (e.key === 'Enter') $<HTMLButtonElement>('bo-load').click();
	});

	$<HTMLButtonElement>('bo-loadgeo').addEventListener('click', () => {
		try {
			loadRing(outerRing(JSON.parse(geojsonIn.value)) as LngLat[], 'outline');
		} catch (err) {
			status(err instanceof Error ? err.message : 'That is not valid GeoJSON.', 'error');
		}
	});

	// --- generate the route where the stencil sits ---------------------------

	genBtn.addEventListener('click', async () => {
		if (!shapeNorm) return;
		// Unproject the stencil's on-screen pixels to where they now sit on the map.
		const placed = stencilPixels().map((p) => {
			const ll = map.unproject(p as maplibregl.PointLike);
			return [ll.lng, ll.lat] as LngLat;
		});
		const ring = orientRing(placed, directionIn.value === 'cw');
		const spacingKm = Math.max(0.2, Number(spacingIn.value) || 3);
		const waypoints = resample(ring, spacingKm * 1000);
		status(`Routing ${waypoints.length} waypoints on real roads…`, 'busy');
		genBtn.disabled = true;
		try {
			const routed = await routeWaypoints(waypoints, profileIn.value as Profile);
			routeCoords = routed.coords;
			setRoute(routeCoords);
			const dev = deviation(routeCoords, waypoints);
			$('bo-dist').textContent = `${(routed.length / 1000).toFixed(1)} km`;
			$('bo-climb').textContent = routed.ascend != null ? `${routed.ascend.toLocaleString()} m` : '—';
			$('bo-wps').textContent = String(waypoints.length);
			$('bo-dev').textContent = `${(dev.mean / 1000).toFixed(2)} km avg · ${(dev.max / 1000).toFixed(2)} km max`;
			statsEl.hidden = false;
			exportBtn.disabled = false;
			status('Route placed. Reposition and generate again, or export.');
		} catch (err) {
			status(err instanceof Error ? err.message : 'Routing failed.', 'error');
		} finally {
			genBtn.disabled = false;
		}
	});

	// --- export --------------------------------------------------------------

	exportBtn.addEventListener('click', () => {
		if (routeCoords.length < 2) return;
		const gpx = toGPX(routeCoords, `${name} outline ride`);
		const a = document.createElement('a');
		a.href = URL.createObjectURL(new Blob([gpx], { type: 'application/gpx+xml' }));
		a.download = `${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-outline.gpx`;
		a.click();
		URL.revokeObjectURL(a.href);
	});
</script>

<style>
	h1 {
		margin-bottom: 1rem;
	}
	.bo {
		display: grid;
		grid-template-columns: 300px minmax(0, 1fr);
		gap: 1.5rem;
		align-items: start;
	}
	@media (max-width: 820px) {
		.bo {
			grid-template-columns: 1fr;
		}
	}

	.bo__controls {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-family: var(--sans);
		font-size: 0.9rem;
	}
	.bo__field {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.bo__field--inline {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}
	.bo__controls label {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--ink-soft);
	}
	.bo__row {
		display: flex;
		gap: 0.4rem;
	}
	.bo__row input {
		flex: 1;
		min-width: 0;
	}
	input,
	select,
	textarea,
	button {
		font: inherit;
		color: var(--ink);
		background: var(--card);
		border: 1px solid var(--rule);
		border-radius: 4px;
		padding: 0.4rem 0.55rem;
	}
	.bo__field--inline input,
	.bo__field--inline select {
		width: 52%;
	}
	button {
		cursor: pointer;
		background: var(--accent-bg);
		font-weight: 600;
	}
	button:hover {
		border-color: var(--accent);
	}
	button:disabled {
		opacity: 0.5;
		cursor: default;
	}
	.bo__geo summary {
		cursor: pointer;
		color: var(--ink-soft);
		font-size: 0.8rem;
	}
	.bo__geo textarea {
		width: 100%;
		margin: 0.5rem 0;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.75rem;
		resize: vertical;
	}
	.bo__geo button {
		width: 100%;
	}
	.bo__actions {
		display: flex;
		gap: 0.5rem;
	}
	.bo__actions button {
		flex: 1;
	}
	.bo__status {
		margin: 0;
		font-size: 0.82rem;
		min-height: 1.2em;
		color: var(--ink-soft);
	}
	.bo__status[data-kind='error'] {
		color: var(--accent);
	}
	.bo__stats {
		margin: 0;
		display: grid;
		gap: 0.6rem;
		border-top: 1px solid var(--rule);
		padding-top: 0.9rem;
	}
	.bo__stats[hidden] {
		display: none;
	}
	.bo__stats div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}
	.bo__stats dt {
		color: var(--ink-soft);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.bo__stats dd {
		margin: 0;
		font-weight: 600;
	}

	.bo__mapwrap {
		position: relative;
		border: 1px solid var(--rule);
		border-radius: 8px;
		overflow: hidden;
	}
	.bo__map {
		height: min(72vh, 640px);
		min-height: 400px;
	}
	/* The stencil floats over the map, fixed in screen space — clicks pass
	   through so the map underneath stays draggable. */
	.bo__stencil {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 2;
	}
	:global(.bo__stencil-shape) {
		fill: rgba(140, 74, 47, 0.1);
		stroke: #8c4a2f;
		stroke-width: 2;
		stroke-dasharray: 6 4;
	}
	:global(.bo__stencil-start) {
		fill: #8c4a2f;
		stroke: #fbf9f4;
		stroke-width: 2;
	}
	.bo__nokey {
		position: absolute;
		left: 50%;
		top: 12px;
		transform: translateX(-50%);
		margin: 0;
		z-index: 3;
		font-family: var(--sans);
		font-size: 12px;
		color: var(--ink-soft);
		background: rgba(251, 249, 244, 0.94);
		border: 1px solid var(--rule);
		border-radius: 6px;
		padding: 6px 10px;
	}
	.bo__nokey code {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
	}
</style>
