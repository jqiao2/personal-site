---
// Ride the outline of any shape. Pick a place (or paste GeoJSON), and the page
// samples its border, routes the samples along real rideable roads via BRouter,
// and hands back a GPX in the shape of the thing. All the geometry and routing
// lives in src/lib/bike-route.ts; this page is the map and the wiring.
//
// Server-rendered so the header's owner check runs per-request, not at build.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { PROFILES } from '../lib/bike-route';

const key = import.meta.env.PUBLIC_MAPTILER_KEY ?? '';
---

<Layout title="Bike outline generator" wide>
	<h1>Bike outline generator</h1>

	<div class="bo">
		<div class="bo__controls">
			<div class="bo__field">
				<label for="bo-place">Place</label>
				<div class="bo__row">
					<input id="bo-place" type="text" placeholder="Portugal, Central Park, Lake Como…" />
					<button id="bo-load" type="button">Find</button>
				</div>
			</div>

			<details class="bo__geo">
				<summary>…or paste GeoJSON</summary>
				<textarea id="bo-geojson" rows="4" placeholder='{"type":"Polygon","coordinates":[[[…]]]}'></textarea>
				<button id="bo-loadgeo" type="button">Load shape</button>
			</details>

			<div class="bo__field bo__field--inline">
				<label for="bo-spacing">Spacing (km)</label>
				<input id="bo-spacing" type="number" min="1" max="200" step="1" value="8" />
			</div>

			<div class="bo__field bo__field--inline">
				<label for="bo-profile">Profile</label>
				<select id="bo-profile">
					{PROFILES.map((p) => <option value={p}>{p}</option>)}
				</select>
			</div>

			<div class="bo__actions">
				<button id="bo-generate" type="button" disabled>Generate route</button>
				<button id="bo-export" type="button" disabled>Export GPX</button>
			</div>

			<p id="bo-status" class="bo__status"></p>

			<dl class="bo__stats" id="bo-stats" hidden>
				<div><dt>Distance</dt><dd id="bo-dist">—</dd></div>
				<div><dt>Climb</dt><dd id="bo-climb">—</dd></div>
				<div><dt>Waypoints</dt><dd id="bo-wps">—</dd></div>
				<div><dt>Border deviation</dt><dd id="bo-dev">—</dd></div>
			</dl>
		</div>

		<div class="bo__mapwrap">
			<div id="bo-map" class="bo__map"></div>
			{
				!key && (
					<p class="bo__nokey">
						Basemap needs <code>PUBLIC_MAPTILER_KEY</code>. Routes still draw on bare ground.
					</p>
				)
			}
		</div>
	</div>
</Layout>

<script type="application/json" id="bo-config" set:html={JSON.stringify({ key })} is:inline />

<script>
	import * as maplibregl from 'maplibre-gl';
	import 'maplibre-gl/dist/maplibre-gl.css';
	import maplibreWorkerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';
	maplibregl.setWorkerUrl(maplibreWorkerUrl);
	import { alpineBasemap, bareAlpineGround } from '../lib/activity-map';
	import {
		outerRing,
		resample,
		deviation,
		toGPX,
		fetchOutline,
		routeWaypoints,
		type LngLat,
		type Profile,
	} from '../lib/bike-route';

	const cfg = JSON.parse(document.getElementById('bo-config')!.textContent || '{}') as { key: string };

	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const placeIn = $<HTMLInputElement>('bo-place');
	const geojsonIn = $<HTMLTextAreaElement>('bo-geojson');
	const spacingIn = $<HTMLInputElement>('bo-spacing');
	const profileIn = $<HTMLSelectElement>('bo-profile');
	const genBtn = $<HTMLButtonElement>('bo-generate');
	const exportBtn = $<HTMLButtonElement>('bo-export');
	const statusEl = $<HTMLParagraphElement>('bo-status');
	const statsEl = $<HTMLElement>('bo-stats');

	let geometry: unknown = null;
	let name = 'outline';
	let routeCoords: LngLat[] = [];

	function status(msg: string, kind: 'info' | 'error' | 'busy' = 'info') {
		statusEl.textContent = msg;
		statusEl.dataset.kind = kind;
	}

	const map = new maplibregl.Map({
		container: 'bo-map',
		style: cfg.key
			? (alpineBasemap(cfg.key) as maplibregl.StyleSpecification)
			: (bareAlpineGround() as maplibregl.StyleSpecification),
		center: [10, 48],
		zoom: 3.5,
		attributionControl: { compact: true },
		dragRotate: false,
		pitchWithRotate: false,
		touchPitch: false,
	});
	map.touchZoomRotate.disableRotation();
	map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
	map.on('error', (e) => console.warn('bike-outline map:', e.error?.message ?? 'tile/style request failed'));

	function whenReady(fn: () => void) {
		if (map.isStyleLoaded()) fn();
		else map.once('styledata', fn);
	}

	function line(coords: LngLat[]) {
		return { type: 'Feature' as const, geometry: { type: 'LineString' as const, coordinates: coords }, properties: {} };
	}

	function setSource(id: string, coords: LngLat[]) {
		const data = line(coords) as maplibregl.GeoJSONSourceSpecification['data'];
		const src = map.getSource(id) as maplibregl.GeoJSONSource | undefined;
		if (src) src.setData(data);
		else map.addSource(id, { type: 'geojson', data });
	}

	function drawLayers() {
		if (!map.getLayer('bo-outline')) {
			map.addLayer({
				id: 'bo-outline',
				type: 'line',
				source: 'outline',
				layout: { 'line-cap': 'round', 'line-join': 'round' },
				paint: { 'line-color': '#8c4a2f', 'line-width': 1.5, 'line-dasharray': [2, 2], 'line-opacity': 0.7 },
			});
		}
		if (!map.getLayer('bo-route')) {
			map.addLayer({
				id: 'bo-route',
				type: 'line',
				source: 'route',
				layout: { 'line-cap': 'round', 'line-join': 'round' },
				paint: { 'line-color': '#1c6e8c', 'line-width': 3.2 },
			});
		}
	}

	function bounds(coords: LngLat[]): [[number, number], [number, number]] {
		let w = Infinity, s = Infinity, e = -Infinity, n = -Infinity;
		for (const [lng, lat] of coords) {
			if (lng < w) w = lng;
			if (lng > e) e = lng;
			if (lat < s) s = lat;
			if (lat > n) n = lat;
		}
		return [[w, s], [e, n]];
	}

	function fit(coords: LngLat[]) {
		if (coords.length < 2) return;
		map.resize();
		map.fitBounds(bounds(coords), { padding: 40, animate: false });
	}

	function showOutline() {
		const ring = outerRing(geometry) as LngLat[];
		whenReady(() => {
			setSource('outline', ring);
			setSource('route', []); // clear any previous route
			drawLayers();
			fit(ring);
		});
		genBtn.disabled = false;
		exportBtn.disabled = true;
		statsEl.hidden = true;
		routeCoords = [];
	}

	// --- load a shape --------------------------------------------------------

	$<HTMLButtonElement>('bo-load').addEventListener('click', async () => {
		const q = placeIn.value.trim();
		if (!q) return;
		status(`Looking up “${q}”…`, 'busy');
		try {
			const outline = await fetchOutline(q);
			geometry = outline.geometry;
			name = outline.name.split(',')[0];
			showOutline();
			status(`Loaded ${outline.name}. Set a spacing and generate.`);
		} catch (err) {
			status(err instanceof Error ? err.message : 'Lookup failed.', 'error');
		}
	});
	placeIn.addEventListener('keydown', (e) => {
		if (e.key === 'Enter') $<HTMLButtonElement>('bo-load').click();
	});

	$<HTMLButtonElement>('bo-loadgeo').addEventListener('click', () => {
		try {
			geometry = JSON.parse(geojsonIn.value);
			name = 'outline';
			showOutline();
			status('Shape loaded. Set a spacing and generate.');
		} catch (err) {
			status(err instanceof Error ? err.message : 'That is not valid GeoJSON.', 'error');
		}
	});

	// --- generate the route --------------------------------------------------

	genBtn.addEventListener('click', async () => {
		if (!geometry) return;
		const spacingKm = Math.max(1, Number(spacingIn.value) || 8);
		const profile = profileIn.value as Profile;
		const ring = outerRing(geometry) as LngLat[];
		const waypoints = resample(ring, spacingKm * 1000);
		status(`Routing ${waypoints.length} waypoints on real roads…`, 'busy');
		genBtn.disabled = true;
		try {
			const routed = await routeWaypoints(waypoints, profile);
			routeCoords = routed.coords;
			whenReady(() => {
				setSource('route', routeCoords);
				fit(routeCoords);
			});
			const dev = deviation(routeCoords, waypoints);
			$('bo-dist').textContent = `${(routed.length / 1000).toFixed(0)} km`;
			$('bo-climb').textContent = routed.ascend != null ? `${routed.ascend.toLocaleString()} m` : '—';
			$('bo-wps').textContent = String(waypoints.length);
			$('bo-dev').textContent = `${(dev.mean / 1000).toFixed(1)} km avg · ${(dev.max / 1000).toFixed(1)} km max`;
			statsEl.hidden = false;
			exportBtn.disabled = false;
			status('Route generated. Fix any rough sections in RideWithGPS after export.');
		} catch (err) {
			status(err instanceof Error ? err.message : 'Routing failed.', 'error');
		} finally {
			genBtn.disabled = false;
		}
	});

	// --- export --------------------------------------------------------------

	exportBtn.addEventListener('click', () => {
		if (routeCoords.length < 2) return;
		const gpx = toGPX(routeCoords, `${name} outline ride`);
		const a = document.createElement('a');
		a.href = URL.createObjectURL(new Blob([gpx], { type: 'application/gpx+xml' }));
		a.download = `${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-outline.gpx`;
		a.click();
		URL.revokeObjectURL(a.href);
	});
</script>

<style>
	h1 {
		margin-bottom: 1rem;
	}
	.bo {
		display: grid;
		grid-template-columns: 300px minmax(0, 1fr);
		gap: 1.5rem;
		align-items: start;
	}
	@media (max-width: 820px) {
		.bo {
			grid-template-columns: 1fr;
		}
	}

	.bo__controls {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-family: var(--sans);
		font-size: 0.9rem;
	}
	.bo__field {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.bo__field--inline {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}
	.bo__controls label {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--ink-soft);
	}
	.bo__row {
		display: flex;
		gap: 0.4rem;
	}
	.bo__row input {
		flex: 1;
		min-width: 0;
	}
	input,
	select,
	textarea,
	button {
		font: inherit;
		color: var(--ink);
		background: var(--card);
		border: 1px solid var(--rule);
		border-radius: 4px;
		padding: 0.4rem 0.55rem;
	}
	.bo__field--inline input,
	.bo__field--inline select {
		width: 42%;
	}
	button {
		cursor: pointer;
		background: var(--accent-bg);
		font-weight: 600;
	}
	button:hover {
		border-color: var(--accent);
	}
	button:disabled {
		opacity: 0.5;
		cursor: default;
	}
	.bo__geo summary {
		cursor: pointer;
		color: var(--ink-soft);
		font-size: 0.8rem;
	}
	.bo__geo textarea {
		width: 100%;
		margin: 0.5rem 0;
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 0.75rem;
		resize: vertical;
	}
	.bo__geo button {
		width: 100%;
	}
	.bo__actions {
		display: flex;
		gap: 0.5rem;
	}
	.bo__actions button {
		flex: 1;
	}
	.bo__status {
		margin: 0;
		font-size: 0.82rem;
		min-height: 1.2em;
		color: var(--ink-soft);
	}
	.bo__status[data-kind='error'] {
		color: var(--accent);
	}
	.bo__stats {
		margin: 0;
		display: grid;
		gap: 0.6rem;
		border-top: 1px solid var(--rule);
		padding-top: 0.9rem;
	}
	.bo__stats[hidden] {
		display: none;
	}
	.bo__stats div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}
	.bo__stats dt {
		color: var(--ink-soft);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.bo__stats dd {
		margin: 0;
		font-weight: 600;
	}

	.bo__mapwrap {
		position: relative;
		border: 1px solid var(--rule);
		border-radius: 8px;
		overflow: hidden;
	}
	.bo__map {
		height: min(72vh, 640px);
		min-height: 400px;
	}
	.bo__nokey {
		position: absolute;
		left: 50%;
		top: 12px;
		transform: translateX(-50%);
		margin: 0;
		z-index: 2;
		font-family: var(--sans);
		font-size: 12px;
		color: var(--ink-soft);
		background: rgba(251, 249, 244, 0.94);
		border: 1px solid var(--rule);
		border-radius: 6px;
		padding: 6px 10px;
	}
	.bo__nokey code {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
	}
</style>
