---
// /activities/gear/:id — one bike and everything bolted to it.
//
// WHY ONLY BIKES GET THIS PAGE. A pair of running shoes has exactly one
// lifecycle and it is the shoe's own — the gear row already carries it, and a
// page would be that row printed larger. A bike is a dozen lifecycles running
// at different rates on the same odometer: the chain is on its fourth, the
// frame is on its first. That's the thing a list can't hold, so that's what
// this page is. Non-bike gear resolves here too and simply stops after its
// totals and its dates — a shoe has nothing bolted to it, and saying so in a
// sentence would be the page explaining its own absence.
//
// WHY THE WEAR BAR IS A RANGE AND NOT A PERCENTAGE. "72% worn" is a claim
// about a chain nobody measured. The honest reading is an interval — fine
// until about here, replace by about there — so the bar draws the whole window
// and marks where the part sits in it. Parts with no mileage interval at all
// (bearings, valves) get no bar rather than a fabricated one: see
// ComponentWear.fraction in src/lib/gear.ts.
import ActivityLayout from '../../../layouts/ActivityLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { requireOwner } from '../../../lib/auth';
import { ALPINE } from '../../../lib/activity-tokens';
import {
	COMPONENT_KINDS,
	COMPONENT_ORDER,
	ageText,
	getGearDetail,
	hoursText,
	hasOwnInterval,
	intervalText,
	isoToday,
	milesText,
	retiredDate,
	GEAR_KIND_LABELS,
	type ComponentWear,
	type GearDetail,
} from '../../../lib/gear';

export const prerender = false;

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return new Response('Not found', { status: 404 });

let detail: GearDetail | null = null;
try {
	detail = await getGearDetail(id);
} catch (err) {
	console.error(`gear detail ${id}: could not reach the activity log —`, err);
	return new Response('The activity log could not be reached', { status: 503 });
}
if (!detail) return new Response('Not found', { status: 404 });

const isOwner = await requireOwner(Astro.cookies);
const { gear, use, fitted, history } = detail;

const isBike = gear.kind === 'bike';
const retired = retiredDate(gear);
const today = isoToday();
const num = (n: number) => n.toLocaleString('en-US');

const title = gear.nickname || gear.name;
const catalog = [gear.brand, gear.model].filter(Boolean).join(' ');
// Most of the rack is named exactly what its brand and model spell out, so the
// subtitle would print the title back at you. Compare loosely — "cervelo S3" is
// not a different fact from "Cervélo S3", just differently typed.
const norm = (v: string) =>
	v.normalize('NFD').replace(/\p{Diacritic}/gu, '').replace(/\s+/g, ' ').trim().toLowerCase();
const subtitle =
	catalog && norm(catalog) !== norm(title)
		? catalog
		: gear.nickname && norm(gear.name) !== norm(title)
			? gear.name
			: '';

// The gear's own start date if it's known; otherwise the earliest activity
// tagged to it, which is a floor and is labelled as one.
const start = gear.first_used_on ?? use.firstDate;
const startIsFloor = !gear.first_used_on && !!use.firstDate;

// Kinds not currently fitted — what the "fit a part" picker should offer
// first, since fitting a second chain to a bike that already has one is
// almost always a mis-click rather than a plan.
const fittedKinds = new Set(fitted.map((c) => c.component.kind));

const STATUS_TEXT: Record<ComponentWear['status'], string> = {
	ok: 'ok',
	due: 'due',
	overdue: 'overdue',
	monitor: 'watch',
	retired: 'removed',
};

/** How far along the bar to draw the marker, clamped so an overdue part sits
 * at the end rather than off it. */
function barPercent(w: ComponentWear): number {
	return Math.max(0, Math.min(1, w.fraction ?? 0)) * 100;
}

/** Where the "due" window opens, as a percent of the bar — the near end of the
 * interval over the far end, which is what makes the shaded zone. */
function duePercent(w: ComponentWear): number {
	const m = w.meta;
	if (m.lifeMiles) return (m.lifeMiles[0] / m.lifeMiles[1]) * 100;
	if (m.lifeMonths) return (m.lifeMonths[0] / m.lifeMonths[1]) * 100;
	return 100;
}

/** The one line under a component's name: what it is, and what it's done.
 *
 * Brakes, wheels and tires don't wear on a trainer, so their odometer is
 * outdoor miles only. When that has actually discarded something, it's said —
 * otherwise a reader comparing a tire's total to the chain's on the same bike
 * finds two numbers that disagree with no account of why. Below a mile it
 * stays quiet; there is nothing to explain. */
function usedText(w: ComponentWear): string {
	const parts = [`${Math.round(w.miles).toLocaleString('en-US')} mi`, ageText(w.days), `${num(w.rides)} rides`];
	if (w.excludedIndoorMiles >= 1) {
		parts.push(`${Math.round(w.excludedIndoorMiles).toLocaleString('en-US')} mi indoors not counted`);
	}
	return parts.join(' · ');
}
---

<ActivityLayout title={`${title} — Jason's activity log`}>
	<div
		class="page"
		style={{
			'--sky': ALPINE.sky,
			'--snow': ALPINE.snow,
			'--granite': ALPINE.granite,
			'--granite-soft': ALPINE.graniteSoft,
			'--lake': ALPINE.lake,
			'--lake-deep': ALPINE.lakeDeep,
			'--larch': ALPINE.larch,
			'--scree': ALPINE.scree,
			'--fir': ALPINE.fir,
			'--alpenglow': ALPINE.alpenglow,
		}}
		data-gear-id={String(gear.id)}
	>
		<div class="card">
			<SiteHeader pathname="/activities" theme="activity" />

			<div class="wrap">
				<a class="back" href="/activities/gear">← Gear</a>

				<header class="head">
					<div class="head__id">
						<h1 class="head__name">{title}</h1>
						{subtitle && <p class="head__sub">{subtitle}</p>}
						<p class="head__served">
							{GEAR_KIND_LABELS[gear.kind].replace(/s$/, '')}
							{start && (
								<Fragment>
									{' · '}
									{retired ? `${start} – ${retired}` : `in service since ${start}`}
									{startIsFloor && <span class="head__floor"> (first tagged activity)</span>}
								</Fragment>
							)}
							{!start && retired && ` · retired ${retired}`}
						</p>
					</div>

					<dl class="odo">
						<div>
							<dt>Distance</dt>
							<dd class="odo__big figure">{milesText(use.distanceM)}</dd>
						</div>
						<div>
							<dt>Moving time</dt>
							<dd class="figure">{hoursText(use.movingSeconds)}</dd>
						</div>
						<div>
							<dt>Activities</dt>
							<dd class="figure">{num(use.activityCount)}</dd>
						</div>
						<div>
							<dt>Last used</dt>
							<dd class="figure">{use.lastDate ?? '—'}</dd>
						</div>
					</dl>
				</header>

				{isOwner && (
					<section class="admin">
						<div class="admin__row">
							<label>
								First used
								<input type="date" id="gear-first-used" value={gear.first_used_on ?? ''} />
							</label>
							<label>
								Retired
								<input type="date" id="gear-retired" value={retired ?? ''} />
							</label>
							<button class="btn" id="gear-save">Save</button>
							<span class="admin__msg" id="gear-msg"></span>
						</div>
					</section>
				)}

				{isBike && (
					<Fragment>
						<section>
							<div class="sec-head">
								<span class="sec-head__title">Fitted</span>
								<span class="sec-head__n figure">{num(fitted.length)}</span>
							</div>

							{fitted.length === 0 ? (
								<p class="note">Nothing recorded on this bike yet.</p>
							) : (
								<ul class="parts">
									{fitted.map((w) => (
										<li class:list={['part', `part--${w.status}`]} data-component-id={String(w.component.id)}>
											<div class="part__main">
												<div class="part__head">
													<span class="part__kind">{w.meta.label}</span>
													{w.component.label && <span class="part__label">{w.component.label}</span>}
													<span class:list={['pill', `pill--${w.status}`]}>{STATUS_TEXT[w.status]}</span>
												</div>
												<div class="part__used figure">{usedText(w)}</div>
												{w.component.condition && <div class="part__cond">{w.component.condition}</div>}
											</div>

											<div class="part__wear">
												{w.fraction == null ? (
													<div class="part__interval">
														{w.meta.trackBy}
														{isOwner && <button class="link-btn" data-act="interval">set</button>}
													</div>
												) : (
													<Fragment>
														<div class="bar" role="img" aria-label={`${Math.round(barPercent(w))}% of ${intervalText(w.meta)}`}>
															<div class="bar__due" style={`left:${duePercent(w)}%`}></div>
															<div class="bar__fill" style={`width:${barPercent(w)}%`}></div>
														</div>
														<div class="part__interval">
															{intervalText(w.meta)}
															{hasOwnInterval(w.component) && <span class="part__own" title="this part's own window, not the default">*</span>}
															{isOwner && <button class="link-btn" data-act="interval">edit</button>}
														</div>
													</Fragment>
												)}
											</div>

											<div class="part__meta figure">
												<span data-fitted={w.component.installed_on}>fitted {w.component.installed_on}</span>
												{isOwner && (
													<span class="part__acts">
														<button class="link-btn" data-act="fitted">date</button>
														<button class="link-btn" data-act="replace">replace</button>
														<button class="link-btn link-btn--danger" data-act="delete">delete</button>
													</span>
												)}
											</div>
										</li>
									))}
								</ul>
							)}
						</section>

						{isOwner && (
							<section class="admin">
								<div class="sec-head">
									<span class="sec-head__title">Fit a part</span>
								</div>
								<div class="admin__grid">
									<label>
										Part
										<select id="c-kind">
											{COMPONENT_ORDER.map((k) => (
												<option value={k} disabled={fittedKinds.has(k) && k !== 'other'}>
													{COMPONENT_KINDS[k].label}
												</option>
											))}
										</select>
									</label>
									<label>
										Label
										<input type="text" id="c-label" placeholder="Shimano CN-M8100" />
									</label>
									<label>
										Fitted
										<input type="date" id="c-installed" value={today} />
									</label>
									<label>
										Miles carried in
										<input type="number" id="c-baseline" min="0" step="1" value="0" />
									</label>
									<label>
										Replace window
										<input type="text" id="c-interval" placeholder="2500-5000 mi" />
									</label>
									<label class="admin__wide">
										Condition
										<input type="text" id="c-condition" />
									</label>
									<div class="admin__actions">
										<button class="btn" id="c-add">Fit</button>
										<span class="admin__msg" id="c-msg"></span>
									</div>
								</div>
							</section>
						)}

						<section>
							<div class="sec-head">
								<span class="sec-head__title">Service history</span>
								<span class="sec-head__n figure">{num(history.length)}</span>
							</div>
							{history.length === 0 ? (
								<p class="note">Nothing replaced yet.</p>
							) : (
								<ul class="parts parts--history">
									{history.map((w) => (
										<li class="part part--retired" data-component-id={String(w.component.id)}>
											<div class="part__main">
												<div class="part__head">
													<span class="part__kind">{w.meta.label}</span>
													{w.component.label && <span class="part__label">{w.component.label}</span>}
												</div>
												<div class="part__used figure">{usedText(w)}</div>
												{w.component.condition && <div class="part__cond">{w.component.condition}</div>}
											</div>
											<div class="part__wear">
												<div class="part__interval">
													{intervalText(w.meta) || w.meta.trackBy}
													{hasOwnInterval(w.component) && <span class="part__own">*</span>}
												</div>
											</div>
											<div class="part__meta figure">
												<span>{w.component.installed_on} – {w.component.removed_on}</span>
												{isOwner && (
													<span class="part__acts">
														<button class="link-btn link-btn--danger" data-act="delete">delete</button>
													</span>
												)}
											</div>
										</li>
									))}
								</ul>
							)}
						</section>
					</Fragment>
				)}
			</div>
		</div>
	</div>

	{isOwner && (
		<script>
			import { parseInterval } from '../../../lib/gear-wear';

			// Owner-only editing. Every write is one fetch to /api/activities/gear
			// followed by a reload — the page's numbers are all derived sums, so
			// re-rendering from the server is both the shortest correct update and
			// the only one that can't drift from what the next visitor will see.
			const page = document.querySelector<HTMLElement>('.page[data-gear-id]');
			const gearId = Number(page?.dataset.gearId);

			async function send(method: string, body: Record<string, unknown>, msg: HTMLElement | null) {
				if (msg) msg.textContent = 'saving…';
				try {
					const res = await fetch('/api/activities/gear', {
						method,
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify(body),
					});
					if (!res.ok) {
						const err = await res.json().catch(() => ({ error: res.statusText }));
						if (msg) msg.textContent = err.error ?? 'failed';
						return false;
					}
					location.reload();
					return true;
				} catch {
					if (msg) msg.textContent = 'network error';
					return false;
				}
			}

			const val = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value ?? '';

			document.getElementById('gear-save')?.addEventListener('click', () => {
				send(
					'PATCH',
					{
						target: 'gear',
						id: gearId,
						firstUsedOn: val('gear-first-used') || null,
						retiredOn: val('gear-retired') || null,
					},
					document.getElementById('gear-msg'),
				);
			});

			document.getElementById('c-add')?.addEventListener('click', () => {
				const installedOn = val('c-installed');
				const msg = document.getElementById('c-msg');
				if (!installedOn) {
					if (msg) msg.textContent = 'a fitted date is required';
					return;
				}
				// A window that was typed but not understood is refused rather than
				// dropped: silently fitting the part against the category default
				// would be the one failure this feature can't recover from, because
				// nothing on the page would say the number had been ignored.
				const raw = val('c-interval').trim();
				const parsed = raw ? parseInterval(raw) : null;
				if (raw && !parsed) {
					if (msg) msg.textContent = 'window must read like "2500-5000 mi" or "4-8 mo"';
					return;
				}
				send(
					'POST',
					{
						target: 'component',
						gearId,
						kind: val('c-kind'),
						label: val('c-label') || null,
						installedOn,
						baselineMiles: Number(val('c-baseline') || 0),
						lifeMiles: parsed?.axis === 'miles' ? parsed.window : null,
						lifeMonths: parsed?.axis === 'months' ? parsed.window : null,
						condition: val('c-condition') || null,
					},
					msg,
				);
			});

			// Delegated so both lists (fitted and history) are covered by one
			// listener, and so rows added by a later render still work.
			document.addEventListener('click', (e) => {
				const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('.link-btn');
				if (!btn) return;
				const li = btn.closest<HTMLElement>('[data-component-id]');
				const id = Number(li?.dataset.componentId);
				if (!Number.isInteger(id)) return;

				if (btn.dataset.act === 'fitted') {
					const current = li?.querySelector<HTMLElement>('[data-fitted]')?.dataset.fitted ?? '';
					const on = prompt('Fitted on (YYYY-MM-DD)', current);
					if (!on) return;
					send('PATCH', { target: 'component', id, installedOn: on }, null);
				} else if (btn.dataset.act === 'replace') {
					// Prefilled with today, but editable: a part is usually noticed
					// as worn out some days after the ride that finished it.
					const on = prompt('Removed on (YYYY-MM-DD)', new Date().toISOString().slice(0, 10));
					if (!on) return;
					send('PATCH', { target: 'component', id, removedOn: on }, null);
				} else if (btn.dataset.act === 'interval') {
					// Prefilled with whatever the row is currently judged against, so
					// editing a window starts from the window rather than from blank.
					const current = li?.querySelector('.part__interval')?.textContent?.trim() ?? '';
					const raw = prompt('Replace window. Write it like "2500-5000 mi" or "4-8 mo". Blank uses the default.', current);
					if (raw === null) return;
					const parsed = raw.trim() ? parseInterval(raw) : null;
					if (raw.trim() && !parsed) {
						alert('Not a window. Write it like "2500-5000 mi" or "4-8 mo".');
						return;
					}
					send(
						'PATCH',
						{
							target: 'component',
							id,
							lifeMiles: parsed?.axis === 'miles' ? parsed.window : null,
							lifeMonths: parsed?.axis === 'months' ? parsed.window : null,
						},
						null,
					);
				} else if (btn.dataset.act === 'delete') {
					if (!confirm('Delete this component row? Replacing a part is "replace". This erases it.')) return;
					send('DELETE', { target: 'component', id }, null);
				}
			});
		</script>
	)}

	<style>
		.page {
			min-height: 100vh;
			display: flex;
			justify-content: center;
			overflow-x: hidden;
		}
		.card {
			width: 100%;
			max-width: 1100px;
			display: flex;
			flex-direction: column;
		}
		.wrap {
			padding: 30px 40px 70px;
			display: flex;
			flex-direction: column;
			gap: 34px;
		}


		.back {
			font-size: 13px;
			color: var(--granite-soft);
			align-self: flex-start;
		}
		.back:hover {
			color: var(--lake);
		}

		.head {
			display: flex;
			justify-content: space-between;
			align-items: flex-end;
			gap: 28px;
			flex-wrap: wrap;
			border-bottom: 1px solid var(--scree);
			padding-bottom: 20px;
		}
		.head__name {
			font-family: 'Instrument Serif', Georgia, serif;
			font-size: 38px;
			font-weight: 400;
			line-height: 1.05;
			margin: 0;
			color: var(--granite);
		}
		.head__sub {
			margin: 6px 0 0;
			font-size: 14px;
			color: var(--granite-soft);
		}
		.head__served {
			margin: 8px 0 0;
			font-size: 12.5px;
			color: var(--granite-soft);
		}
		.head__floor {
			font-style: italic;
		}

		.odo {
			display: flex;
			gap: 26px;
			margin: 0;
			flex-wrap: wrap;
		}
		.odo dt {
			font-size: 11px;
			letter-spacing: 1px;
			text-transform: uppercase;
			color: var(--granite-soft);
		}
		.odo dd {
			margin: 3px 0 0;
			font-size: 17px;
			color: var(--granite);
			font-weight: 600;
		}
		.odo__big {
			font-size: 26px !important;
			color: var(--lake) !important;
			font-weight: 700;
		}

		.sec-head {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			border-bottom: 1px solid var(--scree);
			padding-bottom: 9px;
			margin-bottom: 10px;
		}
		.sec-head__title {
			font-family: 'Instrument Serif', Georgia, serif;
			font-style: italic;
			font-size: 20px;
			color: var(--granite);
		}
		.sec-head__n {
			font-size: 13px;
			color: var(--granite-soft);
		}
		.note {
			margin: 0;
			font-size: 14px;
			color: var(--granite-soft);
		}
		.note a {
			color: var(--lake);
		}

		/* ---- the parts list ---- */
		.parts {
			list-style: none;
			margin: 0;
			padding: 0;
		}
		.part {
			display: grid;
			grid-template-columns: minmax(0, 1.3fr) minmax(140px, 1fr) auto;
			gap: 8px 22px;
			align-items: center;
			padding: 14px 4px;
			border-bottom: 1px solid var(--scree);
		}
		.part:last-child {
			border-bottom: none;
		}
		.part__head {
			display: flex;
			align-items: baseline;
			gap: 9px;
			flex-wrap: wrap;
		}
		.part__kind {
			font-size: 15px;
			font-weight: 600;
			color: var(--granite);
		}
		.part__label {
			font-size: 12.5px;
			color: var(--granite-soft);
		}
		.part__used {
			margin-top: 3px;
			font-size: 13px;
			color: var(--granite-soft);
		}
		.part__cond {
			margin-top: 3px;
			font-size: 12.5px;
			color: var(--granite);
			border-left: 2px solid var(--scree);
			padding-left: 8px;
		}
		.part__interval {
			margin-top: 5px;
			font-size: 11.5px;
			color: var(--granite-soft);
		}
		/* An overridden window is marked, not recoloured — a reader comparing two
		   chains has to know one is being judged against a different ruler, but
		   that fact is a footnote, not a status. */
		.part__own {
			color: var(--larch);
			font-weight: 700;
			padding-left: 2px;
		}
		.part__meta {
			font-size: 12px;
			color: var(--granite-soft);
			text-align: right;
			white-space: nowrap;
		}
		.part__acts {
			display: block;
			margin-top: 5px;
		}

		/* The wear bar. The shaded tail is the replacement window — everything
		   left of it is "fine", everything inside it is "think about it", and past
		   the end is overdue. The fill is the part's position in that window, so
		   the reading is spatial and needs no percentage attached to it. */
		.bar {
			position: relative;
			height: 7px;
			border-radius: 4px;
			background: var(--scree);
			overflow: hidden;
		}
		.bar__due {
			position: absolute;
			top: 0;
			right: 0;
