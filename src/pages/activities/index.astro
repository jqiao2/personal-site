---
// PLACEHOLDER — proves the shell (ActivityLayout) and the card (ActivityCard)
// render and look right. The real landing page (top-four favourites + the
// reverse-chronological week grid, per ACTIVITIES.md §1) is a different
// track's job (see §9 "Landing": src/lib/activity-week.ts + this file) and
// will overwrite this. Data below is hardcoded on purpose — the schema is
// being built concurrently in this same window and may not exist on disk yet,
// so this page must never touch the database.
import ActivityLayout from '../../layouts/ActivityLayout.astro';
import ActivityCard, { type ActivityRow } from '../../components/ActivityCard.astro';
import { siteNav } from '../../lib/nav';

const nav = siteNav(Astro.url.pathname);

// A couple of representative route shapes, already in the 0-0-100-100,
