---
// The activity log's landing page — ACTIVITIES.md §1: top-four favourites,
// then a reverse-chronological Mon–Sun week calendar where every day is a
// vertical list of that day's activities (never a stack that hides all but
// one, the way the film log's month grid stacks posters — see
// ActivityCard.astro's header comment on why "cell" size exists).
//
// Rendered on demand — reflects the live database, which is being seeded
// concurrently with this page's own construction. Every read below already
// degrades to an empty result rather than throwing (activities.ts's
// isDegraded), so an empty or not-yet-migrated database renders the real
// empty state below, not a 500.
import ActivityLayout from '../../layouts/ActivityLayout.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import { siteNav } from '../../lib/nav';
import { listActivityDays, listFavoriteActivities, getActivityStats } from '../../lib/activities';
import { groupIntoWeeks, type ActivityWeek } from '../../lib/activity-week';
import { formatStat } from '../../lib/sports';
import { ALPINE } from '../../lib/activity-tokens';
import { siteYear } from '../../lib/day';

export const prerender = false;

// 12 weeks reads as "the last quarter" without asking the browser to paint
// 14 months of mostly-empty grid — /activities/all is the answer to "show me
// everything." DAYS_FETCH_LIMIT is a day-with-activity count, not a calendar-
// day count (listActivityDays only returns days that have a row at all — see
// its doc comment), so it's set comfortably above WEEKS_TO_SHOW * 7 = 84: even
// if literally every day in the window had an activity, 100 rows would still
// cover all of them, with headroom to spare.
const WEEKS_TO_SHOW = 12;
const DAYS_FETCH_LIMIT = 100;

// activities.ts already turns a missing-table/column error into an empty
// result (isDegraded) — but a Supabase client pointed at unreachable
// credentials (a placeholder `.env`, a project that's paused) fails at the
// network layer instead, which isDegraded doesn't classify as "no data" and
// so it throws. That's a real distinction everywhere else (a network error
// should be loud), but a landing page has no form to fail out of — the
// worst response to "the database didn't answer" is a 500 where an empty
// calendar would do. So this one call site swallows it too.
let favorites: Awaited<ReturnType<typeof listFavoriteActivities>> = [];
let days: Awaited<ReturnType<typeof listActivityDays>> = [];
let stats: Awaited<ReturnType<typeof getActivityStats>> = {
	activitiesThisYear: 0,
	totalDistanceM: 0,
	totalElevationGainM: 0,
	totalMovingHours: 0,
	totalExertion: 0,
	bySportFamily: {},
};
/** Set when the query layer could not be reached at all — see the catch below. */
let unreachable = false;
try {
	[favorites, days, stats] = await Promise.all([
		listFavoriteActivities(4),
		listActivityDays({ limit: DAYS_FETCH_LIMIT }),
		getActivityStats(),
	]);
} catch (err) {
	// AN UNREACHABLE LOG IS NOT AN EMPTY LOG, and the page must not say it is.
	// Falling through to the empty state here would print "nothing logged in the
	// last 12 weeks" over a database we simply failed to ask — which is a
	// sentence about the athlete rather than about the outage, and the one
	// reading a visitor can neither verify nor discount. So the failure is
	// carried into the markup as its own state and said out loud.
	//
	// This stays a caught error rather than a 500 because everything else on
	// the page — the nav, the shell, the links into the rest of the section —
	// is still true and still useful when the query layer is down.
	unreachable = true;
	console.error('activities landing page: could not reach the activity log —', err);
}

const weeks = groupIntoWeeks(days, { weeks: WEEKS_TO_SHOW });
const calendarIsEmpty = weeks.every((w) => w.totals.activityCount === 0);

const nav = siteNav(Astro.url.pathname);
const num = (n: number) => n.toLocaleString('en-US');

// bySportFamily is all-time and only counts families that have at least one
// activity (getActivityStats' doc comment) — summing it is the one place this
// page needs an all-time activity count, and it's cheaper than a second query.
const totalActivities = Object.values(stats.bySportFamily).reduce((a, b) => a + (b ?? 0), 0);
const rideCount = stats.bySportFamily.bike ?? 0;
const yearStart = `${siteYear()}-01-01`;

const DOW = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

/** 'YYYY-MM-DD' → its day-of-month, unpadded — the numeral a calendar cell
 * shows. A plain string slice; no Date needed for a value this literal. */
function dayNum(date: string): string {
	return String(Number(date.slice(8, 10)));
}

/** A week's totals through sports.ts's one formatter, so this page's numbers
 * agree with every other page's rather than keeping a second mi/ft/clock. */
function weekStatText(t: ActivityWeek['totals']) {
	return {
		distance: formatStat('distance', { distance_m: t.distanceM }).value,
		elevation: formatStat('elevation_gain', { elevation_gain_m: t.elevationGainM }).value,
		moving: formatStat('moving_time', { moving_seconds: t.movingSeconds }).value,
		exertion: Math.round(t.exertion).toString(),
	};
}
---

<ActivityLayout title="Jason's activity log">
	<div
		class="page"
		style={{
			'--sky': ALPINE.sky,
			'--snow': ALPINE.snow,
			'--granite': ALPINE.granite,
			'--granite-soft': ALPINE.graniteSoft,
			'--lake': ALPINE.lake,
			'--lake-deep': ALPINE.lakeDeep,
			'--larch': ALPINE.larch,
			'--scree': ALPINE.scree,
		}}
	>
		<div class="card">
			<nav class="tabs">
				{nav.map((n) => (
					<a
						class:list={['tabs__link', n.active && 'tabs__link--active']}
						href={n.href}
						aria-current={n.active ? 'page' : undefined}
					>
						{n.label}
					</a>
				))}
			</nav>

			<div class="card__body">
				<!-- Sidebar -->
				<aside class="side">
					<div class="brand">Jason's<br />activity log</div>
					<div class="brand__sub">{num(stats.activitiesThisYear)} activities this year</div>

					<div class="side__rule"></div>
					<nav class="side__nav">
						<a class="navrow navrow--link" href="/activities/all">
							<span>All activities</span><span class="navrow__n">{num(totalActivities)}</span>
						</a>
						<a class="navrow navrow--link" href="/activities/all?sports=ride,gravel_ride,mountain_bike,virtual_ride">
							<span>Rides</span><span class="navrow__n">{num(rideCount)}</span>
						</a>
						<a class="navrow navrow--link" href={`/activities/all?dateFrom=${yearStart}&sort=elevation`}>
							<span>This year's climbing</span><span class="navrow__n">→</span>
						</a>
						<a class="navrow navrow--link" href="/activities/heatmap">
							<span>Heatmap</span><span class="navrow__n">→</span>
						</a>
						<a class="navrow navrow--link navrow--last" href="/activities/month">
							<span>The month in review</span><span class="navrow__n">→</span>
						</a>
					</nav>
				</aside>

				<!-- Main -->
				<main class="main">
					<section>
						<div class="sec-head">
							<span class="sec-head__title">Favourite activities</span>
						</div>
						{favorites.length > 0 ? (
							<div class="grid4">
								{favorites.map((a) => <ActivityCard activity={a} size="tile" />)}
							</div>
						) : (
							<p class="fav-empty">No favourites picked yet.</p>
						)}
					</section>

					<section>
						<div class="sec-head">
							<span class="sec-head__title">The last {WEEKS_TO_SHOW} weeks</span>
							<a class="sec-head__link" href="/activities/all">Everything →</a>
						</div>

						{unreachable ? (
							<p class="cal-empty cal-empty--error">
								The activity log couldn’t be reached, so this grid is showing nothing
								rather than showing that nothing happened. The two look alike and are
								not the same — try again in a moment.
							</p>
						) : calendarIsEmpty && (
							<p class="cal-empty">
								Nothing logged in the last {WEEKS_TO_SHOW} weeks. Once activities are imported they'll
								show up here, newest week first.
							</p>
						)}

						<div class="calendar">
							<div class="dow" aria-hidden="true">
								{DOW.map((d) => <span>{d}</span>)}
							</div>

							{weeks.map((week) => {
								const t = weekStatText(week.totals);
								const weekHasActivity = week.totals.activityCount > 0;
								return (
									<div class="week">
										<div class="week__head">
											<span class="week__span figure">{week.label}</span>
											{weekHasActivity ? (
												<div class="week__totals figure">
													<span>{t.distance}</span>
													<span class="dot">·</span>
													<span>{t.elevation}</span>
													<span class="dot">·</span>
													<span>{t.moving}</span>
													<span class="dot">·</span>
													<span>{t.exertion} exertion</span>
												</div>
											) : (
												<span class="week__totals week__totals--quiet">Rest week</span>
											)}
										</div>
										<div class="week__grid">
											{week.days.map((day) => (
												<div
													class:list={[
														'day',
														day.activities.length === 0 && 'day--empty',
														day.isToday && 'day--today',
														day.isFuture && 'day--future',
													]}
												>
													<div class="day__label">
														<span class="day__dow">{DOW[week.days.indexOf(day)]}</span>
														<span class="day__num figure">{dayNum(day.date)}</span>
													</div>
													{day.activities.length > 0 ? (
														<div class="day__list">
															{day.activities.map((a) => <ActivityCard activity={a} size="cell" />)}
														</div>
													) : (
														<div class="day__quiet"></div>
													)}
												</div>
											))}
										</div>
									</div>
								);
							})}
						</div>
					</section>
				</main>
			</div>
		</div>
	</div>

<style>
	.page {
		min-height: 100vh;
		display: flex;
		justify-content: center;
		overflow-x: hidden;
	}
	.card {
		width: 100%;
		max-width: 1360px;
		display: flex;
		flex-direction: column;
	}
	.card__body {
		display: flex;
	}

	/* Site nav — spans the viewport while its content stays aligned to the
	   column, same trick films/index.astro uses. */
	.tabs {
		display: flex;
		align-items: stretch;
		gap: 2px;
		width: 100vw;
		margin-left: calc(50% - 50vw);
		padding: 0 calc(50vw - 50% + 28px);
		border-bottom: 1px solid var(--scree);
	}
	.tabs__link {
		font-size: 13px;
		letter-spacing: 0.4px;
		color: var(--granite-soft);
		padding: 26px 16px 24px;
		border-bottom: 2px solid transparent;
		transition: color 0.12s;
	}
	.tabs__link:hover {
		color: var(--granite);
	}
	.tabs__link--active {
		color: var(--lake);
		font-weight: 600;
		border-bottom-color: var(--lake);
	}

	/* Sidebar */
	.side {
		width: 268px;
		flex: none;
		border-right: 1px solid var(--scree);
		padding: 36px 26px;
		display: flex;
		flex-direction: column;
	}
	.brand {
		font-family: 'Instrument Serif', Georgia, serif;
		font-size: 29px;
		font-weight: 400;
		color: var(--granite);
		letter-spacing: -0.2px;
		line-height: 1.08;
	}
	.brand__sub {
		margin-top: 8px;
		font-size: 13px;
		color: var(--lake);
		font-weight: 600;
	}
	.side__rule {
		height: 1px;
		background: var(--scree);
		margin: 26px 0 8px;
	}
	.side__nav {
		display: flex;
		flex-direction: column;
	}
	.navrow {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 11px 0;
		font-size: 14px;
		color: var(--granite);
		border-bottom: 1px solid var(--scree);
	}
	.navrow--last {
		border-bottom: none;
	}
	.navrow--link:hover {
		color: var(--lake);
	}
	.navrow__n {
		color: var(--granite-soft);
		font-size: 13px;
		font-variant-numeric: tabular-nums;
	}

	/* Main */
	.main {
		flex: 1;
		min-width: 0;
		padding: 38px 40px 60px;
		display: flex;
		flex-direction: column;
		gap: 40px;
	}
	.sec-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		border-bottom: 1px solid var(--scree);
		padding-bottom: 9px;
		margin-bottom: 16px;
		gap: 12px;
	}
	.sec-head__title {
		font-family: 'Instrument Serif', Georgia, serif;
		font-style: italic;
		font-size: 20px;
		color: var(--granite);
	}
	.sec-head__link {
		font-size: 12px;
		color: var(--lake);
		font-weight: 600;
		letter-spacing: 0.3px;
		white-space: nowrap;
	}
	.sec-head__link:hover {
		color: var(--lake-deep);
	}
	.fav-empty,
	.cal-empty {
		margin: 0 0 8px;
		font-size: 14px;
		color: var(--granite-soft);
	}

	/* An outage is the one thing on this page allowed the warm accent — it is
	   not part of the record, and it should not read like the quiet grey of a
	   week with no riding in it. */
	.cal-empty--error {
		color: var(--granite);
		border-left: 2px solid var(--larch);
		padding-left: 10px;
	}

	.grid4 {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
	}

	/* ---- the week calendar ---- */
	.calendar {
		display: flex;
		flex-direction: column;
		gap: 26px;
	}
	.dow {
		display: grid;
		grid-template-columns: repeat(7, minmax(0, 1fr));
		gap: 10px;
		font-size: 11.5px;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		color: var(--granite-soft);
		padding: 0 2px 2px;
	}
	.week {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.week__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
		padding-bottom: 6px;
		border-bottom: 1px solid var(--scree);
	}
	.week__span {
		font-size: 13.5px;
		font-weight: 600;
		color: var(--granite);
	}
	.week__totals {
		font-size: 12.5px;
		color: var(--granite-soft);
		display: flex;
		align-items: baseline;
		gap: 6px;
	}
	.week__totals--quiet {
		font-style: italic;
	}
	.dot {
		color: var(--scree);
	}

	.week__grid {
		display: grid;
		grid-template-columns: repeat(7, minmax(0, 1fr));
		gap: 10px;
		align-items: start;
	}
	.day {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-height: 40px;
	}
	.day__label {
		display: none;
	}
	.day__num {
		font-size: 11px;
		color: var(--granite-soft);
	}
	.day--today .day__num {
		color: var(--lake);
		font-weight: 700;
	}
	.day--future {
		opacity: 0.4;
	}
	.day__list {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.day__quiet {
		height: 34px;
		border: 1px solid var(--scree);
		border-radius: 6px;
	}
	.day--today .day__quiet {
		border-color: var(--lake);
	}

	@media (max-width: 900px) {
		.card__body {
			flex-direction: column;
		}
		.side {
			width: 100%;
			border-right: none;
			border-bottom: 1px solid var(--scree);
		}
		.main {
			padding: 28px 22px 44px;
		}
		.grid4 {
			grid-template-columns: repeat(2, 1fr);
		}
		/* Eight links no longer fit in one row once the page itself has shrunk —
		   they wrap rather than clipping, since .page's overflow-x:hidden (there
		   to guard the full-bleed tabs against a scrollbar) would otherwise hide
		   "Activities" and "Subway" off the edge entirely. */
		.tabs {
			flex-wrap: wrap;
			padding-left: calc(50vw - 50% + 16px);
			padding-right: calc(50vw - 50% + 16px);
		}
		.tabs__link {
			padding: 16px 10px 14px;
		}
	}

	/* Below ~720px a 7-across grid squeezes each card under ~90px, too narrow for
	   a title and stats to read — so the week folds into a single-column agenda
	   instead, with each day's own weekday+date label shown inline (the shared
	   .dow header above the calendar no longer lines up with one column). */
	@media (max-width: 720px) {
		.dow {
			display: none;
		}
		.week__grid {
			grid-template-columns: 1fr;
		}
	}

	/* Stacked on a phone held upright, the week reads as a list — so run it
	   newest day first, matching the newest-week-first order around it. */
	@media (max-width: 720px) and (orientation: portrait) {
		.week__grid {
			display: flex;
			flex-direction: column-reverse;
		}
	}

	@media (max-width: 720px) {
		.day {
			flex-direction: row;
			align-items: flex-start;
			gap: 12px;
			min-height: 0;
		}
		.day__label {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 2px;
			flex: none;
			width: 34px;
			padding-top: 2px;
		}
		.day__dow {
			font-size: 10px;
			letter-spacing: 1px;
			text-transform: uppercase;
			color: var(--granite-soft);
		}
		.day__num {
			font-size: 13px;
			color: var(--granite);
		}
		.day--today .day__dow,
		.day--today .day__num {
			color: var(--lake);
			font-weight: 700;
		}
		.day__list {
			flex: 1;
			min-width: 0;
		}
		.day__quiet {
			flex: 1;
			height: 32px;
		}
		.grid4 {
			grid-template-columns: repeat(2, 1fr);
			gap: 10px;
		}
	}
</style>
</ActivityLayout>
