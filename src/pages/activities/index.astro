---
// The activity log's landing page — a reverse-chronological feed of the most
// recent activities down the left, a nav sidebar down the right, in the
// activity section's ALPINE palette. The data-heavy feed is a server island
// (ActivitiesFeed, server:defer) so only the fast owner check blocks this
// response and the feed streams in after. The ALPINE custom properties are set
// on .page here and cascade into the island content.
import ActivityLayout from '../../layouts/ActivityLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ActivitiesFeed from '../../components/ActivitiesFeed.astro';
import { ALPINE } from '../../lib/activity-tokens';

export const prerender = false;
---

<ActivityLayout title="Jason's activity log">
	<div
		class="page"
		style={{
			'--sky': ALPINE.sky,
			'--snow': ALPINE.snow,
			'--granite': ALPINE.granite,
			'--granite-soft': ALPINE.graniteSoft,
			'--lake': ALPINE.lake,
			'--lake-deep': ALPINE.lakeDeep,
			'--larch': ALPINE.larch,
			'--scree': ALPINE.scree,
		}}
	>
		<div class="card">
			<SiteHeader pathname={Astro.url.pathname} theme="activity" />

			<ActivitiesFeed server:defer>
				<div slot="fallback" class="shell-skel" aria-hidden="true">
					<div class="feed-skel">
						{Array.from({ length: 6 }).map(() => (
							<div class="skel-item">
								<div class="skel-body">
									<div class="skel-line skel-line--meta"></div>
									<div class="skel-line skel-line--title"></div>
									<div class="skel-line skel-line--note"></div>
								</div>
								<div class="skel-thumb"></div>
							</div>
						))}
					</div>
					<div class="side-skel"></div>
				</div>
			</ActivitiesFeed>
		</div>
	</div>

	<style>
		.page {
			min-height: 100vh;
			background: var(--sky);
			display: flex;
			justify-content: center;
			overflow-x: hidden;
		}
		.card {
			width: 100%;
			max-width: 1120px;
			display: flex;
			flex-direction: column;
		}

		/* Skeleton shown while the ActivitiesFeed island streams in. Mirrors the
		   feed's two-column geometry so the shell doesn't reflow when it arrives. */
		.shell-skel {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 288px;
		}
		.feed-skel {
			padding: 38px 40px 44px;
		}
		.side-skel {
			border-left: 1px solid var(--scree);
		}
		.skel-item {
			display: flex;
			gap: 20px;
			align-items: flex-start;
			padding: 16px 0 18px;
			border-bottom: 1px solid var(--scree);
		}
		.skel-body {
			flex: 1;
			min-width: 0;
		}
		.skel-thumb {
			flex: none;
			width: 84px;
			height: 63px;
			border: 1px solid var(--scree);
			border-radius: 6px;
			background: var(--snow);
		}
		.skel-line {
			height: 11.5px;
			border-radius: 2px;
			background: var(--scree);
			animation: skel-pulse 1.4s ease-in-out infinite;
		}
		.skel-line--meta {
			width: 38%;
			margin-bottom: 8px;
		}
		.skel-line--title {
			width: 70%;
			height: 22px;
			margin-bottom: 8px;
		}
		.skel-line--note {
			width: 90%;
		}
		@keyframes skel-pulse {
			0%,
			100% {
				opacity: 1;
			}
			50% {
				opacity: 0.5;
			}
		}
		@media (prefers-reduced-motion: reduce) {
			.skel-line {
				animation: none;
			}
		}
		@media (max-width: 720px) {
			.shell-skel {
				grid-template-columns: 1fr;
			}
			.side-skel {
				display: none;
			}
			.feed-skel {
				padding: 28px 22px 34px;
			}
		}
	</style>
</ActivityLayout>
