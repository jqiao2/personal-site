---

<ActivityLayout title="Jason's activity log">
	<div class="page">
		<nav class="tabs">
			{nav.map((n) => (
				<a
					class:list={['tabs__link', n.active && 'tabs__link--active']}
					href={n.href}
					aria-current={n.active ? 'page' : undefined}
				>
					{n.label}
				</a>
			))}
		</nav>

		<p class="note">Placeholder landing page — proves ActivityLayout + ActivityCard. The real grid lands separately.</p>

		<section>
			<h2>Tile — landing page top four</h2>
			<div class="grid grid--tile">
				{activities.slice(0, 4).map((a) => <ActivityCard activity={a} size="tile" />)}
			</div>
		</section>

		<section>
			<h2>Row — list view</h2>
			<div class="grid grid--row">
				{activities.map((a) => <ActivityCard activity={a} size="row" />)}
			</div>
		</section>

		<section>
			<h2>Cell — week grid's per-day list</h2>
			<div class="grid grid--cell">
				{activities.map((a) => <ActivityCard activity={a} size="cell" />)}
			</div>
		</section>
	</div>
</ActivityLayout>

<style>
	.page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 2rem 1.5rem 5rem;
	}
	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		padding-bottom: 1.25rem;
		margin-bottom: 1.5rem;
		border-bottom: 1px solid #c9d4dc;
	}
	.tabs__link {
		font-size: 0.9rem;
		color: #6b7b88;
	}
	.tabs__link--active {
		color: #1c6e8c;
		font-weight: 600;
	}
	.note {
		font-size: 0.8rem;
		color: #6b7b88;
		border: 1px dashed #c9d4dc;
		border-radius: 6px;
		padding: 0.5rem 0.75rem;
		display: inline-block;
		margin-bottom: 2rem;
	}
	h2 {
		font-size: 1.4rem;
		margin: 0 0 1rem;
	}
	section {
		margin-bottom: 3rem;
	}
	.grid {
		display: grid;
		gap: 1rem;
	}
	.grid--tile {
		grid-template-columns: repeat(4, 1fr);
	}
	.grid--row {
		grid-template-columns: 1fr;
	}
	.grid--cell {
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
	}
	@media (max-width: 900px) {
		.grid--tile {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
