---
// /activities/athlete — the athlete's own numbers, and their history.
//
// Everything on this page is an INPUT to a score, never a score. FTP, LTHR,
// max/rest HR, threshold pace and CSS are exactly the values src/lib/exertion.ts
// measures an activity against; weight and height are recorded alongside them
// because power-to-weight is the one number a rider actually tracks and it
// needs both.
//
// WHY A TABLE OF ROWS AND NOT A SETTINGS FORM. athlete_thresholds has been
// versioned by effective_from since 0034: the row in force on a date is the
// latest one on or before it, so a ride from March is scored against March's
// FTP no matter what today's is. A single "current values" form would either
// destroy that history or lie about it. The table IS the data model, shown as
// it is stored — and that is also what makes the graph possible at all.
//
// WHY THE GRAPH IS SMALL MULTIPLES. Watts, bpm, seconds-per-mile and pounds
// share no axis, and stacking them on one by normalising each to its own range
// produces a chart where a 2W change and a 20bpm change draw the same line.
// One sparkline per metric, each with its own range printed on it, keeps every
// line honest about what it is measuring. The one exception is FTP and
// power-to-weight, which are the same test divided by the same weight and so
// draw the identical shape twice — they share a card and a switcher instead.
import ActivityLayout from '../../layouts/ActivityLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { requireOwner } from '../../lib/auth';
import { listThresholds, listWeighIns } from '../../lib/activities';
import { ALPINE } from '../../lib/activity-tokens';
import {
	METRICS,
	seriesOf,
	inForceNow,
	weightSeries,
	wPerKgSeries,
	plot,
	trend,
	windowed,
	RANGES,
	DEFAULT_RANGE,
	PLOT_W,
	PLOT_H,
	type Series,
} from '../../lib/athlete';

export const prerender = false;

// OWNER ONLY. These are body measurements, and the page writes.
if (!(await requireOwner(Astro.cookies))) {
	return Astro.redirect(`/films/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

let rows: Awaited<ReturnType<typeof listThresholds>> = [];
let weighIns: Awaited<ReturnType<typeof listWeighIns>> = [];
let unreachable = false;
try {
	[rows, weighIns] = await Promise.all([listThresholds(), listWeighIns()]);
} catch (err) {
	unreachable = true;
	console.error('athlete page: could not read athlete numbers —', err);
}

const latest = rows[0] ?? null;
// Each threshold metric in force now is its latest recorded value, taken field
// by field: a blank on the newest row means "unchanged", so an FTP entered
// alone still shows the earlier LTHR beside it. Weight and W/kg override this
// below — they read the scale.
const current = inForceNow(rows);
// Weight comes from the smart scale (body_weight), so its graph and current
// value read the daily weigh-ins, not the typed threshold rows; power-to-weight
// pairs the FTP in force with the latest weigh-in.
const latestKg = weighIns.length ? weighIns[weighIns.length - 1].weight_kg : (latest?.weight_kg ?? null);
const series = METRICS.filter((m) => !m.noGraph)
	.map((m) =>
		m.key === 'weight_kg' ? weightSeries(weighIns) : m.key === 'w_per_kg' ? wPerKgSeries(rows, weighIns) : seriesOf(m, rows),
	)
	.filter((s) => s.points.length > 0);

// FTP and power-to-weight ride in one card behind a switcher; everything else
// gets its own. A card is a list of series — the first is the one shown.
const PAIRED = ['ftp_w', 'w_per_kg'];
const paired = PAIRED.map((k) => series.find((s) => s.metric.key === k)).filter((s): s is Series => !!s);
const cards: Series[][] = [
	...(paired.length ? [paired] : []),
	...series.filter((s) => !PAIRED.includes(s.metric.key)).map((s) => [s]),
];

// The points the client script redraws from when the timeframe or the shown
// metric changes. Keyed by metric so it can look the formatting up in METRICS.
const seriesData = Object.fromEntries(series.map((s) => [s.metric.key, s.points]));

/** The current display value for the "in force now" grid. Weight and W/kg draw
 *  on the latest weigh-in; every other metric on its latest recorded value. */
function nowDisplay(m: (typeof METRICS)[number]): number | null {
	if (m.key === 'weight_kg') return latestKg == null ? null : m.toDisplay(latestKg);
	if (m.key === 'w_per_kg') return current?.ftp_w && latestKg ? m.toDisplay(current.ftp_w / latestKg) : null;
	const raw = current ? m.read(current) : null;
	return raw == null ? null : m.toDisplay(raw);
}

// The table is a record of what was typed into athlete_thresholds, so it shows
// only those columns — power-to-weight is derived, and weight is scale-fed now,
// so both live in the graph and the summary rather than as a table column.
const columns = METRICS.filter((m) => !m.derived && !m.scaleFed);

const fmtDate = (iso: string) =>
	new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Today, in the athlete's own timezone rather than UTC — the default for a new
// row's effective date. See wiki pattern 0005.
const today = new Date().toLocaleDateString('en-CA');
---

<ActivityLayout title="Athlete · Jason's activity log">
	<div
		class="page"
		style={{
			'--snow': ALPINE.snow,
			'--granite': ALPINE.granite,
			'--granite-soft': ALPINE.graniteSoft,
			'--lake': ALPINE.lake,
			'--lake-deep': ALPINE.lakeDeep,
			'--scree': ALPINE.scree,
			'--fir': ALPINE.fir,
			'--alpenglow': ALPINE.alpenglow,
			'--larch': ALPINE.larch,
		}}
	>
		<div class="card">
			<SiteHeader pathname={Astro.url.pathname} theme="activity" />

			<header class="head">
				<a class="back" href="/activities">← Activity log</a>
				<h1 class="head__title">Athlete</h1>
				<p class="head__sub">
					The numbers every exertion score is measured against. Each row is in force from its date
					until the next one supersedes it.
				</p>
			</header>

			{unreachable && <p class="flash flash--err">Couldn’t reach the database.</p>}

			{
				(latest || latestKg != null) && (
					<section class="now">
						<h2 class="sec">In force now {latest && <span class="sec__note">from {fmtDate(latest.effective_from)}</span>}</h2>
						<dl class="now__grid">
							{METRICS.map((m) => {
								const value = nowDisplay(m);
								return (
									<div class="now__cell">
										<dt>{m.label}</dt>
										<dd>
											{value == null ? <span class="muted">—</span> : (
												<>
													{m.format(value)}
													<span class="unit">{m.unit}</span>
												</>
											)}
										</dd>
									</div>
								);
							})}
						</dl>
					</section>
				)
			}

			{
				cards.length > 0 && (
					<section class="progress">
						<div class="progress__head">
							<h2 class="sec">Progress</h2>
							<div class="toggle" role="group" aria-label="Timeframe">
								{RANGES.map((r) => (
									<button
										type="button"
										class="toggle__btn"
										data-range={r.key}
										aria-pressed={r.key === DEFAULT_RANGE}
									>
										{r.label}
									</button>
								))}
							</div>
						</div>
						<div class="spark__grid">
							{cards.map((group) => {
								const shown = group[0];
								const pts = windowed(shown.points, DEFAULT_RANGE);
								const p = plot(pts)!;
								const t = trend(shown.metric, pts);
								return (
									<figure class="spark" data-card data-key={shown.metric.key}>
										<figcaption class="spark__head">
											{group.length > 1 ? (
												<div class="toggle toggle--sm" role="group" aria-label="Metric">
													{group.map((g, i) => (
														<button
															type="button"
															class="toggle__btn"
															data-metric={g.metric.key}
															aria-pressed={i === 0}
														>
															{g.metric.short ?? g.metric.label}
														</button>
													))}
												</div>
											) : (
												<span class="spark__label">{shown.metric.label}</span>
											)}
											<span class:list={['spark__trend', `spark__trend--${t?.tone ?? 'flat'}`]} data-trend>
												{t?.text ?? ''}
											</span>
										</figcaption>
										<svg class="spark__svg" viewBox={`0 0 ${PLOT_W} ${PLOT_H}`} role="img" data-plot>
											<polyline class="spark__line" points={p.line} data-line />
											<g data-dots>
												{p.dots.map((d) => <circle class="spark__dot" cx={d.x} cy={d.y} r="1.1" />)}
											</g>
										</svg>
										<div class="spark__foot">
											<span class="spark__now" data-now>
												{shown.metric.format(p.last.value)}
												<span class="unit">{shown.metric.unit}</span>
											</span>
											<span class="spark__range" data-range-text>
												{shown.metric.format(p.lo)}–{shown.metric.format(p.hi)}
											</span>
										</div>
									</figure>
								);
							})}
						</div>
						<script id="series-data" type="application/json" set:html={JSON.stringify(seriesData)} is:inline />
					</section>
				)
			}

			<section class="history">
				<h2 class="sec">History</h2>
				{rows.length === 0 ? (
					<p class="muted">Nothing recorded yet. Add the first row below.</p>
				) : (
					<div class="tablewrap">
						<table class="tbl">
							<thead>
								<tr>
									<th scope="col">From</th>
									{columns.map((m) => (
										<th scope="col" class="num">
											{m.label} <span class="unit">{m.unit}</span>
										</th>
									))}
									<th scope="col"><span class="sr">Actions</span></th>
								</tr>
							</thead>
							<tbody>
								{rows.map((r) => (
									<tr data-row={r.id} data-values={JSON.stringify(r)}>
										<th scope="row" class="date">{fmtDate(r.effective_from)}</th>
										{columns.map((m) => {
											const raw = m.read(r);
											return <td class="num">{raw == null ? <span class="muted">—</span> : m.format(m.toDisplay(raw))}</td>;
										})}
										<td class="num">
											<button type="button" class="link" data-edit>Edit</button>
											<button type="button" class="link link--danger" data-delete>Delete</button>
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				)}
			</section>

			<section class="entry">
				<h2 class="sec" id="form-title">Record a change</h2>
				<p class="muted">
					Save under a date that already exists and that row is amended; a new date adds one. Leave a
					field blank to leave it unrecorded.
				</p>
				<form id="thresholds">
					<div class="fields">
						<label class="field">
							Effective from
							<input type="date" name="effectiveFrom" value={today} required />
						</label>
						{columns.map((m) => (
							<label class="field">
								{m.label} <span class="unit">{m.unit}</span>
								<input
									type={m.pace ? 'text' : 'number'}
									name={m.key}
									step={m.pace ? undefined : 'any'}
									inputmode={m.pace ? 'numeric' : undefined}
									placeholder={m.pace ? 'mm:ss' : ''}
									autocomplete="off"
								/>
							</label>
						))}
					</div>
					<div class="actions">
						<button class="btn btn--primary" type="submit">Save</button>
						<button class="btn" type="reset" id="clear">Clear</button>
					</div>
				</form>
				<p id="out" class="out" hidden></p>
				<p class="muted footnote">
					Saving does not re-score activities already imported — they keep the numbers they were
					scored against. To re-run the whole table through the new values:
					<code>node --import ./scripts/ts-hook.mjs --env-file=.env scripts/recompute-exertion.mjs</code>
				</p>
			</section>
		</div>
	</div>
</ActivityLayout>

<script>
	import { METRICS, parsePace, plot, trend, windowed, DEFAULT_RANGE, type RangeKey } from '../../lib/athlete';

	const form = document.getElementById('thresholds') as HTMLFormElement | null;
	const out = document.getElementById('out') as HTMLElement | null;
	const editable = METRICS.filter((m) => !m.derived && !m.scaleFed);

	const say = (text: string, ok: boolean) => {
		if (!out) return;
		out.hidden = false;
		out.textContent = text;
		out.classList.toggle('out--err', !ok);
	};

	// Display units in, stored units out — the same conversions the server used
	// to render the table, imported rather than re-typed.
	function collect(): Record<string, unknown> | string {
		if (!form) return 'no form';
		const data = new FormData(form);
		const body: Record<string, unknown> = { effectiveFrom: data.get('effectiveFrom') };
		for (const m of editable) {
			const raw = String(data.get(m.key) ?? '').trim();
			if (raw === '') {
				body[m.key] = null; // an explicit clear; the field is on screen and empty
				continue;
			}
			const display = m.pace ? parsePace(raw) : Number(raw);
			if (display == null || !Number.isFinite(display)) {
				return `${m.label}: couldn’t read “${raw}”${m.pace ? ' — try mm:ss' : ''}`;
			}
			body[m.key] = m.toStored!(display);
		}
		return body;
	}

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const body = collect();
		if (typeof body === 'string') return say(body, false);
		const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
		btn.disabled = true;
		try {
			const res = await fetch('/api/activities/thresholds', {
				method: 'PUT',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify(body),
			});
			const json = await res.json();
			if (!res.ok) return say(`error: ${json.error ?? res.status}`, false);
			say('Saved.', true);
			setTimeout(() => location.reload(), 500);
		} catch (err) {
			say(`error: ${err instanceof Error ? err.message : err}`, false);
		} finally {
			btn.disabled = false;
		}
	});

	// Edit — load the row into the form rather than editing in place. The form
	// is already the whole vocabulary, and a PUT on an existing effective_from
	// is an amendment, so there is nothing a second editor would add.
	document.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const tr = btn.closest('tr');
			if (!tr || !form) return;
			const row = JSON.parse(tr.dataset.values!);
			(form.elements.namedItem('effectiveFrom') as HTMLInputElement).value = row.effective_from;
			for (const m of editable) {
				const input = form.elements.namedItem(m.key) as HTMLInputElement;
				const raw = row[m.key];
				input.value = raw == null ? '' : m.format(m.toDisplay(raw));
			}
			document.getElementById('form-title')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const tr = btn.closest('tr');
			if (!tr) return;
			const date = tr.querySelector('.date')?.textContent ?? 'this row';
			if (!confirm(`Delete the values effective ${date}? Activities scored against them keep their scores.`)) return;
			btn.disabled = true;
			try {
				const res = await fetch('/api/activities/thresholds', {
					method: 'DELETE',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ id: Number(tr.dataset.row) }),
				});
				const json = await res.json();
				if (!res.ok) {
					btn.disabled = false;
					return say(`error: ${json.error ?? res.status}`, false);
				}
				location.reload();
			} catch (err) {
				btn.disabled = false;
				say(`error: ${err instanceof Error ? err.message : err}`, false);
			}
		});
	});

	// --- Progress graph -----------------------------------------------------
	// Redraws from the same pure helpers the server rendered with, so a toggle
	// produces exactly the shape a fresh load would.
	const dataEl = document.getElementById('series-data');
	if (dataEl) {
		const DATA: Record<string, { date: string; value: number }[]> = JSON.parse(dataEl.textContent ?? '{}');
		const SVG_NS = 'http://www.w3.org/2000/svg';
		let range: RangeKey = DEFAULT_RANGE;

		function drawCard(card: HTMLElement) {
			const metric = METRICS.find((m) => m.key === card.dataset.key);
			const points = metric && DATA[metric.key];
			if (!metric || !points) return;
			const pts = windowed(points, range);
			const p = plot(pts);
			if (!p) return;
			const t = trend(metric, pts);

			card.querySelector('[data-line]')!.setAttribute('points', p.line);
			const dots = card.querySelector('[data-dots]')!;
			dots.textContent = '';
			for (const d of p.dots) {
				const c = document.createElementNS(SVG_NS, 'circle');
				c.setAttribute('class', 'spark__dot');
				c.setAttribute('cx', String(d.x));
				c.setAttribute('cy', String(d.y));
				c.setAttribute('r', '1.1');
				dots.appendChild(c);
			}
			const trendEl = card.querySelector('[data-trend]') as HTMLElement;
			trendEl.textContent = t?.text ?? '';
			trendEl.className = `spark__trend spark__trend--${t?.tone ?? 'flat'}`;
			card.querySelector('[data-now]')!.innerHTML =
				`${metric.format(p.last.value)}<span class="unit">${metric.unit}</span>`;
			card.querySelector('[data-range-text]')!.textContent =
				`${metric.format(p.lo)}–${metric.format(p.hi)}`;
		}

		const cards = () => document.querySelectorAll<HTMLElement>('[data-card]');
		const press = (group: Element, active: Element) =>
			group.querySelectorAll('[aria-pressed]').forEach((b) => b.setAttribute('aria-pressed', String(b === active)));

		document.querySelectorAll<HTMLButtonElement>('[data-range]').forEach((btn) => {
			btn.addEventListener('click', () => {
				range = btn.dataset.range as RangeKey;
				press(btn.parentElement!, btn);
				cards().forEach(drawCard);
			});
		});

		document.querySelectorAll<HTMLButtonElement>('[data-metric]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const card = btn.closest('[data-card]') as HTMLElement;
				card.dataset.key = btn.dataset.metric!;
				press(btn.parentElement!, btn);
				drawCard(card);
			});
		});
	}
</script>

<style>
	.page {
		min-height: 100dvh;
		background: var(--snow);
		color: var(--granite);
		padding: clamp(1rem, 4vw, 3rem);
	}
	.card {
		max-width: 72rem;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}
	.head { display: flex; flex-direction: column; gap: 0.35rem; }
	.back { color: var(--lake); text-decoration: none; font-size: 0.85rem; }
	.head__title { margin: 0; font-size: 1.6rem; }
	.head__sub { margin: 0; max-width: 46ch; color: var(--granite-soft); font-size: 0.9rem; line-height: 1.5; }
	.sec {
		margin: 0 0 0.75rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--granite-soft);
	}
	.sec__note { font-weight: 400; letter-spacing: 0; text-transform: none; }
	.muted { color: var(--granite-soft); }
	.unit { color: var(--granite-soft); font-size: 0.8em; margin-left: 0.2em; font-weight: 400; }
	.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

	/* --- In force now ----------------------------------------------------- */
	.now__grid {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
		gap: 0.6rem;
	}
	.now__cell {
		padding: 0.7rem 0.85rem;
		border: 1px solid var(--scree);
		border-radius: 0.6rem;
	}
	.now__cell dt { font-size: 0.75rem; color: var(--granite-soft); }
	.now__cell dd { margin: 0.15rem 0 0; font-size: 1.25rem; font-variant-numeric: tabular-nums; }

	/* --- Progress --------------------------------------------------------- */
	.progress__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
	.toggle { display: inline-flex; border: 1px solid var(--scree); border-radius: 0.5rem; overflow: hidden; }
	.toggle__btn {
		border: 0;
		padding: 0.3rem 0.6rem;
		background: var(--snow);
		color: var(--granite-soft);
		font: inherit;
		font-size: 0.72rem;
		line-height: 1.2;
		cursor: pointer;
	}
	.toggle__btn + .toggle__btn { border-left: 1px solid var(--scree); }
	.toggle__btn[aria-pressed='true'] { background: var(--lake); color: var(--snow); }
	.toggle--sm .toggle__btn { padding: 0.2rem 0.45rem; font-size: 0.68rem; }

	/* Two columns on a phone: these cards are a label, a line and a number, and
	   one per row turned the section into a page of scrolling. */
	.spark__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
		gap: 0.75rem;
	}
	.spark {
		margin: 0;
		padding: 0.6rem 0.7rem 0.5rem;
		border: 1px solid var(--scree);
		border-radius: 0.6rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
		/* Wraps as a whole line rather than mid-number: the FTP/W-kg card's switcher
	   and its delta do not both fit across a phone column. */
	.spark__head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.3rem; flex-wrap: wrap; }
	.spark__label { font-size: 0.8rem; color: var(--granite-soft); }
	.spark__trend { font-size: 0.72rem; font-variant-numeric: tabular-nums; white-space: nowrap; margin-left: auto; }
	.spark__trend--good { color: var(--fir); }
	.spark__trend--bad { color: var(--alpenglow); }
	.spark__trend--flat { color: var(--granite-soft); }
	/* No preserveAspectRatio override: uniform scaling is what keeps the dots
	   round. Height follows the viewBox rather than being pinned. */
	.spark__svg { width: 100%; height: auto; overflow: visible; }
	.spark__line { fill: none; stroke: var(--lake); stroke-width: 1.2; vector-effect: non-scaling-stroke; }
	:global(.spark__dot) { fill: var(--lake); }
	.spark__foot { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; }
	.spark__now { font-size: 1.05rem; font-variant-numeric: tabular-nums; }
	/* The unit span inside is rebuilt by the toggle script, so the scoped .unit
	   rule never reaches it. */
	.spark__now :global(.unit) { color: var(--granite-soft); font-size: 0.8em; margin-left: 0.2em; }
	.spark__range { font-size: 0.72rem; color: var(--granite-soft); font-variant-numeric: tabular-nums; }

	/* --- History ---------------------------------------------------------- */
	.tablewrap { overflow-x: auto; }
