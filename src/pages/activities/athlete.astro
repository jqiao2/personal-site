---
// /activities/athlete — the athlete's own numbers, and their history.
//
// Everything on this page is an INPUT to a score, never a score. FTP, LTHR,
// max/rest HR, threshold pace and CSS are exactly the values src/lib/exertion.ts
// measures an activity against; weight and height are recorded alongside them
// because power-to-weight is the one number a rider actually tracks and it
// needs both.
//
// WHY A TABLE OF ROWS AND NOT A SETTINGS FORM. athlete_thresholds has been
// versioned by effective_from since 0034: the row in force on a date is the
// latest one on or before it, so a ride from March is scored against March's
// FTP no matter what today's is. A single "current values" form would either
// destroy that history or lie about it. The table IS the data model, shown as
// it is stored — and that is also what makes the graph possible at all.
//
// WHY THE GRAPH IS SMALL MULTIPLES. Watts, bpm, seconds-per-mile and pounds
// share no axis, and stacking them on one by normalising each to its own range
// produces a chart where a 2W change and a 20bpm change draw the same line.
// One sparkline per metric, each with its own range printed on it, keeps every
// line honest about what it is measuring.
import ActivityLayout from '../../layouts/ActivityLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { requireOwner } from '../../lib/auth';
import { listThresholds } from '../../lib/activities';
import { ALPINE } from '../../lib/activity-tokens';
import { METRICS, seriesOf, inForceNow, type Series } from '../../lib/athlete';

export const prerender = false;

// OWNER ONLY. These are body measurements, and the page writes.
if (!(await requireOwner(Astro.cookies))) {
	return Astro.redirect(`/films/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

let rows: Awaited<ReturnType<typeof listThresholds>> = [];
let unreachable = false;
try {
	rows = await listThresholds();
} catch (err) {
	unreachable = true;
	console.error('athlete page: could not read athlete_thresholds —', err);
}

const current = inForceNow(rows);
const series = METRICS.map((m) => seriesOf(m, rows)).filter((s) => s.points.length > 0);
// The table is a record of what was entered, so it shows only the columns that
// exist — power-to-weight is computed from two of them and lives in the graph
// and the summary, where it isn't also the column that pushes the row off the
// right edge.
const columns = METRICS.filter((m) => !m.derived);

// The sparkline. A plain polyline in a 0..100 × 0..30 box, stretched by the
// SVG's own preserveAspectRatio="none" — no axes, because the two labels
// printed beside it (range, latest) say everything an axis would and take a
// tenth of the room.
const PLOT_W = 100;
const PLOT_H = 30;
function plot(s: Series) {
	const values = s.points.map((p) => p.value);
	const lo = Math.min(...values);
	const hi = Math.max(...values);
	const flat = hi === lo;
	// Time on x, so a long gap between two tests reads as a long gap. A single
	// point sits in the middle rather than dividing by zero.
	const times = s.points.map((p) => Date.parse(p.date));
	const t0 = times[0];
	const tSpan = times[times.length - 1] - t0 || 1;
	const xy = s.points.map((p, i) => {
		const x = times.length === 1 ? PLOT_W / 2 : ((times[i] - t0) / tSpan) * PLOT_W;
		// Inverted: SVG y grows downward, and a bigger number should sit higher.
		// A metric that never moved has no range to scale against, and dividing
		// by its zero span would pin it to the floor as if it were a minimum —
		// so it draws down the middle, which is what "unchanged" looks like.
		const y = flat ? PLOT_H / 2 : PLOT_H - ((p.value - lo) / (hi - lo)) * (PLOT_H - 4) - 2;
		return { x, y };
	});
	return {
		lo,
		hi,
		points: xy.map((p) => `${p.x.toFixed(2)},${p.y.toFixed(2)}`).join(' '),
		dots: xy,
		last: s.points[s.points.length - 1],
		first: s.points[0],
	};
}

// The "since the first reading" delta, rendered as a signed number plus a
// judgement (good/bad/neutral) taken from the metric's own direction — a
// falling threshold pace is an improvement, a falling FTP is not.
function trend(s: Series) {
	if (s.points.length < 2) return null;
	const from = s.points[0].value;
	const to = s.points[s.points.length - 1].value;
	const delta = to - from;
	if (delta === 0) return { text: 'no change', tone: 'flat' as const };
	const rising = delta > 0;
	const tone =
		s.metric.better === 'none' ? ('flat' as const) : (rising === (s.metric.better === 'up') ? 'good' : 'bad') as 'good' | 'bad';
	const magnitude = s.metric.pace ? s.metric.format(Math.abs(delta)) : s.metric.format(Math.abs(delta));
	return { text: `${rising ? '+' : '−'}${magnitude} ${s.metric.unit}`, tone };
}

const fmtDate = (iso: string) =>
	new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Today, in the athlete's own timezone rather than UTC — the default for a new
// row's effective date. See wiki pattern 0005.
const today = new Date().toLocaleDateString('en-CA');
---

<ActivityLayout title="Athlete · Jason's activity log">
	<div
		class="page"
		style={{
			'--snow': ALPINE.snow,
			'--granite': ALPINE.granite,
			'--granite-soft': ALPINE.graniteSoft,
			'--lake': ALPINE.lake,
			'--lake-deep': ALPINE.lakeDeep,
			'--scree': ALPINE.scree,
			'--fir': ALPINE.fir,
			'--alpenglow': ALPINE.alpenglow,
			'--larch': ALPINE.larch,
		}}
	>
		<div class="card">
			<SiteHeader pathname={Astro.url.pathname} theme="activity" />

			<header class="head">
				<a class="back" href="/activities">← Activity log</a>
				<h1 class="head__title">Athlete</h1>
				<p class="head__sub">
					The numbers every exertion score is measured against. Each row is in force from its date
					until the next one supersedes it.
				</p>
			</header>

			{unreachable && <p class="flash flash--err">Couldn’t reach the database.</p>}

			{
				current && (
					<section class="now">
						<h2 class="sec">In force now <span class="sec__note">from {fmtDate(current.effective_from)}</span></h2>
						<dl class="now__grid">
							{METRICS.map((m) => {
								const raw = m.read(current);
								return (
									<div class="now__cell">
										<dt>{m.label}</dt>
										<dd>
											{raw == null ? <span class="muted">—</span> : (
												<>
													{m.format(m.toDisplay(raw))}
													<span class="unit">{m.unit}</span>
												</>
											)}
										</dd>
									</div>
								);
							})}
						</dl>
					</section>
				)
			}

			{
				series.length > 0 && (
					<section class="progress">
						<h2 class="sec">Progress</h2>
						<div class="spark__grid">
							{series.map((s) => {
								const p = plot(s);
								const t = trend(s);
								return (
									<figure class="spark">
										<figcaption class="spark__head">
											<span class="spark__label">{s.metric.label}</span>
											{t && <span class:list={['spark__trend', `spark__trend--${t.tone}`]}>{t.text}</span>}
										</figcaption>
										<svg
											class="spark__svg"
											viewBox={`0 0 ${PLOT_W} ${PLOT_H}`}
											preserveAspectRatio="none"
											role="img"
											aria-label={`${s.metric.label}: ${s.metric.format(p.first.value)} on ${fmtDate(p.first.date)} to ${s.metric.format(p.last.value)} on ${fmtDate(p.last.date)} ${s.metric.unit}`}
										>
											<polyline class="spark__line" points={p.points} />
											{p.dots.map((d) => <circle class="spark__dot" cx={d.x} cy={d.y} r="1.4" />)}
										</svg>
										<div class="spark__foot">
											<span class="spark__now">
												{s.metric.format(p.last.value)}
												<span class="unit">{s.metric.unit}</span>
											</span>
											<span class="spark__range">
												{s.metric.format(p.lo)}–{s.metric.format(p.hi)}
											</span>
										</div>
									</figure>
								);
							})}
						</div>
					</section>
				)
			}

			<section class="history">
				<h2 class="sec">History</h2>
				{rows.length === 0 ? (
					<p class="muted">Nothing recorded yet. Add the first row below.</p>
				) : (
					<div class="tablewrap">
						<table class="tbl">
							<thead>
								<tr>
									<th scope="col">From</th>
									{columns.map((m) => (
										<th scope="col" class="num">
											{m.label} <span class="unit">{m.unit}</span>
										</th>
									))}
									<th scope="col"><span class="sr">Actions</span></th>
								</tr>
							</thead>
							<tbody>
								{rows.map((r) => (
									<tr data-row={r.id} data-values={JSON.stringify(r)}>
										<th scope="row" class="date">{fmtDate(r.effective_from)}</th>
										{columns.map((m) => {
											const raw = m.read(r);
											return <td class="num">{raw == null ? <span class="muted">—</span> : m.format(m.toDisplay(raw))}</td>;
										})}
										<td class="num">
											<button type="button" class="link" data-edit>Edit</button>
											<button type="button" class="link link--danger" data-delete>Delete</button>
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				)}
			</section>

			<section class="entry">
				<h2 class="sec" id="form-title">Record a change</h2>
				<p class="muted">
					Save under a date that already exists and that row is amended; a new date adds one. Leave a
					field blank to leave it unrecorded.
				</p>
				<form id="thresholds">
					<div class="fields">
						<label class="field">
							Effective from
							<input type="date" name="effectiveFrom" value={today} required />
						</label>
						{columns.map((m) => (
							<label class="field">
								{m.label} <span class="unit">{m.unit}</span>
								<input
									type={m.pace ? 'text' : 'number'}
									name={m.key}
									step={m.pace ? undefined : 'any'}
									inputmode={m.pace ? 'numeric' : undefined}
									placeholder={m.pace ? 'mm:ss' : ''}
									autocomplete="off"
								/>
							</label>
						))}
					</div>
					<div class="actions">
						<button class="btn btn--primary" type="submit">Save</button>
						<button class="btn" type="reset" id="clear">Clear</button>
					</div>
				</form>
				<p id="out" class="out" hidden></p>
				<p class="muted footnote">
					Saving does not re-score activities already imported — they keep the numbers they were
					scored against. To re-run the whole table through the new values:
					<code>node --import ./scripts/ts-hook.mjs --env-file=.env scripts/recompute-exertion.mjs</code>
				</p>
			</section>
		</div>
	</div>
</ActivityLayout>

<script>
	import { METRICS, parsePace } from '../../lib/athlete';

	const form = document.getElementById('thresholds') as HTMLFormElement | null;
	const out = document.getElementById('out') as HTMLElement | null;
	const editable = METRICS.filter((m) => !m.derived);

	const say = (text: string, ok: boolean) => {
		if (!out) return;
		out.hidden = false;
		out.textContent = text;
		out.classList.toggle('out--err', !ok);
	};

	// Display units in, stored units out — the same conversions the server used
	// to render the table, imported rather than re-typed.
	function collect(): Record<string, unknown> | string {
		if (!form) return 'no form';
		const data = new FormData(form);
		const body: Record<string, unknown> = { effectiveFrom: data.get('effectiveFrom') };
		for (const m of editable) {
			const raw = String(data.get(m.key) ?? '').trim();
			if (raw === '') {
				body[m.key] = null; // an explicit clear; the field is on screen and empty
				continue;
			}
			const display = m.pace ? parsePace(raw) : Number(raw);
			if (display == null || !Number.isFinite(display)) {
				return `${m.label}: couldn’t read “${raw}”${m.pace ? ' — try mm:ss' : ''}`;
			}
			body[m.key] = m.toStored!(display);
		}
		return body;
	}

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const body = collect();
		if (typeof body === 'string') return say(body, false);
		const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
		btn.disabled = true;
		try {
			const res = await fetch('/api/activities/thresholds', {
				method: 'PUT',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify(body),
			});
			const json = await res.json();
			if (!res.ok) return say(`error: ${json.error ?? res.status}`, false);
			say('Saved.', true);
			setTimeout(() => location.reload(), 500);
		} catch (err) {
			say(`error: ${err instanceof Error ? err.message : err}`, false);
		} finally {
			btn.disabled = false;
		}
	});

	// Edit — load the row into the form rather than editing in place. The form
	// is already the whole vocabulary, and a PUT on an existing effective_from
	// is an amendment, so there is nothing a second editor would add.
	document.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const tr = btn.closest('tr');
			if (!tr || !form) return;
			const row = JSON.parse(tr.dataset.values!);
			(form.elements.namedItem('effectiveFrom') as HTMLInputElement).value = row.effective_from;
			for (const m of editable) {
				const input = form.elements.namedItem(m.key) as HTMLInputElement;
				const raw = row[m.key];
				input.value = raw == null ? '' : m.format(m.toDisplay(raw));
			}
			document.getElementById('form-title')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const tr = btn.closest('tr');
			if (!tr) return;
			const date = tr.querySelector('.date')?.textContent ?? 'this row';
			if (!confirm(`Delete the values effective ${date}? Activities scored against them keep their scores.`)) return;
			btn.disabled = true;
			try {
				const res = await fetch('/api/activities/thresholds', {
					method: 'DELETE',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ id: Number(tr.dataset.row) }),
				});
				const json = await res.json();
				if (!res.ok) {
					btn.disabled = false;
					return say(`error: ${json.error ?? res.status}`, false);
				}
				location.reload();
			} catch (err) {
				btn.disabled = false;
				say(`error: ${err instanceof Error ? err.message : err}`, false);
			}
		});
	});
</script>

<style>
	.page {
		min-height: 100dvh;
		background: var(--snow);
		color: var(--granite);
		padding: clamp(1rem, 4vw, 3rem);
	}
	.card {
		max-width: 72rem;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}
	.head { display: flex; flex-direction: column; gap: 0.35rem; }
	.back { color: var(--lake); text-decoration: none; font-size: 0.85rem; }
	.head__title { margin: 0; font-size: 1.6rem; }
	.head__sub { margin: 0; max-width: 46ch; color: var(--granite-soft); font-size: 0.9rem; line-height: 1.5; }
	.sec {
		margin: 0 0 0.75rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--granite-soft);
	}
	.sec__note { font-weight: 400; letter-spacing: 0; text-transform: none; }
	.muted { color: var(--granite-soft); }
	.unit { color: var(--granite-soft); font-size: 0.8em; margin-left: 0.2em; font-weight: 400; }
	.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

	/* --- In force now ----------------------------------------------------- */
	.now__grid {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
		gap: 0.6rem;
	}
	.now__cell {
		padding: 0.7rem 0.85rem;
		border: 1px solid var(--scree);
		border-radius: 0.6rem;
	}
	.now__cell dt { font-size: 0.75rem; color: var(--granite-soft); }
	.now__cell dd { margin: 0.15rem 0 0; font-size: 1.25rem; font-variant-numeric: tabular-nums; }

	/* --- Progress --------------------------------------------------------- */
	.spark__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
		gap: 1rem;
	}
	.spark {
		margin: 0;
		padding: 0.7rem 0.85rem 0.6rem;
		border: 1px solid var(--scree);
		border-radius: 0.6rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.spark__head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; }
	.spark__label { font-size: 0.8rem; color: var(--granite-soft); }
	.spark__trend { font-size: 0.72rem; font-variant-numeric: tabular-nums; }
	.spark__trend--good { color: var(--fir); }
	.spark__trend--bad { color: var(--alpenglow); }
	.spark__trend--flat { color: var(--granite-soft); }
	.spark__svg { width: 100%; height: 46px; overflow: visible; }
	.spark__line { fill: none; stroke: var(--lake); stroke-width: 1.2; vector-effect: non-scaling-stroke; }
	.spark__dot { fill: var(--lake); }
	.spark__foot { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; }
	.spark__now { font-size: 1.05rem; font-variant-numeric: tabular-nums; }
	.spark__range { font-size: 0.72rem; color: var(--granite-soft); font-variant-numeric: tabular-nums; }

	/* --- History ---------------------------------------------------------- */
	.tablewrap { overflow-x: auto; }
	.tbl { border-collapse: collapse; width: 100%; font-size: 0.88rem; }
	.tbl th, .tbl td { padding: 0.45rem 0.6rem; text-align: left; white-space: nowrap; }
	.tbl thead th {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--granite-soft);
		border-bottom: 1px solid var(--scree);
	}
	.tbl tbody tr + tr th, .tbl tbody tr + tr td { border-top: 1px solid var(--scree); }
	.tbl .num { text-align: right; font-variant-numeric: tabular-nums; }
	.tbl thead .num { text-align: right; }
	.tbl .date { font-weight: 500; }
	.tbl tbody tr:first-child { background: color-mix(in srgb, var(--lake) 6%, transparent); }

	.link {
		background: none;
		border: 0;
		padding: 0 0 0 0.6rem;
		color: var(--lake);
		font: inherit;
		font-size: 0.82rem;
		cursor: pointer;
	}
	.link--danger { color: var(--alpenglow); }
	.link:disabled { opacity: 0.5; cursor: default; }

	/* --- Entry ------------------------------------------------------------ */
	.entry .muted { font-size: 0.85rem; max-width: 60ch; margin: 0 0 0.9rem; line-height: 1.5; }
	.fields {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
		gap: 0.75rem;
	}
	.field { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.8rem; color: var(--granite-soft); }
	.field input {
		padding: 0.45rem 0.55rem;
		border: 1px solid var(--scree);
		border-radius: 0.5rem;
		background: var(--snow);
		color: var(--granite);
		font: inherit;
		font-variant-numeric: tabular-nums;
	}
	.field input:focus-visible { outline: 2px solid var(--lake); outline-offset: 1px; }
	.actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1rem; }
	.btn {
		padding: 0.5rem 1rem;
		border: 1px solid var(--scree);
		border-radius: 0.5rem;
		background: var(--snow);
		color: var(--granite);
		font: inherit;
		cursor: pointer;
	}
	.btn--primary { background: var(--lake); border-color: var(--lake-deep); color: var(--snow); }
	.btn:disabled { opacity: 0.6; cursor: default; }
	.out { margin: 0.75rem 0 0; font-size: 0.85rem; color: var(--fir); }
	.out--err { color: var(--alpenglow); }
	.footnote { margin-top: 1.25rem; font-size: 0.78rem; }
	.footnote code {
		display: block;
		margin-top: 0.3rem;
		font-size: 0.92em;
		overflow-wrap: anywhere;
	}
	.flash { margin: 0; padding: 0.5rem 0.75rem; border-radius: 0.5rem; font-size: 0.9rem; }
	.flash--err { background: color-mix(in srgb, #c0392b 12%, transparent); color: #c0392b; }
</style>
