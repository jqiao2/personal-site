---
// "The month in activities" — a share card, same family as /films/month and
// /books/month: a fixed 1080-wide artboard rendered at full size and scaled
// down by a transform on its wrapper, so a PNG export captures the drawing at
// share resolution rather than at whatever size the screen happened to show it.
//
// THE ONE RULE THAT DIFFERENTIATES THIS CARD. The film card stacks a day's
// posters, best on top, and shows the count of the rest in a badge. This card
// draws only the day's dominant activity — the one with the highest
// `exertion` — and nothing else, not even faded behind it. See
// src/lib/activity-month.ts's header comment for the full argument; the short
// version is that the landing page is a record you read (so it lists
// everything) and this is a picture you post (so it says one true thing per
// day). A day with a commute, a swim and a five-hour ride shows the ride.
//
// Everything the calendar/artboard needs is shared with the film and reading
// cards via share-card.ts, re-exported through activity-month.ts, which also
// owns what's this card's own: the dominance sort, the per-cell face (a
// stroked route or a sport glyph + headline figure), and the four summary
// figures.
import ActivityLayout from '../../../layouts/ActivityLayout.astro';
import { listActivitiesForMonth } from '../../../lib/activities';
import { supabasePublic } from '../../../lib/supabase';
import { siteDay } from '../../../lib/day';
import {
	ALPINE,
	ASPECTS,
	CARD_WIDTH,
	MONTH_ABBR,
	WEEKDAYS,
	aspectBySlug,
	buildCells,
	cellIcon,
	cellInk,
	geometries,
	headlineStat,
	monthKey,
	monthLabel,
	monthQuery,
	parseMonthKey,
	shiftMonth,
	summarise,
	weekRows,
} from '../../../lib/activity-month';

// Rendered on demand — reflects the live database.
export const prerender = false;

const key = Astro.params.month ?? '';
const parsed = parseMonthKey(key);
// Anything that isn't a YYYY-MM lands on the current month rather than 404ing —
// /activities/month is a reasonable thing to type, same convention as /films/month.
if (!parsed) return Astro.redirect(`/activities/month/${siteDay().slice(0, 7)}`, 302);

const aspect = aspectBySlug(Astro.url.searchParams.get('fmt'));
const query = monthQuery(aspect);

// activity_months is the same rollup view listActivitiesForMonth's sibling
// track built for the month index — read directly here (a plain view select,
// nothing owned by another track) so the picker can show a count per month
// without a network round trip per tile. Degrades to an empty map rather than
// throwing: a missing/un-migrated view must not 500 this page's picker.
async function monthCounts(): Promise<Record<string, number>> {
	const { data, error } = await supabasePublic.from('activity_months').select('month_key, activity_count');
	if (error) return {};
	const out: Record<string, number> = {};
	for (const row of (data ?? []) as { month_key: string; activity_count: number }[]) {
		out[row.month_key] = row.activity_count;
	}
	return out;
}

const [activities, counts] = await Promise.all([listActivitiesForMonth(key), monthCounts()]);

const rows = weekRows(key);
const geometry = geometries(rows);
const initial = geometry[aspect.id];
const cells = buildCells(key, activities);
const summary = summarise(key, activities);
const label = monthLabel(key);
const isEmpty = activities.length === 0;

const pickerMonths = MONTH_ABBR.map((abbr, i) => {
	const monthId = monthKey(parsed.year, i + 1);
	const count = counts[monthId] ?? 0;
	return {
		abbr,
		key: monthId,
		count: count ? `${count} ${count === 1 ? 'activity' : 'activities'}` : '—',
		current: monthId === key,
	};
});

// Everything the controls need, handed over as data rather than recomputed —
// mirrors the film card's clientData exactly.
const clientData = JSON.stringify({
	key,
	width: CARD_WIDTH,
	counts,
	geometry,
	aspect: aspect.slug,
	slugs: Object.fromEntries(ASPECTS.map((a) => [a.id, a.slug])),
});
---

<ActivityLayout title={`${label} in activities — Jason's activity log`}>
	<div class="page" style={{ '--sky': ALPINE.sky, '--snow': ALPINE.snow, '--granite': ALPINE.granite, '--scree': ALPINE.scree, '--lake': ALPINE.lake }}>
		<div class="wrap">
			<header class="topbar">
				<a class="back" href="/activities">
					<span class="back__arrow">←</span><span>Activity log</span>
				</a>
				<span class="topbar__tag">Share</span>
			</header>

			<div class="titleblock">
				<h1>Month in activities</h1>
				<span class="dims" data-dims>
					{CARD_WIDTH} × {aspect.height} · {aspect.id}
				</span>
			</div>

			<!-- Controls: screen only, never part of the exported card. -->
			<div class="controls">
				<div class="stepper" data-picker>
					<a
						class="step"
						href={`/activities/month/${shiftMonth(key, -1)}${query}`}
						data-month-link={`/activities/month/${shiftMonth(key, -1)}`}
						aria-label="Previous month">←</a
					>
					<button class="step step--month" type="button" data-picker-toggle>
						<span>{label}</span><span class="step__caret">▾</span>
					</button>
					<a
						class="step"
						href={`/activities/month/${shiftMonth(key, 1)}${query}`}
						data-month-link={`/activities/month/${shiftMonth(key, 1)}`}
						aria-label="Next month">→</a
					>

					<div class="picker" hidden data-picker-panel>
						<div class="picker__head">
							<button type="button" data-picker-year="-1" aria-label="Previous year">←</button>
							<span data-picker-label>{parsed.year}</span>
							<button type="button" data-picker-year="1" aria-label="Next year">→</button>
						</div>
						<div class="picker__grid">
							{
								pickerMonths.map((m) => (
									<a
										class:list={['picker__month', m.current && 'is-on']}
										href={`/activities/month/${m.key}${query}`}
										data-picker-month
									>
										<span class="picker__abbr">{m.abbr}</span>
										<span class="picker__count">{m.count}</span>
									</a>
								))
							}
						</div>
					</div>
				</div>

				<div class="aspects">
					{
						ASPECTS.map((a) => (
							<button
								class:list={['aspect', a.id === aspect.id && 'is-on']}
								type="button"
								data-aspect={a.id}
								data-height={a.height}
							>
								{a.label}
							</button>
						))
					}
				</div>

				<div class="actions">
					<button class="btn" type="button" data-copy>Copy link</button>
					<button class="btn btn--primary" type="button" data-download>Download image</button>
				</div>
			</div>

			<!-- The card. -->
			<div class="stage">
				<div class="viewport" data-viewport>
					<div class="scaler">
						<div
							class:list={['card', initial.figures && 'card--figures']}
							data-card
							style={`--cell:${initial.cell}px; --card-h:${initial.height}px; --grid-w:${initial.grid}px`}
						>
							<div class="card__head">
								<div class="eyebrow">Month in activities</div>
								<div class="card__month">{label}</div>
							</div>

							<div class="calendar">
								<div class="weekdays">
									{WEEKDAYS.map((w) => <div>{w}</div>)}
								</div>

								<div class="grid">
									{
										cells.map((cell) =>
											cell.outside ? (
												<div class="cell" />
											) : !cell.activity ? (
												<div class="cell">
													<div class="numeral">{cell.date}</div>
												</div>
											) : (
												<div class="cell" data-lines={cell.count > 1 ? cell.lines.join('\n') : undefined}>
													<div class="face" style={`--ink:${cellInk(cell.activity)}`}>
														<div class="face__date">{cell.date}</div>
														{cell.activity.route_path ? (
															<svg class="route" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
																<path
																	d={cell.activity.route_path}
																	fill="none"
																	stroke="var(--ink)"
																	stroke-width="3.2"
																	stroke-linecap="round"
																	stroke-linejoin="round"
																	vector-effect="non-scaling-stroke"
																/>
															</svg>
														) : (
															<div class="noroute">
																<svg
																	class="noroute__icon"
																	viewBox="0 0 24 24"
																	fill="none"
																	stroke="var(--ink)"
																	stroke-width="1.6"
																	aria-hidden="true"
																>
																	<path d={cellIcon(cell.activity)} />
																</svg>
																<div class="noroute__value">{headlineStat(cell.activity).value}</div>
															</div>
														)}
														{cell.count > 1 && <div class="badge">{cell.count}</div>}
													</div>
												</div>
											),
										)
									}
								</div>
								{isEmpty && <div class="card__empty">No activities logged in {label}</div>}
							</div>

							<div class="summary">
								{
									summary.map((stat) => (
										<div class="summary__item">
											<div class="summary__label">{stat.label}</div>
											<div class="summary__value">{stat.value}</div>
										</div>
									))
								}
							</div>

							<div class="card__foot">
								<span>jqiao.vercel.app</span>
								<span>Ranked by exertion, hardest on top</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Tooltips live outside the scaled/exported artboard so their text stays
			     screen-resolution sharp and never gets swept into the PNG. Positioned
			     over the card via JS on hover. -->
			<div class="tip" hidden data-tip></div>
		</div>
	</div>

	<div class="toast" hidden data-toast></div>

	<script type="application/json" data-month-data set:html={clientData} />
</ActivityLayout>

<style>
	.page {
		min-height: 100vh;
		display: flex;
		justify-content: center;
		padding: 0 24px 90px;
	}
	.wrap {
		width: 100%;
		max-width: 900px;
		position: relative;
	}

	/* ---- chrome ---- */
	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 26px 0 22px;
		border-bottom: 1px solid var(--scree);
		margin-bottom: 30px;
	}
	.back {
		display: flex;
		align-items: center;
		gap: 9px;
		font-size: 13px;
		color: var(--granite);
		opacity: 0.7;
	}
	.back:hover {
		opacity: 1;
		color: var(--lake);
	}
	.back__arrow {
		font-size: 15px;
	}
	.topbar__tag {
		font-size: 11.5px;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: var(--granite);
		opacity: 0.55;
	}
	.titleblock {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
		margin-bottom: 22px;
	}
	h1 {
		font-family: 'Instrument Serif', Georgia, serif;
		font-weight: 400;
		font-size: 42px;
		color: var(--granite);
		letter-spacing: -0.3px;
		line-height: 1;
		margin: 0;
	}
	.dims {
		font-size: 12.5px;
		color: var(--granite);
		opacity: 0.6;
		padding-bottom: 6px;
	}

	/* ---- controls ---- */
	.controls {
		background: var(--snow);
		border: 1px solid var(--scree);
		border-radius: 12px;
		padding: 16px 18px;
		display: flex;
		align-items: center;
		gap: 26px;
		flex-wrap: wrap;
		margin-bottom: 30px;
	}
	.stepper {
		position: relative;
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.step {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 8px;
		border: 1px solid var(--scree);
		background: var(--snow);
		color: var(--granite);
		font-size: 14px;
		font-family: inherit;
		cursor: pointer;
	}
	.step:hover {
		border-color: var(--lake);
		color: var(--lake);
	}
	.step--month {
		justify-content: space-between;
		gap: 10px;
		min-width: 168px;
		width: auto;
		padding: 0 12px;
		color: var(--granite);
		font-size: 13px;
	}
	.step__caret {
		font-size: 9px;
		opacity: 0.6;
	}
	.picker {
		position: absolute;
		left: 0;
		top: calc(100% + 8px);
		z-index: 40;
		background: var(--snow);
		border: 1px solid var(--scree);
		border-radius: 10px;
		padding: 12px;
		width: 290px;
		box-shadow: 0 20px 44px -14px rgba(61, 74, 85, 0.28);
	}
	.picker__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 10px;
		font-family: 'Instrument Serif', Georgia, serif;
		font-size: 19px;
		color: var(--granite);
	}
	.picker__head button {
		width: 24px;
		height: 24px;
		border: none;
		background: none;
		color: var(--granite);
		opacity: 0.6;
		cursor: pointer;
		font-size: 13px;
	}
	.picker__head button:hover {
		opacity: 1;
	}
	.picker__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 5px;
	}
	.picker__month {
		display: block;
		text-align: center;
		padding: 8px 0;
		border-radius: 7px;
		border: 1px solid transparent;
		color: var(--granite);
	}
	.picker__month:hover {
		background: var(--sky);
		color: var(--granite);
	}
	.picker__month.is-on {
		color: var(--lake);
		background: var(--sky);
		border-color: var(--lake);
	}
	.picker__abbr {
		display: block;
		font-size: 12px;
	}
	.picker__count {
		display: block;
		font-size: 10px;
		color: var(--granite);
		opacity: 0.6;
		margin-top: 2px;
	}
	.aspects {
		display: flex;
		align-items: center;
		gap: 4px;
		border: 1px solid var(--scree);
		border-radius: 8px;
		padding: 3px;
		background: var(--sky);
	}
	.aspect {
		padding: 6px 13px;
		border: none;
		border-radius: 6px;
		background: transparent;
		color: var(--granite);
		opacity: 0.65;
		font-size: 12.5px;
		font-family: inherit;
		cursor: pointer;
	}
	.aspect.is-on {
		color: var(--lake);
		opacity: 1;
		background: var(--snow);
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-left: auto;
	}
	.btn {
		height: 34px;
		padding: 0 15px;
		border-radius: 8px;
		border: 1px solid var(--scree);
		background: transparent;
		color: var(--granite);
		font-size: 12.5px;
		font-family: inherit;
		cursor: pointer;
	}
	.btn:hover {
		border-color: var(--lake);
		color: var(--lake);
	}
	.btn--primary {
		border: none;
		background: var(--lake);
		color: var(--snow);
		font-weight: 700;
		padding: 0 17px;
	}
	.btn--primary:hover {
		background: #12495e;
	}

	/* ---- the artboard ----
	   .viewport reserves the scaled-down footprint; .scaler shrinks the 1080px
	   card into it. The card keeps its real size so the PNG export renders at
	   1080 regardless of the screen. */
	.stage {
		display: flex;
		justify-content: center;
	}
	.viewport {
		position: relative;
		width: calc(1080px * var(--s, 0.5));
		height: calc(var(--card-h, 1350px) * var(--s, 0.5));
	}
	.scaler {
		transform: scale(var(--s, 0.5));
		transform-origin: 0 0;
		width: 1080px;
	}
	.card {
		width: 1080px;
		height: var(--card-h);
		background: linear-gradient(180deg, #dceaf4 0%, #f8fbfd 420px, #f8fbfd 100%);
		padding: 44px 46px 40px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		/* Derived from the cell size, so one number moves the whole drawing. */
		--badge: max(22px, calc(var(--cell) * 0.24));
	}
	.card__head {
		text-align: center;
	}
	.eyebrow {
		font-size: 23px;
		letter-spacing: 5px;
		color: #1c6e8c;
		text-transform: uppercase;
	}
	.card__month {
		font-family: 'Instrument Serif', Georgia, serif;
		font-weight: 400;
		font-size: 78px;
		line-height: 1.02;
		color: #3d4a55;
		letter-spacing: -1.2px;
		margin-top: 8px;
	}
	.calendar {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		flex: 1;
		justify-content: center;
		gap: 16px;
	}
	.weekdays {
		width: var(--grid-w);
		display: grid;
		grid-template-columns: repeat(7, var(--cell));
		column-gap: 10px;
		text-align: center;
		font-size: 20px;
		letter-spacing: 3px;
		color: #6b7b88;
	}
	.grid {
		width: var(--grid-w);
		display: grid;
		grid-template-columns: repeat(7, var(--cell));
		gap: 10px;
	}

	/* ---- a day ---- */
	.cell {
		position: relative;
		width: var(--cell);
		height: calc(var(--cell) * 1.5);
	}
	.numeral {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: 'Instrument Serif', Georgia, serif;
		font-size: calc(var(--cell) * 0.26);
		line-height: 1;
		color: #c9d4dc;
	}
	.face {
		position: absolute;
		inset: 0;
		border-radius: 6px;
		background: #f8fbfd;
		border: 1.5px solid var(--ink);
	}
	.face__date {
		position: absolute;
		top: calc(var(--cell) * 0.06);
		left: calc(var(--cell) * 0.08);
		z-index: 3;
		font-family: 'Instrument Serif', Georgia, serif;
		font-size: calc(var(--cell) * 0.16);
		line-height: 1;
		color: var(--ink);
		opacity: 0.75;
	}
	.route {
		position: absolute;
		inset: calc(var(--cell) * 0.14) calc(var(--cell) * 0.1) calc(var(--cell) * 0.1);
		width: calc(100% - calc(var(--cell) * 0.2));
		height: calc(100% - calc(var(--cell) * 0.24));
	}
	.noroute {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: calc(var(--cell) * 0.08);
	}
	.noroute__icon {
		width: calc(var(--cell) * 0.26);
		height: calc(var(--cell) * 0.26);
		opacity: 0.85;
	}
	.noroute__value {
		font-family: 'Instrument Serif', Georgia, serif;
		font-size: calc(var(--cell) * 0.17);
		line-height: 1.1;
		color: var(--ink);
		text-align: center;
		padding: 0 calc(var(--cell) * 0.08);
	}
	.badge {
		position: absolute;
		right: calc(var(--badge) * -0.3);
		bottom: calc(var(--badge) * -0.3);
		z-index: 4;
		width: var(--badge);
		height: var(--badge);
		border-radius: 50%;
		background: var(--ink);
		color: #f8fbfd;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: calc(var(--badge) * 0.52);
		font-weight: 700;
		box-shadow: 0 2px 7px -1px rgba(61, 74, 85, 0.4);
	}

	/* ---- under the grid ---- */
	.summary {
		display: none;
		align-items: flex-start;
		border-top: 1px solid #c9d4dc;
		margin-top: 28px;
		padding-top: 24px;
	}
	.card--figures .summary {
		display: flex;
	}
	.summary__item {
		flex: 1;
		padding-left: 22px;
		padding-right: 16px;
		border-left: 1px solid #c9d4dc;
	}
	.summary__item:first-child {
		padding-left: 0;
		border-left: none;
	}
	.summary__item:last-child {
		padding-right: 0;
	}
	.summary__label {
		font-size: 21px;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: #6b7b88;
	}
	.summary__value {
		font-family: 'Instrument Serif', Georgia, serif;
		font-weight: 400;
		font-size: 46px;
		line-height: 1.05;
		color: #1c6e8c;
		margin-top: 8px;
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}
	/* Overlaid rather than stacked below the grid — a rest month still draws its
	   (all-quiet) calendar underneath, and the message floats over it without
	   adding to the flow height. .calendar's height is fixed by geometry() for
	   every other month, and this is the one line of copy that doesn't have a
	   row of its own reserved in that arithmetic — an overlay can never push
	   the footer past the card's own fixed height the way appending would. */
	.card__empty {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 0 40px;
		font-family: 'Instrument Serif', Georgia, serif;
		font-style: italic;
		font-size: 26px;
		color: #6b7b88;
		background: rgba(248, 251, 253, 0.82);
	}
	.card__foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-top: 1px solid #c9d4dc;
		margin-top: 24px;
		padding-top: 18px;
		font-size: 24px;
		color: #6b7b88;
	}

	/* ---- hover tooltip (screen only; positioned by script, never exported) ---- */
	.tip {
		position: fixed;
		z-index: 60;
		width: max-content;
		max-width: 260px;
		background: var(--snow);
		border: 1px solid var(--scree);
		border-radius: 8px;
		padding: 10px 13px;
		box-shadow: 0 20px 44px -14px rgba(61, 74, 85, 0.32);
		font-size: 13px;
		color: var(--granite);
		line-height: 1.5;
		pointer-events: none;
	}

	.toast {
		position: fixed;
		left: 50%;
		bottom: 34px;
		transform: translateX(-50%);
		background: var(--granite);
		border-radius: 9px;
		padding: 11px 18px;
		font-size: 13px;
		color: var(--snow);
		box-shadow: 0 16px 40px -12px rgba(61, 74, 85, 0.4);
		z-index: 60;
	}

	@media (max-width: 720px) {
		.controls {
			gap: 16px;
		}
		.actions {
			margin-left: 0;
		}
	}
</style>

<script>
	interface Geometry {
		height: number;
		cell: number;
		grid: number;
		figures: boolean;
	}
	interface MonthData {
		key: string;
		width: number;
		counts: Record<string, number>;
		geometry: Record<string, Geometry>;
		/** Slug of the aspect the page was rendered with. */
		aspect: string;
		/** Aspect id ("4:5") to URL slug ("feed"). */
		slugs: Record<string, string>;
	}

	const dataEl = document.querySelector('[data-month-data]');
	const card = document.querySelector<HTMLElement>('[data-card]');
	const viewport = document.querySelector<HTMLElement>('[data-viewport]');
	if (dataEl?.textContent && card && viewport) {
		const data = JSON.parse(dataEl.textContent) as MonthData;
		let aspect = Object.keys(data.geometry).find((id) => data.slugs[id] === data.aspect)!;
		const defaultSlug = data.slugs[Object.keys(data.geometry)[0]];

		// ---- carry the settings across a month step ----
		// Mirrors monthQuery() in activity-month.ts: the aspect lives in the URL
		// so a copied link reproduces the card that was on screen.
		function query(): string {
			return data.slugs[aspect] !== defaultSlug ? `?fmt=${data.slugs[aspect]}` : '';
		}
		function syncLinks(): void {
			const q = query();
			for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-month-link]'))
				link.href = `${link.dataset.monthLink}${q}`;
			for (const tile of document.querySelectorAll<HTMLAnchorElement>('[data-picker-month]'))
				tile.href = `${tile.pathname}${q}`;
			history.replaceState(null, '', `${location.pathname}${q}`);
		}

		// Stepping to another month replaces the history entry rather than
		// stacking one per month — same reasoning as the film card.
		for (const link of document.querySelectorAll<HTMLAnchorElement>(
			'[data-month-link], [data-picker-month]',
		)) {
			link.addEventListener('click', (event) => {
				if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
					return;
				event.preventDefault();
				location.replace(link.href);
			});
		}

		// ---- fit the 1080px artboard to whatever room the column has ----
		const stage = viewport.parentElement;
		function fit(): void {
			const width = stage?.clientWidth ?? data.width;
			const scale = Math.max(0.2, Math.min(0.62, width / data.width));
			viewport!.style.setProperty('--s', String(scale));
		}
		if (stage && 'ResizeObserver' in window) new ResizeObserver(fit).observe(stage);
		else window.addEventListener('resize', fit);
		fit();

		// ---- toast ----
		let toastTimer: ReturnType<typeof setTimeout> | undefined;
		const toastEl = document.querySelector<HTMLElement>('[data-toast]');
		function flash(message: string): void {
			if (!toastEl) return;
			toastEl.textContent = message;
			toastEl.hidden = false;
			clearTimeout(toastTimer);
			toastTimer = setTimeout(() => {
				toastEl.hidden = true;
			}, 2600);
		}

		// ---- aspect ----
		const dims = document.querySelector<HTMLElement>('[data-dims]');
		for (const button of document.querySelectorAll<HTMLElement>('[data-aspect]')) {
			button.addEventListener('click', () => {
				const id = button.dataset.aspect;
				const geometry = id ? data.geometry[id] : undefined;
				if (!id || !geometry) return;
				aspect = id;
				card.style.setProperty('--cell', `${geometry.cell}px`);
				card.style.setProperty('--card-h', `${geometry.height}px`);
				card.style.setProperty('--grid-w', `${geometry.grid}px`);
				viewport.style.setProperty('--card-h', `${geometry.height}px`);
				card.classList.toggle('card--figures', geometry.figures);
				if (dims) dims.textContent = `${data.width} × ${geometry.height} · ${id}`;
				for (const other of document.querySelectorAll('[data-aspect]'))
					other.classList.toggle('is-on', other === button);
				syncLinks();
			});
		}
		// The viewport sizes itself from --card-h too; seed it from the card's own.
		viewport.style.setProperty('--card-h', card.style.getPropertyValue('--card-h'));

		// ---- month picker ----
		const picker = document.querySelector<HTMLElement>('[data-picker]');
		const panel = document.querySelector<HTMLElement>('[data-picker-panel]');
		const yearLabel = document.querySelector<HTMLElement>('[data-picker-label]');
		const tiles = document.querySelectorAll<HTMLAnchorElement>('[data-picker-month]');
		let pickerYear = Number(data.key.slice(0, 4));

		function paintPicker(): void {
			if (yearLabel) yearLabel.textContent = String(pickerYear);
			tiles.forEach((tile, i) => {
				const id = `${pickerYear}-${String(i + 1).padStart(2, '0')}`;
				const count = data.counts[id] ?? 0;
				tile.href = `/activities/month/${id}${query()}`;
				tile.classList.toggle('is-on', id === data.key);
				const countEl = tile.querySelector('.picker__count');
				if (countEl)
					countEl.textContent = count ? `${count} ${count === 1 ? 'activity' : 'activities'}` : '—';
			});
		}
		document.querySelector('[data-picker-toggle]')?.addEventListener('click', () => {
			if (!panel) return;
			panel.hidden = !panel.hidden;
			if (!panel.hidden) {
				pickerYear = Number(data.key.slice(0, 4));
				paintPicker();
			}
		});
		for (const button of document.querySelectorAll<HTMLElement>('[data-picker-year]')) {
			button.addEventListener('click', (event) => {
				event.stopPropagation();
				pickerYear += Number(button.dataset.pickerYear);
				paintPicker();
			});
		}
		document.addEventListener('mousedown', (event) => {
			if (!panel || panel.hidden) return;
			if (!picker?.contains(event.target as Node)) panel.hidden = true;
		});

		// ---- per-cell tooltip ----
		// The card is exported as a flat image, so a hover popover can't live
		// inside it the way a normal page's would — it's a single fixed-position
		// element repositioned over whichever cell is under the pointer, entirely
		// outside the artboard that gets rasterised.
		const tip = document.querySelector<HTMLElement>('[data-tip]');
		for (const cell of document.querySelectorAll<HTMLElement>('[data-lines]')) {
			cell.addEventListener('mouseenter', () => {
				if (!tip) return;
				const lines = (cell.dataset.lines ?? '').split('\n').filter(Boolean);
				if (lines.length < 2) return;
				tip.innerHTML = lines.map((l) => `<div>${l.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</div>`).join('');
				const rect = cell.getBoundingClientRect();
				tip.style.left = `${rect.left + rect.width / 2}px`;
				tip.style.top = `${rect.top - 8}px`;
				tip.style.transform = 'translate(-50%, -100%)';
				tip.hidden = false;
			});
			cell.addEventListener('mouseleave', () => {
				if (tip) tip.hidden = true;
			});
		}

		// ---- share ----
		document.querySelector('[data-copy]')?.addEventListener('click', () => {
			const url = `${location.origin}/activities/month/${data.key}${query()}`;
			if (navigator.clipboard)
				navigator.clipboard.writeText(url).then(
					() => flash(`Link copied · ${url}`),
					() => flash(url),
				);
			else flash(url);
		});

		// ---- saving the card ----
		// Same phone-vs-desktop split as the film card: a downloaded file goes to
		// Files on a phone, not Photos, so touch devices go through the share
		// sheet instead of a plain download.
		const download = document.querySelector<HTMLElement>('[data-download]');
		const shareFile =
			matchMedia('(pointer: coarse)').matches &&
			typeof navigator.share === 'function' &&
			(() => {
				try {
					return !!navigator.canShare?.({
						files: [new File([new Blob()], 'card.png', { type: 'image/png' })],
					});
				} catch {
					return false;
				}
			})();
		if (shareFile && download) download.textContent = 'Save image';

		let rendered: { state: string; file: File } | null = null;
		const renderState = (): string => `${data.key}|${aspect}`;

		/**
		 * The card as a PNG blob. Unlike the film card, there is nothing here for
		 * html-to-image to fail to inline — every route is an inline `<path>` and
		 * every glyph an inline `<svg>`, so there's no poster `<img>` whose
		 * cross-origin cache copy needs cache-busting, and no cold-pass insurance
		 * render to guard against.
		 */
		async function render(height: number): Promise<Blob | null> {
			if (!card) return null;
			const { toBlob } = await import('html-to-image');
			return toBlob(card, {
				width: data.width,
				height,
				backgroundColor: '#f8fbfd',
				pixelRatio: 1,
				style: { transform: 'none' },
			});
		}

		download?.addEventListener('click', async () => {
			const height = data.geometry[aspect].height;
			const name = `activity-log-${data.key}.png`;

			if (shareFile && rendered?.state === renderState()) {
				try {
					await navigator.share({ files: [rendered.file] });
				} catch (error) {
					if ((error as DOMException)?.name !== 'AbortError') flash('Could not open the share sheet');
				}
				return;
			}

			flash(`Rendering ${data.width}×${height}…`);
			try {
				const blob = await render(height);
				if (!blob) throw new Error('nothing was rendered');

				if (shareFile) {
					const file = new File([blob], name, { type: 'image/png' });
					rendered = { state: renderState(), file };
					try {
						await navigator.share({ files: [file] });
					} catch (error) {
						const kind = (error as DOMException)?.name;
						if (kind === 'NotAllowedError') flash('Ready — tap Save image again');
						else if (kind !== 'AbortError') flash('Could not open the share sheet');
					}
					return;
				}

				const url = URL.createObjectURL(blob);
				const link = document.createElement('a');
				link.href = url;
				link.download = name;
				link.click();
				setTimeout(() => URL.revokeObjectURL(url), 10_000);
				flash(`Saved ${name}`);
			} catch {
				flash('Could not render the image');
			}
		});
	}
</script>
</ActivityLayout>
