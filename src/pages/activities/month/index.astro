---
// No listing of its own — /activities/month opens on the month it is now, and
// the picker on /activities/month/[month] steps to any other. A request-time
// redirect (same as /films/month and /books/month) so the "Month in review"
// link can stay pointed at the stable /activities/month while landing on the
// current month.
import { siteDay } from '../../../lib/day';
import { requireOwner } from '../../../lib/auth';

export const prerender = false;

// OWNER ONLY — the destination gates anyway.
if (!(await requireOwner(Astro.cookies))) {
	return Astro.redirect(`/films/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

return Astro.redirect(`/activities/month/${siteDay().slice(0, 7)}`, 302);
---
