---
// /activities/fitness — the fitness trend, a Performance Management Chart over
// every activity's exertion. Fitness (CTL, 42-day), Fatigue (ATL, 7-day) and
// Form (TSB) on one shared axis; see src/lib/fitness.ts for the model.
//
// OWNER ONLY. A fitness curve is a sum over the private per-day exertion — the
// same disclosure the private activity cards make, only pre-added — so like the
// athlete and heatmap pages it is owner-gated outright rather than redacted.
//
// The whole curve is computed once from the first-ever activity (CTL needs ~6
// weeks of history behind it to be right) and embedded as JSON; the range
// toggle and the custom From/To pickers only re-slice and redraw it client-side,
// through the same plotPmc the server rendered with — one implementation, not
// two that drift (the same split as /activities/athlete).
import ActivityLayout from '../../layouts/ActivityLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { requireOwner } from '../../lib/auth';
import { listDailyLoads } from '../../lib/activities';
import { ALPINE } from '../../lib/activity-tokens';
import {
	computePmc,
	windowPmc,
	rangeDates,
	plotPmc,
	RANGES,
	DEFAULT_RANGE,
	PLOT_W,
	PLOT_H,
	type PmcPoint,
} from '../../lib/fitness';

export const prerender = false;

if (!(await requireOwner(Astro.cookies))) {
	return Astro.redirect(`/films/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

// Today in the athlete's own timezone, not UTC (wiki pattern 0005).
const today = new Date().toLocaleDateString('en-CA');

let pmc: PmcPoint[] = [];
let unreachable = false;
try {
	pmc = computePmc(await listDailyLoads(), today);
} catch (err) {
	unreachable = true;
	console.error('fitness page: could not read the activity log —', err);
}

const { from, to } = rangeDates(DEFAULT_RANGE, today);
const initial = windowPmc(pmc, from, to);
const p = plotPmc(initial);

// The three series, named once so the legend, the header numbers and the CSS
// custom properties all read from the same list.
const SERIES = [
	{ key: 'ctl', label: 'Fitness', note: 'CTL · 42-day', color: ALPINE.lake },
	{ key: 'atl', label: 'Fatigue', note: 'ATL · 7-day', color: ALPINE.larch },
	{ key: 'tsb', label: 'Form', note: 'TSB · fitness − fatigue', color: ALPINE.fir },
] as const;

/** A word for the current Form value — the whole point of the number. */
function formWord(tsb: number): string {
	if (tsb > 15) return 'very fresh';
	if (tsb > 5) return 'fresh';
	if (tsb >= -10) return 'neutral';
	if (tsb >= -25) return 'fatigued';
	return 'very fatigued';
}

const fmtDate = (iso: string) =>
	new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

// The custom pickers start showing the default window's actual bounds.
const inputFrom = initial.length ? initial[0].date : from ?? '';
const inputTo = initial.length ? initial[initial.length - 1].date : to;
---

<ActivityLayout title="Fitness trend · Jason's activity log">
	<div
		class="page"
		style={{
			'--snow': ALPINE.snow,
			'--granite': ALPINE.granite,
			'--granite-soft': ALPINE.graniteSoft,
			'--lake': ALPINE.lake,
			'--lake-deep': ALPINE.lakeDeep,
			'--scree': ALPINE.scree,
			'--fir': ALPINE.fir,
			'--larch': ALPINE.larch,
			'--alpenglow': ALPINE.alpenglow,
			'--c-ctl': ALPINE.lake,
			'--c-atl': ALPINE.larch,
			'--c-tsb': ALPINE.fir,
		}}
	>
		<div class="card">
			<SiteHeader pathname={Astro.url.pathname} theme="activity" />

			<header class="head">
				<a class="back" href="/activities">← Activity log</a>
				<h1 class="head__title">Fitness trend</h1>
			</header>

			{unreachable && <p class="flash flash--err">Could not reach the activity log.</p>}

			{!unreachable && pmc.length === 0 && (
				<p class="muted">Nothing logged yet — the trend needs activities to draw.</p>
			)}

			{p && (
				<>
					<section class="now" data-now>
						{SERIES.map((s) => (
							<div class="now__cell" style={`--dot:${s.color}`}>
								<span class="now__label">{s.label}</span>
								<span class="now__val" data-now-key={s.key}>{p.last[s.key].toFixed(1)}</span>
								<span class="now__note">{s.key === 'tsb' ? <span data-form-word>{formWord(p.last.tsb)}</span> : s.note}</span>
							</div>
						))}
					</section>

					<section class="chart">
						<div class="controls">
							<div class="toggle" role="group" aria-label="Timeframe">
								{RANGES.map((r) => (
									<button type="button" class="toggle__btn" data-range={r.key} aria-pressed={r.key === DEFAULT_RANGE}>
										{r.label}
									</button>
								))}
							</div>
							<div class="dates">
								<label class="date">From <input type="date" data-from value={inputFrom} max={today} /></label>
								<label class="date">To <input type="date" data-to value={inputTo} max={today} /></label>
							</div>
						</div>

						<div class="plotwrap">
						<svg class="plot" viewBox={`0 0 ${PLOT_W} ${PLOT_H}`} role="img" aria-label="Fitness, fatigue and form over time" data-plot>
							<rect class="hit" x="0" y="0" width={PLOT_W} height={PLOT_H} fill="transparent" data-hit />
							<g data-ygrid>
								{p.yTicks.map((t) => (
									<>
										<line class="grid" x1="30" y1={t.y} x2={PLOT_W - 6} y2={t.y} />
										<text class="ylabel" x="26" y={t.y + 3} text-anchor="end">{t.value}</text>
									</>
								))}
							</g>
							<line class="zero" x1="30" y1={p.zeroY} x2={PLOT_W - 6} y2={p.zeroY} data-zero />
							<path class="area area--tsb" d={p.tsbArea} data-area />
							<polyline class="line line--tsb" points={p.tsbLine} data-line-tsb />
							<polyline class="line line--ctl" points={p.ctlLine} data-line-ctl />
							<polyline class="line line--atl" points={p.atlLine} data-line-atl />
							<g data-xaxis>
								{p.xTicks.map((t) => (
									<text class="xlabel" x={t.x} y={PLOT_H - 5} text-anchor="middle">{t.label}</text>
								))}
							</g>
							<g data-cross hidden>
								<line class="cross" y1="12" y2={PLOT_H - 18} data-cross-line />
								<circle class="mark mark--ctl" r="2.4" data-mark-ctl />
								<circle class="mark mark--atl" r="2.4" data-mark-atl />
								<circle class="mark mark--tsb" r="2.4" data-mark-tsb />
							</g>
						</svg>
						<div class="tip" data-tip hidden aria-hidden="true">
							<div class="tip__date" data-tip-date></div>
							{SERIES.map((s) => (
								<div class="tip__row">
									<span class="tip__sw" style={`background:${s.color}`}></span>
									<span class="tip__lbl">{s.label}</span>
									<b class="tip__val" data-tip-key={s.key}></b>
								</div>
							))}
						</div>
						</div>

						<div class="legend">
							{SERIES.map((s) => (
								<span class="legend__item"><span class="legend__swatch" style={`background:${s.color}`}></span>{s.label}</span>
							))}
						</div>
						<p class="span muted" data-span>{fmtDate(inputFrom)} – {fmtDate(inputTo)}</p>
					</section>
				</>
			)}
		</div>
	</div>
</ActivityLayout>

<script>
	import { computePmc, windowPmc, rangeDates, plotPmc, PLOT_H, type PmcPoint, type FitnessMark, type RangeKey } from '../../lib/fitness';

	const dataEl = document.getElementById('pmc-data');
	const svg = document.querySelector<SVGElement>('[data-plot]');
	if (dataEl && svg) {
		const PMC: PmcPoint[] = JSON.parse(dataEl.textContent ?? '[]');
		const today = svg.getAttribute('data-today') ?? new Date().toLocaleDateString('en-CA');
		const SVG_NS = 'http://www.w3.org/2000/svg';
		const W = Number(svg.viewBox.baseVal.width);

		// The days plotted in the current window — what the scrubber snaps to.
		let marks: FitnessMark[] = [];
		const crossG = svg.querySelector<SVGGElement>('[data-cross]')!;
		const crossLine = svg.querySelector<SVGElement>('[data-cross-line]')!;
		const markEls = {
			ctl: svg.querySelector<SVGElement>('[data-mark-ctl]')!,
			atl: svg.querySelector<SVGElement>('[data-mark-atl]')!,
			tsb: svg.querySelector<SVGElement>('[data-mark-tsb]')!,
		};
		const tip = document.querySelector<HTMLElement>('[data-tip]')!;
		const tipDate = tip.querySelector<HTMLElement>('[data-tip-date]')!;
		const tipVals = {
			ctl: tip.querySelector<HTMLElement>('[data-tip-key="ctl"]')!,
			atl: tip.querySelector<HTMLElement>('[data-tip-key="atl"]')!,
			tsb: tip.querySelector<HTMLElement>('[data-tip-key="tsb"]')!,
		};

		const fromInput = document.querySelector<HTMLInputElement>('[data-from]')!;
		const toInput = document.querySelector<HTMLInputElement>('[data-to]')!;
		const MONTH = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
		const fmtDate = (iso: string) => {
			const [y, m, d] = iso.split('-').map(Number);
			return `${MONTH[(m || 1) - 1]} ${d}, ${y}`;
		};

		function el(tag: string, attrs: Record<string, string | number>) {
			const node = document.createElementNS(SVG_NS, tag);
			for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
			return node;
		}

		function draw(from: string, to: string) {
			const win = windowPmc(PMC, from || null, to || null);
			const p = plotPmc(win);
			if (!p) return;

			(svg.querySelector('[data-line-ctl]') as SVGElement).setAttribute('points', p.ctlLine);
			(svg.querySelector('[data-line-atl]') as SVGElement).setAttribute('points', p.atlLine);
			(svg.querySelector('[data-line-tsb]') as SVGElement).setAttribute('points', p.tsbLine);
			(svg.querySelector('[data-area]') as SVGElement).setAttribute('d', p.tsbArea);
			const zero = svg.querySelector('[data-zero]') as SVGElement;
			zero.setAttribute('y1', String(p.zeroY));
			zero.setAttribute('y2', String(p.zeroY));

			const ygrid = svg.querySelector('[data-ygrid]')!;
			ygrid.textContent = '';
			for (const t of p.yTicks) {
				ygrid.appendChild(el('line', { class: 'grid', x1: 30, y1: t.y, x2: W - 6, y2: t.y }));
				const label = el('text', { class: 'ylabel', x: 26, y: t.y + 3, 'text-anchor': 'end' });
				label.textContent = String(t.value);
				ygrid.appendChild(label);
			}
			const xaxis = svg.querySelector('[data-xaxis]')!;
			xaxis.textContent = '';
			for (const t of p.xTicks) {
				const label = el('text', { class: 'xlabel', x: t.x, y: PLOT_H - 5, 'text-anchor': 'middle' });
				label.textContent = t.label;
				xaxis.appendChild(label);
			}

			// Header numbers + the Form word.
			const set = (key: 'ctl' | 'atl' | 'tsb') =>
				(document.querySelector(`[data-now-key="${key}"]`)!.textContent = p.last[key].toFixed(1));
			set('ctl'); set('atl'); set('tsb');
			const word = document.querySelector('[data-form-word]');
			if (word) word.textContent = formWord(p.last.tsb);

			document.querySelector('[data-span]')!.textContent = `${fmtDate(win[0].date)} – ${fmtDate(win[win.length - 1].date)}`;
			fromInput.value = win[0].date;
			toInput.value = win[win.length - 1].date;

			// A fresh window invalidates the crosshair's position.
			marks = p.marks;
			hideScrub();
		}

		function formWord(tsb: number): string {
			if (tsb > 15) return 'very fresh';
			if (tsb > 5) return 'fresh';
			if (tsb >= -10) return 'neutral';
			if (tsb >= -25) return 'fatigued';
			return 'very fatigued';
		}

		const press = (active: Element | null) =>
			document.querySelectorAll('[data-range]').forEach((b) => b.setAttribute('aria-pressed', String(b === active)));

		document.querySelectorAll<HTMLButtonElement>('[data-range]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const { from, to } = rangeDates(btn.dataset.range as RangeKey, today);
				press(btn);
				draw(from ?? '', to);
			});
		});

		// Editing either date is a custom window — the presets deselect.
		for (const input of [fromInput, toInput]) {
			input.addEventListener('change', () => {
				if (fromInput.value && toInput.value && fromInput.value > toInput.value) return;
				press(null);
				draw(fromInput.value, toInput.value);
			});
		}

		// --- Scrubbing ------------------------------------------------------
		// Snap a crosshair and readout to the day nearest the pointer. The SVG
		// scales to the card width, so a client x is mapped back into viewBox
		// units before the nearest mark is found (marks carry viewBox x).
		function hideScrub() {
			crossG.setAttribute('hidden', '');
			tip.setAttribute('hidden', '');
		}

		function scrub(clientX: number) {
			if (marks.length === 0) return;
			const rect = svg.getBoundingClientRect();
			if (rect.width === 0) return;
			const vbX = ((clientX - rect.left) / rect.width) * W;
			let best = marks[0];
			for (const m of marks) if (Math.abs(m.x - vbX) < Math.abs(best.x - vbX)) best = m;

			crossG.removeAttribute('hidden');
			crossLine.setAttribute('x1', String(best.x));
			crossLine.setAttribute('x2', String(best.x));
			markEls.ctl.setAttribute('cx', String(best.x)); markEls.ctl.setAttribute('cy', String(best.yCtl));
			markEls.atl.setAttribute('cx', String(best.x)); markEls.atl.setAttribute('cy', String(best.yAtl));
			markEls.tsb.setAttribute('cx', String(best.x)); markEls.tsb.setAttribute('cy', String(best.yTsb));

			tip.removeAttribute('hidden');
			tipDate.textContent = fmtDate(best.date);
			tipVals.ctl.textContent = best.ctl.toFixed(1);
			tipVals.atl.textContent = best.atl.toFixed(1);
			tipVals.tsb.textContent = best.tsb.toFixed(1);
			// Follow the crosshair in pixels, flipping to the left near the right
			// edge so the box never runs off the chart.
			const px = (best.x / W) * rect.width;
			tip.style.left = `${px}px`;
			tip.style.transform = px > rect.width * 0.6 ? 'translateX(calc(-100% - 10px))' : 'translateX(10px)';
		}

		svg.addEventListener('pointermove', (e) => scrub(e.clientX));
		svg.addEventListener('pointerdown', (e) => scrub(e.clientX));
		svg.addEventListener('pointerleave', hideScrub);

		// The server already rendered the default window; redraw it once (same
		// output) so `marks` is populated and scrubbing works before any toggle.
		draw(fromInput.value, toInput.value);
	}
</script>

<script id="pmc-data" type="application/json" set:html={JSON.stringify(pmc)} is:inline />
<script is:inline define:vars={{ today }}>
	document.querySelector('[data-plot]')?.setAttribute('data-today', today);
</script>

<style>
	.page {
		min-height: 100dvh;
		background: var(--snow);
		color: var(--granite);
		padding: clamp(1rem, 4vw, 3rem);
	}
	.card {
		max-width: 72rem;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}
	.head { display: flex; flex-direction: column; gap: 0.35rem; }
	.back { color: var(--lake); text-decoration: none; font-size: 0.85rem; }
	.head__title { margin: 0; font-size: 1.6rem; }
	.muted { color: var(--granite-soft); }
	.flash { margin: 0; padding: 0.5rem 0.75rem; border-radius: 0.5rem; font-size: 0.9rem; }
	.flash--err { background: color-mix(in srgb, #c0392b 12%, transparent); color: #c0392b; }

	/* --- Current values --------------------------------------------------- */
	.now {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.6rem;
	}
	.now__cell {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.7rem 0.85rem;
		border: 1px solid var(--scree);
		border-radius: 0.6rem;
		border-left: 3px solid var(--dot);
	}
	.now__label { font-size: 0.75rem; color: var(--granite-soft); text-transform: uppercase; letter-spacing: 0.06em; }
	.now__val { font-size: 1.7rem; font-variant-numeric: tabular-nums; line-height: 1.1; }
	.now__note { font-size: 0.72rem; color: var(--granite-soft); }

	/* --- Chart ------------------------------------------------------------ */
	.controls {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 0.75rem;
	}
	.toggle { display: inline-flex; border: 1px solid var(--scree); border-radius: 0.5rem; overflow: hidden; }
	.toggle__btn {
		border: 0;
		padding: 0.3rem 0.7rem;
		background: var(--snow);
		color: var(--granite-soft);
		font: inherit;
		font-size: 0.72rem;
		cursor: pointer;
	}
	.toggle__btn + .toggle__btn { border-left: 1px solid var(--scree); }
	.toggle__btn[aria-pressed='true'] { background: var(--lake); color: var(--snow); }
	.dates { display: flex; gap: 0.6rem; flex-wrap: wrap; }
	.date { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.72rem; color: var(--granite-soft); }
	.date input {
		padding: 0.25rem 0.4rem;
		border: 1px solid var(--scree);
		border-radius: 0.4rem;
		background: var(--snow);
		color: var(--granite);
		font: inherit;
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
	}
	.date input:focus-visible { outline: 2px solid var(--lake); outline-offset: 1px; }

	.plotwrap { position: relative; }
	/* pan-y lets the page still scroll vertically over the chart on touch, while
	   a horizontal drag scrubs. */
	.plot { width: 100%; height: auto; overflow: visible; touch-action: pan-y; }
	.grid { stroke: var(--scree); stroke-width: 0.5; opacity: 0.6; }
	.zero { stroke: var(--granite-soft); stroke-width: 0.6; stroke-dasharray: 3 3; opacity: 0.7; }
	.ylabel, .xlabel { fill: var(--granite-soft); font-size: 9px; font-variant-numeric: tabular-nums; }
	.line { fill: none; stroke-width: 1.6; vector-effect: non-scaling-stroke; stroke-linejoin: round; stroke-linecap: round; }
	.line--ctl { stroke: var(--c-ctl); }
	.line--atl { stroke: var(--c-atl); }
	.line--tsb { stroke: var(--c-tsb); stroke-width: 1.1; opacity: 0.9; }
	.area--tsb { fill: var(--c-tsb); opacity: 0.1; }

	/* Scrubbing */
	.cross { stroke: var(--granite-soft); stroke-width: 0.6; opacity: 0.55; }
	.mark { stroke: var(--snow); stroke-width: 1; vector-effect: non-scaling-stroke; }
	.mark--ctl { fill: var(--c-ctl); }
	.mark--atl { fill: var(--c-atl); }
	.mark--tsb { fill: var(--c-tsb); }
	[hidden] { display: none; }
	.tip {
		position: absolute;
		top: 6px;
		left: 0;
		pointer-events: none;
		background: var(--snow);
		border: 1px solid var(--scree);
		border-radius: 0.5rem;
		padding: 0.4rem 0.55rem;
		font-size: 0.72rem;
		box-shadow: 0 2px 10px rgba(30, 50, 66, 0.12);
		z-index: 2;
		min-width: 8.5rem;
	}
	.tip__date { font-weight: 600; margin-bottom: 0.25rem; color: var(--granite); }
	.tip__row { display: flex; align-items: center; gap: 0.4rem; line-height: 1.5; }
	.tip__sw { width: 10px; height: 3px; border-radius: 2px; flex: none; }
	.tip__lbl { color: var(--granite-soft); }
	.tip__val { margin-left: auto; font-variant-numeric: tabular-nums; color: var(--granite); }

	.legend { display: flex; gap: 1.1rem; flex-wrap: wrap; margin-top: 0.6rem; }
	.legend__item { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.78rem; color: var(--granite); }
	.legend__swatch { width: 12px; height: 3px; border-radius: 2px; }
	.span { margin: 0.3rem 0 0; font-size: 0.75rem; font-variant-numeric: tabular-nums; }

	@media (max-width: 640px) {
		.now { grid-template-columns: 1fr; }
		.controls { align-items: stretch; }
	}
</style>
