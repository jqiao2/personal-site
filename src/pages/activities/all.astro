	</style>

	<script>
		// NOTE ON WHAT THIS SCRIPT DOES NOT IMPORT. activity-params.ts (this
		// track's own file) is the single parser both this page's frontmatter
		// and /api/activities/list read a URL through — but it also re-exports
		// fetchActivityPage/fetchActivityFacets, which pull in lib/activities.ts
		// and, through it, lib/supabase.ts's service-role client. Importing
		// activity-params.ts here would drag that whole chain into the browser
		// bundle and throw at load ("SUPABASE_SERVICE_ROLE_KEY is not set") the
		// moment a client env lacks the server-only secret it needs — which a
		// browser always does. So the filter-sentence builder below is a
		// deliberate, small duplicate of activityFilterSentence's logic rather
		// than an import of it; sports.ts and activity-tokens.ts have no such
		// server dependency and are imported directly.
		import { sportMeta, sportIcon } from '../../lib/sports';
		import { ALPINE, cardStats, exertionLabel, noGpsStats } from '../../lib/activity-tokens';
		// Type-only — erased at build, so this brings in none of activities.ts's
		// runtime code (and, through it, supabase.ts) the way a value import
		// would.
		import type { ActivityListRow } from '../../lib/activities';
		type ApiActivity = ActivityListRow;

		interface SentencePart {
			t: string;
			em: boolean;
		}

		const SPORT_VERB: Record<string, string> = {
			ride: 'ridden',
			gravel_ride: 'ridden',
			mountain_bike: 'ridden',
			virtual_ride: 'ridden',
			run: 'run',
			treadmill_run: 'run',
			trail_run: 'run',
			swim: 'swum',
			open_water_swim: 'swum',
			hike: 'hiked',
			walk: 'walked',
			snowshoe: 'snowshoed',
			alpine_ski: 'skied',
			backcountry_ski: 'skied',
			nordic_ski: 'skied',
			snowboard: 'ridden',
			strength: 'lifted through',
			yoga: 'practiced',
			rowing: 'rowed',
			transition: 'logged',
			other: 'logged',
		};

		function andList(items: string[], conj = 'and'): string {
			if (items.length <= 1) return items.join('');
			if (items.length === 2) return `${items[0]} ${conj} ${items[1]}`;
			return `${items.slice(0, -1).join(', ')}, ${conj} ${items[items.length - 1]}`;
		}
		function miTxt(m: number): string {
			const val = m / 1609.344;
			return `${val % 1 === 0 ? val.toFixed(0) : val.toFixed(1)} mi`;
		}
		function ftTxt(m: number): string {
			return `${Math.round(m / 0.3048).toLocaleString('en-US')} ft`;
		}
		function durTxt(s: number): string {
			const h = Math.floor(s / 3600);
			const m = Math.round((s % 3600) / 60);
			return h > 0 ? `${h}h ${m}m` : `${m}m`;
		}

		interface FilterSummary {
			total: number;
			sports: string[];
			dateFrom: string | null;
			dateTo: string | null;
			distanceMinM: number | null;
			distanceMaxM: number | null;
			durationMinS: number | null;
			durationMaxS: number | null;
			elevationMinM: number | null;
			elevationMaxM: number | null;
			exertionMin: number | null;
			exertionMax: number | null;
			hasGps: boolean | null;
			indoor: boolean | null;
			hasPower: boolean;
			hasHr: boolean;
			place: string | null;
			personalBestOnly: boolean;
			measuredOnly: boolean;
			gearNames: string[];
		}

		/** Client-side twin of activity-params.ts's activityFilterSentence — see
		 * the note above the imports for why this isn't a shared function. Keep
		 * the two in step by eye; the wording, not the filtering, is all that's
		 * ever at stake if they drift. */
		function activityFilterSentence(s: FilterSummary): SentencePart[] {
			const parts: SentencePart[] = [];
			const lit = (t: string) => parts.push({ t, em: false });
			const em = (t: string) => parts.push({ t, em: true });

			const verb = s.sports.length === 1 ? (SPORT_VERB[s.sports[0]] ?? 'logged') : 'logged';
			lit(`You have ${verb} `);
			em(s.total.toLocaleString('en-US'));
			lit(s.total === 1 ? ' activity' : ' activities');

			if (s.sports.length > 1) {
				lit(' across ');
				em(andList(s.sports.map((slug) => sportMeta(slug).label)));
			} else if (s.sports.length === 1 && verb === 'logged') {
				lit(' of ');
				em(sportMeta(s.sports[0]).label);
			}

			if (s.personalBestOnly) {
				lit(' that are ');
				em('personal bests');
			}

			if (s.dateFrom || s.dateTo) {
				if (s.dateFrom && s.dateTo) {
					lit(' between ');
					em(`${s.dateFrom} and ${s.dateTo}`);
				} else if (s.dateFrom) {
					lit(' since ');
					em(s.dateFrom);
				} else {
					lit(' before ');
					em(s.dateTo!);
				}
			}

			if (s.distanceMinM != null || s.distanceMaxM != null) {
				if (s.distanceMinM != null && s.distanceMaxM != null) {
					lit(' between ');
					em(`${miTxt(s.distanceMinM)} and ${miTxt(s.distanceMaxM)}`);
				} else if (s.distanceMinM != null) {
					lit(' over ');
					em(miTxt(s.distanceMinM));
				} else {
					lit(' under ');
					em(miTxt(s.distanceMaxM!));
				}
			}

			if (s.durationMinS != null || s.durationMaxS != null) {
				if (s.durationMinS != null && s.durationMaxS != null) {
					lit(' lasting between ');
					em(`${durTxt(s.durationMinS)} and ${durTxt(s.durationMaxS)}`);
				} else if (s.durationMinS != null) {
					lit(' lasting over ');
					em(durTxt(s.durationMinS));
				} else {
					lit(' lasting under ');
					em(durTxt(s.durationMaxS!));
				}
			}

			if (s.elevationMinM != null || s.elevationMaxM != null) {
				if (s.elevationMinM != null && s.elevationMaxM != null) {
					lit(' climbing between ');
					em(`${ftTxt(s.elevationMinM)} and ${ftTxt(s.elevationMaxM)}`);
				} else if (s.elevationMinM != null) {
					lit(' climbing over ');
					em(ftTxt(s.elevationMinM));
				} else {
					lit(' climbing under ');
					em(ftTxt(s.elevationMaxM!));
				}
			}

			if (s.exertionMin != null || s.exertionMax != null) {
				if (s.exertionMin != null && s.exertionMax != null) {
					lit(' at ');
					em(`${exertionLabel(s.exertionMin)} to ${exertionLabel(s.exertionMax)}`);
					lit(' effort');
				} else if (s.exertionMin != null) {
					lit(' at ');
					em(`${exertionLabel(s.exertionMin)} or above`);
				} else {
					lit(' at ');
					em(`${exertionLabel(s.exertionMax!)} or below`);
				}
			}

			if (s.hasGps === true) {
				lit(' with a ');
				em('GPS route');
			} else if (s.hasGps === false) {
				lit(' with ');
				em('no GPS');
			}

			if (s.indoor === true) {
				lit(' ');
				em('indoors');
			} else if (s.indoor === false) {
				lit(' ');
				em('outdoors');
			}

			if (s.hasPower) {
				lit(' with ');
				em('power data');
			}
			if (s.hasHr) {
				lit(' with ');
				em('heart-rate data');
			}
			if (s.measuredOnly) {
				lit(' with ');
				em('measured');
				lit(' exertion only');
			}

			if (s.gearNames.length) {
				lit(' using ');
				em(andList(s.gearNames));
			}
			if (s.place) {
				lit(' starting near ');
				em(`"${s.place}"`);
			}

			lit('.');
			return parts;
		}

		const grid = document.getElementById('grid');
		const sentinel = document.getElementById('sentinel');
		if (!grid || !sentinel) throw new Error('activities/all: missing #grid or #sentinel');

		const shown = document.getElementById('shown')!;
		const emptyUnfiltered = document.getElementById('empty-unfiltered')!;
		const emptyFiltered = document.getElementById('empty-filtered')!;
		const errorBox = document.getElementById('load-error')!;
		const retry = document.getElementById('retry')!;
		const BATCH = Number(sentinel.dataset.batch);

		let offset = grid.childElementCount;
		let loading = false;
		let done = sentinel.hidden;
		let seq = 0;

		const fmt = (n: number) => n.toLocaleString('en-US');

		// --- Filter state, mirroring activity-params.ts's units ------------
		let sort = (document.getElementById('sort') as HTMLSelectElement).value;
		let dir = (document.getElementById('dir-toggle') as HTMLButtonElement).dataset.dir as 'asc' | 'desc';
		const sports = new Set<string>(
			Array.from(document.querySelectorAll<HTMLButtonElement>('.chip[data-sport][aria-pressed="true"]')).map(
				(c) => c.dataset.sport!,
			),
		);
		const gear = new Set<number>(
			Array.from(document.querySelectorAll<HTMLButtonElement>('.chip[data-gear][aria-pressed="true"]')).map((c) =>
				Number(c.dataset.gear),
			),
		);
		const flags = {
			power: false,
			hr: false,
			measured: false,
			pr: false,
		};
		for (const chip of document.querySelectorAll<HTMLButtonElement>('.chip[data-flag]')) {
			flags[chip.dataset.flag as keyof typeof flags] = chip.getAttribute('aria-pressed') === 'true';
		}
		let gps: boolean | null = null;
		let indoor: boolean | null = null;
		for (const chip of document.querySelectorAll<HTMLButtonElement>('.chip[data-tri]')) {
			if (chip.getAttribute('aria-pressed') !== 'true') continue;
			const key = chip.dataset.tri as 'gps' | 'indoor';
			const val = chip.dataset.value === '1';
			if (key === 'gps') gps = val;
			else indoor = val;
		}
		const dateFromInput = document.getElementById('datefrom') as HTMLInputElement;
		const dateToInput = document.getElementById('dateto') as HTMLInputElement;
		const placeInput = document.getElementById('place') as HTMLInputElement;
		let place = placeInput.value.trim();

		function activeCount(): number {
			let n =
				sports.size +
				gear.size +
				(dateFromInput.value || dateToInput.value ? 1 : 0) +
				(gps != null ? 1 : 0) +
				(indoor != null ? 1 : 0) +
				(flags.power ? 1 : 0) +
				(flags.hr ? 1 : 0) +
				(flags.measured ? 1 : 0) +
				(flags.pr ? 1 : 0) +
				(place ? 1 : 0) +
				(distRange && distRange.isActive() ? 1 : 0) +
				(durRange && durRange.isActive() ? 1 : 0) +
				(elevRange && elevRange.isActive() ? 1 : 0) +
				(exRange && exRange.isActive() ? 1 : 0);
			return n;
		}

		// --- Generic dual-thumb range control -------------------------------
		interface RangeHandle {
			min: number;
			max: number;
			setValues(a: number, b: number): void;
			isActive(): boolean;
			reset(): void;
		}

		function makeRange(prefix: string, lo: number, hi: number, format: (v: number) => string): RangeHandle | null {
			const minInput = document.getElementById(`${prefix}-min`) as HTMLInputElement | null;
			const maxInput = document.getElementById(`${prefix}-max`) as HTMLInputElement | null;
			const fill = document.getElementById(`${prefix}-fill`);
			const minLabel = document.getElementById(`${prefix}-min-label`);
			const maxLabel = document.getElementById(`${prefix}-max-label`);
			if (!minInput || !maxInput || !fill || !minLabel || !maxLabel) return null;

			let curMin = Number(minInput.value);
			let curMax = Number(maxInput.value);

			function sync() {
				const pct = (v: number) => (hi > lo ? ((v - lo) / (hi - lo)) * 100 : 0);
				fill!.style.left = `${pct(curMin)}%`;
				fill!.style.width = `${pct(curMax) - pct(curMin)}%`;
				minLabel!.textContent = format(curMin);
				maxLabel!.textContent = format(curMax);
				const overlap = curMin > (lo + hi) / 2;
				minInput!.style.zIndex = overlap ? '2' : '1';
				maxInput!.style.zIndex = overlap ? '1' : '2';
			}

			function setValues(a: number, b: number) {
				curMin = Math.min(a, b);
				curMax = Math.max(a, b);
				minInput!.value = String(curMin);
				maxInput!.value = String(curMax);
				sync();
			}

			minInput.addEventListener('input', () => {
				setValues(Number(minInput.value), curMax);
			});
			maxInput.addEventListener('input', () => {
				setValues(curMin, Number(maxInput.value));
			});
			for (const input of [minInput, maxInput]) {
				input.addEventListener('change', () => applyFilters());
			}

			sync();
			return {
				get min() {
					return curMin;
				},
				get max() {
					return curMax;
				},
				setValues,
				isActive: () => curMin > lo || curMax < hi,
				reset: () => setValues(lo, hi),
			};
		}

		const distRange = makeRange(
			'dist',
			Number((document.getElementById('dist-min') as HTMLInputElement | null)?.min ?? 0),
			Number((document.getElementById('dist-min') as HTMLInputElement | null)?.max ?? 0),
			(v) => `${Math.round(v)} mi`,
		);
		const durRange = makeRange(
			'dur',
			Number((document.getElementById('dur-min') as HTMLInputElement | null)?.min ?? 0),
			Number((document.getElementById('dur-min') as HTMLInputElement | null)?.max ?? 0),
			(v) => `${Math.round(v)}m`,
		);
		const elevRange = makeRange(
			'elev',
			Number((document.getElementById('elev-min') as HTMLInputElement | null)?.min ?? 0),
			Number((document.getElementById('elev-min') as HTMLInputElement | null)?.max ?? 0),
			(v) => `${Math.round(v).toLocaleString('en-US')} ft`,
		);
		const exRange = makeRange(
			'ex',
			Number((document.getElementById('ex-min') as HTMLInputElement | null)?.min ?? 0),
			Number((document.getElementById('ex-min') as HTMLInputElement | null)?.max ?? 0),
			(v) => `${Math.round(v)} · ${exertionLabel(v)}`,
		);

		function buildQuery(from: number): string {
			const p = new URLSearchParams();
			p.set('limit', String(BATCH));
			p.set('offset', String(from));
			if (sort !== 'date') p.set('sort', sort);
			if (dir !== 'desc') p.set('dir', dir);
			for (const s of sports) p.append('sport', s);
			if (dateFromInput.value) p.set('datefrom', dateFromInput.value);
			if (dateToInput.value) p.set('dateto', dateToInput.value);
			if (distRange?.isActive()) {
				p.set('distmin', String(distRange.min));
				p.set('distmax', String(distRange.max));
			}
			if (durRange?.isActive()) {
				p.set('durmin', String(durRange.min));
				p.set('durmax', String(durRange.max));
			}
			if (elevRange?.isActive()) {
				p.set('elevmin', String(elevRange.min));
				p.set('elevmax', String(elevRange.max));
			}
			if (exRange?.isActive()) {
				p.set('exmin', String(exRange.min));
				p.set('exmax', String(exRange.max));
			}
			if (gps != null) p.set('gps', gps ? '1' : '0');
			if (indoor != null) p.set('indoor', indoor ? '1' : '0');
			if (flags.power) p.set('power', '1');
			if (flags.hr) p.set('hr', '1');
			if (flags.measured) p.set('measured', '1');
			if (flags.pr) p.set('pr', '1');
			for (const id of gear) p.append('gear', String(id));
			if (place) p.set('place', place);
			return p.toString();
		}

		function writeUrl() {
			const qs = buildQuery(0);
			// offset/limit are paging, not filters — never belong in the shareable URL.
			const p = new URLSearchParams(qs);
			p.delete('offset');
			p.delete('limit');
			const url = location.pathname + (p.toString() ? `?${p.toString()}` : '');
			if (url !== location.pathname + location.search) history.replaceState(null, '', url);
		}

		// Card markup for rows paged in after the first render, mirroring
		// ActivityCard.astro's own template so the same scoped CSS applies —
		// see the scopeDummy comment in the frontmatter for why the hash has
		// to be read off a real rendered instance rather than guessed.
		const cardSample = document.querySelector('#scope-source .ac');
		const cardScope = cardSample
			? Array.from(cardSample.attributes)
					.map((a) => a.name)
					.find((n) => n.startsWith('data-astro-cid-'))
			: undefined;
		const pageScope = Array.from(grid.attributes)
			.map((a) => a.name)
			.find((n) => n.startsWith('data-astro-cid-'));

		function el(tag: string, cls: string | undefined, scope: string | undefined, text?: string): HTMLElement {
			const node = document.createElement(tag);
			if (scope) node.setAttribute(scope, '');
			if (cls) node.className = cls;
			if (text != null) node.textContent = text;
			return node;
		}
		function svgEl(tag: string, scope: string | undefined): SVGElement {
			const node = document.createElementNS('http://www.w3.org/2000/svg', tag);
			if (scope) node.setAttribute(scope, '');
			return node;
		}

		/** The card's palette, which every .ac rule reads through. */
		function setAlpine(node: HTMLElement): void {
			node.style.setProperty('--sky', ALPINE.sky);
			node.style.setProperty('--snow', ALPINE.snow);
			node.style.setProperty('--granite', ALPINE.granite);
			node.style.setProperty('--granite-soft', ALPINE.graniteSoft);
			node.style.setProperty('--lake', ALPINE.lake);
			node.style.setProperty('--lake-deep', ALPINE.lakeDeep);
			node.style.setProperty('--larch', ALPINE.larch);
			node.style.setProperty('--scree', ALPINE.scree);
		}

		function buildRow(a: ApiActivity): HTMLElement {
			const wrap = el('div', 'row-item', pageScope);
			// Mirrors ActivityCard.astro's redacted branch — a private activity
			// seen by a visitor is a sport glyph in a <div>, not a link to a page
			// that would 404. The API has already emptied every other field; this
			// only has to agree with it about what to draw.
			if (a.redacted) {
				const box = el('div', 'ac ac--row ac--redacted', cardScope);
				setAlpine(box);
				box.setAttribute('aria-label', sportMeta(a.sport).label);
				box.title = sportMeta(a.sport).label;
				const rface = el('div', 'ac__face', cardScope);
				const rsvg = svgEl('svg', cardScope) as unknown as SVGSVGElement;
				rsvg.setAttribute('class', 'ac__redacted-mark');
				rsvg.setAttribute('viewBox', '0 0 24 24');
				rsvg.setAttribute('fill', 'none');
				rsvg.setAttribute('stroke', 'currentColor');
				rsvg.setAttribute('stroke-width', '1.5');
				rsvg.setAttribute('aria-hidden', 'true');
				const rpath = svgEl('path', cardScope);
				rpath.setAttribute('d', sportIcon(a.sport));
				rsvg.appendChild(rpath);
				rface.appendChild(rsvg as unknown as Node);
				box.appendChild(rface);
				wrap.appendChild(box);
				return wrap;
			}
			const card = el('a', 'ac ac--row', cardScope) as HTMLAnchorElement;
			card.href = `/activities/${a.id}`;
			setAlpine(card);

			const face = el('div', 'ac__face', cardScope);
			if (a.route_path) {
				const svg = svgEl('svg', cardScope) as unknown as SVGSVGElement;
				svg.setAttribute('class', 'ac__route');
				svg.setAttribute('viewBox', '0 0 100 100');
				svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
				svg.setAttribute('aria-hidden', 'true');
				const path = svgEl('path', cardScope);
				path.setAttribute('d', a.route_path);
				path.setAttribute('fill', 'none');
				path.setAttribute('stroke', 'var(--lake)');
				path.setAttribute('stroke-width', '2.2');
				path.setAttribute('stroke-linecap', 'round');
				path.setAttribute('stroke-linejoin', 'round');
				path.setAttribute('vector-effect', 'non-scaling-stroke');
				svg.appendChild(path);
				const m = a.route_path.match(/^M\s*(-?[\d.]+)[\s,]+(-?[\d.]+)/);
				if (m) {
					const dot = svgEl('circle', cardScope);
					dot.setAttribute('cx', m[1]);
					dot.setAttribute('cy', m[2]);
					dot.setAttribute('r', '1.8');
					dot.setAttribute('fill', 'var(--lake)');
					svg.appendChild(dot);
				}
				face.appendChild(svg as unknown as Node);
			} else {
				const nogps = el('div', 'ac__nogps', cardScope);
				noGpsStats(a).forEach((value, i) => {
					const stat = el('div', i === 0 ? 'ac__nogps-stat' : 'ac__nogps-stat ac__nogps-stat--sub', cardScope);
					stat.appendChild(el('span', i === 0 ? 'ac__nogps-value figure' : 'ac__nogps-value ac__nogps-value--sub figure', cardScope, value));
					nogps.appendChild(stat);
				});
				face.appendChild(nogps);
			}
			card.appendChild(face);

			const metaBox = el('div', 'ac__meta', cardScope);
			metaBox.appendChild(el('div', 'ac__title', cardScope, a.title));
			const sportRow = el('div', 'ac__sport', cardScope);
			const iconSvg = svgEl('svg', cardScope) as unknown as SVGSVGElement;
			iconSvg.setAttribute('class', 'ac__sport-mark');
			iconSvg.setAttribute('viewBox', '0 0 24 24');
			iconSvg.setAttribute('fill', 'none');
			iconSvg.setAttribute('stroke', 'currentColor');
			iconSvg.setAttribute('stroke-width', '1.6');
			iconSvg.setAttribute('aria-hidden', 'true');
			const iconPath = svgEl('path', cardScope);
			iconPath.setAttribute('d', sportIcon(a.sport));
			iconSvg.appendChild(iconPath);
			sportRow.appendChild(iconSvg as unknown as Node);
			sportRow.appendChild(el('span', undefined, cardScope, sportMeta(a.sport).label));
			metaBox.appendChild(sportRow);

			const statsRow = el('div', 'ac__stats figure', cardScope);
			cardStats(a).forEach((value, i) => {
				if (i > 0) statsRow.appendChild(el('span', 'ac__stats-sep', cardScope, '·'));
				statsRow.appendChild(document.createTextNode(value));
			});
			metaBox.appendChild(statsRow);
			card.appendChild(metaBox);
			wrap.appendChild(card);

			if (a.exertion != null && a.exertion_confidence && a.exertion_confidence !== 'measured') {
				const badge = el(
					'span',
					'conf-badge',
					pageScope,
					a.exertion_confidence === 'estimated' ? 'Est.' : 'Assumed',
				);
				badge.title = `Exertion ${a.exertion_confidence} — via ${a.exertion_method ?? 'an unrecorded method'}. Not measured from a power or heart-rate stream, so treat it as a rough read rather than a precise one.`;
				wrap.appendChild(badge);
			}
			return wrap;
		}

		function armSentinel() {
			observer.unobserve(sentinel!);
			sentinel!.hidden = done;
			if (!done) observer.observe(sentinel!);
		}

		async function load(reset = false) {
			if (!reset && (loading || done)) return;
			if (reset) writeUrl();
			const mySeq = ++seq;
			loading = true;
			errorBox.hidden = true;
			const from = reset ? 0 : offset;
			try {
				const res = await fetch(`/api/activities/list?${buildQuery(from)}`);
				if (!res.ok) throw new Error(`HTTP ${res.status}`);
				const { activities, total } = (await res.json()) as { activities: ApiActivity[]; total: number };
				if (mySeq !== seq) return;

				if (reset) {
					grid!.replaceChildren();
					offset = 0;
				}
				const batch = document.createDocumentFragment();
				for (const a of activities) batch.append(buildRow(a));
				grid!.append(batch);
				offset += activities.length;

				shown.textContent = fmt(total);
				renderFilterInfo(total);
				const filtered = activeCount() > 0;
				emptyUnfiltered.hidden = !(total === 0 && !filtered);
				emptyFiltered.hidden = !(total === 0 && filtered);
				done = offset >= total || activities.length < BATCH;
				armSentinel();
			} catch (e) {
				if (mySeq !== seq) return;
				console.error('activities/all: failed to load activities', e);
				errorBox.hidden = false;
			} finally {
				if (mySeq === seq) loading = false;
			}
		}

		const observer = new IntersectionObserver(
			(entries) => {
				if (entries.some((entry) => entry.isIntersecting)) load();
			},
			{ rootMargin: '600px' },
		);
		armSentinel();
		retry.addEventListener('click', () => load(offset === 0));

		// --- Filter summary sentence -----------------------------------------
		const filterInfo = document.getElementById('filterinfo')!;
		const filterInfoText = document.getElementById('filterinfo-text')!;

		function metersFromMiles(v: number) {
			return v * 1609.344;
		}
		function metersFromFeet(v: number) {
			return v * 0.3048;
		}
		function secondsFromMinutes(v: number) {
			return v * 60;
		}

		function renderFilterInfo(total: number) {
			const n = activeCount();
			filterInfo.hidden = n === 0;
			if (filterInfo.hidden) return;
			const parts: SentencePart[] = activityFilterSentence({
				total,
				sports: [...sports],
				dateFrom: dateFromInput.value || null,
				dateTo: dateToInput.value || null,
				distanceMinM: distRange?.isActive() ? metersFromMiles(distRange.min) : null,
				distanceMaxM: distRange?.isActive() ? metersFromMiles(distRange.max) : null,
				durationMinS: durRange?.isActive() ? secondsFromMinutes(durRange.min) : null,
				durationMaxS: durRange?.isActive() ? secondsFromMinutes(durRange.max) : null,
				elevationMinM: elevRange?.isActive() ? metersFromFeet(elevRange.min) : null,
				elevationMaxM: elevRange?.isActive() ? metersFromFeet(elevRange.max) : null,
				exertionMin: exRange?.isActive() ? exRange.min : null,
				exertionMax: exRange?.isActive() ? exRange.max : null,
				hasGps: gps,
				indoor,
				hasPower: flags.power,
				hasHr: flags.hr,
				place: place || null,
				personalBestOnly: flags.pr,
				measuredOnly: flags.measured,
				gearNames: Array.from(gear).map((id) => {
					const chip = document.querySelector<HTMLButtonElement>(`.chip[data-gear="${id}"]`);
					return chip?.textContent?.trim() ?? String(id);
				}),
			});
			filterInfoText.replaceChildren(...parts.map((p) => el('span', p.em ? 'finfo__em' : undefined, undefined, p.t)));
		}

		function applyFilters() {
			const n = activeCount();
			countBadge.textContent = n ? ` · ${n}` : '';
			toggle.classList.toggle('pill--on', panel.hidden === false || n > 0);
			clearAll.hidden = n === 0;
			load(true);
		}

		// --- Wiring ------------------------------------------------------------
		const panel = document.getElementById('filters')!;
		const toggle = document.getElementById('filters-toggle')!;
		const countBadge = document.getElementById('filters-count')!;
		const clearAll = document.getElementById('clear-all') as HTMLButtonElement;

		toggle.addEventListener('click', () => {
			panel.hidden = !panel.hidden;
			toggle.setAttribute('aria-expanded', String(!panel.hidden));
		});

		const sortSelect = document.getElementById('sort') as HTMLSelectElement;
		sortSelect.addEventListener('change', () => {
			sort = sortSelect.value;
			applyFilters();
		});
		const dirToggle = document.getElementById('dir-toggle') as HTMLButtonElement;
		dirToggle.addEventListener('click', () => {
			dir = dir === 'asc' ? 'desc' : 'asc';
			dirToggle.dataset.dir = dir;
			dirToggle.textContent = dir === 'asc' ? '↑' : '↓';
			applyFilters();
		});

		for (const chip of document.querySelectorAll<HTMLButtonElement>('.chip[data-sport]')) {
			chip.addEventListener('click', () => {
				const slug = chip.dataset.sport!;
				if (sports.has(slug)) sports.delete(slug);
				else sports.add(slug);
				chip.setAttribute('aria-pressed', String(sports.has(slug)));
				applyFilters();
			});
		}
		for (const chip of document.querySelectorAll<HTMLButtonElement>('.chip[data-gear]')) {
			chip.addEventListener('click', () => {
				const id = Number(chip.dataset.gear);
				if (gear.has(id)) gear.delete(id);
				else gear.add(id);
				chip.setAttribute('aria-pressed', String(gear.has(id)));
				applyFilters();
			});
		}
		for (const chip of document.querySelectorAll<HTMLButtonElement>('.chip[data-flag]')) {
			chip.addEventListener('click', () => {
				const key = chip.dataset.flag as keyof typeof flags;
				flags[key] = !flags[key];
				chip.setAttribute('aria-pressed', String(flags[key]));
				applyFilters();
			});
		}
		for (const chip of document.querySelectorAll<HTMLButtonElement>('.chip[data-tri]')) {
			chip.addEventListener('click', () => {
				const key = chip.dataset.tri as 'gps' | 'indoor';
				const val = chip.dataset.value === '1';
				const current = key === 'gps' ? gps : indoor;
				const next = current === val ? null : val;
				if (key === 'gps') gps = next;
				else indoor = next;
				for (const sibling of document.querySelectorAll<HTMLButtonElement>(`.chip[data-tri="${key}"]`)) {
					sibling.setAttribute('aria-pressed', String(sibling.dataset.value === '1' ? next === true : next === false));
				}
				applyFilters();
			});
		}
		for (const chip of document.querySelectorAll<HTMLButtonElement>('.chip[data-place]')) {
			chip.addEventListener('click', () => {
				const value = chip.dataset.place!;
				place = place === value ? '' : value;
				placeInput.value = place;
				for (const sibling of document.querySelectorAll<HTMLButtonElement>('.chip[data-place]')) {
					sibling.setAttribute('aria-pressed', String(sibling.dataset.place === place && place !== ''));
				}
				applyFilters();
			});
		}
		let placeDebounce = 0;
		placeInput.addEventListener('input', () => {
			window.clearTimeout(placeDebounce);
			placeDebounce = window.setTimeout(() => {
				const next = placeInput.value.trim();
				if (next === place) return;
				place = next;
				for (const chip of document.querySelectorAll<HTMLButtonElement>('.chip[data-place]')) {
					chip.setAttribute('aria-pressed', String(chip.dataset.place === place && place !== ''));
				}
				applyFilters();
			}, 300);
		});
		for (const input of [dateFromInput, dateToInput]) {
			input.addEventListener('change', applyFilters);
		}

		clearAll.addEventListener('click', () => {
			sports.clear();
			gear.clear();
			gps = null;
			indoor = null;
			place = '';
			placeInput.value = '';
			flags.power = flags.hr = flags.measured = flags.pr = false;
			dateFromInput.value = '';
			dateToInput.value = '';
			distRange?.reset();
			durRange?.reset();
			elevRange?.reset();
			exRange?.reset();
			for (const chip of document.querySelectorAll<HTMLButtonElement>('.chip[aria-pressed]')) {
				chip.setAttribute('aria-pressed', 'false');
			}
			applyFilters();
		});

		// Deliberately no chrome hydration here. The server already rendered the
		// badge, "Clear all" visibility and the filter sentence from this exact
		// URL — and did it from the real ActivityQuery, not from what DOM
		// controls happen to exist. Recomputing from activeCount() here would
		// actively regress a filter the URL set but the panel can't represent
		// yet (e.g. an ?exmin= narrower than any slider drawn, because the
		// collection has no range to size one from): the request already
		// honoured it, but a DOM-only recount would silently drop it from the
		// badge and sentence, and then from the query itself on the next
		// interaction. Chrome only needs to move once state actually changes,
		// which is exactly what applyFilters() does.
	</script>
</ActivityLayout>
