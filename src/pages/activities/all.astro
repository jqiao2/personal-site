---
// /activities/all — every activity, reverse chronological, with filters and
// sorts (ACTIVITIES.md §8). Same shape as /films/watched: a server-rendered
// first page whose filters come off the URL through activity-params.ts, a
// filter panel with a badge count, a sort control, a plain-English filter
// summary sentence, and a client script that pages in more results from
// /api/activities/list and rewrites the query string as you go.
//
// WHY THE FACETS AREN'T DEFERRED THE WAY FILMS' ARE. /films/watched puts off
// fetching its filter chips until after the grid paints, because reading
// every credit across the whole watched collection costs several times what
// the first 100 tiles do. This collection is a few hundred activities, and
// fetchActivityFacets pages that same small table once — cheap enough to
// read right here, so the panel is fully server-rendered on first paint and
// there is no "loading filters…" state to design for.
import ActivityLayout from '../../layouts/ActivityLayout.astro';
import ActivityCard, { type ActivityRow as ActivityCardRow } from '../../components/ActivityCard.astro';
import { requireOwner } from '../../lib/auth';
import SiteHeader from '../../components/SiteHeader.astro';
import { SPORTS, sportMeta, type SportFamily } from '../../lib/sports';
import { exertionLabel } from '../../lib/activity-tokens';
import {
	activityQueryFromParams,
	activityFilterCount,
	activityFilterSentence,
	fetchActivityFacets,
	fetchActivityPage,
	type ActivityFacetsPayload,
	type ActivityFilterQuery,
} from '../../lib/activity-params';
import type { ActivityListRow, ActivitySort } from '../../lib/activities';

export const prerender = false;

const BATCH = 30;
const METERS_PER_MILE = 1609.344;
const METERS_PER_FOOT = 0.3048;

const mi = (m: number) => m / METERS_PER_MILE;
const ft = (m: number) => m / METERS_PER_FOOT;
const min = (s: number) => s / 60;

// A visitor gets redacted rows (sport glyph, no link) and an empty facet set,
// both decided in the data layer — see redactActivities and fetchActivityPage.
// The toolbar and filter panel come off the page entirely rather than being
// left to draw themselves empty: with no chips, no gear, no places and no
// slider bounds there is nothing in them to operate.
const isOwner = await requireOwner(Astro.cookies);
const query: ActivityFilterQuery = activityQueryFromParams(Astro.url.searchParams);
const filterCount = activityFilterCount(query);
// Visitors have no filters, because fetchActivityPage drops all but sport and
// date for them — so the summary sentence and the badge would both be
// describing a filter that wasn't applied.
const hasFilters = isOwner && filterCount > 0;

// Defensive: a placeholder-credentialed Supabase client (see ACTIVITIES.md's
// handoff note) or an unmigrated database can throw outright rather than
// degrade gracefully the way a PostgREST "column doesn't exist" error does —
// this page must still render its real empty state rather than 500.
let rows: ActivityListRow[] = [];
let total = 0;
let facets: ActivityFacetsPayload = {
	sports: [],
	gear: [],
	places: [],
	distanceM: null,
	durationS: null,
	elevationM: null,
	exertion: null,
};
try {
	const [page, f] = await Promise.all([
		fetchActivityPage(query, { limit: BATCH, offset: 0 }, isOwner),
		fetchActivityFacets(isOwner),
	]);
	rows = page.rows;
	total = page.total;
	facets = f;
} catch (e) {
	console.error('activities/all: failed to load activities', e);
}

// The whole collection's size — every sport count sums to it, since the
// facet is built off the same top-level, non-deleted rows the filters run
// over. Free: no extra query beyond the facets already fetched above. A
// visitor has no facets, and no filters either, so their `total` is already
// the whole collection.
const collectionTotal = isOwner ? facets.sports.reduce((sum, s) => sum + s.count, 0) : total;
const hasMore = total > rows.length;
const num = (n: number) => n.toLocaleString('en-US');

const gearNames = query.gearIds?.length
	? facets.gear.filter((g) => query.gearIds!.includes(g.id)).map((g) => g.name)
	: [];

const summary = hasFilters
	? activityFilterSentence({
			total,
			sports: query.sports ?? [],
			dateFrom: query.dateFrom ?? null,
			dateTo: query.dateTo ?? null,
			distanceMinM: query.distanceMinM ?? null,
			distanceMaxM: query.distanceMaxM ?? null,
			durationMinS: query.durationMinS ?? null,
			durationMaxS: query.durationMaxS ?? null,
			elevationMinM: query.elevationMinM ?? null,
			elevationMaxM: query.elevationMaxM ?? null,
			exertionMin: query.exertionMin ?? null,
			exertionMax: query.exertionMax ?? null,
			hasGps: query.hasGps ?? null,
			indoor: query.indoor ?? null,
			hasPower: Boolean(query.hasPower),
			hasHr: Boolean(query.hasHr),
			place: query.place ?? null,
			personalBestOnly: Boolean(query.personalBestOnly),
			measuredOnly: Boolean(query.measuredOnly),
			gearNames,
		})
	: [];

// Sport chips, grouped by family in §6's canonical order — static from
// sports.ts, so (unlike films' tags/directors) these need no round trip at
// all to draw; a family with a zero count still shows, dimmed, so the panel
// reads as the whole taxonomy rather than only what happens to be logged.
const FAMILY_LABEL: Record<SportFamily, string> = {
	bike: 'Bike',
	run: 'Run',
	swim: 'Swim',
	foot: 'Hike & walk',
	snow: 'Snow',
	other: 'Other',
	transition: 'Transition',
};
const FAMILY_ORDER: SportFamily[] = ['bike', 'run', 'swim', 'foot', 'snow', 'other', 'transition'];
const sportCounts = new Map(facets.sports.map((s) => [s.sport, s.count]));
const sportsByFamily = FAMILY_ORDER.map((family) => ({
	family,
	label: FAMILY_LABEL[family],
	sports: SPORTS.filter((s) => sportMeta(s).family === family),
})).filter((g) => g.sports.length > 0);

const SORT_LABEL: Record<ActivitySort, string> = {
	date: 'Date',
	exertion: 'Exertion',
	distance: 'Distance',
	duration: 'Duration',
	elevation: 'Elevation gain',
	pace: 'Avg speed / pace',
	power: 'Avg power',
	hr: 'Avg heart rate',
	calories: 'Calories',
};
const SORTS: ActivitySort[] = ['date', 'exertion', 'distance', 'duration', 'elevation', 'pace', 'power', 'hr', 'calories'];
const currentSort: ActivitySort = query.sort ?? 'date';
const currentDir: 'asc' | 'desc' = query.sortDir ?? 'desc';

// Range bounds for the four sliders, rounded to friendly steps and only
// drawn when the collection actually spans one — a single-activity log (or
// an empty one) has nothing to narrow between, same convention as the film
// log's release/diary sliders.
function bounds(lo: number, hi: number, step: number, round: (n: number) => number) {
	const lov = round(lo / step) * step;
	const hiv = Math.max(lov + step, Math.ceil(hi / step) * step);
	return { lo: lov, hi: hiv };
}
const distBounds = facets.distanceM
	? bounds(mi(facets.distanceM.min), mi(facets.distanceM.max), 1, Math.floor)
	: null;
const durBounds = facets.durationS
	? bounds(min(facets.durationS.min), min(facets.durationS.max), 5, Math.floor)
	: null;
const elevBounds = facets.elevationM
	? bounds(ft(facets.elevationM.min), ft(facets.elevationM.max), 50, Math.floor)
	: null;
const exBounds = facets.exertion ? bounds(facets.exertion.min, facets.exertion.max, 5, Math.floor) : null;

const distVal = {
	min: query.distanceMinM != null ? mi(query.distanceMinM) : (distBounds?.lo ?? 0),
	max: query.distanceMaxM != null ? mi(query.distanceMaxM) : (distBounds?.hi ?? 0),
};
const durVal = {
	min: query.durationMinS != null ? min(query.durationMinS) : (durBounds?.lo ?? 0),
	max: query.durationMaxS != null ? min(query.durationMaxS) : (durBounds?.hi ?? 0),
};
const elevVal = {
	min: query.elevationMinM != null ? ft(query.elevationMinM) : (elevBounds?.lo ?? 0),
	max: query.elevationMaxM != null ? ft(query.elevationMaxM) : (elevBounds?.hi ?? 0),
};
const exVal = {
	min: query.exertionMin ?? exBounds?.lo ?? 0,
	max: query.exertionMax ?? exBounds?.hi ?? 0,
};

// A hidden, off-DOM ActivityCard purely to source its component's scoped
// style hash (Astro's data-astro-cid-* attribute) for the client script:
// rows paged in after the first render are built by hand in JS (Astro
// components only ever render on the server), and without this hash on
// every hand-built node, ActivityCard's <style> block — which targets
// `.ac`, `.ac__face`, etc. under that same generated attribute — would
// never match them. Always rendered, independent of whether any real
// activity exists yet, so the first client-side batch can always find it.
const scopeDummy: ActivityCardRow = {
	id: 0,
	sport: 'other',
	title: '',
	local_date: '2000-01-01',
	distance_m: null,
	moving_seconds: null,
	elapsed_seconds: 0,
	elevation_gain_m: null,
	route_path: null,
};
---

<ActivityLayout title="All activities — Jason's activity log">
	<SiteHeader pathname={Astro.url.pathname} theme="activity" />
	<div class="page">
		<div id="scope-source" hidden aria-hidden="true">
			<ActivityCard activity={scopeDummy} size="row" />
		</div>

		<header class="head">
			<a class="back" href="/activities">← Jason's activity log</a>
			<h1>All activities</h1>
			<div class="sub">
				<span class="sub__n">{num(collectionTotal)}</span> activities logged · showing{' '}
				<span class="sub__n" id="shown">{num(total)}</span>
			</div>
		</header>

		<!-- Owner only: with no facets there is nothing in the panel to draw and
		     nothing but sport and date the server would honour anyway. Hidden
		     rather than removed so the client script below — which wires the
		     sort, the chips and the sliders on load — still finds every node it
		     expects instead of dying on the first null and taking the infinite
		     scroll down with it. -->
		<div class="toolbar" hidden={!isOwner}>
			<div class="sortby">
				<label for="sort" class="sortby__label">Sort</label>
				<select id="sort">
					{SORTS.map((s) => (
						<option value={s} selected={s === currentSort}>
							{SORT_LABEL[s]}
						</option>
					))}
				</select>
				<button type="button" id="dir-toggle" aria-label="Toggle sort direction" data-dir={currentDir}>
					{currentDir === 'asc' ? '↑' : '↓'}
				</button>
			</div>
			<button
				type="button"
				id="filters-toggle"
				class={hasFilters ? 'pill pill--on' : 'pill'}
				aria-expanded="false"
				aria-controls="filters"
			>
				Filters<span id="filters-count">{hasFilters ? ` · ${filterCount}` : ''}</span>
			</button>
		</div>

		<div class="panel" id="filters" hidden>
			<div class="panel__head">
				<span class="panel__title">Filter activities</span>
				<button type="button" id="clear-all" class="clear" hidden={!hasFilters}>Clear all</button>
			</div>

			<div class="panel__grid">
				<section class="panel__wide">
					<h2 class="grp">Sport</h2>
					<div class="sport-groups">
						{
							sportsByFamily.map((g) => (
								<div class="sport-family">
									<span class="sport-family__label">{g.label}</span>
									<div class="chips">
										{g.sports.map((slug) => {
											const count = sportCounts.get(slug) ?? 0;
											return (
												<button
													type="button"
													class="chip"
													data-sport={slug}
													aria-pressed={(query.sports?.includes(slug) ?? false) ? 'true' : 'false'}
													disabled={count === 0}
												>
													{sportMeta(slug).label}
													{count > 0 && <span class="chip__count">{count}</span>}
												</button>
											);
										})}
									</div>
								</div>
							))
						}
					</div>
				</section>

				<section>
					<h2 class="grp">Date</h2>
					<div class="daterange">
						<input type="date" id="datefrom" value={query.dateFrom ?? ''} aria-label="Earliest date" />
						<span class="daterange__sep">–</span>
						<input type="date" id="dateto" value={query.dateTo ?? ''} aria-label="Latest date" />
					</div>
				</section>

				<section>
					<h2 class="grp">Type</h2>
					<div class="chips chips--gap">
						<button type="button" class="chip" data-tri="gps" data-value="1" aria-pressed={(query.hasGps === true) ? 'true' : 'false'}>GPS route</button>
						<button type="button" class="chip" data-tri="gps" data-value="0" aria-pressed={(query.hasGps === false) ? 'true' : 'false'}>No GPS</button>
						<button type="button" class="chip" data-tri="indoor" data-value="1" aria-pressed={(query.indoor === true) ? 'true' : 'false'}>Indoor</button>
						<button type="button" class="chip" data-tri="indoor" data-value="0" aria-pressed={(query.indoor === false) ? 'true' : 'false'}>Outdoor</button>
					</div>
				</section>

				<section>
					<h2 class="grp">Data &amp; highlights</h2>
					<div class="chips chips--gap">
						<button type="button" class="chip" data-flag="power" aria-pressed={(!!query.hasPower) ? 'true' : 'false'}>Has power</button>
						<button type="button" class="chip" data-flag="hr" aria-pressed={(!!query.hasHr) ? 'true' : 'false'}>Has HR</button>
						<button type="button" class="chip" data-flag="measured" aria-pressed={(!!query.measuredOnly) ? 'true' : 'false'} title="Only activities whose exertion score came from a measured stream (power or heart rate), not an estimate.">
							Measured exertion only
						</button>
						<button type="button" class="chip" data-flag="pr" aria-pressed={(!!query.personalBestOnly) ? 'true' : 'false'}>Personal bests</button>
					</div>
				</section>

				{distBounds && (
					<section>
						<h2 class="grp">Distance</h2>
						<div class="range" id="dist-range">
							<div class="range__track"></div>
							<div class="range__fill" id="dist-fill"></div>
							<input type="range" id="dist-min" min={distBounds.lo} max={distBounds.hi} step="1" value={distVal.min} aria-label="Minimum distance" />
							<input type="range" id="dist-max" min={distBounds.lo} max={distBounds.hi} step="1" value={distVal.max} aria-label="Maximum distance" />
							<div class="range__ends">
								<span id="dist-min-label">{Math.round(distVal.min)} mi</span>
								<span id="dist-max-label">{Math.round(distVal.max)} mi</span>
							</div>
						</div>
					</section>
				)}

				{durBounds && (
					<section>
						<h2 class="grp">Duration</h2>
						<div class="range" id="dur-range">
							<div class="range__track"></div>
							<div class="range__fill" id="dur-fill"></div>
							<input type="range" id="dur-min" min={durBounds.lo} max={durBounds.hi} step="5" value={durVal.min} aria-label="Minimum duration" />
							<input type="range" id="dur-max" min={durBounds.lo} max={durBounds.hi} step="5" value={durVal.max} aria-label="Maximum duration" />
							<div class="range__ends">
								<span id="dur-min-label">{Math.round(durVal.min)}m</span>
								<span id="dur-max-label">{Math.round(durVal.max)}m</span>
							</div>
						</div>
					</section>
				)}

				{elevBounds && (
					<section>
						<h2 class="grp">Elevation gain</h2>
						<div class="range" id="elev-range">
							<div class="range__track"></div>
							<div class="range__fill" id="elev-fill"></div>
							<input type="range" id="elev-min" min={elevBounds.lo} max={elevBounds.hi} step="50" value={elevVal.min} aria-label="Minimum elevation gain" />
							<input type="range" id="elev-max" min={elevBounds.lo} max={elevBounds.hi} step="50" value={elevVal.max} aria-label="Maximum elevation gain" />
							<div class="range__ends">
								<span id="elev-min-label">{Math.round(elevVal.min).toLocaleString('en-US')} ft</span>
								<span id="elev-max-label">{Math.round(elevVal.max).toLocaleString('en-US')} ft</span>
							</div>
						</div>
					</section>
				)}

				{exBounds && (
					<section class="panel__wide">
						<h2 class="grp">
							Exertion
							<span class="grp__hint">an hour at threshold scores 100 — easy &lt;50 · steady 50–100 · hard 100–200 · brutal 200+</span>
						</h2>
						<div class="range range--exertion" id="ex-range">
							<div class="range__track"></div>
							<div class="range__fill" id="ex-fill"></div>
							<input type="range" id="ex-min" min={exBounds.lo} max={exBounds.hi} step="5" value={exVal.min} aria-label="Minimum exertion" />
							<input type="range" id="ex-max" min={exBounds.lo} max={exBounds.hi} step="5" value={exVal.max} aria-label="Maximum exertion" />
							<div class="range__ends">
								<span id="ex-min-label">{Math.round(exVal.min)} · {exertionLabel(exVal.min)}</span>
								<span id="ex-max-label">{Math.round(exVal.max)} · {exertionLabel(exVal.max)}</span>
							</div>
						</div>
					</section>
				)}

				{facets.gear.length > 0 && (
					<section class="panel__wide">
						<h2 class="grp">Gear</h2>
						<div class="chips">
							{facets.gear.map((g) => (
								<button type="button" class="chip" data-gear={g.id} aria-pressed={(query.gearIds?.includes(g.id) ?? false) ? 'true' : 'false'}>
									{g.name}
								</button>
							))}
						</div>
					</section>
				)}

				<section class="panel__wide">
					<h2 class="grp">Start place</h2>
					<input type="text" id="place" class="place-input" placeholder="e.g. Snoqualmie Pass" value={query.place ?? ''} autocomplete="off" />
					{facets.places.length > 0 && (
						<div class="chips" id="place-chips">
							{facets.places.slice(0, 10).map((p) => (
								<button type="button" class="chip" data-place={p.place} aria-pressed={(query.place === p.place) ? 'true' : 'false'}>
									{p.place}
								</button>
							))}
						</div>
					)}
				</section>
			</div>
		</div>

		<div class="filterinfo" id="filterinfo" hidden={!hasFilters}>
			<span class="filterinfo__tag">Filter</span>
			<p class="filterinfo__text" id="filterinfo-text">
				{summary.map((part) => <span class={part.em ? 'finfo__em' : undefined}>{part.t}</span>)}
			</p>
		</div>

		<div class="grid" id="grid">
			{
				rows.map((row) => (
					<div class="row-item">
						<ActivityCard activity={row} size="row" />
						{row.exertion != null && row.exertion_confidence && row.exertion_confidence !== 'measured' && (
							<span
								class="conf-badge"
								title={`Exertion ${row.exertion_confidence} — via ${row.exertion_method ?? 'an unrecorded method'}. Not measured from a power or heart-rate stream, so treat it as a rough read rather than a precise one.`}
							>
								{row.exertion_confidence === 'estimated' ? 'Est.' : 'Assumed'}
							</span>
						)}
					</div>
				))
			}
		</div>

		<p class="empty" id="empty-unfiltered" hidden={!(total === 0 && !hasFilters)}>
			No activities logged yet. The <a href="/activities/settings">import</a> hasn't run.
		</p>
		<p class="empty" id="empty-filtered" hidden={!(total === 0 && hasFilters)}>
			No activities match these filters.
		</p>

		<div id="sentinel" data-batch={BATCH} hidden={!hasMore}>
			<span class="sentinel__spinner" aria-hidden="true"></span>
			<span class="sentinel__text">Loading more…</span>
		</div>
		<p id="load-error" class="load-error" hidden>
			Couldn't load more activities. <button type="button" id="retry">Retry</button>
		</p>
	</div>

	<style>
		.page {
			max-width: 1100px;
			margin: 0 auto;
			padding: 2rem 1.5rem 6rem;
		}
		#scope-source {
			display: none;
		}

		.head {
			margin-bottom: 1.5rem;
		}
		.back {
			display: inline-block;
			font-size: 0.8rem;
			color: #6b7b88;
			margin-bottom: 0.6rem;
		}
		.back:hover {
			color: #1c6e8c;
		}
		h1 {
			font-size: 2.6rem;
			margin: 0 0 0.4rem;
			letter-spacing: -0.5px;
		}
		.sub {
			font-size: 0.85rem;
			color: #6b7b88;
		}
		.sub__n {
			color: #1c6e8c;
			font-weight: 600;
			font-variant-numeric: tabular-nums;
		}

		.toolbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-bottom: 0.9rem;
		}
		.sortby {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}
		.sortby__label {
			font-size: 0.72rem;
			text-transform: uppercase;
			letter-spacing: 1.2px;
			color: #6b7b88;
		}
		#sort {
			font: inherit;
			font-size: 0.85rem;
			padding: 0.45rem 0.6rem;
			border-radius: 8px;
			border: 1px solid #c9d4dc;
			background: #f8fbfd;
			color: #3d4a55;
		}
		#dir-toggle {
			font-size: 0.95rem;
			width: 2rem;
			height: 2rem;
			border-radius: 8px;
			border: 1px solid #c9d4dc;
			background: #f8fbfd;
			color: #1c6e8c;
			cursor: pointer;
		}
		#dir-toggle:hover {
			border-color: #1c6e8c;
		}
		.pill {
			font-size: 0.82rem;
			padding: 0.5rem 0.85rem;
			border-radius: 8px;
			cursor: pointer;
			border: 1px solid #c9d4dc;
			background: #f8fbfd;
			color: #3d4a55;
		}
		.pill:hover {
			border-color: #1c6e8c;
		}
		.pill--on {
			background: #1c6e8c;
			color: #f8fbfd;
			border-color: #1c6e8c;
			font-weight: 600;
		}

		.filterinfo {
			background: #f8fbfd;
			border: 1px solid #c9d4dc;
			border-radius: 10px;
			padding: 0.85rem 1.1rem;
			margin-bottom: 1rem;
			display: flex;
			align-items: baseline;
			gap: 0.9rem;
		}
		.filterinfo[hidden] {
			display: none;
		}
		.filterinfo__tag {
			font-size: 0.65rem;
			text-transform: uppercase;
			letter-spacing: 1.6px;
			color: #6b7b88;
			flex: none;
		}
		.filterinfo__text {
			font-family: 'Instrument Serif', Georgia, serif;
			font-size: 1.05rem;
			line-height: 1.5;
			margin: 0;
			color: #3d4a55;
		}
		.finfo__em {
			color: #1c6e8c;
			font-weight: 600;
			font-style: normal;
