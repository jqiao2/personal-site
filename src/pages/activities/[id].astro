				/>
			)
		}

		{
			laps.length > 0 && !skiView && (
				<section class="laps">
					<h2 class="section-h">Laps <span class="section-h__meta">{laps.length}</span></h2>
					<div class="laps__scroll">
						<table class="laps__table">
							<thead>
								<tr>
									<th>#</th>
									<th>Type</th>
									<th>Distance</th>
									<th>Time</th>
									{meta.paceStyle !== 'none' && <th>{meta.paceStyle === 'speed' ? 'Speed' : 'Pace'}</th>}
									<th>Avg HR</th>
									<th>Avg power</th>
									<th>Elev gain</th>
								</tr>
							</thead>
							<tbody>
								{
									laps.map((lap: ActivityLap) => {
										const lapRow: StatRow = {
											distance_m: lap.distance_m,
											moving_seconds: lap.moving_seconds ?? lap.elapsed_seconds,
											avg_hr: lap.avg_hr,
											avg_power_w: lap.avg_power_w,
											avg_speed_ms: lap.avg_speed_ms,
											elevation_gain_m: lap.elevation_gain_m,
										};
										const paceKey: StatKey = meta.paceStyle === 'speed' ? 'avg_speed' : meta.paceStyle === 'per_100m' ? 'pace_100m' : 'avg_pace';
										return (
											<tr class:list={[lap.lap_type === 'transition' && 'laps__row--transition']}>
												<td>{lap.lap_index}</td>
												<td><span class:list={['laps__type', `laps__type--${lap.lap_type}`]}>{lap.lap_type}</span></td>
												<td class="figure">{formatStat('distance', lapRow).value}</td>
												<td class="figure">{formatStat('moving_time', lapRow).value}</td>
												{meta.paceStyle !== 'none' && <td class="figure">{formatStat(paceKey, lapRow).value}</td>}
												<td class="figure">{formatStat('avg_hr', lapRow).value}</td>
												<td class="figure">{formatStat('avg_power', lapRow).value}</td>
												<td class="figure">{formatStat('elevation_gain', lapRow).value}</td>
											</tr>
										);
									})
								}
							</tbody>
						</table>
					</div>
				</section>
			)
		}

		{
			children.length > 0 && (
				<section class="legs">
					<h2 class="section-h">Multisport day <span class="section-h__meta">{children.length} legs</span></h2>
					<div class="legs__list">
