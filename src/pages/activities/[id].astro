						{activity.tags.length > 0 && (
							<div class="head__tags">
								{activity.tags.map((t) => (
									<span class="head__tag">{t}</span>
								))}
							</div>
						)}
					</>
				)
			}
		</header>

		{
			hasRoute ? (
				<>
					<ActivityMap title={activity.title} sport={activity.sport} polyline={activity.polyline!} />
					{graphData && <ActivityGraph data={graphData} preferTime={meta.indoor} />}
					{
						primaryStats.length > 0 && (
							<div class="stats stats--row">
								{
									primaryStats.map((s) => (
										<div class="stat">
											<div class="stat__value figure">{s.value}</div>
											<div class="stat__label">{s.label}</div>
										</div>
									))
								}
							</div>
						)
					}
				</>
			) : (
				<>
					<div class="nogps">
						{
							primaryStats.length > 0 && (
								<div class="stats stats--hero">
									{
										primaryStats.map((s) => (
											<div class="stat stat--hero">
												<div class="stat__value stat__value--hero figure">{s.value}</div>
												<div class="stat__label">{s.label}</div>
											</div>
										))
									}
								</div>
							)
						}
					</div>
					{/* No map to scrub, but the combined profile still reads the
					    trainer/treadmill's HR, power and speed against time. */}
					{graphData && <ActivityGraph data={graphData} preferTime={meta.indoor} />}
				</>
			)
		}

		{
			activity.exertion != null && (
				<section class="exertion">
					<div class="exertion__score">
						<span class="exertion__value figure" style={`color:${exInk}`}>{Math.round(activity.exertion)}</span>
						<span class="exertion__word" style={`color:${exInk}`}>{exWord}</span>
					</div>
					<div class="exertion__body">
						<div class="exertion__badges">
							{activity.exertion_method && <span class="badge">{METHOD_LABEL[activity.exertion_method] ?? activity.exertion_method}</span>}
							{activity.exertion_confidence && (
								<span class:list={['badge', `badge--${activity.exertion_confidence}`]}>
									{CONFIDENCE_LABEL[activity.exertion_confidence] ?? activity.exertion_confidence}
								</span>
							)}
							{activity.intensity_factor != null && <span class="badge badge--quiet">IF {activity.intensity_factor.toFixed(2)}</span>}
						</div>
						{detail && <p class="exertion__detail">{detail}</p>}
					</div>
				</section>
			)
		}

		{
			secondaryStats.length > 0 && (
				<section class="secondary">
					<h2 class="section-h">Details</h2>
					<div class="stats stats--secondary">
