							{activity.start_place && <span>{activity.start_place}</span>}
							{activityGear && <span class="head__dot">·</span>}
							{activityGear && <span>{gearLabel(activityGear)}</span>}
							{activity.device_name && <span class="head__dot">·</span>}
							{activity.device_name && <span class="head__device">{activity.device_name}</span>}
						</div>
						{activity.notes && <p class="head__notes">{activity.notes}</p>}
						{activity.movie_tmdb_id && (
							<a class="head__movie" href={`/films/movie/${activity.movie_tmdb_id}`}>
