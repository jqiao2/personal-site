---
// The activity detail page — ACTIVITIES.md §1: "primarily a view of the
// activity on an interactive map", with sport-aware stats leading below it.
//
// STRUCTURE, TOP TO BOTTOM: a route map (or, when there is no GPS, a
// stats-forward hero in its place — §7's "must read as deliberate, not
// broken"), the sport's `primaryStats` set large, the exertion score with its
// method and confidence spelled out (§3: never an unexplained claim), the
// terrain/HR/power/speed charts built straight from `activity_streams`, a lap
// table when the activity has laps, and the multisport thread (child legs for
// a parent, a link back up for a child).
//
// WHY THE EXERTION SENTENCE IS RECOMPUTED RATHER THAN JUST READ OFF THE ROW.
// `activities.exertion`/`exertion_method`/`exertion_confidence` are the
// persisted, authoritative numbers — this page always displays *those*, the
// same ones every list and card on the site would show, so the number here
// never disagrees with the number anywhere else. But the *sentence* that
// explains it (`ExertionResult.detail`) isn't a stored column — exertion.ts is
// built as "pure functions over streams… so it can be re-run… when a
// threshold changes", so this page re-runs the same cascade with the
// activity's current streams and the threshold row in force on its date, and
// only trusts the resulting sentence when the recomputed method matches the
// stored one (proof the same rung produced both). When it doesn't match —
// streams that existed at ingest aren't available now, say — this falls back
// to a plain, still-honest sentence built from the stored method and
// confidence alone, rather than presenting a mismatched explanation as if it
// justified the stored number.
//
// WHY CHARTS ARE SERVER-RENDERED SVG, NOT A CLIENT CHART LIBRARY. The streams
// are already arrays by the time this runs; turning them into an area/line
// path is arithmetic, not a rendering problem that needs a dependency. It also
// means the potentially-thousands-of-samples stream arrays never have to be
// serialised to the client at all — only the small, already-computed path
// strings are.
import ActivityLayout from '../../layouts/ActivityLayout.astro';
import ActivityMap from '../../components/ActivityMap.astro';
import ActivityGraph from '../../components/ActivityGraph.astro';
import SkiRuns from '../../components/SkiRuns.astro';
import SkiRunsEditor from '../../components/SkiRunsEditor.astro';
import { buildGraphData } from '../../lib/activity-graph';
import { buildSkiView, buildSkiEditRows } from '../../lib/ski-view';
import { resolveSkiSegments, type SkiSegmentType, type SkiStreams } from '../../lib/ski';
import {
	getActivity,
	getActivityStreams,
	listActivityLaps,
	listActivityChildren,
	thresholdsOn,
	updateActivity,
	saveSkiSegments,
	deleteActivity,
	listGear,
	type ActivityLap,
	type ActivityRow,
} from '../../lib/activities';
import { requireOwner } from '../../lib/auth';
import { isPinned } from '../../lib/pins';
import PinButton from '../../components/PinButton.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { sportMeta, sportIcon, formatStat, isStatRelevant, SPORTS, type StatKey, type StatRow, type FormattedStat } from '../../lib/sports';
import { computeExertion, type Thresholds, type ExertionStreams } from '../../lib/exertion';
import { ALPINE, exertionInk, exertionLabel } from '../../lib/activity-tokens';

export const prerender = false;

// Drop a hand-typed "Ride movie: …" line from notes once the film is linked —
// the link carries it structurally, so keeping the line just duplicates it.
// Removes the whole matching line and collapses the blank gap it leaves.
function stripRideMovieNote(notes: string): string {
	return notes
		.split('\n')
		.filter((line) => !/^\s*ride\s*movie\s*[:\-–]/i.test(line))
		.join('\n')
		.replace(/\n{3,}/g, '\n\n')
		.trim();
}

const id = Number(Astro.params.id);
const validId = Number.isInteger(id) && id > 0;

// ---------------------------------------------------------------------------
// Owner-only writes, self-handled by this page rather than a dedicated API
// route: both are a form post from this page and nowhere else, so a route
// would only add a file and a fetch() between the button and the row.
//
// The edit state is a second rendering of the header (`?edit=1`), not a
// dialog and not an inline contenteditable — a plain GET away and a plain
// POST back, which is why it needs no client JavaScript at all and works with
// the browser's own back button as an undo of the *opening*, not of the save.
//
// ONLY AUTHORED FIELDS ARE EDITABLE. Title, notes, sport, gear and tags are
// things a person decides. Distance, heart rate and exertion are things a
// device recorded — typing over those would turn every number on this site
// from a reading into a claim, so they aren't offered.
// ---------------------------------------------------------------------------
if (Astro.request.method === 'POST') {
	const isOwner = validId && (await requireOwner(Astro.cookies));
	if (!isOwner) {
		return new Response('Forbidden', { status: 403 });
	}
	const form = await Astro.request.formData();
	const action = form.get('action');
	if (action === 'delete') {
		// Soft — see deleteActivity. The redirect goes to the index rather than
		// back here, because "here" is now a 404.
		await deleteActivity(id);
		return Astro.redirect('/activities', 303);
	} else if (action === 'save') {
		const title = String(form.get('title') ?? '').trim();
		const sport = String(form.get('sport') ?? '');
		const gearRaw = String(form.get('gear_id') ?? '');
		// An empty title is the one input that can't be saved as given — the
		// header would have nothing to say. Reopen the editor rather than
		// silently keeping the old one.
		if (!title) return Astro.redirect(`${Astro.url.pathname}?edit=1&error=title`, 303);
		// The film watched during a virtual ride. The picker posts the TMDB id and
		// its title together; an empty id unlinks. A non-numeric id is treated as
		// "leave/clear" rather than trusted.
		const raw = String(form.get('movie_tmdb_id') ?? '').trim();
		const tmdbId = raw === '' ? null : Number(raw);
		const movie: { movieTmdbId: number | null; movieTitle?: string } =
			Number.isInteger(tmdbId) && (tmdbId as number) > 0
				? { movieTmdbId: tmdbId as number, movieTitle: String(form.get('movie_title') ?? '') }
				: { movieTmdbId: null };
		// Once a film is linked, the hand-typed "Ride movie: …" note is redundant —
		// the link carries it structurally — so strip that line on save.
		let notes = String(form.get('notes') ?? '');
		if (movie.movieTmdbId != null) notes = stripRideMovieNote(notes);
		await updateActivity(id, {
			title,
			notes,
			privateNotes: String(form.get('private_notes') ?? ''),
			// A sport off the canonical list would break every icon, stat set and
			// filter that reads it, so an unknown one leaves the sport alone.
			...(SPORTS.includes(sport as (typeof SPORTS)[number]) ? { sport } : {}),
			gearId: Number.isInteger(Number(gearRaw)) && gearRaw !== '' ? Number(gearRaw) : null,
			// A checkbox that isn't ticked isn't submitted, so "public" is the
			// absence of the field rather than a value — which is the right way
			// round here: a malformed post publishes nothing.
			private: form.get('private') !== 'public',
			// Same unticked-means-absent shape as `private` above, but the plain
			// way round: the box says "hide", so ticked is true.
			hideFromReview: form.get('hide_from_review') === 'hide',
			...movie,
			// Comma-separated in, deduped and trimmed here — the input is a
			// sentence to type, the column is a set.
			tags: [
				...new Set(
					String(form.get('tags') ?? '')
						.split(',')
						.map((t) => t.trim())
						.filter(Boolean),
				),
			],
		});
	} else if (action === 'reset-runs') {
		// Drop the override, reverting display and exertion to auto-detection.
		await saveSkiSegments(id, null);
		return Astro.redirect(Astro.url.pathname, 303);
	} else if (action === 'save-runs') {
		// The editor posts three parallel arrays in row order — start, end and the
		// (possibly reclassified) type of every segment. Zip them back into the
		// override partition; saveSkiSegments re-scores exertion on it.
		const t0s = form.getAll('seg_t0');
		const t1s = form.getAll('seg_t1');
		const types = form.getAll('seg_type');
		const valid = new Set(['run', 'lift', 'idle']);
		const override = t0s
			.map((t0, i) => ({ t0: Number(t0), t1: Number(t1s[i]), type: String(types[i]) }))
			.filter((s) => Number.isFinite(s.t0) && Number.isFinite(s.t1) && s.t1 > s.t0 && valid.has(s.type))
			.map((s) => ({ t0: s.t0, t1: s.t1, type: s.type as SkiSegmentType }));
		if (override.length > 0) await saveSkiSegments(id, override);
		return Astro.redirect(Astro.url.pathname, 303);
	}
	return Astro.redirect(Astro.url.pathname, 303);
}

const isOwner = await requireOwner(Astro.cookies);
const activity = validId ? await getActivity(id, isOwner) : null;

// A private activity does not exist for anyone but the owner — not as a stub,
// not as a "log in to see this", which would itself confirm there was
// something here on this date. It falls into the same 404 as an id that was
// never used, and the copy in that 404 already says exactly this.
if (!activity || (activity.private && !isOwner)) {
	return new Response(
		`<!doctype html><html lang="en"><head><meta charset="utf-8">
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<title>Not found</title>
		<style>
			body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;
				padding:40px 24px;background:linear-gradient(180deg,#dceaf4 0%,#f8fbfd 640px);
				color:#3d4a55;font-family:'Instrument Sans',Arial,sans-serif}
			.box{max-width:420px;text-align:center}
			.code{font-family:'Instrument Serif',Georgia,serif;font-size:64px;color:#9fc4dd;line-height:1}
			.head{font-family:'Instrument Serif',Georgia,serif;font-size:24px;color:#3d4a55;margin-top:14px;line-height:1.4}
			p{font-size:14px;color:#6b7b88;margin:12px 0 0;line-height:1.65}
			a{display:inline-block;margin-top:22px;font-size:13px;color:#1c6e8c;text-decoration:none}
		</style></head><body><div class="box">
		<div class="code">404</div>
		<div class="head">There is nothing at this address.</div>
		<p>No redacted page, no placeholder — as far as this log is concerned the activity was never here.</p>
		<a href="/activities">&larr; Back to Activities</a>
		</div></body></html>`,
		{ status: 404, headers: { 'content-type': 'text/html; charset=utf-8' } },
	);
}

const meta = sportMeta(activity.sport);
const hasRoute = Boolean(activity.polyline);
const activityPinned = isOwner ? await isPinned('move', activity.id) : false;

const [streams, laps, parent, children, thresholds] = await Promise.all([
	getActivityStreams(activity.id),
	listActivityLaps(activity.id),
	activity.parent_id ? getActivity(activity.parent_id) : Promise.resolve(null),
	activity.parent_id ? Promise.resolve([]) : listActivityChildren(activity.id, isOwner),
	thresholdsOn(activity.local_date),
]);

// ---------------------------------------------------------------------------
// Sport-aware stats — §6. `sportMeta(activity.sport).primaryStats` decides
// both which stats lead and in what order; everything else in the StatKey
// union that has an actual value on this activity goes in the secondary
// block below it. formatStat is already null-safe (returns '—' for a missing
// input) — filtered out here rather than rendered, per §7's "never a dash".
// ---------------------------------------------------------------------------
// 'exertion' is deliberately excluded from both grids below — it always gets
// its own explained section (score + method + confidence + the sentence
// behind it), never a bare number sitting in a tile with no context, which is
// exactly the "unexplained claim" §3 rules out.
const ALL_STAT_KEYS: StatKey[] = [
	'distance',
	'moving_time',
	'elapsed_time',
	'elevation_gain',
	'avg_power',
	'normalized_power',
	'avg_speed',
	'avg_pace',
	'pace_100m',
	'avg_hr',
	'max_hr',
	'swolf',
	'pool_length',
	'work_kj',
	'elev_high',
	'vertical_descent',
	'max_speed',
	'runs',
	'water_temp',
	'calories',
];

// Lift-served snow days get a real run/lift breakdown recovered from the
// altitude stream (src/lib/ski-view.ts) — the `activity_laps` rows on these are
// Strava's arbitrary auto-laps, each spanning part of a lift and part of a run,
// so they are useless as runs. The detected run count is the honest "Runs"
// stat; every other sport still counts its laps.
const isLiftServed = activity.sport === 'alpine_ski' || activity.sport === 'snowboard';
const skiStreams: SkiStreams = {
	time_s: streams?.time_s ?? undefined,
	altitude_m: streams?.altitude_m ?? undefined,
	distance_m: streams?.distance_m ?? undefined,
	latlng: streams?.latlng ?? undefined,
	moving: streams?.moving ?? undefined,
};
// The resolved segments honour a saved edit (activity.ski_segments), else
// auto-detect. One computation drives the breakdown, the profile bands and the
// editor, so they never disagree.
const skiSegments = isLiftServed ? resolveSkiSegments(skiStreams, activity.ski_segments) : [];
const skiView = skiSegments.length > 0 ? buildSkiView(skiSegments, skiStreams, activity.max_speed_ms) : null;
const editingRuns = isOwner && isLiftServed && Astro.url.searchParams.has('editruns');
const skiEditRows = editingRuns ? buildSkiEditRows(skiSegments) : [];
const skiEdited = isLiftServed && activity.ski_segments != null;
const runsCount = skiView
	? skiView.summary.runs
	: laps.length > 0
		? laps.filter((l) => l.lap_type === 'lap').length
		: null;

const statRow: StatRow = {
	distance_m: activity.distance_m,
	moving_seconds: activity.moving_seconds,
	elapsed_seconds: activity.elapsed_seconds,
	elevation_gain_m: activity.elevation_gain_m,
	elev_high_m: activity.elev_high_m,
	elevation_loss_m: activity.elevation_loss_m,
	avg_power_w: activity.avg_power_w,
	normalized_power_w: activity.normalized_power_w,
	avg_speed_ms: activity.avg_speed_ms,
	max_speed_ms: activity.max_speed_ms,
	avg_hr: activity.avg_hr,
	max_hr: activity.max_hr,
	avg_swolf: activity.avg_swolf,
	pool_length_m: activity.pool_length_m,
	work_kj: activity.work_kj,
	exertion: activity.exertion,
	avg_temp_c: activity.avg_temp_c,
	calories: activity.calories,
	runs: runsCount,
};

function statsFor(keys: StatKey[]): FormattedStat[] {
	return keys.map((k) => formatStat(k, statRow)).filter((s) => s.value !== '—');
}

const primaryKeys: StatKey[] = meta.primaryStats.filter((k) => k !== 'exertion');
const primaryStats = statsFor(primaryKeys);

// avg_pace / pace_100m / avg_speed are three renderings of the same
// avg_speed_ms column — formatStat computes all three for any activity that
// has a speed, regardless of sport, so without this the secondary block
// would show a run's pace as minutes-per-mile AND minutes-per-100m AND mph
// all at once. Only the one src/lib/sports.ts's paceStyle actually calls for
// this sport belongs in the "everything else" grid.
const PACE_KEYS: StatKey[] = ['avg_pace', 'pace_100m', 'avg_speed'];
const paceKeyForSport: StatKey | null =
	meta.paceStyle === 'per_km' ? 'avg_pace' : meta.paceStyle === 'per_100m' ? 'pace_100m' : meta.paceStyle === 'speed' ? 'avg_speed' : null;
// isStatRelevant is the second gate, and it is about truth rather than tidiness:
// a stat like `water_temp` reads `avg_temp_c`, which on a bike is the air, so an
// "everything whose column is non-null" grid captions a real number with a false
// label. See FAMILY_ONLY_STATS in src/lib/sports.ts.
const secondaryKeys = ALL_STAT_KEYS.filter(
	(k) =>
		!primaryKeys.includes(k) &&
		(!PACE_KEYS.includes(k) || k === paceKeyForSport) &&
		// On a lift-served day the file's moving time is broken (see SNOW_PRIMARY);
		// the "Runs & lifts" breakdown reports time skiing and time on lifts, so
		// this stat stays out of the Details grid rather than resurfacing there.
		!(skiView && k === 'moving_time') &&
		isStatRelevant(activity.sport, k),
);
const secondaryStats = statsFor(secondaryKeys);

// ---------------------------------------------------------------------------
// Exertion — §3. See the header comment for why the sentence is recomputed
// and the score is not.
// ---------------------------------------------------------------------------
const EMPTY_THRESHOLDS: Thresholds = {
	ftp_w: null,
	lthr_bpm: null,
	max_hr: null,
	rest_hr: null,
	threshold_pace_s_per_km: null,
	css_pace_s_per_100m: null,
	weight_kg: null,
};

const METHOD_LABEL: Record<string, string> = {
	tss: 'power-based TSS',
	hrtss: 'HR-based TSS (Banister TRIMP)',
	avghr: 'flat average-HR TRIMP',
	ptss: 'pace-based TSS',
	met: 'MET-minutes',
	ski: 'active-descent MET',
};
const CONFIDENCE_LABEL: Record<string, string> = {
	measured: 'Measured',
	estimated: 'Estimated',
	assumed: 'Assumed',
};

// Takes `act` as a parameter rather than closing over the page-level
// `activity` purely for TypeScript's benefit: the 404 check above narrows
// `activity` to non-null in this scope, but that narrowing doesn't survive
// into a separately-declared function's body, so a plain closure would need
// `activity!` sprinkled everywhere it's touched.
function exertionDetail(act: ActivityRow): string | null {
	if (act.exertion == null || !act.exertion_method) return null;
	try {
		const exStreams: ExertionStreams | undefined = streams
			? {
					time_s: streams.time_s ?? undefined,
					power_w: streams.power_w ?? undefined,
					heartrate: streams.heartrate ?? undefined,
					altitude_m: streams.altitude_m ?? undefined,
					distance_m: streams.distance_m ?? undefined,
					moving: streams.moving ?? undefined,
				}
			: undefined;
		const result = computeExertion(
			{
				sport: act.sport,
				moving_seconds: act.moving_seconds,
				elapsed_seconds: act.elapsed_seconds,
				distance_m: act.distance_m,
				elevation_gain_m: act.elevation_gain_m,
				avg_hr: act.avg_hr,
				avg_power_w: act.avg_power_w,
				streams: exStreams,
			},
			thresholds ?? EMPTY_THRESHOLDS,
		);
		// Only trust the recomputed sentence when it took the same rung AND
		// landed close to the stored score. Method agreement alone isn't
		// enough — a threshold edited since ingest, say, would still take the
		// same rung but produce a sentence whose numbers (an NP, an FTP) don't
		// match the score sitting next to it, which is worse than no sentence.
		const scoreAgrees = Math.abs(result.score - act.exertion) <= Math.max(3, act.exertion * 0.15);
		if (result.method === act.exertion_method && scoreAgrees) return result.detail;
	} catch {
		// Recomputation is best-effort; the generic fallback below always works.
	}
	return null;
}

const durationLabel = formatDuration(activity.moving_seconds ?? activity.elapsed_seconds);
const detail =
	exertionDetail(activity) ??
	(activity.exertion != null && activity.exertion_method
		? `${durationLabel} of ${meta.label.toLowerCase()} — ${(CONFIDENCE_LABEL[activity.exertion_confidence ?? ''] ?? 'Assumed').toLowerCase()} via ${METHOD_LABEL[activity.exertion_method] ?? activity.exertion_method}.`
		: null);

// ---------------------------------------------------------------------------
// The interactive profile graph — elevation/HR/power/speed on one shared axis,
// each toggled, time-or-distance x, and a cursor that scrubs the map. All the
// arithmetic (and the downsample that keeps the payload small) lives in
// src/lib/activity-graph.ts; this page just hands it the streams. Null when
// there is nothing plottable, in which case the graph doesn't render at all.
// ---------------------------------------------------------------------------
// Ski days pass their resolved segments so the profile can band the sawtooth
// into runs and lifts; every other sport passes none and the graph omits them.
const graphData = buildGraphData(streams, laps, undefined, skiSegments.length ? skiSegments : null);

// ---------------------------------------------------------------------------
// Formatting helpers local to this page.
// ---------------------------------------------------------------------------
function formatDuration(seconds: number | null | undefined): string {
	if (seconds == null || !Number.isFinite(seconds) || seconds < 0) return '—';
	const s = Math.round(seconds);
	const h = Math.floor(s / 3600);
	const m = Math.floor((s % 3600) / 60);
	const ss = s % 60;
	if (h > 0) return `${h}h ${m}m`;
	if (m > 0) return `${m}m`;
	return `${ss}s`;
}

function formatDateLong(dateStr: string): string {
	const [y, m, d] = dateStr.split('-').map(Number);
	const dt = new Date(Date.UTC(y, (m ?? 1) - 1, d ?? 1));
	return dt.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
}

function legLabel(leg: number | null): string {
	if (leg == null) return '';
	return `Leg ${leg}`;
}

// The gear catalog: read whenever the activity has gear to name, and again
// for the editor's picker. Retired gear is kept in the list — an old ride was
// ridden on the bike that's since been retired, and that has to stay sayable.
const gear = activity.gear_id != null || isOwner ? await listGear() : [];
const activityGear = gear.find((g) => g.id === activity.gear_id) ?? null;
const gearLabel = (g: (typeof gear)[number]) => g.nickname || g.name;
const editing = isOwner && Astro.url.searchParams.has('edit');
const titleError = Astro.url.searchParams.get('error') === 'title';
// The film link is a virtual-ride idea (the trainer with a movie on), but a ride
// already linked keeps its editor even if the sport was later changed.
const showMovie = activity.sport === 'virtual_ride' || activity.movie_tmdb_id != null;

const pageTitle = `${activity.title} — Jason's activity log`;
const glyph = sportIcon(activity.sport);
const exInk = exertionInk(activity.exertion);
const exWord = exertionLabel(activity.exertion);
---

<ActivityLayout title={pageTitle}>
	<SiteHeader pathname={Astro.url.pathname} theme="activity" />
	<div class="page">
		<a class="back" href="/activities" data-back>&larr; Activities</a>

		{
			parent && (
				<a class="parent-banner" href={`/activities/${parent.id}`}>
					<span class="parent-banner__leg">{legLabel(activity.leg)}</span>
					of <strong>{parent.title}</strong> — back to the full day &rarr;
				</a>
			)
		}

		<header class="head">
			<div class="head__top">
				<svg
					class="head__icon"
					viewBox="0 0 24 24"
					fill="none"
					stroke={ALPINE.granite}
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d={glyph} />
				</svg>
				<span class="head__sport">{meta.label}</span>
				{isOwner && !editing && <span class="head__actions"><PinButton track="move" refId={activity.id} pinned={activityPinned} /></span>}
				{isOwner && !editing && !activity.private && <span class="head__public" title="Visible to everyone">Public</span>}
				{isOwner && !editing && <a class="head__fav-btn" href="?edit=1">Edit</a>}
			</div>

			{
				editing ? (
					/* The edit state: the same header, with its authored parts
					   opened up. Fields keep the size and weight they have when
					   read, so opening the editor moves nothing on the page. */
					<form method="POST" class="edit">
						<input type="hidden" name="action" value="save" />

						<label class="edit__field">
							<span class="edit__label">Title</span>
							<input class="edit__title" name="title" type="text" value={activity.title} required autofocus />
							{titleError && <span class="edit__error">An activity needs a title.</span>}
						</label>

						<div class="head__meta">
							<span>{formatDateLong(activity.local_date)}</span>
							{activity.start_place && <span class="head__dot">·</span>}
							{activity.start_place && <span>{activity.start_place}</span>}
						</div>

						<label class="edit__field">
							<span class="edit__label">Notes</span>
							<textarea class="edit__input edit__notes" name="notes" rows="4" placeholder="How it went.">{activity.notes ?? ''}</textarea>
						</label>

						{/* A disclosure, not a field: the box is folded away until opened,
						    and pre-opened only when a note already exists. `<details>` is
						    the native toggle — no script on this server-rendered form. The
						    note stays private even when the activity above is public. */}
						<details class="edit__private" open={Boolean(activity.private_notes)}>
							<summary class="edit__private-summary">
								<span aria-hidden="true">🔒</span> Private note
							</summary>
							<textarea
								class="edit__input edit__notes"
								name="private_notes"
								rows="3"
								placeholder="Just for you — never shown to anyone else."
							>{activity.private_notes ?? ''}</textarea>
						</details>

						<div class="edit__row">
							<label class="edit__field">
								<span class="edit__label">Sport</span>
								<select class="edit__input" name="sport">
									{SPORTS.map((slug) => (
										<option value={slug} selected={slug === activity.sport}>
											{sportMeta(slug).label}
										</option>
									))}
								</select>
							</label>

							<label class="edit__field">
								<span class="edit__label">Gear</span>
								<select class="edit__input" name="gear_id">
									<option value="">None</option>
									{gear.map((g) => (
										<option value={g.id} selected={g.id === activity.gear_id}>
											{gearLabel(g)}
											{g.retired_at ? ' (retired)' : ''}
										</option>
									))}
								</select>
							</label>
						</div>

						{showMovie && (
							/* The film watched during the ride. A search picker (below,
							   in the page's one script) fills the two hidden inputs from
							   /api/tmdb/search. With no script the hidden inputs still
							   carry the current link, so a save preserves it — only
							   changing the film needs the search. */
							<div class="edit__field" id="movie-pick">
								<span class="edit__label">🎬 Ride movie</span>
								<input type="hidden" name="movie_tmdb_id" value={activity.movie_tmdb_id ?? ''} />
								<input type="hidden" name="movie_title" value={activity.movie_title ?? ''} />
								<div class="movie-chosen" hidden={!activity.movie_tmdb_id}>
									<span class="movie-chosen__title">{activity.movie_title}</span>
									<button type="button" class="movie-chosen__clear" id="movie-clear">Remove</button>
								</div>
								<input
									class="edit__input"
									id="movie-search"
									type="text"
									autocomplete="off"
									placeholder="Search for the film…"
									hidden={Boolean(activity.movie_tmdb_id)}
								/>
								<ul class="movie-results" id="movie-results" hidden></ul>
							</div>
						)}

						<label class="edit__toggle">
							<input type="checkbox" name="private" value="public" checked={!activity.private} />
							<span>Public — anyone can see this activity, its route and its numbers</span>
						</label>

						<label class="edit__toggle">
							<input
								type="checkbox"
								name="hide_from_review"
								value="hide"
								checked={activity.hide_from_review}
