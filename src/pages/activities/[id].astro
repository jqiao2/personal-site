		{
			editingRuns ? (
				<SkiRunsEditor rows={skiEditRows} pathname={Astro.url.pathname} edited={skiEdited} />
			) : (
				<SkiRuns
					view={skiView}
					editHref={isOwner && isLiftServed && skiView ? `${Astro.url.pathname}?editruns=1` : null}
