											<path d={cGlyph} />
										</svg>
										<div class="leg__body">
											<div class="leg__title">{legLabel(c.leg)} — {cMeta.label}</div>
											<div class="leg__name">{c.title}</div>
										</div>
										<div class="leg__time figure">{formatDuration(c.moving_seconds ?? c.elapsed_seconds)}</div>
									</a>
								);
							})
						}
					</div>
				</section>
			)
		}
	</div>
</ActivityLayout>

{/* The only client JavaScript on this page. Everything else here is a plain
    GET/POST on purpose (see the note above the POST handler); a confirm is the
    one thing HTML has no element for. It's an enhancement rather than a gate —
    with JS off the delete still posts, and the server is what actually checks
    the owner cookie. */}
<script>
	document.getElementById('delete-activity')?.addEventListener('submit', (e) => {
		if (!window.confirm('Delete this activity? It stops appearing anywhere on the site.')) {
			e.preventDefault();
		}
	});

	// The ride-movie picker. A search box over /api/tmdb/search that writes the
	// chosen film's id and title into the two hidden inputs the form submits.
	// Progressive: with no JS the field still shows the linked film and its
	// Remove button (a plain form control), just without new-film search.
	const pick = document.getElementById('movie-pick');
	const idInput = pick?.querySelector<HTMLInputElement>('input[name="movie_tmdb_id"]');
	const titleInput = pick?.querySelector<HTMLInputElement>('input[name="movie_title"]');
	const chosen = pick?.querySelector<HTMLElement>('.movie-chosen');
	const chosenTitle = pick?.querySelector<HTMLElement>('.movie-chosen__title');
	const search = document.getElementById('movie-search') as HTMLInputElement | null;
	const results = document.getElementById('movie-results');
	if (pick && idInput && titleInput && chosen && chosenTitle && search && results) {
		const showChosen = (title: string) => {
			chosenTitle.textContent = title;
			chosen.hidden = false;
			search.hidden = true;
			results.hidden = true;
			results.replaceChildren();
		};
		const showSearch = () => {
			idInput.value = '';
			titleInput.value = '';
			chosen.hidden = true;
			search.hidden = false;
			search.value = '';
			search.focus();
		};

		document.getElementById('movie-clear')?.addEventListener('click', showSearch);

		let timer: ReturnType<typeof setTimeout>;
		search.addEventListener('input', () => {
			clearTimeout(timer);
			const q = search.value.trim();
			if (!q) {
				results.hidden = true;
				results.replaceChildren();
				return;
			}
			timer = setTimeout(async () => {
				try {
					const res = await fetch(`/api/tmdb/search?query=${encodeURIComponent(q)}`);
					if (!res.ok) return;
					const data = await res.json();
					const items = (data.results ?? []).slice(0, 8) as { id: number; title: string; release_date?: string }[];
					results.replaceChildren();
					for (const m of items) {
						const li = document.createElement('li');
						const btn = document.createElement('button');
						btn.type = 'button';
						btn.className = 'movie-results__item';
						const year = (m.release_date || '').slice(0, 4);
						const titleEl = document.createElement('span');
						titleEl.className = 'movie-results__title';
						titleEl.textContent = m.title;
						btn.appendChild(titleEl);
						if (year) {
							const yearEl = document.createElement('span');
							yearEl.className = 'movie-results__year';
							yearEl.textContent = year;
							btn.appendChild(yearEl);
						}
						btn.addEventListener('click', () => {
							idInput.value = String(m.id);
							titleInput.value = m.title;
							showChosen(year ? `${m.title} (${year})` : m.title);
						});
						li.appendChild(btn);
						results.appendChild(li);
					}
					results.hidden = items.length === 0;
				} catch {
					/* leave the box as-is on a failed search */
				}
			}, 300);
		});

		document.addEventListener('click', (e) => {
			if (e.target instanceof Node && !pick.contains(e.target)) results.hidden = true;
		});
	}
</script>

