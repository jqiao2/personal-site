							    carries a hidden action=save that a second value can't
							    override (formData.get returns the first). The `form`
							    attribute is how HTML lets the button sit here anyway. */}
							<button type="submit" form="delete-activity" class="edit__delete">Delete</button>
						</div>
					</form>

					<form method="POST" id="delete-activity" hidden>
						<input type="hidden" name="action" value="delete" />
					</form>
				) : (
					<>
						<h1 class="head__title">{activity.title}</h1>
						<div class="head__meta">
							<span>{formatDateLong(activity.local_date)}</span>
