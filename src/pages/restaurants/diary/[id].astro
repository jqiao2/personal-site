---
// One visit.
//
// The three rating signals get their hierarchy here, in the sidecar, and this
// is the only screen where all three are shown at full size: stars first and
// largest, the verdict under them, and the heart and
// the revisit mark as two small stamps at the bottom. On a tile only the stars
// survive; on a map pin only the verdict does; the heart never leaves the entry
// except as a ♥ beside a name. That ordering is the whole answer to "three
// overlapping opinions" — they are ranked by how far they travel.
import RestaurantLayout from '../../../layouts/RestaurantLayout.astro';
import MealEditor from '../../../components/MealEditor.astro';
import PhotoWall from '../../../components/PhotoWall.astro';
import VerdictMark from '../../../components/VerdictMark.astro';
import { requireOwner } from '../../../lib/auth';
import { getVisit, listFriends, listTags } from '../../../lib/restaurants';
import { layoutPhotos, longDate, placeLine } from '../../../lib/restaurant-view';
import { verdictAt } from '../../../lib/verdict';
import { starText } from '../../../lib/format';
import PinButton from '../../../components/PinButton.astro';
import { isPinned } from '../../../lib/pins';
import { activitiesForMeal, activitiesNear, shortDay, withLinked } from '../../../lib/activity-meals';

export const prerender = false;

const id = Number(Astro.params.id);

if (!Number.isInteger(id) || id <= 0) return Astro.redirect('/restaurants/diary');

// Owner first: it decides whether getVisit fetches the private note off the base
// table at all, so a visitor's `visit` never carries the text.
const isOwner = await requireOwner(Astro.cookies);

const visit = await getVisit(id, isOwner);

if (!visit) return new Response('Not found', { status: 404 });

const [tagOptions, friendOptions] = isOwner ? await Promise.all([listTags(), listFriends()]) : [[], []];

const pinned = isOwner ? await isPinned('meal', visit.id) : false;

const linkedActivities = await activitiesForMeal(visit.id, isOwner);

const activityOptions = isOwner ? withLinked(linkedActivities, await activitiesNear(visit.visited_on)) : [];

const linkedActivityIds = new Set(linkedActivities.map((a) => a.id));

const verdict = verdictAt(visit.verdict);

const stars = starText(visit.rating);

const photos = layoutPhotos(visit.photos);

const paragraphs = (visit.review ?? '').split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
---

<RestaurantLayout
	title={`${visit.restaurant_name}, ${visit.visited_on} · Jason's restaurant log`}
	pathname="/restaurants"
>
	<div class="rl-page rl-page--flush">
		<div class="rl-topbar">
			<a class="rl-back" href="/restaurants/diary">&larr; Jason&rsquo;s restaurant log</a>
			<span class="rl-tag">Diary</span>
		</div>

		<div class="rl-split entry">
			<div class="rl-main entry__main">
				<header class="entry__head">
					<div class="entry__date">{longDate(visit.visited_on).toUpperCase()}</div>
					<a class="entry__name" href={`/restaurants/place/${visit.restaurant_id}`}>
						{visit.restaurant_name}
					</a>
					{/* No price band. It is the restaurant's, not this meal's — the
					    place page states it, and repeating it over every visit made
					    a property of the place look like a bill. */}
					<div class="entry__facts">
						{visit.cuisines.length > 0 && <span>{visit.cuisines.join(', ')}</span>}
						{visit.cuisines.length > 0 && <span class="dot">·</span>}
						<span>{placeLine(visit)}</span>
						{
							isOwner && visit.friends.length > 0 && (
								<span class="entry__with">
									with{' '}
									{visit.friends.map((f, i) => (
										<>
											{i > 0 && ', '}
											<a class="entry__with-name" href={`/restaurants/places?friend=${encodeURIComponent(f)}`}>
												{f}
											</a>
										</>
									))}
								</span>
							)
						}
					</div>
					{
						linkedActivities.length > 0 && (
							<div class="entry__moves">
								{linkedActivities.map((a) => (
									<a class="entry__move" href={`/activities/${a.id}`}>
										{a.sportLabel}: {a.title}
										{a.distance && <span class="entry__move-dist">{a.distance}</span>}
									</a>
								))}
							</div>
						)
					}
				</header>

				{photos.length > 0 && <PhotoWall photos={photos} height={230} />}

				{
					paragraphs.length > 0 && (
						<div class="entry__review">
							{paragraphs.map((p) => (
								<p class="rl-prose">{p}</p>
							))}
						</div>
					)
				}

				{
					visit.private_note && (
						<div class="entry__private">
							<div class="entry__private-label">
								<span aria-hidden="true">🔒</span>Private note
							</div>
							<p class="rl-prose">{visit.private_note}</p>
						</div>
					)
				}

				{
					visit.tags.length > 0 && (
						<div class="entry__tags">
							{visit.tags.map((t) => (
								<span class="entry__tag">{t}</span>
							))}
						</div>
					)
				}
			</div>

			<aside class="rl-side">
				<div class="rl-box entry__card">
					<div class="rl-label">How was it</div>
					{
						stars ? (
							<div class="entry__stars">
								<span class="entry__starglyphs">{stars}</span>
								<span class="entry__starnum">{visit.rating}</span>
							</div>
						) : (
							<p class="entry__unrated">Not rated. Not every meal gets a number.</p>
						)
					}

					<div class="rl-label entry__label2">Would I go back</div>
					<div class="entry__verdict">
						<VerdictMark verdict={visit.verdict} size={34} />
						<div class="entry__verdict-name">{verdict?.label ?? 'Not recorded'}</div>
					</div>

					<div class="entry__stamps">
						<span class:list={['stamp', visit.hearted && 'stamp--heart']}>
							♥ {visit.hearted ? 'Loved' : 'Not loved'}
						</span>
						<span class:list={['stamp', visit.revisit && 'stamp--on']}>
							↻ {visit.revisit ? 'Been before' : 'First time'}
						</span>
					</div>
				</div>

				{
					isOwner && (
						<div class="rl-box rl-box--panel rl-box__pad owner">
							<div class="rl-label">Owner</div>
							<button type="button" class="owner__link" data-open-meal-editor="edit">
								Edit this entry
							</button>
							<label class="owner__link" data-add-photos={visit.id}>
								<span data-add-photos-text>Add photos</span>
								<input type="file" accept="image/*" multiple hidden />
							</label>
							<PinButton track="meal" refId={visit.id} pinned={pinned} />
							{activityOptions.length > 0 && (
								<form class="links" method="POST" action={`/api/restaurants/visits/${visit.id}/activities`}>
									<div class="rl-label">Activities</div>
									{activityOptions.map((a) => (
										<label class="links__row">
											<input type="checkbox" name="activity_id" value={a.id} checked={linkedActivityIds.has(a.id)} />
											<span>
												{a.title} · {shortDay(a.local_date)}
											</span>
										</label>
									))}
									<button type="submit" class="owner__link">Save links</button>
								</form>
							)}
						</div>
					)
				}
			</aside>
		</div>
	</div>

	{
		isOwner && (
			<MealEditor
				redirect={`/restaurants/diary/${visit.id}`}
				deleteRedirect="/restaurants/diary"
				visitId={visit.id}
				place={{
					id: visit.restaurant_id,
					name: visit.restaurant_name,
					meta: `${visit.cuisines[0] ?? ''}${visit.cuisines[0] ? ' · ' : ''}${placeLine(visit)}`,
					visits: 1,
				}}
				initial={{
					visitedOn: visit.visited_on,
					rating: visit.rating,
					verdict: visit.verdict,
					hearted: visit.hearted,
					revisit: visit.revisit,
					friends: visit.friends,
					review: visit.review ?? '',
					privateNote: visit.private_note ?? '',
					tags: visit.tags,
				}}
				photos={visit.photos.map((p) => ({ id: p.id, url: p.url }))}
				tagOptions={tagOptions}
				friendOptions={friendOptions}
			/>
		)
	}
</RestaurantLayout>

<script>
	import { preparePhoto } from '../../../lib/photo';

	// Straight to the photos endpoint, skipping the editor: one photograph per
	// request, shrunk first, for the same 4.5 MB body cap the editor works under.
	const label = document.querySelector<HTMLLabelElement>('[data-add-photos]');
	const input = label?.querySelector('input');
	const text = label?.querySelector('[data-add-photos-text]');

	input?.addEventListener('change', async () => {
		const files = Array.from(input.files ?? []);

		if (files.length === 0 || !label || !text) return;
		const url = `/api/restaurants/visits/${label.dataset.addPhotos}/photos`;
		const failures: string[] = [];

		input.disabled = true;

		for (const [i, file] of files.entries()) {
			text.textContent = `Uploading ${i + 1} of ${files.length}…`;
			const p = await preparePhoto(file);
			URL.revokeObjectURL(p.url);
			const form = new FormData();
			form.append('photo', p.file, p.file.name);
			form.append('width', String(p.width));
			form.append('height', String(p.height));
			form.append('caption', '');

			try {
				const res = await fetch(url, { method: 'POST', body: form });

				if (!res.ok) failures.push(`${file.name} (${res.status === 413 ? 'too large' : `HTTP ${res.status}`})`);
			} catch {
				failures.push(file.name);
			}
		}

		if (failures.length > 0) window.alert(`Did not upload: ${failures.join(', ')}.`);
		location.reload();
	});
</script>

<style>
	.entry {
		margin-top: 26px;
	}
	.entry__main {
		flex: 999 1 440px;
		min-width: min(100%, 440px);
		gap: 24px;
	}
	.entry__head {
		border-bottom: 2px solid var(--ink);
		padding-bottom: 13px;
	}
	.entry__date {
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 1.2px;
		color: var(--ink-3);
	}
	.entry__name {
		display: block;
		margin-top: 8px;
		font-family: var(--display);
		font-size: clamp(28px, 5.5vw, 40px);
		line-height: 1.04;
		color: var(--ink);
	}
	.entry__name:hover {
		color: var(--terracotta);
	}
	.entry__facts {
		margin-top: 9px;
		display: flex;
		align-items: baseline;
		gap: 11px;
		flex-wrap: wrap;
		font-size: 13px;
		color: var(--ink-2);
	}
	.dot {
		color: var(--rule);
	}
	.entry__with {
		margin-left: auto;
		font-size: 12px;
		color: var(--ink-3);
	}
	.entry__with-name {
		color: var(--ink-2);
		text-decoration: underline;
		text-decoration-color: var(--rule);
		text-underline-offset: 2px;
	}
	.entry__with-name:hover {
		color: var(--terracotta);
		text-decoration-color: currentColor;
	}

	.entry__review {
		max-width: 660px;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.entry__review p {
		margin: 0;
	}
	.entry__review p + p {
		color: var(--ink-soft);
	}

	.entry__private {
		max-width: 660px;
		margin-top: 20px;
		padding: 12px 15px;
		border: 1px dashed var(--dashed);
		border-radius: 8px;
	}
	.entry__private-label {
		display: flex;
		align-items: center;
		gap: 7px;
		font-size: 10.5px;
		font-weight: 700;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		color: var(--ink-3);
		margin-bottom: 8px;
	}
	.entry__private .rl-prose {
		margin: 0;
		color: var(--ink-soft);
		white-space: pre-wrap;
	}

	.entry__tags {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}
	.entry__tag {
		border: 1px solid var(--rule);
		background: var(--card);
		font-size: 12px;
		color: var(--ink-2);
		padding: 4px 10px;
	}

	.entry__card {
		padding: 16px 18px;
	}
	.entry__stars {
		margin-top: 10px;
		display: flex;
		align-items: center;
		gap: 10px;
		padding-bottom: 14px;
		border-bottom: 1px solid var(--rule-2);
	}
	.entry__starglyphs {
		font-size: 24px;
		letter-spacing: 2px;
		color: var(--marigold);
		line-height: 1;
	}
	.entry__starnum {
		font-family: var(--mono);
		font-size: 12.5px;
		color: var(--ink-2);
	}
	.entry__unrated {
		margin: 10px 0 14px;
		padding-bottom: 14px;
		border-bottom: 1px solid var(--rule-2);
		font-family: var(--prose);
		font-style: italic;
		font-size: 14px;
		color: var(--ink-3);
	}
	.entry__label2 {
		display: block;
		margin-top: 14px;
	}
	.entry__verdict {
		margin-top: 9px;
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.entry__verdict-name {
		font-size: 14px;
		font-weight: 600;
	}
	.entry__stamps {
		margin-top: 16px;
		padding-top: 14px;
		border-top: 1px solid var(--rule-2);
		display: flex;
		gap: 8px;
	}
	.stamp {
		flex: 1;
		background: var(--panel);
		border: 1px solid var(--rule);
		color: var(--ink-4);
		font-size: 12px;
		padding: 7px 0;
		text-align: center;
	}
	.stamp--on {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--ground);
	}
	.stamp--heart {
		background: var(--terracotta);
		border-color: var(--terracotta);
		color: var(--card);
	}

	.owner {
		margin-top: 14px;
	}
	/* Pin dressed like the paper .rl-btn outline, set off from the Edit link. */
	.owner :global(.pin) {
		display: block;
		margin-top: 11px;
		--pin-font-family: var(--ui);
		--pin-font-size: 12.5px;
		--pin-pad: 7px 13px;
		--pin-radius: 0;
		--pin-fg: var(--ink-2);
		--pin-border: var(--rule);
		--pin-accent: var(--terracotta);
		--pin-accent-bg: #f6e7d4;
	}
	.entry__moves {
		margin-top: 9px;
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
		font-size: 13px;
	}
	.entry__move {
		color: var(--ink-2);
		text-decoration: underline;
		text-decoration-color: var(--rule);
		text-underline-offset: 2px;
	}
	.entry__move:hover {
		color: var(--terracotta);
		text-decoration-color: currentColor;
	}
	.entry__move-dist {
		margin-left: 6px;
		font-family: var(--mono);
		font-size: 12px;
		color: var(--ink-3);
	}
	.links {
		margin-top: 14px;
		padding-top: 12px;
		border-top: 1px solid var(--rule-2);
	}
	.links__row {
		display: flex;
		align-items: baseline;
		gap: 7px;
		margin-top: 7px;
		font-size: 12.5px;
		color: var(--ink-2);
	}
	.owner__link {
		display: block;
		margin-top: 9px;
		border: none;
		background: none;
		padding: 0;
		font-size: 12.5px;
		color: var(--terracotta-deep);
		cursor: pointer;
		text-align: left;
	}
</style>
