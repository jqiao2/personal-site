---
// The month in eating — a shareable card, at the same 1080px artboard and the
// same three aspects as the film and book cards.
//
// THE PROBLEM THIS CARD HAS THAT THE OTHERS DON'T. A good month of films is
// thirty posters and a good month of reading is a shelf; a good month of eating
// is EIGHT MEALS. Filling the artboard with a 31-cell calendar that has eight
// marks in it is mostly empty grid, and the film card's poster wall has no
// equivalent — nobody drew a poster for dinner.
//
// But this card has something the other two don't: my own photographs, and one
// of them per meal. So the photographs ARE the grid. Each cell is the plate I
// ate that day, and the calendar stops being a scaffold with marks on it and
// becomes the thing worth looking at — a month of eating, in the order it
// happened, at the size the month actually was. The verdict needles stay on top
// of the photographs, so the strip still says how the month went as well as when.
//
// A MONTH WITH NO PHOTOGRAPHS still has to work, and it is a normal month. Then
// the same grid draws itself as ruled paper with the needles on it, which is the
// calendar this card had before the photographs went in — no empty state, no
// second layout.
import RestaurantLayout from '../../../layouts/RestaurantLayout.astro';
import VerdictMark from '../../../components/VerdictMark.astro';
import { requireOwner } from '../../../lib/auth';
import { listMonthKeys, listMonthVisits, placesForMonth } from '../../../lib/restaurants';
import { monthCalendar, monthFigures } from '../../../lib/restaurant-view';
import { staticMapUrl } from '../../../lib/map-style';
import {
	ASPECTS,
	aspectBySlug,
	monthLabel,
	monthQuery,
	parseMonthKey,
	shiftMonth,
	WEEKDAYS,
} from '../../../lib/share-card';

export const prerender = false;

const key = Astro.params.month ?? '';
if (!parseMonthKey(key)) return Astro.redirect('/restaurants/month');

const [visits, allKeys, isOwner] = await Promise.all([
	listMonthVisits(key),
	listMonthKeys(),
	requireOwner(Astro.cookies),
]);

const aspect = aspectBySlug(Astro.url.searchParams.get('fmt'));

// Two things the visits themselves can't answer: whether a place was new — only
// the whole diary knows that — and where it is, for the meals with no
// photograph. One round trip for both.
const places = await placesForMonth(
	visits.map((v) => v.restaurant_id),
	key,
);
const mapKey = import.meta.env.PUBLIC_MAPTILER_KEY ?? '';
const maps = new Map(
	[...places].flatMap(([id, place]) => {
		const url = staticMapUrl(place, mapKey);
		return url ? ([[id, url]] as [number, string][]) : [];
	}),
);

const cells = monthCalendar(key, visits, { maps });
const rows = Math.max(1, cells.length / 7);
const usesMaps = cells.some((c) => c.covers.some((cover) => cover.kind === 'map'));

const newIds = new Set([...places].filter(([, p]) => p.isNew).map(([id]) => id));
const figures = monthFigures(visits, newIds);

const prev = shiftMonth(key, -1);
const next = shiftMonth(key, 1);
const has = (k: string) => allKeys.includes(k);
const query = monthQuery(aspect);

const placesThisMonth = new Set(visits.map((v) => v.restaurant_id)).size;
const boroughs = new Set(visits.map((v) => v.city)).size;
const summary = visits.length
	? `${visits.length} meal${visits.length === 1 ? '' : 's'}, ${placesThisMonth} place${
			placesThisMonth === 1 ? '' : 's'
		}, ${boroughs} cit${boroughs === 1 ? 'y' : 'ies'}.`
	: 'Nothing logged this month.';
---

<RestaurantLayout
	title={`${monthLabel(key)} · Jason's restaurant log`}
	pathname="/restaurants"
	isOwner={isOwner}
>
	<div class="rl-page">
		<div class="rl-head">
			<div>
				<a class="rl-back" href="/restaurants">&larr; Jason&rsquo;s restaurant log</a>
				<div class="rl-head__title">Month in review</div>
			</div>
			<div class="controls">
				<span class="rl-label">Export</span>
				{
					ASPECTS.map((a) => (
						<a
							class:list={['fmt', a.slug === aspect.slug && 'fmt--on']}
							href={`/restaurants/month/${key}${monthQuery(a)}`}
						>
							{a.id}
						</a>
					))
				}
				<button type="button" class="rl-btn" data-save-card>Save image</button>
			</div>
		</div>

		<!-- Stepping to another month is a navigation, but the card is one place, so
		     the steps replace the history entry rather than stacking one per month
		     (data-rl-replace; the layout does the work). Otherwise Back walks you
		     through every month you looked at instead of leaving for the page that
		     sent you here. The film log's month card behaves the same way. -->
		<nav class="stepper">
			{
				has(prev) ? (
					<a class="stepper__go" href={`/restaurants/month/${prev}${query}`} data-rl-replace>
						&larr; {monthLabel(prev)}
					</a>
				) : (
					<span class="stepper__go stepper__go--off">&larr;</span>
				)
			}
			<a class="stepper__all" href="/restaurants/month">All months</a>
			{
				has(next) ? (
					<a class="stepper__go" href={`/restaurants/month/${next}${query}`} data-rl-replace>
						{monthLabel(next)} &rarr;
					</a>
				) : (
					<span class="stepper__go stepper__go--off">&rarr;</span>
				)
			}
		</nav>

		<div class="stage">
			<div class="viewport" data-viewport style={`--h:${aspect.height}px`}>
				<div class="scaler">
					<div class="card" data-card style={`--h:${aspect.height}px; --rows:${rows}`}>
						<div class="card__head">
							<div>
								<div class="card__kicker">The month in eating</div>
								<div class="card__month">{monthLabel(key)}</div>
							</div>
							<div class="card__count">
								<div class="card__countn">{visits.length}</div>
								<div class="card__countl">{visits.length === 1 ? 'meal out' : 'meals out'}</div>
							</div>
						</div>

						{/* THE PHOTOGRAPHS HERE ARE DELIBERATELY NOT PUT THROUGH THE IMAGE
						    OPTIMISER, unlike every other photograph on the site — see
						    src/lib/photo-src.ts. This card is an artboard, not a page: it
						    is 1080px wide whatever the screen is, and `toPng` below redraws
						    it at that size to be saved as a file. It also passes
						    `cacheBust`, which appends a query parameter to every image URL
						    it fetches — harmless on a storage URL, unverified against an
						    optimiser endpoint that parses its own query string. Getting
						    that wrong breaks the export, and the export is the whole point
						    of the page.

						    A DAY WITH TWO MEALS IN IT stacks: the better-ranked cover sits
						    on top and the one under it is turned a few degrees so its
						    corner shows, which is how a pile of prints looks and is the
						    only honest way to fit two meals in one square.

						    The maps are drawn in grey by a stock style — see staticMapUrl
						    — and warmed into the palette by a filter here, where the
						    filter is on the cell rather than the image so the pin over it
						    keeps the terracotta it was given. */}
						<div class="strip">
							<div class="strip__days">
								{WEEKDAYS.map((d) => <span>{d}</span>)}
							</div>
							<div class="strip__grid">
								{
									cells.map((c) => (
										<div
											class:list={[
												'cell',
												c.day == null && 'cell--pad',
												c.verdict != null && 'cell--hit',
												c.covers.length > 0 && 'cell--plated',
												c.covers.length > 1 && 'cell--stack',
											]}
										>
											{c.covers.map((cover, i) => (
												<span
													class:list={['plate', `plate--${cover.kind}`, i > 0 && 'plate--under']}
													style={`--i:${i}`}
												>
													<img src={cover.url} alt="" crossorigin="anonymous" data-cover />
													{cover.kind === 'map' && <span class="plate__pin" />}
												</span>
											))}
											{c.day != null && <span class="cell__n">{c.day}</span>}
											{c.verdict != null && (
												<span class="cell__mark">
													<VerdictMark verdict={c.verdict} size={16} ring={false} />
												</span>
											)}
										</div>
									))
								}
							</div>
						</div>

						<div class="figures">
							{
								figures.map((f) => (
									<div class="figure">
										<div class="figure__v">{f.value}</div>
										<div class="figure__l">{f.label}</div>
									</div>
								))
							}
						</div>

						<div class="card__foot">
							<span class="card__summary">{summary}</span>
							<span class="card__stamp">
								<span class="card__url">jasonqiao.com/restaurants</span>
								{/* The watermark is suppressed inside the map images, where it
								    would be 6px type in the corner of a calendar cell, so the
								    credit is printed once here — which is the condition of
								    suppressing it. */}
								{usesMaps && <span class="card__credit">Maps © MapTiler © OpenStreetMap</span>}
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</RestaurantLayout>

<script>
	import { toPng } from 'html-to-image';

	const button = document.querySelector<HTMLButtonElement>('[data-save-card]');
	const card = document.querySelector<HTMLElement>('[data-card]');
	const viewport = document.querySelector<HTMLElement>('[data-viewport]');

	// ---- fit the 1080px artboard to whatever room the column has ----
	// The card is drawn at its real size and shrunk by a transform on the wrapper,
	// so the export keeps its 1080 whatever the screen is. The scale is worked out
	// here rather than in CSS because a length divided by a length is not a number
	// as far as `scale()` is concerned — the arithmetic this replaced was invalid,
	// which dropped the transform and left phones showing the artboard at full
	// size. Capped at 0.62 so the card doesn't outgrow the controls above it, and
	// floored so it stays a picture on a phone. Same fit as the film card's.
	const stage = viewport?.parentElement;
	function fit(): void {
		if (!viewport) return;
		const width = stage?.clientWidth ?? 1080;
		viewport.style.setProperty('--s', String(Math.max(0.2, Math.min(0.62, width / 1080))));
	}
	if (viewport) {
		if (stage && 'ResizeObserver' in window) new ResizeObserver(fit).observe(stage);
		else window.addEventListener('resize', fit);
		fit();
	}

	// A cover that never arrives — a tile server having a bad day, a photo whose
	// object has gone — leaves the cell as the ruled paper it would have been,
	// rather than as a broken image with a day number on it.
	for (const img of document.querySelectorAll<HTMLImageElement>('img[data-cover]')) {
		const drop = () => {
			const cell = img.closest('.cell');
			img.closest('.plate')?.remove();
			if (cell && !cell.querySelector('.plate')) cell.classList.remove('cell--plated', 'cell--stack');
		};
		if (img.complete && img.naturalWidth === 0) drop();
		else img.addEventListener('error', drop);
	}

	button?.addEventListener('click', async () => {
		if (!card) return;
		const label = button.textContent;
		button.disabled = true;
		button.textContent = 'Drawing…';
		try {
			// Drawn at the artboard's own size rather than the scaled-down preview,
			// so the export is 1080 wide whatever the screen is.
			const url = await toPng(card, {
				pixelRatio: 1,
				width: card.offsetWidth,
				height: card.offsetHeight,
				// The card sits inside a scaled wrapper; the clone must not inherit it.
				style: { transform: 'none' },
				cacheBust: true,
			});
			const a = document.createElement('a');
			a.href = url;
			a.download = `${document.title.split(' ·')[0].replace(/\s+/g, '-').toLowerCase()}-eating.png`;
			a.click();
		} catch {
			window.alert('Could not draw the card.');
		} finally {
			button.disabled = false;
			button.textContent = label;
		}
	});
</script>

<style>
	.controls {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}
	.fmt {
		background: var(--card);
		border: 1px solid var(--dashed);
		font-family: var(--mono);
		font-size: 11.5px;
		padding: 5px 10px;
		color: var(--ink-2);
	}
	.fmt--on {
		background: var(--ink);
		color: var(--ground);
		border-color: var(--ink);
	}
	.fmt--on:hover {
		color: var(--ground);
	}

	.stepper {
		margin-top: 14px;
		display: flex;
		align-items: center;
		gap: 16px;
		font-size: 12.5px;
	}
	.stepper__all {
		margin-left: auto;
		color: var(--ink-3);
	}
	.stepper__go--off {
		color: var(--rule);
	}

	/* ---- the artboard ----
	   .viewport reserves the scaled-down footprint; .scaler shrinks the 1080px
	   card into it. The card keeps its real size so the export renders at 1080
	   regardless of the screen. --s is set by the script above. */
	.stage {
		margin-top: 20px;
		display: flex;
		justify-content: center;
	}
	.viewport {
		position: relative;
		width: calc(1080px * var(--s, 0.5));
		height: calc(var(--h) * var(--s, 0.5));
	}
	.scaler {
		transform: scale(var(--s, 0.5));
		transform-origin: 0 0;
		width: 1080px;
	}
	.card {
		width: 1080px;
		height: var(--h);
		background: var(--card);
		border: 1px solid var(--rule);
		padding: 56px 56px 48px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.card__head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		border-bottom: 3px solid var(--ink);
		padding-bottom: 18px;
	}
	.card__kicker {
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 2.6px;
		text-transform: uppercase;
		color: var(--terracotta);
	}
	.card__month {
		margin-top: 10px;
		font-family: var(--display);
		font-size: 66px;
		line-height: 0.98;
		letter-spacing: -1px;
	}
	.card__count {
		text-align: right;
	}
	.card__countn {
		font-family: var(--display);
		font-size: 52px;
		line-height: 1;
	}
	.card__countl {
		font-size: 13px;
		letter-spacing: 1.8px;
		text-transform: uppercase;
		color: var(--ink-3);
	}

	/* The calendar takes everything the head, the figures and the foot don't.
	   Rows share that height evenly, so one grid fits all three aspects without a
	   second set of numbers — but a cell is capped at 190px so the story artboard,
	   which has 500px more than it needs, doesn't crop every photograph into a
	   column. Past the cap the grid centres itself in what's left. */
	.strip {
		margin-top: 26px;
		flex: 1 1 auto;
		min-height: 0;
		display: flex;
		flex-direction: column;
		/* Once the cells hit their cap the leftover height is shared out here, so
		   the weekday letters travel with the grid instead of being stranded
		   under the rule. */
		justify-content: center;
	}
	.strip__days {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 8px;
		font-size: 11px;
		letter-spacing: 1.6px;
		color: var(--ink-4);
		text-transform: uppercase;
		padding-bottom: 6px;
	}
	.strip__grid {
		flex: 1 1 auto;
		min-height: 0;
		max-height: calc(var(--rows) * 190px + (var(--rows) - 1) * 8px);
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		grid-auto-rows: 1fr;
		gap: 8px;
	}
	.cell {
		position: relative;
		background: #faf3e2;
		border: 1px solid var(--rule-4);
	}
	.cell--pad {
		background: none;
		border-color: transparent;
	}
	.cell--hit {
		background: var(--sunk);
		border-color: var(--rule);
	}
	.cell--plated {
		border-color: transparent;
		box-shadow: inset 0 0 0 1px rgba(47, 30, 18, 0.18);
		z-index: 1;
	}
	/* A stacked cell's under-plate spills past its own square, so it paints over
	   its neighbours rather than under whichever of them comes later in source
	   order. Both of these also make the cell a stacking context, which is what
	   keeps the plate layering below a matter of the cell it's in. */
	.cell--stack {
		z-index: 2;
	}

	.plate {
		position: absolute;
		inset: 0;
		display: block;
		overflow: hidden;
		/* Best-ranked meal on top; the rest fall back a layer each. */
		z-index: calc(10 - var(--i));
	}
	.plate img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.plate--under {
		transform: rotate(calc(var(--i) * 3.5deg));
		box-shadow: 0 1px 6px rgba(47, 30, 18, 0.35);
	}
	/* The stock style is grey; this is what puts it on the same paper as the
	   rest of the card. Sepia does the warming, the rest keeps it from going
	   muddy — and it lands close to --land, which the live map is drawn on. */
	.plate--map img {
		filter: sepia(0.5) saturate(1.15) brightness(1.04) contrast(0.96);
	}
	.plate__pin {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 9px;
		height: 9px;
		margin: -4.5px 0 0 -4.5px;
		border-radius: 50%;
		background: var(--terracotta);
		box-shadow: 0 0 0 2px var(--card);
	}

	.cell__n {
		position: absolute;
		left: 6px;
		top: 4px;
		z-index: 20;
		font-family: var(--mono);
		font-size: 12px;
		color: #bda98a;
	}
	.cell--hit .cell__n {
		color: var(--ink);
	}
	/* On a photograph the numeral and the needle need their own ground — a plate
	   can be any colour at all, and both of these are small. */
	.cell--plated .cell__n {
		left: 0;
		top: 0;
		padding: 3px 6px;
		background: var(--card);
		color: var(--ink);
	}
	.cell__mark {
		position: absolute;
		right: 5px;
		bottom: 4px;
		z-index: 20;
	}
	.cell--plated .cell__mark {
		right: 0;
		bottom: 0;
		padding: 4px 5px 3px;
		background: var(--card);
	}

	.figures {
		margin-top: 30px;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
	}
	.figure {
		padding: 20px 22px;
		border-left: 1px solid var(--rule-4);
	}
	.figure:first-child {
		border-left: none;
		padding-left: 0;
	}
	.figure__v {
		font-family: var(--display);
		font-size: 38px;
		line-height: 1;
	}
	.figure__l {
		margin-top: 8px;
		font-size: 12px;
		letter-spacing: 1.6px;
		text-transform: uppercase;
		color: var(--ink-3);
	}

	.card__foot {
		padding-top: 24px;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 16px;
	}
	.card__summary {
		font-family: var(--prose);
		font-style: italic;
		font-size: 19px;
		color: var(--ink-2);
	}
	.card__stamp {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 4px;
		text-align: right;
	}
	.card__url {
		font-size: 12px;
		letter-spacing: 1.8px;
		text-transform: uppercase;
		color: var(--ink-4);
	}
	.card__credit {
		font-size: 9.5px;
		letter-spacing: 0.9px;
		text-transform: uppercase;
		color: var(--rule);
	}
</style>
