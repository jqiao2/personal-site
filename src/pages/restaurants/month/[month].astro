---
// The month in eating — a shareable card, at the same 1080px artboard and the
// same three aspects as the film and book cards.
//
// THE PROBLEM THIS CARD HAS THAT THE OTHERS DON'T. A good month of films is
// thirty posters and a good month of reading is a shelf; a good month of eating
// is EIGHT MEALS. Filling the artboard with a 31-cell calendar that has eight
// marks in it is mostly empty grid, and the film card's poster wall has no
// equivalent — nobody drew a poster for dinner.
//
// But this card has something the other two don't: my own photographs, and one
// of them per meal. So the photographs ARE the grid. Each cell is the plate I
// ate that day, and the calendar stops being a scaffold with marks on it and
// becomes the thing worth looking at — a month of eating, in the order it
// happened, at the size the month actually was. The verdict needles stay on top
// of the photographs, so the strip still says how the month went as well as when.
//
// A MONTH WITH NO PHOTOGRAPHS still has to work, and it is a normal month. Then
// the same grid draws itself as ruled paper with the needles on it, which is the
// calendar this card had before the photographs went in — no empty state, no
// second layout.
import RestaurantLayout from '../../../layouts/RestaurantLayout.astro';
import VerdictMark from '../../../components/VerdictMark.astro';
import { requireOwner } from '../../../lib/auth';
import { photoSrc } from '../../../lib/photo-src';
import { listMonthKeys, listMonthVisits, placesForMonth } from '../../../lib/restaurants';
import { monthCalendar, monthFigures } from '../../../lib/restaurant-view';
import type { MapPoint } from '../../../lib/restaurant-view';
import {
	ASPECTS,
	aspectBySlug,
	monthLabel,
	monthQuery,
	parseMonthKey,
	shiftMonth,
	WEEKDAYS,
} from '../../../lib/share-card';

export const prerender = false;

// OWNER ONLY. A month in review is a dense summary of one person's month —
// what they read/watched/ate/did, on which days, from which places. It is the
// most concentrated disclosure any of these sections makes, and it is one
// page rather than a hundred, so it gates as a whole rather than per entry.
if (!(await requireOwner(Astro.cookies))) {
	return Astro.redirect(`/films/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

const key = Astro.params.month ?? '';
if (!parseMonthKey(key)) return Astro.redirect('/restaurants/month');

const [visits, allKeys] = await Promise.all([listMonthVisits(key), listMonthKeys()]);
// The gate above already established this.
const isOwner = true;

const aspect = aspectBySlug(Astro.url.searchParams.get('fmt'));

// Two things the visits themselves can't answer: whether a place was new — only
// the whole diary knows that — and where it is, for the meals with no
// photograph. One round trip for both.
const places = await placesForMonth(
	visits.map((v) => v.restaurant_id),
	key,
);
// Only places that were actually pinned, and only if there is a key to draw
// them with — otherwise there is no map to be had and the cell keeps its paper.
const mapKey = import.meta.env.PUBLIC_MAPTILER_KEY ?? '';
const maps = new Map(
	mapKey
		? [...places].flatMap(([id, p]) =>
				p.lat != null && p.lng != null ? [[id, { lat: p.lat, lng: p.lng } as MapPoint] as const] : [],
			)
		: [],
);

const cells = monthCalendar(key, visits, { maps });
const rows = Math.max(1, cells.length / 7);
const usesMaps = cells.some((c) => c.covers.some((cover) => cover.kind === 'map'));

const newIds = new Set([...places].filter(([, p]) => p.isNew).map(([id]) => id));
const figures = monthFigures(visits, newIds);

const prev = shiftMonth(key, -1);
const next = shiftMonth(key, 1);
const has = (k: string) => allKeys.includes(k);
const query = monthQuery(aspect);

---

<RestaurantLayout
	title={`${monthLabel(key)} · Jason's restaurant log`}
	pathname="/restaurants"
	isOwner={isOwner}
>
	<div class="rl-page">
		<div class="rl-head">
			<div>
				<a class="rl-back" href="/restaurants">&larr; Jason&rsquo;s restaurant log</a>
				<div class="rl-head__title">Month in review</div>
			</div>
			<div class="controls">
				<span class="rl-label">Export</span>
				{
					ASPECTS.map((a) => (
						<a
							class:list={['fmt', a.slug === aspect.slug && 'fmt--on']}
							href={`/restaurants/month/${key}${monthQuery(a)}`}
						>
							{a.id}
						</a>
					))
				}
				<button type="button" class="rl-btn" data-save-card>Save image</button>
			</div>
		</div>

		<!-- Stepping to another month is a navigation, but the card is one place, so
		     the steps replace the history entry rather than stacking one per month
		     (data-rl-replace; the layout does the work). Otherwise Back walks you
		     through every month you looked at instead of leaving for the page that
		     sent you here. The film log's month card behaves the same way. -->
		<nav class="stepper">
			{
				has(prev) ? (
					<a class="stepper__go" href={`/restaurants/month/${prev}${query}`} data-rl-replace>
						&larr; {monthLabel(prev)}
					</a>
				) : (
					<span class="stepper__go stepper__go--off">&larr;</span>
				)
			}
			<a class="stepper__all" href="/restaurants/month">All months</a>
			{
				has(next) ? (
					<a class="stepper__go" href={`/restaurants/month/${next}${query}`} data-rl-replace>
						{monthLabel(next)} &rarr;
					</a>
				) : (
					<span class="stepper__go stepper__go--off">&rarr;</span>
				)
			}
		</nav>

		<div class="stage">
			<div class="viewport" data-viewport style={`--h:${aspect.height}px`}>
				<div class="scaler">
					<div class="card" data-card style={`--h:${aspect.height}px; --rows:${rows}`}>
						<div class="card__head">
							<div>
								<div class="card__kicker">The month in eating</div>
								<div class="card__month">{monthLabel(key)}</div>
							</div>
							<div class="card__count">
								<div class="card__countn">{visits.length}</div>
								<div class="card__countl">{visits.length === 1 ? 'meal out' : 'meals out'}</div>
							</div>
						</div>

						{/* THE PHOTOGRAPHS GO THROUGH THE IMAGE OPTIMISER, and here that is
						    about ORIGIN rather than bytes. The export rasterises the card
						    through a canvas, so every photograph on it has to be readable
						    cross-origin — and the bucket's public r2.dev host answers with
						    no `Access-Control-Allow-Origin` at all, which no bucket CORS
						    policy fixes (that policy applies to custom domains and the S3
						    API, not to r2.dev). A `crossorigin="anonymous"` <img> against
						    it therefore fails outright, which is what emptied every cell.
						    `/_vercel/image` is same-origin, so there is nothing to allow.
						    The card is a fixed 1080px artboard exported at pixelRatio 1,
						    so a cell is ~150px and the 320 rung is already 2x it.
						    `cacheBust` below appends a `&v=` the optimiser ignores.

						    A DAY WITH TWO MEALS IN IT stacks: the better-ranked cover sits
						    on top and the one under it is turned a few degrees so its
						    corner shows, which is how a pile of prints looks and is the
						    only honest way to fit two meals in one square.

						    A MAP COVER IS AN EMPTY SPAN UNTIL THE CLIENT FILLS IT, which is
						    the price of drawing it in our own palette rather than a
						    vendor's. See the script below. */}
						<div class="strip">
							<div class="strip__days">
								{WEEKDAYS.map((d) => <span>{d}</span>)}
							</div>
							<div class="strip__grid">
								{
									cells.map((c) => (
										<div
											class:list={[
												'cell',
												c.day == null && 'cell--pad',
												c.verdict != null && 'cell--hit',
												c.covers.length > 0 && 'cell--plated',
												c.covers.length > 1 && 'cell--stack',
											]}
										>
											{c.covers.map((cover, i) => (
												<span
													class:list={['plate', `plate--${cover.kind}`, i > 0 && 'plate--under']}
													style={`--i:${i}`}
												>
													{cover.kind === 'photo' ? (
														<img src={photoSrc(cover.url, 320)} alt="" data-cover />
													) : (
														<Fragment>
															<span data-place-map data-lat={cover.at.lat} data-lng={cover.at.lng} />
															<span class="plate__pin" />
														</Fragment>
													)}
												</span>
											))}
											{c.day != null && <span class="cell__n">{c.day}</span>}
											{c.verdict != null && (
												<span class="cell__mark">
													<VerdictMark verdict={c.verdict} size={22} ring={false} />
												</span>
											)}
										</div>
									))
								}
							</div>
						</div>

						<div class="figures">
							{
								figures.map((f) => (
									<div class="figure">
										<div class="figure__v">{f.value}</div>
										<div class="figure__l">{f.label}</div>
									</div>
								))
							}
						</div>

						<div class="card__foot">
							<span class="card__url">jqiao.vercel.app</span>
							{/* A calendar cell has no room for the attribution control the live
							    map carries, so the credit is printed here instead — and taken
							    away again if no map ends up being drawn. */}
							{usesMaps && (
								<span class="card__credit" data-map-credit>
									Maps © MapTiler © OpenStreetMap
								</span>
							)}
						</div>
					</div>
				</div>
			</div>
		</div>

		{/* Zoom 14.5 puts a few blocks in a 131px cell — enough street pattern to
		    read as a place. Closer than that and it is one intersection; the live
		    map opens on a single pin at 14.5 as well. */}
		{
			usesMaps && (
				<script
					type="application/json"
					data-map-config
					set:html={JSON.stringify({ key: mapKey, zoom: 14.5 })}
				/>
			)
		}
	</div>
</RestaurantLayout>

<script>
	const button = document.querySelector<HTMLButtonElement>('[data-save-card]');
	const card = document.querySelector<HTMLElement>('[data-card]');
	const viewport = document.querySelector<HTMLElement>('[data-viewport]');

	// ---- fit the 1080px artboard to whatever room the column has ----
	// The card is drawn at its real size and shrunk by a transform on the wrapper,
	// so the export keeps its 1080 whatever the screen is. The scale is worked out
	// here rather than in CSS because a length divided by a length is not a number
	// as far as `scale()` is concerned — the arithmetic this replaced was invalid,
	// which dropped the transform and left phones showing the artboard at full
	// size. Capped at 0.62 so the card doesn't outgrow the controls above it, and
	// floored so it stays a picture on a phone. Same fit as the film card's.
	const stage = viewport?.parentElement;
	function fit(): void {
		if (!viewport) return;
		const width = stage?.clientWidth ?? 1080;
		viewport.style.setProperty('--s', String(Math.max(0.2, Math.min(0.62, width / 1080))));
	}
	if (viewport) {
		if (stage && 'ResizeObserver' in window) new ResizeObserver(fit).observe(stage);
		else window.addEventListener('resize', fit);
		fit();
	}

	// A cover that never arrives — a photo whose object has gone, a map that
	// couldn't be drawn — leaves the cell as the ruled paper it would have been,
	// rather than as a broken image with a day number on it.
	function abandon(plate: Element | null | undefined): void {
		const cell = plate?.closest('.cell');
		plate?.remove();
		if (cell && !cell.querySelector('.plate')) cell.classList.remove('cell--plated', 'cell--stack');
	}

	for (const img of document.querySelectorAll<HTMLImageElement>('img[data-cover]')) {
		const drop = () => abandon(img.closest('.plate'));
		if (img.complete && img.naturalWidth === 0) drop();
		else img.addEventListener('error', drop);
	}

	// ---- the map covers ----
	//
	// WHY THESE ARE DRAWN HERE RATHER THAN FETCHED AS PICTURES. Asking MapTiler
	// for a finished image — the Static Maps API, or raster tiles of a style of
	// our own — is server-side rendering, and this account's key is not entitled
	// to it: those endpoints answer "Invalid key" for the key their vector tiles
	// accept. Stock raster tiles do work, and the first version of this used
	// them, warmed towards the palette with a sepia filter. But the map on this
	// card should be the same map as the section's, and that style
	// (menuBasemap — green water, ink labels, roads drawn by taking ink away)
	// only exists as something MapLibre draws. So MapLibre draws it, once, in a
	// hidden 131×190 map that jumps from place to place, and each frame is
	// snapshotted to a data URL and dropped into its cell.
	//
	// The snapshot is what makes this survivable downstream: the export
	// rasterises the DOM, which a live WebGL canvas comes out of blank, but a
	// data URL is just another image by then. `preserveDrawingBuffer` is what
	// makes the canvas readable at all, and the map is rendered at the cell's
	// own size so the street labels land at the size they were designed for
	// rather than at half of it.
	//
	// The whole thing is lazy: no map covers on this month, no MapLibre.
	const mapConfig = document.querySelector('[data-map-config]');
	const slots = [...document.querySelectorAll<HTMLElement>('[data-place-map]')];

	// Held so the export can wait for it: a card saved while the maps are still
	// arriving is a card with holes in it.
	let mapsDrawn: Promise<void> = Promise.resolve();

	if (mapConfig?.textContent && slots.length > 0) {
		const { key, zoom } = JSON.parse(mapConfig.textContent) as { key: string; zoom: number };
		mapsDrawn = drawMaps(key, zoom, slots).catch(() => {
			for (const slot of slots) abandon(slot.closest('.plate'));
			document.querySelector('[data-map-credit]')?.remove();
		});
	}

	async function drawMaps(key: string, zoom: number, slots: HTMLElement[]): Promise<void> {
		const [maplibregl, { default: workerUrl }, { menuBasemap }] = await Promise.all([
			import('maplibre-gl'),
			// The worker is loaded from a URL the bundler cannot infer; the live
			// map has the long version of this note in RestaurantMap.astro.
			import('maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url'),
			import('../../../lib/map-style'),
		]);
		maplibregl.setWorkerUrl(workerUrl);

		// THE LABELS COME OFF. menuBasemap sets street and place names for a map
		// you look at, and a cell is 131px wide: at that size one name is wider
		// than the whole square, so what actually lands is a word cut in half at
		// both ends. Without them the cell reads as what it is — a street pattern
		// with a pin in it — and the palette is doing the talking anyway.
		const style = menuBasemap(key);
		style.layers = style.layers.filter((layer) => !layer.id.startsWith('label-'));

		// Off-screen rather than hidden: `display: none` gives the map no size to
		// render at, and a zero-sized canvas snapshots to nothing. Sized to the
		// cell it will land in — `offsetWidth` is the layout size, so the stage's
		// scaling transform doesn't get a vote — which keeps every width in the
		// style at the number it was authored as.
		const cell = slots[0].closest<HTMLElement>('.cell');
		const scratch = document.createElement('div');
		scratch.style.cssText = `position:fixed; left:-9999px; top:0; width:${
			cell?.offsetWidth || 131
		}px; height:${cell?.offsetHeight || 145}px; pointer-events:none`;
		document.body.append(scratch);

		const map = new maplibregl.Map({
			container: scratch,
			style: style as maplibregl.StyleSpecification,
			center: [0, 0],
			zoom,
			interactive: false,
			attributionControl: false,
			// Read back below, so the frame has to still be there to read.
			preserveDrawingBuffer: true,
			// Twice the cell, so the export has something to work with; and no
			// fade, so a snapshot can't catch a label half-way in.
			pixelRatio: 2,
			fadeDuration: 0,
		});

		/** Resolves when the map has nothing left to draw, or has taken too long. */
		const settled = (event: 'load' | 'idle') =>
			new Promise<void>((resolve) => {
				const done = () => {
					clearTimeout(timer);
					map.off(event, done);
					resolve();
				};
				const timer = setTimeout(done, 6000);
				map.on(event, done);
			});

		try {
			await settled('load');
			let drawn = 0;
			for (const slot of slots) {
				const lat = Number(slot.dataset.lat);
				const lng = Number(slot.dataset.lng);
				if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
					abandon(slot.closest('.plate'));
					continue;
				}
				map.jumpTo({ center: [lng, lat], zoom });
				await settled('idle');
				const shot = document.createElement('img');
				shot.className = 'plate__shot';
				shot.alt = '';
				shot.src = map.getCanvas().toDataURL('image/png');
				slot.replaceWith(shot);
				drawn++;
			}
			if (drawn === 0) document.querySelector('[data-map-credit]')?.remove();
		} finally {
			map.remove();
			scratch.remove();
		}
	}

	// ---- saving the card ----
	//
	// THIS USED TO BE `toPng` INTO AN `<a download>`, AND ON A PHONE IT STOPPED
	// WORKING: iOS put up its download prompt and then produced nothing. Two
	// reasons, and the film card had already answered both.
	//
	// The first is that a `data:` URL of a whole 1080×1350 artboard is a string
	// megabytes long, and longer again now the map cells carry their snapshots as
	// data URLs of their own — a size Safari quietly declines to save. A Blob has
	// no such ceiling.
	//
	// The second is where the file would land even if it saved. A download goes
	// to Files; a picture you meant to post belongs in Photos, and the share
	// sheet's "Save Image" is the only door into it. So on a touch device the
	// render is handed to navigator.share, and desktop keeps the plain download,
	// where a share sheet would be a detour.
	const shareFile =
		matchMedia('(pointer: coarse)').matches &&
		typeof navigator.share === 'function' &&
		(() => {
			try {
				return !!navigator.canShare?.({
					files: [new File([new Blob()], 'card.png', { type: 'image/png' })],
				});
			} catch {
				return false;
			}
		})();

	// Rendering can outlast the tap that started it, and Safari won't open the
	// sheet without a live user gesture. Keeping the render means the second tap
	// can share immediately, inside its own gesture. The map snapshots are part of
	// the state: a render made before they landed is a different card.
	let rendered: { state: string; file: File } | null = null;
	const renderState = (): string =>
		`${location.pathname}${location.search}|${document.querySelectorAll('.plate__shot').length}`;

	// Safari and every iOS browser, which is Safari underneath. html-to-image
	// rasterises through an SVG <foreignObject>, and WebKit is known to paint
	// that clone's text on a cold pass while dropping its images; the second pass
	// costs almost nothing, since the inlined data URLs are cached from the first.
	const webkit =
		/AppleWebKit/.test(navigator.userAgent) && !/Chrome|Chromium|Edg\//.test(navigator.userAgent);

	async function render(): Promise<Blob | null> {
		if (!card) return null;
		const { toBlob } = await import('html-to-image');
		const options = {
			// Drawn at the artboard's own size rather than the scaled-down preview,
			// so the export is 1080 wide whatever the screen is.
			width: card.offsetWidth,
			height: card.offsetHeight,
			pixelRatio: 1,
			backgroundColor: '#fdf7e8',
			// The card sits inside a scaled wrapper; the clone must not inherit it.
			style: { transform: 'none' },
			cacheBust: true,
		};
		const first = await toBlob(card, options);
		return webkit ? await toBlob(card, options) : first;
	}

	button?.addEventListener('click', async () => {
		if (!card) return;
		const idle = button.dataset.label ?? button.textContent ?? 'Save image';
		button.dataset.label = idle;
		const name = `${document.title.split(' ·')[0].replace(/\s+/g, '-').toLowerCase()}-eating.png`;

		// A render is already in hand and still current: share it now, while the
		// tap that asked for it is still what the browser is acting on.
		if (shareFile && rendered?.state === renderState()) {
			try {
				await navigator.share({ files: [rendered.file] });
			} catch (error) {
				if ((error as DOMException)?.name !== 'AbortError')
					button.textContent = 'Could not open the share sheet';
			}
			return;
		}

		let next = idle;
		button.disabled = true;
		button.textContent = 'Drawing…';
		try {
			// A card whose maps haven't arrived yet would export with holes in it.
			await mapsDrawn;
			const blob = await render();
			if (!blob) throw new Error('nothing was rendered');

			if (shareFile) {
				const file = new File([blob], name, { type: 'image/png' });
				rendered = { state: renderState(), file };
				try {
					await navigator.share({ files: [file] });
				} catch (error) {
					const kind = (error as DOMException)?.name;
					// The sheet needs a gesture that hasn't gone stale; the render is
					// kept, so tapping again opens it straight away.
					if (kind === 'NotAllowedError') next = 'Ready — tap again';
					else if (kind !== 'AbortError') next = 'Could not open the share sheet';
				}
				return;
			}

			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = name;
			a.click();
			// Revoked late: some browsers are still reading the blob when click() returns.
			setTimeout(() => URL.revokeObjectURL(url), 10_000);
		} catch {
			next = 'Could not draw the card';
		} finally {
			button.disabled = false;
			button.textContent = next;
		}
	});
</script>

<style>
	.controls {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}
	.fmt {
		background: var(--card);
		border: 1px solid var(--dashed);
		font-family: var(--mono);
		font-size: 11.5px;
		padding: 5px 10px;
		color: var(--ink-2);
	}
	.fmt--on {
		background: var(--ink);
		color: var(--ground);
		border-color: var(--ink);
	}
	.fmt--on:hover {
		color: var(--ground);
	}

	.stepper {
		margin-top: 14px;
		display: flex;
		align-items: center;
		gap: 16px;
		font-size: 12.5px;
	}
	.stepper__all {
		margin-left: auto;
		color: var(--ink-3);
	}
	.stepper__go--off {
		color: var(--rule);
	}

	/* ---- the artboard ----
	   .viewport reserves the scaled-down footprint; .scaler shrinks the 1080px
	   card into it. The card keeps its real size so the export renders at 1080
	   regardless of the screen. --s is set by the script above. */
	.stage {
		margin-top: 20px;
		display: flex;
		justify-content: center;
	}
	.viewport {
		position: relative;
		width: calc(1080px * var(--s, 0.5));
		height: calc(var(--h) * var(--s, 0.5));
	}
	.scaler {
		transform: scale(var(--s, 0.5));
		transform-origin: 0 0;
		width: 1080px;
	}
	.card {
		width: 1080px;
		height: var(--h);
		background: var(--card);
		border: 1px solid var(--rule);
		padding: 56px 56px 48px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.card__head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		border-bottom: 3px solid var(--ink);
		padding-bottom: 18px;
	}
	.card__kicker {
		font-size: 22px;
		font-weight: 700;
		letter-spacing: 4.4px;
		text-transform: uppercase;
		color: var(--terracotta);
	}
	.card__month {
		margin-top: 10px;
		font-family: var(--display);
