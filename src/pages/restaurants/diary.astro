---
// The diary — every visit, newest first, grouped by month.
//
// The film log's diary is a dense table-ish list and this one wants to be too,
// except it has photographs to contend with. Rather than letting them set the
// row height, the thumbnails ride INSIDE the row at its existing height — up to
// three, 38×30, sitting between the name and the rating. A month of meals
// stays scannable, the photos say which visits have any, and a row with none
// is the same height as a row with three.
//
// NO PRICE COLUMN. It was the rightmost thing on the row, which made it read as
// what the meal cost — and it never was: `restaurant_diary.price_band` is the
// PLACE's band, inlined, so eleven meals at the same counter printed the same
// $ eleven times. It belongs to the restaurant, and that is where it is said:
// the place page, the places list, the tile, the map popup and the price mix on
// the stats page.
import RestaurantLayout from '../../layouts/RestaurantLayout.astro';
import MealEditor from '../../components/MealEditor.astro';
import VerdictMark from '../../components/VerdictMark.astro';
import { requireOwner } from '../../lib/auth';
import { groupByMonth, listDiary, listFriends, listTags, getRestaurantStats } from '../../lib/restaurants';
import { placeLine } from '../../lib/restaurant-view';
import { starText } from '../../lib/format';
import { photoUrl } from '../../lib/restaurants';
import { photoSrc, photoSrcSet, photoWidthsFor } from '../../lib/photo-src';
import { supabasePublic } from '../../lib/supabase';

export const prerender = false;

// 38×30 in the stylesheet below, and this is the page that makes the optimiser
// worth having: it lists every visit ever logged, three thumbnails apiece, so
// serving the stored 1600px frame here meant a few hundred kilobytes each for
// a picture the width of a fingernail.
const THUMB = 38;
const THUMB_WIDTHS = photoWidthsFor(THUMB);

const [visits, stats, isOwner] = await Promise.all([
	listDiary(),
	getRestaurantStats(),
	requireOwner(Astro.cookies),
]);
const [tagOptions, friendOptions] = isOwner ? await Promise.all([listTags(), listFriends()]) : [[], []];

// Up to three thumbnails a row. Fetched in one query for the whole page rather
// than per visit — the diary is the one page where a per-row round trip would
// actually be felt.
const thumbs = new Map<number, string[]>();
if (visits.length > 0) {
	const { data } = await supabasePublic
		.from('restaurant_photos')
		.select('visit_id,storage_path,position')
		.in(
			'visit_id',
			visits.map((v) => v.id),
		)
		.order('position');
	for (const row of (data ?? []) as { visit_id: number; storage_path: string }[]) {
		const list = thumbs.get(row.visit_id) ?? [];
		if (list.length < 3) list.push(photoUrl(row.storage_path));
		thumbs.set(row.visit_id, list);
	}
}

const months = groupByMonth(visits);
---

<RestaurantLayout title="Diary · Jason's restaurant log" pathname="/restaurants" isOwner={isOwner}>
	<div class="rl-page">
		<div class="rl-head">
			<div>
				<a class="rl-back" href="/restaurants">&larr; Jason&rsquo;s restaurant log</a>
				<div class="rl-head__title">Diary</div>
			</div>
			<span class="rl-count">
				{stats.visits} visit{stats.visits === 1 ? '' : 's'} · {stats.places} place{stats.places === 1 ? '' : 's'}
			</span>
		</div>

		{
			months.length === 0 ? (
				<p class="rl-empty empty">
					No meals logged yet. Every visit lands here, newest first, under the month
					it happened in.
				</p>
			) : (
				months.map((m) => (
					<section class="month">
						<div class="rl-sec-head rl-sec-head--thin">
							<span class="rl-sec-head__title">{m.label}</span>
							<span class="rl-gap" />
							<span class="rl-sec-head__sub">
								{m.visits.length} visit{m.visits.length === 1 ? '' : 's'} · {m.places} place
								{m.places === 1 ? '' : 's'}
							</span>
						</div>
						{m.visits.map((v) => (
							<a class="drow" href={`/restaurants/diary/${v.id}`}>
								<span class="drow__day">{Number(v.visited_on.slice(8, 10))}</span>
								<VerdictMark verdict={v.verdict} size={21} />
								<span class="drow__name">{v.restaurant_name}</span>
								<span class="drow__hood">{placeLine(v)}</span>
								<span class="rl-gap" />
								<span class="drow__thumbs">
									{(thumbs.get(v.id) ?? []).map((url) => (
										<img
											src={photoSrc(url, THUMB)}
											srcset={photoSrcSet(url, THUMB_WIDTHS)}
											sizes={`${THUMB}px`}
											alt=""
											loading="lazy"
											decoding="async"
										/>
									))}
								</span>
								<span class="drow__rating">
									<span class="rl-stars drow__stars">{starText(v.rating) ?? ''}</span>
									<span class="rl-marks drow__mark">{v.hearted ? '♥' : ''}</span>
									<span class="rl-marks drow__mark">{v.revisit ? '↻' : ''}</span>
								</span>
							</a>
						))}
					</section>
				))
			)
		}
	</div>

	{
		isOwner && (
			<MealEditor redirect="/restaurants/diary" tagOptions={tagOptions} friendOptions={friendOptions} />
		)
	}
</RestaurantLayout>

<style>
	.month {
		margin-top: 26px;
	}
	.empty {
		margin-top: 24px;
	}

	.drow {
		display: flex;
		align-items: center;
		gap: 8px 14px;
		flex-wrap: wrap;
		padding: 12px 4px;
		border-bottom: 1px solid var(--rule-3);
		color: var(--ink);
	}
	.drow:hover {
		background: var(--wash);
		color: var(--ink);
	}
	.drow__day {
		width: 34px;
		flex: none;
		font-family: var(--mono);
		font-size: 14px;
		text-align: right;
		font-variant-numeric: tabular-nums;
	}
	.drow__name {
		font-size: 14.5px;
		font-weight: 600;
		white-space: nowrap;
	}
	.drow__hood {
		font-size: 11.5px;
		color: var(--ink-3);
		white-space: nowrap;
	}
	.drow__thumbs {
		display: flex;
		gap: 5px;
	}
	.drow__thumbs img {
		width: 38px;
		height: 30px;
		object-fit: cover;
		box-shadow: inset 0 0 0 1px rgba(47, 30, 18, 0.18);
		display: block;
	}
	/* The rating and its two marks are one right-hand cluster rather than three
	   columns with the row's 14px gap between them: they are one opinion said
	   three ways, so they read as a group and are spaced like one. Every slot
	   is drawn whether or not it is filled — an unhearted meal still occupies
	   its heart's width — which is what keeps the star column landing in the
	   same place down the month instead of shuffling left and right by a
	   glyph. */
	.drow__rating {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.drow__stars {
		width: 66px;
		text-align: right;
	}
	.drow__mark {
		width: 12px;
		text-align: center;
		line-height: 1;
	}

	/* On a phone the row wraps: the date, mark and name hold the first line and
	   everything measurable drops to the second, still right-aligned as a
	   column. The spacer goes with them rather than splitting the name. */
	@media (max-width: 620px) {
		.drow__name {
			white-space: normal;
		}
		.drow__hood {
			width: 100%;
			padding-left: 48px;
		}
	}
</style>
