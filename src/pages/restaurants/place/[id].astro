---
// A restaurant — the place, not the visit.
//
// Two shapes have to work here and they pull in opposite directions. The COMMON
// one is a place I've been to once, where the page is a name, a location, a
// verdict and very little else, and the job is to not look unfinished. The
// INTERESTING one is a place I've been to eleven times, where the page is
// mostly history, and the job is to not become a wall.
//
// The answer is that the sections are earned rather than always drawn. One
// visit gets the header, the visit and the sidecar — no verdict history (a
// single point is not a history), no photo grouping (one date is not a
// grouping). Eleven visits earns both, and the history goes FIRST, because
// with eleven of them the movement is the story: the verdict belongs to a
// visit and it moves, so a place that was "Try something else" in March and
// "Definitely return" in June is the system working. Flattening that into one
// badge would throw away the only thing eleven visits tells you that one
// doesn't.
import RestaurantLayout from '../../../layouts/RestaurantLayout.astro';
import MealEditor from '../../../components/MealEditor.astro';
import PlaceEditor from '../../../components/PlaceEditor.astro';
import VerdictMark from '../../../components/VerdictMark.astro';
import PhotoStrip from '../../../components/PhotoStrip.astro';
import { requireOwner } from '../../../lib/auth';
import { getPlace, listFriends, listTags, WHY_TAGS } from '../../../lib/restaurants';
import {
	locationState,
	photoStrip,
	placeEvidence,
	placeLine,
	shortDate,
	visitCountLabel,
	visitMarks,
} from '../../../lib/restaurant-view';
import { verdictAt, VERDICTS } from '../../../lib/verdict';
import { starText } from '../../../lib/format';

export const prerender = false;

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect('/restaurants/places');

const detail = await getPlace(id);
if (!detail) return new Response('Not found', { status: 404 });

const { place, visits } = detail;
const isOwner = await requireOwner(Astro.cookies);
const [tagOptions, friendOptions] = isOwner ? await Promise.all([listTags(), listFriends()]) : [[], []];

// A history needs at least three points to be a shape rather than a pair.
const withVerdicts = visits.filter((v) => v.verdict != null).slice().reverse();
const showHistory = withVerdicts.length >= 3;
const shots = photoStrip(visits);

const latest = verdictAt(place.latest_verdict);
const links = [
	{
		label: 'Google Maps',
		href: place.google_place_id
			? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place.name)}&query_place_id=${place.google_place_id}`
			: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${place.name} ${placeLine(place)}`)}`,
	},
	{ label: 'Website', href: place.website_url },
	{ label: 'Yelp', href: place.yelp_url },
	{ label: 'Beli', href: place.beli_url },
];

const span =
	place.first_visit && place.last_visit
		? `${monthYear(place.first_visit)} — ${monthYear(place.last_visit)}`
		: '';

function monthYear(iso: string): string {
	const [y, m] = iso.slice(0, 7).split('-').map(Number);
	return new Date(y, m - 1, 1).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}

// Counted off the strip rather than off `place.photo_count`, so the head can
// never claim a photograph the row isn't showing.
const photoNote = shots.length === 1 ? '1 photograph' : `${shots.length} photographs`;

// ---------------------------------------------------------------------------
// Where this place is, and how much of that anybody confirmed
// ---------------------------------------------------------------------------
//
// A place added by name alone has no point, and its city is the default the
// insert had to write to satisfy a NOT NULL. The header said that city as
// plainly as a confirmed one, so 34 pages asserted a location nobody chose.
//
// The invitation to fix it scales with how much else the page has to say. On a
// to-try page — which is what every unplaced place is today — there is almost
// nothing else, so it is the content: the panel states the cost, shows the
// record, and offers both routes. On a page with a history the same fact is a
// footnote, because eleven visits are the reason you came.
const where = locationState(place);
const isPlaced = where === 'placed';
// Owner-only, both of them: an invitation is a control, and to a visitor it
// would only be an apology for the state of somebody else's records. What a
// visitor still sees is the header's admission and the sidecar's "not on it",
// because those are statements about the record rather than things to do.
const inviteLoud = isOwner && !isPlaced && visits.length <= 1;
const inviteQuiet = isOwner && !isPlaced && visits.length > 1;
const evidence = placeEvidence(place);

const UNCONFIRMED = `Nobody confirmed this. “${place.city}” was assumed when the place was added by name alone.`;
---

<RestaurantLayout
	title={`${place.name} · Jason's restaurant log`}
	pathname="/restaurants"
	isOwner={isOwner}
>
	<div class="rl-page rl-page--flush">
		<div class="rl-topbar">
			<a class="rl-back" href="/restaurants/places">&larr; Jason&rsquo;s restaurant log</a>
			<span class="rl-tag">Restaurants</span>
		</div>

		<div class="rl-split place">
			<div class="rl-main place__main">
				<header>
					<h1 class="place__name">{place.name}</h1>
					<div class="place__facts">
						{place.cuisines.length > 0 && <span>{place.cuisines.join(', ')}</span>}
						{place.cuisines.length > 0 && place.price_band && <span class="dot">·</span>}
						{place.price_band && <span class="mono">{place.price_band}</span>}
						{(place.cuisines.length > 0 || place.price_band) && <span class="dot">·</span>}
						{
							/* An assumed city is said as an assumption. The words stay —
							   they are the only location on record — but they stop
							   claiming to be a fact. */
							where === 'unplaced' ? (
								<Fragment>
									<span class="place__where place__where--unsure" title={UNCONFIRMED}>
										{placeLine(place)}
									</span>
									<span class="place__unsure" title={UNCONFIRMED}>nobody confirmed this</span>
								</Fragment>
							) : (
								<span>{placeLine(place)}</span>
							)
						}
						<span class="place__links">
							{
								links.map((l) =>
									l.href ? (
										<a class="place__link" href={l.href} rel="noreferrer noopener" target="_blank">
											{l.label}
										</a>
									) : (
										<span class="place__link place__link--off" title={`No ${l.label} link on record`}>
											{l.label}
										</span>
									),
								)
							}
							{
								isOwner && isPlaced && (
									<button type="button" class="place__fix" data-open-place-editor>
										wrong location?
									</button>
								)
							}
						</span>
					</div>
				</header>

				{
					inviteLoud && (
						<div class="invite">
							<div class="invite__title">
								{where === 'unplaced'
									? 'This place has no point on the map.'
									: 'Located, but still not on the map.'}
							</div>
							<div class="invite__evidence">{evidence}</div>
							<p class="invite__body">
								{where === 'unplaced'
									? 'It doesn’t appear on the map screen, and its city counts toward nothing in the rollup.'
									: 'The words are on record. The map still has nothing to draw, because a neighbourhood has no door to point at.'}
							</p>
							{
								isOwner && (
									<div class="invite__actions">
										<button type="button" class="rl-btn rl-btn--primary" data-open-place-editor>
											Find this place on OpenStreetMap
										</button>
										<button type="button" class="invite__hand" data-open-place-by-hand>
											or write the location in by hand
										</button>
									</div>
								)
							}
						</div>
					)
				}

				{
					inviteQuiet && (
						<div class="quiet">
							<span class="quiet__line">
								{where === 'unplaced'
									? `${visitCountLabel(visits.length)} and no point on the map — it doesn’t appear on the map screen.`
									: 'Located in words only. Still nothing for the map to draw.'}
							</span>
							<button type="button" class="quiet__cta" data-open-place-editor>
								{where === 'unplaced' ? 'Find its point' : 'Try again for a point'}
							</button>
						</div>
					)
				}

				{
					place.on_to_try && (
						<section class="totry">
							<div class="rl-label">On the to-try list</div>
							<p class="totry__why">{place.to_try_reason ?? 'No reason written down.'}</p>
							{/* The kind of why, beside the sentence. For an owner they
							    are the control as well as the display — eighty places
							    were imported without any, and a filter nothing is
							    tagged for is a filter that never works. */}
							{isOwner ? (
								<div class="totry__tags" data-why-tags data-place={place.id}>
									{WHY_TAGS.map((t) => (
										<button
											type="button"
											class:list={['totry__tag', place.to_try_tags.includes(t) && 'totry__tag--on']}
											data-why-tag={t}
										>
											{t}
										</button>
									))}
								</div>
							) : (
								place.to_try_tags.length > 0 && (
									<div class="totry__tags">
										{place.to_try_tags.map((t) => (
											<span class="totry__tag totry__tag--on totry__tag--static">{t}</span>
										))}
									</div>
								)
							)}
							{isOwner && (
								<button type="button" class="rl-btn rl-btn--primary" data-open-meal-editor>
									+ Log the first visit
								</button>
							)}
						</section>
					)
				}

				{
					showHistory && (
						<section>
							<div class="rl-sec-head rl-sec-head--thin">
								<span class="rl-sec-head__title">Verdict history</span>
								<span class="rl-sec-head__sub">{span}</span>
							</div>
							{/* The y axis is the ladder itself, top rung at the top, so the
							    needles both sit at their rank and point at it. */}
							<div class="rl-box hist">
								<div class="hist__plot">
									<div class="hist__axis">
										<span>Definitely</span>
										<span>Happy to go</span>
										<span>Avoid</span>
									</div>
									<div class="hist__series">
										<div class="hist__track">
										{withVerdicts.map((v) => (
											<a
												class="hist__col"
												href={`/restaurants/diary/${v.id}`}
												title={`${shortDate(v.visited_on)} — ${verdictAt(v.verdict)?.label}`}
											>
												<span
													class="hist__dot"
													style={`top:${((v.verdict as number) / (VERDICTS.length - 1)) * 100}%`}
												>
													<VerdictMark verdict={v.verdict} size={20} />
												</span>
												<span class="hist__tick">{shortDate(v.visited_on)}</span>
											</a>
										))}
										</div>
									</div>
								</div>
							</div>
						</section>
					)
				}

				{
					shots.length > 0 && (
						<section>
							<div class="rl-sec-head rl-sec-head--thin">
								<span class="rl-sec-head__title">Photographs</span>
								<span class="rl-sec-head__sub">{photoNote}</span>
							</div>
							{/* ONE ROW, however many times I go back. Twelve visits of one to
							    three photographs each was twelve dated headings over twelve
							    near-empty walls: a section that grew a rung every meal and was
							    mostly margin. The row is the same height at any count, and the
							    heading each group used to need is now the line underneath it —
							    point at a photograph and it says when it was taken and what it
							    was of. The dates ride on the photographs, so nothing is spent
							    on saying them twelve times. */}
							<PhotoStrip photos={shots} />
						</section>
					)
				}

				<section>
					<div class="rl-sec-head rl-sec-head--thin">
						<span class="rl-sec-head__title">{visits.length === 1 ? 'The visit' : 'Every visit'}</span>
						<span class="rl-sec-head__sub">{visitCountLabel(visits.length)}</span>
					</div>
					{
						visits.length === 0 ? (
							<p class="rl-empty">Not been yet.</p>
						) : (
							visits.map((v) => (
								<a class="visit" href={`/restaurants/diary/${v.id}`}>
									<div class="visit__when">
										<div class="visit__day">{shortDate(v.visited_on)}</div>
										<div class="visit__year">{v.visited_on.slice(0, 4)}</div>
									</div>
									<VerdictMark verdict={v.verdict} size={22} />
									<div class="visit__body">
										<div class="visit__line">
											{starText(v.rating) && <span class="rl-stars">{starText(v.rating)}</span>}
											{visitMarks(v) && <span class="rl-marks">{visitMarks(v)}</span>}
											{v.friends.length > 0 && (
												<span class="visit__friends">with {v.friends.join(', ')}</span>
											)}
										</div>
										{/* An entry with no review is frequent and fine. The row
										    keeps its shape from the date and the mark, so nothing
										    is drawn to fill the gap. */}
										{v.review && <p class="visit__review">{v.review}</p>}
									</div>
									{v.photos[0] && (
										<img class="visit__thumb" src={v.photos[0].url} alt="" loading="lazy" decoding="async" />
									)}
								</a>
							))
						)
					}
				</section>
			</div>

			<aside class="rl-side">
				<div class="rl-box">
					<div class="sidecar__block">
						<div class="rl-label">Verdict</div>
						<div class="sidecar__verdict">
							<VerdictMark verdict={place.latest_verdict} size={40} />
							<div>
								<div class="sidecar__verdict-name">{latest?.label ?? 'None recorded'}</div>
								<div class="sidecar__verdict-when">
									{
										place.latest_verdict_on
											? `${shortDate(place.latest_verdict_on)} ${place.latest_verdict_on.slice(0, 4)} · ${
													visits.length > 1 ? `latest of ${visits.length}` : 'only visit'
												}`
											: 'no visit has recorded one'
									}
								</div>
							</div>
						</div>
						{latest && <p class="sidecar__gloss">{latest.gloss}</p>}
					</div>

					<div class="sidecar__row">
						<span class="rl-label">Rating</span>
						<span class="rl-gap"></span>
						{starText(place.avg_rating) && <span class="rl-stars">{starText(place.avg_rating)}</span>}
						<span class="sidecar__n">
							{place.avg_rating != null ? `${place.avg_rating} avg` : 'no rating'}
						</span>
					</div>

					<div class="sidecar__row">
						<span class="rl-label">Visits</span>
						<span class="rl-gap"></span>
						<span class="sidecar__n">{place.visit_count}</span>
					</div>

					{
						/* The one field on this page you can only set here: the
						   composer asks it when you log or add, and this is where
						   it gets changed afterwards. Writes straight through, like
						   the heart and the rank. */
						isOwner ? (
							<button
								type="button"
								class="sidecar__row sidecar__trip"
								data-trip
								data-place={place.id}
								data-on={place.trip ? '1' : ''}
								title="click to change"
							>
								<span class="rl-label">Trip</span>
								<span class="rl-gap" />
								<span
									class:list={['sidecar__tripv', place.trip && 'sidecar__tripv--on']}
									data-trip-label
								>
									{place.trip ? 'Worth the trip †' : 'If I’m nearby'}
								</span>
							</button>
						) : (
							place.trip && (
								<div class="sidecar__row">
									<span class="rl-label">Trip</span>
									<span class="rl-gap" />
									<span class="sidecar__tripv sidecar__tripv--on">Worth the trip †</span>
								</div>
							)
						)
					}

					{
						/* Only drawn when the answer is no. A row saying "on it" on
						   every other page would be a row about nothing. */
						!isPlaced && (
							<div class="sidecar__row">
								<span class="rl-label">On the map</span>
								<span class="rl-gap" />
								<span
									class="sidecar__off"
									title={
										where === 'unplaced'
											? 'The map screen only draws places with both coordinates.'
											: 'Located to a neighbourhood, which has no point to draw.'
									}
								>
									{where === 'unplaced' ? 'not on it' : 'words only'}
								</span>
							</div>
						)
					}

					{
						isOwner && place.visit_count > 0 && (
							<div class="sidecar__block">
								<button
									type="button"
									class:list={['heartbtn', place.hearted && 'heartbtn--on']}
									data-heart
									data-place={place.id}
									data-hearted={place.hearted ? '1' : ''}
								>
									<span class="heartbtn__glyph">♥</span>
									<span data-heart-label>{place.hearted ? 'Loved' : 'Love it'}</span>
								</button>
							</div>
						)
					}
				</div>

				{
					isOwner && (
						<div class="rl-box rl-box--panel rl-box__pad owner">
							<div class="rl-label">Owner</div>
							<button type="button" class="owner__link" data-open-meal-editor>
								+ Log another visit
							</button>
							<button type="button" class="owner__link" data-open-place-editor>
								{isPlaced ? 'Fix this location' : 'Find this place on the map'}
							</button>
							<div class="owner__ranks">
								<span class="owner__ranks-label">Favourite rank</span>
								<div class="owner__rankrow">
									{[1, 2, 3, 4].map((r) => (
										<button
											type="button"
											class:list={['owner__rank', place.favorite_rank === r && 'owner__rank--on']}
											data-rank={r}
											data-place={place.id}
										>
											{r}
										</button>
									))}
									<button
										type="button"
										class:list={['owner__rank', place.favorite_rank == null && 'owner__rank--on']}
										data-rank=""
										data-place={place.id}
									>
										none
									</button>
								</div>
							</div>
						</div>
					)
				}
			</aside>
		</div>
	</div>

	{
		isOwner && (
			<MealEditor
				redirect={`/restaurants/place/${place.id}`}
				place={{
					id: place.id,
					name: place.name,
					meta: `${place.cuisines[0] ?? ''}${place.cuisines[0] ? ' · ' : ''}${placeLine(place)}`,
					visits: place.visit_count,
					trip: place.trip,
					priceBand: place.price_band,
					// Logging from here is nearly always logging ANOTHER visit, so
					// the composer opens on the last one's answers. Already loaded
					// and already sorted newest first — see getPlace.
					previous: visits[0]
						? {
								visitedOn: visits[0].visited_on,
								rating: visits[0].rating,
								verdict: visits[0].verdict,
								hearted: visits[0].hearted,
							}
						: null,
				}}
				tagOptions={tagOptions}
				friendOptions={friendOptions}
			/>
		)
	}

	{
		isOwner && (
			<PlaceEditor
				place={{ id: place.id, name: place.name, where: placeLine(place), cuisines: place.cuisines }}
				state={where}
				evidence={evidence}
			/>
		)
	}
</RestaurantLayout>

<script>
	// Saving a location re-reads the page, because the header, the invitation and
	// the sidecar all move together and all three are rendered on the server. The
	// sentence about what was saved rides across the reload, since "the words but
	// still no point" is the one outcome you cannot see at a glance.
	const pending = sessionStorage.getItem('rl-toast');
	if (pending) {
		sessionStorage.removeItem('rl-toast');
		const toast = document.createElement('div');
		toast.className = 'toast';
		toast.textContent = pending;
		document.body.append(toast);
		setTimeout(() => toast.remove(), 3200);
	}

	// The two owner controls that are a single field each write straight through
	// and re-read the page, rather than opening a form to change one value.
	const heart = document.querySelector<HTMLButtonElement>('[data-heart]');
	heart?.addEventListener('click', async () => {
		const on = heart.dataset.hearted === '1';
		heart.disabled = true;
		const res = await fetch(`/api/restaurants/places/${heart.dataset.place}`, {
			method: 'PATCH',
			headers: { 'content-type': 'application/json' },
			body: JSON.stringify({ hearted: !on }),
		});
		heart.disabled = false;
		if (!res.ok) {
			window.alert('Could not change that.');
			return;
		}
		heart.dataset.hearted = on ? '' : '1';
		heart.classList.toggle('heartbtn--on', !on);
		heart.querySelector('[data-heart-label]')!.textContent = on ? 'Love it' : 'Loved';
	});

	// Two more single-field controls on the same pattern: write through, then
	// show the new state. Neither reloads — nothing else on the page changes.
	const trip = document.querySelector<HTMLButtonElement>('[data-trip]');
	trip?.addEventListener('click', async () => {
		const on = trip.dataset.on === '1';
		trip.disabled = true;
		const res = await fetch(`/api/restaurants/places/${trip.dataset.place}`, {
			method: 'PATCH',
			headers: { 'content-type': 'application/json' },
			body: JSON.stringify({ trip: !on }),
		});
		trip.disabled = false;
		if (!res.ok) {
			window.alert('Could not change that.');
			return;
		}
		trip.dataset.on = on ? '' : '1';
		const label = trip.querySelector('[data-trip-label]')!;
		label.textContent = on ? 'If I\u2019m nearby' : 'Worth the trip \u2020';
		label.classList.toggle('sidecar__tripv--on', !on);
	});

	const tagBox = document.querySelector<HTMLElement>('[data-why-tags]');
	for (const button of tagBox?.querySelectorAll<HTMLButtonElement>('[data-why-tag]') ?? []) {
		button.addEventListener('click', async () => {
			// The whole set goes up, not a delta: the column is an array and the
			// buttons on screen are the truth about what it should contain.
			const wanted = [...tagBox!.querySelectorAll<HTMLButtonElement>('[data-why-tag]')]
				.filter((b) => (b === button ? !b.classList.contains('totry__tag--on') : b.classList.contains('totry__tag--on')))
				.map((b) => b.dataset.whyTag!);
			button.disabled = true;
			const res = await fetch(`/api/restaurants/places/${tagBox!.dataset.place}`, {
				method: 'PATCH',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ toTryTags: wanted }),
			});
			button.disabled = false;
			if (!res.ok) {
				window.alert('Could not change that.');
				return;
			}
			button.classList.toggle('totry__tag--on');
		});
	}

	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-rank]')) {
		button.addEventListener('click', async () => {
			const rank = button.dataset.rank ? Number(button.dataset.rank) : null;
			const res = await fetch(`/api/restaurants/places/${button.dataset.place}`, {
				method: 'PATCH',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ favoriteRank: rank }),
			});
			if (!res.ok) {
				window.alert('Could not set that rank.');
				return;
			}
			location.reload();
		});
	}
