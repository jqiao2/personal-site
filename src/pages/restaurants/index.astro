---
// The restaurant log's landing page. The warm-paper theme and the header (+ its
// "+ Log meal" action) come from RestaurantLayout; the data-heavy feed is a
// server island (RestaurantsFeed, server:defer) so only the fast owner check
// blocks this response and the meals stream in after.
import RestaurantLayout from '../../layouts/RestaurantLayout.astro';
import MealEditor from '../../components/MealEditor.astro';
import RestaurantsFeed from '../../components/RestaurantsFeed.astro';
import { requireOwner } from '../../lib/auth';
import { listTags, listFriends } from '../../lib/restaurants';

export const prerender = false;

const isOwner = await requireOwner(Astro.cookies);
const [tagOptions, friendOptions] = isOwner ? await Promise.all([listTags(), listFriends()]) : [[], []];
---

<RestaurantLayout title="Jason's restaurant log" pathname={Astro.url.pathname} isOwner={isOwner} sidebar>
	<RestaurantsFeed pathname={Astro.url.pathname} server:defer>
		<div slot="fallback" class="shell-skel" aria-hidden="true">
			<div class="feed-skel">
				{Array.from({ length: 6 }).map(() => (
					<div class="skel-item">
						<div class="skel-body">
							<div class="skel-line skel-line--meta"></div>
							<div class="skel-line skel-line--title"></div>
							<div class="skel-line skel-line--note"></div>
						</div>
						<div class="skel-thumb"></div>
					</div>
				))}
			</div>
			<div class="side-skel"></div>
		</div>
	</RestaurantsFeed>

	{isOwner && <MealEditor redirect="/restaurants" tagOptions={tagOptions} friendOptions={friendOptions} />}
</RestaurantLayout>

<style>
	/* Skeleton shown while the RestaurantsFeed island streams in. Mirrors the
	   feed's two-column geometry so the shell doesn't reflow when it arrives. */
	/* Reserves the height of the real feed, so nothing below the island moves
	   when it lands and a reader who scrolls during the load isn't yanked.
	   ponytail: measured (listRecentVisits(25) at 1280px/420px), not derived —
	   re-measure if the row template or that limit changes. */
	.shell-skel {
		/* Matches RestaurantsFeed's .shell: max-width from the header's
		   --sh-max (1120px), same 288px sidebar as the film/activity logs. */
		max-width: 1120px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 288px;
		min-height: 3870px;
	}
	.feed-skel {
		padding: 38px 40px 44px clamp(14px, 4vw, 32px);
	}
	.skel-item {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		padding: 0.85rem 0 1.05rem;
		border-bottom: 1px solid var(--rule-4, var(--rule));
	}
	.skel-body {
		flex: 1;
		min-width: 0;
	}
	.skel-thumb {
		flex: none;
		width: 72px;
		height: 72px;
		border: 1px solid var(--rule);
		background: var(--card);
	}
	.skel-line {
		height: 0.72rem;
		border-radius: 2px;
		background: var(--rule);
	}
	.skel-line--meta {
		width: 38%;
		margin-bottom: 0.5rem;
	}
	.skel-line--title {
		width: 70%;
		height: 1.25rem;
		margin-bottom: 0.5rem;
	}
	.skel-line--note {
		width: 90%;
	}
	@media (max-width: 820px) {
		.shell-skel {
			grid-template-columns: 1fr;
			/* Rows wrap narrower, so the same 25 visits run taller. */
			min-height: 4690px;
		}
		.feed-skel {
			padding: 28px 22px 34px;
		}
		.side-skel {
			display: none;
		}
	}
</style>
