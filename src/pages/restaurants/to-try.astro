---
// To try — the same components with two thirds of their content removed.
//
// A place I haven't been has no rating, no verdict, no photographs and no
// history. What survives is a name, a neighbourhood, a price band and the one
// line about why I want to go — which is, as it happens, exactly the shape a
// menu row already had. So the list row is the SAME row as the Restaurants
// list, with the right-hand price column intact and the reason set in italic
// prose where the cuisine and rating used to sit. The empty ring in the left
// margin is where the verdict mark goes, marking the slot as unfilled rather
// than removing it.
//
// THE PRICE COLUMN IS THE OWNER'S DELETE. A list of intentions is only useful
// if changing your mind is as cheap as adding — otherwise it silts up with
// places you decided against and stops being a shortlist. So for me the price
// band gives up its slot to a × in the same column, right-aligned to the same
// edge: nothing moves, the row keeps its rhythm, and the one control the list
// was missing is where the eye already ends up. Visitors still see the price.
//
// The row is a container with a stretched link rather than an <a> wrapping
// everything, because a button inside a link is not valid HTML and the whole
// row should still be clickable.
//
// AND THE MAP MEANS SOMETHING DIFFERENT. Every pin here is an intention rather
// than an opinion, so the pins are drawn open — the same shape with nothing
// inside it. Set against the visited map, the difference reads without a
// legend: a full pin is a verdict, an open one is a plan.
import RestaurantLayout from '../../layouts/RestaurantLayout.astro';
import RestaurantMap from '../../components/RestaurantMap.astro';
import MealEditor from '../../components/MealEditor.astro';
import { requireOwner } from '../../lib/auth';
import {
	isMapFilter,
	isPlaceSort,
	isPriceBand,
	isTripFilter,
	listCuisineFacets,
	listFriends,
	listPlaces,
	listTags,
	listWhyTagFacets,
	PRICE_BANDS,
	WHY_TAGS,
	type MapFilter,
	type PlaceSort,
	type PriceBand,
	type TripFilter,
} from '../../lib/restaurants';
import { placeLine } from '../../lib/restaurant-view';
import type { MapPoint } from '../../lib/restaurant-map';

export const prerender = false;

// THE SAME FILTERS AS THE RESTAURANTS LIST, MINUS THE ONES WITH NOTHING TO BITE
// ON. A place you haven't been to has no rating and no verdict, so those two
// rows are simply absent rather than present and inert; what remains is cuisine,
// price and a sort, read from the query string exactly as they are next door, so
// a filtered list survives a reload, a share and the list/map toggle.
const params = Astro.url.searchParams;
const isMap = params.get('view') === 'map';
const selectedCuisines = params.getAll('cuisine');
const selectedPrices = params.getAll('price').filter(isPriceBand) as PriceBand[];
// "Recently added" is the list's own order and the only sensible default: a
// shortlist is read from the top, and the top is what you just thought of.
const sort: PlaceSort = isPlaceSort(params.get('sort')) ? (params.get('sort') as PlaceSort) : 'added';
const trip: TripFilter | null = isTripFilter(params.get('trip')) ? (params.get('trip') as TripFilter) : null;
const onMap: MapFilter | null = isMapFilter(params.get('map')) ? (params.get('map') as MapFilter) : null;
const selectedTags = params.getAll('why').filter((t) => (WHY_TAGS as readonly string[]).includes(t));

const [all, places, cuisineFacets, whyFacets, isOwner] = await Promise.all([
	listPlaces({ scope: 'to-try' }),
	listPlaces({
		scope: 'to-try',
		cuisines: selectedCuisines,
		prices: selectedPrices,
		trip,
		tags: selectedTags,
		onMap,
		sort,
	}),
	listCuisineFacets('to-try'),
	listWhyTagFacets('to-try'),
	requireOwner(Astro.cookies),
]);
const [tagOptions, friendOptions] = isOwner ? await Promise.all([listTags(), listFriends()]) : [[], []];

// CUISINE IS LONG-TAILED HERE TOO — 36 values across 83 places, most of them
// naming one place. Same treatment as the restaurants list: everything that
// names more than one place is a chip, capped at eight, and the tail goes
// behind a <details> that says how big it is.
const HEAD_CHIPS = 8;
const head = cuisineFacets.filter((c) => c.count > 1).slice(0, HEAD_CHIPS);
const tail = cuisineFacets.filter((c) => !head.some((h) => h.name === c.name));

const toggle = (list: string[], value: string) =>
	list.includes(value) ? list.filter((v) => v !== value) : [...list, value];

const sorts: { key: PlaceSort; label: string }[] = [
	{ key: 'added', label: 'Recently added' },
	{ key: 'trip', label: 'Worth the trip first' },
	{ key: 'price', label: 'Price' },
	{ key: 'name', label: 'A–Z' },
];

// A count on the chip, because this filter is a job queue rather than a taste:
// the number IS the reason to click it, and when it reaches zero the chip says
// so instead of pretending there is work left.
const unplacedCount = all.filter((p) => p.lat == null || p.lng == null).length;

const trips: { key: TripFilter | null; label: string }[] = [
	{ key: null, label: 'All' },
	{ key: 'trip', label: 'Worth the trip †' },
	{ key: 'nearby', label: 'If I’m nearby' },
];

const activeFilters = [
	...selectedCuisines.map((c) => ({ label: c, href: href({ cuisine: toggle(selectedCuisines, c) }) })),
	...selectedPrices.map((p) => ({ label: p, href: href({ price: toggle(selectedPrices, p) }) })),
	...selectedTags.map((t) => ({ label: t, href: href({ why: toggle(selectedTags, t) }) })),
	...(trip ? [{ label: trip === 'trip' ? 'Worth the trip †' : 'If I’m nearby', href: href({ trip: null }) }] : []),
	...(onMap ? [{ label: onMap === 'off' ? 'Not on the map' : 'On the map', href: href({ map: null }) }] : []),
];

const countLine =
	places.length === all.length
		? `${all.length} place${all.length === 1 ? '' : 's'}`
		: `${places.length} of ${all.length}`;

const points: MapPoint[] = places
	.filter((p) => p.lat != null && p.lng != null)
	.map((p) => ({
		id: p.id,
		name: p.name,
		lat: p.lat as number,
		lng: p.lng as number,
		verdict: null,
		visited: false,
		trip: p.trip,
		price: p.price_band,
		cuisine: p.cuisines[0] ?? '',
		city: p.city,
		where: placeLine(p),
		rating: null,
		visits: 0,
		hearted: false,
	}));

/** Rebuild the query string with one parameter changed. */
function href(changes: Record<string, string | string[] | null>): string {
	const next = new URLSearchParams(params);
	for (const [key, value] of Object.entries(changes)) {
		next.delete(key);
		if (value == null) continue;
		for (const v of Array.isArray(value) ? value : [value]) next.append(key, v);
	}
	const qs = next.toString();
	return qs ? `/restaurants/to-try?${qs}` : '/restaurants/to-try';
}
---

<RestaurantLayout title="To try · Jason's restaurant log" pathname="/restaurants" isOwner={isOwner}>
	<div class="rl-page">
		<div class="rl-head">
			<div>
				<a class="rl-back" href="/restaurants">&larr; Jason&rsquo;s restaurant log</a>
				<div class="rl-head__title">To try</div>
			</div>
			<div class="head-right">
				<span class="rl-count" data-try-count>{countLine}</span>
				{isOwner && <button type="button" class="rl-btn rl-btn--primary" data-open-try-editor>+ Add place</button>}
				<div class="viewtoggle">
					<a class:list={['viewtoggle__b', !isMap && 'viewtoggle__b--on']} href={href({ view: null })}>List</a>
					<a class:list={['viewtoggle__b', isMap && 'viewtoggle__b--on']} href={href({ view: 'map' })}>Map</a>
				</div>
			</div>
		</div>

		{
			all.length > 0 && (
				<div class="rl-filters">
					<div class="rl-filters__row">
						<span class="rl-filters__legend">Cuisine</span>
						{head.map((c) => (
							<a
								class="rl-chip"
								href={href({ cuisine: toggle(selectedCuisines, c.name) })}
								aria-pressed={selectedCuisines.includes(c.name) ? 'true' : 'false'}
							>
								<span>{c.name}</span>
								<span class="rl-chip__n">{c.count}</span>
							</a>
						))}
						{tail.length > 0 && (
							<details class="rl-more">
								<summary class="rl-chip rl-chip--more">{tail.length} more</summary>
								<div class="rl-more__panel">
									{tail.map((c) => (
										<a
											class="rl-chip"
											href={href({ cuisine: toggle(selectedCuisines, c.name) })}
											aria-pressed={selectedCuisines.includes(c.name) ? 'true' : 'false'}
										>
											<span>{c.name}</span>
											<span class="rl-chip__n">{c.count}</span>
										</a>
									))}
								</div>
							</details>
						)}
					</div>

					{whyFacets.length > 0 && (
						<div class="rl-filters__row rl-filters__row--split">
							<span class="rl-filters__legend">Why</span>
							{whyFacets.map((t) => (
								<a
									class="rl-chip"
									href={href({ why: toggle(selectedTags, t.name) })}
									aria-pressed={selectedTags.includes(t.name) ? 'true' : 'false'}
								>
									<span>{t.name}</span>
									<span class="rl-chip__n">{t.count}</span>
								</a>
							))}
						</div>
					)}

					<div class="rl-filters__row rl-filters__row--split">
						<span class="rl-filters__legend">Price</span>
						{PRICE_BANDS.map((p) => (
							<a
								class="rl-chip rl-chip--mono"
								href={href({ price: toggle(selectedPrices, p) })}
								aria-pressed={selectedPrices.includes(p) ? 'true' : 'false'}
							>
								{p}
							</a>
						))}

						<span class="rl-filters__legend rl-filters__legend--gap">Trip</span>
						{trips.map((t) => (
							<a
								class="rl-chip"
								href={href({ trip: t.key })}
								aria-pressed={trip === t.key ? 'true' : 'false'}
							>
								{t.label}
							</a>
						))}

						{isOwner && unplacedCount > 0 && (
							<a
								class="rl-chip"
								href={href({ map: onMap === 'off' ? null : 'off' })}
								aria-pressed={onMap === 'off' ? 'true' : 'false'}
								title="Places with no point on the map — the ones the map screen cannot draw"
							>
								<span>Not on the map</span>
								<span class="rl-chip__n">{unplacedCount}</span>
							</a>
						)}

						<span class="rl-filters__sorts">
							<span class="rl-filters__legend">Sort</span>
							{sorts.map((s) => (
								<a class="rl-chip" href={href({ sort: s.key })} aria-pressed={sort === s.key ? 'true' : 'false'}>
									{s.label}
								</a>
							))}
						</span>
					</div>

					{activeFilters.length > 0 && (
						<div class="rl-filters__row rl-filters__row--active">
							<span class="rl-filters__legend">Active</span>
							{activeFilters.map((f) => (
								<a class="rl-chip" href={f.href} aria-pressed="true">
									{f.label} <span class="rl-filters__x">×</span>
								</a>
							))}
							<a class="rl-filters__clear" href="/restaurants/to-try">Clear all</a>
						</div>
					)}
				</div>
			)
		}

		{
			all.length === 0 ? (
				<p class="rl-empty empty">
					Nothing on the list yet. A name, roughly where it is, and one line about why
					you want to go — that is the whole entry.
				</p>
			) : places.length === 0 ? (
				<p class="rl-empty empty">
					Nothing on the list matches that. <a href="/restaurants/to-try">Clear the filters</a> to
					see all {all.length}.
				</p>
			) : isMap ? (
				<RestaurantMap points={points} caption={`${points.length} of ${places.length} placed`} />
			) : (
				<div class="rl-box list">
					{places.map((p) => (
						<div class="trow" data-try-row>
							<a class="trow__link" href={`/restaurants/place/${p.id}`} aria-label={p.name} />
							<span class="trow__ring" aria-hidden="true" />
							<span class="trow__name">{p.name}</span>
							{/* The mark, not the words: on a list this long "worth the
							    trip" nine times is noise, and a dagger is what a menu
							    uses to say the same thing once. */}
							{p.trip && (
								<span class="trow__trip" title="Worth the trip">
									†
								</span>
							)}
							<span class="trow__hood">{placeLine(p)}</span>
							<span class="rl-gap" />
							{p.to_try_tags.length > 0 && <span class="trow__tags">{p.to_try_tags.join(' · ')}</span>}
							<span class="rl-why trow__why">{p.to_try_reason}</span>
							{isOwner ? (
								<button
									type="button"
									class="trow__drop"
									data-try-drop={p.id}
									data-try-name={p.name}
									aria-label={`Remove ${p.name} from the list`}
									title={`Remove ${p.name} from the list`}
								>
									×
								</button>
							) : (
								<span class="trow__price">{p.price_band ?? ''}</span>
							)}
						</div>
					))}
				</div>
			)
		}
	</div>

	{
		isOwner && (
			<MealEditor
				redirect="/restaurants/to-try"
				tagOptions={tagOptions}
				friendOptions={friendOptions}
			/>
		)
	}
</RestaurantLayout>

<script>
	// Dropping a place off the list. The row goes without a reload — the count
	// is the only other thing on the page that knows how long the list is, and
	// it is one string — but an emptied list falls back to a reload, because the
	// "nothing on the list yet" copy is the server's to write.
	const count = document.querySelector('[data-try-count]');

	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-try-drop]')) {
		button.addEventListener('click', async () => {
			const name = button.dataset.tryName ?? 'this place';
			if (!window.confirm(`Remove ${name} from the to-try list?`)) return;

			button.disabled = true;
			const res = await fetch(`/api/restaurants/places/${button.dataset.tryDrop}`, {
				method: 'PATCH',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ toTry: false }),
			});
			if (!res.ok) {
				button.disabled = false;
				window.alert(`Could not remove ${name}.`);
				return;
			}

			button.closest('[data-try-row]')?.remove();
			const left = document.querySelectorAll('[data-try-row]').length;
			if (left === 0) {
				location.reload();
				return;
			}
			if (count) count.textContent = `${left} place${left === 1 ? '' : 's'}`;
		});
	}
</script>

<style>
	.head-right {
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
	}
	.viewtoggle {
		display: flex;
		border: 1px solid var(--rule);
	}
	.viewtoggle__b {
		background: var(--card);
		color: var(--ink-2);
		font-size: 12px;
		padding: 7px 14px;
	}
	.viewtoggle__b + .viewtoggle__b {
		border-left: 1px solid var(--rule);
	}
	.viewtoggle__b--on {
		background: var(--ink);
		color: var(--ground);
		font-weight: 600;
	}
	.viewtoggle__b--on:hover {
		color: var(--ground);
	}

	.list,
	.empty {
		margin-top: 16px;
	}
	.trow {
		position: relative;
		display: flex;
		align-items: baseline;
		gap: 6px 11px;
		flex-wrap: wrap;
		padding: 15px 18px;
		border-bottom: 1px solid var(--rule-4);
		color: var(--ink);
	}
	/* The whole row is the link. Out of flow, so the flex line above is laid
	   out exactly as it was when the row itself was an <a>. */
	.trow__link {
		position: absolute;
		inset: 0;
	}
	.trow:has(.trow__link:focus-visible) {
		outline: 2px solid var(--terracotta);
		outline-offset: -2px;
	}
	.trow:last-child {
		border-bottom: none;
	}
	.trow:hover {
		background: var(--wash-2);
		color: var(--ink);
	}
	/* Where the verdict mark sits on a visited row. Kept, empty, so the two
	   lists line up when you flip between them. */
	.trow__ring {
		width: 9px;
		height: 9px;
		flex: none;
		border: 1.4px solid var(--ink-3);
		border-radius: 50%;
		transform: translateY(-1px);
	}
	.trow__name {
		font-size: 15px;
		font-weight: 600;
	}
	.trow__hood {
		font-size: 11.5px;
		color: var(--ink-3);
	}
	.trow__trip {
		font-family: var(--prose);
		font-size: 15px;
		line-height: 1;
		color: var(--terracotta);
		flex: none;
	}
	.trow__tags {
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 1.4px;
		text-transform: uppercase;
		color: var(--ink-3);
		white-space: nowrap;
	}
	.trow__why {
		font-size: 14.5px;
		text-align: right;
		max-width: 330px;
	}
	.trow__price {
		font-family: var(--mono);
		font-size: 12.5px;
		width: 38px;
		text-align: right;
	}
	/* The price column's width, so an owner's list and a visitor's list rule
	   down the same edge. Quiet until the row is under the cursor — a delete
	   that shouts on every row of a list of things you like is wrong. */
	.trow__drop {
		position: relative;
		width: 38px;
		flex: none;
		/* Padded for a thumb, then pulled back by the same amount so the row is
		   the height it was and the × still sits on the price band's baseline. */
		padding: 11px 0;
		margin: -11px 0;
		border: none;
		background: none;
		font-family: var(--ui);
		font-size: 17px;
		line-height: 1;
		text-align: right;
		color: var(--ink-4);
		cursor: pointer;
		transition: color 0.12s;
	}
	.trow:hover .trow__drop {
		color: var(--ink-3);
	}
	/* Both selectors out-specify the row-hover rule above, which would
	   otherwise keep the × at --ink-3 while the cursor is on it. */
	.trow:hover .trow__drop:hover,
	.trow .trow__drop:focus-visible {
		color: var(--terracotta);
	}
	.trow__drop[disabled] {
		cursor: default;
		opacity: 0.4;
	}

	/* On a phone the row wraps and the reason drops to a second line. The ×
	   must not go with it — wrapped, it lands under the name at the LEFT
	   margin, pointing at nothing. So it leaves the flex line and pins to the
	   row's right edge, centred on however many lines the row ended up with,
	   and the row reserves the width it used to occupy. */
	@media (max-width: 620px) {
		.trow {
			padding-right: 46px;
		}
		.trow__drop {
			position: absolute;
			top: 50%;
			right: 6px;
			width: auto;
			margin: 0;
			padding: 11px 12px;
			transform: translateY(-50%);
		}
	}
</style>
